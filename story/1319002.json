  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅、帕克",
    "words": "好燙喔～！！",
    "voice": "vo_adv_1319002_000",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "兩位還好嗎？",
    "voice": "vo_adv_1319002_001",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "把章魚燒整個吞進嘴裡很危險，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請小口小口地吃。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "哈呼、",
    "voice": "vo_adv_1319002_002",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "呼──",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "呼……",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "好燙，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "但是，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "非～常好吃！",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "這也是",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "海邊才有的食物嗎？",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "與其說是海邊，",
    "voice": "vo_adv_1319002_003",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "應該說是海之家一定會有的料理吧。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n除了章魚燒之外，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "炒麵跟烤玉米之類的也很有名。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "這樣啊。",
    "voice": "vo_adv_1319002_004",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "雖然每樣都讓我很在意……",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "但是我有辦法全部吃完嗎。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只要在海水浴時活動身體，",
    "voice": "vo_adv_1319002_005",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "肚子自然就會餓了，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n所以沒有問題。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下很想那麼說……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "再怎麼說也太熱了吧！",
    "voice": "vo_adv_1319002_006",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "這種溫度去海水浴，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "在納涼之前就會先變成煮熟的章魚了啦！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "畢竟這幾天，",
    "voice": "vo_adv_1319002_007",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非比尋常的酷暑一直都在持續著呢。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n連本來",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是旺季的海之家也……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我買章魚燒的時候，",
    "voice": "vo_adv_1319002_008",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "店員開心到哭得非～常厲害，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "原來就是因為這樣啊。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總之，",
    "voice": "vo_adv_1319002_009",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們先去海之家休息吧。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "繼續這樣待在沙灘的話，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感覺我們也會倒下。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "background",
    "bg_id": "500690"
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "唉，",
    "voice": "vo_adv_1319002_010",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "就算在陰影下也很熱……",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n纖細的我會受不了啦～",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "沒想到至高的毛茸茸會帶來這種反效果啊。",
    "voice": "vo_adv_1319002_011",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "就算是我",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "現在也提不起勁去摸你啊……",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "抱歉啦，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "帕克。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "但是，",
    "voice": "vo_adv_1319002_012",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "因為天氣炎熱，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "所以刨冰感覺很美味呢。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "感覺不管幾碗我都能吃下去♪",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "愛蜜莉雅小姐，",
    "voice": "vo_adv_1319002_013",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請小心。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n讓肚子受寒不但對身體不好，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要是一口氣吃太多，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還會引起頭痛。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗚，",
    "voice": "vo_adv_1319002_014",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "痛痛痛……",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "這就是",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "吃冰引起的頭痛嗎？",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "吃太多也不好呢……",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n我本來想說如果有刨冰的力量，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "就能度過這股炎熱的說……",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "借助冰的力量",
    "voice": "vo_adv_1319002_015",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "嗎……",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我想到了！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "就做出比刨冰",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n還要更厲害的東西不就好了嗎？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "真不愧是兄弟。",
    "voice": "vo_adv_1319002_016",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "你很懂我呢！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n就是要這樣才行啊！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咦，",
    "voice": "vo_adv_1319002_017",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你們在說什麼啊？",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "放心吧，",
    "voice": "vo_adv_1319002_018",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "待會就會知道了。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n我有事情想拜託",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "愛蜜莉雅醬跟帕克──",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "泳裝男子",
    "words": "天氣這麼熱，",
    "voice": "vo_adv_1319002_019",
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "泳裝男子",
    "words": "果然很不妙啊──",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "泳裝男子",
    "words": "\\n差不多該回去了吧？",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "泳裝女子",
    "words": "咦～",
    "voice": "vo_adv_1319002_020",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "泳裝女子",
    "words": "難得現在沒什麼人，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "泳裝女子",
    "words": "\\n再稍微待一下啦～",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "泳裝女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "泳裝女子",
    "words": "人家現在才開始要曬出漂亮的小麥色耶～",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "泳裝男子",
    "words": "說什麼小麥色，妳啊……",
    "voice": "vo_adv_1319002_021",
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "泳裝男子",
    "words": "嗯？",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "泳裝男子",
    "words": "喂，",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "泳裝男子",
    "words": "看那個啊！",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "泳裝男子",
    "words": "\\n那是什麼啊，",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "泳裝男子",
    "words": "有塊巨大的冰塊",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "泳裝男子",
    "words": "立在海裡面啊！",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "泳裝女子",
    "words": "真的嗎～！？",
    "voice": "vo_adv_1319002_022",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "泳裝女子",
    "words": "那、",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "泳裝女子",
    "words": "那是什麼！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "泳裝女子",
    "words": "但是，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "泳裝女子",
    "words": "感覺好像有點涼呢。",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "泳裝女子",
    "words": "\\n靠近一點看看吧！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嘿、",
    "voice": "vo_adv_1319002_023",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咻。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "這個樣子就可以了吧？",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "嗯，",
    "voice": "vo_adv_1319002_024",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "跟我們想的完全一樣！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n真不愧是愛蜜莉雅醬啊！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "但是，",
    "voice": "vo_adv_1319002_025",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "只是讓巨大的冰塊浮在那邊，很沒意思呢。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n我覺得它",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "有更多可以遊玩的可能性啊……",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n對吧？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "好主意呢～",
    "voice": "vo_adv_1319002_026",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "是那個吧！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "still",
    "still_id": "131900201"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "不久後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n由昴跟{0}負責設計，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n大家一起雕塑成形的冰山，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "變成浮在海上的巨大滑水道了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯～",
    "voice": "vo_adv_1319002_027",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "非～常舒服呢～！",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n再滑一次吧！",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "愛蜜莉雅小姐，",
    "voice": "vo_adv_1319002_028",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請注意不要摔下去。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "海水可是相當鹹的。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯，",
    "voice": "vo_adv_1319002_029",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我會注意的！",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "但是，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "可可蘿",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "也想多滑幾次吧？",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n妳看起來躍躍欲試啊。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "畢竟那是主人跟昴先生",
    "voice": "vo_adv_1319002_030",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "想出來的傑作呢。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n充分樂在其中，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也是在下身為隨從的職責。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "泳裝小孩",
    "words": "接下來，",
    "voice": "vo_adv_1319002_031",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "泳裝小孩",
    "words": "換我滑～！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "喔～",
    "voice": "vo_adv_1319002_032",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不知不覺間排起等著滑的隊伍了呢。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "泳裝大叔",
    "words": "我是聽說",
    "voice": "vo_adv_1319002_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "泳裝大叔",
    "words": "在海邊有有趣的活動而來的喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "泳裝大叔",
    "words": "\\n沒想到居然能玩這種東西呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "泳裝奶奶",
    "words": "我還是第一次看到冰做的滑水道呢。",
    "voice": "vo_adv_1319002_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "泳裝奶奶",
    "words": "\\n不枉費我活這麼久呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "顧名思義，",
    "voice": "vo_adv_1319002_035",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不分男女老幼",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都非常喜歡它呢。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "因為這場只限今天舉辦的限定活動，",
    "voice": "vo_adv_1319002_036",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "終究會融化掉嘛。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n不管是什麼人，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "都抵抗不了限定這個詞啊……！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "它可能會更快融掉也說不定呢～",
    "voice": "vo_adv_1319002_037",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "畢竟天氣熱到連不是冰做的我都要融化了。",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n在強度上應該也差不多要到極限了。",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "咦，",
    "voice": "vo_adv_1319002_038",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "是那樣嗎？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "得在滑水道崩塌之前公告……",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "終於輪到我了呢。",
    "voice": "vo_adv_1319002_039",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那麼就，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "出發吧～！",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "奇怪，",
    "voice": "vo_adv_1319002_040",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "滑水道到一半就不見──",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "呀啊啊啊！！",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "愛蜜莉雅！！！",
    "voice": "vo_adv_1319002_041",
    "unit_id": 2713
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "噗哈……",
    "voice": "vo_adv_1319002_042",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我整個人頭朝下",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "摔進海裡了！",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "愛蜜莉雅小姐，",
    "voice": "vo_adv_1319002_043",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您沒受傷吧？",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n要是有什麼狀況的話，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就馬上上岸來接受治療……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "可可蘿，妳聽我說！",
    "voice": "vo_adv_1319002_044",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n海水",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真的很鹹呢。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n或許能夠用來當作料理的調味料呢！",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵，",
    "voice": "vo_adv_1319002_045",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那就是所謂的大海喔。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n您看起來很享受，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是太好了呢。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "原本明明是那麼大的冰塊，",
    "voice": "vo_adv_1319002_046",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "現在變得很小了呢。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "沒辦法抵抗大自然的力量嗎……",
    "voice": "vo_adv_1319002_047",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不過，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "這也沒辦法吧。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "已經沒地方可以滑了，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n冰製滑水道差不多該收攤了呢。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "泳裝小孩",
    "words": "大姐姐們，",
    "voice": "vo_adv_1319002_048",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "泳裝小孩",
    "words": "謝謝你們！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "泳裝小孩",
    "words": "\\n滑水道",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "泳裝小孩",
    "words": "非常好玩喔！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "泳裝男子",
    "words": "託你們的福變得涼爽不少，",
    "voice": "vo_adv_1319002_049",
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "泳裝男子",
    "words": "感覺還能繼續玩下去囉？",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "泳裝男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "泳裝男子",
    "words": "真的",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "泳裝男子",
    "words": "很感謝你們啦。",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "呵呵，",
    "voice": "vo_adv_1319002_050",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不客氣。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "難得到海邊來了啊，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "能玩得開心的話就太好了！",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "泳裝小孩",
    "words": "那麼我",
    "voice": "vo_adv_1319002_051",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "泳裝小孩",
    "words": "接下來想堆沙山！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "沙山？",
    "voice": "vo_adv_1319002_052",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "把被海水打濕的沙子堆起來，",
    "voice": "vo_adv_1319002_053",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是在海邊才能玩的遊戲。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n可以講究細微的造型，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也有很多製作方式。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "堆沙山是很深奧的，",
    "voice": "vo_adv_1319002_054",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "愛蜜莉雅醬。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我們就來堆個",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "跟剛剛的冰山匹敵的巨大作品吧。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "咦，",
    "voice": "vo_adv_1319002_055",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "要用手堆嗎？",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
