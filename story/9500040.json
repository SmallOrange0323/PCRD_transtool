  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "…………咦？",
    "voice": "vo_adv_9500040_000",
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦咦咦咦咦──！？！？",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "等等、等等、等等！？",
    "voice": "vo_adv_9500040_001",
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n是因為撞到頭的衝擊，",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "讓我的妄想失控了嗎！？",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "討厭，我在說什麼啊！",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我不是想講真陽式笑話啦！？",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "還、",
    "voice": "vo_adv_9500040_002",
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "還不是因為",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你突然說那種話，",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "人家才會不知所措啦！",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n你應該明白",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "人家想說什麼吧？",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "{0}竟然會選擇",
    "voice": "vo_adv_9500040_003",
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不是普通女孩的我……",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……果然還是",
    "voice": "vo_adv_9500040_004",
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "很奇怪啊！",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我覺得",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你還是重新考慮一下比較好！",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好不好？",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就這麼辦吧！！",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "………………好痛啊。",
    "voice": "vo_adv_9500040_005",
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "試著踩了踩自己的腳，",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "果然真的",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "痛到流眼淚了。",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n原來這不是夢……",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "而是真真切切的",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "現實呢。",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我知道了……",
    "voice": "vo_adv_9500040_006",
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "只讓男孩子來說，",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "確實不公平呢！",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "…",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "…咳咳。",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "對我來說，",
    "voice": "vo_adv_9500040_007",
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你是個會讓大家不由自主喜歡上的，",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "很棒的男孩子喔。",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n你還記得嗎？",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我吃下「變身蘋果」，",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "變成普通女孩子的時候，",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n你像戀人一樣牽著我的手，",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "還一起跳了舞……",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "所以，",
    "voice": "vo_adv_9500040_008",
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "即使是這樣的我，",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也曾夢想著總有一天",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "能和優秀的王子殿下幸福地生活──",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……雖然我知道",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這種想法會被人笑，",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "光是想像著「可喜可賀的結局」，",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就讓我心跳不已呢。",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "可是──",
    "voice": "vo_adv_9500040_009",
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n「現實」",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "還真是殘酷呢……",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "雖然你是個普通男孩，",
    "voice": "vo_adv_9500040_010",
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但我卻不是普通女孩……",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "既然",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "夢醒了，",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那就只能全盤接受了，不是嗎？",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我明明",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是這樣想的──",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "沒想到",
    "voice": "vo_adv_9500040_011",
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "夢醒了以後，",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我的王子殿下竟然在等著我！",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這比",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "任何童話故事都還要",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "「可喜可賀」不是嗎？",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "──所以呢，",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也請讓我",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "告白吧！",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "謝謝你喜歡我……",
    "voice": "vo_adv_9500040_012",
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "謝謝你把我當成",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "「普通的女孩子」！",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我也",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "喜歡{0}。",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n全世界",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "最最",
    "voice": null,
    "unit_id": 105241
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "最～喜歡你了♪",
    "voice": null,
    "unit_id": 105241
  }
]
