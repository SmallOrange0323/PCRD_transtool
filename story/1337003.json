  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "此外還帶有隨著時間經過就會累積錯誤而弱化的減益效果。",
