    "words": "先準備好以備不時之需的連接方法是正確的呢。",
    "voice": "vo_adv_1337003_022",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n雖然也有可能變成系統漏洞，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但這種時候就很有幫助。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "話雖如此，",
    "voice": "vo_adv_1337003_023",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "爬山",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "還真是考驗",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "腰腿啊～！",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要是能使用權能就可以更輕鬆了呢。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "哎呀，",
    "voice": "vo_adv_1337003_024",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你沒注意到嗎？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "在來這裡的路上，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我一直都是用走的吧。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "其實，",
    "voice": "vo_adv_1337003_025",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不知道是不是始源冠裝變得不穩定的緣故，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n權能的使用也出現了問題呢。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不，怎麼說呢，",
    "voice": "vo_adv_1337003_026",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "只是要用的話或許可以用……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但要是不能在穩定狀態下使用會很危險啊。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你想",
    "voice": "vo_adv_1337003_027",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "想，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "假如我們想走方便的捷徑，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n但是指定地點的座標出現異狀，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "結果活埋在土裡",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "或是岩石中！",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這種事也是有可能發生的。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "如果是物理上逃得出去的地方倒還好，",
    "voice": "vo_adv_1337003_028",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n要是困在不妙的空間，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "一輩子出不來的話，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你肯定也不想要吧？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "困在石頭中一命嗚呼，",
    "voice": "vo_adv_1337003_029",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "或是永遠在不知是何處的空間裡徘徊……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "至少",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "在確定安全之前",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我不太建議使用呢～",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "所以，",
    "voice": "vo_adv_1337003_030",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我們就只能腳踏實地前進了。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n前方的路還很長，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年你也做好心理準備吧。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "background",
    "bg_id": "500250"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這是",
    "voice": "vo_adv_1337003_031",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "通往我們據點的道路。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n這裡設計成了迷宮，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "即使是偶然迷路的人",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n或是懷有惡意的傢伙誤闖進來，也無法到達。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "話雖如此，",
    "voice": "vo_adv_1337003_032",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "畢竟是通往自家的熟悉道路。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n放心跟著我走吧。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "其實要是璃乃和靜流也在的話，",
    "voice": "vo_adv_1337003_033",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n狀態會更萬全……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但我拜託她們去做其他事，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "所以她們沒辦法馬上回來。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊，就是那裡。",
    "voice": "vo_adv_1337003_034",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "首先在那個轉角向右轉──",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "background",
    "bg_id": "500253"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……奇怪，",
    "voice": "vo_adv_1337003_035",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這裡剛才是不是也有經過？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不──",
    "voice": "vo_adv_1337003_036",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那是不可能的！",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n迷宮女王自己迷路這種事，可不是開玩笑的！",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "等等喔，",
    "voice": "vo_adv_1337003_037",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我們走回原路吧。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n目前為止走過的路線都記在我的腦中了，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n反過來前進的話應該就能回到原處……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……好奇怪。",
    "voice": "vo_adv_1337003_038",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "絕對有問題。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "才沒有這回事！",
    "voice": "vo_adv_1337003_039",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒想到",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我居然",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "會搞錯路……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "慢著，",
    "voice": "vo_adv_1337003_040",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這面岩壁和物件配置……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "如棋盤格子般整齊排列的道路……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我有印象。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "該不會這裡也……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……果然是這樣！",
    "voice": "vo_adv_1337003_041",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年，我知道了！",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不是我搞錯了──",
    "voice": "vo_adv_1337003_042",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "錯的，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是這個世界！",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊，等一下！",
    "voice": "vo_adv_1337003_043",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n抱歉，我會按順序來解釋的，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你別用一副",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "「這傢伙已經神智不清了……」",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "的眼神看著我啦！",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "修復的資料出現問題時",
    "voice": "vo_adv_1337003_044",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我就該預料到會變成這樣了呢……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "難怪我會有印象。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這裡",
    "voice": "vo_adv_1337003_045",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是阿斯特朗開發途中的區域……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n是後來中止實裝的",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "特殊地下城。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "似乎是在修復過去差點被還原的資料時，",
    "voice": "vo_adv_1337003_046",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n連同應該已經捨棄的開發資料都抽取出來了呢。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "所以通往據點的路好像就變成地下城了。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "的確，",
    "voice": "vo_adv_1337003_047",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "在系統方面幾乎已經完成了……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但這裡的時間流動比較特殊，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "跟外面",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "有點不太一樣。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "具體而言──",
    "voice": "vo_adv_1337003_048",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n只要玩家沒有前進一定的步數，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "時間就不會往前。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "更正確來說，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是「事件不會發生」。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "依里和鈴是不是有在玩這類遊戲？",
    "voice": "vo_adv_1337003_049",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n像是《風來的古煉》",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "和《約魯內克大冒險》之類的。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不過",
    "voice": "vo_adv_1337003_050",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "既然這個地下城顯現出來，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n就表示系統中恐怕也加入了一些改變──",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年，等等！",
    "voice": "vo_adv_1337003_051",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n不能隨便亂動──",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "魔物的集團",
    "words": "──咕喔喔喔喔喔！！\\n──咕喔喔喔喔喔！！\\n──咕喔喔喔喔喔！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是怪物屋！",
    "voice": "vo_adv_1337003_052",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這裡被設下了一大堆像這樣的陷阱啊！",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "聽好了，",
    "voice": "vo_adv_1337003_053",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就保持這樣別動，冷靜地思考吧。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n只要不動作，魔物應該就不會有反應……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "…………",
    "voice": "vo_adv_1337003_054",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……好，",
    "voice": "vo_adv_1337003_055",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "決定好作戰計畫了。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "準備好了嗎？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯。",
    "voice": "vo_adv_1337003_056",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你就這樣踏出去，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "攻擊魔物看看。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "background",
    "bg_id": "500253"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "原來如此，",
    "voice": "vo_adv_1337003_057",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "對魔物造成了１點傷害啊。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "頭上會出現數字真是簡單明瞭呢！",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "換我踏出一步對吧？",
    "voice": "vo_adv_1337003_058",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "好，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "姑且也攻擊",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "一下吧。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "果然是",
    "voice": "vo_adv_1337003_059",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "１點傷害呢。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯～",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "闖入地下城時",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n好像會被強制固定在等級１啊。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯嗯。",
    "voice": "vo_adv_1337003_060",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "果然是這樣。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我們的行動回合結束了。",
    "voice": "vo_adv_1337003_061",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n接著",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "輪到敵方的回合。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這麼一來──",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "魔物的集團",
    "words": "──咕喔喔喔喔喔！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我們就會被圍毆，然後Game Over。",
    "voice": "vo_adv_1337003_062",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不過，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "初始等級遇上怪物屋就是個死局。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n這樣的話重置是最快的。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "好，",
    "voice": "vo_adv_1337003_063",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "一起咬緊牙關撐過去吧！",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒事的，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "如果是依照系統設定，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我們只會被送回「入口」！",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "應該說，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "反正不管怎樣，在這種狀況下",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "也沒救了！",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "background",
    "bg_id": "500253"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "哦──",
    "voice": "vo_adv_1337003_064",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "好痛好痛……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你沒事吧？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "看來體力已經恢復了呢。",
    "voice": "vo_adv_1337003_065",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "跟設計的一樣。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "而且也回到起點了。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "也就是說，",
    "voice": "vo_adv_1337003_066",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我們無論如何",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n都必須攻略這座地下城嗎……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這下麻煩了。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "剛才我們往回走也行不通吧？",
    "voice": "vo_adv_1337003_067",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n這座迷宮變成了地下城，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n是與外界空間分離的另一個空間。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "很遺憾，",
    "voice": "vo_adv_1337003_068",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "若按照開發中的設計，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n不攻略到最深處應該就沒辦法出去。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要是能使用除錯指令就好了……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "果然不行啊……",
    "voice": "vo_adv_1337003_069",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "而且可靠的權能也無法使用。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這樣的話……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就",
    "voice": "vo_adv_1337003_070",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是說啊。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雖然是這樣，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但目標本身非常單純。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要達成的目標有兩個。",
    "voice": "vo_adv_1337003_071",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n攻略這座地下城前往據點。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "還有，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "配合現行版本將始源冠裝最佳化。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "只不過，",
    "voice": "vo_adv_1337003_072",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "已經好久沒有……",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這種感覺了。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雖然不該這麼說，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但我的遊戲玩家之魂",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "似乎有些躍躍欲試了。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "哎呀，",
    "voice": "vo_adv_1337003_073",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年你是不太會接觸",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "限制條件玩法的類型嗎？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不如說，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "正因為是這種狀況吧。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "遊戲",
    "voice": "vo_adv_1337003_074",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "一旦等級練得過高，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n大多情況都可以靠力量強行闖過。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不過",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "受到弱化的這種狀況就不能用那種方式了。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "正因為這樣，",
    "voice": "vo_adv_1337003_075",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "才有必要思考。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "絞盡腦汁、",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "耗費苦心、",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "尋找最好的方法──",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就是有這種唯有等級１才能體會到的樂趣",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "對吧？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "簡直",
    "voice": "vo_adv_1337003_076",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就像是新遊戲，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "讓人興奮起來了對吧，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年！",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "別那樣嘆氣嘛。",
    "voice": "vo_adv_1337003_077",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我也不是想拖很久。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "接下來",
    "voice": "vo_adv_1337003_078",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要以最快速度攻略這座地下城。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n就讓你好好見識一下什麼是寶刀未老吧。",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "敵人似乎也正好來迎接我們了。",
    "voice": "vo_adv_1337003_079",
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年，",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "準備好了嗎？",
    "voice": null,
    "unit_id": 133712
  },
  {
    "type": "still",
    "still_id": "133700301"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "很棒的表情，",
    "voice": "vo_adv_1337003_080",
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "看是做好準備了呢。",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "──那麼，",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "開始遊戲吧！",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "still",
    "still_id": "end"
  }
]
