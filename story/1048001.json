[
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天，當{0}在平原與魔物戰鬥時，\\n一旁傳來巨大聲響。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喝啊啊啊啊啊！",
    "voice": "vo_adv_1048001_000",
    "unit_id": 104811
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘰歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "很好！ 一招致命呢！",
    "voice": "vo_adv_1048001_001",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n討伐委託完成！ ",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "下一個！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呼、呼、",
    "voice": "vo_adv_1048001_002",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呼、呼……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──呱歐歐歐歐歐！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後又過了一段時間，\\n當{0}正在其他地方與魔物展開死鬥時――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喝啊啊啊啊啊啊！",
    "voice": "vo_adv_1048001_003",
    "unit_id": 104811
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘰歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "很好！ 一招致命！",
    "voice": "vo_adv_1048001_004",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯……但是剛才的動作有點多餘呢。",
    "voice": "vo_adv_1048001_005",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "該反省反省……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯？ 奇怪……",
    "voice": "vo_adv_1048001_006",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂，你。我從剛剛開始就一直遇見你……",
    "voice": "vo_adv_1048001_007",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你是賞金獵人？ 還是保鏢？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "看來似乎不是同行呢……",
    "voice": "vo_adv_1048001_008",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是喔。算了，沒關係。",
    "voice": "vo_adv_1048001_009",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "話說回來，你叫什麼名字？",
    "voice": "vo_adv_1048001_010",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣啊，原來如此。我的名字是美冬喔。",
    "voice": "vo_adv_1048001_011",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "今後請多多指教。我隸屬於墨丘利財團……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n是只要有酬勞什麼都能搞定的傭兵喔！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也可以說我是在各地領時薪工作的能幹打工族喔。",
    "voice": "vo_adv_1048001_012",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "話說回來，你剛剛使的劍法，",
    "voice": "vo_adv_1048001_013",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n慢到我都看不下去了。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你認為戰鬥最需要的是什麼？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯──，",
    "voice": "vo_adv_1048001_014",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "只有勝利是不行的。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "雖然答案很接近……",
    "voice": "vo_adv_1048001_015",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可惜答錯了。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "正確答案是……",
    "voice": "vo_adv_1048001_016",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "『效率』喔！！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "以最精簡的動作獲得最佳效率，那就是我引以為目標的",
    "voice": "vo_adv_1048001_017",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n最強傭兵。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "時間就是金錢！ 時間是不等人的！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "換句話說，如果有時間悠閒沉浸在擊倒一個敵人的餘韻中，",
    "voice": "vo_adv_1048001_018",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不如更有效率地行動，再擊倒一個敵人。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "能看一下這裡嗎？ 我示範給你看。",
    "voice": "vo_adv_1048001_019",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "要一招擊倒兩個敵人……",
    "voice": "vo_adv_1048001_020",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "首先是給予重擊，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "再用力抓過來，像這樣",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯，大概是這種感覺喔！",
    "voice": "vo_adv_1048001_021",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊，等等……？ ",
    "voice": "vo_adv_1048001_022",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我想到更有效率地擊倒敵人的方法了！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n或許，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "像這樣高舉之後，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "再這麼做的話，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n第三招就能擊中……！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "………………",
    "voice": "vo_adv_1048001_023",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……沒有傷到喔。",
    "voice": "vo_adv_1048001_024",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "沒、沒有傷到啦！！ ",
    "voice": "vo_adv_1048001_025",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是真的喔！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但是，你的攻擊看起來頗具威力呢。",
    "voice": "vo_adv_1048001_026",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "雖然劍法不太行，但是若好好地鍛鍊，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我認為能有相當的戰力喔。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對了，",
    "voice": "vo_adv_1048001_027",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你要不要當我的徒弟？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我會手把手教你如何有效率地打敗敵人喔！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不客氣。呵呵呵，用不著道謝。",
    "voice": "vo_adv_1048001_028",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n今後，我會定期在這個平原",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n嚴格訓練你喔！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "像這樣，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "再這樣……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "痛、",
    "voice": "vo_adv_1048001_029",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "痛痛痛……我的腰……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "話說回來，教師費幫你打了個大折扣，",
    "voice": "vo_adv_1048001_030",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n時薪只要750盧幣就好了喔！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……？ 怎麼了？一臉搞不清楚狀況的樣子。",
    "voice": "vo_adv_1048001_031",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "美冬自己說要收徒弟，又主動要求報酬，\\n{0}對於她強烈的經商頭腦感到相當吃驚……",
    "voice": null,
    "unit_id": null
  }
]
