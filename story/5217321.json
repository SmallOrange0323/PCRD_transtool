[
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "八斗神先生……",
    "voice": "vo_adv_5217321_000",
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "竟能使出如此不得了的劍法！",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "就是說呀。",
    "voice": "vo_adv_5217321_001",
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不知道他是不是",
    "voice": null,
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "練等練了很長一段期間……",
    "voice": null,
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "──不。",
    "voice": "vo_adv_5217321_002",
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n我來到「這邊」才不到一個月啊。",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "大叔，",
    "voice": "vo_adv_5217321_003",
    "unit_id": 139712
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n成長期。",
    "voice": null,
    "unit_id": 139712
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "明明我們這邊",
    "voice": "vo_adv_5217321_004",
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "仍在被女武神的力量給牽著走……",
    "voice": null,
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不，",
    "voice": null,
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "現在可不是說喪氣話的時候呢。",
    "voice": null,
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "臥薪嘗膽──",
    "voice": "vo_adv_5217321_005",
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "活用我們至今為止的經驗，",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "來駕馭新的力量吧！",
    "voice": null,
    "unit_id": 139512
  }
]
