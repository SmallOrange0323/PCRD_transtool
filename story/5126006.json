  },
  {
    "type": "background",
    "bg_id": "502030"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔",
    "voice": "vo_adv_5126006_090",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這傢伙……",
