    "name": "鈴奈",
    "words": "呼嚕。",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……鈴奈，妳快醒醒！",
    "voice": "vo_adv_5126006_017",
