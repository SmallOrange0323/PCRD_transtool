    "words": "嗯──",
    "voice": "vo_adv_5126006_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "來賓",
    "words": "因為這樣……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "來賓",
    "words": "啊──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "來賓",
    "words": "所以是這麼回事。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "來賓",
    "words": "\\n唔──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "來賓",
    "words": "以上，",
    "voice": null,
    "unit_id": null
  },
