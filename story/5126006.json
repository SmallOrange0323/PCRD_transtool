  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不愧是魔法學園裡的大人物，",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "超會使用睡眠魔法的呢～",
