  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "由於凱留實在過於優秀，因此她將直接跳級畢業。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "轉眼間，凱留明天就要畢業了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而她正在宿舍收拾行李。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呼～",
    "voice": "vo_adv_5126006_000",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "明天就要跟這間學園道別了啊。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "畢業的時刻也來得太快了。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "明明想在這裡……",
    "voice": "vo_adv_5126006_001",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "再和大家多相處一陣子。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還有好多好多……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在青春裡還沒完成的事……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯，",
    "voice": "vo_adv_5126006_002",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "其實我一直很憧憬在傍晚放學後穿著制服……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以想試一次",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看看……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？{0}！！？",
    "voice": "vo_adv_5126006_003",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你為什麼在啦！！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為自己的東西整理完了，",
    "voice": "vo_adv_5126006_004",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以來幫我？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊啊……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你原本就是來陪我的，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n所以也會跟我一起畢業呢。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還有要拿東西給我？",
    "voice": "vo_adv_5126006_005",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這個是，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "鈴奈給我的留言？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "「凱留寶飛起」，",
    "voice": "vo_adv_5126006_006",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是惠啟啦惠啟！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "誰跟妳飛起啊！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n別連寫封信也要讓人吐槽啊！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……有錯字、漏字，",
    "voice": "vo_adv_5126006_007",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "和注音符號跟圓圓的文字，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "再加上用了一堆顏色，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n未免也太難閱讀了……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "原來如此……",
    "voice": "vo_adv_5126006_008",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "上面寫說",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然規模不大，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n但是他們在明天替我們準備了畢業典禮。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n然後",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "叫我先想好畢業生代表",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "的致詞內容。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的……",
    "voice": "vo_adv_5126006_009",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "突然被告知這種事讓人很困擾耶。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "再說畢業生根本就只有我們嘛！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……嗯，",
    "voice": "vo_adv_5126006_010",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還可以啦。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你呢？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "！！",
    "voice": "vo_adv_5126006_011",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我、",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我跟你一起也",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很開……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什、",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼都沒有啦！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "笨蛋！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "！！",
    "voice": "vo_adv_5126006_012",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你喔……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我人就站在你眼前，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n好歹也顧慮一下我的心情吧……？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "顧慮什麼心情……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "誰、",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "誰知道啊！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "笨蛋！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉……",
    "voice": "vo_adv_5126006_013",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總覺得最近很容易就表露出情感呢……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這也是",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為「青春」的關係嗎？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什、",
    "voice": "vo_adv_5126006_014",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼～～！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你再說一次，看我不宰了你～～！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "background",
    "bg_id": "502030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接著，到了凱留的畢業典禮當天。",
