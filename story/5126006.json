  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "阿爾杰什……",
    "voice": "vo_adv_5126006_054",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "什麼的，",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n感覺最近好像有聽過……？",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "對，",
    "voice": "vo_adv_5126006_055",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "我有提過……",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "據說阿爾杰什",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "\\n是800年前在這片土地上肆虐的獨眼魔物……！",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "\\n也就是傳說中被大賢者──安布羅斯大人所封印的……",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喔喔，",
    "voice": "vo_adv_5126006_056",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以當時就在那個大鐘上開了一個洞啊……",
