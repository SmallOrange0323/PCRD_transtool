    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但這間學園充滿了凱留寶的青春回憶，",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n絕對不能讓它被破壞！！",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "班導",
