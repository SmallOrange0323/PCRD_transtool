    "name": "璃乃",
    "words": "去地下室看看吧！！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等等等等等等……！！",
    "voice": "vo_adv_5126006_066",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那傢伙是不是在往這邊前進！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "喂～～～！！",
    "voice": "vo_adv_5126006_067",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "阿爾杰什寶～～～！！！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n現在",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "正在辦凱留寶的畢業典禮～！！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n你如果可以去其他地方的話人家會很開心的～～～！！！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "聲音傳不到魔物耳裡的吧！！",
    "voice": "vo_adv_5126006_068",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "人類給我閉嘴。",
    "voice": "vo_adv_5126006_069",
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "你們的聲音……",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "\\n在我剛睡醒的腦袋裡嗡嗡作響……",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說了超多話！！！",
    "voice": "vo_adv_5126006_070",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……啊！？",
    "voice": "vo_adv_5126006_071",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "凱留寶，妳看！！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n那傢伙，",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "正抓著一個人！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "咿咿咿！！",
    "voice": "vo_adv_5126006_072",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "喂、",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "喂，放開我！！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "\\n我可是幫你解開封印的恩人啊！？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "少自大了，人類。",
    "voice": "vo_adv_5126006_073",
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "就算不借助你的力量，",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "我也早就醒來了。",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "\\n……當我聽到那可恨鐘聲的瞬間，",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "也就是現在仍迴繞在我耳朵深處……",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "\\n800年前那令人不快的聲響……！！",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "牠會醒來好像是我害的耶──！！？",
    "voice": "vo_adv_5126006_074",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "……脆弱的人類，生命早就已到盡頭了吧。",
    "voice": "vo_adv_5126006_075",
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "\\n可恨的安布羅斯……",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "\\n我恨不得親手",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "將你大卸八塊……！",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "怎、",
    "voice": "vo_adv_5126006_076",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "怎樣都好啦……！！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "\\n你只要去把那間學園弄得一團亂就行了……！！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "這樣一來",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "交代給我的任務……！！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "我……",
    "voice": "vo_adv_5126006_077",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "我就能完成任務，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "拿到貴族給我的豐厚報酬了……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "我要拿著那筆錢去南國……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "悠哉地過生活……！！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "刺客",
    "words": "呀啊啊！！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "沒聽到我叫你閉嘴嗎……！！",
    "voice": "vo_adv_5126006_078",
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "既然現在安布羅斯不在了，",
    "voice": "vo_adv_5126006_079",
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "我就將這份憎恨向著世界發洩吧……",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "\\n首先就從",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "這裡開始破壞。",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "安布羅斯魔法學園。",
    "voice": "vo_adv_5126006_080",
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "\\n",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "就從這間冠了個名字令人作嘔的",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "學校開始吧！！",
    "voice": null,
    "unit_id": 17711
