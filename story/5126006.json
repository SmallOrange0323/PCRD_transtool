  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖然現在才想起來有點晚了。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但是在我確定要插班進入這所學園時……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "現在是講這個的時候嗎！？",
    "voice": "vo_adv_5126006_060",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……那時候，",
    "voice": "vo_adv_5126006_061",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "會長拜託了我。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為這所學園中",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "封印著名為阿爾杰什的魔物，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以如果有個萬一的話，要我保護哥哥。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "校園生活過得太開心，",
    "voice": "vo_adv_5126006_062",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "導致我忘得一乾二淨了……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那是什麼意思啊……！！",
    "voice": "vo_adv_5126006_063",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "現在不是吵架的時候了！",
    "voice": "vo_adv_5126006_064",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "應該先掌握封印解開的原因！！",
    "voice": null,
    "unit_id": 103011
  },
  {
