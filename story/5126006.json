    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呃……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "為什麼這種怪物會醒來啊！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "老實說，這件事太久遠，",
    "voice": "vo_adv_5126006_057",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "導致安布羅斯大人的傳說已經沒有真實感了……",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "事實上，這800年來什麼事都沒有發生，",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "\\n而且我記得地下室的管理也很隨便……",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "是被哪個心懷不軌的人解開了封印嗎……？",
    "voice": "vo_adv_5126006_058",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……那個，",
    "voice": "vo_adv_5126006_059",
