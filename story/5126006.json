  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "我只要",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "能妨礙凱留的畢業典禮就行了……！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "我不過是來欣賞她悲痛的表情，",
    "voice": "vo_adv_5126006_083",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "可不想被捲入啊！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "…",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "…不管了！！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
