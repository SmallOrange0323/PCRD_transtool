    "name": "惠理子",
    "words": "你們還真敢玷汙那位大人風光場面呢！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n做好覺悟吧，你們這些垃圾！！",
