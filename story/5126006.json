    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "\\n趕快解決這傢伙再繼續進行吧！",
    "voice": null,
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "\\n凱留的畢業典禮還沒結束呢！！",
    "voice": null,
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…",
    "voice": "vo_adv_5126006_099",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……真煩人。",
    "voice": "vo_adv_5126006_100",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你們這群魔力低的傢伙就算待在這裡",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也沒有意義啊……！",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "不良學生們",
    "words": "但是我們不會逃的！！！",
    "voice": "vo_adv_5126006_101",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "受不了，",
    "voice": "vo_adv_5126006_102",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真的是一群笨蛋……",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我本來只是想隨便爭取點時間後就逃跑的，",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這下不就沒辦法逃了嗎……",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都是你們的錯，",
    "voice": "vo_adv_5126006_103",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n害我非得打倒這傢伙不可了啊！！",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "……妳的雙眼充滿無所畏懼的光芒，",
    "voice": "vo_adv_5126006_104",
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "真看不順眼。",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "\\n讓我想起了可恨的安布羅斯。",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "算了，",
    "voice": "vo_adv_5126006_105",
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "給我消失吧。",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "\\n",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "……喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "！！",
    "voice": "vo_adv_5126006_106",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好驚人的魔力……！",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你們幾個，",
    "voice": "vo_adv_5126006_107",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "已經夠了，真的拜託你們快逃吧。",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……我已經有好好接收到你們的心意了。",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我一定會贏的！！",
    "voice": "vo_adv_5126006_108",
    "unit_id": 127211
  },
  {
    "type": "movie",
    "movie_id": "512600601"
  }
]
