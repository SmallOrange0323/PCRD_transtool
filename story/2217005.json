  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n咦？",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n天空",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "在發光……？",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "啊……",
    "voice": "vo_adv_2217005_054",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "……咕嚕咕嚕咕嚕咕嚕……",
    "voice": "vo_adv_2217005_055",
    "unit_id": 6833
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "等等！？",
    "voice": "vo_adv_2217005_056",
    "unit_id": 6633
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "是腳抽筋了嗎！？",
    "voice": null,
    "unit_id": 6633
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n這麼淺的地方，",
    "voice": null,
    "unit_id": 6633
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "怎麼會溺水……！",
    "voice": null,
    "unit_id": 6633
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "等等……",
    "voice": "vo_adv_2217005_057",
    "unit_id": 6633
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n這傢伙以外的其他人",
    "voice": null,
    "unit_id": 6633
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "也一個個暈過去了……！？",
    "voice": null,
    "unit_id": 6633
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 6633
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "而且總感覺，",
    "voice": null,
    "unit_id": 6633
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "天空也很奇怪──",
    "voice": null,
    "unit_id": 6633
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "咦……",
    "voice": "vo_adv_2217005_058",
    "unit_id": 6633
  },
  {
    "type": "background",
    "bg_id": "510520"
  },
  {
    "type": "dialogue",
    "name": "青年1",
    "words": "嘿咻……！",
    "voice": "vo_adv_2217005_059",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "青年1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "青年1",
    "words": "我、",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "青年1",
    "words": "我姑且把店附近睡著的傢伙",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "青年1",
    "words": "\\n都搬過來了……！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "青年2",
    "words": "到底",
    "voice": "vo_adv_2217005_060",
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "青年2",
    "words": "發生什麼事了……！？",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "青年2",
    "words": "\\n如果在建築物和車子裡面的話，",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "青年2",
    "words": "可能會好一點……",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "青年1",
    "words": "這樣下去，",
    "voice": "vo_adv_2217005_061",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "青年1",
    "words": "街上的……",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "青年1",
    "words": "不！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "青年1",
    "words": "\\n地球上所有人",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "青年1",
    "words": "都會暈倒的吧……！？",
    "voice": null,
    "unit_id": 1331
  },
