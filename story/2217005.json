    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "幻想の星へ。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\nそしてあなたたちの、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "新たなる故郷へ。",
