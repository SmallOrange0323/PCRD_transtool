  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "……",
    "voice": "vo_adv_2217005_062",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "歡迎你們，",
    "voice": "vo_adv_2217005_063",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n地球人。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "歡迎來到由七冠創造的，",
    "voice": "vo_adv_2217005_064",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "幻想之星。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n也是你們的",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "新故鄉。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "然後……",
    "voice": "vo_adv_2217005_065",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "啊啊。",
    "voice": "vo_adv_2217005_066",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n終於……",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我的願望",
    "voice": "vo_adv_2217005_067",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "終於實現了。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n我能將名為地球的可怕行星，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n覆寫成",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "適合我居住的故鄉。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "回想起來，",
    "voice": "vo_adv_2217005_068",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我這一路究竟耗費了多少心力啊。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我是多麼慎重、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "細心，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "又充滿毅力、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "善於忍耐。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不。",
    "voice": "vo_adv_2217005_069",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n我",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "還不能鬆懈。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "其他七冠們",
    "voice": "vo_adv_2217005_070",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "一定會採取行動。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "還有那些公主騎士們。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "…………",
    "voice": "vo_adv_2217005_071",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "……？",
    "voice": "vo_adv_2217005_072",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n真是",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "奇怪呢。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "照理說，",
    "voice": "vo_adv_2217005_073",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "應該已經有足以填滿",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n蘭德索爾五芒星的登入量才對。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "但此刻仍毫無跡象。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "難道是新玩家大量湧入，",
    "voice": "vo_adv_2217005_074",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "導致登入伺服器塞住了？",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不對。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n如果沒有封鎖模式，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "理應能承受數以億計的存取才是。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "既然如此，",
    "voice": "vo_adv_2217005_075",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "為什麼？",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "是",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "塔被破壞得太嚴重嗎？",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n還是說，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "有我不知道的隱藏指令",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "在妨礙登入？",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不對。",
    "voice": "vo_adv_2217005_076",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n這是……",
    "voice": null,
    "unit_id": 107412
  },
