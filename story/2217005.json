    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "唔……",
    "voice": "vo_adv_2217005_001",
    "unit_id": 193712
  },
  {
    "type": "still",
    "still_id": "221509901"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我是",
    "voice": "vo_adv_2217005_002",
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "尤絲蒂亞娜‧F‧阿斯特賴亞。",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n以這個國家的公主之名起誓──",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "無論我所珍愛的人們，",
    "voice": "vo_adv_2217005_003",
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還是幸福的餐桌，",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這一切……",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "都由我來守護！",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "background",
    "bg_id": "502840"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……阿斯特賴亞",
    "voice": "vo_adv_2217005_004",
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "background",
    "bg_id": "500204"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一對一決鬥",
    "voice": "vo_adv_2217005_005",
    "unit_id": 180412
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就到此為止了！！",
    "voice": null,
    "unit_id": 180412
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n超火力全開！！",
    "voice": null,
    "unit_id": 180412
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n公主突襲──！！",
    "voice": null,
    "unit_id": 180412
  },
  {
    "type": "background",
    "bg_id": "502840"
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……阿斯特賴亞……",
    "voice": "vo_adv_2217005_006",
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "阿斯特賴亞啊啊啊啊……！！！",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……哦。",
    "voice": "vo_adv_2217005_007",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "看來妳的憤怒之火",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "還沒有熄滅呢。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……當然。",
    "voice": "vo_adv_2217005_008",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n不如說每秒都燒得更旺。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "光是想到「那傢伙」",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "此時此刻",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "仍悠悠哉哉地活著……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "看來妳幹勁十足，",
    "voice": "vo_adv_2217005_009",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那我就放心了。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不過……",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n下次戰鬥時，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "要待在我能看到的地方喔。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……",
    "voice": "vo_adv_2217005_010",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "妳是說──",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n我自己",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "打不贏尤絲蒂亞娜嗎……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……不對……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……黎薩。",
    "voice": "vo_adv_2217005_011",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n妳的意思是，",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "會助我一臂之力嗎？",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "算是",
    "voice": "vo_adv_2217005_012",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "吧──",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "反正對方應該會",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "人多打人少吧。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "像我就被某個",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "個性很差的[rub:亡靈]幽靈[/rub]給記恨著，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "要是有個能替我守護背後的人就再好不過了。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "而且……",
    "voice": "vo_adv_2217005_013",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "就算氣到腦血管破了，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我也能用恢復魔法幫妳補起來喔。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……",
    "voice": "vo_adv_2217005_014",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "希望妳不用",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "這麼大費周章。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "話說回來──",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "黎薩。",
    "voice": "vo_adv_2217005_015",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "妳似乎能靈活運用",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "皇家裝備「貪婪」。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n那幻境龍后的",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "公主騎士能力呢？",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n如果使用那個能力，",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "應該也不至於輸給",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "霸瞳皇帝之前養的那隻貓吧？",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "公主騎士的能力……",
    "voice": "vo_adv_2217005_016",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "如果是像妳一樣，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "通用性高的能力就好了。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "怎麼說呢，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "跟我合不來──",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "妳不也是嗎？",
    "voice": "vo_adv_2217005_017",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不久之前還在說什麼「害怕被憤怒吞噬」之類的，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n所以不怎麼願意使用「憤怒」。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "差不多是類似的感覺。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "大概吧。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "妳都這麼說了，",
    "voice": "vo_adv_2217005_018",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "我也不好強人所難……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n但是……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……是啊。",
    "voice": "vo_adv_2217005_019",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "現在或許不是說這種天真話的時候了。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "而且……",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "background",
    "bg_id": "500521"
  },
  {
    "type": "background",
    "bg_id": "502840"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "看著那片奇怪的天空，",
    "voice": "vo_adv_2217005_020",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "便會不由自主地想，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不管最後會變得如何……",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "一切也快",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "接近尾聲了。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……是啊。",
    "voice": "vo_adv_2217005_021",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "不過當然，",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "要結束的並不是我們──",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "黎薩、芙蕾雅",
    "words": "！？",
    "voice": "vo_adv_2217005_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "這股魔力是……",
    "voice": "vo_adv_2217005_023",
    "unit_id": 140414
  },
  {
    "type": "still",
    "still_id": "221609803"
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "當然",
    "voice": "vo_adv_2217005_024",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "是我囉。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我回來了，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "兩位。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "幻境龍后，",
    "voice": "vo_adv_2217005_025",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "這副模樣是……？",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "抱歉，",
    "voice": "vo_adv_2217005_026",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "嚇到妳們了。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "因為貿然行事，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "後果真的是非常悽慘──",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n害我不得不動用",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "一張王牌。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "多虧如此，",
    "voice": "vo_adv_2217005_027",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我變成了這副模樣。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n真是始料未及的狀況。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "可、",
    "voice": "vo_adv_2217005_028",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "可是……",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n比起身形的變化，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那魔力的量，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n簡直超乎尋常。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不管是貪吃佩可公主、",
    "voice": "vo_adv_2217005_029",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "背面世界的公主們，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n還是其他七冠……",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "現在的妳，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "都能像大象踩死螞蟻一樣，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n一個人碾碎所有人吧？",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "雖然我不像霸瞳皇帝",
    "voice": "vo_adv_2217005_030",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "那麼擅長預測未來，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "但勝率",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "應該已經有",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "99.9％吧。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不過──",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不能忽略",
    "voice": "vo_adv_2217005_031",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "萬分之一的可能。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n所以這副模樣，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "也是顯現出我所害怕的風險。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n所謂[rub:・]一[/rub][rub:・]旦[/rub][rub:・]輸[/rub][rub:・]掉[/rub][rub:・]就[/rub][rub:・]結[/rub][rub:・]束[/rub]",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "的風險。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "承擔風險換來的魔力量……",
    "voice": "vo_adv_2217005_032",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "嗎？",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "不過，妳沒有必要冒險。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n畢竟，",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "[rub:我們]公主騎士[/rub]就是為此存在的。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "那就靠妳們了。",
    "voice": "vo_adv_2217005_033",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "而且──",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "M６號。",
    "voice": "vo_adv_2217005_034",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n神祕的否定者，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "也是登月實驗的受試者。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n多虧他的努力，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "LoA的資源化也有了相當大的進展。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "那麼……",
    "voice": "vo_adv_2217005_035",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n另外一張王牌也準備好了嗎？",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "嗯。",
    "voice": "vo_adv_2217005_036",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n還缺一點索爾龍孵化所需的",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "飼料。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "最後不只從天空，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "也要從地表吸取資源。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "然後──",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我會從內部破壞",
    "voice": "vo_adv_2217005_037",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n因封鎖模式而封閉的登入伺服器的門。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "應該已經找不到",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "解除程式了。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……對不起。",
    "voice": "vo_adv_2217005_038",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我還是",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "沒能完整想起",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "所謂的「現實世界」。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那扇",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "「登入伺服器的門」，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n是什麼樣子，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "又在哪裡？",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "「正門」",
    "voice": "vo_adv_2217005_039",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "位於非常顯眼的地方。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n另外還有１扇卻也是３扇的「後門」，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "則位於非常不顯眼的地方。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "呃……？",
    "voice": "vo_adv_2217005_040",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那是",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "什麼謎語嗎？",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不好意思，",
    "voice": "vo_adv_2217005_041",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我就直接了當地說吧。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n所謂的「正門」，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "就是位於蘭德索爾上空的",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "世界管理設施。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n俗稱",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "「索爾之塔」。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "啊……",
    "voice": "vo_adv_2217005_042",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那座飄在空中的塔。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n之前認識的人帶我導覽城鎮時，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "有說過名字。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n確實非常顯眼。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "所以……",
    "voice": "vo_adv_2217005_043",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "只要破壞索爾之塔，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "就能達成妳的目的嗎？",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不過破壞",
    "voice": "vo_adv_2217005_044",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "也是需要一點技巧的呢。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "就算失敗了，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n也可以去破壞「後門」。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "「後門」……",
    "voice": "vo_adv_2217005_045",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n妳剛才說，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "是非常不顯眼的對吧。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "而且，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "「１扇卻也是３扇」是什麼意思？",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "同一座設施",
    "voice": "vo_adv_2217005_046",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "同時存在於不同世界。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n名為",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "「反轉之塔」",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "──不對，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "在VR中，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "是叫做「顛倒之塔」吧。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n妳的故鄉，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "吉歐‧尼布爾黑爾的天空中也飄著一座喔。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "吉歐‧尼布爾黑爾的天空？",
    "voice": "vo_adv_2217005_047",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我從沒見過",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那種東西……",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "匿蹤──",
    "voice": "vo_adv_2217005_048",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "簡單來說，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n就是透過高等透明魔法，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "將其隱藏起來了。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不過……",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "現在，",
    "voice": "vo_adv_2217005_049",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "受到M６號導致天空「分解」的影響，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n似乎已經到了肉眼可見的狀態呢。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "真是僥倖。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "那麼，",
    "voice": "vo_adv_2217005_050",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n我們……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "對這裡進行戒備，",
    "voice": "vo_adv_2217005_051",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "以免有人阻撓。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n若是有人阻撓，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "就麻煩妳們處理了。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "still",
    "still_id": "end"
