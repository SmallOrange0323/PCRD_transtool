  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "わたしは、",
    "voice": "vo_adv_2217005_002",
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ユースティアナ・フォン・アストライア。",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nこの国のプリンセスの名において──",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "愛する人々も、",
    "voice": "vo_adv_2217005_003",
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "幸せな食卓も、",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nすべて……",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "わたしが、守る！",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "background",
    "bg_id": "502840"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "……アスト、",
    "voice": "vo_adv_2217005_004",
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "ライア……",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "background",
    "bg_id": "500204"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一騎打ちは、",
    "voice": "vo_adv_2217005_005",
    "unit_id": 180412
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ここまでです！！",
    "voice": null,
    "unit_id": 180412
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n超全力全開！！",
    "voice": null,
    "unit_id": 180412
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nプリンセスストライク──！！！",
    "voice": null,
    "unit_id": 180412
  },
  {
    "type": "background",
    "bg_id": "502840"
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "……アストライア……",
    "voice": "vo_adv_2217005_006",
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "アストライアぁぁあああっ……！！！",
    "voice": null,
    "unit_id": 193712
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "……ふぅん。",
    "voice": "vo_adv_2217005_007",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "貴女の怒りの炎、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "まだまだ消えてないみたいね。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "……当然です。",
    "voice": "vo_adv_2217005_008",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "\\nむしろ一秒ごとに膨れ上がっています。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "『奴』が今この瞬間も、",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "のうのうと息をしている。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "そう思うだけで……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "意気込み十分みたいで、",
    "voice": "vo_adv_2217005_009",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "安心したわ。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "でも……",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n次に戦うときは、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "私の目の届くところにしてね？",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "……っ。",
    "voice": "vo_adv_2217005_010",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "それは──",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "\\n私では、",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "ユースティアナに勝てないと……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "……いえ……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "……リーザ。",
    "voice": "vo_adv_2217005_011",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "\\n助太刀を、",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "してくれると？",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "まぁ、",
    "voice": "vo_adv_2217005_012",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "ね──",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "向こうはどうせ、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "数の暴力してくるでしょうし。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "私だって",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "性格の悪い[rub:レイス]幽霊[/rub]とかに恨まれてるから、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "背中を守ってくれる相手がいると助かるし。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "それに……",
    "voice": "vo_adv_2217005_013",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "怒りのあまり頭の血管が切れちゃっても",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n回復魔法で繋いであげられるしね？",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "……",
    "voice": "vo_adv_2217005_014",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "そんな手間をかけないで済むと、",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "良いのですが。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "ところで──",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "リーザ。",
    "voice": "vo_adv_2217005_015",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "王家の装備の『強欲』は、",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "器用に使いこなしているようですが。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "\\n幻境竜后の、",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "プリンセスナイトとしての能力のほうは？",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "\\nそれを使えば",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "覇瞳皇帝の元飼い猫に、",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "遅れを取ることもなかったのでは？",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "プリンセスナイトの能力……",
    "voice": "vo_adv_2217005_016",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "貴女みたいに、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "汎用性の高いモノだったら良かったんだけどね。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "どうも、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "相性が悪いっていうか──",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "貴女だって、",
    "voice": "vo_adv_2217005_017",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "少し前まで「怒りに呑まれるのが怖い」とかいって",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n『憤怒』の使用を渋っていたでしょう？",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "それと同じようなものよ。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "たぶんね。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "そう言われると、",
    "voice": "vo_adv_2217005_018",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "無理強いしにくいですが……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "\\nしかし……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "……そうね。",
    "voice": "vo_adv_2217005_019",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "そんな甘いことを言ってる場合じゃないかもね。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "それに……",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "background",
    "bg_id": "500521"
  },
  {
    "type": "background",
    "bg_id": "502840"
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "あのおかしな空を見ていると、",
    "voice": "vo_adv_2217005_020",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "否が応にもそう思うわ。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "どうなるにしろ……",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "そろそろ、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "終わりが近いんだって。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "……ええ。",
    "voice": "vo_adv_2217005_021",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "ですがもちろん、",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "終わるのは私たちではなく──",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "リーザ・フレイヤ",
    "words": "っ！？",
    "voice": "vo_adv_2217005_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "──この魔力って……",
    "voice": "vo_adv_2217005_023",
    "unit_id": 195214
  },
  {
    "type": "still",
    "still_id": "221609803"
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "もちろん、",
    "voice": "vo_adv_2217005_024",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "私ですよ。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "ただいま戻りました、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "二人とも。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "幻境竜后、",
    "voice": "vo_adv_2217005_025",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "その姿はっ……？",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "驚かせてしまって、",
    "voice": "vo_adv_2217005_026",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "ごめんなさい。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "先走った結果、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "本当に酷い目にあわされてしまって──",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n切り札の一つを、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "使わざるを得ませんでした。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "おかげで私は、",
    "voice": "vo_adv_2217005_027",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "この有様です。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n計算外の事態でした。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "で、",
    "voice": "vo_adv_2217005_028",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "でも……",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n身体の大きさより、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "その魔力の量。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n桁外れもいいところだわ。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "今の貴女なら",
    "voice": "vo_adv_2217005_029",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "ペコリーヌ姫たちも、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n裏世界のプリンセスたちも、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "他の七冠も……",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "象が蟻を踏むみたいに",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\nぜんぶ一人で捻り潰せるんじゃない？",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "覇瞳皇帝ほど、",
    "voice": "vo_adv_2217005_030",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "未来予測は得意ではありませんが",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "勝率は、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "99.9％",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "といったところでしょうか。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "ですが──",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "万が一を引く可能性は、",
    "voice": "vo_adv_2217005_031",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "ゼロにできません。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\nそしてこの姿は、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "私の恐れるリスクも顕在化してしまうのです。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n[rub:・]負[/rub][rub:・]け[/rub][rub:・]れ[/rub][rub:・]ば[/rub][rub:・]終[/rub][rub:・]わ[/rub][rub:・]り[/rub]、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "というリスクを。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "リスクを呑んだからこその魔力量……",
    "voice": "vo_adv_2217005_032",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "ということですか。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "ですが、貴方が危険を冒す必要はありません。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "\\nそのために、",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "[rub:われわれ]プリンセスナイト[/rub]がいるのですから。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "当てにしています。",
    "voice": "vo_adv_2217005_033",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "それに──",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "M６号。",
    "voice": "vo_adv_2217005_034",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n神秘の否定者にして、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "ムーンショット実験の被験者。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n彼が頑張ってくれたおかげで、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "LoAのリソース化がだいぶ進みました。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "では……",
    "voice": "vo_adv_2217005_035",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "フレイヤ",
    "words": "\\nもう一つの切り札の用意が？",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "ええ。",
    "voice": "vo_adv_2217005_036",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\nソルドラゴンが孵化するまでに必要なエサは、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "あと少し。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "最後は空からだけでなく、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "地表からもリソースを吸い上げて。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "そして──",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "BANモードによって閉鎖されたログインサーバーの扉を、",
    "voice": "vo_adv_2217005_037",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n内側から破壊します。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "解除プログラムは、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "もう見つからないでしょうし。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "……ごめんなさい。",
    "voice": "vo_adv_2217005_038",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "私はまだ、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "ちゃんと『現実の世界』っていうのを",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n思い出せていないんだけど。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "その",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "『ログインサーバーの扉』っていうのは",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\nどんなかたちをしていて、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "どこにあるの？",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "『表玄関』は、",
    "voice": "vo_adv_2217005_039",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "とても目立つ場所にあり。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\nもう１つにして３つの『裏口』は、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "とても目立たない場所にあります。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "えっと……？",
    "voice": "vo_adv_2217005_040",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "それは、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "謎々か何かかしら。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "失礼、",
    "voice": "vo_adv_2217005_041",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "単刀直入に言いましょう。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n『表玄関』とは、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "ランドソルの上空にある",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "世界の管理施設。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n通称",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "『ソルの塔』です。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "あぁ……",
    "voice": "vo_adv_2217005_042",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "あの空に浮かんだ塔。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n知り合いに街を案内してもらったとき、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "名前を教えてもらったわ。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n確かによく目立っていたけれど。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "じゃあ……",
    "voice": "vo_adv_2217005_043",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "ソルの塔を壊せば、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "貴女の目的は達成されるの？",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "壊し方にも、",
    "voice": "vo_adv_2217005_044",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "少々コツがいりますけれどね。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\nそれに、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "もし失敗したとしても",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n『裏口』のほうを壊すという手もあります。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "『裏口』……",
    "voice": "vo_adv_2217005_045",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\nそっちは、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "とても目立たないって言ってたわね。",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "それに、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "「１つにして３つ」って？",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "同じ施設が、",
    "voice": "vo_adv_2217005_046",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "違う世界に同時に存在しているのです。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n名を",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "『リバースタワー』",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "──いえ、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "VRでは",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "『さかさまの塔』でしたか。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\nあなたの故郷、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "ジオ・ニヴルヘルの空にも浮かんでいるのですよ。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "ジオ・ニヴルヘルの空に？",
    "voice": "vo_adv_2217005_047",
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "\\n",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "そんなもの、",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "リーザ",
    "words": "見たことないけれど……",
    "voice": null,
    "unit_id": 195214
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "ステルス──",
    "voice": "vo_adv_2217005_048",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "あなたにも分かりやすく言えば、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n高度な透明化の魔法によって",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "隠蔽されているのです。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "ですが。",
    "voice": null,
    "unit_id": 107412
