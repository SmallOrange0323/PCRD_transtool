    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\nおかしい、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "ですね。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "すでに、",
    "voice": "vo_adv_2217005_073",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "ランドソルの五芒星を埋め尽くすほどの",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\nログインがあってしかるべきなのに。",
