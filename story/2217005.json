    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "いえ。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\nBANモードでないなら、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "億単位のアクセスにも耐えられる設計のはず。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "ならば、",
    "voice": "vo_adv_2217005_075",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "なぜ？",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "塔の破壊を、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "やりすぎてしまった？",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\nそれとも、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "私の知らない隠しコマンドで",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "ログインが阻害されている？",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "違いますね。",
    "voice": "vo_adv_2217005_076",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\nこれは……",
    "voice": null,
    "unit_id": 107412
  },
