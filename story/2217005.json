    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "入念で、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "根気強く、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "我慢強かった。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "いえ。",
    "voice": "vo_adv_2217005_069",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "\\nまだ、",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境竜后",
    "words": "気を抜いてはいけない。",
