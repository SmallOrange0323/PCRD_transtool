  },
  {
    "type": "dialogue",
    "name": "青年１",
    "words": "とりあえず店の近くで寝ちまったやつは",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "青年１",
    "words": "\\n運んできたけどよぉっ……！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "青年２",
    "words": "いったい、",
    "voice": "vo_adv_2217005_060",
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "青年２",
    "words": "何が起こってるんだっ……！？",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "青年２",
    "words": "\\n建物や車の中とかなら、",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "青年２",
    "words": "多少はマシっぽいけど……",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "青年１",
    "words": "このままじゃ、",
