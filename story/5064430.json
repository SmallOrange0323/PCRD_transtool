  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我說啊，",
    "voice": "vo_adv_5064430_000",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n雖然現在講這個有點晚。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但同時辦運動會跟文化祭，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "妳們不覺得這樣根本腦袋有問題嗎？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "真的是挺晚的呢。",
    "voice": "vo_adv_5064430_001",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "雖然說得沒錯。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "而且，",
    "voice": "vo_adv_5064430_002",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "再仔細想想，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "時間根本不夠吧？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "體力也不夠呢。",
    "voice": "vo_adv_5064430_003",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就像是",
    "voice": "vo_adv_5064430_004",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "因為牛排跟蛋糕都很好吃，\\n所以混在一起一定更好吃，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這種爆炸性的謬論呢。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "噗……",
    "voice": "vo_adv_5064430_005",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這間學校，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真的沒問題嗎？",
    "voice": null,
    "unit_id": 116211
  }
]
