[
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "祈梨拿著席茲爺爺給的「年神祭參加券」，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n和{0}來到了懷舊點心店。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "這個是",
    "voice": "vo_adv_1283002_000",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "「年神祭參加券」……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "什麼？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "妳贏了席茲爺爺嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "爺爺跟我說了什麼神的寶座……",
    "voice": "vo_adv_1283002_001",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "然後要我來這邊詢問詳細的內容。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "嗯，",
    "voice": "vo_adv_1283002_002",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "好吧。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "既然妳手上有參加券，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "就表示妳有詢問的資格。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "妳知道，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "這條巷子的深處有一座小小的祠堂嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "祠堂……",
    "voice": "vo_adv_1283002_003",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我記得",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是一座很小很小的對吧。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這麼說來，那邊有時候好像會有一些裝飾……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "那個是來自東國的喔。",
    "voice": "vo_adv_1283002_004",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n在這一帶也不乏有人供奉祭祀。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "到這邊為止的情報其實也並沒有刻意隱瞞。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳說到這邊為止，",
    "voice": "vo_adv_1283002_005",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "聽妳的說法，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就表示在那之後還有些什麼對吧……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "沒錯。",
    "voice": "vo_adv_1283002_006",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "只有有資格的人才能獲得傳承，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n接下司掌那間祠堂一整年的年神。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "實際上祈梨妳也不知道這件事，對吧？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "年神……",
    "voice": "vo_adv_1283002_007",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那的確是神的寶座呢……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這件事感覺大有搞頭啊！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "不過，",
    "voice": "vo_adv_1283002_008",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "年神祭畢竟是對那座祠堂的供奉。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n因為是喜慶，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "所以絕對不能見血。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "也就是說，",
    "voice": "vo_adv_1283002_009",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要和持有這張奇怪票券的傢伙戰鬥，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對吧？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "透過",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "新年的遊戲！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "真是一點就通呢。",
    "voice": "vo_adv_1283002_010",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n就是這麼一回事。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "那麼……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "妳打算怎麼做呢？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是愚蠢的問題呢！",
    "voice": "vo_adv_1283002_011",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "當然是只有",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "「參加」這個選項啊！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我要",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "成為新時代的神！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "這樣啊。",
    "voice": "vo_adv_1283002_012",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "那麼就往這邊走吧。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "接下來要比的是……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "打陀螺！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "background",
    "bg_id": "500893"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我們就這樣",
    "voice": "vo_adv_1283002_013",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "來到了什麼第一場戰鬥……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說是要比打陀螺，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n不過這個場地，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "看來要比的是激鬥陀螺吧。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哈──哈哈哈──！",
    "voice": "vo_adv_1283002_014",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這下贏定啦！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n居然要跟我比賽激鬥陀螺，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "雖然不知道對手是誰，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但只能送他一個慘字啦！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "少年等人",
    "words": "那可不好說！",
    "voice": "vo_adv_1283002_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這、",
    "voice": "vo_adv_1283002_016",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這個聲音是！？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "嘿嘿，",
    "voice": "vo_adv_1283002_017",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "沒想到祈梨姐姐也有參加呢！",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "復仇的機會來了！",
    "voice": "vo_adv_1283002_018",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "讓妳看看我們脫胎換骨後的實力吧！",
    "voice": "vo_adv_1283002_019",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哈！",
    "voice": "vo_adv_1283002_020",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還以為是誰，原來是你們啊。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你們該不會",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要三個人打我一個吧？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過也沒關係啦。",
    "voice": "vo_adv_1283002_021",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "管你是三個人還是多少人，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "儘管放馬過來！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你們這些雜魚連我的一根指頭都動不了，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "根本就不足為懼！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唉～",
    "voice": "vo_adv_1283002_022",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這場仗顯然已經贏定了呢。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "看我一擊",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就把你們幾個都收拾掉！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "事情有這麼簡單嗎？",
    "voice": "vo_adv_1283002_023",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "等妳看到我們的全新力量，肯定會嚇一跳的。",
    "voice": "vo_adv_1283002_024",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "好了好了，",
    "voice": "vo_adv_1283002_025",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "在那之前，我們先完成裝備檢查吧。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼，",
    "voice": "vo_adv_1283002_026",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還有裝備檢查啊……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
