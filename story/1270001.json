    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "好厲害……",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花的身體",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "好像要燒起來一樣……！",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊啊～！",
    "voice": "vo_adv_1270001_061",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n虐待狂先生",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "正看著在熾熱沙灘上痛苦扭動的空花……！",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n這樣有讓你滿足嗎～？",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻……",
    "voice": "vo_adv_1270001_062",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "流口水～♪",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……我",
    "voice": "vo_adv_1270001_063",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "棄權……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……我也是……",
    "voice": "vo_adv_1270001_064",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這不是抱著遊玩心態能夠參加的慶典……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻，",
    "voice": "vo_adv_1270001_065",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻～",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊，",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "對了！",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n差不多",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "該前往會場才行呢……！",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花差點",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就因為眼前的快樂",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "而忘記目的了……！",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "被虐狂夏日慶典，",
    "voice": "vo_adv_1270001_066",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "看來會是個超開心的慶典呢～♪",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "空花以一如往常的言行舉止使周遭喪失了鬥志。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n對於在熱沙道路上悠然前進的她，有一群人露出了充滿興趣的眼神。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女被虐狂",
    "words": "哦……",
    "voice": "vo_adv_1270001_067",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女被虐狂",
    "words": "那孩子，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女被虐狂",
    "words": "挺有意思的嘛。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "在火熱的沙灘上居然也能笑著。",
    "voice": "vo_adv_1270001_068",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "看來她說不定和我們一樣",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "也是貨真價實的呢。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "女被虐狂",
    "words": "哼，",
    "voice": "vo_adv_1270001_069",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女被虐狂",
    "words": "這可不好說。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女被虐狂",
    "words": "\\n那點程度居然就說是貨真價實，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女被虐狂",
    "words": "你的標準也變低了呢？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "究竟是不是貨真價實，馬上就會揭曉了。",
    "voice": "vo_adv_1270001_070",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "\\n畢竟只要進入正式比賽，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "就會直接對上我們啊。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "受虐狂們",
    "words": "呵呵呵呵呵……",
    "voice": "vo_adv_1270001_071",
    "unit_id": null
  }
]
