[
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "喔喔喔喔喔喔喔喔！",
    "voice": "vo_adv_5111321_000",
    "unit_id": 17212
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "可惡，",
    "voice": "vo_adv_5111321_001",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這傢伙外觀雖然好看，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n但是戰鬥方式",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "卻挺下流的……！",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就算躲過寶石攻擊，",
    "voice": "vo_adv_5111321_002",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也會因為鎖鏈而無法靠近……",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這樣有點犯規呢……",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊──討厭！",
    "voice": "vo_adv_5111321_003",
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "超煩躁的！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂，尾狗刀！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "有沒有什麼好計策？",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是啊，",
    "voice": "vo_adv_5111321_004",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們都是肌肉笨蛋，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "拜託你想些簡單易懂的好主意吧。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？",
    "voice": "vo_adv_5111321_005",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "應該沒有把我算在肌肉笨蛋裡面吧？",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒有對吧？",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "好吧，",
    "voice": "vo_adv_5111321_006",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "畢竟這種工作從以前就是我在負責的。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我看看，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "他發動寶石攻擊的同時，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "似乎還另有目的。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是、",
    "voice": "vo_adv_5111321_007",
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是這樣嗎！？",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "仔細觀察就能知道了，",
    "voice": "vo_adv_5111321_008",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我猜他應該是在將力量累積到鎖鏈上。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "要是被他集滿了會很不妙，但是，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "如果在那之前阻止他，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "應該就能找到勝算。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哇──",
    "voice": "vo_adv_5111321_009",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "果然看起來可疑的傢伙腦袋都比較好。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n就像我家老大一樣啊。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "……",
    "voice": "vo_adv_5111321_010",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我就當作妳在稱讚我囉。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "謝了，",
    "voice": "vo_adv_5111321_011",
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "尾狗刀！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "既然知道亞斯來的目的了，",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那就一鼓作氣衝吧──！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嗯～這種感覺，",
    "voice": "vo_adv_5111321_012",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "就像回到了那個時候呢。",
    "voice": null,
    "unit_id": 106211
  }
]
