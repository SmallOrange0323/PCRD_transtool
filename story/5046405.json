    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這裡是選手們",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "實現夢想的地方，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我們一起守護它吧～！",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯！",
    "voice": "vo_adv_5046405_002",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我也會繼續努力，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "為追夢的大家加油──！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "請你也",
    "voice": "vo_adv_5046405_003",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "再把力量借給我們一下下喔。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "只要堅持到最後一刻不放棄，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "無論是什麼樣的困境",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "都一定能夠逆轉勝的。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就讓我們來證明，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "努力終將會有回報吧～！",
    "voice": null,
    "unit_id": 113511
  }
