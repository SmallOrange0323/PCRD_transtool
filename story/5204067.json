  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "真璃路過公園時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n彩羽跟苑正在玩的身影映入眼簾。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "……哎呀，",
    "voice": "vo_adv_5204067_000",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "那是隔壁鄰居。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "彩羽、",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "苑小姐，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "妳們──",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "碰！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "咦咦？",
    "voice": "vo_adv_5204067_001",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "撞到了！？",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "沒事吧……！？",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "唔唔……",
    "voice": "vo_adv_5204067_002",
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "痛痛痛。",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "喂，彩羽！",
    "voice": "vo_adv_5204067_003",
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n妳不要莫名其妙到處跑啦，",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "很危險啊……！",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "……咦？",
    "voice": "vo_adv_5204067_004",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_5204067_005",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "抱歉喔，小苑！",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n請原諒我吧──！！",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "等……",
    "voice": "vo_adv_5204067_006",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "怎麼回事……！？",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "該不會是",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "撞到的瞬間交換了之類的……",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "不不，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "不可能有那種事吧！？",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "真是的，彩羽，",
    "voice": "vo_adv_5204067_007",
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n壞孩子要打屁股喔。",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嗯……",
    "voice": "vo_adv_5204067_008",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "一直以來抱歉了。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "彩羽",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "會成為不讓小苑生氣的好孩子喔。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "咦……？",
    "voice": "vo_adv_5204067_009",
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "唔、",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嗯，",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "沒錯喔，",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "那樣很好喔。",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "彩羽",
    "voice": "vo_adv_5204067_010",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "之後也會多幫忙家裡的喔！",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "會努力用功，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "社團也會加油！",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n不會挑食，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "每天也會捶小苑的肩膀",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "的！",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……欸！？",
    "voice": "vo_adv_5204067_011",
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽才不會做那種事……",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……",
    "voice": "vo_adv_5204067_012",
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "那樣的話……",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "欸嘿嘿……",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "唔",
    "voice": "vo_adv_5204067_013",
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "唔唔……",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "我可是老眼昏花了啊～",
