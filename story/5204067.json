    "type": "dialogue",
    "name": "彩羽",
    "words": "啊，",
    "voice": "vo_adv_5204067_017",
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "小苑有反應了！",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "交換比賽",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "是彩羽贏了──♪",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……這竟然是比賽啊。",
    "voice": "vo_adv_5204067_018",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "啊，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "真璃，辛苦了～",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "……妳好。",
    "voice": "vo_adv_5204067_019",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "……是交換比賽啊。",
    "voice": "vo_adv_5204067_020",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n演得還真像呢……",
