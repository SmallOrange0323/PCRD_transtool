    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……啊？",
    "voice": "vo_adv_5204067_014",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "咿咿……",
    "voice": "vo_adv_5204067_015",
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "肩膀也",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "舉不起來了……",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "啊嗚！？",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "腰、",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "腰",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
