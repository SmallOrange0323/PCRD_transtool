[
  {
    "type": "background",
    "bg_id": "501680"
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "よーし、",
    "voice": "vo_adv_5142701_000",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "この辺りの魔物は片付いたなっ。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\nみんな",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "休憩に入れー！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "新兵たち",
    "words": "はい、",
    "voice": "vo_adv_5142701_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "新兵たち",
    "words": "教官！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "しかし、",
    "voice": "vo_adv_5142701_002",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "魔物が山ほどいるとは聞いていましたが。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n本当に",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "次から次へと湧いてきますわね。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "ま、",
    "voice": "vo_adv_5142701_003",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "想像してた通りではあるさ。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "実戦経験を積むにもちょうどいいだろ。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "お疲れさま。",
    "voice": "vo_adv_5142701_004",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n魔物の掃討は順調に進んでいるようだね。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "ああ、",
    "voice": "vo_adv_5142701_005",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "おかげさまで。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n新兵もしっかり戦えてるし、",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "エリコも……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "クスクス……",
    "voice": "vo_adv_5142701_006",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "忌々しい魔物たちですが、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n私たちが愛を育むための糧になると思えば、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\nかわいらしいものですわね。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "うん、",
    "voice": "vo_adv_5142701_007",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "エリコも力が入ってるぜ。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "……動機はちょっと不純だけどな。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "それはよかった。",
    "voice": "vo_adv_5142701_008",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\nならこの訓練も、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "次の課程に進んで問題なさそうだね。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "え？　",
    "voice": "vo_adv_5142701_009",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "まだ何かやるのか？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "やること自体はこれまでと同じ、",
    "voice": "vo_adv_5142701_010",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "協力して魔物を倒すだけさ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\nただ次はゴール地点を設けず、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "隊列が保てる限り",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n行軍を続けてもらいたい。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "要するに、",
    "voice": "vo_adv_5142701_011",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "進めるところまで進むってことか。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "ほんっと、",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "無茶振りが多い騎士団だな……！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "問題ありませんわ。",
    "voice": "vo_adv_5142701_012",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n彼らの実力を考えれば不可能ではありませんし、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "それに……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "新兵１",
    "words": "追加の訓練って聞いてびっくりしたけど、",
    "voice": "vo_adv_5142701_013",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新兵１",
    "words": "\\n魔物もそんなに強くないみたいでよかったよ。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新兵２",
    "words": "むしろ",
    "voice": "vo_adv_5142701_014",
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "新兵２",
    "words": "俺たちが強すぎるのかもしれないな！",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "新兵２",
    "words": "\\nこれなら",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "新兵２",
    "words": "騎士団でもどんどん出世できそうだぜ！",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "思った通り、",
    "voice": "vo_adv_5142701_015",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "敵を侮り慢心する輩が出る頃合いですので。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "教育し甲斐がありそうです……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "クスクスクス♪",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "おーい、",
    "voice": "vo_adv_5142701_016",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "エリコ？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n新兵にお仕置きするのがメインじゃないから、",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "そこは忘れんなよ？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "さあみなさん……",
    "voice": "vo_adv_5142701_017",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "いえ、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "思い上がったゴミ虫たち。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "これより先には",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "今までと別次元の地獄が待っていますので、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "お覚悟を。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "新兵たち",
    "words": "い、",
    "voice": "vo_adv_5142701_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "新兵たち",
    "words": "イエスマム！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "……ま、",
    "voice": "vo_adv_5142701_019",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "油断禁物なのは確かだしな。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\nあたしたちも、",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "気合入れ直していくかっ！",
    "voice": null,
    "unit_id": 129811
  }
]
