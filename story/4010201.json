  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯呵呵♪",
    "voice": "vo_adv_4010201_000",
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n真開心呢～",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "跟幼稚園的大家一起辦慶生會。",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我也要謝謝你",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "協助孩子們進行準備。",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大家為了我，",
    "voice": "vo_adv_4010201_001",
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "畫了肖像畫與摺了摺紙……",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "成了一場非～",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "常棒的生日。",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我發自內心覺得……",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "能成為保母真是太好了。",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "咦？",
    "voice": "vo_adv_4010201_002",
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "孩子們都已經",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "回家……",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀～！",
    "voice": "vo_adv_4010201_003",
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n包裝精美的盒子……",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這是",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "生日禮物嗎？",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不是跟",
    "voice": "vo_adv_4010201_004",
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "孩子們一起送的……",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是你個人送的？",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀。",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "莫非，",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你是想獨占",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "老師開心的笑容嗎？",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真是貪心呢……♪",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那麼，",
    "voice": "vo_adv_4010201_005",
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "可以讓我打開嗎？",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀～！",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n是一條可愛的緞帶♪",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是你為我選的嗎？",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯呵呵♪",
    "voice": "vo_adv_4010201_006",
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我會非常",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "珍惜地",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "配戴它的。",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "對了……",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "第一次，",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就託付給你吧。",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這條緞帶。",
    "voice": "vo_adv_4010201_007",
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n第一次配戴它……",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我想拜託你。",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……",
    "voice": "vo_adv_4010201_008",
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你願意幫我繫上嗎？",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "配戴上這個後……",
    "voice": "vo_adv_4010201_009",
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n感覺就像你",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "一直陪伴在我身邊。",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 101533
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯呵呵♪",
    "voice": null,
    "unit_id": 101533
  }
]
