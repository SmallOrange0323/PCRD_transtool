  },
  {
    "name": "旁白",
    "words": "格蕾斯因為春天的變疑分子騷動，",
    "voice": null
  },
  {
    "name": "旁白",
    "words": "使得守護騎士一職遭到解任。",
    "voice": null
  },
  {
    "name": "旁白",
    "words": "\\n在順利解決騷動後，",
    "voice": null
  },
  {
    "name": "旁白",
    "words": "她準備回去吉歐‧尼布爾黑爾以恢復守護騎士身分。\\n而啟程的日子越來越接近了。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "我的尼特族生活到此結束。",
    "voice": "vo_adv_1389001_000"
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "我一定會通過錄用考試，",
    "voice": null
  },
  {
