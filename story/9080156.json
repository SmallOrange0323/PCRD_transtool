[
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哦～",
    "voice": "vo_adv_9080156_000",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呵呵呵呵呵",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呵…………",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "倒地。",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "雖然打倒敵人了……",
    "voice": "vo_adv_9080156_001",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "但華音小姐也倒下了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "明明身中那麼大量的詛咒，",
    "voice": "vo_adv_9080156_002",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n居然還能打倒敵人，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真令人佩服。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "失算的是，",
    "voice": "vo_adv_9080156_003",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n就算",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "魔物死了，詛咒還是",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "存在著。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "已經沒救了嗎？",
    "voice": "vo_adv_9080156_004",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我正在",
    "voice": "vo_adv_9080156_005",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "嘗試中和詛咒。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n雖然只有手邊現有的素材，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但加上藥草，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "應該能補強效果。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n理論上應該是可行的……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不行呢。",
    "voice": "vo_adv_9080156_006",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "別說什麼",
    "voice": "vo_adv_9080156_007",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不行啊！？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這也沒辦法，",
    "voice": "vo_adv_9080156_008",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我已經盡我所能了。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "之後就看她自己的造化了。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們走吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嗯，說得也是。",
    "voice": "vo_adv_9080156_009",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n我得回去寫報告書才行。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "而且彩羽她們也在等我們。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n該買什麼伴手禮好呢～？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……看我的喔喔喔喔！",
    "voice": "vo_adv_9080156_010",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "本小姐，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "大‧",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "復‧",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "活～～！！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "那種寒酸的詛咒，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "怎麼可能殺得死本小姐啊！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "鐘聲",
    "voice": "vo_adv_9080156_011",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "已經不會再響了對吧！？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "也就是說……",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "這場勝負，",
    "voice": "vo_adv_9080156_012",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "是本小姐贏了！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哦～",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呵呵呵呵！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……話說。",
    "voice": "vo_adv_9080156_013",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "為什麼沒半個人在啊？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……嗯？",
    "voice": "vo_adv_9080156_014",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "這塊立牌是什麼？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "「華隸大小姐華音　",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "在此長眠」",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "什麼啊啊啊啊！？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "到底是誰製作了這種莫名其妙的立牌啊！？",
    "voice": "vo_adv_9080156_015",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "給我等一下！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我才沒死呢！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n話說回來──",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "妳們應該要待到最後，",
    "voice": "vo_adv_9080156_016",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "見證我華麗的復活啊────！！！",
    "voice": null,
    "unit_id": 134912
  }
