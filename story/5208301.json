[
  {
    "type": "dialogue",
    "name": "怜",
    "words": "志那都！",
    "voice": "vo_adv_5208301_000",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n埃拉他們也在另一個世界努力著！",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我們也要一口氣打倒敵人！",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "怜，",
    "voice": "vo_adv_5208301_001",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "妳變得可靠許多了呢。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n我的背後就交給妳了。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……妳可別輸了，",
    "voice": "vo_adv_5208301_002",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "埃拉。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……！",
    "voice": "vo_adv_5208301_003",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n那當然囉，志那都！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……咦？",
    "voice": "vo_adv_5208301_004",
    "unit_id": 135711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n怎麼了嗎？埃拉。",
    "voice": null,
    "unit_id": 135711
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我剛才，",
    "voice": "vo_adv_5208301_005",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "聽見了風的聲音喔！",
    "voice": null,
    "unit_id": 135512
  }
]
