[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『阿囉哈～☆』",
    "voice": "vo_adv_1058004_000",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『真難得會在中午遇到你，",
    "voice": "vo_adv_1058004_001",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n待會是要去吃午餐嗎？』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『我的肚子也餓得咕嚕咕嚕叫",
    "voice": "vo_adv_1058004_002",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n方便的話，一起去用餐吧』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『嘻嘻，",
    "voice": "vo_adv_1058004_003",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我又發現了一間好吃的店喔～！』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『那間店算是我現在打工的餐廳",
    "voice": "vo_adv_1058004_004",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n的對手店吧？』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『店長要我去那裡偵察敵情，",
    "voice": "vo_adv_1058004_005",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒想到我一去就被他們的美食俘虜了呢！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "太讚了吧☆』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『現在每天都要\\n來這間店報到呢～♪』",
    "voice": "vo_adv_1058004_006",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『啊這樣不行，",
    "voice": "vo_adv_1058004_007",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這是背叛我打工地方的行為！』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『可是啊，",
    "voice": "vo_adv_1058004_008",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n他們的東西實在太好吃了。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "特別是那散壽司，堪稱一絕……☆』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『…………』",
    "voice": "vo_adv_1058004_009",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『……難道。",
    "voice": "vo_adv_1058004_010",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你跟其他人一樣。』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『你也",
    "voice": "vo_adv_1058004_011",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n忘記我了嗎？』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『嗯嗯？",
    "voice": "vo_adv_1058004_012",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯～？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你好像還記得我吧？』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『那為什麼要無視我……？",
    "voice": "vo_adv_1058004_013",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我說話還蠻大聲的，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我不認為你會沒聽到？』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『咦，你聽不懂我在說什麼？",
    "voice": "vo_adv_1058004_014",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你問我是說哪國的語言？』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『啊～……",
    "voice": "vo_adv_1058004_015",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "抱歉！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這種事偶爾也會發生呢！』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『我明明就普通地說話，",
    "voice": "vo_adv_1058004_016",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但不知道為什麼，就是沒辦法溝通！』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『在遇到你們之前，",
    "voice": "vo_adv_1058004_017",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我也沒跟其他人說過什麼話，所以忘記了』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『過了一段時間後，",
    "voice": "vo_adv_1058004_018",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n又很自然地能溝通了……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "即使這麼說，你也沒有頭緒吧，嗯？』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『啊？",
    "voice": "vo_adv_1058004_019",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好像有什麼在發光？』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『這這這、這是怎麼回事？",
    "voice": "vo_adv_1058004_020",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "難道這也是因為我的關係嗎……？』",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你好。",
    "voice": "vo_adv_1058004_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不好意思……",
    "voice": "vo_adv_1058004_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n可以借我一下mimi嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊……",
    "voice": "vo_adv_1058004_023",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nNO，不是耳朵。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是mimi，OK～？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "YES，是攜帶型終端！",
    "voice": "vo_adv_1058004_024",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "太讚了吧☆",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "謝謝！",
    "voice": "vo_adv_1058004_025",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我可以使用一下mimi嗎？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "拜託你。",
    "voice": "vo_adv_1058004_026",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我現在很困擾。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯～？",
    "voice": "vo_adv_1058004_027",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你說的是英文吧……？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "抱歉，你的發音我聽不懂。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我的母語不是英文。",
    "voice": "vo_adv_1058004_028",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我英文不是很拿手，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊……",
    "voice": "vo_adv_1058004_029",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我可以使用mimi的翻譯功能嗎？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我想要用它來翻譯，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『……嗯，好。",
    "voice": "vo_adv_1058004_030",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n非常謝謝你～",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這世上還是有好人的呢♪』",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『你能借我mimi，真是幫了大忙。",
    "voice": "vo_adv_1058004_031",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我的mimi突然一點反應也沒有，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n讓我很困擾呢。』",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『是的。",
    "voice": "vo_adv_1058004_032",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我正在用mimi的翻譯功能跟你說話……』",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『我也正在學習日文喔～",
    "voice": "vo_adv_1058004_033",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "日文的文法跟我的母語差異很大，學習上很困難♪』",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『啊哈哈。",
    "voice": "vo_adv_1058004_034",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我的國家在數位機械的發展上，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "跟日本比起來還落後很多。』",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『mimi也常常故障呢～",
    "voice": "vo_adv_1058004_035",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n真令人困擾。』",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『話雖如此。",
    "voice": "vo_adv_1058004_036",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n父親大人跟我說，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n要盡量使用國產的產品～』",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "『說真的……",
    "voice": "vo_adv_1058004_037",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我在日本停留的期間，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
