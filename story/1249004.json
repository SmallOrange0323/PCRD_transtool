[
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接受矛依未的提案，嘉夜放棄了能夠解放「樂園的居民」的力量。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而在過了幾天後，{0}在小巷中",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n遇見陷入了沉思的嘉夜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……嗯？",
    "voice": "vo_adv_1249004_000",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哦，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是你啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "怎麼了，",
    "voice": "vo_adv_1249004_001",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "發生什麼事了嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n從樂園的騷動之後，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這邊、這附近的圈子都很和平。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……和平到讓人覺得有點過頭了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還說這種話……",
    "voice": "vo_adv_1249004_002",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我看你是又來要我請客吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "之前是我請的，",
    "voice": "vo_adv_1249004_003",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這次該換你請了吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你要請的話我是可以陪你吃飯。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我……",
    "voice": "vo_adv_1249004_004",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "在想些事情。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n從那種大騷動突然變得和平，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n害我跟著沒事做了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "該怎麼說啊，",
    "voice": "vo_adv_1249004_005",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就內心深處有種煩悶的感覺……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n所以就稍微",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "陷入了沉思。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不，",
    "voice": "vo_adv_1249004_006",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真的沒什麼大不了的。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n只是",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒有揮拳的機會時，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就是會莫名其妙想太多呢……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哈哈，",
    "voice": "vo_adv_1249004_007",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真不像我呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "可能是疲勞還沒完全恢復吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "總覺得",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "眼前也在閃爍──",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不對，",
    "voice": "vo_adv_1249004_008",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是你在發光吧！？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在街角看到嘉夜，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n本打算要向她打招呼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n卻發現她被不良學生們包圍著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "──所以說！",
    "voice": "vo_adv_1249004_009",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我就說我拒絕了！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n為什麼總是要把我扯進你們跟笨蛋大哥之間的事啊！？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "喂喂，",
    "voice": "vo_adv_1249004_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "也沒什麼好生氣的吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "\\n只是幫我們傳個話而已啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "妳就想成是在幫助我們嘛，",
    "voice": "vo_adv_1249004_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "是幫助人喔，幫助人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "\\n如果是重要的妹妹拜託，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "他也會聽的對吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哈，",
    "voice": "vo_adv_1249004_012",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真丟臉。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "明明就在那邊耍狠，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n到了緊要關頭卻是拜託大哥、",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "拜託我……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你們根本沒有揍人的膽識吧？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "妹妹",
    "voice": "vo_adv_1249004_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "妳還真老套耶～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "\\n時下的打架啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "可不是靠拳頭而是靠人脈喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "對啊對啊，",
    "voice": "vo_adv_1249004_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "就是所謂的情報戰。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "用社群媒體之類的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "要不然妹妹來也可以喔？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "\\n妹妹妳也有",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "練空手道對吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_1249004_015",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是又如何？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "哦，",
    "voice": "vo_adv_1249004_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "真的假的？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "我還是第一次聽說耶，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "是哪來的資訊啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "真的真的。",
    "voice": "vo_adv_1249004_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "而且妹妹她啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "\\n聽說還在空手道的比賽中",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "把對手打到送醫院對吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "…………！",
    "voice": "vo_adv_1249004_018",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這、",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這些事",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是從哪……？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "私帳啦，",
    "voice": "vo_adv_1249004_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "私帳。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "裝得一副不打架的清高模樣，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "\\n但結果",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "妹妹妳還是跟我們一樣吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "我們好好相處嘛。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你……",
    "voice": "vo_adv_1249004_020",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "如果再繼續說下去，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我絕不饒你。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n絕對不會放過你……！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "！",
    "voice": "vo_adv_1249004_021",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……學長！？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "啊？",
    "voice": "vo_adv_1249004_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "你是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "怎樣啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "\\n我們現在",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子１",
    "words": "正在談事情──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "──",
    "voice": "vo_adv_1249004_023",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好耶，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你來得正好！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "學長！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "快跑！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這邊這邊！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "啊，",
    "voice": "vo_adv_1249004_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "可惡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "該死……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "\\n唔喔，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "那傢伙是怎樣啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良分子２",
    "words": "跑有夠快！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "噗、",
    "voice": "vo_adv_1249004_025",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊哈哈！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那些傢伙跑有夠慢的啦！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n──好啦，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "學長！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "快點快點！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "跟上我！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "background",
    "bg_id": "510150"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯～",
    "voice": "vo_adv_1249004_026",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "盡情跑了一趟呢。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "心臟就快爆炸了……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那些傢伙啊，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "因為也沒什麼真的打過架，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n馬上就喘不過氣來了。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "順利甩掉他們了呢！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊哈，",
    "voice": "vo_adv_1249004_027",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這次是我牽著學長的手……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n改天有機會就反過來吧。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣做過之後其實滿有趣的耶。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n就像電影場景一樣，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真刺激。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但",
    "voice": "vo_adv_1249004_028",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "學長出現真是幫了大忙～",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那些傢伙",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真的超級纏人的……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……嗯。",
    "voice": "vo_adv_1249004_029",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真的幫了大忙。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我差點氣昏頭，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不知道要做出什麼事來。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "──呼，",
    "voice": "vo_adv_1249004_030",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "久違地跑步都流汗了呢～",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n啊哈哈，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "學長也滿身大汗嘛。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "既然都逃到咖啡廳來了，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n就點個飲料吧！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我要",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "多糖咖啡歐蕾！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊，",
    "voice": "vo_adv_1249004_031",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "學長你看！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這間咖啡廳",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "有賣肉包耶！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還說是店家手作的，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就點來試試看吧！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "其他就……",
    "voice": "vo_adv_1249004_032",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "麵類也有很多種耶！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n誇張，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "都是一堆大份量的主餐嘛。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這家店也真奇怪。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "只是我啊，",
    "voice": "vo_adv_1249004_033",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不管是甜的還是鹹的還是大份量的都喜歡就是了。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n讓我對這家店有點一見鍾情耶，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "或許會變成常客吧。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "咖啡歐蕾也很好喝，",
    "voice": "vo_adv_1249004_034",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "很適合當避難所。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n之後要是再被纏上，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "逃來這邊好像不錯……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……啊哈哈，",
    "voice": "vo_adv_1249004_035",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "果然",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "被你聽到了啊。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "──如果是跟學長說的話，",
    "voice": "vo_adv_1249004_036",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "已經沒關係了吧。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我放棄空手道的理由，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "其實不只一個。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……瞞著你真抱歉。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "之前",
    "voice": "vo_adv_1249004_037",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不是說我害跟我對戰的朋友哭了嗎……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "其實啊，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是我害她受傷了。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "她因此",
    "voice": "vo_adv_1249004_038",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒辦法參加後面的大賽……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我不只是害朋友哭，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我更是奪走了她重要的機會。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那個時候的我……",
    "voice": "vo_adv_1249004_039",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "一定很希望有人責備我。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n責備我親手破壞了",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "某人重要的事物。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但受傷的她、",
    "voice": "vo_adv_1249004_040",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "老師跟大家，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n都很溫柔對待我，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "都寵著我……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "明明就是加害者，",
    "voice": "vo_adv_1249004_041",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "卻像這樣受人寵愛，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我沒辦法原諒這樣的自己。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "所以我才放棄了",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "空手道。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……嗯。",
    "voice": "vo_adv_1249004_042",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "因為沒有人要責備我。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我從那之後，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就一直責備著自己。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唉，",
    "voice": "vo_adv_1249004_043",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但我家的笨蛋大哥啊……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n直到現在都還是",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "隨意地揮拳，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "總是讓人受傷。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "明明",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "總有一天會破壞某個人的未來也說不定。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真的超級不負責任的，",
    "voice": "vo_adv_1249004_044",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還害我被牽連。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n都不知道像那樣被纏上了是第幾次了。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真～的",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "超級煩的。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……啊哈，",
    "voice": "vo_adv_1249004_045",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "謝啦。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但是",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就像學長幫我一樣，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n小時候幫了我的，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也是大哥的拳頭。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "大哥的拳頭既是給了我未來，",
    "voice": "vo_adv_1249004_046",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也是傷害了某人的未來。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我現在",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "已經",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "煩到什麼都搞不懂了。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我朋友到現在",
    "voice": "vo_adv_1249004_047",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也還在持續練空手道。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n只有我不管過了多久，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "都還在原地踏步──",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "still",
    "still_id": "124900401"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "──你看，",
    "voice": "vo_adv_1249004_048",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就像這杯咖啡歐蕾一樣。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n既不是咖啡也不是牛奶的感覺，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真適合我。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "如果繼續這樣下去的話，",
    "voice": "vo_adv_1249004_049",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "冰塊也遲早會融光……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n變成沒什麼味道，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "無聊的人吧。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "──",
    "voice": "vo_adv_1249004_050",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "噗，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那什麼意思啊。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然我認同啦。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "只有咖啡的話太苦了，",
    "voice": "vo_adv_1249004_051",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "只有牛奶的話又太甜了。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n又有平衡又有份量。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真的很棒呢，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "咖啡歐蕾。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "──咦。",
    "voice": "vo_adv_1249004_052",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你的意思是……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "still",
    "still_id": "124900402"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……這樣啊。",
    "voice": "vo_adv_1249004_053",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "確實呢。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "像咖啡一樣的苦澀經驗、",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "像牛奶一樣的溫柔經驗，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n並不是只有一種才是正確的。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那兩種",
    "voice": "vo_adv_1249004_054",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "造就了我的未來。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n……是這個意思嗎？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯。",
    "voice": "vo_adv_1249004_055",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "如果只是持續責備自己，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那就無法往未來前進。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那樣做才沒辦法面對自己的行為……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n只是站著不動而已。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "background",
    "bg_id": "510150"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "──",
    "voice": "vo_adv_1249004_056",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呼～",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "總覺得講完這些話之後，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "變得超級暢快的。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n啊哈哈，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "最近發生過的討厭的事，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "全部都忘光了！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真的是太好了，",
    "voice": "vo_adv_1249004_057",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還好談這件事的對象是學長。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……謝謝你。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "──從、",
    "voice": "vo_adv_1249004_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "從未有過的嚴肅氣氛……！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "給我等一下，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你根本就是個厲害的詩人吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "簡直就像浪漫電影的場景耶！？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……怎麼可能是嘛。",
    "voice": "vo_adv_1249004_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "反正是你這個人，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n也只是單純喜歡咖啡歐蕾而已吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你呀，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "還真是會自然而然地說甜言蜜語耶。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "算了，",
    "voice": "vo_adv_1249004_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "反正人生是很長的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "沒辦法永遠都在犯錯，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n也沒辦法永遠都在做對的事……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不對，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "其實打從一開始",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就沒有什麼東西是對。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嘉夜口中的大哥、",
    "voice": "vo_adv_1249004_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "持續練空手道的朋友，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "當然也包括嘉夜自己……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n都是走在各自的道路上，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "尋找著屬於自己的未來色彩。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嘉夜在這之後會染上什麼樣的色彩、",
    "voice": "vo_adv_1249004_062",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "會走向什麼樣的未來呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你可要陪在她身旁，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好好看著她喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那就再見囉～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "──唔、",
    "voice": "vo_adv_1249004_063",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯嗯……？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "剛才的……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是夢？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我睡著啦。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "居然會在這種小巷中打瞌睡，",
    "voice": "vo_adv_1249004_064",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我果然是還沒完全恢復過來吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那個解放的力量，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "耗能到底是有誇張啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯……",
    "voice": "vo_adv_1249004_065",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "要說的話，\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "感覺內心深處",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那個煩悶的感覺",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "完全消失了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然不太記得內容，",
    "voice": "vo_adv_1249004_066",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但一定是好夢吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然也有可能只是肚子餓了而已啦。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哈哈，",
    "voice": "vo_adv_1249004_067",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……不過這",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "肯定是因為有你陪著我吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "只有身邊有死黨陪著……",
    "voice": "vo_adv_1249004_068",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n就算偶爾會停下腳步，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但還是能朝未來前進。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "經過這次的事，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我徹底明白這一點了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "特別是有你在的話……",
    "voice": "vo_adv_1249004_069",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "總有種安心感，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n或是說背後變得很溫暖的感覺。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然因為有點害羞所以不太想說。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "誰知道啊。",
    "voice": "vo_adv_1249004_070",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那肯定是──",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "到了未來就會知道吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……接下來，",
    "voice": "vo_adv_1249004_071",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "肚子也餓了，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就帶你去我之前說的，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "在小巷內很好吃的那家店吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但是",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "由你請客，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你可不能說不要喔。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在樂園自蘭德索爾消失之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n殘留下來的只有空白的未來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而{0}與嘉夜正要向那踏出第一步。",
    "voice": null,
    "unit_id": null
  }
]
