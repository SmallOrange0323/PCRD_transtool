  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等等，",
    "voice": "vo_adv_9067158_009",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "搞什麼嘛，那些刺蝟們！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還很有精神耶！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是的。",
    "voice": "vo_adv_9067158_010",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n而且……",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "正在拖著若菜小姐。",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "想逃跑嗎！？",
    "voice": "vo_adv_9067158_011",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "噫呀啊啊啊！？",
    "voice": "vo_adv_9067158_012",
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n告、",
    "voice": null,
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "告辭了～！",
    "voice": null,
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "不愧是能當車輪用的刺蝟……",
    "voice": "vo_adv_9067158_013",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n好厲害的速度。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼。",
    "voice": "vo_adv_9067158_014",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n沒關係啦，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那種雜碎跟雜碎魔物",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "隨時都能打倒。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "根本不用追也……",
    "voice": null,
    "unit_id": 106011
  },
