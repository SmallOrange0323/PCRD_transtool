  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "…………",
    "voice": "vo_adv_9067158_004",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎麼了嗎？",
    "voice": "vo_adv_9067158_005",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n貪吃佩可。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我說刺蝟啊，",
    "voice": "vo_adv_9067158_006",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n雖然小小的……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "聽說很好吃耶。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "然後這麼大一隻的話，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不曉得會多有飽足感……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可、普蕾西亞",
    "words": "流口水。",
    "voice": "vo_adv_9067158_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "刺蝟型魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 50311
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "啊、",
    "voice": "vo_adv_9067158_008",
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "咦……？",
    "voice": null,
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "大家，",
    "voice": null,
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "沒事嗎……！？",
