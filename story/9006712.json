[
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "唔……！",
    "voice": "vo_adv_9006712_000",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "機會來了！",
    "voice": "vo_adv_9006712_001",
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n一鼓作氣進攻吧！",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好！",
    "voice": "vo_adv_9006712_002",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n日和熾炎──",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "唔！",
    "voice": "vo_adv_9006712_003",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n等等──",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……霸瞳天星‧",
    "voice": "vo_adv_9006712_004",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "滅光！！",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "啊啊啊！",
    "voice": "vo_adv_9006712_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔……！",
    "voice": "vo_adv_9006712_006",
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如果我能更",
    "voice": null,
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "精準地預知攻擊的話……！　",
    "voice": null,
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "──妳們幾個！",
    "voice": "vo_adv_9006712_007",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n快退下，去恢復體力！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n戰鬥",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "現在才剛開始而已呢！？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……對不起，",
    "voice": "vo_adv_9006712_008",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "菲歐……！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我們馬上回來！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……嚮導小妖精。",
    "voice": "vo_adv_9006712_009",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n又想玩什麼自爆了嗎？",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "只是會和當時一樣，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "根本毫無意義就是了。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我才不會做那種事！",
    "voice": "vo_adv_9006712_010",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n修復身體",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是很痛苦的！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "比起那個──",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "交換選手！",
    "voice": "vo_adv_9006712_011",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n拜託妳了──",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "七冠！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "──[rub:亂數聖域]亂數聖域[/rub]！",
    "voice": "vo_adv_9006712_012",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n聖域！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "聖～～域！！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……唔！",
    "voice": "vo_adv_9006712_013",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "真討厭……",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n那刀鋒──",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "似乎比以前更銳利了呢。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "克莉絲。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那是當然的！",
    "voice": "vo_adv_9006712_014",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n沐浴在那些將生命燃燒在舞台上的少女們的光輝，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我的劍也變得更加耀眼了☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "來吧陛下！",
    "voice": "vo_adv_9006712_015",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "再來！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "再來啊！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n讓我們使勁全力，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "相愛相殺到底吧！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "亂數──",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "唷呼～",
    "voice": "vo_adv_9006712_016",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真那～？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嚇了我一跳啊，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒想到妳竟然會和幻境龍后聯手呢。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳們關係有這麼好嗎？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我和她",
    "voice": "vo_adv_9006712_017",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "才不是什麼關係很好。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我只是為了",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不再輸給曾打倒過我的妳們。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "雖然和她聯手會讓我很不開心。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……總覺得妳變了呢。",
    "voice": "vo_adv_9006712_018",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳那高傲的氣焰被打壓下去後，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "反倒變得更討人喜歡了不是嗎？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "如今沒了那份傲慢，",
    "voice": "vo_adv_9006712_019",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "感覺比以前難纏多了。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這下子，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要是我們也瞻前顧後的話，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "恐怕一下子就會被擊潰呢。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂喂喂。",
    "voice": "vo_adv_9006712_020",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n在我和陛下的舞蹈進行時，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可以請妳別插手嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我才不想跳什麼舞，",
    "voice": "vo_adv_9006712_021",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "很累人的。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "比起那個──",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n還是乖乖向我磕頭，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "雙腳下跪才適合妳們幾個！",
    "voice": null,
    "unit_id": 106914
  }
]
