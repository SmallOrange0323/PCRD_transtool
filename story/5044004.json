  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "聽見內心的聲音後",
