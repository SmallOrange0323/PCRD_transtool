    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n應該說在下我",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "都快聽到膩了。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "人本來就該聽從內心的聲音嘛！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "原來如此。",
    "voice": "vo_adv_5044004_072",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "真不愧是杏奈大人的同伴。",
