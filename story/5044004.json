    "voice": "vo_adv_5044004_065",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "在聽了妳的話之後我下定決心了。",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "\\n現在，",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "就讓我們前往決戰之地吧！",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "織女！",
    "voice": "vo_adv_5044004_066",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n妳能停止哭泣真是太好了。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "打起精神了嗎？",
