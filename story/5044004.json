    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不過妳剛剛說的",
    "voice": "vo_adv_5044004_073",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是指什麼意思？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "意思是，",
    "voice": "vo_adv_5044004_074",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "發現想要的東西就一定要弄到手☆",
