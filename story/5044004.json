    "type": "dialogue",
    "name": "織女",
    "words": "我",
    "voice": "vo_adv_5044004_076",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "不能讓事情就這樣結束。",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "\\n我要解決和牛郎之間的問題，",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "讓七夕祭順利舉辦！",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "\\n",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "身為受「銀河」引導的宿星之星姬，",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "我以此名義起誓！",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哼哼哼，",
    "voice": "vo_adv_5044004_077",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不錯不錯！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": " 就該有這種氣魄！",
