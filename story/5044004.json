    "name": "巫女1",
    "words": "請您別再哭了。",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "嗚，",
    "voice": "vo_adv_5044004_002",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "嗚嗚……！",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "\\n",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "別管我，",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "反正我這種人、",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "我這種人……！！",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "巫女1",
    "words": "……織女大人自從回來之後",
    "voice": "vo_adv_5044004_003",
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女1",
    "words": "就一直都是這種狀態。",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女1",
    "words": "\\n以前",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女1",
    "words": "還偶爾會露出笑容，",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女1",
    "words": "現在則是成天以淚洗面……",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我明白了，",
    "voice": "vo_adv_5044004_004",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "謝謝妳。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "想私下和她談談，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "能麻煩妳迴避一下嗎？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "巫女1",
    "words": "好的，",
    "voice": "vo_adv_5044004_005",
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "巫女1",
    "words": "那麼我先退下了。",
    "voice": null,
    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唉……",
    "voice": "vo_adv_5044004_006",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "竟然讓織女留下了這麼不好的回憶，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還真是不好意思啊。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n因為我的關係",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "反而適得其反了。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒錯沒錯。",
    "voice": "vo_adv_5044004_007",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這次的事情誰也料不到的吧？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n只是這件事和",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "流夏姐的作法合不來而已。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "別介意。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "唔姆。",
    "voice": "vo_adv_5044004_008",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "只要再試試別的辦法就行了！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n流夏，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "下次要用什麼方法啊？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……你們覺得",
    "voice": "vo_adv_5044004_009",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼做比較好？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總覺得，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我好像很不擅長",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "處理這種問題啊。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "感覺要是我貿然做了什麼，",
    "voice": "vo_adv_5044004_010",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "又會",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "把事情弄得更複雜。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你們",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要是有什麼想法，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就說出來讓我聽聽看吧。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "原來如此啊～",
    "voice": "vo_adv_5044004_011",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這事",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就交給正義的魔法少女",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "七七香吧！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "唔姆！",
    "voice": "vo_adv_5044004_012",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": " 只要能發揮我們的力量，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "解決問題只是小事一樁！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哼哼哼，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "看來解放我真實力量的這天終於來臨了……！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……雖然你們這樣說讓我很開心啦，",
    "voice": "vo_adv_5044004_013",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但真的沒問題嗎？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "當然的啦！",
    "voice": "vo_adv_5044004_014",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": " 我們稍～",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "微過去那裡商量一下，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "等一下喔☆",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "姑且確認一下，",
    "voice": "vo_adv_5044004_015",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳應該也沒有任何的想法對吧？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "當然。",
    "voice": "vo_adv_5044004_016",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但是，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "看著流夏的表情，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我實在是說不出沒辦法啊。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "她看起來那麼困擾，",
    "voice": "vo_adv_5044004_017",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是能明白她想幫上忙的心情啦！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但是，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "該怎麼辦呢～",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……雖然不確定行不行得通，",
    "voice": "vo_adv_5044004_018",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但我是有個想法。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喔喔，",
    "voice": "vo_adv_5044004_019",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "真的嗎！？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "說不定織女她……",
    "voice": "vo_adv_5044004_020",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "和我一樣",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是擁有「資質」的人。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "像她這種個性膽怯的人，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "其實都深藏著驚人的力量。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "所以說七七香，",
    "voice": "vo_adv_5044004_021",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要是我成功說服了織女，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就這樣這樣再那樣那樣……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唔姆唔姆，",
    "voice": "vo_adv_5044004_022",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "原來是這樣啊。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "OK☆",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n流夏姐，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "總之我們已經",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "想到方法了，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就包在我們身上吧！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以，",
    "voice": "vo_adv_5044004_023",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳們打算要怎麼做？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哼哼，",
    "voice": "vo_adv_5044004_024",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "很簡單的。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我去突襲織女的房間，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "然後說服她！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……讓杏奈去說服別人，",
    "voice": "vo_adv_5044004_025",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "感覺是最不妙的呢，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n真的沒問題嗎？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "別擔心，",
    "voice": "vo_adv_5044004_026",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "相信我！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": " 那麼，",
