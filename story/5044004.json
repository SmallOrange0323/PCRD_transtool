    "name": "織女",
    "words": "我有一事想詢問各位。",
    "voice": "vo_adv_5044004_069",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "\\n請問各位有聽過「自我」所發出的",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "內心之聲嗎？",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯？",
    "voice": "vo_adv_5044004_070",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": " 那是",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "什麼意思──",
    "voice": null,
    "unit_id": 113111
  },
  {
