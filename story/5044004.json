    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我可以讓妳加入熾炎戰鬼煉獄血盟暗黑團喔！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "此話當真！？",
    "voice": "vo_adv_5044004_062",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "\\n沒想到",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "我竟然擁有這樣的天賦……！",
