    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n妳的眼淚",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "到底是為了什麼而流？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "咦？",
    "voice": "vo_adv_5044004_032",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": " 這、",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "當然是因為牛郎他",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "劈腿了……",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "\\n",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "所以",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "我才會悲傷得流下眼淚啊……？",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這就是妳",
    "voice": "vo_adv_5044004_033",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "「自認為」",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "的原因啊。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳要欺騙自己到什麼時候？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "這是，",
    "voice": "vo_adv_5044004_034",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "什麼意思？",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": " 我",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "沒有說過謊啊……",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我不是那個意思。",
    "voice": "vo_adv_5044004_035",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳聽不見嗎？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n那個沉睡在妳心中的，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "另外一個真正的「自我」的聲音！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳所流的淚水不是因為悲傷。",
    "voice": "vo_adv_5044004_036",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n妳所流的淚，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是因為真正的「自我」在悔恨地叫喚著啊！！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "悔恨……？",
    "voice": "vo_adv_5044004_037",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": " 我",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "悔恨嗎……？",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "沒錯。",
    "voice": "vo_adv_5044004_038",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "悔恨牛郎劈腿。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "悔恨妳那麼喜歡他他卻辜負妳。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n妳心中燃起的鬥爭之心，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "正在不停著咆哮著！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "來吧，",
    "voice": "vo_adv_5044004_039",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "站起來。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n能回應「自我」的，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "只有妳自己啊！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "但是，",
    "voice": "vo_adv_5044004_040",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "我……",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "那麼懦弱，",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "鬥爭什麼的……",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……不敢否定原來的自己，",
    "voice": "vo_adv_5044004_041",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "的確會有這種想法。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我在",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "前世時也是這樣，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "很能",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "體會妳的心情。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但正因如此，",
    "voice": "vo_adv_5044004_042",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "才要讓另一個「自我」",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "降臨於世啊！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n這樣一來，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳體內的力量",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "必將顯現出來！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "顯現……",
    "voice": "vo_adv_5044004_043",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "嗎？",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "\\n",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "那、",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "那個，",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "我已經是個降臨於世的化身了。",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "\\n我還能顯現出什麼呢？",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "天真！",
    "voice": "vo_adv_5044004_044",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": " 妳太天真了！！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "啊、",
    "voice": "vo_adv_5044004_045",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "啊噫！？",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不要被自己的雙眼所蒙蔽！",
    "voice": "vo_adv_5044004_046",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n本質可不是物質層面，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "而是寄宿在精神裡的啊！！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "本質寄宿在精神裡……",
    "voice": "vo_adv_5044004_047",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "\\n原、",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "原來如此！",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": " 或許",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "就是這樣沒錯呢。",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對吧，",
    "voice": "vo_adv_5044004_048",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對吧。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n對妳來說，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "和星辰共存的那好幾萬年，",
