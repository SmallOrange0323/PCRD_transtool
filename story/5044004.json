    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n總不可能是白白虛度的吧。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "此刻正是",
    "voice": "vo_adv_5044004_049",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "於妳那千錘百鍊的精神中，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n喚醒真正「自我」",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "的時機啊！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "織女是和",
    "voice": "vo_adv_5044004_050",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "星神差不多的存在吧？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n杏奈把話說成那個樣子，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真的沒問題嗎。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒問題、",
    "voice": "vo_adv_5044004_051",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒問題！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n相信杏奈美眉吧！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "……",
    "voice": "vo_adv_5044004_052",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "真、",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "真不愧是杏奈大人！",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "\\n",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "不過，",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "像我這樣的人，",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "真的能辦得到嗎……",
