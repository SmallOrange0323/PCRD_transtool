  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "——於鯛魚燒店工作的珠希。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n和來臨時支援的{0}一同，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n不停烤著鯛魚燒。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "珠希！",
    "voice": "vo_adv_1046009_000",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "\\n老樣子一個紅豆口味！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "這邊，",
    "voice": "vo_adv_1046009_001",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "給我白豆沙吧！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "多謝惠顧喵！",
    "voice": "vo_adv_1046009_002",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "一個紅豆、",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "一個白豆沙……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n這邊的餡料好像快用完了，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "麻煩你準備一下喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喔喔，",
    "voice": "vo_adv_1046009_003",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "手腳真俐落呢！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}願意來打工，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n真是幫大忙了喵～♪",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "欸……",
    "voice": "vo_adv_1046009_004",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯，",
    "voice": "vo_adv_1046009_005",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "怎麼了喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "沒事沒事，",
    "voice": "vo_adv_1046009_006",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "\\n好像夫妻一起經營鯛魚燒店似的，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "\\n兩位的默契這麼好，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "光是看著就被感動了呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "是、",
    "voice": "vo_adv_1046009_007",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "是這樣喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n喵哈哈～",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "總感覺",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "有點害羞喵～♪",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "吶吶，",
    "voice": "vo_adv_1046009_008",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n既然這樣，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們乾脆就結婚吧？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "咦！？",
    "voice": "vo_adv_1046009_009",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n等、",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "給我等一下喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "再怎麼說也，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那個……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你、",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你是認真的嗎？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "哈哈！",
    "voice": "vo_adv_1046009_010",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "\\n最近",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "物價上漲日子過得可辛苦了，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "\\n能聽到這種喜事真令人開心呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "物價上漲喵？",
    "voice": "vo_adv_1046009_011",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "是啊。",
    "voice": "vo_adv_1046009_012",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "\\n不論吃的穿的，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "甚至連日常用品都在漲價。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……這麼說來，",
    "voice": "vo_adv_1046009_013",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "最近貓的飼料也很貴，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n店長也語重心長地說鯛魚燒可能要漲價了喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "……偷偷告訴你們，",
    "voice": "vo_adv_1046009_014",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "物價會上漲都是因為，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "\\n商人們互相勾結，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "操弄價格的樣子。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "原、",
    "voice": "vo_adv_1046009_015",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "原來有這種事喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "唉，",
    "voice": "vo_adv_1046009_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "這也只是謠言啦。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "\\n……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "不過如果謠言是真的，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "\\n現在那些傢伙一定笑得合不攏嘴吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "可惡！",
    "voice": "vo_adv_1046009_017",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "\\n辛苦的，一直都是",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "我們這樣的無產階級啊！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "…………",
    "voice": "vo_adv_1046009_018",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "好啦，",
    "voice": "vo_adv_1046009_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "差不多該回去工作了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "我也該走了。",
    "voice": "vo_adv_1046009_020",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "再見啦，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "珠希！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊、",
    "voice": "vo_adv_1046009_021",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "謝謝惠顧！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "歡迎再來喵～！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……剛才的客人提到的那件事，",
    "voice": "vo_adv_1046009_022",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "說不定，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n又有像惡德伊商會那樣的組織出現了喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "說得沒錯喵！",
    "voice": "vo_adv_1046009_023",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n這種欺壓百姓的邪惡商會，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n就由幻影貓來降下制裁喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "首先，",
    "voice": "vo_adv_1046009_024",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "先從謠言的可信度開始調查喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "像對抗惡德伊的那時候，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "已經被假情報害得太多次了喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "先請感覺精通商會情報的秋乃幫忙……",
    "voice": "vo_adv_1046009_025",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n怎麼了喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "太、",
    "voice": "vo_adv_1046009_026",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "太快了喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n連30秒都還沒過！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你該不會",
    "voice": "vo_adv_1046009_027",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n是打算要",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "協助我的義賊幻影貓喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這、",
    "voice": "vo_adv_1046009_028",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這當然不行喵！！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……啊，",
    "voice": "vo_adv_1046009_029",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "抱、",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "抱歉我語氣太兇了喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "畢竟{0}你是一般人，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n還是不要再介入會比較好喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這種事",
    "voice": "vo_adv_1046009_030",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就交給我去辦喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我可是幻影貓，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n沒有什麼是不可能的喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "助、",
    "voice": "vo_adv_1046009_031",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "助我一臂之力……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真、",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真的喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
