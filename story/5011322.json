  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這咆哮聲……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "讓身體麻到不能動了。",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗚、",
    "voice": "vo_adv_5011322_001",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這樣下去就會被單方面地解決掉了……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "咦，",
    "voice": "vo_adv_5011322_002",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "可可亞烏拉朝著敵人過去了！？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "怎麼了？小可，",
    "voice": "vo_adv_5011322_003",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "很危險的唷！！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊、",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "該不會是",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "想要保護我們吧？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n連小可都這麼努力了，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那我們怎麼可以認輸呢！",
    "voice": null,
    "unit_id": 101112
  }
