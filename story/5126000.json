    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也就是說",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你是要負責教大家魔法的人吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但你看起來完全是狂戰士啊！",
    "voice": "vo_adv_5126000_099",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n狂戰士就算硬是穿得像魔法師，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n也用不了魔法的啊！！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "喂，",
    "voice": "vo_adv_5126000_100",
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "妳沒有學過不可以用外表來判斷人嗎？",
