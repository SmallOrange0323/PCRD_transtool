    "words": "我有收到陛下來信，說明你會和凱留同學同行。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……那個，校長。",
    "voice": "vo_adv_5126000_059",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "為什麼會寄信來讓我插班入學呢？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "呵呵，",
    "voice": "vo_adv_5126000_060",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "也不怕讓妳誤會，我就直說了……",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "是因為有話題性。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "我們希望邀請優秀且具有強大影響力的人才入學，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n來更廣泛地宣傳這所學園。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "而我們",
    "voice": "vo_adv_5126000_061",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "首先選中的",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "就是凱留同學。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "妳身為魔法師的實力，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n就連身在遠處的我們",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "都十分地清楚♪",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "原來如此……",
    "voice": "vo_adv_5126000_062",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼簡單來說，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就是用來宣傳招生的吉祥物是吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "是啊，",
    "voice": "vo_adv_5126000_063",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "簡單來說就是這樣♪",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呵呵，",
    "voice": "vo_adv_5126000_064",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳說得真直白呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不過我並不討厭就是。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "畢竟身為教育者，",
    "voice": "vo_adv_5126000_065",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "我不能對學生說謊呀♪",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "哎呀……",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "這麼說來還真慢呢。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "其實",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "預定還有一個人要來的。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還有一個人？",
    "voice": "vo_adv_5126000_066",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不妙不妙",
    "voice": "vo_adv_5126000_067",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "超扯的不妙啦──！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n第一天就遲到",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真的要完蛋了──！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好像",
    "voice": "vo_adv_5126000_068",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有人朝著這裡跑來……？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "呵呵，",
    "voice": "vo_adv_5126000_069",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "她來了呢。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "咚────！！！！",
    "voice": "vo_adv_5126000_070",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n勉強趕上！！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……奇怪，",
    "voice": "vo_adv_5126000_071",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "聽見了秀才的聲音……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n為什麼──？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，對了，",
    "voice": "vo_adv_5126000_072",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這裡好像",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是魔法學園嘛。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以這是用來讓慌張的人家冷靜下來的",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "神奇魔法……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不對，",
    "voice": "vo_adv_5126000_073",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是真正的秀才！？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦……！",
    "voice": "vo_adv_5126000_074",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才也要上這所學園，真假！？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "而且那邊的，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不是凱留寶嗎～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好久不見欸～",
    "voice": "vo_adv_5126000_075",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "妳過得好嗎～？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家啊──",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "超×４有精神喲～♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我想也是……",
    "voice": "vo_adv_5126000_076",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "見面兩秒就看出來了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "話說妳靠得太近了！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……所以，",
    "voice": "vo_adv_5126000_077",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "鈴奈就是另一個學生嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "沒錯，",
    "voice": "vo_adv_5126000_078",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "超級模特兒的鈴奈同學",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "一定可以引起話題，不是嗎？",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "……話雖如此，她算是特別身分，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "比較類似交換留學生。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯，",
    "voice": "vo_adv_5126000_079",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為人家雖然想進魔法學園，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n但是也絕對不想離開月學嘛──♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "而且在這邊努力念書的話……",
    "voice": "vo_adv_5126000_080",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "在推甄？的時候",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好像會有加分之類的，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "聽說對月學好像也有幫助！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "話說",
    "voice": "vo_adv_5126000_081",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我可以問一下嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n雖然是個大前提，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過妳",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "會用魔法嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯？",
    "voice": "vo_adv_5126000_082",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不會啊？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我想也是……",
    "voice": "vo_adv_5126000_083",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那又是為什麼？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不會用魔法為什麼要來這裡？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "凱留寶，",
    "voice": "vo_adv_5126000_084",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所謂的學校，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就是學東西的地方啊♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……",
    "voice": "vo_adv_5126000_085",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說的也是。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也就是說，鈴奈，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳來這裡",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是想學會使用魔法嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊～",
    "voice": "vo_adv_5126000_086",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好想趕快穿",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那套超可愛制服喔～♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家可是為了那個而來的呢！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "凱留寶也是一樣的對吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才不是呢！",
    "voice": "vo_adv_5126000_087",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n話說回來，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳剛才還在說什麼",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "「學校是學東西的地方」啊！！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "快看啊秀才！",
    "voice": "vo_adv_5126000_088",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n手冊上也有刊登男生的制服！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "感覺很棒對吧♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不要連你都為了區區制服就那麼興致高昂啦！",
    "voice": "vo_adv_5126000_089",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n…………",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "（偷瞄）",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家看到了！",
    "voice": "vo_adv_5126000_090",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "凱留寶，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "妳剛才偷偷地看了對吧！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "果然凱留寶也很想穿嘛～♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我、",
    "voice": "vo_adv_5126000_091",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我才沒有看呢！！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "……那個，",
    "voice": "vo_adv_5126000_092",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "抱歉打斷你們那麼熱烈的討論。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n我們好像不小心弄錯，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "寄成了去年的入學通知……",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "其實從今年開始",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "那套制服就被廢止了，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "現在服裝是自由穿著的。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦咦咦～～～！！？",
    "voice": "vo_adv_5126000_093",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n那這套制服",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "已經穿不到了嗎～！？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "怎麼這樣……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "既然服裝是自由的，",
    "voice": "vo_adv_5126000_094",
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那要穿制服也沒關係吧，",
    "voice": null,
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "校長？",
    "voice": null,
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……你是誰啊？",
    "voice": "vo_adv_5126000_095",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "嗨。",
    "voice": "vo_adv_5126000_096",
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "我是你們班的班導，名叫坂本！",
    "voice": null,
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "\\n請多指教囉！",
    "voice": null,
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "老師好～",
    "voice": "vo_adv_5126000_097",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……唉，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "制服。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……先等一下。",
    "voice": "vo_adv_5126000_098",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這裡是魔法學園對吧？",
