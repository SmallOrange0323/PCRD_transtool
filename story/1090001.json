    "type": "dialogue",
    "name": "惠理子",
    "words": "我也改變了呢……",
    "voice": "vo_adv_1090001_045",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我想這大概是……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "多虧有{0}大人……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "儘管與過去的自己有所差距，\\n但惠理子對這般改變莫名地感到愉快。",
