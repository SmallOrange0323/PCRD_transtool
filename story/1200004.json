    "name": "摩拉",
    "words": "騎士大人！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n快醒醒啊～！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯……",
    "voice": "vo_adv_1200004_059",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "奇怪……？",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "啊，",
    "voice": "vo_adv_1200004_060",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "太好了……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "你們終於醒了！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "接納完黑暗靜流後，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "你們兩位就突然倒下了……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "是力量突然回到身上的副作用嗎……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "但是，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "為什麼騎士大人會……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……呵呵♪",
    "voice": "vo_adv_1200004_061",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n那種事不重要啦。",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "比起那件事，弟弟、",
