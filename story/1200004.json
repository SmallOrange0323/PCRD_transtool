  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "黑暗姐姐被壓扁了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n於是靜流分身引起的騷動終於解決了……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呼，",
    "voice": "vo_adv_1200004_000",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "事情解決了！",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n是姐姐贏了！",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "事情解決了",
    "voice": "vo_adv_1200004_001",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "──才怪啦，靜流！？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "妳最後是用力量和質量",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "強行解決掉的吧！？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "妳看啦，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "騎士大人嚇到整個人都呆住了！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "咦，",
    "voice": "vo_adv_1200004_002",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟，你怎麼了！？",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n你的嘴巴張得很大唷！？",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "啊，",
    "voice": "vo_adv_1200004_003",
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "是希望姐姐幫你刷牙嗎？",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "\\n",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "真拿你沒轍，",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "你真愛撒嬌呢♪",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "嗚哇，",
    "voice": "vo_adv_1200004_004",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "嚇我一跳！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n咦，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "為什麼妳還在啊！？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n妳剛才不是被王者騎士大人壓扁了……！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呵呵♪",
    "voice": "vo_adv_1200004_005",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我不會讓王者弟弟",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "做傷害他人的行為。",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "因為弟弟很溫柔的……♪",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "嗯……",
    "voice": "vo_adv_1200004_006",
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "在王者弟弟的手包覆住我的時候……",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "\\n我被非常溫柔的觸感包覆，",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "彷彿置身夢境一般……♪",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "\\n",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "……於是我不禁心想，",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "自己絕對戰勝不了。",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "這、",
    "voice": "vo_adv_1200004_007",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好了，",
    "voice": "vo_adv_1200004_008",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那麼……",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "做個了斷吧。",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "……我的黑暗力量",
    "voice": "vo_adv_1200004_009",
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "輸給妳了。",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "\\n",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "隨妳處置吧。",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "\\n",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "我覺得把我消滅掉，",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "妳會比較輕鬆就是了。",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我不會這麼做。",
    "voice": "vo_adv_1200004_010",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "因為……",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟說過",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "想要和「全部的我」待在一起。",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "……！",
    "voice": "vo_adv_1200004_011",
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "那樣不管經過多久，",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "黑暗都不會消失。",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "\\n",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "妳得要在壓抑",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "和痛苦中……",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "繼續忍耐下去才行喔？",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……那也是",
    "voice": "vo_adv_1200004_012",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐的愛。",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "回來吧。",
    "voice": "vo_adv_1200004_013",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "……",
    "voice": "vo_adv_1200004_014",
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "黑暗姐姐",
    "words": "嗯。",
    "voice": null,
    "unit_id": 120016
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……！",
    "voice": "vo_adv_1200004_015",
    "unit_id": 120011
  },
  {
    "type": "background",
    "bg_id": "510090"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我回來了～♪",
    "voice": "vo_adv_1200004_016",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n嘿嘿，",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "雖然不是姐姐的房間，",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還是說了我回來了♪",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "和弟弟一起去購物，",
    "voice": "vo_adv_1200004_017",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "太開心了～♪",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟，謝謝你，",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "願意幫姐姐提東西。",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟為我挑選了很多東西，",
    "voice": "vo_adv_1200004_018",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我高興到不小心買太多了……",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不過，沒問題！",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n為了弟弟而使用的錢，",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是姐姐的必要經費♪",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "對了，",
    "voice": "vo_adv_1200004_019",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "今天的晚餐",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你想吃什麼？",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "受你的雙親所託，要幫忙照顧你。",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我會像妻子一樣",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "細心照顧你的……♪",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……不過，",
    "voice": "vo_adv_1200004_020",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "在那之前。",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n家裡只有我們兩個，",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還有事情要做吧。",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "難道你的作業還沒寫完？",
    "voice": "vo_adv_1200004_021",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這可不得了，",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐待會幫你看看！",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n不過，現在不是要做這件事……！",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "沒錯沒錯！",
    "voice": "vo_adv_1200004_022",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n說到兩人獨處要做的事情，",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就是比腕力吧！",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我會讓你知道沒有弟弟能贏過姐姐！",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呃，不對～啦！",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "討厭，",
    "voice": "vo_adv_1200004_023",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟你啊，根本就不懂。",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "在這個狀況下要做的事情……",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就只有一件，",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "對吧。",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "──由姐姐主辦！",
    "voice": "vo_adv_1200004_024",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n姐姐的時裝秀要開始囉！",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "咻咻～♪",
    "voice": "vo_adv_1200004_025",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "哇啊，謝謝～♪",
    "voice": "vo_adv_1200004_026",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟整個人的反應",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
