    "type": "background",
    "bg_id": "500012"
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "那麼，",
    "voice": "vo_adv_1200004_062",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我就先在這裡告辭了。",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n你們兩位，",
