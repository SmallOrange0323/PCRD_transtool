[
  {
    "type": "background",
    "bg_id": "500164"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "炎熱的陽光照射在沙灘上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}靜靜凝視著眼前",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n被烤熱的黑鐵之軀。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "怎麼了嗎，",
    "voice": "vo_adv_1136001_000",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你為什麼會露出那麼訝異的表情？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒錯。",
    "voice": "vo_adv_1136001_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是我。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "難不成你以為",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我是銅像嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n好吧，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果有鎧甲佇立在沙灘上，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n會那麼認為或許也很正常。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，",
    "voice": "vo_adv_1136001_002",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在這裡遇見你也挺稀奇的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這麼說來我也一樣嗎。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊，",
    "voice": "vo_adv_1136001_003",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "找到了找到了。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n真是的……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要是你一直閒晃，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "小心會走丟喔？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗨，",
    "voice": "vo_adv_1136001_004",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "原來小咲戀也來了嗎。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "咦？",
    "voice": "vo_adv_1136001_005",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那個聲音……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "難不成是純！？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n妳是怎麼了？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "怎麼會跑來這種地方……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "而且還穿成那樣！",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "最近突然大受歡迎的",
    "voice": "vo_adv_1136001_006",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "海邊勝地……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我指的是這片海灘。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n負責維持這片沙灘治安的部隊裡",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "似乎有缺人。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所以我就來補那個缺了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "補、",
    "voice": "vo_adv_1136001_007",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "補那個缺……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳可是【王宮騎士團】的團長耶，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n怎麼可以這麼輕易就跑出來補缺啊？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唉呀，",
    "voice": "vo_adv_1136001_008",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "他們都說王宮的護衛人已經夠了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所以我就想說，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這裡可能會有工作做……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "原來如此，",
    "voice": "vo_adv_1136001_009",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是這麼一回事嗎。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯？",
    "voice": "vo_adv_1136001_010",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "什麼原來如此什麼啊，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小咲戀？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這裡的沙難",
    "voice": "vo_adv_1136001_011",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真的很和平對吧。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "之前甚至",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不需要維持治安的部隊。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "純現在也是，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "無事可做閒到不行對吧？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就是說啊。",
    "voice": "vo_adv_1136001_012",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "今天也不是我當班，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但我實在是沒事可做，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n才會像這樣到處巡邏。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "唉，",
    "voice": "vo_adv_1136001_013",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳這樣不行啊。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "大家是想讓妳好好休息，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "才會謊稱有缺人的。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這裡的部隊原本就只有一人，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我剛才也有在那邊",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "看到他喔？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "原、",
    "voice": "vo_adv_1136001_014",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "原來是那樣的嗎……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我確實一直感到困惑，畢竟這裡的工作量很少。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n嗯……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可是，就算明白他們的用意，我又該如何是好……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那個簡單啦。",
    "voice": "vo_adv_1136001_015",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n非工作時間就盡情享受大海，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "為身心充電──",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n這樣做也算是",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "尊重全體團員的這份心意了吧？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_1136001_016",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那麼，",
    "voice": "vo_adv_1136001_017",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "事情就是這樣，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "如果純不嫌棄，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n要不要跟我們一起行動呀？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可是，",
    "voice": "vo_adv_1136001_018",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那樣好嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我這種人就算跟著你們……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "放心吧。",
    "voice": "vo_adv_1136001_019",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們今天是跟育幼院的孩子們一起來的。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "肯定是人越多",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "會越開心呀。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是嗎。",
    "voice": "vo_adv_1136001_020",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就讓我打擾一下吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呵呵，",
    "voice": "vo_adv_1136001_021",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "幫了大忙呢。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "幫了大忙……？",
    "voice": "vo_adv_1136001_022",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "原來如此，",
    "voice": "vo_adv_1136001_023",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是這麼一回事嗎……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後，純跟{0}一起在\\n照顧過咲戀她們的海之家裡幫忙送餐。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對不起喔，",
    "voice": "vo_adv_1136001_024",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "純。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": "vo_adv_1136001_025",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是我自己問有沒有什麼可以幫忙的事，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所以妳不用在意，只是……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我在這家店幫忙",
    "voice": "vo_adv_1136001_026",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不會有問題嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我記得【王宮騎士團】",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n是禁止從事副業的……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳放心吧。",
    "voice": "vo_adv_1136001_027",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "根據【王宮騎士團】的服務規定，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n在非勤務時間",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "從事無給薪之行為，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n不會視為副業。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不愧是小咲戀。",
    "voice": "vo_adv_1136001_028",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我就能放心進行任務了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "任務……",
    "voice": "vo_adv_1136001_029",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真是的，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這裡可不是【王宮騎士團】喔？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "而且……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳真的不把鎧甲脫掉嗎？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這點我辦不到。",
    "voice": "vo_adv_1136001_030",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n而且這種程度的炎熱，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我早已習以為常。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那就好……",
    "voice": "vo_adv_1136001_031",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過妳要記得隨時補充水分喔？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n為了避免中暑，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳絕對不可以勉強自己。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "聽到了嗎？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我瞭解了，",
    "voice": "vo_adv_1136001_032",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小咲戀。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那麼，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "行軍路線有著落了嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有。",
    "voice": "vo_adv_1136001_033",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "請看這張地圖。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "首先要走這條路線，優先部署冷飲。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n回程時",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "則以湯類為優先，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這部分的搬運，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我會請隨行的他負責。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那樣的話，",
    "voice": "vo_adv_1136001_034",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "分成兩隊會比較有效率吧？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "因為我想同時端給同一群客人。",
    "voice": "vo_adv_1136001_035",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "當客人要用餐時，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們會希望同一桌的人",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "一起喊開動不是嗎？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有道理。",
    "voice": "vo_adv_1136001_036",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這很重要呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我明白了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那就照這個作戰執行。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你是怎麼了，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哈哈，",
    "voice": "vo_adv_1136001_037",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "畢竟我跟小咲戀認識很久了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n在【王宮騎士團】時代，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我總是受到她的幫助。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "會嗎？",
    "voice": "vo_adv_1136001_038",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n畢竟訂定這類型的作戰，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是小咲戀比較在行。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我從以前就老是依靠她。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真是的，",
    "voice": "vo_adv_1136001_039",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "才沒有那種事咧。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "純都會好好領導作戰現場，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n所以我只是做自己辦得到的事而已。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊，",
    "voice": "vo_adv_1136001_040",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "料理好像準備好了。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就拜託你們囉。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好，",
    "voice": "vo_adv_1136001_041",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那我們出動吧，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呵呵，",
    "voice": "vo_adv_1136001_042",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "謝謝你們。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "祝你們凱旋歸來～",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "說笑的啦。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "久等了。",
    "voice": "vo_adv_1136001_043",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我們來送料理。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "真是的，",
    "voice": "vo_adv_1136001_044",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "有夠慢耶！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "你們剛剛到底都在……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "噫！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n鎧、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "鎧甲！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "在這種海邊！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不好意思，",
    "voice": "vo_adv_1136001_045",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "由於來客眾多……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這邊的飲料",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是我們一點小小心意。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "好、",
    "voice": "vo_adv_1136001_046",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "好……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "謝謝。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "接著……",
    "voice": "vo_adv_1136001_047",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是這裡嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "請問叫外送餐點的人是哪一位……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "我就是……",
    "voice": "vo_adv_1136001_048",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "呃，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "呀啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "！",
    "voice": "vo_adv_1136001_049",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "您怎麼了嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "沒、",
    "voice": "vo_adv_1136001_050",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "沒事……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "請問……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "妳是海之家的員工、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是的，",
    "voice": "vo_adv_1136001_051",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我是臨時",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "來幫忙送餐的……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "對不起，",
    "voice": "vo_adv_1136001_052",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "因為妳在這種地方穿著鎧甲……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n這樣或許比在海邊遇到人魚更驚人呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "中年女性",
    "words": "這個外送員的興趣還真特別……",
    "voice": "vo_adv_1136001_053",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "中年男性",
    "words": "真有幹勁啊……",
    "voice": "vo_adv_1136001_054",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "可是，視覺上的衝擊好強烈……",
    "voice": "vo_adv_1136001_055",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "再點一些東西好了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "喂──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "我可以點餐嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "我也再點一份好了……",
    "voice": "vo_adv_1136001_056",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n不好意思──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好的，",
    "voice": "vo_adv_1136001_057",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "等送完餐後我們會再回來一趟。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n要點餐的話，可以去那邊的店面點……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "中年女性",
    "words": "是嗎？",
    "voice": "vo_adv_1136001_058",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "中年女性",
    "words": "那我們也試著點些什麼吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "中年男性",
    "words": "好啊，",
    "voice": "vo_adv_1136001_059",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "中年男性",
    "words": "東西應該是由你們送來吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "中年男性",
    "words": "\\n感覺會成為很棒的旅行見聞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是的，",
    "voice": "vo_adv_1136001_060",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "當然是由我們送來。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n好，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那我們稍微加快腳步吧，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n看來要變忙了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "歡迎回來！",
    "voice": "vo_adv_1136001_061",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "又有人點餐了！",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "看來是那樣沒錯。",
    "voice": "vo_adv_1136001_062",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是發生了什麼事嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "天曉得……",
    "voice": "vo_adv_1136001_063",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有一群人說",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "比人魚還怎樣怎樣的……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n呃，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "現在不是閒聊的時候。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這些",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "可以麻煩你們嗎？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n路線是這樣走，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "再去這裡。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我明白了。",
    "voice": "vo_adv_1136001_064",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那我們出動吧，少年。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，有咲戀跟純他們幫忙的海之家，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n客人變得絡繹不絕。",
    "voice": null,
    "unit_id": null
  }
]
