  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是那個溫柔可人，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "連蟲子都殺不下手的千歌嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗄啊啊啊啊！",
    "voice": "vo_adv_5009002_003",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　呀啊啊啊啊啊！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦咦，",
    "voice": "vo_adv_5009002_004",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "好大的聲音……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n牆壁都在隆隆作響了……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為千歌最愛唱歌了，平常都一直鍛練肺活量呢！",
    "voice": "vo_adv_5009002_005",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗚呀，耳朵好痛，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "鼓膜都要被震破了～！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗚嗄嚕嚕嚕嚕！　",
    "voice": "vo_adv_5009002_006",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咕呀啊啊啊啊啊啊啊！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊，咦……？",
    "voice": "vo_adv_5009002_007",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n那個人，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不知跑到哪裡去了耶……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "怎、怎麼回事呢……？",
    "voice": "vo_adv_5009002_008",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n她剛才",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "發出了像野獸的聲音，動作也很像野獸耶……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我、我也不曉得！",
    "voice": "vo_adv_5009002_009",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　但我要去追她！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要是她那種詭異的行為被粉絲目擊的話，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "偶像生涯就結束了……！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呀啊啊啊啊！？",
    "voice": "vo_adv_5009002_010",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哇，",
    "voice": "vo_adv_5009002_011",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "有尖叫聲……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n剛才的聲音是",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "可可蘿……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "可可蘿是今天負責下廚的人，",
    "voice": "vo_adv_5009002_012",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n現在應該是在廚房煮飯……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦咦，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "好像聽到了很大的聲音和尖叫聲……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "似、似乎是千歌失控了？",
    "voice": "vo_adv_5009002_013",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "到底是怎麼回事～",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "發生了什麼事啊？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我、",
    "voice": "vo_adv_5009002_014",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我不太清楚……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "總之我們去看看情況吧……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咲戀媽媽和鈴莓姐現在都不在，",
    "voice": "vo_adv_5009002_015",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我要守護【咲戀育幼院】才行……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "…………",
    "voice": "vo_adv_5009002_016",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "奇怪，",
    "voice": "vo_adv_5009002_017",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "綾音……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n妳、妳怎麼了……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "從剛才就一言不發的？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……不說話了。",
    "voice": "vo_adv_5009002_018",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "唔、",
    "voice": "vo_adv_5009002_019",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "綾音",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "妳平常是話匣子，現在不說話感覺好怪……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……從剛才到現在",
    "voice": "vo_adv_5009002_020",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉都不說話了。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦，那個……？",
    "voice": "vo_adv_5009002_021",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊，",
    "voice": "vo_adv_5009002_022",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不可以！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下不知道妳是哪位，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過做這種事讓在下很困擾啊！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那些是幫主人，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還有育幼院的大家做的料理！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "感、感覺好像真的發出了不妙的聲音！",
    "voice": "vo_adv_5009002_023",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我先走一步喔！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌～",
    "voice": "vo_adv_5009002_024",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然不知道妳在做什麼，不過快住手啊！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不可以再給其他人添麻煩了啦～！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗚嗚～？",
    "voice": "vo_adv_5009002_025",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "　怎麼回事，發生了什麼事……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n綾音感覺也變得好怪，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n接二連三的發生怪事……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "為什麼……？",
    "voice": "vo_adv_5009002_026",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n都快到快樂的聖誕節了，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n明明只要再等一下幸福就會來臨……？",
    "voice": null,
    "unit_id": 102111
  },
  {
