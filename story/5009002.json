  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請問……？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n您是哪位啊？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "可可蘿……",
    "voice": "vo_adv_5009002_030",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那……那個，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "這些人好像是",
    "voice": null,
