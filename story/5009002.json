    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然好不容易做的料理被糟蹋，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n讓在下有股難以忍受的怒氣。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哎呀呀，",
    "voice": "vo_adv_5009002_033",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "鍋子都打翻了呢……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "這些",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "都是千歌一個人做的嗎……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唉。",
    "voice": "vo_adv_5009002_034",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個人突然衝了進來，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n臉直接往鍋子撞上去。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下還想說到底是什麼事呢，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嚇了在下一大跳。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個叫千歌的，",
    "voice": "vo_adv_5009002_035",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就那樣子舔著舔著，把所有料理吃個精光了……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "明明只要跟在下說，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就會像平常一樣給她午餐。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "抱、抱歉啊～？",
    "voice": "vo_adv_5009002_036",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為什麼要那樣做呢千歌，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "肚子餓了嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "…………",
    "voice": "vo_adv_5009002_037",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……千歌？　",
    "voice": "vo_adv_5009002_038",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "奇怪，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "怎麼一聲不響的站著！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "到底是怎麼了～",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我搞不懂千歌在做什麼了呀！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……♪",
    "voice": "vo_adv_5009002_039",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "喔、喔喔？",
    "voice": "vo_adv_5009002_040",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳為什麼要那樣笑著靠近我啊？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n感覺好可怕啊……？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "唔嗚……♪",
    "voice": "vo_adv_5009002_041",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "噫呀？",
    "voice": "vo_adv_5009002_042",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "等一下，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為什麼要磨蹭我？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "住手啦，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好癢喔！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "舔舔……♪",
    "voice": "vo_adv_5009002_043",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哇呀！？",
    "voice": "vo_adv_5009002_044",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n不行不行，不可以舔，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "【慈樂之音】不必做這樣的粉絲服務！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然也有聽過這種要求，",
    "voice": "vo_adv_5009002_045",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但我的目標是成為傳統良好的清純派偶像……！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咬♪",
    "voice": "vo_adv_5009002_046",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好痛！？",
    "voice": "vo_adv_5009002_047",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "更不可以咬人～",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n留下齒痕的話，不就會出現奇怪的流言嗎！？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……♪",
    "voice": "vo_adv_5009002_048",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "喔喔？",
    "voice": "vo_adv_5009002_049",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n怎麼一臉滿足的倒下了！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦咦……？",
    "voice": "vo_adv_5009002_050",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n千歌妳到底怎麼了，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳想做什麼啊？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我真的不懂啊～！",
    "voice": null,
    "unit_id": 102913
  }
]
