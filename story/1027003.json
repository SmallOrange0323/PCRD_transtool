    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "唉呀……",
    "voice": "vo_adv_1027003_003",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這好像是……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "情書……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "的……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "樣子……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "呢……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不能原諒不能原諒不能原諒不能原諒不能原諒不能原諒……",
