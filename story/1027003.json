  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n{0}大人，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們一起去燒掉它吧。",
