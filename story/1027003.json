  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "代您……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "讀那封信……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "當然是應該立即丟掉它了。",
