  {
    "type": "background",
    "bg_id": "500220"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "骯髒的垃圾……",
    "voice": "vo_adv_1027003_006",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就要燒得一乾二淨連灰燼都不剩……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n最好是用火山的地獄業火……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "燃燒吧燃燒吧燃燒吧燃燒吧燃燒吧燃燒吧燃燒吧燃燒吧燃燒吧……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "垃圾就要像垃圾一樣……",
    "voice": "vo_adv_1027003_007",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "好好地處理掉……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那麼……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們出發吧。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "當然是去信中內容約好的地方",
    "voice": "vo_adv_1027003_008",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "呢……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "將膽敢接近{0}大人的母狗，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n好好地懲罰一番……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "為了讓她……",
    "voice": "vo_adv_1027003_009",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不再跟{0}大人扯上任何關係……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我會徹底地擊潰她……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……地圖上所標示的地點，",
    "voice": "vo_adv_1027003_010",
    "unit_id": 102711
  },
