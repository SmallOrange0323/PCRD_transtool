  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隨著萬聖節一天一天靠近，美咲的班級\\n也因為要舉辦萬聖節派對而熱鬧不已。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "好期待萬聖節唷～！",
    "voice": "vo_adv_1083001_000",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "希望可以拿到很多糖果呢～",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "對了，",
    "voice": "vo_adv_1083001_001",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "下個週末啊，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n我們大家一起來辦個萬聖節派對嘛！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "可以扮裝，然後帶點心來吃～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是的，只不過是萬聖節就這麼興奮……",
