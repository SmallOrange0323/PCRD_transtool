    "name": "美咲",
    "words": "才、",
    "voice": "vo_adv_1083001_011",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "才不是勒！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "只是今天晚點剛好沒事而已啦！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n別把我跟你們相提並論！",
    "voice": null,
    "unit_id": 105011
  },
