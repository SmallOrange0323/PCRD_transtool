  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊，",
    "voice": "vo_adv_1083001_024",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "對了！　",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我想到一個好主意了♪",
    "voice": null,
    "unit_id": 105011
  },
  {
