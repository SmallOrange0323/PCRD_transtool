  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "太、",
    "voice": "vo_adv_1083001_032",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "太好了！　",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真的拿到點心了！",
