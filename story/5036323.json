    "type": "dialogue",
    "name": "凜",
    "words": "滿足盆栽小花。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那當然！",
    "voice": "vo_adv_5036323_005",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n絕對要讓它認同",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我們三個的力量啦！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是的！　",
    "voice": "vo_adv_5036323_006",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我的心情也和妳們一樣……！",
    "voice": null,
    "unit_id": 112411
  },
