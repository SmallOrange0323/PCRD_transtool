    "name": "凱留",
    "words": "\\nや、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "やるわけないじゃない",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "ぎゅ～",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "っとか、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\nこんな恥ずかしいこと！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "へぇ～、",
    "voice": "vo_adv_5085006_071",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "そりゃもったいない。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "今なら多少素直になっても許されるだろうに。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "今度こそ、",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "ちゃんとしても",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "いいんじゃない？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "──キッス。",
    "voice": "vo_adv_5085006_072",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "しししっ、",
    "voice": "vo_adv_5085006_073",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "しないわよ！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "ってかまだいたの、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "あんた！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "ご挨拶だな～",
    "voice": "vo_adv_5085006_074",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\nアタシだって彼が心配でたまらなかったんだよ？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "ああそう！",
    "voice": "vo_adv_5085006_075",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "だったらあんたが抱きついてやればいいじゃない！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "ははは。",
    "voice": "vo_adv_5085006_076",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "それもいいとは思うけどね、",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "それよりも今回、",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "頑張ったのはキミたちだ。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\nその役は譲るとしよう。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "あっそ。",
    "voice": "vo_adv_5085006_077",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……そういえば、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "聞いておきたいんだけどさ。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "あの、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "陛下のプリンセスナイトの力なんだけど……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "ああそれなら、",
    "voice": "vo_adv_5085006_078",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "キミの中にはもうないよ。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "一時的に貸し与えたというか、",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "時限的に発動するようにしてただけみたいだね。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……そ。",
    "voice": "vo_adv_5085006_079",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "それより、",
    "voice": "vo_adv_5085006_080",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "改めて言わせてもらおうかな。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "少年を救ってくれたこと、",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "感謝するよ。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\n……ありがとう。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ラビリスタさん……",
    "voice": "vo_adv_5085006_081",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……別に、",
    "voice": "vo_adv_5085006_082",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "誰に頼まれてやったわけじゃないわよ。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "ふむ？",
    "voice": "vo_adv_5085006_083",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "ペコリーヌも、",
    "voice": "vo_adv_5085006_084",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "コロ助も、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "シェフィも。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "それに他の連中だって。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n頼まれなくたって、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "こうしていたわ。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "こいつが寝てる間、",
    "voice": "vo_adv_5085006_085",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "いろんな人に会って、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\nこいつのこれまでしてきたことを見てきたけど……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "みんな、",
    "voice": "vo_adv_5085006_086",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "こいつのことを本気で思って、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n心配して、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "力を貸してくれた。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "だから感謝なんていらないのよ。",
    "voice": "vo_adv_5085006_087",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\nただ、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "あたしが『良かった』って、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\nそう思えてるから、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "それでいい。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "みんな、",
    "voice": "vo_adv_5085006_088",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "そうなんじゃない？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……しっ、",
    "voice": "vo_adv_5085006_089",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "知らないけどね！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "キャルさま……！",
    "voice": "vo_adv_5085006_090",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "キャル……！",
    "voice": "vo_adv_5085006_091",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "なっ！　",
    "voice": "vo_adv_5085006_092",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "なによ！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\nあたしなんか変なこと言った！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "だっ、",
    "voice": "vo_adv_5085006_093",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "だから感謝なんていらないって言ってるでしょ！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "えへへ……☆",
    "voice": "vo_adv_5085006_094",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "やっぱりいいですね。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "今はここが、",
    "voice": "vo_adv_5085006_095",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "わたしの居場所。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "いっぱい笑って、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "たくさん遊んで、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "思いっきり食べて。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "幸せでお腹を満たせる場所。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……こちらこそ。",
    "voice": "vo_adv_5085006_096",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nありがとうございます、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}くん♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "……さて、",
    "voice": "vo_adv_5085006_097",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "そろそろいいかな？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "そろそろ……",
    "voice": "vo_adv_5085006_098",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "とは、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "なにがでございますか？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "いやぁ、",
    "voice": "vo_adv_5085006_099",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "そろそろ我慢できなくなってるんじゃないかなって。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "我慢……？",
    "voice": "vo_adv_5085006_100",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "キミたちがこうしている間にね、",
    "voice": "vo_adv_5085006_101",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\nその……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "集まってきてるんだよ。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "ほら、",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "聞こえない？　",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "ギルドハウスがきしむ音。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……まっ、",
    "voice": "vo_adv_5085006_102",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "まさか。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "そりゃあそうだよねぇ。",
    "voice": "vo_adv_5085006_103",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\nみんな心配してたわけだから。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "あ、",
    "voice": "vo_adv_5085006_104",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "足音が……！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nたくさんの足音が聞こえてきますよっ！？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "それじゃ、",
    "voice": "vo_adv_5085006_105",
    "unit_id": 106812
  },
  {
