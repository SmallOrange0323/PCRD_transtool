  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "──そうだね。",
    "voice": "vo_adv_5085006_027",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\n今回起きた全ての問題は片付いた。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ラビリスタさん……！",
    "voice": "vo_adv_5085006_028",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "彼の中で暴走しかけていた力も、",
    "voice": "vo_adv_5085006_029",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "すっかり元通り。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "あれだけのエネルギーを並列化して吸収してのけるとはね。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "これも絆の力ってやつかな……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "本当に、",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "計り知れないよ。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "じゃあどうして、",
    "voice": "vo_adv_5085006_030",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n彼はまだ起きないんですかっ！？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "そう心配する必要はないよ。",
    "voice": "vo_adv_5085006_031",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\n彼は今、",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "きっと向こうで別れを告げているのさ。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "記憶の欠片を歪に組み合わせただけの",
    "voice": "vo_adv_5085006_032",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "『作りものの世界』でも、",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\nそれは少年にとって",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "大切なものを積み上げた、",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "宝物に違いない。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "もう少しだけ待ってあげてくれないかな。",
    "voice": "vo_adv_5085006_033",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\nせめて、",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "夢の終わりを",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "笑顔で迎えられるように。",
    "voice": null,
    "unit_id": 106812
  },
