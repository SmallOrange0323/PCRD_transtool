  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天的蘭德索爾。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}正在追逐",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n拿著布巾包裹的倭。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哼，",
    "voice": "vo_adv_1300001_000",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我不要。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n這世上哪有說還就還的盜賊啊。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你很拼命嘛。",
    "voice": "vo_adv_1300001_001",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n也就是說……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這個布巾包裹裡，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "放了相當高級的東西是嗎。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那就讓我來好好鑑定看看♪",
    "voice": "vo_adv_1300001_002",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嘿",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "咻！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──哼！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──時間回到幾分鐘之前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n事情的開端，是走在街上的{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n遇到了一位老婆婆。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "嘿咻，",
    "voice": "vo_adv_1300001_003",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "嘿咻……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "啊，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "腰好痛啊……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "呼……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "哎呀，",
    "voice": "vo_adv_1300001_004",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "我還想說怎麼突然變輕了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "小哥要幫我拿嗎？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "這其實是我們家的傳家之寶，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "但實在是太重了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "真是幫了大忙，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "太謝謝你了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "但是重物都給你拿",
    "voice": "vo_adv_1300001_005",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "太不好意思了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "小哥的劍",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "也是很重要的東西吧。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "我幫你拿吧。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n要是碰撞傷到",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "就不好了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哼。",
    "voice": "vo_adv_1300001_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "傳家之寶嗎。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n聽到不錯的情報了呢♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "……？",
    "voice": "vo_adv_1300001_007",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n妳",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "是誰？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我的名字不重要啦。",
    "voice": "vo_adv_1300001_008",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n就只是個盜賊而已。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "盜、",
    "voice": "vo_adv_1300001_009",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "盜賊！？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n光、",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "光天化日之下",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "怎麼會出現在這裡……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那是我想說的。",
    "voice": "vo_adv_1300001_010",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n很不巧，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我也很喜歡拿走別人的東西呢。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──所以……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那個傳家之寶我就收下了！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哎呀嘿咻♪",
    "voice": "vo_adv_1300001_011",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "再見啦！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "啊啊？",
    "voice": "vo_adv_1300001_012",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "恕我拒絕。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "很不巧已經有人先跟我約好玩你追我跑了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你看看，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你的背後。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "士兵長",
    "words": "找到了！",
    "voice": "vo_adv_1300001_013",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "士兵長",
    "words": "倭在那邊！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "士兵長",
    "words": "\\n快追！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "士兵長",
    "words": "給我追──！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "真是的，",
    "voice": "vo_adv_1300001_014",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我只是和沒教養的惡棍們打個招呼而已，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n那群鎧甲團",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "就變了個眼神追上來了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "就這麼喜歡我嗎。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "算了。",
    "voice": "vo_adv_1300001_015",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "被追也有被追的快樂，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這就是盜賊的天性啊。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哼，",
    "voice": "vo_adv_1300001_016",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我不要。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n這世上哪有說還就還的盜賊啊。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你很拼命嘛。",
    "voice": "vo_adv_1300001_017",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "也就是說……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n這個布巾包裹裡，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "放了相當高級的東西是嗎。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那就讓我來好好鑑定看看♪",
    "voice": "vo_adv_1300001_018",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嘿",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "咻！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──哼！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "倭將布包巾包裹丟向地面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n從裡面出現的是──一點也不適合被稱為傳家之寶的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n垃圾堆。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哈，",
    "voice": "vo_adv_1300001_019",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我就知道是這樣。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "小子你被太多女生利用了啦。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "真是的，",
    "voice": "vo_adv_1300001_020",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不要愣在那邊。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n你看那邊的街道！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "倭的手指向的地方，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n有拿著沉重布包巾包裹的老人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n和打算去幫助他的青年──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "不好意思呢。",
    "voice": "vo_adv_1300001_021",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n讓你拿這麼重的東西。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "不會不會。",
    "voice": "vo_adv_1300001_022",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "這是傳家之寶對吧？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n我幫你拿到目的地那邊。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "啊那麼，",
    "voice": "vo_adv_1300001_023",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "小哥你的東西，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "就換我來拿著吧。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n這點程度的話我也拿得動。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "那就麻煩你了。",
    "voice": "vo_adv_1300001_024",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "嘿",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "咻",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "──",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "好咧……",
    "voice": "vo_adv_1300001_025",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "（歪嘴笑）。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "──抱歉啦小哥。",
    "voice": "vo_adv_1300001_026",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n這些東西我就收下了！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "……",
    "voice": "vo_adv_1300001_027",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "咦咦！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "我的東西！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n裡面有我的錢包跟鑰匙……！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "話說，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "那傢伙根本不是老爺爺啊！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "咦，",
    "voice": "vo_adv_1300001_028",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "那這個傳家之寶是……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "──！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n哇啊啊啊，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "裡面就只有石頭啊──！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……就是這樣。",
    "voice": "vo_adv_1300001_029",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你懂了吧小子？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那群傢伙是熟練的盜賊集團。",
    "voice": "vo_adv_1300001_030",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n打算拿走你的劍的那傢伙也是用同樣的手法。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "最近流行起",
    "voice": "vo_adv_1300001_031",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "叫做「假求助強盜」的手法。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "利用人的善意，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "直接奪走交給他拿著的東西。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "所有傢伙都裝成老人的樣子，",
    "voice": "vo_adv_1300001_032",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "其實都是年輕的小偷。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "明明到處都有貼通緝令，",
    "voice": "vo_adv_1300001_033",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n沒想到還會有這麼多人上那種人的當啊。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哈，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "蘭德索爾真是個愚蠢的城鎮。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哼，",
    "voice": "vo_adv_1300001_034",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "勉強算是逃過一劫了呢。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n如果是很重要的東西，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "最好片刻不離地帶在身上。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……什麼？",
    "voice": "vo_adv_1300001_035",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "別說傻話了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n為什麼我要幫你啊。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……看到那種狡猾的傢伙，",
    "voice": "vo_adv_1300001_036",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我就會很不爽。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "想要的話就直接搶走就好不是嗎？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不需要做出這種拐彎抹角的事情。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "所以才不自覺的，",
    "voice": "vo_adv_1300001_037",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "就想出手妨礙而已。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "很可惜，不是為了你。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "話說，",
    "voice": "vo_adv_1300001_038",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嗯？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n──那個狡猾的小偷，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "正在往這個方向逃呢。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "【王宮騎士團】在追他……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哼♪",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "閃開！",
    "voice": "vo_adv_1300001_039",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "別擋路！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n閃開閃開！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──嘿咻。",
    "voice": "vo_adv_1300001_040",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "哇哇！？",
    "voice": "vo_adv_1300001_041",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "唔哦哦！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "──妳這傢伙……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "是故意絆倒我的吧！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n搞屁啊！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "喂～",
    "voice": "vo_adv_1300001_042",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "貪吃公主手下的鎧甲團！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n要追我也是可以，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n但這裡還有一個，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "通緝犯喔──",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嘿！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "哇",
    "voice": "vo_adv_1300001_043",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "啊啊啊啊！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n不、",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "不要把我丟出去啊啊啊！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "士兵長",
    "words": "嗯？",
    "voice": "vo_adv_1300001_044",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "士兵長",
    "words": "這張臉……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "士兵長",
    "words": "是假求助強盜的成員！？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "士兵長",
    "words": "\\n──逮捕了！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "怎麼這樣！",
    "voice": "vo_adv_1300001_045",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哈哈哈！",
    "voice": "vo_adv_1300001_046",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……那麼，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我也趁這個機會閃人吧。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "小子你也別一直迷迷糊糊的。",
    "voice": "vo_adv_1300001_047",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n偶爾也要懷疑別人。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──再見了！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "怎麼了，",
    "voice": "vo_adv_1300001_048",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "連小子你也要追著我啊。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我是沒關係，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "但你跟得上小偷逃跑的速度嗎？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n來啊來啊，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "來啊來啊♪",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……小子你，",
    "voice": "vo_adv_1300001_049",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "意外的很難纏呢。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "什麼？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你說什麼？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "有想跟我說的話？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "………………",
    "voice": "vo_adv_1300001_050",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "真是的，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你的理解力真差。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我剛剛不是說過了，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "才不是為了小子你呢。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你說什麼？",
    "voice": "vo_adv_1300001_051",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n你說我雖然說很討厭狡猾的小偷，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n但【蠻賊三姊妹】對格羅哥團做的事，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "也大同小異？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "所以剛剛的解釋……",
    "voice": "vo_adv_1300001_052",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不合邏輯？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "…………",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n……小子……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你這傢伙……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你是在說",
    "voice": "vo_adv_1300001_053",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我講的話沒有信用嗎？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "所以怎樣……",
    "voice": "vo_adv_1300001_054",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n其實是我想幫你才出手幫忙的……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你是想這樣說嗎！",
    "voice": "vo_adv_1300001_055",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n啊啊啊啊啊啊！？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "………………",
    "voice": "vo_adv_1300001_056",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "啊？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "………………",
    "voice": "vo_adv_1300001_057",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……哼──哈哈哈！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "…………",
    "voice": "vo_adv_1300001_058",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你啊…………",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "看起來迷迷糊糊的，",
    "voice": "vo_adv_1300001_059",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "卻蠻會說話的嘛。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……哼。",
    "voice": "vo_adv_1300001_060",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "已經被拒絕兩次，",
    "voice": "vo_adv_1300001_061",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我本來打算要放棄了，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "但果然就這麼放過你還是太可惜了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……呵呵呵。",
    "voice": "vo_adv_1300001_062",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "俗話說事不過三，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "對吧♪",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嗯，",
    "voice": "vo_adv_1300001_063",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "就如你所說。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我是為了幫你，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "才搶走布巾包裹的。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "再怎麼說我都是做竊盜事業的。",
    "voice": "vo_adv_1300001_064",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "和商人不同，買賣不是我的本分。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我是喜歡拿走別人的東西，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "但不喜歡賣人情。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "想要的東西用自己的力量獲得就好。",
    "voice": "vo_adv_1300001_065",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我可沒有",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "即使拿人情當擋箭牌，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n也想要讓他人做的事。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……這個嘛，",
    "voice": "vo_adv_1300001_066",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我直到剛剛都是這麼想的……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "但看來即使是我，",
    "voice": "vo_adv_1300001_067",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n也有憑自己的力量無法如願的事。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "所以說現在，",
    "voice": "vo_adv_1300001_068",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n就讓我期待一下小子的報恩吧。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "雖然這是把沒什麼勝算的賭注──",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──跟我來！",
    "voice": "vo_adv_1300001_069",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n都是為了幫你",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "害得我被鎧甲團縮短距離了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n作為補償你就跟著我一天，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "幫我把風吧！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "然後也順便……",
    "voice": "vo_adv_1300001_070",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n讓和若菜一樣不經事的你",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "累積一下社會經驗……♪",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}被倭拉著手，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "消失在蘭德索爾昏暗的巷弄中。",
    "voice": null,
    "unit_id": null
  }
]
