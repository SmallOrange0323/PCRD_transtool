[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……啊？",
    "voice": "vo_adv_9500098_000",
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "等一下，",
    "voice": "vo_adv_9500098_001",
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛剛",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "說了什麼？",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n要選我",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "當公主？",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這個玩笑",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "一點都不好笑。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "別這樣，",
    "voice": "vo_adv_9500098_002",
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "其他選擇多得是吧？",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你最難受的時候，",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "什麼都做不到。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "回溯時也是，",
    "voice": "vo_adv_9500098_003",
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我也只讓你",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n閉上眼睛……",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "沒能為你做到什麼。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我……",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就是那樣的存在。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……唔，",
    "voice": "vo_adv_9500098_004",
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "什麼意思啊……",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就是因為你會這麼說，",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我才……",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……笨蛋，",
    "voice": "vo_adv_9500098_005",
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這樣",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "哪夠啊。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你明明",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "什麼都不記得，",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n只有我",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "記得一切……",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這樣根本",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "一點都不好。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我",
    "voice": "vo_adv_9500098_006",
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "想一直待在你身邊。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n站在你身邊，",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "手牽著手，",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "一起冒險，",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "然後──",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在我還是妖精時，",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這些都像是夢一樣。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但，",
    "voice": "vo_adv_9500098_007",
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "既然你選擇了我。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n──我也會",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "選擇你。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不是作為嚮導小妖精，",
    "voice": "vo_adv_9500098_008",
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也不是作為女神。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "而是只作為單純的我，",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "待在你身邊。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n用這雙手，",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這雙腳。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好了，",
    "voice": "vo_adv_9500098_009",
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你不是主動邀過我嗎？",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n說要一起去某個地方。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我可是",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "一直在等耶。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你要回握啊，",
    "voice": "vo_adv_9500098_010",
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "笨蛋。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n要是鬆開手……",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我可不會原諒你。",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "引導你",
    "voice": "vo_adv_9500098_011",
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就是我的工作",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……一直",
    "voice": null,
    "unit_id": 123041
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "喔。",
    "voice": null,
    "unit_id": 123041
  }
]
