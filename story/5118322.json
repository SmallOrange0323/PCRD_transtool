    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "輕輕鬆鬆就化解了喔！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "可別要戰鬥的對象乖乖等你哪♪",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "我學到一課了。",
    "voice": "vo_adv_5118322_001",
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "就用下一招吧……",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "伸長吧，",
    "voice": "vo_adv_5118322_002",
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "偉大臂膀！！",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "危險！",
    "voice": "vo_adv_5118322_003",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "雖然早知道那個臂膀可以自由伸縮……",
    "voice": "vo_adv_5118322_004",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "但沒想到它可以伸到這麼遠的後排來！",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這下子，如果往後退得太多，便會很危險。",
    "voice": "vo_adv_5118322_005",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "雖然如此，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "但要是因此上前，就合了莫夫的意……！",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "看來抓準不會太近或太遠的距離，乘隙攻擊是最好的。",
    "voice": "vo_adv_5118322_006",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "還請大家多加注意，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不要鬆懈了！",
    "voice": null,
    "unit_id": 125711
  }
]
