  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "萬聖節慶典即將在蘭德索爾的鬧區登場，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n大家正如火如荼地準備慶典，街上充滿甜點的香甜氣味。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈～",
    "voice": "vo_adv_5076003_000",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "小棉花糖，等等～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我給你吃甜點，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "要不要去找大家～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "小棉花糖",
    "words": "汪汪！",
    "voice": "vo_adv_5076003_001",
    "unit_id": 7611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "小棉花糖的數量",
    "voice": "vo_adv_5076003_002",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "一天比一天多……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n牠們大概是受到香甜的氣味吸引，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "才從靈界",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "一隻接一隻地跑過來吧。",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這樣下去，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "根本沒完沒了。",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "現在",
    "voice": "vo_adv_5076003_003",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還勉強能把牠們抓起來，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n要是再多下去，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "應該會很吃力吧？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "如果繼續增加，",
    "voice": "vo_adv_5076003_004",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不只我們抓不完～",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n而且這樣一來，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "在萬聖節慶典開始之前，甜點就會被吃光了！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "說得也是～",
    "voice": "vo_adv_5076003_005",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n真希望博士的研究",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "能趕快有進展……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂，",
    "voice": "vo_adv_5076003_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "{0}！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "好久不見啊～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "有新種妖魔出現了～！？",
    "voice": "vo_adv_5076003_007",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "對方的目標似乎是將軍！",
    "voice": "vo_adv_5076003_008",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "看我妮諾",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "讓你吃不完兜著走是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "能抓到小棉花糖之外的妖魔也比較好！",
    "voice": "vo_adv_5076003_009",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n大家",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "上吧～！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "等、",
    "voice": "vo_adv_5076003_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "等一下！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳們冷靜一點！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n{0}你也說句話啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是我啦，",
    "voice": "vo_adv_5076003_011",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是我！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你不會說",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "忘記我是誰了吧？",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "竟然假裝成認識的人企圖接近，",
    "voice": "vo_adv_5076003_012",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "真是惡劣的手法！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我現在",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "就讓你束手就擒是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂，",
    "voice": "vo_adv_5076003_013",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "別再開這種惡質的玩笑了！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "別害我真的被她們打倒！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我是傑克啦！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "忘記我的臉太誇張囉！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "太好了～！",
    "voice": "vo_adv_5076003_014",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "原來你還記得我！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "很久沒見了，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "還真有點怕你忘記我！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，",
    "voice": "vo_adv_5076003_015",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "原來你認識這個妖魔啊？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n你的人面",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "也太廣了吧？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈～",
    "voice": "vo_adv_5076003_016",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你的臉感覺就像是萬聖節的代表呢～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我是",
    "voice": "vo_adv_5076003_017",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "傑克！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "是萬聖節的精靈！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n我跟{0}",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "之前有過幾面之緣……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n再次",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "請妳們多指教啦！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "也請你多多指教～！",
    "voice": "vo_adv_5076003_018",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我們是",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "萬聖節拯救隊～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你說你是萬聖節的精靈……",
    "voice": "vo_adv_5076003_019",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "所以傑克你是來現實世界玩的囉～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "平常是這樣沒錯……",
    "voice": "vo_adv_5076003_020",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n但今年不只這樣，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我是來拯救現實世界的。",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你說拯救現實世界，",
    "voice": "vo_adv_5076003_021",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "什麼意思～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "其實……",
    "voice": "vo_adv_5076003_022",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "有某隻妖魔",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "從靈界跑出來了，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n我是追著那傢伙，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "不久前來到現實世界的。",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "那傢伙是",
    "voice": "vo_adv_5076003_023",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "超特級妖魔，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "放任牠到處亂跑會很危險，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n我必須趕快找到牠，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "把牠送回靈界才行。",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "要是那傢伙發狂，",
    "voice": "vo_adv_5076003_024",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "萬聖節……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "不，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "整個現實世界都會被弄得一團糟。",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的假的……？",
    "voice": "vo_adv_5076003_025",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "香織，",
    "voice": "vo_adv_5076003_026",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "如果傑克說的是真的……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n是不是就代表",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "博士是正確的……？",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "糟了～",
    "voice": "vo_adv_5076003_027",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒想到竟然會這樣～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "再過不久",
    "voice": "vo_adv_5076003_028",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "就是萬聖節了吧？",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n有發生",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "什麼奇怪的事嗎？",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "奇怪的事……",
    "voice": "vo_adv_5076003_029",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯～～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "好像沒發生什麼特別奇怪的事～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n硬要說的話，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就是街上出現了很多這種狗～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "小棉花糖",
    "words": "汪！",
    "voice": "vo_adv_5076003_030",
    "unit_id": 7611
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "嗯……？",
    "voice": "vo_adv_5076003_031",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "這是什麼狗？",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n……牠是妖魔嗎？",
