    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "光靠幾個人類合力，",
    "voice": "vo_adv_5076003_043",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "對上牠是毫無勝算……",
