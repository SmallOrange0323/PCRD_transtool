  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "與其說像真正的飼主一樣，",
    "voice": "vo_adv_5076003_066",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不如說看起來越來越像一家人了！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "是啊～",
    "voice": "vo_adv_5076003_067",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "看著大家開開心心地一起吃點心，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我也想起了故鄉的家人～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們常常像這樣",
    "voice": "vo_adv_5076003_068",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "懶洋洋地躺在地上，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n一起吃著開口笑",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "度過悠閒時光～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "小棉花糖你們的故鄉",
    "voice": "vo_adv_5076003_069",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "是什麼樣的地方呢～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "小棉花糖",
    "words": "汪！",
    "voice": "vo_adv_5076003_070",
    "unit_id": 7611
  },
  {
    "type": "dialogue",
    "name": "小棉花糖",
    "words": "汪！",
    "voice": null,
    "unit_id": 7611
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈～",
    "voice": "vo_adv_5076003_071",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "說的也是，你們沒辦法回答呢～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "雖然我們不懂彼此的語言……",
    "voice": "vo_adv_5076003_072",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "心意還是可以互通吧～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我來跟你們說說",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我的故鄉吧～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我出生成長的地方，",
    "voice": "vo_adv_5076003_073",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n四面環繞著",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "非常非常美麗的大海……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚喔喔喔喔喔喔喔喔喔喔喔喔喔──！！！！",
    "voice": "vo_adv_5076003_074",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那、",
    "voice": "vo_adv_5076003_075",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那是什麼叫聲──！？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "博士",
    "words": "大、",
    "voice": "vo_adv_5076003_076",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "博士",
    "words": "大事不妙了！！",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "博士",
    "words": "\\n我觀測到前所未有的強烈能量！！",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "博士",
    "words": "來源……",
    "voice": "vo_adv_5076003_077",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "博士",
    "words": "不明？",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "博士",
    "words": "\\n是因為能量太強，沒辦法辨識嗎！？",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "博士",
    "words": "雖然必須詳細分析才能確定，",
    "voice": "vo_adv_5076003_078",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "博士",
    "words": "\\n但影響範圍肯定遍及蘭德索爾……",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "博士",
    "words": "不，",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "博士",
    "words": "肯定",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "博士",
    "words": "遍及整個阿斯特賴亞大陸。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "博士",
    "words": "嗯嗯嗯……",
    "voice": "vo_adv_5076003_079",
    "unit_id": 7511
  },
  {
    "type": "background",
    "bg_id": "505034"
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "剛才的……",
    "voice": "vo_adv_5076003_080",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "該不會是！？",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "糟了！",
    "voice": "vo_adv_5076003_081",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我得趕快過去！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "background",
    "bg_id": "501420"
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "剛才那個，",
    "voice": "vo_adv_5076003_082",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "該不會是傑克在找的妖魔的叫聲……？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "簡直",
    "voice": "vo_adv_5076003_083",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "就像蟾蜍的打呼聲一樣，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "求老天保佑，求老天保佑……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家嚇了好大一跳～！",
    "voice": "vo_adv_5076003_084",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "太恐怖了吧，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們怎麼可能打得過能發出那種叫聲的妖魔！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "小棉花糖們",
    "words": "嗷嗚────！！",
    "voice": "vo_adv_5076003_085",
    "unit_id": 7611
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒事的，",
    "voice": "vo_adv_5076003_086",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "放輕鬆～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n不要怕，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "放心吧～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "小棉花糖們",
    "words": "嗷嗚嗚嗚──────！！",
    "voice": "vo_adv_5076003_087",
    "unit_id": 7611
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嚎叫……？",
    "voice": "vo_adv_5076003_088",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "難不成，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "牠們對剛才的巨響起了反應～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "而且，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "總覺得",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "叫聲聽起來有點寂寞～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是嗎？",
    "voice": "vo_adv_5076003_089",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我隱約有這種感覺～",
    "voice": "vo_adv_5076003_090",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n牠們到這個世界來也有好一陣子了，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n說不定是在想家～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "究竟還有多少隻",
    "voice": "vo_adv_5076003_091",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "小棉花糖呢～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真想趕快全部找出來，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "讓牠們回到故鄉……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "神秘叫聲響徹天際的當晚，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n小棉花糖們的嚎叫一直持續到天亮。",
    "voice": null,
    "unit_id": null
  }
]
