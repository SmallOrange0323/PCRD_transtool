    "name": "香織",
    "words": "牠是小棉花糖～！",
    "voice": "vo_adv_5076003_032",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我們正在抓牠的同伴～",
