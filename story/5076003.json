    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "究竟是正確的，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "還是錯誤的，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n果然還是",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "令人搞不懂……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "{0}，你也在試圖拯救世界吧？",
    "voice": "vo_adv_5076003_040",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "或許我們的目的不同，",
    "voice": "vo_adv_5076003_041",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "但現在就互相合作吧。",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n如果",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "發現感覺很危險的妖魔，",
