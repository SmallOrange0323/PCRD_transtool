    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "低得驚人。",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "就連我看到牠，",
    "voice": "vo_adv_5076003_036",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "都會把牠當成普通的狗，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "所以妳們大可放心！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我在找的妖魔，",
    "voice": "vo_adv_5076003_037",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "有著山一樣巨大的身驅，穿梭在靈界的黑暗中……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n豎立的毛髮",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "像熊熊燃燒的火焰……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n閃著光芒的鋒利尖牙",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "能咬碎一切……",
