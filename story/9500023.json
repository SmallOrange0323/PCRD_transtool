[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這，",
    "voice": "vo_adv_9500023_000",
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "難不成……",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n是在說喜歡我嗎？",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n不只是作為朋友",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "或一起並肩作戰的夥伴",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊……",
    "voice": "vo_adv_9500023_001",
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我真的好開心。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "能聽到",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你對我說這些話……",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n知道你把我當成",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "比任何人都重要的人，",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真的……",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": "vo_adv_9500023_002",
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不小心有點激動了……",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "既然你都把自己的心意告訴我了，",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n那我也必須有所回應才行呢。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也……",
    "voice": "vo_adv_9500023_003",
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "有著同樣的心情。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我打從心底",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "愛著{0}。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "愛得比任何人都還要深、",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還要強烈。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "如果能夠如願，",
    "voice": "vo_adv_9500023_004",
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "今後我也想……",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n陪伴著你",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "一起走下去。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "直到死亡將我們分開……",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不，",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "即使在那之後，",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也要永遠在一起……",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……你還記得嗎？",
    "voice": "vo_adv_9500023_005",
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "以父親的謊言為契機，",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我們一起度過",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "「世界末日」的那段時光……",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我當時",
    "voice": "vo_adv_9500023_006",
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真的很開心。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n因為你",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "選擇了我",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "作為一起度過最後一天的人……",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n還對我說，",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我是你比任何人都還要重要的人。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也因為你讓我相信了這一點。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "然後……",
    "voice": "vo_adv_9500023_007",
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那份情感，",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "在我心中不斷加深。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我想著，如果你也能像我一樣，",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "對我抱有同樣的感情",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就好了……",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以，",
    "voice": "vo_adv_9500023_008",
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我現在感到非常滿足。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n因為你幫我實現了",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我一直以來的夢想……",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵……",
    "voice": "vo_adv_9500023_009",
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "說的也是。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我想和",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}在一起。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n所以……",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我無法接受",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "什麼世界末日。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "用我們的力量",
    "voice": "vo_adv_9500023_010",
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "改變命運吧。",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n不管是擋在眼前的敵人，",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還是降臨的災厄……",
    "voice": null,
    "unit_id": 103141
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我會全部掃除掉……！",
    "voice": null,
    "unit_id": 103141
  }
]
