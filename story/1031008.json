[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "忍和{0}在蘭德索爾散步時，\\n突然被奇妙的光芒環繞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "又是這道光……好、好刺眼……",
    "voice": "vo_adv_1031008_000",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呀！",
    "voice": "vo_adv_1031008_001",
    "unit_id": 103111
  },
  {
    "type": "background",
    "bg_id": "510351"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，{0}，你好。",
    "voice": "vo_adv_1031008_002",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我現在在做什麼嗎？我在看雜誌。",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這本靈異週刊很有趣唷。",
    "voice": "vo_adv_1031008_003",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "對吧，爸爸？",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……爸爸？",
    "voice": "vo_adv_1031008_004",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……不好了。不知道什麼時候，",
    "voice": "vo_adv_1031008_005",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我父親被掉包成假貨了。",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "看來是被偷走了。",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不會的。",
    "voice": "vo_adv_1031008_006",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n因為我父親沒有半個粉絲，所以那是不可能的。",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我想那也不可能。",
    "voice": "vo_adv_1031008_007",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因為幾乎沒有人會相信，",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n那個骷髏頭是我的父親。",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我想這可能是某個骨董仲介商搞的鬼，",
    "voice": "vo_adv_1031008_008",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n一定是想把我父親賣到某個地方。",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我父親附身的骷髏頭，做為「椿丘水晶骷髏頭」，",
    "voice": "vo_adv_1031008_009",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n被認為是古代文明的時代錯置古文物而引起了話題。",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過實際上那只是父親在路邊攤買的便宜貨。",
    "voice": "vo_adv_1031008_010",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，{0}，請等一下！",
    "voice": "vo_adv_1031008_011",
    "unit_id": 103133
  },
  {
    "type": "background",
    "bg_id": "510030"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呼…",
    "voice": "vo_adv_1031008_012",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "…\\n{0}……請……請等一下……",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "background",
    "bg_id": "510101"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呼、呼……",
    "voice": "vo_adv_1031008_013",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}……等、等等我……",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "background",
    "bg_id": "510351"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呼、呼……",
    "voice": "vo_adv_1031008_014",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呼啊……",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "總算追上你了……",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個，不知道犯人的長相和服裝的話，",
    "voice": "vo_adv_1031008_015",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n要找出來實在太困難了。",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不用了。在這個城鎮，",
    "voice": "vo_adv_1031008_016",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我想我會比警察更快找到犯人。",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就交給我吧。",
    "voice": "vo_adv_1031008_017",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n這裡可是有很多只有我能對話的目擊者。",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你看。",
    "voice": "vo_adv_1031008_018",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "跟在{0}後面的女性也說，",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n她看到犯人了喔。",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "background",
    "bg_id": "510281"
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "嘿嘿嘿……",
    "voice": "vo_adv_1031008_019",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "\\n用這個傳聞中的骷髏頭，",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "\\n來大撈一筆吧。",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "找到了。",
    "voice": "vo_adv_1031008_020",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n你就是偷走我父親的犯人吧。",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n把我父親還來。",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "呿！被發現了嗎！？",
    "voice": "vo_adv_1031008_021",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "\\n",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "別來妨礙我，快滾到一邊去！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊",
    "voice": "vo_adv_1031008_022",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "！",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "嘿，妳就乖乖地倒在那裡吧！",
    "voice": "vo_adv_1031008_023",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "\\n後會無期啦！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "……嗯？骷髏頭變紅了――",
    "voice": "vo_adv_1031008_024",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "好燙燙燙燙！",
    "voice": "vo_adv_1031008_025",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "\\n搞、搞什麼啊，怎麼回事！？燙得拿不了啊！？",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "一定是因為小偷揍飛了我，所以我父親生氣了。",
    "voice": "vo_adv_1031008_026",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "好、好恐怖的骷髏頭……",
    "voice": "vo_adv_1031008_027",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "\\n",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "這種鬼玩意兒我不要了啦！！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，小偷逃走了。",
    "voice": "vo_adv_1031008_028",
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過既然我父親平安無事回來，也不用去追他了。",
    "voice": null,
    "unit_id": 103133
  },
  {
    "type": "still",
    "still_id": "103100801"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "太好了，爸爸。",
    "voice": "vo_adv_1031008_029",
    "unit_id": 103132
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n這個人幫忙我一起找你喔。",
    "voice": null,
    "unit_id": 103132
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n所以爸爸也向他道謝吧。",
    "voice": null,
    "unit_id": 103132
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗯嗯……",
    "voice": "vo_adv_1031008_030",
    "unit_id": 103132
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103132
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我父親說，",
    "voice": null,
    "unit_id": 103132
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103132
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "「我說過不准再接近忍了吧！我宰了你喔！」",
    "voice": null,
    "unit_id": 103132
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸真是的，這麼害臊啊。",
    "voice": "vo_adv_1031008_031",
    "unit_id": 103132
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這次多虧了",
    "voice": "vo_adv_1031008_032",
    "unit_id": 103132
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "聚集在這裡的眾多幽靈們，",
    "voice": null,
    "unit_id": 103132
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n才能順利地找到我父親。",
    "voice": null,
    "unit_id": 103132
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "竟然有這麼多的幽靈一起來幫忙……",
    "voice": "vo_adv_1031008_033",
    "unit_id": 103132
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n這都是因為你平常做人很成功的關係。",
    "voice": null,
    "unit_id": 103132
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真是太了不起了，{0}。",
    "voice": "vo_adv_1031008_034",
    "unit_id": 103132
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "自己的父親被偷走卻沒發現……",
    "voice": "vo_adv_1031008_035",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n忍也真是個隨性的孩子呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但還好最後順利找回來了～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如何呢？這是我給你的禮物！ 你做了個好「夢」嗎？",
    "voice": "vo_adv_1031008_036",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這是我依照你跟忍以前的記憶創造出來的「夢」，",
    "voice": "vo_adv_1031008_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n原來現在的你會採取這樣的行動呀。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我看了也很開心呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次見囉～ ♪",
    "voice": "vo_adv_1031008_038",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……啊，{0}，",
    "voice": "vo_adv_1031008_039",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n你醒來了嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也是剛剛才醒來喔。",
    "voice": "vo_adv_1031008_040",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n和上次一樣，我夢到了一個奇妙世界。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n{0}也做了一樣的夢嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……這樣呀。",
    "voice": "vo_adv_1031008_041",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n果然是很不可思議的夢呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n這會不會是某種心電感應呢？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過，{0}。",
    "voice": "vo_adv_1031008_042",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你在夢裡面也幫了我找到父親，謝謝你。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你在夢裡面也很溫柔呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "忍和{0}的心中都想著，\\n想再做一些這令人感覺奇妙又懷念的夢。",
    "voice": null,
    "unit_id": null
  }
]
