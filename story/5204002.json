    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "\\n不愧是瑪莉絲黛菈……",
    "voice": null,
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "\\n全部的人都飛走了！",
    "voice": null,
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "……哼。",
    "voice": "vo_adv_5204002_086",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n你是怎麼了。",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n被留下來嗎？",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "啊哈，",
    "voice": "vo_adv_5204002_087",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "我也不知道！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "你沒必要在意這個。",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "因為我會讓你也飛走的！！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "那麼，",
    "voice": "vo_adv_5204002_088",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "掰囉～！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "瑪莉絲黛菈所創造出來的藥，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "讓大家不知道飛往了哪裡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n【阿爾克絲鍊金堂】與【暮光流星群】",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n……以及，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一行人的下場究竟會如何呢──",
    "voice": null,
    "unit_id": null
  }
]
