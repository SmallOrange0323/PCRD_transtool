[
  {
    "type": "background",
    "bg_id": "500203"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "布里薩溪谷──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n【阿爾克絲鍊金堂】與【暮光流星群】，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正在與一名神似露易絲瑪莉的鹿少女對峙中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "什……",
    "voice": "vo_adv_5204002_000",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "什什什……",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "呼……",
    "voice": "vo_adv_5204002_001",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "呼……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n終於找到妳了……！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "沒有到",
    "voice": "vo_adv_5204002_002",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "「終於」",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那麼辛苦就是了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n幾乎是在出發後",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "就馬上發現。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "哇～！",
    "voice": "vo_adv_5204002_003",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "妳們看妳們看！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n好厲害，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "就好像有兩個露易一樣好有趣哦～！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "也想要有另一個彩羽～！！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "啊，",
    "voice": "vo_adv_5204002_004",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "對了！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "我說～",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "露易",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "妳過來一下，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "並排站一起！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n好，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "預備～！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "靈魂～",
    "voice": "vo_adv_5204002_005",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "出竅～～～！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉‧瑪莉絲黛菈",
    "words": "妳這是在做什麼啦！！",
    "voice": "vo_adv_5204002_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……祖母！！",
    "voice": "vo_adv_5204002_007",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n妳是",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "瑪莉絲黛菈祖母對吧！？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "妳、",
    "voice": "vo_adv_5204002_008",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "妳為什麼會知道我的名字！？",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "不對……",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "比起這個，",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "妳叫誰祖母啊！！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n對我這個水噹噹的摩登辣妹來說",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "未免太失禮了吧！！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "話說妳到底是誰啊！？",
    "voice": "vo_adv_5204002_009",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n難道是在模仿我嗎！？",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n快點從我眼前消失，",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "妳這模仿我的",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "冒牌貨！！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "誰是冒牌貨啦！",
    "voice": "vo_adv_5204002_010",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "是我，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "露易絲瑪莉啊！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n是超越瑪莉絲黛菈祖母的天才鍊金術師，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "妳的孫女！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "若無其事地偷踩對方……",
    "voice": "vo_adv_5204002_011",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "孫女！？",
    "voice": "vo_adv_5204002_012",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "妳說連男朋友都沒交過的我",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "有孫女",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "是在開什麼玩笑！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "不過嘛，",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "我這麼受歡迎！？",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n要找到阿娜答",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "當永久飯票",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "也是輕輕鬆鬆啦！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "咦……",
    "voice": "vo_adv_5204002_013",
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "那跟我在一起怎麼樣？",
    "voice": null,
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "而且再說，",
    "voice": "vo_adv_5204002_014",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "怎麼可能會有能超越我的天才鍊金術師！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n少在那胡說了！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "真是的，",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "真想看看教育妳的父母長什麼模樣！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我的父母之一就是妳女兒啊……",
    "voice": "vo_adv_5204002_015",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "不、",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "不對比起那個。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "居然會不認得我，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "這是怎麼回事……！？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "先不管那隻被妳們華麗地無視的巨人……",
    "voice": "vo_adv_5204002_016",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我說露易美眉，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "所以",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "她的確是妳奶奶",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對吧？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這是最終答案囉？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不是假冒的？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "確實先來確認一下這點比較好呢……",
    "voice": "vo_adv_5204002_017",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "說，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "祖母！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n妳身上戴的那個金墜飾，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "把它打開看看。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n裡面應該有張相片。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "妳對這有印象嗎？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "別再",
    "voice": "vo_adv_5204002_018",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "叫我祖母了，",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "我扭斷妳哦！！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n真是的……",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "這個墜飾怎麼了嗎？",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "說起來不知道什麼時候我就戴著了呢，",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "這金墜飾。",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "照片……",
    "voice": "vo_adv_5204002_019",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "呃，",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "裡面有位不認識的老婆婆跟小孩子的照片！？",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "好詭異喔……！！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "所以說那就是妳和我啦！",
    "voice": "vo_adv_5204002_020",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……瑪莉絲黛菈。",
    "voice": "vo_adv_5204002_021",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n妳還記得我嗎？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "哼！",
    "voice": "vo_adv_5204002_022",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "我才不會特別去記女生的臉呢！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "除了摩登又年輕的帥哥以外",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "我都不需要！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……妳可別裝傻哦？",
    "voice": "vo_adv_5204002_023",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我不允許妳說妳忘了。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "10年前，",
    "voice": "vo_adv_5204002_024",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "暴風雨之夜的新手醫生。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……我這樣說妳應該就懂了吧？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……？",
    "voice": "vo_adv_5204002_025",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "所以就說我不知道了！",
    "voice": "vo_adv_5204002_026",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n10年前我才７歲耶。",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……？",
    "voice": "vo_adv_5204002_027",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n看起來不像是在裝傻。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n難道說，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真的失去記憶了……？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……露易絲瑪莉，",
    "voice": "vo_adv_5204002_028",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n那個「回春祕藥」",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "的功效，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "只有讓身體變年輕嗎？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "會不會",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "有副作用導致",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "記憶障礙之類的？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "照理說是只有身體變年輕",
    "voice": "vo_adv_5204002_029",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "但保留知識與記憶。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "副作用的部分",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我還不能斷定……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "但身為天才的祖母是不可能",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "犯下那種失敗的。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "……我差不多要生氣了哦！！",
    "voice": "vo_adv_5204002_030",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "就算動用武力也要走人了！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "該你出場了",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "荷姆荷姆！！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "好耶，",
    "voice": "vo_adv_5204002_031",
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "交給我吧瑪莉絲黛菈，",
    "voice": null,
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "我喜歡妳！！",
    "voice": null,
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "喔喔喔喔喔……！！",
    "voice": "vo_adv_5204002_032",
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "噫……！？",
    "voice": "vo_adv_5204002_033",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好強大的壓迫感……！",
    "voice": "vo_adv_5204002_034",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n大家",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "提高警戒！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "我的名字是荷姆荷姆！！",
    "voice": "vo_adv_5204002_035",
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "\\n是瑪莉絲黛菈用鍊金術所創造的鍊成生物！！",
    "voice": null,
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "\\n今天也要火力全開",
    "voice": null,
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "全力衝刺！！",
    "voice": null,
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "荷姆荷姆。",
    "voice": "vo_adv_5204002_036",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……噗。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "別、",
    "voice": "vo_adv_5204002_037",
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "別笑──！",
    "voice": null,
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "\\n這是瑪莉絲黛菈想了三天三夜才想出來的名字！",
    "voice": null,
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "抱歉。",
    "voice": "vo_adv_5204002_038",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "我只想了２秒。",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "對不起我不該誕生在世界上……",
    "voice": "vo_adv_5204002_039",
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "真容易悲觀啊。",
    "voice": "vo_adv_5204002_040",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "上吧荷姆荷姆！！",
    "voice": "vo_adv_5204002_041",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n把這群傢伙給趕走！！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "遵命！！",
    "voice": "vo_adv_5204002_042",
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "就別怪我動粗了！！",
    "voice": null,
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "姑丈你也是！",
    "voice": "vo_adv_5204002_043",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n喝啊啊！！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "background",
    "bg_id": "500203"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唔！",
    "voice": "vo_adv_5204002_044",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n用刀鞘就把巨人的拳頭給……！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真厲害！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "欸嘿嘿！",
    "voice": "vo_adv_5204002_045",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n彩羽從剛剛開始就一直很在意。",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "你跟彩羽到底哪邊比較強，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "來一決勝負吧！？",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "那麼要上了哦，",
    "voice": "vo_adv_5204002_046",
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "小荷姆！！",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "喝啊啊！！",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "誰是小荷姆啊！！",
    "voice": "vo_adv_5204002_047",
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "\\n嗚喔喔──！！",
    "voice": null,
    "unit_id": 19311
  },
  {
    "type": "background",
    "bg_id": "500203"
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……我說祖……",
    "voice": "vo_adv_5204002_048",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "瑪莉絲黛菈小姐。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "妳",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "好像在各種地方引發災難，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n讓魔物四處大鬧對吧。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……明明妳以前那麼地溫柔，",
    "voice": "vo_adv_5204002_049",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n為什麼要做這種事？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "哼，",
    "voice": "vo_adv_5204002_050",
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "那還用說嗎？",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n當然是為了讓全世界都知道",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "我身為鍊金術師的力量！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "而且更重要的是，",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "瑪莉絲黛菈",
    "words": "這會讓我心情很舒暢！",
    "voice": null,
    "unit_id": 53111
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這跟之前聽到的差太多了吧……",
    "voice": "vo_adv_5204002_051",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這傢伙哪裡是又溫柔又有品格的人了？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n整個正值青春期",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "過激得不得了耶？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……青春期，",
    "voice": "vo_adv_5204002_052",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "沒啦，",
    "voice": "vo_adv_5204002_053",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我的父親……",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "對彩羽來說是爺爺。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n在父親他還小的時候，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "在瑪莉絲黛菈小姐的鍊金工作室",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "當保鑣，",
