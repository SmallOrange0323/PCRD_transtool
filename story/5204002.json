    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "這並不是什麼",
    "voice": "vo_adv_5204002_058",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "失敗的副作用，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n而是露易很常說的那個……！",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "就是，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "在鍊金術上失敗時會說的那個。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我在鍊金術上才不會失敗！",
