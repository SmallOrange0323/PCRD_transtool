    "words": "換句話說！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "可以無時無刻跟弟弟膩在一起！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "超快樂！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "超開心！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "本該是這樣才對的……",
    "voice": "vo_adv_5070101_001",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那位大人似乎被大量的作業搞得不知如何是好，",
    "voice": "vo_adv_5070101_002",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不過，作業這種小事",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "休想妨礙我們。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "如果要邊做作業邊享受夏天，",
    "voice": "vo_adv_5070101_003",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n就要非常有計畫才行呢。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "要完成作業，",
    "voice": "vo_adv_5070101_004",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "同時享受暑假……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流、惠理子",
    "words": "…………",
    "voice": "vo_adv_5070101_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流、惠理子",
    "words": "對了！\\n我想到了！",
    "voice": "vo_adv_5070101_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就由我們……",
    "voice": "vo_adv_5070101_007",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "安排最棒的計畫！",
    "voice": "vo_adv_5070101_008",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流、惠理子",
    "words": "給弟弟最棒的暑假！\\n給那位大人最棒的暑假！",
    "voice": "vo_adv_5070101_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流、惠理子",
    "words": "下回，",
    "voice": "vo_adv_5070101_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流、惠理子",
    "words": "「永不完結的夏日計畫　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流、惠理子",
    "words": "盛夏的雙人獨佔樂園」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們會為大人獻上……",
    "voice": "vo_adv_5070101_011",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流",
