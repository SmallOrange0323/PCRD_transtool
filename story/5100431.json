  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這次去了好多地方喔！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n有平安回來，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真的是太好了！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n噗吉也辛苦了！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "綾音小姐",
    "voice": "vo_adv_5100431_001",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "妳努力搬了",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "巨大的行李呢。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真是辛苦了♪",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "妳這麼中意",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那套衣服",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "實在太好了。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯！",
    "voice": "vo_adv_5100431_002",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "明明很費工，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "謝謝妳願意做給我，真步小姐！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我真的非常喜歡，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "要不要以後都穿著它呢……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那的確也不錯……",
    "voice": "vo_adv_5100431_003",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不過，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n等到下次去旅行時再拿出來穿，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "說不定也很棒喔？",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……的確是呢！",
    "voice": "vo_adv_5100431_004",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我還想",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "再跟大家一起去旅行！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家也是。",
    "voice": "vo_adv_5100431_005",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不過在那之前，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n得先幫玩偶們修繕",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "跟換裝才行。",
    "voice": null,
    "unit_id": 123111
  },
  {
