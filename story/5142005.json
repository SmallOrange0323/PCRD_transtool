    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我一個人去救他也可以。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n畢竟我也不需要什麼勳章。",
