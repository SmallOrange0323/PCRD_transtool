    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "不、",
    "voice": "vo_adv_5142005_069",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "不是……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "\\n我沒有受傷……！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "只是、",
