    "voice": "vo_adv_5142005_032",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "大家像平常一樣去戰鬥吧。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n這樣肯定就會贏的……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻嘻嘻。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "非常感謝",
    "voice": "vo_adv_5142005_033",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "教官的激勵！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "\\n我們絕對",
