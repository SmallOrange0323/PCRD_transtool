  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "那麼，",
    "voice": "vo_adv_5142005_031",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "惠理子教官。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "\\n我們也出發了！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
