    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要是新兵遇到了那邊的魔物……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可不堪一擊啊。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "騙、",
    "voice": "vo_adv_5142005_076",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "騙人的吧……？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "\\n那麼",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "弗萊迪他……！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……",
    "voice": "vo_adv_5142005_077",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
