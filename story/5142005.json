    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "？",
    "voice": "vo_adv_5142005_073",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "有什麼問題嗎？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……棲息在北方森林的魔物，",
    "voice": "vo_adv_5142005_074",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "強度和其他區域的魔物是天差地遠。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n聽其他教官說，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "似乎是最近才開始棲息在那附近的。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "事前說明時不是也有講了嗎？",
    "voice": "vo_adv_5142005_075",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n騎士團說",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "「不要走出區域外」。",
