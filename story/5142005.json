  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "訓練期間過了一半，逐漸進入關鍵時刻。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n新兵們的訓練內容也變得更加嚴苛，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而說到惠理子班目前的情況……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "現在",
    "voice": "vo_adv_5142005_000",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "即將開始所有班相互對抗的劍術比賽！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "\\n全員就定位──",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "開始！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "其他班的新兵1",
    "words": "唔喔喔喔喔！",
    "voice": "vo_adv_5142005_001",
    "unit_id": 711
  },
  {
    "type": "background",
    "bg_id": "501680"
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "哼。",
    "voice": "vo_adv_5142005_002",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "這點程度的攻擊，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "沒什麼大不了的！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "是啊！",
    "voice": "vo_adv_5142005_003",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "畢竟做了那麼多肌力訓練，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "劍握起來感覺也變輕了！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "其他班的新兵2",
    "words": "這些傢伙……！",
    "voice": "vo_adv_5142005_004",
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "其他班的新兵2",
    "words": "\\n那麼這招如何！！",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "嘿嘿，",
    "voice": "vo_adv_5142005_005",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "太慢了！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "background",
    "bg_id": "501680"
  },
  {
    "type": "dialogue",
    "name": "其他班的新兵2",
    "words": "唔啊啊啊！",
    "voice": "vo_adv_5142005_006",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "到此為止！",
    "voice": "vo_adv_5142005_007",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "獲勝的是惠理子班！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "惠理子班",
    "words": "好耶～！",
    "voice": "vo_adv_5142005_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻嘻……",
    "voice": "vo_adv_5142005_009",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n做得很好喔，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "垃圾蟲們♪",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "惠理子班",
    "voice": "vo_adv_5142005_010",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還真強啊……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n一開始還很擔心他們的情況，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n但現在他們已經是所有班裡排名在前的了……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那是當然的，",
    "voice": "vo_adv_5142005_011",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "畢竟他們是我訓練出來的。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這本來是最讓人擔心的因素呢……",
    "voice": "vo_adv_5142005_012",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "唔唔。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但既然有實際成果，那我也無話可說……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過",
    "voice": "vo_adv_5142005_013",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我不是開玩笑的，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "現在看來真的有機會……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可以獲頒勳章呢。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻，",
    "voice": "vo_adv_5142005_014",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這是當然的♪",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n畢竟我就是為了這個而來的。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "而且……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "惠理子教官～！",
    "voice": "vo_adv_5142005_015",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "我們贏了～！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嗯，",
    "voice": "vo_adv_5142005_016",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我有看到喔。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "做得很好呢，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "各位垃圾蟲。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子班",
    "words": "嘿嘿嘿！",
    "voice": "vo_adv_5142005_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……指導他人，",
    "voice": "vo_adv_5142005_018",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "感覺也沒有那麼差呢。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哦……",
    "voice": "vo_adv_5142005_019",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒想到妳居然變得能說出這種話啊。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嘿嘿！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我看妳跟新兵們也有好好建立起信賴關係了，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n看來最終測驗也很值得期待呢！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "最終測驗……",
    "voice": "vo_adv_5142005_020",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我記得，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是要遠征討伐魔物對吧。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是啊。",
    "voice": "vo_adv_5142005_021",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "雖然不會是太強的魔物，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n但對新兵來說，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "將是第一次",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "面對真正敵人的實戰。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "會根據討伐魔物的數量，",
    "voice": "vo_adv_5142005_022",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n來決定本期的首席畢業生……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻嘻……",
    "voice": "vo_adv_5142005_023",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我現在就開始期待結果了♪",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "background",
    "bg_id": "501370"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接著到了最終測驗當天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "所有班，",
    "voice": "vo_adv_5142005_024",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "列隊──！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "\\n現在開始進行",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "最終測驗的事前說明！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "我們教官會把這裡設為本營，",
    "voice": "vo_adv_5142005_025",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "在此監督你們。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "\\n而你們必須繼續向上爬，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "抵達山腰。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "山腰棲息著許多魔物，",
    "voice": "vo_adv_5142005_026",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "商人與旅行者皆有傳出被害。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "\\n我們必須討伐那些魔物，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "確保民眾的安全。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "所有人",
    "voice": "vo_adv_5142005_027",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "各自臨機應變採取行動，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "盡量討伐更多魔物吧。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "必須在指定的區域內戰鬥！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "這對各位來說",
    "voice": "vo_adv_5142005_028",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "將是首次的實戰訓練，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "\\n期待各位的英勇奮鬥！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "以上。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "那麼，最終訓練──",
    "voice": "vo_adv_5142005_029",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "開始！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "新兵們",
