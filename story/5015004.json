  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "出了茶館後，【純白之翼 蘭德索爾分部】和\\n{0}來到了傳來尖叫的地方。\\n那裡聚集了許多人，有兩個人在正中間。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "惡代官大人……",
    "voice": "vo_adv_5015004_000",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "就是這裡。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "喔，",
    "voice": "vo_adv_5015004_001",
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "這裡就是",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "\\n無視我的命令，那個沒禮貌的店家嗎。",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……引起騷動的",
    "voice": "vo_adv_5015004_002",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好像是那間店呢。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "男人們",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好像正在說些什麼……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "啊，",
    "voice": "vo_adv_5015004_003",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我認識其中一個人！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "　",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "他是大江戶町的",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "町長！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n他出身於蘭德索爾，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "很努力的",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "想讓這個町\\n有更好的發展，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是個好人喔♪",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "旁邊那個被稱為惡代官的人",
    "voice": "vo_adv_5015004_004",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "明顯的很不美麗呢？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n好像不是人類，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也好像不是魔族。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "……我也",
    "voice": "vo_adv_5015004_005",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "沒有見過……",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "可是！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n總覺得",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "非常可疑！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "惡代官……",
    "voice": "vo_adv_5015004_006",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "在剛才書店看到的《武士之路》書上，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "寫說是東國的官員，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但做盡壞事，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n被東國的英雄制裁了呢。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "正因為如此的暴虐無道，",
    "voice": "vo_adv_5015004_007",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這個詞好像就成了",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "東國壞人的代名詞。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "可、",
    "voice": "vo_adv_5015004_008",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "可是，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "管理這個町的",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是町長，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "再說了，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這個町",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "根本沒有惡代官！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那、",
    "voice": "vo_adv_5015004_009",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那麼說來，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n那個同名的人",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "到底是什麼人啊……？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "上納金遲繳第二天……",
    "voice": "vo_adv_5015004_010",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "這次就給予規勸。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "我去喊老闆出來……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "沒那必要，",
    "voice": "vo_adv_5015004_011",
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "現在就毀了這裡。",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "怎麼可以……！？",
    "voice": "vo_adv_5015004_012",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "\\n上納金遲繳",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "不是最多可以延一週的……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "我已經",
    "voice": "vo_adv_5015004_013",
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "\\n說沒有必要了……",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "你沒聽見嗎？",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "可、",
    "voice": "vo_adv_5015004_014",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "可是……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "不，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "我知道了……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "嘻嘻嘻……",
    "voice": "vo_adv_5015004_015",
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "這個城鎮裡",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "\\n不需要違抗我的人……",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "哈～哈哈哈哈！！",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "那個惡代官",
    "voice": "vo_adv_5015004_016",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "打算毀了那間店！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "去阻止他吧，",
    "voice": "vo_adv_5015004_017",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "全部的人跟我來！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我對這種粗暴的行為",
    "voice": "vo_adv_5015004_018",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n是不太感興趣的，不過……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "嗯？",
    "voice": "vo_adv_5015004_019",
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "　你們有什麼事？",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "到此為止了，壞人！",
    "voice": "vo_adv_5015004_020",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "　",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你如此欺負百姓，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我身為榮耀的【純白之翼】一份子，絕對饒不了你！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n要逮捕他，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "然後交給【王宮騎士團】！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "要你老實",
    "voice": "vo_adv_5015004_021",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n繳納",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "年貢！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "是別的城鎮的人嗎……",
    "voice": "vo_adv_5015004_022",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "不能反抗惡代官啊！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "惡代官大人認真起來，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "\\n會毀了大江戶町的……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "你們現在立刻離開！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "原來是這樣啊……",
    "voice": "vo_adv_5015004_023",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "各位，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "你們放心吧！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n因為我們有",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "天下的英雄，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "也就是將軍陪同！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "將、",
    "voice": "vo_adv_5015004_024",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "將軍……！？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "\\n是說統一天下，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "帶領國家邁向太平之世的",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "東國之王……！？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "妳、",
    "voice": "vo_adv_5015004_025",
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "妳說什麼！？",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "　我可沒聽說這個城鎮有將軍啊！",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "\\n",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "只聽說就是稍微威脅一下，隨我勒索錢財，",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "\\n這和說好的不一樣啊！！",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……",
    "voice": "vo_adv_5015004_026",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "感、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "感覺他的",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n態度突然改變了呢。",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
