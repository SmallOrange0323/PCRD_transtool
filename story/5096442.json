  },
  {
    "type": "dialogue",
    "name": "チカ",
    "words": "ええ。",
    "voice": "vo_adv_5072442_001",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "チカ",
    "words": "\\n見事な戦いぶり……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "チカ",
    "words": "いいえ、",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "チカ",
    "words": "ライブでした。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "ほんと、",
    "voice": "vo_adv_5072442_002",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "いつも順風満帆とはいきませんよね、",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n私たちのライブって。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "でも",
    "voice": "vo_adv_5072442_003",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "最高に輝いてたと思う。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "私たち、３人とも。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "だけど",
    "voice": "vo_adv_5072442_004",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "まだ安心しちゃダメだよ？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "\\nライブが終わったわけじゃないんだから。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "ほら、",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "お客さんたちが待ってる！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "これだけ歌って踊って戦って、",
    "voice": "vo_adv_5072442_005",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\nどうしてこんなに元気なんですか～！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "チカ",
    "words": "ノゾミだから、",
    "voice": "vo_adv_5072442_006",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "チカ",
    "words": "としか言いようがありませんね。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "チカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "チカ",
    "words": "ですが、",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "チカ",
    "words": "私もまだ歌い足りなかったところです。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "……チカさんも元気いっぱいですね。",
    "voice": "vo_adv_5072442_007",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "ええいいですよ、",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "私もまだまだ動けますし！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "じゃあ行こっか、",
    "voice": "vo_adv_5072442_008",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "チカ、",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "ツムギ！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "私たちで最高のステージを作り上げよう♪",
    "voice": null,
    "unit_id": 117211
  },
