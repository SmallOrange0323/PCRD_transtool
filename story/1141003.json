  {
    "type": "dialogue",
    "name": "旁白",
    "words": "茉莉與{0}為了帶回小孩子們，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n前往被目擊到有魔物出現的西地區。",
    "voice": null,
    "unit_id": null
  },
  {
