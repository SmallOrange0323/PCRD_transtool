    "name": "拉菲",
    "words": "我感覺到了！",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n這邊的感覺很強烈！",
    "voice": null,
    "unit_id": 5512
  },
