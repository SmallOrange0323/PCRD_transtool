  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯？",
    "voice": "vo_adv_5106608_007",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這位騎士大人認識我嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "如果見過這麼正氣凜然的騎士大人，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我是不會忘記的……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不，等等，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這麼無可挑剔的站姿和這個聲音……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "難道是",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "純閣下！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真不愧是莫妮卡。",
    "voice": "vo_adv_5106608_008",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我很高興妳能認出我。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "因為妳穿的不是平時的鎧甲，",
    "voice": "vo_adv_5106608_009",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "所以我有點吃驚。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n像我這樣的",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "一流軍人，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "當然會注意到了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "哈哈哈哈哈哈！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "妳剛剛是在看",
    "voice": "vo_adv_5106608_010",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這個點心嗎？",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n哇～",
