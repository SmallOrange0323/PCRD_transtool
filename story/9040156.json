[
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "牠飛走了……",
    "voice": "vo_adv_9040156_000",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是個相當棘手的對手呢。",
    "voice": "vo_adv_9040156_001",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚嗚，",
    "voice": "vo_adv_9040156_002",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "烤雞串……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可，",
    "voice": "vo_adv_9040156_003",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳怎麼突然就衝出去了呀！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n很危險耶！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為",
    "voice": "vo_adv_9040156_004",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那是第一次見到的格里芬嘛。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我有義務確認牠吃起來是什麼樣的味道！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那什麼鬼義務呀！",
    "voice": "vo_adv_9040156_005",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而且，格里芬說穿了跟大型鳥類沒什麼兩樣呀？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n也不是什麼特別需要珍視的存在吧。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "才沒那回事呢！",
    "voice": "vo_adv_9040156_006",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "肉質確實是像雞肉一樣多汁，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但更富含油脂，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n表層炸過以後，口感酥酥脆脆，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "肯定會是極品烤雞串！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "差點忘記了。",
    "voice": "vo_adv_9040156_007",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n之前品嚐過的格里芬烤雞串，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "堪稱一絕，無庸置疑。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還真的吃過啊，",
    "voice": "vo_adv_9040156_008",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳們兩個……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "最重要的是！",
    "voice": "vo_adv_9040156_009",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "做成湯品更是不得了！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "湯的色澤很清澈，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "味道卻很濃郁，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "兼具了鳥類和野獸的優點！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果弄成水炊……",
    "voice": "vo_adv_9040156_010",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一定很讚☆",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的，",
    "voice": "vo_adv_9040156_011",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "肯定很讚。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "吞口水……",
    "voice": "vo_adv_9040156_012",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼嘛。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n聽了這種話題……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿嘿嘿，",
    "voice": "vo_adv_9040156_013",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留肚子也餓了吧☆",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我、",
    "voice": "vo_adv_9040156_014",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我才不是",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為聽妳們討論，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n好像很好吃似的，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我這只是戰鬥過後的疲憊！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵……",
    "voice": "vo_adv_9040156_015",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那我們",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就準備用餐吧。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好的！",
    "voice": "vo_adv_9040156_016",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "先吃飯，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "然後……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "盯……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……妳在看什麼。",
    "voice": "vo_adv_9040156_017",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "然後，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們要是能抓到",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個稀有物種的話，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就能得到公會管理協會發放的獎勵，對吧？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的，",
    "voice": "vo_adv_9040156_018",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "應該沒有錯。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": "vo_adv_9040156_019",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們就展開調查，順勢抓住稀有物種，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n然後狠狠地向花凜敲詐一筆。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好耶！",
    "voice": "vo_adv_9040156_020",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "人家最喜歡小凱留了☆",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n抱抱～♪",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵……",
    "voice": "vo_adv_9040156_021",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n兩位",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "果然感情很好呢。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那麼",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "抱抱～",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "夠了，別黏過來！",
    "voice": "vo_adv_9040156_022",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真受不了……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "吃飽了就趕緊追上去吧！",
    "voice": null,
    "unit_id": 106011
  }
]
