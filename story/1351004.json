    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "嘴上說著是復健，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但是看起來卻像是在跟騎士先生玩的部分。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n問題的原因，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "應該是與阿賀斗紫布菜的距離太近了。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不對，",
    "voice": "vo_adv_1351004_044",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這跟騎士先生說也無濟於事。",
