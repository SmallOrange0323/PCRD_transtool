    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "就是那樣喔。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "雖然看起來很普通，",
    "voice": "vo_adv_1351004_021",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "但是這也是重要的練習喔。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n要一點一點地",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "記住在水中活動身體的方式。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "花式滑冰的跳躍，",
    "voice": "vo_adv_1351004_022",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n也是要先從習慣穿滑冰鞋的感覺開始。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "一階一階向上爬很重要。",
    "voice": "vo_adv_1351004_023",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n我覺得這點",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "不管是游泳還是花式滑冰都一樣呢。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "不會，",
    "voice": "vo_adv_1351004_024",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我才要謝謝你。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n謝謝你陪我復健。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "不知道是不是因為有跟你聊天，",
    "voice": "vo_adv_1351004_025",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n總覺得和平常不太一樣。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "因為平常",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "就像是在跟",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "自己戰鬥一樣……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "有點孤獨的感覺。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "有你在的話，",
    "voice": "vo_adv_1351004_026",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "該說感覺心情跟身體都很輕快嗎。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n讓我覺得復健很開心……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "所以說，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "狀況比之前還要好喔。",
    "voice": "vo_adv_1351004_027",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "但是，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "奇蹟是不會那麼輕易就發生的。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "其實，",
    "voice": "vo_adv_1351004_028",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "剛剛回診的時候，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "醫生跟我說了。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n要像以前一樣",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "進行花式滑冰，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "果然還是有困難",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "的樣子。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "當然，",
    "voice": "vo_adv_1351004_029",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "因為初診時他就這麼跟我說過了，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "所以我明白的。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "不過就算是那樣，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n我還是想著",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "要是有一天",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "能顛覆",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "那個診斷",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "就好了呢。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "啊，",
    "voice": "vo_adv_1351004_030",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "對不起。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我並不是打算說些讓人消沉的話題。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "之前",
    "voice": "vo_adv_1351004_031",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "你有跟我",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "提過，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n許願是「表明想要實現願望的決心」吧？",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "在那之後我想了很多，",
    "voice": "vo_adv_1351004_032",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "最後決定要努力到自己能接受為止。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "不管醫生說了什麼，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我都要",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "努力到最後。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "still",
    "still_id": "135100402"
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "因為，",
    "voice": "vo_adv_1351004_033",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我很喜歡花式滑冰啊。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "就算沒辦法再做出一樣的跳躍……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我還是喜歡。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "而且在不能滑冰的空白期間裡，",
    "voice": "vo_adv_1351004_034",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我也注意到了",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "很多事情。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……注意到",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "周圍有著願意幫助我的人，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "這件事。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "總之，",
    "voice": "vo_adv_1351004_035",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "不管什麼我都打算去做喔。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "不然，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "感覺會留下留戀啊。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "所以",
    "voice": "vo_adv_1351004_036",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我就跟哥哥一起開始玩LoA了。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "這可是受了你的影響喔？",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "呵呵，",
    "voice": "vo_adv_1351004_037",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "當然好啊！",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n我很期待喔。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "那麼，",
    "voice": "vo_adv_1351004_038",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我們繼續練習吧！",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "一、",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "二。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "一、",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "二……！",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "background",
    "bg_id": "500510"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生……",
    "voice": "vo_adv_1351004_039",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "辛苦你了。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "對不起，",
    "voice": "vo_adv_1351004_040",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "嚇到你了。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "剛剛的夢，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是我讓你做的。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……那是因為……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我想著要是能稍微療癒到",
    "voice": "vo_adv_1351004_041",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "阿賀斗紫布菜的心就好了。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……因為就像我之前說的，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我覺得",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "她有恩於我。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我能像這樣跟騎士先生講話，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "也是因為她的自我犧牲。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……夢裡的她……",
    "voice": "vo_adv_1351004_042",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n雖然承受著挫折，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但是看起來很正向。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生還有其他人跟她的聯繫，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "或許成為她的支柱了呢。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "──但是，",
    "voice": "vo_adv_1351004_043",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我也看到了幾個該反省的部分。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "首先，",
