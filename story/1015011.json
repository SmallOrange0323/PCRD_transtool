    "name": "美里",
    "words": "──就像是感情很好的情侶",
    "voice": "vo_adv_1015011_072",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那樣。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵呵……♪",
    "voice": "vo_adv_1015011_073",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我覺得啊，",
    "voice": "vo_adv_1015011_074",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "今天好像變成很特別的一天了……♪",
