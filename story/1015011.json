    "name": "美里",
    "words": "今天天氣真好～♪",
    "voice": "vo_adv_1015011_000",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n吹著舒服的風，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "花圃裡的小花好像也很開心地左右搖晃。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "既然今天幼稚園也放假，",
    "voice": "vo_adv_1015011_001",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n偶爾就悠哉悠哉一下吧。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵呵。",
    "voice": "vo_adv_1015011_002",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n{0}你要不要也一起呢？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "躺在柔軟的草地上，",
    "voice": null,
    "unit_id": 101512
