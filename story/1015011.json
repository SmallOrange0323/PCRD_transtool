  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n是這樣嗎？",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "原來、",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是這樣啊……",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "咦？",
    "voice": "vo_adv_1015011_064",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n你說因為剛剛……",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你全部",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "都看在眼裡了？",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你說剛剛……",
    "voice": "vo_adv_1015011_065",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "啊。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n是我們在那家咖啡廳的時候？",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我的確是",
    "voice": "vo_adv_1015011_066",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "一直看著那對送花的情侶沒錯……",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "原來你……",
    "voice": "vo_adv_1015011_067",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "一直",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "看著我呀。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "感覺有點難為情呢……♪",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就是因為這樣，",
    "voice": "vo_adv_1015011_068",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你才會在花店買這個給我吧。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……呵呵呵，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是為了我……",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我真的……",
    "voice": "vo_adv_1015011_069",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "好高興。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "雖然收到孩子們送的禮物也很高興，",
    "voice": "vo_adv_1015011_070",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "但這種溫暖的感覺……",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "似乎",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "和那有點不同呢。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這個……",
    "voice": "vo_adv_1015011_071",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我就可以",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "往那方面想了吧。",
    "voice": null,
    "unit_id": 101532
  },
  {
