  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "花種子發芽後經過了數天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}每天都一早就跑來澆水。",
    "voice": null,
    "unit_id": null
  },
  {
