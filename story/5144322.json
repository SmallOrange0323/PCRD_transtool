[
  {
    "type": "dialogue",
    "name": "魔物植物",
    "words": "──嘎喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 12012
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗚嗚，",
    "voice": "vo_adv_5144322_000",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好不容易才努力把它拖出來的～！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "怎麼森林裡的其他魔物也靠過來了～！？",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是魔物植物把它們叫來的嗎？",
    "voice": "vo_adv_5144322_001",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "它們好像打算要把我們包圍起來……！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "怎麼這樣，",
    "voice": "vo_adv_5144322_002",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我們要被圍毆了～！？",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "該該、",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "該從哪隻魔物開始對付才好呢～！？",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "總之先從靠近過來的敵人開始解決吧。",
    "voice": "vo_adv_5144322_003",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "只要踏實地減少敵人數量，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我們應該就有勝算。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n戰鬥時最重要的是數量，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "課本上也是這樣寫的。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……鏡華上的學校，",
    "voice": "vo_adv_5144322_004",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "究竟都在教些什麼呢。",
    "voice": null,
    "unit_id": 130811
  }
]
