[
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "シグルドよ。",
    "voice": "vo_adv_6044310_000",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "貴様に聞いておきたいことがあるのだが……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "貴様、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "ルカやナナカの姿を見て",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "どう思う？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "誤魔化したりせず、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "素直な感想を述べるのだぞ。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そ、",
    "voice": "vo_adv_6044310_001",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そうか……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "た、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "確かに大人だな……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\nあの二人はスタイルがいいし、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "シグルドもそう思っていたんだな。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "……今からでも牛乳を飲めば、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "もう少し大きくなれるのかな……？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "ほ、",
    "voice": "vo_adv_6044310_002",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "ほう？　",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "かわいいだと？　",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "もう少し説明をしてみるがいい。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "……水着が似合っててかわいい？　",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "なるほど、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そういうことか。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\nちなみに私の水着は",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "似合ってるか？　",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "……そうか、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "合ってるか！　",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "よし！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "確かに、",
    "voice": "vo_adv_6044310_003",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "強者の気配を放っているな。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "しかし",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "私が聞きたいのはそういうことでは……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "まぁ、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "シグルドはそれで",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "いいのかもしれんな。",
    "voice": null,
    "unit_id": 113211
  }
]
