[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在蘭德索爾散步時，\\n遇見了被骷髏頭魔物襲擊的少女。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……住手，你適可而止。",
    "voice": "vo_adv_1031001_000",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "骷髏頭",
    "words": "我忍不住了！嘎――――！",
    "voice": "vo_adv_1031001_001",
    "unit_id": 2411
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "骷髏頭",
    "words": "好痛―――！這傢伙竟然突然砍過來，",
    "voice": "vo_adv_1031001_002",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏頭",
    "words": "\\n到底想怎樣啊！？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "請問……這個骷髏頭對你做過什麼嗎？",
    "voice": "vo_adv_1031001_003",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……因為我被這個魔物攻擊，所以你來幫我？",
    "voice": "vo_adv_1031001_004",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "被你這麼一說，看起來好像是那麼一回事呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "讓你擔心真是抱歉。",
    "voice": "vo_adv_1031001_005",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "其實這個骷髏頭不是魔物。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "他是我的父親。",
    "voice": "vo_adv_1031001_006",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "雖然他因為一些因素變成了骷髏頭的樣子，",
    "voice": "vo_adv_1031001_007",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "但靈魂毫無疑問地是我的父親。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那個，爸爸你也向人家道歉一下。",
    "voice": "vo_adv_1031001_008",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "妳在說什麼，忍！",
    "voice": "vo_adv_1031001_009",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n是這個小伙子搞不清楚狀況，突然向我砍過來的耶！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n要道歉的應該是他吧！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……爸爸。",
    "voice": "vo_adv_1031001_010",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我、我很抱歉……",
    "voice": "vo_adv_1031001_011",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以說呢，",
    "voice": "vo_adv_1031001_012",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這個骷髏頭不會去危害其他人的。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請你不用擔心。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "哼，算了。",
    "voice": "vo_adv_1031001_013",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n先別管那個，剛剛的女孩去哪裡了……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n啊，在那裡！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "那邊那位小姐──！",
    "voice": "vo_adv_1031001_014",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n妳好可愛唷──！！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n和我一起去吃個飯吧──！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "天啊──！這骷髏頭是怎麼回事啊！",
    "voice": "vo_adv_1031001_015",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n好噁心！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n走開啦！！！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然不會危害其他人……",
    "voice": "vo_adv_1031001_016",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但是卻會騷擾其他人呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……爸爸。",
    "voice": "vo_adv_1031001_017",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "幹嘛，忍？",
    "voice": "vo_adv_1031001_018",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n現在氣氛正好，不要來吵我……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "好痛！快、快住手，忍！",
    "voice": "vo_adv_1031001_019",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n住……住手啊！快點停下來！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n好痛啊！痛死了！我會死掉的！！！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "喂，小伙子！你不要光是在那裡看，幫幫我啊！",
    "voice": "vo_adv_1031001_020",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "小、小伙子！你真是沒血沒淚啊！",
    "voice": "vo_adv_1031001_021",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n雖然我這骷髏頭也是沒血沒淚……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "呃啊！喂！",
    "voice": "vo_adv_1031001_022",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n忍、忍，快住手！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n小、小伙子！你要幹嘛啊，哇咧！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "小伙子……竟然這麼囂張……",
    "voice": "vo_adv_1031001_023",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n我饒不了你！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我咬",
    "voice": "vo_adv_1031001_024",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "！！！！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊……你被咬了呢……",
    "voice": "vo_adv_1031001_025",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還好嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "哇哈哈！知道我的厲害了吧！！",
    "voice": "vo_adv_1031001_026",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真抱歉。",
    "voice": "vo_adv_1031001_027",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n前面有間診所，我們一起去吧。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個，你叫什麼名字？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}啊。\\n我叫忍。\\n走路有困難嗎？扶著我的肩膀吧。",
    "voice": "vo_adv_1031001_028",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍、忍！",
    "voice": "vo_adv_1031001_029",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n不准妳和那種小伙子這麼親密地走在一起！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n我不會放任這種事不管的！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸……",
    "voice": "vo_adv_1031001_030",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你適可而止。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "咿！忍好恐怖！",
    "voice": "vo_adv_1031001_031",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這就是{0}和父親是骷髏頭的奇妙少女・忍的邂逅。",
    "voice": null,
    "unit_id": null
  }
]
