[
  {
    "type": "background",
    "bg_id": "510460"
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "嗯。",
    "voice": "vo_adv_5201075_000",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "大家都提議了吧。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "各位開發成員",
    "voice": "vo_adv_5201075_001",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "已經各自提出想要實裝的企劃，",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n從現在起，",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "開始最終決定。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "接著這句話我再三強調過──",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "──直率的意見",
    "voice": "vo_adv_5201075_002",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "才能做出更好的內容。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "各位，",
    "voice": "vo_adv_5201075_003",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "請記住這句話",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "再各自陳述意見。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "關於教授提議的戰鬥競技場，",
    "voice": "vo_adv_5201075_004",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "以目前的系統來說不太行。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "會變成只有強者",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n能夠站在巔峰的內容，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這樣是沒辦法運作下去的。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "強者立於人之上",
    "voice": "vo_adv_5201075_005",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "乃是理所當然，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n我認為切磋琢磨想要追過前面的人",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "才是遊戲的醍醐味。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "克莉絲妳提議的金錢遊戲",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "和這個也沒多大差別吧？",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "很遺憾地，",
    "voice": "vo_adv_5201075_006",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "兩款都可能會造成過度的憎恨與紛爭。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "必須重新設計，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "或是先暫緩實裝會比較好。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "說是這麼說，",
    "voice": "vo_adv_5201075_007",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "似似花。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "妳提議的",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "魔物馴服系統",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n也是問題多多喔。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "要是採取了每種怪物都能馴服的形式，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "反而會讓玩家產生依戀，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "作為敵方出現的時候下不了手。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "依戀這種話從你口中說出來",
    "voice": "vo_adv_5201075_008",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是意外呢。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不過確實，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n這個提議可能和我們追求的真實性",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "會搭不起來。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "變身系統你們覺得如何？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "不行呢。",
    "voice": "vo_adv_5201075_009",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "要是實裝了能變身成其他東西的系統，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n毫無疑問",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "會變成氾濫的為惡手段。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "我能想出無數用這系統做壞事的方法。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真不愧是真那大人。",
    "voice": "vo_adv_5201075_010",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "那算得上是稱讚嗎，",
    "voice": "vo_adv_5201075_011",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "克莉絲？",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那不然看看我的！",
    "voice": "vo_adv_5201075_012",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "看看我的點子怎麼樣？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "真那等人",
    "words": "…………",
    "voice": "vo_adv_5201075_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "「以角色為棋子的AUTO戰鬥型棋盤遊戲。」",
    "voice": "vo_adv_5201075_014",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「在自動生成的地下城裡",
    "voice": "vo_adv_5201075_015",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "無限挖掘素材的探索遊戲。」",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "「在海邊打棒球，",
    "voice": "vo_adv_5201075_016",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "沙灘棒球。」",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "其他還有好多方案啊……",
    "voice": "vo_adv_5201075_017",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "是不是挺有趣的？",
    "voice": "vo_adv_5201075_018",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "對吧！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "不行。",
    "voice": "vo_adv_5201075_019",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "廢案。",
    "voice": "vo_adv_5201075_020",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "不通過。",
    "voice": "vo_adv_5201075_021",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "為什麼啊～！？",
    "voice": "vo_adv_5201075_022",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n一起做好多遊戲放進去嘛～！",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "晶……",
    "voice": "vo_adv_5201075_023",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳啊，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只是打算把想到的遊戲都放進去而已吧。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "對呀？",
    "voice": "vo_adv_5201075_024",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n能玩各種遊戲的話才更好吧。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "那麼誰來負責開發？",
    "voice": "vo_adv_5201075_025",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "晶，",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "這些項目內容明顯與至今為止製作的類型都不一樣。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "……",
    "voice": "vo_adv_5201075_026",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "大家一起？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "七冠們",
    "words": "駁回。",
    "voice": "vo_adv_5201075_027",
    "unit_id": null
  }
]
