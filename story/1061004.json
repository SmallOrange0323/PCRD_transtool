[
  {
    "type": "background",
    "bg_id": "500341"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "――王都作戰的前一晚。\\n矛依未正在保養武器和防具。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "都變得破破爛爛的了呢……",
    "voice": "vo_adv_1061004_000",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這次的作戰恐怕會很激烈，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還是事先做好保養為妙！　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯……？",
    "voice": "vo_adv_1061004_001",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "什麼啊，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這道光……？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "明明很刺眼、",
    "voice": "vo_adv_1061004_002",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "卻覺得、",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "開始……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "想睡……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "諾維姆和尾狗刀受到米奈娃的委託，\\n為了保護所有可能登上索爾之塔塔頂的\\n玩家帳號不受攻擊，正到處奔走。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是哪個傢伙……？",
    "voice": "vo_adv_1061004_003",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哦，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "有了有了！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "春咲日和……",
    "voice": "vo_adv_1061004_004",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那傢伙就是日和嗎。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "和在阿斯特朗時一樣",
    "voice": "vo_adv_1061004_005",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "很有精神呢。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "用米奈娃那裡借來的管理者權限，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n只要連接上mimi……",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "好了，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "帳號保護完成。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那下一個是怜嗎。",
    "voice": "vo_adv_1061004_006",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "如果情報正確的話，",
    "voice": "vo_adv_1061004_007",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "應該是王林道的高年級吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n諾維姆。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "太麻煩了，我們用跳躍移動吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你這傢伙……",
    "voice": "vo_adv_1061004_008",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n連動都覺得麻煩的話，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "很快就會變老爺爺喔？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "比起諾維姆，我可是有好好在運動的，沒問題。",
    "voice": "vo_adv_1061004_009",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "對了。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "格鬥技的通信教育，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "妳有持續在學習嗎？",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "當、",
    "voice": "vo_adv_1061004_010",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "當然有啊！？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "換下一個了，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "下一個！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "好好好。",
    "voice": "vo_adv_1061004_011",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "該不會，",
    "voice": "vo_adv_1061004_012",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "最近其實都在偷懶吧……？　",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "怜……",
    "voice": "vo_adv_1061004_013",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是那個人嗎？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "……",
    "voice": "vo_adv_1061004_014",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "好像是呢。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "mimi連結的帳號，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n和她的個人資料一致。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "果然如此……",
    "voice": "vo_adv_1061004_015",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "這孩子感覺最容易被盯上。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n對她再加強比其他人更多層的保護吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "為什麼啊？",
    "voice": "vo_adv_1061004_016",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "因為現實中怜的立場，",
    "voice": "vo_adv_1061004_017",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "有可能認識七冠。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "若是如此，我們的對策",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "也有可能無疾而終。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "就算為了避免米奈娃遭受攻擊而想出保護帳號的對策，",
    "voice": "vo_adv_1061004_018",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n如果像我們一樣，在現實裡被七冠抓住的話，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "也就什麼辦法都沒有了吧？",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也是啦。",
    "voice": "vo_adv_1061004_019",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不是故意要學你的口頭禪，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n但感覺還真會是件麻煩事呢。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "到底會不會麻煩，",
    "voice": "vo_adv_1061004_020",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "只有神才知道喔。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "保護流程都結束了，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "接著去找下一個吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "下個是優衣對吧。",
    "voice": "vo_adv_1061004_021",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是怎樣的傢伙呢？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n說不定現實中可是很狂暴的人！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "……我想至少",
    "voice": "vo_adv_1061004_022",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "不是個壞孩子唷。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是嗎？",
    "voice": "vo_adv_1061004_023",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "算了，沒差。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n與其想那麼多，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還不如親自去確認看看！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "background",
    "bg_id": "510240"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哪個才是優衣～？",
    "voice": "vo_adv_1061004_024",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在哪裡～？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "是那孩子吧？",
    "voice": "vo_adv_1061004_025",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "妳看，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "那邊。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喔喔，",
    "voice": "vo_adv_1061004_026",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那個人啊！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "看起來是個不錯的傢伙呢。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "而且在旁邊的是……",
    "voice": "vo_adv_1061004_027",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "{0}呢。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊？",
    "voice": "vo_adv_1061004_028",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "尾狗刀你在說些什麼啊。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你說那傢伙在哪？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "現在可不是在阿斯特朗唷。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "這點我還是知道的。",
    "voice": "vo_adv_1061004_029",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "聽好了諾維姆。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "他是晶的公主騎士唷。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是嗎！？",
    "voice": "vo_adv_1061004_030",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你這傢伙，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "為什麼知道呀！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "因為我把從學校用mimi登入阿斯特朗的學生們",
    "voice": "vo_adv_1061004_031",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n所有人的帳號都掌握得一清二楚呢。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "資訊記錄檔保護的異常嚴密的帳號，",
    "voice": "vo_adv_1061004_032",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n只有一個而已。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "而且這保護的構造還很眼熟呢。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你偷看嗎！？",
    "voice": "vo_adv_1061004_033",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你還是一樣，真是個壞傢伙！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你該不會，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還告訴了真那他們吧？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "怎麼會。",
    "voice": "vo_adv_1061004_034",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "他也是米奈娃想要保護的對象喔？",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "而且比對那三人更謹慎地",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "刻意隱藏了他的資訊。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "還故意設計過用假帳號來進行資訊傳輸，",
    "voice": "vo_adv_1061004_035",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "真那他們若不盡全力是沒辦法解析出來的吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "但他的帳號是晶做的，",
    "voice": "vo_adv_1061004_036",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n基本上應該是完美無缺啦。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "所以放心吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喔！",
    "voice": "vo_adv_1061004_037",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我放心了！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "米奈娃要我們做的事，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也算告一段落了吧？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "還沒結束喔。",
    "voice": "vo_adv_1061004_038",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n還得繼續調查其他的玩家。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "但我肚子餓了啦，",
    "voice": "vo_adv_1061004_039",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "先去吃個可麗餅吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "晶的店嗎！？",
    "voice": "vo_adv_1061004_040",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我想去！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n好，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "走吧尾狗刀！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "等、",
    "voice": "vo_adv_1061004_041",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "等一下啦諾維姆──",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "background",
    "bg_id": "510121"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂～！",
    "voice": "vo_adv_1061004_042",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "晶──！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "……",
    "voice": "vo_adv_1061004_043",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "好像不在耶。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但攤販還在喔！",
    "voice": "vo_adv_1061004_044",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也就是說……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "她發現克莉絲提娜在附近搜查了嗎。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "應該是喔。",
    "voice": "vo_adv_1061004_045",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "看來安全藏匿好了。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "不愧是晶。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嘖。",
    "voice": "vo_adv_1061004_046",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我還以為終於能見到晶了說……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "妳那麼想見晶啊？",
    "voice": "vo_adv_1061004_047",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "沒想到妳還滿怕寂寞的嘛，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "諾維姆。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "吵死了！",
    "voice": "vo_adv_1061004_048",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我才沒有寂寞呢！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "晶不在的話我要回去了！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "掰掰，尾狗刀！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "哎呀呀，",
    "voice": "vo_adv_1061004_049",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "走掉啦。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "接下來。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "該做的事也都做完了，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n回家去登入吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你這傢伙幹嘛跟過來呀！",
    "voice": "vo_adv_1061004_050",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "因為是工作嘛。",
    "voice": "vo_adv_1061004_051",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "妳還在氣剛才的事啊？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "差不多該消氣了吧。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "喂？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "不知道！",
    "voice": "vo_adv_1061004_052",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "如果有下次，你就算道歉我也不理你喔！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n別跟過來啦！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "咦──",
    "voice": "vo_adv_1061004_053",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "別這麼說嘛──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "……",
    "voice": "vo_adv_1061004_054",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "啊。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "諾維姆妳看。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "發現這次的目標了。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "是嗎！",
    "voice": "vo_adv_1061004_055",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "剛好，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "可以紓壓！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "still",
    "still_id": "106100401"
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "喂！",
    "voice": "vo_adv_1061004_056",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "那邊幾位！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n和我戰鬥吧！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "玩家1",
    "words": "啊？",
    "voice": "vo_adv_1061004_057",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "玩家1",
    "words": "\\n……怎麼了，那麼突然？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "雖然不能告訴妳原因，",
    "voice": "vo_adv_1061004_058",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n但現在可不可以和我們戰鬥呢？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "玩家2",
    "words": "什麼……？",
    "voice": "vo_adv_1061004_059",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "戰鬥什麼的很麻煩吧。",
    "voice": "vo_adv_1061004_060",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "所以如果妳們能早點被解決掉的話就輕鬆多了。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "順帶一提，",
    "voice": "vo_adv_1061004_061",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "妳們如果輸了，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n就不能再用那個帳號再次登入了，加油囉～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "玩家1",
    "words": "你們該不會是，",
    "voice": "vo_adv_1061004_062",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "玩家1",
    "words": "PK公會的……！？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "反正妳們是贏不過我跟尾狗刀的，",
    "voice": "vo_adv_1061004_063",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n要投降趁現在唷！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "玩家2",
    "words": "……光兩個人想挑戰我們，",
    "voice": "vo_adv_1061004_064",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "玩家2",
    "words": "真是好大的膽子呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "玩家2",
    "words": "\\n要上囉各位！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "嘿嘿，",
    "voice": "vo_adv_1061004_065",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "太棒了太棒了！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "開始有幹勁了呢！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "準備好，尾狗刀！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "把她們所有人，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "全都砍掉！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "還是那麼熱血呢，諾維姆。",
    "voice": "vo_adv_1061004_066",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我會大概支援一下的，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "剩下的就交給妳囉──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "喔！",
    "voice": "vo_adv_1061004_067",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我要開始囉，搭擋！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "後面就交給你了！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "好──",
    "voice": "vo_adv_1061004_068",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "就交給我吧，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "搭擋。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……這孩子可以播放的記憶，",
    "voice": "vo_adv_1061004_069",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n果然到這裡就是極限了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然循著與那傢伙之間的羈絆，",
    "voice": "vo_adv_1061004_070",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n總算是接觸到了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但再接下去就沒辦法了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "還以為終於找到有益的資訊了呢……",
    "voice": "vo_adv_1061004_071",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "用能力做的防護，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "果然無法解除呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然那段記憶重要到這地步，",
    "voice": "vo_adv_1061004_072",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但同時也不太想回憶起呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那時發生的事。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……也不能勉強她回憶起來呢。",
    "voice": "vo_adv_1061004_073",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不知道會有什麼影響。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這孩子的記憶，",
    "voice": "vo_adv_1061004_074",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "除了阿斯特朗開始的事情外，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n都是些讓人不忍去看的事情……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "即使如此，",
    "voice": "vo_adv_1061004_075",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "只有那陣子的回憶是",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "會讓她願意回想起來的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n充滿光輝的記憶吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "存取結束。",
    "voice": "vo_adv_1061004_076",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "開始重新啟動。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n……雖然之前曾是敵人，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但從今起請多多指教唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "諾維姆。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500341"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯嗯……",
    "voice": "vo_adv_1061004_077",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "咦？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "剛睡著了嗎，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "以前的事，",
    "voice": "vo_adv_1061004_078",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "最近幾乎都沒有夢見過了……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "算了沒差。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "呼啊……",
    "voice": "vo_adv_1061004_079",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "明天就是作戰進行日了，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "早點睡吧……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "晚安，",
    "voice": "vo_adv_1061004_080",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "搭擋……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……",
    "voice": "vo_adv_1061004_081",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "說著現在無法向搭擋說出口的話，\\n矛依未再度進入夢鄉──",
    "voice": null,
    "unit_id": null
  }
]
