[
  {
    "type": "background",
    "bg_id": "510224"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}與貪吃佩可在神秘的世界遇上了魔物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人好不容易擊退了魔物後，再次開始調查這個充滿謎團的世界。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個魔物……",
    "voice": "vo_adv_5085001_000",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "從這裡出現了呢。",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "到底，",
    "voice": "vo_adv_5085001_001",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這像裂縫一樣的東西是什麼……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "該不會，",
    "voice": "vo_adv_5085001_002",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "它後面連接著蘭德索爾，",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n只要跳進去就能回去了？",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是啊。",
    "voice": "vo_adv_5085001_003",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然想要賭一把",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "試試看……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但還是不要比較好。",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "萬一",
    "voice": "vo_adv_5085001_004",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為這樣而和你分隔兩地，",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "會很困擾的。",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊！",
    "voice": "vo_adv_5085001_005",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那很危險的！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你還是一樣好奇心旺盛呢♪",
    "voice": "vo_adv_5085001_006",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過，",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這種時候還是謹慎一點比較好。",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n……真的要碰它的話就一起碰",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "吧♪",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "…………",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──嗎！？",
    "voice": "vo_adv_5085001_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "聽得到嗎！？",
    "voice": "vo_adv_5085001_008",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n喂！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這是……",
    "voice": "vo_adv_5085001_009",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "聲音……？",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n簡直像是，",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "直接傳到腦袋裡一樣……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "聽得到",
    "voice": "vo_adv_5085001_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我的聲音吧！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n太好了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "想不到",
    "voice": "vo_adv_5085001_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "連這邊都受到影響……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n連聲音也傳不過去，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "太折騰人了吧，真是的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個，",
    "voice": "vo_adv_5085001_012",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳該不會是……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "愛梅斯大人？",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯，",
    "voice": "vo_adv_5085001_013",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "抱歉啊，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "貪吃佩可。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n把你們關在",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那種地方。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "把我們關",
    "voice": "vo_adv_5085001_014",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "起來……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳知道這是什麼狀況嗎！？",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這裡到底是哪裡！？",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n是我們之前看過的",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個地方嗎！？",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然是相同的風景，",
    "voice": "vo_adv_5085001_015",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "卻是不同的地方。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那裡是",
    "voice": "vo_adv_5085001_016",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "從這傢伙的記憶中產生的夢之場所。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "從他的",
    "voice": "vo_adv_5085001_017",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "記憶……？",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "沒錯。",
    "voice": "vo_adv_5085001_018",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n從累積在這傢伙身上的",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "「記憶碎片」產生的，像夢一樣的東西。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "──是我為了讓妳看而做出來的",
    "voice": "vo_adv_5085001_019",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "「人工世界」。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "愛梅斯大人，既然是妳做出來的世界，",
    "voice": "vo_adv_5085001_020",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n妳應該知道如何從這裡出去吧？",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們",
    "voice": "vo_adv_5085001_021",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "想回到蘭德索爾！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……對不起。",
    "voice": "vo_adv_5085001_022",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n現在",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我還不能那麼做。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "為什麼……？",
    "voice": "vo_adv_5085001_023",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這次",
    "voice": "vo_adv_5085001_024",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "讓你們看這個「人工世界」",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是有理由的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n……跟你有關喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "跟他有關……？",
    "voice": "vo_adv_5085001_025",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你現在",
    "voice": "vo_adv_5085001_026",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "正處於非常危險的狀態。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n危險程度甚至不能一直讓你存在於蘭德索爾。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "！？",
    "voice": "vo_adv_5085001_027",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你……",
    "voice": "vo_adv_5085001_028",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不驚訝嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n該不會，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你有想到什麼！？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "才不是那樣！！",
    "voice": "vo_adv_5085001_029",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "只是因為我沒辦法駕馭而已……！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "等、",
    "voice": "vo_adv_5085001_030",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "等一下！？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你該不會……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在那邊也",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "可以使用力量？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "原來如此，",
    "voice": "vo_adv_5085001_031",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是跟魔物之間的戰鬥……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "魔物！？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你那邊也出現魔物了嗎！？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這可不妙了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "比想像中還要糟糕。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我問妳，",
    "voice": "vo_adv_5085001_032",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "貪吃佩可。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這傢伙的力量……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n有沒有什麼",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "奇怪的地方？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呃，",
    "voice": "vo_adv_5085001_033",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我穿的衣服突然起了變化……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "湧出了比平常還要強大的力量……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我沒辦法",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好好地使用它。",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "心一橫用力攻擊之後，",
    "voice": "vo_adv_5085001_034",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n反而產生了像是自己身體",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "要壞掉一樣的",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "疼痛感……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……這樣",
    "voice": "vo_adv_5085001_035",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n想不到",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "竟然這麼嚴重……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有什麼",
    "voice": "vo_adv_5085001_036",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "關聯嗎？",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是啊……",
    "voice": "vo_adv_5085001_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那就是這次事件的開端。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "──你的公主騎士之力，",
    "voice": "vo_adv_5085001_038",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "已經強過頭了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以我，",
    "voice": "vo_adv_5085001_039",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n才暫時把你的精神分離到「人工世界」，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n將力量與",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "心靈隔離開來。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "變強……",
    "voice": "vo_adv_5085001_040",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "應該是",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好事沒錯吧……？",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "當然，",
    "voice": "vo_adv_5085001_041",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "變強是件好事。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "前提是配合你自身的成長，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "的話。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "經歷了許多冒險、",
    "voice": "vo_adv_5085001_042",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "戰鬥、",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "以及相遇，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你一直持續在成長。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "藉由連繫羈絆，",
    "voice": "vo_adv_5085001_043",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你的力量就會變強。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "每增加一個必須守護的事物，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "每增加一些",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "記憶的碎片。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n公主騎士的力量",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "會無止盡地",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "增強下去。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "然而",
    "voice": "vo_adv_5085001_044",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在最近的數場大戰中，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你原本的公主騎士力量歸還到你身上，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n此時",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "又增加了名為「公主型態」的",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "新力量。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "急速進化……",
    "voice": "vo_adv_5085001_045",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "已經超越了成長。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "太過強大的力量，",
    "voice": "vo_adv_5085001_046",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "已經到了會反噬自己的程度。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎麼會……！",
    "voice": "vo_adv_5085001_047",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n自己的力量……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "竟然會讓他傷到自己嗎！？",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不對，",
    "voice": "vo_adv_5085001_048",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不光是你。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那些承受這股力量的人也一樣。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……連我們，",
    "voice": "vo_adv_5085001_049",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也會？",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "然後，",
    "voice": "vo_adv_5085001_050",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那個甚至可能會對「那一側世界的命運」",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "造成巨大影響。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不管怎樣……",
    "voice": "vo_adv_5085001_051",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "力量再繼續增強下去的話，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你的身體",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "很快就會撐不住了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……破碎的資料",
    "voice": "vo_adv_5085001_052",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "都會走向相同的結局。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n會被視為「不明原因的錯誤」",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "而遭到世界排除，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "然後消失。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……這個人會",
    "voice": "vo_adv_5085001_053",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "消失……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "從我們的身旁消失……？",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "…………",
    "voice": "vo_adv_5085001_054",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我",
    "voice": "vo_adv_5085001_055",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "該怎麼做才好？",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n要怎麼做",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "才能救他！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "說實在的，",
    "voice": "vo_adv_5085001_056",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我完全沒預料到貪吃佩可會在這裡。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在我製作這個夢世界時，",
    "voice": "vo_adv_5085001_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "為了盡量",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不讓你想起那邊的事情，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我本來設法",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "使你以及周遭的人，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n都無法從記憶中說出阿斯特朗的事情。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過實際上，",
    "voice": "vo_adv_5085001_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你帶著那邊的記憶",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "到了這裡，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n連貪吃佩可也一起",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "捲進來了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這也是，",
    "voice": "vo_adv_5085001_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "力量變強過頭的影響……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……不對。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這代表，",
    "voice": "vo_adv_5085001_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "對你而言，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "「那一側」有那麼地重要呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……不管怎樣，",
    "voice": "vo_adv_5085001_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這邊也是……那邊也是，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n為了解決狀況而……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "採取……行動……呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "愛梅斯大人！？",
    "voice": "vo_adv_5085001_062",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n聲音",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "越來越聽不見了……！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不要使用……",
    "voice": "vo_adv_5085001_063",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "力量……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……已經",
    "voice": "vo_adv_5085001_064",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "聽不到了。",
