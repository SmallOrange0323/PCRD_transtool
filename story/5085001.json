    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "要是魔物又出現的話……",
