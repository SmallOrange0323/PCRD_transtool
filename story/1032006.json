[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "走在蘭德索爾城鎮中心的{0}\\n與秋乃巧遇。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "{0}大人！",
    "voice": "vo_adv_1032006_000",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "來的正好！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "為了成為「獨當一面的商人」",
    "voice": "vo_adv_1032006_001",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我想到一件最適合的事了。那就是投資文化事業！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我如果對這個國家的文化有所貢獻的話，",
    "voice": "vo_adv_1032006_002",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n肯定也能獲得父親大人的認同！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "因此，",
    "voice": "vo_adv_1032006_003",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "作為紫藤家支援的文化事業第一彈，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n將要舉行戲劇祭！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "其實，今天就是舉辦日……",
    "voice": "vo_adv_1032006_004",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "如果可以的話，你現在要不要",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n跟我一起去廣場觀賞呢？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "可以嗎？謝謝你！",
    "voice": "vo_adv_1032006_005",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼，我們現在趕快走吧！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "氣氛好像已經很熱烈了呢！",
    "voice": "vo_adv_1032006_006",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "也有很多觀眾前來觀賞！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這個戲劇祭預計會有一人戲劇、兩人演出的戲劇、",
    "voice": "vo_adv_1032006_007",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n多人演出的戲劇及富含娛樂效果的表演。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真是令人期待呢！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哎呀？好像有人倒在舞臺的旁邊？",
    "voice": "vo_adv_1032006_008",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n好像是……一對男女呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "{0}大人，我們一起去看看情況吧",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "好痛啊……肚子……",
    "voice": "vo_adv_1032006_009",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "打擾一下？",
    "voice": "vo_adv_1032006_010",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你還好嗎？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "先把這杯水給喝下去吧。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "女",
    "words": "謝、謝謝妳…",
    "voice": "vo_adv_1032006_011",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女",
    "words": "…",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你們怎麼了呢？",
    "voice": "vo_adv_1032006_012",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "其實我們是等會兒要表演戲劇的演員，",
    "voice": "vo_adv_1032006_013",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n但是剛剛在休息室吃的料理好像壞掉了……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n現在正因為肚子痛而苦惱著……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "好痛啊……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女",
    "words": "我們很努力練習兩人戲劇表演，",
    "voice": "vo_adv_1032006_014",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女",
    "words": "\\n但現在這樣……不得不取消……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女",
    "words": "好痛啊……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女",
    "words": "難得這是個好劇本……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "原來如此……這是你們自豪的作品嗎？",
    "voice": "vo_adv_1032006_015",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "是啊！我想展現給大家看啊……",
    "voice": "vo_adv_1032006_016",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n至少只有劇本也好……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n現在還找不找得到人代為演出……應該是找不到吧……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我知道了！",
    "voice": "vo_adv_1032006_017",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我們就代替你們演出吧！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "真、真的嗎！？",
    "voice": "vo_adv_1032006_018",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "如果你們真的願意代為演出的話，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n我們也很歡迎的……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "啊……",
    "voice": "vo_adv_1032006_019",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "{0}大人……\\n我擅自決定了，真是對不起……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n給你添麻煩了嗎？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "謝謝你！",
    "voice": "vo_adv_1032006_020",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n這才是我的騎士候選人啊！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你不用勉強自己，",
    "voice": "vo_adv_1032006_021",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "但可以麻煩你",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "站在最前排\\n對著我們，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "然後舉著劇本嗎？　",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "如果能同時\\n小聲地指示我們的話，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我們就能照著演了！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "拜、拜託你們了……",
    "voice": "vo_adv_1032006_022",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接著，秋乃與{0}一起演出的\\n兩人戲劇的出場時刻來臨了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這布幕升起後，",
    "voice": "vo_adv_1032006_023",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "便要開始表演了……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "還、",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "還真是稍微……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "有些緊張……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我想想，基本的故事情節，",
    "voice": "vo_adv_1032006_024",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n好像是年輕夫妻在房裡對話時，妻子發現老公欠債。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n但就算如此，兩人仍互相確認彼此的愛依舊不變……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "雖說是兩人戲劇，竟然也有簡易的房間布景，",
    "voice": "vo_adv_1032006_025",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n很正式呢……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "而且這是……愛、愛情故事呢……",
    "voice": "vo_adv_1032006_026",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n雖、雖然，我是不介意啦……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "總、總之，布幕就要升起了！",
    "voice": "vo_adv_1032006_027",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n演戲的細節部分，我們就在舞台上修改吧！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n加油囉，{0}大人！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "秋乃小姐，我搶到最前面的位置了喔。",
    "voice": "vo_adv_1032006_028",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n我會從這裡讓你們看劇本，給你們建議的，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n那就麻煩你們了……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "原來如此，這樣應該就沒有問題了吧……",
    "voice": "vo_adv_1032006_029",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "「我是位年輕妻子，與丈夫一起生活……",
    "voice": "vo_adv_1032006_030",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n過著自由、滿足的日子。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n只是，我無法確信丈夫的愛，而每日感到焦躁……」",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "「啊，歡迎你回來，老公！",
    "voice": "vo_adv_1032006_031",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "」",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "「嗯，歡迎你回來，親愛的……」",
    "voice": "vo_adv_1032006_032",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "年輕夫妻……",
    "voice": "vo_adv_1032006_033",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "像這樣子感覺也不錯呢……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……糟糕，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "得快說下一句台詞！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "「來吧，",
    "voice": "vo_adv_1032006_034",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "開始吃晚餐吧！」",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "「哎呀？　",
    "voice": "vo_adv_1032006_035",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這張紙是……」",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "「這是10萬盧幣的借據！　",
    "voice": "vo_adv_1032006_036",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "親、",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "親愛的！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你什麼時候借了這麼多錢！？」",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "「就是說啊。區區10萬盧幣的小錢，",
    "voice": "vo_adv_1032006_037",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我去買東西的時候就順便幫你還啊」",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "請、請不要擅自更換劇本――！",
    "voice": "vo_adv_1032006_038",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n10萬盧幣可是筆大錢喔――！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "啊，不、",
    "voice": "vo_adv_1032006_039",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不小心就以我平常的金錢觀……！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "「不、不對，你竟然欠了10萬盧幣……」",
    "voice": "vo_adv_1032006_040",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "「這、這張借條先放一邊，",
    "voice": "vo_adv_1032006_041",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我們來吃飯吧。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n因為餐具不夠，所以要洗碗」",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……洗碗？要怎麼洗呢？",
    "voice": "vo_adv_1032006_042",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "對了！我將盤子跟水一起甩，",
    "voice": "vo_adv_1032006_043",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n把髒污甩掉吧！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "「哈啊啊啊啊啊啊啊啊！」",
    "voice": "vo_adv_1032006_044",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "嗚哇啊啊！才不是那樣吧！",
    "voice": "vo_adv_1032006_045",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "給我正常洗碗啊啊啊！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾",
    "words": "啊哈哈哈哈！",
    "voice": "vo_adv_1032006_046",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "接下來，妻子一邊壓抑對丈夫的怒氣，",
    "voice": "vo_adv_1032006_047",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n一邊默默地準備曬衣服……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "曬衣桿……是哪一個呢？",
    "voice": "vo_adv_1032006_048",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我想想……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "對了！總之，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n就先用我的劍把柱子砍掉當棍子的話，就能曬衣服啦！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "「那個，因為沒有曬衣桿，我就砍掉家裡的柱子囉。",
    "voice": "vo_adv_1032006_049",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n就冒昧地用這把劍……嘿！」",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "嗚哇啊啊啊！",
    "voice": "vo_adv_1032006_050",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n這個場景就算了，演下一幕吧！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾",
    "words": "啊哈哈！這齣戲真有趣―――！",
    "voice": "vo_adv_1032006_051",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "直接演下一幕嗎？",
    "voice": "vo_adv_1032006_052",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n那個……因為很多場景都跳過了……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n所以剩下的場景是……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "最後一個場景，說完「只要我跟你之間有愛的話！",
    "voice": "vo_adv_1032006_053",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n就算欠債也沒關係！」後就親吻！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "still",
    "still_id": "103200602"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "親、親吻！？",
    "voice": "vo_adv_1032006_054",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "雖、雖然說是演戲，但竟然有那樣的場景……",
    "voice": "vo_adv_1032006_055",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我完全沒想到啊……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "still",
    "still_id": "103200601"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……你認為如何呢？",
    "voice": "vo_adv_1032006_056",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n跟我，那個……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "說、說得也是呢……",
    "voice": "vo_adv_1032006_057",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n演戲，這個是演戲……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "覺、覺悟！？",
    "voice": "vo_adv_1032006_058",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那、那指的不是",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n決定要做本小姐的騎士嗎……？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我……",
    "voice": "vo_adv_1032006_059",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是為了紫藤家，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n所以也主辦了這齣戲劇。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我認為，為各位一般市民做些事情，",
    "voice": "vo_adv_1032006_060",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n是本小姐的義務啊。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "所以……",
    "voice": "vo_adv_1032006_061",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我現在，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要做我該做的事了。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n可以的吧，{0}大人？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……謝謝你。",
    "voice": "vo_adv_1032006_062",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n你真的是一位非常出色的人呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼，開始吧……",
    "voice": "vo_adv_1032006_063",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n「只要我跟你之間有愛的話！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n就算欠債也沒關係……」親、親吻……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "咦，",
    "voice": "vo_adv_1032006_064",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "奇怪？　",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "剛才被劍砍過的地方……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要倒下來啦――――！？",
    "voice": "vo_adv_1032006_065",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "咳、咳、咳……",
    "voice": "vo_adv_1032006_066",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這簡直就像是搞笑短劇的結尾呢……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "觀眾",
    "words": "啊――哈哈！",
    "voice": "vo_adv_1032006_067",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾",
    "words": "\\n真有趣呢――！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……咦？",
    "voice": "vo_adv_1032006_068",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "觀眾",
    "words": "哇哈哈哈哈哈！鼓掌鼓掌鼓掌鼓掌！！",
    "voice": "vo_adv_1032006_069",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這、這就是……",
    "voice": "vo_adv_1032006_070",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "所、所謂起立鼓掌的行為嗎……？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "秋乃小姐！",
    "voice": "vo_adv_1032006_071",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "辛苦你們了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n我是撰寫劇本的人！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "啊！真、真是抱歉呢，",
    "voice": "vo_adv_1032006_072",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n把你們的戲劇演得亂七八糟的…",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "…",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "女",
    "words": "多虧了你們，我們的戲劇才能有更好的演出結果！",
    "voice": "vo_adv_1032006_073",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "咦！？",
    "voice": "vo_adv_1032006_074",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "女",
    "words": "這齣戲劇本來是很嚴肅的……",
    "voice": "vo_adv_1032006_075",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女",
    "words": "\\n但是看到了大家的笑容，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女",
    "words": "\\n讓我們知道其實只要這樣就好了！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "重要的是，任何夫妻間的問題，都該笑著拋諸腦後呢！",
    "voice": "vo_adv_1032006_076",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n你們能代替我們演出……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "真的非常感謝！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不、不，這沒什麼……",
    "voice": "vo_adv_1032006_077",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n嗯，算了，反正圓滿結束就好了…… ",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這樣就可以了吧？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不過，剛剛我可是忍不住心跳加速了呢。",
    "voice": "vo_adv_1032006_078",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "跟{0}大人成為夫妻……呵呵。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "紫藤家所主辦的第一屆戲劇祭，\\n伴隨著觀眾們的熱烈喝彩，非常成功地結束了。",
    "voice": null,
    "unit_id": null
  }
]
