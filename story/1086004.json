  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為你可是特殊的存在，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以取回記憶的工作也該仔細慎重地進行……",
