[
  {
    "type": "background",
    "bg_id": "500112"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "綾音受到與自己一模一樣的『闇影』所託付，收下要送給父母的禮物後，\\n便立刻前往自己的家。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "綾音的父母溫柔地迎接離家出走的女兒，\\n並為禮物感到非常開心。\\n接著，還邀請了綾音一起參加慶祝聖誕節的派對。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "綾音因不忍拒絕，而久違地與父母一塊用餐。\\n綾音和父母自始至終都帶著笑容，幸福的氣氛就這麼持續下去。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在用餐過後，父母雖然很捨不得地挽留了綾音，\\n但是「我必須把別人託我買的東西送回去才可以」\\n綾音如此說道，便返回了【咲戀育幼院】。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我回來了～……",
    "voice": "vo_adv_1086004_000",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "呀哇！",
    "voice": "vo_adv_1086004_001",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "歡迎回來，綾音……",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "怎、怎麼了嗎？　",
    "voice": "vo_adv_1086004_002",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "難道受傷了嗎？",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "綾音",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n為何會被{0}哥哥背著呢……？",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊，",
    "voice": "vo_adv_1086004_003",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我沒有受傷，別擔心。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "只是感覺",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "有點累了……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "這、",
    "voice": "vo_adv_1086004_004",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我們是有接到聯絡，",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我記得好像是綾音和父母一起吃飯了……？",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我本來以為是不能太深入的問題，",
    "voice": "vo_adv_1086004_005",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "所以才沒有多問什麼……",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "但是綾音，",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "妳和父母的關係不好嗎……？",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不是的……",
    "voice": "vo_adv_1086004_006",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n爸爸和媽媽",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "都非常地寶貝我。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "只是我",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "沒辦法坦率地接受他們的愛情。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咦。",
    "voice": "vo_adv_1086004_007",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "胡桃的爸爸媽媽因為『消失』，\\n所以不見了……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我得多注意才行。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那種話題，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "還是別說太多比較好呢。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "畢竟胡桃",
    "voice": "vo_adv_1086004_008",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就算想見爸爸媽媽也見不到啊。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……欸嘿嘿。",
    "voice": "vo_adv_1086004_009",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "沒事的，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我很有精神喔。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯……",
    "voice": "vo_adv_1086004_010",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "如果有什麼煩惱就和我商量喔，",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "因為我們是家人啊。",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯。",
    "voice": "vo_adv_1086004_011",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n謝謝，胡桃。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嘿嘿。",
    "voice": "vo_adv_1086004_012",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我真的打起精神了。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n你可以不需要再背我囉，哥哥，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "很抱歉一直跟你撒嬌。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嘿咻。",
    "voice": "vo_adv_1086004_013",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "有什麼東西掉了！　",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "有叩咚的聲音！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉……",
    "voice": "vo_adv_1086004_014",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不是呢，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉我一直都好好拿在手上。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那是什麼呢？　",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那個……？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "綾音，",
    "voice": "vo_adv_1086004_015",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "妳腳邊有什麼閃閃發光的東西掉了喔……？",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "閃閃發光？　",
    "voice": "vo_adv_1086004_016",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是像寶石一樣的東西掉了！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n這是什麼東西？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥知道嗎？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "記、記憶……",
    "voice": "vo_adv_1086004_017",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咦？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我沒聽過那東西，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那是什麼？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯嗯……",
    "voice": "vo_adv_1086004_018",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是『闇影』偶爾會掉落的，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "某人的記憶結晶嗎？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n還有那種東西啊～",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥明明喪失記憶了，卻只知道些奇怪的事呢？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "『闇影』掉落的就表示……",
    "voice": "vo_adv_1086004_019",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是那個消失的，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "和我一模一樣的『闇影』掉的嗎？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "然後，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不知不覺間掉進我的衣服裡……嗎？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "呀？",
    "voice": "vo_adv_1086004_020",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n有、有什麼東西在發光啊，哥哥！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哇哇！",
    "voice": "vo_adv_1086004_021",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這個叫做記憶碎片……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "的東西也在發光！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這怎麼回事？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好耀眼～！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "background",
    "bg_id": "510280"
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……♪",
    "voice": "vo_adv_1086004_022",
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『",
    "voice": "vo_adv_1086004_023",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "喂喂！　",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "真是不像樣耶，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "你已經累了嗎……{0}？』",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『綾音可是還完全沒有滿足，",
    "voice": "vo_adv_1086004_024",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "要再陪我們一下喔？』",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『鞋子帽子都買齊了，",
    "voice": "vo_adv_1086004_025",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n之後就是衣服了……",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "要到下一間店去囉！』",
    "voice": null,
    "unit_id": 2131
  },
