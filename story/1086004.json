    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "為什麼要抱住我呢？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我、",
    "voice": "vo_adv_1086004_083",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我可不是玩偶喔……？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗚嗚。",
    "voice": "vo_adv_1086004_084",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "傷腦筋，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "靠我的力氣沒辦法掙脫哥哥啊。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "被抱住後覺得好溫暖、",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n好開心，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "又開始想睡覺了。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "算了，也好。",
    "voice": "vo_adv_1086004_085",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就這樣子",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n被當成玩偶抱住再睡一下吧。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "因為發生了悲傷的事情，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "感覺變得好無助……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "正好是想盡情撒嬌的時候。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥，",
    "voice": "vo_adv_1086004_086",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就這樣抱住我。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "治癒我、",
    "voice": "vo_adv_1086004_087",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "拯救我……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "從這盡是難以理解",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "又充滿悲傷的世界裡，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就算僅僅在夢中的時間也好，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "請你要守護我喔。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不對。",
    "voice": "vo_adv_1086004_088",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n求求你……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "請你要愛我喔，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 108611
  }
]
