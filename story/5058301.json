[
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留、小可蘿，",
    "voice": "vo_adv_5058301_000",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳們看！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那邊有魔物！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "看起來非～常好吃呢☆",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說什麼！",
    "voice": "vo_adv_5058301_001",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "魔物看起來非常好吃呢！！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不對吧！！！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不要一看到魔物就立刻想像牠的味道啦！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n一般",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不應該都是",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看起來很難對付、",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要多加小心",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "之類的嗎！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "肉質看起來",
    "voice": "vo_adv_5058301_002",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的確很硬，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "很難對付的樣子。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "料理的時候",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "小心一點，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不要切到手指了。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……我說啊，",
    "voice": "vo_adv_5058301_003",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可蘿仔。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我不是在討論肉的硬度唷！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n是在說戰鬥……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿嘿嘿，",
    "voice": "vo_adv_5058301_004",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "為了烹調美味的料理，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n【美食殿堂】的大家團結一心了呢♪",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_5058301_005",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n今天",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們【美食殿堂】也是",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "團結一心。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我的心是被強迫團結的吧！？",
    "voice": "vo_adv_5058301_006",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我可沒有想要",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "吃什麼魔物啊！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "透過我們的羈絆，",
    "voice": "vo_adv_5058301_007",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "今天也取得美味的料理吧☆",
    "voice": null,
    "unit_id": 105811
  }
]
