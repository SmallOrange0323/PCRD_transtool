  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在離情人節只剩幾天的某一天。\\n城裡充滿著慶祝的氣氛，\\n靜流與璃乃來到了鬧區的某間舶來品店。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃，",
    "voice": "vo_adv_1091001_000",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳要做情人節巧克力嗎？",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "欸！？",
    "voice": "vo_adv_1091001_001",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "　為什麼突然問我！！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "當、",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "當然是要做給哥哥啊。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "對呢～",
    "voice": "vo_adv_1091001_002",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}弟弟很可愛嘛，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n大家都會想送他巧克力呢～",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我懂我懂！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "其實，",
    "voice": "vo_adv_1091001_003",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我這次也想幫{0}弟弟",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "做巧克力呢。",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n……",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "和惠理子一起。",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "惠、",
    "voice": "vo_adv_1091001_004",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "惠理子嗎！？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n惠理子是指那個",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "人稱「破壞者」的惠理子吧？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "怎麼會做那種事……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呵呵呵，",
    "voice": "vo_adv_1091001_005",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "祕密♪",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "可是，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "和她的比賽我絕對不能輸。",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n是女性之間的戰爭呢！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "比、",
    "voice": "vo_adv_1091001_006",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "比賽是指什麼啊……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我只有不好的預感……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "然後啊，",
    "voice": "vo_adv_1091001_007",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我也想讓{0}看看",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我們兩個人做巧克力的模樣。",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "果然還是",
    "voice": "vo_adv_1091001_008",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "要穿得可愛點，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n這樣{0}弟弟也會開心吧？",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "所以我今天是來挑選在料理時要穿的衣服的！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "總之，",
    "voice": "vo_adv_1091001_009",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳是想得到選衣服的建議，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n所以今天找我來的吧？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "交給我吧！",
    "voice": "vo_adv_1091001_010",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我會幫姐姐選出讓妳最耀眼奪目的衣服的。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我還能幫妳修改呢。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "喔～",
    "voice": "vo_adv_1091001_011",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真可靠！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "　",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "對了，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n要給{0}弟弟巧克力的事要保密喔？",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "因為是驚喜，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "被發現就沒意義了嘛。",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我知道了～",
    "voice": "vo_adv_1091001_012",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n別看我這樣，我口風很緊喔。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "俗話說「禍從口入，謹言身心」嘛。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "對身體不好的東西",
    "voice": "vo_adv_1091001_013",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "千萬不要亂吃啊♪",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳要說的是",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "「禍從口出，謹言慎行」吧。",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，",
    "voice": "vo_adv_1091001_014",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這樣啊！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "如果是那樣的話，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們來這裡的事，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n也不能讓哥哥知道吧。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要偷偷地，",
    "voice": "vo_adv_1091001_015",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "悄悄地……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊！？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯，",
    "voice": "vo_adv_1091001_016",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在那邊的人……",
    "voice": "vo_adv_1091001_017",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是哥哥。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "咦！？",
    "voice": "vo_adv_1091001_018",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n為、",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "為什麼{0}弟弟會來這裡！？",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "似乎是來打工呢……",
    "voice": "vo_adv_1091001_019",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為哥哥他從事很多不同的工作。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呀！？",
    "voice": "vo_adv_1091001_020",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "　什麼時候到身後的？",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "馬上就被發現了呢……",
    "voice": "vo_adv_1091001_021",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯～",
    "voice": "vo_adv_1091001_022",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不過難得{0}弟弟也在，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我來試探一下他對衣服的喜好吧。",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "欸欸，{0}弟弟。",
    "voice": "vo_adv_1091001_023",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你覺得姐姐做料理時，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n穿什麼衣服比較適合？",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這問題不會太直接了嗎！？",
    "voice": "vo_adv_1091001_024",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "咦，",
    "voice": "vo_adv_1091001_025",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "容易活動的衣服？",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我當然也是覺得容易活動會比較好，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "畢竟是要做料理嘛？",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過",
    "voice": "vo_adv_1091001_026",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "穿著運動服做料理\\n實在是不可愛呢……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯，",
    "voice": "vo_adv_1091001_027",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "有沒有什麼好點子呢～",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "傳統的衣服啊……",
    "voice": "vo_adv_1091001_028",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "喏，璃乃，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳覺得烹飪罩衫如何呢？",
