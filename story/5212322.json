[
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "喔？",
    "voice": "vo_adv_5212322_000",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "確認到敵人周圍有遠古遺物！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n大家，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "比起目標的BOSS，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "先瞄準那些傢伙！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "遠古遺物？",
    "voice": "vo_adv_5212322_001",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "在說",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這個小型魔物？",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊啊，",
    "voice": "vo_adv_5212322_002",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那是很久以前的測試資料。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n那些魔物裝有BOSS戰用的機關，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n打倒後，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就能發動對我們有利的附帶效果。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "原來如此，",
    "voice": "vo_adv_5212322_003",
    "unit_id": 137911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那麼就是要先來",
    "voice": null,
    "unit_id": 137911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "「大頭針」對吧！",
    "voice": null,
    "unit_id": 137911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "當作是順便年末大掃除，",
    "voice": null,
    "unit_id": 137911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "用我的箭收拾得一乾二淨吧！",
    "voice": null,
    "unit_id": 137911
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "說得對，",
    "voice": "vo_adv_5212322_004",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "交給妳「打頭陣」了！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "璃乃！",
    "voice": null,
    "unit_id": 106811
  }
]
