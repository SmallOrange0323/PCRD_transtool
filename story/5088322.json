    "words": "呼、",
    "voice": "vo_adv_5088322_000",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "呼……！",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n終於擊退小老鼠了！",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "竟敢那樣對待我的手下……",
    "voice": "vo_adv_5088322_001",
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "我是很想這麼說，",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "\\n但好戲現在才要開始呢。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "沒時間讓人放心下來呢……",
    "voice": "vo_adv_5088322_002",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "身為淑女，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我想在這時候換個裝扮……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是令人遺憾啊！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "我們上，",
    "voice": "vo_adv_5088322_003",
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "啾三。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "遵命，",
    "voice": "vo_adv_5088322_004",
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "頭目！",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "\\n讓她們後悔",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "當初跑來這裡吧！",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我們",
    "voice": "vo_adv_5088322_005",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "才不會後悔！",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我們",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "絕對不會輸的……！",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "對吧，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "美咲！",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗯！",
    "voice": "vo_adv_5088322_006",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "好好教訓他們一頓吧！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n當然，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是用時髦的手段！",
    "voice": null,
    "unit_id": 121411
  }
]
