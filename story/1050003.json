  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "唔―嗯……",
    "voice": "vo_adv_1050003_000",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "雖然我很想去啦。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可是一個人去，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "有點那個。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "哎呀。",
    "voice": "vo_adv_1050003_001",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你是從哪裡冒出來的？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過，",
    "voice": "vo_adv_1050003_002",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你因為擔心我來向我搭話，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n這一點其實頗有紳士風度的。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我就特別稱讚你一次！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "耶，",
    "voice": "vo_adv_1050003_003",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我要吃我要吃──♪",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呃、",
    "voice": "vo_adv_1050003_004",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不要把我當小孩子啦，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你這個笨蛋！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n話說回來，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你是從哪裡冒出來的！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊，",
    "voice": "vo_adv_1050003_005",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "對了，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你來的正好！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "哼哼，",
    "voice": "vo_adv_1050003_006",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你可要感到榮幸。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我賜給你",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "當我的護花使者的權利！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "其實呢，",
    "voice": "vo_adv_1050003_007",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "在蘭德索爾，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n新開了一家知名的甜點店。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那家店超級受到情侶們的喜愛♪",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我",
    "voice": "vo_adv_1050003_008",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是想說至少去吃一次看看啦……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n不過聽說客人大多是情侶，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "一個人去了會很不自在。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "但是",
    "voice": "vo_adv_1050003_009",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你來的時機正好，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "幫了我大忙！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "事不宜遲，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我們這就去吃吧♪",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦？",
    "voice": "vo_adv_1050003_010",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你問我",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "要去吃什麼？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那還用說。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "當然是要去吃適合我這種成熟淑女的",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "大人甜點啊。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "來吧，",
    "voice": "vo_adv_1050003_011",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "快牽起我的手。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n要記住，你要做一位",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "與優雅聰明的成熟淑女",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "相襯的護花使者喔♪",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊，",
    "voice": "vo_adv_1050003_012",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就是這裡！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這裡就是",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "新開的甜點店！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "它的店名叫作",
    "voice": "vo_adv_1050003_013",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "「Bitter&Bitter」！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "賣著不甜",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "又很～苦",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "的甜點，完全符合店名，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是一家適合大人的甜點店喔♪",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "然後！",
    "voice": "vo_adv_1050003_014",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "裡面",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "最熱門的甜點是……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n「百分百純苦瓜汁果凍」！！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "聽說那是最近",
    "voice": "vo_adv_1050003_015",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "才剛改良的品種，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n是新推出的水果！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "苦瓜果凍……",
    "voice": "vo_adv_1050003_016",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "聽起來是",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "多麼成熟的詞彙呀。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "如果",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "小孩子吃了這種東西的話，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "一定會苦到哭出來吧。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可是，",
    "voice": "vo_adv_1050003_017",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我身為一位成熟的淑女，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n應該是會非常享受的♪",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這、",
    "voice": "vo_adv_1050003_018",
