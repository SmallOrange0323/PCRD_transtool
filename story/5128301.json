[
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沒想到沙漠中",
    "voice": "vo_adv_5128301_000",
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "會埋了這樣的東西……",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要是這傢伙大鬧起來，",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "城鎮會被毀掉的！",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我以前曾經和類似的對手戰鬥過。",
    "voice": "vo_adv_5128301_001",
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n如果被那個破舊的外表給騙了，",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可是會嚐到苦頭的喔。",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過，",
    "voice": "vo_adv_5128301_002",
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "無論是什麼樣的對手……",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n如果敢擋在我面前，",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我都會將其一刀兩斷的。",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咲戀，",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "準備好了嗎？",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯。",
    "voice": "vo_adv_5128301_003",
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就靠妳囉，",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "流夏！",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n當然",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還有{0}也是！",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那麼，",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們上吧！",
    "voice": null,
    "unit_id": 127511
  }
]
