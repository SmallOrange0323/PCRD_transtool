    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "それは、",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "以前あったと聞く、",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n人格入れ替えとはまた別の状態ということか？",
    "voice": null,
    "unit_id": 124211
  },
