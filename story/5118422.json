    "type": "dialogue",
    "name": "ジュン",
    "words": "──まさか！　",
    "voice": "vo_adv_5106422_003",
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n今度は二人を、",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "足して、",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "二で割った……？",
    "voice": null,
    "unit_id": 124211
  },
