  },
  {
    "type": "dialogue",
    "name": "ラフィ",
    "words": "魔法を発してしまって、",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "ラフィ",
    "words": "\\nヨリちゃんとアカリちゃんを、",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "ラフィ",
    "words": "みっくすしてしまいました……",
