  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "這些應該",
    "voice": "vo_adv_1063005_024",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "就是全部了吧？",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n等等再去委託人那邊報告完就結束了呢！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "{0}，謝謝你。",
    "voice": "vo_adv_1063005_025",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n剛剛在教{0}的時候……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n我",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "回想起了一些事情。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……以前蘿莎麗亞她，",
    "voice": "vo_adv_1063005_026",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "也是這樣教我的。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n她說姿勢要像大地一樣，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "呼吸要像微風一樣。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……抱歉呢，{0}。",
    "voice": "vo_adv_1063005_027",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n如果是蘿莎麗亞的話，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "一定能教得更好……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……真的嗎？",
    "voice": "vo_adv_1063005_028",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "耶嘿嘿，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "那麼……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "嗯！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n之後再一起練習吧！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "雖然沒有像蘿莎麗亞那麼厲害……",
    "voice": "vo_adv_1063005_029",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n不過如果是為了{0}，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n我會",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "盡全力教你的！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後，{0}和笑瞇瞇的亞里莎一起踏上歸途。",
