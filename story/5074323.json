  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不會吧，",
    "voice": "vo_adv_5074323_000",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "院長的力量還在增強……",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "再、",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "再變強下去，可能真的要束手無策了……",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是啊，",
    "voice": "vo_adv_5074323_001",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我也真的累了。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "院長看起來也一樣累了呢。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "什麼？",
    "voice": "vo_adv_5074323_002",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "他自己也已經撐不下去了。",
    "voice": "vo_adv_5074323_003",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "現在這就像是蠟燭要燒光之前",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "放出一瞬間的強烈光芒罷了。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可是，",
    "voice": "vo_adv_5074323_004",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要是在他燒光之前，我們先失去了光芒……？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀？",
    "voice": "vo_adv_5074323_005",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "世上最美最耀眼的人，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "怎麼會這麼沒自信呢？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "難道妳的光芒",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "會輸給這種依賴藥物強制製造出來的燭光？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……妳這話說得",
    "voice": "vo_adv_5074323_006",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好奸詐喔。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "聽到妳講這種話，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我也只能硬著頭皮上了呢。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就讓妳看看",
    "voice": "vo_adv_5074323_007",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "誰才是最美的！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我很期待喔，",
    "voice": "vo_adv_5074323_008",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "世上最美的護理師♪",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好啦，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這就是最後一戰了！",
    "voice": null,
    "unit_id": 117511
  }
]
