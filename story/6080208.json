  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "どっちの方が正しいと思ってる？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "でーすよねー！　",
