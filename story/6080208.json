  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "はー、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "分かってましたともー！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nそりゃね、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "都合良く力に目覚めていきなりパワー発揮するとかさ、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nそういう王道展開はそうそうないって分かってるよーだ！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "……うーん。",
    "voice": "vo_adv_6044208_002",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "なんかこう、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "気を使ってるのが伝わってくる。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "いや、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "まぁ、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "そりゃそう言ってもらった方がうれしいんだけどさ。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "そうじゃないよねーって自覚ある時だとダメージ受けますな……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "……そっか。",
    "voice": "vo_adv_6044208_003",
    "unit_id": 113311
  },
  {
