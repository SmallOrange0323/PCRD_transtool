    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n不是為了破壞，而是為了拯救他人。",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n原來我可以成為",
    "voice": null,
    "unit_id": 106541
  },
