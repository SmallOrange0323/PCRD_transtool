    "name": "嘉夜",
    "words": "因為你",
    "voice": "vo_adv_9500061_006",
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "已經一直",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "都在我身邊了。",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "無論何時，我都能懷抱著",
    "voice": null,
    "unit_id": 106541
  },
