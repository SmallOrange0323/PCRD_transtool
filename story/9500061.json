  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "心跳得好快。",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然我一直用死黨",
    "voice": "vo_adv_9500061_001",
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這個詞來說服自己，",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但我已經",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒辦法再自欺欺人了。",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我的感情",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "並不只是那樣而已。",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "可是……",
