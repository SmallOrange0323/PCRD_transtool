    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "覺醒的力量也好，",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n對那股力量感到畏懼的",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還有這顆心也好，",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我與你，",
