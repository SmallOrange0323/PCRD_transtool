    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒錯吧……！",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你一直",
    "voice": null,
    "unit_id": 106541
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "都是這樣說的……！",
