[
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "期望成為世界第一大壞蛋的諾維姆，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n今天也進行著非常認真（？）的鍛鍊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "哈哈哈哈～！",
    "voice": "vo_adv_5110607_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "……不，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "感覺有點不太一樣～？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n再稍微",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "壓低一點聲音可能比較好……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "唔……？",
    "voice": "vo_adv_5110607_001",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n尾狗刀，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "諾維姆她在做什麼？",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "看她突然笑出聲來，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "下一秒卻又沉默不語。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "啊，",
    "voice": "vo_adv_5110607_002",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "那個啊──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n她在練習壞蛋般的放聲大笑。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不過她那種興趣，我完全無法理解。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "你、",
    "voice": "vo_adv_5110607_003",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "你說什麼！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "放聲大笑應該是",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "正義一方的特權……",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n看來我必須糾正她的認知！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "……",
    "voice": "vo_adv_5110607_004",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我都忘了。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n這個人也是跟諾維姆同類型的，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "只是所堅持的東西不一樣而已。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "但願後續不會演變成麻煩事。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "喔～呵呵呵呵……",
    "voice": "vo_adv_5110607_005",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "不，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "這樣也不對！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "耶嘿嘿嘿嘿……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "這樣好像",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "有點太沒品了。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n壞蛋的放聲大笑，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "還真難練啊……！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "那是當然，",
    "voice": "vo_adv_5110607_006",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "諾維姆！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "會朝湛藍天空放聲大笑的，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n總是正義的一方啊！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你說什麼～！？",
    "voice": "vo_adv_5110607_007",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你笑一次給我看！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n你能辦到",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "充滿正義感的完美放聲大笑是吧！？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "沒問題，",
    "voice": "vo_adv_5110607_008",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "妳好好看清楚且聽清楚了！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "……啊～",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "啊～",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "咳咳。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "呵呵呵……",
    "voice": "vo_adv_5110607_009",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "哼哼哼……",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "啊──哈哈哈！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n哼哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "如何，",
    "voice": "vo_adv_5110607_010",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "這放聲大笑很出色吧！？",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n我打算總有一天要在主人面前展現成果，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n所以每天都早起練習，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "練成了這獨門絕活！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "好、",
    "voice": "vo_adv_5110607_011",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "好",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "厲害……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "真的好像",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "壞蛋的笑聲！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我太感動了，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "真軌！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "很有當壞蛋的才能呢！？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n竟然可以放聲大笑得這麼邪惡！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "什麼，",
    "voice": "vo_adv_5110607_012",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "妳說我的放聲大笑很邪惡！？",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "尾狗刀，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "你覺得我「正義的」放聲大笑如何！？",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "你不必有所顧忌，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "我想聽聽你最真實的意見！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "你的笑法，感覺就像是會在故事中盤被擊倒，",
    "voice": "vo_adv_5110607_013",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n毫不起眼的中BOSS吧──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "還有，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "你最好別在你那主人面前這樣笑喔。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "咦，",
    "voice": "vo_adv_5110607_014",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "有這麼糟嗎……？",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "再這樣下去，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "我不就沒法保護主人了……！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不，",
    "voice": "vo_adv_5110607_015",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我只是單純在說笑聲的部分。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不管你怎麼笑，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "並不會影響到你的能力強弱吧。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆、真軌",
    "words": "會影響！",
    "voice": "vo_adv_5110607_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諾維姆、真軌",
    "words": "絕對會影響！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "咦……？",
    "voice": "vo_adv_5110607_017",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我說啊，",
    "voice": "vo_adv_5110607_018",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "惡與正義",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "要不要暫時聯手？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "如果無法練成完美的放聲大笑，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n我們倆都會兩敗俱傷！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "我也正想這麼提議！",
    "voice": "vo_adv_5110607_019",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "正義與惡的對決，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "就先暫緩到我們練成放聲大笑之後吧！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "那麼，",
    "voice": "vo_adv_5110607_020",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不管是正義、是惡，還是高笑聲，我都無所謂，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n所以我要先走一步囉……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "尾狗刀，",
    "voice": "vo_adv_5110607_021",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你也太不配合了！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你以為你一個人可以逃得掉嗎！？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "沒錯！",
    "voice": "vo_adv_5110607_022",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "那麼，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "我們一起來努力達成目標吧……",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "練就最棒的放聲大笑！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "拜託你們",
    "voice": "vo_adv_5110607_023",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "饒了我吧……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n這很明顯不是我該扮演的角色啊……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "你會覺得害臊，只有在剛開始的時候而已！",
    "voice": "vo_adv_5110607_024",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n只要在眾人面前多練習幾次，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "就不會覺得那麼害羞了！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "好啦，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "要開始囉……",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "預備──！！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "諾維姆、真軌",
    "words": "哈──哈哈哈哈～！！",
    "voice": "vo_adv_5110607_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "哈──哈哈哈哈……",
    "voice": "vo_adv_5110607_026",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "唉……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "尾狗刀一想到今後都要配合他們進行這項練習，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就不禁嘆息連連。",
    "voice": null,
