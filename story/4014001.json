  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "…………",
    "voice": "vo_adv_4014001_012",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}為拯救不了這位女孩的事在心中道歉，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n並發誓為了這位女孩一定要打倒魔物。",
    "voice": null,
    "unit_id": null
