  {
    "type": "dialogue",
    "name": "旁白",
    "words": "王都‧蘭德索爾。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n有一位少女佇立在熙來攘往的街道旁。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "從遠離蘭德索爾之地──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "佐賀而來，\\n為了成為揚名立萬的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一位偶像。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她的名字是──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "我是櫻！",
    "voice": "vo_adv_4014001_000",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "我在遠離蘭德索爾，",
    "voice": "vo_adv_4014001_001",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "名為佐賀的地方出生，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "享年17歲。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "雖然平常有點沒用，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "有時候會覺得自己是不是很倒霉。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "……但是現在！　",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "我是偶像團體──",
    "voice": "vo_adv_4014001_002",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "法蘭秀秀的一員！",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "雖然因為製作人的指示，",
    "voice": "vo_adv_4014001_003",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "突然要進行",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "個人活動，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "但總會有辦法的！",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "因為以前的我",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "和現在的我已經不一樣了！",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "好──！",
    "voice": "vo_adv_4014001_004",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n在王都的快閃演唱會，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "我一定要成功──！",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "噢呃……！？",
    "voice": "vo_adv_4014001_005",
    "unit_id": 136111
  },
