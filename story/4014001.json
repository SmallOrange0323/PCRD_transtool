    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n哥。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我和普蕾西亞去處理魔物。",
    "voice": "vo_adv_4014001_009",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n就拜託{0}去救那位女孩子了！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "…………",
    "voice": "vo_adv_4014001_010",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "…………",
