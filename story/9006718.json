  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "霸瞳皇帝、",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "以及",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n三名公主騎士陷入沉默。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "首先，",
    "voice": "vo_adv_9006718_001",
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這算是我們的勝利呢……！",
    "voice": null,
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\t各位，",
    "voice": "vo_adv_9006718_002",
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你們沒事吧……？",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "說沒事的話",
    "voice": "vo_adv_9006718_003",
    "unit_id": 133113
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "有些牽強了呢。",
    "voice": null,
    "unit_id": 133113
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n剛才可是一連串",
    "voice": null,
    "unit_id": 133113
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "讓人心臟彷彿都要停止的嚴苛戰鬥……",
    "voice": null,
    "unit_id": 133113
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然則我等，",
    "voice": "vo_adv_9006718_004",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "意氣風發。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "敵方首領，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "幻境龍后的首級，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "我等這就前去取下。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "若一直待在此處，",
    "voice": "vo_adv_9006718_005",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "或許會遭到單方面的攻擊。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還是儘快趕往目的地吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "妨礙我們的人",
    "voice": "vo_adv_9006718_006",
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "已經不在了。",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "小飯糰、",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "小樂、",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n接下來就拜託你們",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "帶我們去幻境龍后那裡囉！",
    "voice": null,
    "unit_id": 139811
