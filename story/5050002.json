  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "{0}，也讓他們見識看看我們的力量吧！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "哇，",
    "voice": "vo_adv_5050002_039",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "好像很好玩！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "也讓我加入吧──！！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "狂野……",
    "voice": "vo_adv_5050002_040",
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "亮晶晶……",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "\\n亮晶晶……",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "狂野……",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "喂──────！！",
    "voice": "vo_adv_5050002_041",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這可是你們的鬼屋耶！！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n你們自己為什麼在那裡胡鬧啦！！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "話說回來，",
    "voice": "vo_adv_5050002_042",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生和茉莉什麼時候也加入他們了啊！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我要生氣囉！！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "艾迪",
