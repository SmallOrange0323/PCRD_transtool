[
  {
    "type": "background",
    "bg_id": "501140"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "穿上紡希手製服裝的一行人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n開始了改造鬼屋的第一步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我本來是打算在幕後幫忙的……",
    "voice": "vo_adv_5050002_000",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我才不會讓那麼浪費的事情發生呢！",
    "voice": "vo_adv_5050002_001",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "幕後有騎士先生就夠了！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就算紡希妳這麼說，",
    "voice": "vo_adv_5050002_002",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "妳一開始不也打算\\n在幕後幫忙嘛。",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那是因為我有待在幕後的經驗啊。",
    "voice": "vo_adv_5050002_003",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "結果因為鬼怪們的要求，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我也變成要上場的人了……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "最重要的鬼怪們去哪了？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊啊，",
    "voice": "vo_adv_5050002_004",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那些孩子們的話，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n應該正在把玩",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "紡希準備的「那些東西」吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "紡希！",
    "voice": "vo_adv_5050002_005",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "謝謝妳也為我們做了服裝！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "比起服裝，應該說是一些小道具啦。",
    "voice": "vo_adv_5050002_006",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "畢竟你們",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "光看外表可是非常完美的。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "好厲害──！",
    "voice": "vo_adv_5050002_007",
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "好帥氣的手杖！",
    "voice": null,
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "真適合本大爺！",
    "voice": null,
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "你在說什麼啊，",
    "voice": "vo_adv_5050002_008",
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "明明是我的武器更帥！",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "好啦好啦，",
    "voice": "vo_adv_5050002_009",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "兩邊都很帥喔。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n你們就看在小道具的份上好好努力吧。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "我、",
    "voice": "vo_adv_5050002_010",
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "我也是，",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "很謝謝妳……",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "不過，",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "我的裝扮，",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "不太合適",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "吧？",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "維多的話就是要可怕點才行呢。",
    "voice": "vo_adv_5050002_011",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "至少先從外表開始，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "所以我準備了狂野風格的道具。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "這、",
    "voice": "vo_adv_5050002_012",
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "而且，",
    "voice": "vo_adv_5050002_013",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "要是覺得不適合的話，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n你該做的就是努力讓它變得適合。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "哇……！！",
    "voice": "vo_adv_5050002_014",
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "我",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "會加油的！",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "紡希真溫柔呢～",
    "voice": "vo_adv_5050002_015",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "完全沒有原本不情願的感覺。",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "既然決定要做我就會認真到底。",
    "voice": "vo_adv_5050002_016",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n所以沒準備好像樣的回報",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我才不會爽快答應要幫忙呢。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個「回報」",
    "voice": "vo_adv_5050002_017",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就只是看我變裝真的好嗎……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就──說──了！",
    "voice": "vo_adv_5050002_018",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "才不是什麼「只是」！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n這是非常重要的事！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "畢竟能讓怜大人穿上我做的衣服嘛！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這、",
    "voice": "vo_adv_5050002_019",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "紡希也能來幫忙，我很高興喔。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n因為我不知道要怎麼讓鬼屋變得更恐怖呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我也是呀。",
    "voice": "vo_adv_5050002_020",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦！？",
    "voice": "vo_adv_5050002_021",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是這樣嗎！？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "為什麼要這麼驚訝？",
    "voice": "vo_adv_5050002_022",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我能給的建議",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那天就全部說出來了。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n說到底，妳覺得裁縫師兼偶像的我能幫鬼屋什麼忙？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "或、",
    "voice": "vo_adv_5050002_023",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "或許是這樣沒錯啦……",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，既然妳答應幫忙，",
    "voice": "vo_adv_5050002_024",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "應該是有點把握吧？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是的！　",
    "voice": "vo_adv_5050002_025",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……我是很想這麼說啦，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但其實沒有呢。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n因為當時想看怜大人變裝的心情勝過了一切。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "紡希……",
    "voice": "vo_adv_5050002_026",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "接招吧！",
    "voice": "vo_adv_5050002_027",
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "本大爺的手杖──",
    "voice": null,
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "攻擊！！",
    "voice": null,
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "笨蛋！",
    "voice": "vo_adv_5050002_028",
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "手杖怎麼可能贏得了長槍嘛！",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "叭咻！！",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "紡希送給我的帽子……",
    "voice": "vo_adv_5050002_029",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "真帥氣──",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "好開心啊──",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "狂、",
    "voice": "vo_adv_5050002_030",
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "狂野的我……",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "\\n",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "咦？",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "狂野……",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "是什麼意思啊……？",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "\\n我身上的鎖鏈",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "亮晶晶的，",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "意思是要我像馬修一樣閃亮嗎？",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "因為，",
    "voice": "vo_adv_5050002_031",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那可是這些孩子們的鬼屋喔？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n妳覺得我能有把握嗎？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這個嘛……",
    "voice": "vo_adv_5050002_032",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳說的或許沒錯啦。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過那些孩子們讓我看見了怜大人如此美妙的一面。",
    "voice": "vo_adv_5050002_033",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我是有打算盡力回應他們的期待喔。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "紡希真了不起呢。",
    "voice": "vo_adv_5050002_034",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也會全力以赴的。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "實在是難以想像怜大人不認真的樣子，",
    "voice": "vo_adv_5050002_035",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "所以我從一開始就不擔心。",
    "voice": null,
    "unit_id": 113911
  },
  {
