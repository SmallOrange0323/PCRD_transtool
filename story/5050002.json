    "voice": "vo_adv_5050002_043",
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "妳明明已經在生氣了！！",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你有說什麼嗎？",
    "voice": "vo_adv_5050002_044",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "什、",
    "voice": "vo_adv_5050002_045",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "什麼也沒說！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "對吧？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "艾迪？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "咦，",
    "voice": "vo_adv_5050002_046",
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "啊，",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "嗯。",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "什麼也沒說。",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我想也是。",
    "voice": "vo_adv_5050002_047",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "與其道歉，還不如一開始就別胡鬧。",
    "voice": "vo_adv_5050002_048",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "因為我們",
    "voice": "vo_adv_5050002_049",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "得到紡希送的禮物太開心了……",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你們能喜歡是很讓人高興啦，",
    "voice": "vo_adv_5050002_050",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但那可不是禮物喔。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n是我認為有需要才準備的小道具。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "所以，",
    "voice": "vo_adv_5050002_051",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "把如此重要的小道具當成玩具玩代表什麼，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n你們應該知道吧……？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "那是什麼意思……？",
    "voice": "vo_adv_5050002_052",
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "不知道……",
    "voice": "vo_adv_5050002_053",
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "是不是要我們好好珍惜，把它們裝飾起來？",
    "voice": "vo_adv_5050002_054",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "哦哦，",
    "voice": "vo_adv_5050002_055",
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "這樣啊──",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "才不是──！",
    "voice": "vo_adv_5050002_056",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "意思是別把生財工具拿來玩啦！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n你們",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是真心想要變可怕嗎？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "當然呀！",
    "voice": "vo_adv_5050002_057",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "難得我們都來幫忙了，",
    "voice": "vo_adv_5050002_058",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n你們要是不認真點我會很困擾的。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "我們一直都很認真喔！",
    "voice": "vo_adv_5050002_059",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你們認真起來是這樣的話，",
    "voice": "vo_adv_5050002_060",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那還真是前途堪憂啊。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就想成他們還有很多成長空間吧。",
    "voice": "vo_adv_5050002_061",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我自己也沒有自信能做好……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怜大人做什麼都沒問題的！",
    "voice": "vo_adv_5050002_062",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我能保證！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "偏心可不好喔。",
    "voice": "vo_adv_5050002_063",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說到底，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我真的有必要扮演鬼怪嗎？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我又不需要吸食悲鳴，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "果然還是去幕後……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "當然有必要！",
    "voice": "vo_adv_5050002_064",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "難道怜大人真的認為",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我是為了看妳的變裝才讓妳穿成這樣嗎？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不是嗎？",
    "voice": "vo_adv_5050002_065",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "當然不是！",
    "voice": "vo_adv_5050002_066",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不對，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "有九成九是這樣沒錯，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但我也是有其他考量的！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "當然是真的！",
    "voice": "vo_adv_5050002_067",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生真是失禮耶！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怜大人，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳相信我吧？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是、",
    "voice": "vo_adv_5050002_068",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我從一開始",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就相信紡希、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "的喔？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怜大人剛剛好像撇開視線了，",
    "voice": "vo_adv_5050002_069",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我就當成是錯覺吧。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "總而言之，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我們也一起變裝",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是考慮到了平衡喔。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "平衡",
    "voice": "vo_adv_5050002_070",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗎？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就算這些孩子們再努力，",
    "voice": "vo_adv_5050002_071",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "以客人的視角來說\\n感受都不會差太多。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "如果想製造比較多樣化的驚訝感，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n出場的角色多一點會比較好，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我是這麼想的。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哦哦！",
    "voice": "vo_adv_5050002_072",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "真不愧是紡希！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我可不是因為想著要如何讓怜大人變裝，",
    "voice": "vo_adv_5050002_073",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n才接著想到這個理由喔。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "妳這句話就破功了……",
    "voice": "vo_adv_5050002_074",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過紡希說的很有道理。",
    "voice": "vo_adv_5050002_075",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我明白了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我會努力扮演好鬼怪。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怜大人都這麼說了，",
    "voice": "vo_adv_5050002_076",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你們再不好好努力",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我可不原諒你們喔！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "知道了！",
    "voice": "vo_adv_5050002_077",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "我們也會努力不輸給怜大人！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊，",
    "voice": "vo_adv_5050002_078",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不用連你們都叫我「大人」……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "一起變可怕吧，",
    "voice": "vo_adv_5050002_079",
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "怜大人！",
    "voice": null,
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不，",
    "voice": "vo_adv_5050002_080",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "都說了……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "唉，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一起加油吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "好啦。",
    "voice": "vo_adv_5050002_081",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "大家都冷靜下來後",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就開始練習吧……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "組長",
    "words": "打擾啦。",
    "voice": "vo_adv_5050002_082",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "哇哇！",
    "voice": "vo_adv_5050002_083",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "馬上就有客人來了！？",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不好意思，",
    "voice": "vo_adv_5050002_084",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "鬼屋正在改裝中，還沒開始營業……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這不是組長嗎。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "啊──！",
    "voice": "vo_adv_5050002_085",
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "是鬼魂教父！",
    "voice": null,
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "鬼魂教父……？",
    "voice": "vo_adv_5050002_086",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n不是組長嗎？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "我說過我負責掌管樂園裡的鬼屋嘛，",
    "voice": "vo_adv_5050002_087",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n而實際上，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "也就掌管著來到樂園裡的鬼怪。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n因此鬼怪們稱呼我為鬼魂教父。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "於是，",
    "voice": "vo_adv_5050002_088",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "我聽說這群蠢貨暴露了自己的身分，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n才來這裡看看情況……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "對、",
    "voice": "vo_adv_5050002_089",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "對不起……",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "錯都錯了，再追究也無濟於事。",
    "voice": "vo_adv_5050002_090",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "不過，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "他們說的那些事希望你們能夠保密。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n畢竟以人類的悲鳴為食，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "就算對人無害，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "說出去還是難免會讓人恐懼。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "鬼怪真的存在這種事就算說出去也不會有人信，",
    "voice": "vo_adv_5050002_091",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我們也不會特意去大肆宣傳啦。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "這倒也是。",
    "voice": "vo_adv_5050002_092",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "不過，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "這些廢柴鬼怪的鬼屋",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n一次也沒有傳出過悲鳴就是了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "真是的，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "明明我鬼屋裡的那些鬼怪每年都有在成長。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "為什麼不讓這些孩子們去你的鬼屋工作呢？",
    "voice": "vo_adv_5050002_093",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n那樣的話，他們就能很快成長了不是嘛。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "那、",
    "voice": "vo_adv_5050002_094",
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "那是因為我們……",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "因為他們是鬼怪界的吊車尾啊。",
    "voice": "vo_adv_5050002_095",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n他們可沒有別的容身之處。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "就連這裡也是基於同情才讓給他們的。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我從剛才就很在意了，",
    "voice": "vo_adv_5050002_096",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你也是鬼怪……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗎？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n看起來像是普通人呢……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "因為鬼魂教父是很厲害的鬼怪，",
    "voice": "vo_adv_5050002_097",
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "他能夠變換外貌喔！",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "\\n他真正的模樣",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "可是非常恐怖的！",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "喂，",
    "voice": "vo_adv_5050002_098",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "光暴露自己的身分還不夠，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n連我的事都要口無遮攔嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不，",
    "voice": "vo_adv_5050002_099",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是我過問太多了，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "這不是小妹妹妳的錯啦。",
    "voice": "vo_adv_5050002_100",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "妳會好奇是正常的。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "以這個模樣",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "在現世進行各種活動時都很方便。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n而且要在這裡開設鬼屋",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "也需要通過正規手續。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "還有",
    "voice": "vo_adv_5050002_101",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "通過正規手續啊……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真意外。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "哈哈哈！",
    "voice": "vo_adv_5050002_102",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "我們可是通通都腳踏實地的來啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "然後，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "終於連這次遊行都交由我們包辦了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "鬼屋會協助舉辦遊行也就是說……",
    "voice": "vo_adv_5050002_103",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n這些孩子們也會參加嗎？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "遊行？",
    "voice": "vo_adv_5050002_104",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "我們",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "什麼都沒聽說喔？",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "像他們這樣的吊車尾才沒資格參加啦。",
    "voice": "vo_adv_5050002_105",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n畢竟不知道他們會惹出什麼亂子啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "怎麼這樣……",
    "voice": "vo_adv_5050002_106",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你從剛剛開始就滿口廢柴、吊車尾之類的，",
    "voice": "vo_adv_5050002_107",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n這些孩子們",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是由你負責照顧的吧？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n照這樣說來，你也有責任不是嗎？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "不、",
    "voice": "vo_adv_5050002_108",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "不能對鬼魂教父說這種話啦，紡希！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n他生氣起來超級恐怖的！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "而且，",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "說我們是吊車尾",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "也是事實啊……",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不管你們是吊車尾還是什麼，",
    "voice": "vo_adv_5050002_109",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n負責照顧你們的人都不該說出那種話吧。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "啊？",
    "voice": "vo_adv_5050002_110",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "鬼、",
    "voice": "vo_adv_5050002_111",
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "鬼魂教父！",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "\\n紡希不了解你的可怕之處！",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "就原諒她吧！",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "不，",
    "voice": "vo_adv_5050002_112",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "這位小妹妹說的很有道理。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n是我不對。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "而且，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "這下我也明白小妹妹妳是值得信賴的人。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n這些傢伙",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "就交給妳了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "把他們培養成像樣的鬼怪吧。",
    "voice": "vo_adv_5050002_113",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "說了些冠冕堂皇的話就把問題全拋過來很讓人困擾呢。",
    "voice": "vo_adv_5050002_114",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你乾脆自己來指導他們吧。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "紡希！？",
    "voice": "vo_adv_5050002_115",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "開玩笑的。",
    "voice": "vo_adv_5050002_116",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我一旦答應下來了，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就會對他們負責到底。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我會讓他們成為能獨當一面的鬼怪，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "而且是",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "能在遊行上大放異彩的那種喔。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "哦哦，",
    "voice": "vo_adv_5050002_117",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "真是令人欽佩的小妹妹。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "那麼這樣好了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n需要我提供",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "可能對他們的成長有所幫助的工作嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "什麼？",
    "voice": "vo_adv_5050002_118",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "有那種工作的話，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你倒是一開始就該給他們嘛。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n該不會",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "其實連你也是廢柴吧？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "哈哈哈！",
    "voice": "vo_adv_5050002_119",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "真敢說呢，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "小妹妹。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "雖說如此，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "這些工作只有真正的鬼怪才能勝任。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "有小姑娘妳們在的話，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "應該不成問題吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "不過，",
    "voice": "vo_adv_5050002_120",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "這些工作的報酬都歸我喔。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n要維持鬼怪們在這裡的開銷",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "也是要花上不少錢的。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "所謂的公平交換嘛。",
    "voice": "vo_adv_5050002_121",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "沒有問題。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那麼，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是什麼樣的工作？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "這裡有份清單。",
    "voice": "vo_adv_5050002_122",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n每項……嗯，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "視情況應該都多少有點幫助，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n就交給小姑娘妳來選吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "唔，我看看……",
    "voice": "vo_adv_5050002_123",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n嗯～",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "確實都是些能當成練習的好工作呢。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "必須分成兩組來完成這點雖然有些麻煩……",
    "voice": "vo_adv_5050002_124",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但這兩項工作好像都挺不錯的呢。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "紡希為鬼怪們選擇的工作是……",
    "voice": null,
    "unit_id": null
  }
