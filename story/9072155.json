    "voice": "vo_adv_9072155_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呀！？",
    "voice": "vo_adv_9072155_012",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "痛……",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦，",
