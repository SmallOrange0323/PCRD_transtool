[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "咦！？",
    "voice": "vo_adv_9500038_000",
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你剛、",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "剛剛是說，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你覺得我最好嗎！？",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n你說我是",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "最棒的",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "搭檔……？",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "什麼──！",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你為什麼會這樣想……",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……最棒的",
    "voice": "vo_adv_9500038_001",
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "笑容？",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "確實是這樣呢！",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我現在",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "露出了至今最燦爛的笑容！",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "而且，",
    "voice": "vo_adv_9500038_002",
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥也是啊，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "露出了很棒的笑容呢！",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n哈哈哈！",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不愧是我的搭檔！",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n明明不是在搞笑，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我們兩個卻都笑了起來。",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "其實，",
    "voice": "vo_adv_9500038_003",
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我跟老哥的心情",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "一～模一樣喔。",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥是最棒的！",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嘿嘿……",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然就這樣說出口了……",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但能把心意告訴老哥，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真的好開心啊。",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "欸，",
    "voice": "vo_adv_9500038_004",
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你還記得嗎？",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我因為國王的話大受打擊，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "笑不出來的那時候。",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n只有老哥",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "還會因為我的笑話而笑呢。",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "多虧了老哥，我才能重拾自信，",
    "voice": "vo_adv_9500038_005",
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "重新當回搞笑藝人。",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……老哥那時候的笑容，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n對我來說，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就像是",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "天賜的恩惠。",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不僅如此，",
    "voice": "vo_adv_9500038_006",
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我煩惱的時候也好，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "寂寞的時候也罷，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n老哥最後一定都會",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "讓我露出笑容。",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然身為搞笑藝人，難免會嫉妒你的才能，",
    "voice": "vo_adv_9500038_007",
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "過，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我感到更多的是開心。",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……很開心",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "終於遇到了",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "「只屬於我的搭檔」。",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "有下雨的日子，",
    "voice": "vo_adv_9500038_008",
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "也有刮風的日子，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "人生或許就是充滿波折。",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "只要我們能一起笑著，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "將一切變成哏……",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n就這樣一直講著夫妻相聲，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我就很幸福了♪",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……總之，",
    "voice": "vo_adv_9500038_009",
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "結尾就像老哥說的那樣啦！",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我們兩個到最後，",
    "voice": null,
    "unit_id": 103341
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "都會露出最棒的笑容♪",
    "voice": null,
    "unit_id": 103341
  }
]
