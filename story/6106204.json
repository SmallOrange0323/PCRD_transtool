[
  {
    "type": "background",
    "bg_id": "510360"
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "カフェ店員、",
    "voice": "vo_adv_6106204_000",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "義賊、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "財団のお仕事……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "忙しくて目が回りそうだにゃ。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n猫の手も借りたいのに、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "猫のあたしが大忙しってどういうことにゃ！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "んにゃにゃ……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "もうすこし楽に仕事できないものかにゃあ……？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "！　",
    "voice": "vo_adv_6106204_001",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "その手があったかにゃ！　",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "確かにカフェで一休みしてるときは\\nみんな気が緩んでるから、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "情報収集には好都合だにゃ！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "……って、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "結局仕事しちゃってるじゃないかにゃ！　",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "謀られたにゃ！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "あ、",
    "voice": "vo_adv_6106204_002",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "ありがとにゃ……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "はにゃ～、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "この一杯が染みるにゃ～……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nたっぷりミルクも、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "あたし好みで……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "むふ、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "キミのコーヒーのおかげで",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nなんだか元気が湧いてきたにゃ。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "もうひとがんばりしてやるにゃ！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "くっ、",
    "voice": "vo_adv_6106204_003",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "それは猫派のプライドが傷つくのにゃ……！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nでも……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "ぐぬぬ、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "背に腹は代えられないにゃ。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "この場は一時休戦、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "今からひとっ走り行って助っ人を呼んでくるのにゃ！",
    "voice": null,
    "unit_id": 107911
  }
]
