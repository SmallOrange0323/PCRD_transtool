    "words": "變得討厭我……！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "欸嘿嘿……♪",
    "voice": "vo_adv_1227003_114",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "鏡華一邊喜極而泣，一邊和班上的同學一起歡笑。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n那無憂無慮的笑容，既天真又閃閃發亮。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "…………",
    "voice": "vo_adv_1227003_115",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "聽好了，",
    "voice": "vo_adv_1227003_116",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請在那邊看著喔。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n不可以幫忙喔。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "總覺得如果是現在，",
    "voice": "vo_adv_1227003_117",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就算沒有你的力量，",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我也能夠使出魔法。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "要是成功了，",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我就不會再被你當成小孩了吧！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我要上囉……！",
    "voice": "vo_adv_1227003_118",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "夏日水藍──",
    "voice": "vo_adv_1227003_119",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "凝結！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呀啊啊啊！？",
    "voice": "vo_adv_1227003_120",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊啊，",
    "voice": "vo_adv_1227003_121",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "又……",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "失敗了～",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_1227003_122",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "全身",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "都濕透了……",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但是，",
    "voice": "vo_adv_1227003_123",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我已經不會再沮喪了喔。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "因為",
    "voice": "vo_adv_1227003_124",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這就是現在的我♪",
    "voice": null,
    "unit_id": 122711
  }
