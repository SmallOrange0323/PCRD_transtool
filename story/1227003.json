  {
    "type": "dialogue",
    "name": "旁白",
    "words": "夏令營原本如火如荼地進行著，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但鏡華被班上的同學們",
    "voice": null,
    "unit_id": null
  },
