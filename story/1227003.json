    "voice": "vo_adv_1227003_006",
    "unit_id": 5412
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "集合的時間差不多到囉……？",
    "voice": "vo_adv_1227003_007",
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "唔……",
    "voice": "vo_adv_1227003_008",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "對、",
    "voice": "vo_adv_1227003_009",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "對不起……",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我",
    "voice": "vo_adv_1227003_010",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不配當隊長……！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "啊，",
    "voice": "vo_adv_1227003_011",
    "unit_id": 5412
  },
  {
    "type": "dialogue",
    "name": "女子",
