    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n向{0}求救的時候。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我在欺騙大家的事……",
    "voice": "vo_adv_1227003_002",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "被發現了……",
    "voice": null,
    "unit_id": 122711
  },
