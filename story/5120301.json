[
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": "vo_adv_5120301_000",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哈哈哈！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我正是「統御美麗之人」，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "今晚也臣服在我的美麗之下吧！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……妳突然在說些什麼？",
    "voice": "vo_adv_5120301_001",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "討厭，",
    "voice": "vo_adv_5120301_002",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳也太遲鈍了。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我只是在配合伊莉亞妳啊。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "剛才的是在配合妾身嗎！？",
    "voice": "vo_adv_5120301_003",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……在即將要與對方一戰之際，也太沒緊張感了。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妳就沒有害怕的東西嗎？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有啊，",
    "voice": "vo_adv_5120301_004",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那當然是──",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳自身的美麗對吧？",
    "voice": "vo_adv_5120301_005",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……來，",
    "voice": "vo_adv_5120301_006",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "開戰吧。",
    "voice": null,
    "unit_id": 126311
  }
]
