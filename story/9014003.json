[
  {
    "type": "background",
    "bg_id": "502460"
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "明明是千載難逢的機會，",
    "voice": "vo_adv_9014003_000",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "卻沒能討伐幻境龍后，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n實在遺憾……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "但也不能總是",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "垂頭喪氣，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n畢竟決戰時刻",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "是不等人的。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "老實說，",
    "voice": "vo_adv_9014003_001",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "真的很不妙。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "阿爾莎特跟霸瞳皇帝都強過頭，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "還以為會沒命呢。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不過，其實是真死了啦。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "黎薩就是跟",
    "voice": "vo_adv_9014003_002",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "那麼可怕的人們在一起啊……",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "她是不是",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "有被排擠啊？",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "有好好",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "吃飯嗎……？",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "喂喂。",
    "voice": "vo_adv_9014003_003",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n別擔心敵方成員啦。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "即便要跟黎薩戰鬥，",
    "voice": "vo_adv_9014003_004",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "璐璐伊也別大意啊。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "對，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "就把對方當作",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "是殺父仇人，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n或是搶走晚餐菜餚的可恨存在吧。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "好、",
    "voice": "vo_adv_9014003_005",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "好的……！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "可、",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "可惡～！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "可恨的黎薩姐接～～！！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "……嗚嗚，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "好困難……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "即使腦袋理解，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n卻無論如何都恨不了黎薩姐接……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "別說這種刁難人的話啦，",
    "voice": "vo_adv_9014003_006",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "格蕾斯。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n雖然很在意黎薩……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "但也不能太過在意她。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n現在就先為決戰做準備，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "並張羅些吉利的食物吧。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "啊，既然如此，",
    "voice": "vo_adv_9014003_007",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶剛好看到",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "有適合的東西流過。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n雪野姐接也有看見吧？",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "嗯、",
    "voice": "vo_adv_9014003_008",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "嗯……",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "有很大的闇勝魚",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "游過。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "而且我聽說勝魚的",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "「勝」跟「勝利」",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "相通……",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "小公主，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "妳、",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "妳覺得呢？",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "除了武運昌隆，",
    "voice": "vo_adv_9014003_009",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "勝魚也是",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "祈求長壽跟子孫繁榮的吉祥物。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n如果是其中特別吉利的",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "「初勝魚」，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n對即將要面對強大敵人的我們而言，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "可說是很適合的食物。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "那",
    "voice": "vo_adv_9014003_010",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就去捕勝魚吧。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "雪野，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "來幫忙。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "是要把牠",
    "voice": "vo_adv_9014003_011",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "凍起來，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "對吧？",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "嗯",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "交給我吧，剎鬼……！",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶就",
    "voice": "vo_adv_9014003_012",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "跟公主姐接等人一起準備烹飪！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "等著剎鬼姐接",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "和雪野姐接",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n帶勝魚回來！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "看來能活用為了蘭德索爾國際博覽會而實際烹飪的經驗呢。",
    "voice": "vo_adv_9014003_013",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……這次一定要小心，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "別在烹飪途中失敗。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "端出菫手腕的活體生肉片",
    "voice": "vo_adv_9014003_014",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "來搞笑……",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這點子不錯。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "一點都不好！",
    "voice": "vo_adv_9014003_015",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "受不了，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "連這種時間都只會開玩笑……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……各位，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我們雖然正走在困難的道路上，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n但我相信若是我們，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "一定能夠跨越難關。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "畢竟命運",
    "voice": "vo_adv_9014003_016",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "當然要親手開拓。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n我們就各自拚盡全力，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n用這隻手抓住",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "大家能平穩度日的每一天吧。",
    "voice": null,
    "unit_id": 133111
  }
]
