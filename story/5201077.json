  {
    "type": "dialogue",
    "name": "似似花",
    "words": "嗯……",
    "voice": "vo_adv_5201077_000",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "防護措施依然有漏洞。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "得想辦法解決才行……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這裡也是。",
    "voice": "vo_adv_5201077_001",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這樣的話就能從外部存取角色的外觀了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "會有不少人想使用",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "個人製作的資料呢……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "似似花，",
    "voice": "vo_adv_5201077_002",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "辛苦了～",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "什麼？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "又在檢查防護措施嗎？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n妳都會像例行公事一樣找出安全漏洞呢～",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "當然了。",
    "voice": "vo_adv_5201077_003",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n攻擊漏洞的方法",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "可是要多少有多少。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不不不，",
    "voice": "vo_adv_5201077_004",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "像似似花這種實力的攻擊方式一般人很難辦到吧。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "嚴格一點是當然的，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "但也不要拼命過頭了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "來，",
    "voice": "vo_adv_5201077_005",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "拿去，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "這是慰勞品。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……？",
    "voice": "vo_adv_5201077_006",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這是……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "蛋糕。",
    "voice": "vo_adv_5201077_007",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這個",
    "voice": "vo_adv_5201077_008",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "要給我？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "對啊？",
    "voice": "vo_adv_5201077_009",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我也拿去給克莉絲他們～",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "慰勞品，",
    "voice": "vo_adv_5201077_010",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我從來沒有想過這種事呢。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "還是一樣不知道她在想些什麼……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但是──",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "──狂真咲先生。",
    "voice": "vo_adv_5201077_011",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "是，",
    "voice": "vo_adv_5201077_012",
    "unit_id": 191031
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "您找我嗎？",
    "voice": null,
    "unit_id": 191031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我分你一口蛋糕吧。",
    "voice": "vo_adv_5201077_013",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "不會吧……",
    "voice": "vo_adv_5201077_014",
    "unit_id": 191031
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "您竟然願意分給我，",
    "voice": null,
    "unit_id": 191031
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "真是榮幸至極。",
    "voice": null,
    "unit_id": 191031
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n那我就不客氣了……",
    "voice": null,
    "unit_id": 191031
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "啊呣……",
    "voice": null,
    "unit_id": 191031
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "哦，",
    "voice": null,
    "unit_id": 191031
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "真是好吃……",
    "voice": null,
    "unit_id": 191031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "好吃嗎？",
    "voice": "vo_adv_5201077_015",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "是的。",
    "voice": "vo_adv_5201077_016",
    "unit_id": 191031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "身體有什麼變化嗎？",
    "voice": "vo_adv_5201077_017",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "沒有……",
    "voice": "vo_adv_5201077_018",
    "unit_id": 191031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "…………",
    "voice": "vo_adv_5201077_019",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "原來如此，",
    "voice": "vo_adv_5201077_020",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "沒有下毒啊。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "……難不成這是",
    "voice": "vo_adv_5201077_021",
    "unit_id": 191031
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "在讓我試毒？",
    "voice": null,
    "unit_id": 191031
  }
]
