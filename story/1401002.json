    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嗚哇啊～～！",
    "voice": "vo_adv_1401002_005",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "倭姊～～～！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n聽我說啦～～！！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "「……啊？",
