    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "怎麼了布武機。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我才剛拿到美味的葡萄酒呢。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……所以，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "發生什麼事了？」",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "區區",
    "voice": "vo_adv_1401002_007",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "雜碎哥哥，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n竟然有一堆女粉絲！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n為什麼我不是第一！？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "區區雜碎哥哥～！",
