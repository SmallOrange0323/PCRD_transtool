    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "好累～♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n當作是休息，",
