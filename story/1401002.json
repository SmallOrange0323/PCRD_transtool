    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嗯！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "「他的視線被其他女生搶走的話，",
    "voice": "vo_adv_1401002_013",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n妳就連同那傢伙的心一起搶過來，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n讓他完完全全成為妳的人。」",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "……嘻嘻，",
    "voice": "vo_adv_1401002_014",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嘻嘻嘻嘻♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "說得也是，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
