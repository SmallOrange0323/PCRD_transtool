    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "想要的東西就算在哭泣的小孩手上也要搶過來，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n這就是我們【蠻賊三姊妹】。」",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "「不管對方是誰，",
    "voice": "vo_adv_1401002_011",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n想要的話就全力從對方手上搶過來，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n這就是我們的作風──",
    "voice": null,
    "unit_id": 130012
  },
