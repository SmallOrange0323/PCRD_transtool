[
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "窣窣窣……",
    "voice": "vo_adv_1060004_000",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊～真美味♪",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "放入藥草的粥，",
    "voice": "vo_adv_1060004_001",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n流進了疲憊的腸胃裡啦～……♪",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你也點你喜歡吃的東西啊。",
    "voice": "vo_adv_1060004_002",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這裡的料理可是對腸胃很溫和的喔，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n而且還無敵美味！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你有跟大家一起來吃過，",
    "voice": "vo_adv_1060004_003",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n所以應該知道吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯，",
    "voice": "vo_adv_1060004_004",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那次吃完後就深得我心呢，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我很常來這裡吃喔。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "特別是早餐很常來這裡吃呢。",
    "voice": "vo_adv_1060004_005",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這家店離我工作的地方……離王宮也很近呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我可跟和平大眾家庭裡的少爺、大小姐不同，",
    "voice": "vo_adv_1060004_006",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n沒有會煮三餐給我吃的父母呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我必須要自己想辦法弄到食物，",
    "voice": "vo_adv_1060004_007",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不然會餓死",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以囉……",
    "voice": "vo_adv_1060004_008",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說真的，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n能跟你們一起吃遍天下，可說是幫大忙啦！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也因此知道了許多",
    "voice": "vo_adv_1060004_009",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n便宜又好吃的店呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說真的，不只是晚餐而已，",
    "voice": "vo_adv_1060004_010",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n早中晚任何時候我都想要一起吃遍天下呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我想跟其他人一起熱鬧地吃吃喝喝啊。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯，不過你們也有自己的生活……",
    "voice": "vo_adv_1060004_011",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n每一次都要讓你們陪我也很不好意思呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我可沒有像那樣",
    "voice": "vo_adv_1060004_012",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "跟你們打成一片、當好朋友的權利呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊哈哈。",
    "voice": "vo_adv_1060004_013",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n抱歉。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這種事情就算跟你說，也沒用呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過呢……",
    "voice": "vo_adv_1060004_014",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我忘了是什麼時候，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n可蘿仔有說過『吃就是為了活著』呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "飲食生活如果充實的話，",
    "voice": "vo_adv_1060004_015",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就會有好～幸福的感覺。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不知怎麼，",
    "voice": "vo_adv_1060004_016",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n最近我的心情非常好呢……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都是多虧了你們。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如果能像這樣",
    "voice": "vo_adv_1060004_017",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "每天都能持續下去就好啦。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哇……！？",
    "voice": "vo_adv_1060004_018",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喂，你？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你好像在發光喔，怎麼這麼突然？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "（這是什麼？",
    "voice": "vo_adv_1060004_019",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n『陛下』也從來都沒提過這種事……！？）",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "background",
    "bg_id": "510352"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊～可惡！",
    "voice": "vo_adv_1060004_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n真糟糕！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我的錢包不曉得掉在哪了，",
    "voice": "vo_adv_1060004_021",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不對，還是被扒手摸走了……！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "怎～麼辦……",
    "voice": "vo_adv_1060004_022",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我家離這個車站很遠呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不搭電車用走的話，",
    "voice": "vo_adv_1060004_023",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "何止是太陽下山，根本就要走到天亮啦。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "補習完太晚回到家的話，",
    "voice": "vo_adv_1060004_024",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n又會被罵……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "如果我不聽",
    "voice": "vo_adv_1060004_025",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我家老媽的話，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n她就會擅自認為 『我是不是在哪裡做壞事啊？』",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "因為這樣，",
    "voice": "vo_adv_1060004_026",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n害我打工不知道被開除幾次了……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n好不容易才好像能交到好朋友的說……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊～煩死了！",
    "voice": "vo_adv_1060004_027",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n那傢伙，死不了嗎！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我在這裡亂生氣也不是辦法啊。",
    "voice": "vo_adv_1060004_028",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n總之得想辦法籌到電車費……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "還是我先去打工的店，",
    "voice": "vo_adv_1060004_029",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "預支點薪水好了？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "可是打工的地方，不管哪個都是在家附近……",
    "voice": "vo_adv_1060004_030",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "但是老媽竟然說什麼『風水上很吉利』，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n就只有補習班選在離家這麼遠的車站前。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "什麼風水啊，",
    "voice": "vo_adv_1060004_031",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n她是笨蛋嗎！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊～真是不幸……",
    "voice": "vo_adv_1060004_032",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "全部都是老媽害的……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我想離家出走啊～",
    "voice": "vo_adv_1060004_033",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我就這樣不再回家，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n去哪個遙遠的城鎮住吧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不行，我必須要忍耐。",
    "voice": "vo_adv_1060004_034",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "至少我也要大學畢業，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n現在就業之類的好像很嚴苛呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我就忍耐到那時，",
    "voice": "vo_adv_1060004_035",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n然後獲得一份好工作……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "之後我再找個好男人，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "過上幸福的生活。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "然後再跟老媽說",
    "voice": "vo_adv_1060004_036",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n『我會幸福絕對不是托妳的福！』……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那就是我的報仇！",
    "voice": "vo_adv_1060004_037",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊～真是討厭的人生啊。",
    "voice": "vo_adv_1060004_038",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n為什麼都只有我這樣……？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……嗯？",
    "voice": "vo_adv_1060004_039",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n幹嘛啊，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你在看哪裡啊？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "看什麼看啊，",
    "voice": "vo_adv_1060004_040",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n宰了你喔！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊？",
    "voice": "vo_adv_1060004_041",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n什麼怎麼了嗎，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "跟你有關係嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "沒有吧？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "雖然我不知道你是要搭訕還是要推銷兜售，",
    "voice": "vo_adv_1060004_042",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n反正去找別人啊，笨蛋～！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嗄？",
    "voice": "vo_adv_1060004_043",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不要在那給我裝傻喔！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "幹嘛啊？",
    "voice": "vo_adv_1060004_044",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n你是想跟我吵架嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n快滾啦，礙眼死了，我真的宰了你喔！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嗯嗯？什麼？",
    "voice": "vo_adv_1060004_045",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我聽不到啊，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "講清楚一點？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嗄？",
    "voice": "vo_adv_1060004_046",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n你說……如果可以的話，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n你要借我電車費？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你說因為我在大叫，",
    "voice": "vo_adv_1060004_047",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n所以擔心起我來了？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不要管我！",
    "voice": "vo_adv_1060004_048",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n管什麼閒事啊，笨蛋～！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "對悲慘的女國中生溫柔，",
    "voice": "vo_adv_1060004_049",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你是想要沈浸於自我滿足之中嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "但是很可惜，",
    "voice": "vo_adv_1060004_050",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我才不相信別人的溫柔！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不管是什麼阿貓阿狗都裝作一副好人樣，",
    "voice": "vo_adv_1060004_051",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n用高姿態瞧不起別人！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不要把別人當笨蛋啊！",
    "voice": "vo_adv_1060004_052",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n只要大家大家大家……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "死了最好！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "哇呀？",
    "voice": "vo_adv_1060004_053",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n什、什麼？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "喂，你剛拿什麼東西丟我了吧……？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "來啊！",
    "voice": "vo_adv_1060004_054",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n要吵架的話，我奉陪到底啊！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我可是在巷弄裡長大的品性惡劣壞小孩喔，",
    "voice": "vo_adv_1060004_055",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n暴力事件什麼的我熟得很喔！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊，喂！\\n不要逃跑啊！",
    "voice": "vo_adv_1060004_056",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你給我回來，我要宰了你……！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "哼……",
    "voice": "vo_adv_1060004_057",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "真是的，噁心。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n那傢伙到底要幹嘛啊？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "從他身上的制服來看，",
    "voice": "vo_adv_1060004_058",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n像是這附近高中的傢伙呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我已經記住那傢伙的臉了。",
    "voice": "vo_adv_1060004_059",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "下次再讓我碰到的話，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我就要馬上用指甲抓他兩下。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嗯……？",
    "voice": "vo_adv_1060004_060",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n那傢伙丟過來的到底是什麼？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "仔細一看，竟然是錢包？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊，有留言在裡面。",
    "voice": "vo_adv_1060004_061",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這麼說的話，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n剛剛那傢伙好像邊跑邊寫了什麼呢……？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嗯。",
    "voice": "vo_adv_1060004_062",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "上面寫著『請當作電車費使用』嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嗄……？",
    "voice": "vo_adv_1060004_063",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "什麼啊……？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這樣子，",
    "voice": "vo_adv_1060004_064",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n不就跟勒索沒兩樣嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不過確實，",
    "voice": "vo_adv_1060004_065",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n有了這個的話我就能像平常一樣搭電車回家了……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n真是幫了大忙呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……啊、裡面有學生手冊。",
    "voice": "vo_adv_1060004_066",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "哼，那傢伙叫這個名字啊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "上面也有寫住址呢。",
    "voice": "vo_adv_1060004_067",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "總之我就先只借用電車費，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n之後再把錢還回去這個住址就好了吧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "只借不還的話，\\n",
    "voice": "vo_adv_1060004_068",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "會讓人覺得不舒服呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "哼……",
    "voice": "vo_adv_1060004_069",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n總之就先謝謝你啦！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真恐怖……",
    "voice": "vo_adv_1060004_070",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n凱留，品性非常不好呢？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我光看著就覺得害怕啦，",
    "voice": "vo_adv_1060004_071",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n她的行為舉止完全就是個不良少女嘛！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "到底是在怎樣的環境下長大，",
    "voice": "vo_adv_1060004_072",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n才會讓女國中生有那樣的言行舉止出現呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "總覺得，",
    "voice": "vo_adv_1060004_073",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n有點在意呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……哎呀。",
    "voice": "vo_adv_1060004_074",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n抱歉抱歉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不先稍微說明一下的話，你會很困惑呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛剛看見的，是如同夢境一般的情景唷。",
    "voice": "vo_adv_1060004_075",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n反正你醒來以後很快就會忘記的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以沒關係，現在不用太在意哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你在『那邊』的時候，",
    "voice": "vo_adv_1060004_076",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n好像跟凱留幾乎沒有什麼交流呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "實際上，",
    "voice": "vo_adv_1060004_077",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你能回想出的回憶可說是幾乎沒有呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "再稍微讓我",
    "voice": "vo_adv_1060004_078",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n補充說明一下……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這件事發生過後幾天……",
    "voice": "vo_adv_1060004_079",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你會再次",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n跟來還錢包跟電車費的凱留見面喔！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "然後，你們會發現",
    "voice": "vo_adv_1060004_080",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n其實你們已經在阿斯特朗……遊戲上碰過面，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "而互相嚇了一跳！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也就是，",
    "voice": "vo_adv_1060004_081",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n有你常經歷到的慣例上的那個喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "只是，在那之後你們也幾乎沒有什麼交集……",
    "voice": "vo_adv_1060004_082",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n直到最後都沒有",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你跟凱留感情變好的發展喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "畢竟你們的生活圈\\n好像幾乎沒有重疊呢。",
    "voice": "vo_adv_1060004_083",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "凱留也似乎因為家庭因素，",
    "voice": "vo_adv_1060004_084",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不太能登入阿斯特朗。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "正因為如此，",
    "voice": "vo_adv_1060004_085",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你現在能跟凱留相遇，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n還一直有互動交流，是非常不可思議的……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我覺得是誰",
    "voice": "vo_adv_1060004_086",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n存著什麼樣的意圖。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "算了，現在想那種事也沒用。",
    "voice": "vo_adv_1060004_087",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n搞不好單純是巧合呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，",
    "voice": "vo_adv_1060004_088",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n既然說這麼多廢話也沒用，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這次就先到這裡失陪囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "掰掰～",
    "voice": "vo_adv_1060004_089",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n下次見囉♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "{0}？",
    "voice": "vo_adv_1060004_090",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還好嗎……？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你身體不舒服嗎？",
    "voice": "vo_adv_1060004_091",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n感冒了嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "依照症狀不同，我的恢復魔法搞不好會有效……？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我還蠻擅長魔法的呢。",
    "voice": "vo_adv_1060004_092",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我經過了重重學習與修行，所以會各式各樣的魔法喔♪",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯？",
    "voice": "vo_adv_1060004_093",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你幹嘛啊，一直盯著我看……？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我的臉上有什麼東西嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼啊，真是的，",
    "voice": "vo_adv_1060004_094",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n奇怪的傢伙……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "比起那個，餐點會冷掉喔，",
    "voice": "vo_adv_1060004_095",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n趕快把它吃完吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我從下午開始也要工作，",
    "voice": "vo_adv_1060004_096",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n跟閒閒沒事做的你不同呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如果你沒有要再加點的話，",
    "voice": "vo_adv_1060004_097",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就先去結帳吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯？",
    "voice": "vo_adv_1060004_098",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你忘記帶錢包了？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是糊塗呢～……？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒關係啦。",
    "voice": "vo_adv_1060004_099",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n反正我們今晚",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n也要跟大家一起吃飯嘛。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "到時你再幫我付錢就好啦，",
    "voice": "vo_adv_1060004_100",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這裡我就先幫你墊。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯嗯？",
    "voice": "vo_adv_1060004_101",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n幹嘛啊？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你不要一副很意外的表情啊，真沒禮貌呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我，",
    "voice": "vo_adv_1060004_102",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n看起來有那麼像是貪財的人嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦，你到底怎麼啦……",
    "voice": "vo_adv_1060004_103",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你幹嘛那麼害怕，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還道歉了好幾次。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我又沒有在生氣～",
    "voice": "vo_adv_1060004_104",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我的臉有這麼恐怖嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊哈哈。",
    "voice": "vo_adv_1060004_105",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你今天真的有點怪怪的喔……♪",
    "voice": null,
    "unit_id": 106012
  }
]
