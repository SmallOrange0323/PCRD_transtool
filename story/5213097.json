[
  {
    "type": "background",
    "bg_id": "502791"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這傢伙，",
    "voice": "vo_adv_5213097_000",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是布丁喲！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是真的有甜味又很好吃的",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "布丁喲！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "明明外表完全不一樣，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "卻是布丁來的……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "而且還Q彈得不得了喲！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "因為太Q彈了，",
    "voice": "vo_adv_5213097_001",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "連宮子的衣服都……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "咦？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n……該不會，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是搞錯了？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可是宮子明明有感覺到，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "衣服整個彈開了喲。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嚇了一跳來的……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "是吃下去之後，",
    "voice": "vo_adv_5213097_002",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "身體發生了什麼異狀嗎……？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n材料",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "都是在蘭德索爾採買的，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "而且先前請格蕾斯試吃的時候，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "應該也沒有什麼特別的變化才對……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不，",
    "voice": "vo_adv_5213097_003",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "那就是我不夠周到的關係呢。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n沒能回應公主的期待，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n只能感嘆自己愚鈍，竟錯過了該裝傻的時機。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "唉呀呀。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "格蕾斯，",
    "voice": "vo_adv_5213097_004",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "妳也在嗎！？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "不過那時候，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我可沒有期待妳在那方面裝傻就是了……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不",
    "voice": "vo_adv_5213097_005",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不不，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "公主。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "只要擁有超一流的亡靈力，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n被布丁的衝擊，震得衣服彈開個一兩件，根本是理所當然的事。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "對吧，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "宮子前輩？",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "真不愧是妳，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "令人敬佩。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯嗯～？",
    "voice": "vo_adv_5213097_006",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……就是這樣，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子可是很厲害的！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "所以妳也應該",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好好尊敬宮子前輩才對！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "要表現尊敬的話，再來一份布丁就可以了喲！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "要做很多布丁來的！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我、",
    "voice": "vo_adv_5213097_007",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我明白了，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "前輩小姐……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我這就再去",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "準備一份。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "宮子完全順著自己的布丁慾，不斷要求續碗，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n結果材料轉眼之間就見底了。",
    "voice": null,
    "unit_id": null
  }
]
