  {
    "type": "dialogue",
    "name": "苑",
    "words": "哦──",
    "voice": "vo_adv_4010217_000",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n好巧啊，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "竟在這種地方遇見。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……嗯，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "這是什麼？",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "啊，",
    "voice": "vo_adv_4010217_001",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n我沒什麼從男人手中收到生日禮物的記憶，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n腦袋處理不來。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是說，",
    "voice": "vo_adv_4010217_002",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "也不用這麼費心啦，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n多給同學送一點啊。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "啊，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "已經有送了嗎？",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……這樣啊。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嗯，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我想也是。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……呵呵，",
    "voice": "vo_adv_4010217_003",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我還沒道謝吧。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呃，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "幾歲就是企業機密了喔。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……咦？",
    "voice": "vo_adv_4010217_004",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "當、",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "當然有啊。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n成熟的女人在生日晚上怎麼可能沒事，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n真是個蠢問題……",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "今年",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "就是偶然有空啦。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嗯……",
    "voice": "vo_adv_4010217_005",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "這是",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "什麼……",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呃，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "等等。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n這是",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那間訂不到的餐廳的招待劵……",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "你說",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "一起去……",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呃，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "你這會不會太風流了……",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……呵呵，",
    "voice": "vo_adv_4010217_006",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n你好不容易準備的，我就陪你去吧。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……可是，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "能讓我先回家準備一下嗎？",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "得為彩羽準備飯菜。",
    "voice": "vo_adv_4010217_007",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不是要盛裝打扮，可別期待啊♪",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呃，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不會啊。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "都要自我厭惡了，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "忘了",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "剛剛那句話吧。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那",
    "voice": "vo_adv_4010217_008",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "等會見。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我很期待喔，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 132531
  }
]
