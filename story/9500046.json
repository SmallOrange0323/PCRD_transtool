    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101341
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "「相信兩人的羈絆能拯救世界……！」",
    "voice": null,
