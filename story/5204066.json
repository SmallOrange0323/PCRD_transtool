[
  {
    "type": "background",
    "bg_id": "510150"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在陽光灑落的假日餐廳裡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n由市政府主辦的聯誼派對即將舉行。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呃──",
    "voice": "vo_adv_5204066_000",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "感謝",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "大家",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "來參加",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "「愛‧椿丘」。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n我是擔任主持人的",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "市政府職員，名叫石動苑──",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "深月‧流夏",
    "words": "…………\\n……",
    "voice": "vo_adv_5204066_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呃……",
    "voice": "vo_adv_5204066_002",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "今天天氣也很好，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n參加者",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是兩個人，所以……",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那個，",
    "voice": "vo_adv_5204066_003",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "今天這是",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "聯誼派對吧？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "市政府主辦的。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不會錯的，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "畢竟我是看到海報，確認過好幾遍才報名。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……這到底",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是怎麼回事……？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那個，",
    "voice": "vo_adv_5204066_004",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n男、",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "男性參加者的話，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "因為有",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "急事",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "之類的……",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈，",
    "voice": "vo_adv_5204066_005",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這不是妳需要道歉的事啦。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "而且",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說實話，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也沒有在尋求",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "什麼邂逅。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們常客的老公",
    "voice": "vo_adv_5204066_006",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "在市政府工作，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n他拜託我，說參加者好像很少，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "希望我能去。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是、",
    "voice": "vo_adv_5204066_007",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是啊，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我也並沒有那麼期待啦。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我是有稍微",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "想過",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "說不定……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但跟研究一樣，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這不是會那麼順利進展的事",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "吧。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "嗯嗯……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……那個，",
    "voice": "vo_adv_5204066_008",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "真的非常抱歉。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n這",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "作為聯誼派對已經失敗了，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "所以我們解散吧。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n我會先向市政府報告的。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……欸，",
    "voice": "vo_adv_5204066_009",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳們",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "接下來有空嗎？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我知道這附近有很棒的店。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "與其帶著悶悶不樂的心情回去，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不如透過女生聚會來發洩",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "一下如何？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我可以喔，",
    "voice": "vo_adv_5204066_010",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n反正就算",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "回去了也只能釣魚。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "石動小姐呢？",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "啊啊，",
    "voice": "vo_adv_5204066_011",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呃──",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我要",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "消化",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "累積沒看的劇……",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "機會難得，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我就奉陪吧。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾小時後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不是啊，",
    "voice": "vo_adv_5204066_012",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "為什麼單身的我",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "非得幫助別人結婚不可啊。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……話說，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "市政府主辦的聯誼派對什麼的，是誰會受益？",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "這種活動交給民間百分之百更好吧……",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "通過了展現我們正努力推動少子化對策的企劃是很好啦，",
    "voice": "vo_adv_5204066_013",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n但既然如此，就由提案的你來負責啊，",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "笨蛋上司。",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n為什麼是我假日要被叫出去啊？",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "可惡可惡可惡可惡──",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "深月‧流夏",
    "words": "…………",
    "voice": "vo_adv_5204066_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "啊！？",
    "voice": "vo_adv_5204066_015",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不、",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不好意思……！",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n在市民面前這麼失言……",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊哈哈，",
    "voice": "vo_adv_5204066_016",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳憋很久了吧～",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我完全不介意，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不如說",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "很有人性，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "讓人很有好感喔。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵，",
    "voice": "vo_adv_5204066_017",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "排毒是很重要的嘛，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "沒什麼不好吧。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不懂幕後辛苦的人哪裡都有呢。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我的研究所也有一樣的……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "抱歉，有電話。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "喂？",
    "voice": "vo_adv_5204066_018",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "您好。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……是……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "預算下不來……？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n這樣啊。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那件事以後再說。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好的，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我先掛了。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……真是的，",
    "voice": "vo_adv_5204066_019",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "什麼都搞不懂……！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n叫我趕快做，我只是照著指示做了，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "卻說預算不能變，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n希望我繼續進行，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "到底是把現場當成什麼──",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哦哦，",
    "voice": "vo_adv_5204066_020",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這位也憋很久了呢。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "兩位",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "今天都",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說個痛快吧！",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過啊，",
    "voice": "vo_adv_5204066_021",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "從剛剛開始",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就都只有工作的牢騷耶，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那個……",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就不能稍微",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "來點戀愛話題",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "之類的嗎？",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "苑‧深月",
    "words": "……………………………………………………\\n……………………………………………………",
    "voice": "vo_adv_5204066_022",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳那樣說，那妳自己呢？",
    "voice": "vo_adv_5204066_023",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……………………………………………………\\n……………………………………………………",
    "voice": "vo_adv_5204066_024",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……我們",
    "voice": "vo_adv_5204066_025",
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是不是完了？",
    "voice": null,
    "unit_id": 132531
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……是連開始都沒有喔。",
    "voice": "vo_adv_5204066_026",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……沒有開始就是問題所在",
    "voice": "vo_adv_5204066_027",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "吧……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "３人",
