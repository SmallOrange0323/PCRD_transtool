    "words": "……加油吧。",
    "voice": "vo_adv_5204066_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，交換了聯絡方式的三人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n回歸了各自的日常。",
    "voice": null,
