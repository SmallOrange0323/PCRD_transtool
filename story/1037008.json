[
  {
    "type": "background",
    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "感謝招待！",
    "voice": "vo_adv_1037008_000",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "哎呀，",
    "voice": "vo_adv_1037008_001",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "覺得有點不好意思呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n還讓你請我吃飯……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "沒想到{0}還會做菜呢，",
    "voice": "vo_adv_1037008_002",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n看來會是一個好丈夫唷。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗯，",
    "voice": "vo_adv_1037008_003",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "很好吃唷。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n最近我大都在【王宮騎士團】",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "的據點裡吃飯……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但那裡基本上都是男人，",
    "voice": "vo_adv_1037008_004",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "所以料理的味道也就馬馬虎虎的。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "所以吃到{0}做的這種很溫暖的家庭料理，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n感覺很開心呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呵呵。",
    "voice": "vo_adv_1037008_005",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然因為【咲戀育幼院】的經營者",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咲戀小姐不在……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n所以我",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "沒辦法完成監察任務。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "本來也有點擔心就這樣回去會不會不好，",
    "voice": "vo_adv_1037008_006",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n但你卻約我留下來吃飯……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n真～的很謝謝你呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呵呵呵。",
    "voice": "vo_adv_1037008_007",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n受你招待了呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "當然。",
    "voice": "vo_adv_1037008_008",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我想{0}",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "應該是沒有這樣的企圖啦。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "想說對我好一點的話，",
    "voice": "vo_adv_1037008_009",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "監察就會放水之類的……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不論是好的方面，或是壞的方面，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我想你應該也沒有那種小聰明才對呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就只是很一般地，",
    "voice": "vo_adv_1037008_010",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "親切地接待我。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你這樣子正是最棒的待客之道唷。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊。",
    "voice": "vo_adv_1037008_011",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n那讓我來幫你洗碗吧，{0}。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "當作你請我吃飯的謝禮。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這也是我這基層人員的工作之一唷，",
    "voice": "vo_adv_1037008_012",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n因為常常在打掃據點，所以早就習慣了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_1037008_013",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n兩個人一起站在流理台前，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n好像新婚夫婦唷。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦？",
    "voice": "vo_adv_1037008_014",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n你說不知道原來我很會做家事？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗯，",
    "voice": "vo_adv_1037008_015",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "當然啊。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n做菜、洗衣服、裁縫，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "每一樣都會唷。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "別看我這樣，我可是手很巧的。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呵呵。",
    "voice": "vo_adv_1037008_016",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n是不是很適合娶回家當新娘啊♪",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "開～玩笑的啦……",
    "voice": "vo_adv_1037008_017",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "抱歉呢，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n不知道為什麼，我好像有點興奮過頭了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗯嗯。",
    "voice": "vo_adv_1037008_018",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n今天{0}是",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "【咲戀育幼院】的家事值日生啊。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過，一個人要打掃整棟建築物，",
    "voice": "vo_adv_1037008_019",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n應該很辛苦吧……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n希望有人來幫你嗎？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "明白了。",
    "voice": "vo_adv_1037008_020",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我今天也沒有其他工作，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n就讓我來幫忙{0}吧。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過你看起來很想睡覺呢，\\n{0}。",
    "voice": "vo_adv_1037008_021",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n搖搖晃晃的……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是不是這陣子累積了不少疲勞啊，",
    "voice": "vo_adv_1037008_022",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n畢竟大白天的你也睡得很熟呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "哦，",
    "voice": "vo_adv_1037008_023",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "昨天打工到很晚啊。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n是晚上的",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "警備工作嗎？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "還真是",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "辛苦你了呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "所以很晚才回來，",
    "voice": "vo_adv_1037008_024",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "今天也就一路睡到中午這樣啊……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然晚上的工作薪水比較好，",
    "voice": "vo_adv_1037008_025",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n但生活步調就會被打亂呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這樣不行唷～{0}。",
    "voice": "vo_adv_1037008_026",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n要是睡眠時間不固定的話，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "對健康也不好。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那家事就交給我，",
    "voice": "vo_adv_1037008_027",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n你去補眠一下沒關係唷。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "只要告訴我",
    "voice": "vo_adv_1037008_028",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "打掃用具放在哪裡就好……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦，",
    "voice": "vo_adv_1037008_029",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n{0}，\\n你是不是站著睡著了啊？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "唔！？",
    "voice": "vo_adv_1037008_030",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n又是",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那道神秘的光……！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好刺眼！",
    "voice": "vo_adv_1037008_031",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "糟糕，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "洗到一半的盤子會掉下去啦！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "still",
    "still_id": "103700801"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "面！",
    "voice": "vo_adv_1037008_032",
    "unit_id": 103732
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n腹！",
    "voice": null,
    "unit_id": 103732
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n前臂～！",
    "voice": null,
    "unit_id": 103732
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "得分！",
    "voice": "vo_adv_1037008_033",
    "unit_id": 103732
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103732
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 103732
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "流了一些汗很舒服呢……♪",
    "voice": null,
    "unit_id": 103732
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "謝謝你陪我修練，我很開心唷，\\n{0}。",
    "voice": "vo_adv_1037008_034",
    "unit_id": 103732
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "因為我們的道場都是些很強的人，",
    "voice": "vo_adv_1037008_035",
    "unit_id": 103732
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103732
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "所以常常被他們打得落花流水……",
    "voice": null,
    "unit_id": 103732
  },
  {
    "type": "dialogue",
    "name": "智",
