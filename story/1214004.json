[
  {
    "type": "background",
    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "物產展公休的某個假日。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了和育幼院的孩子們一起去牧場賞花，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n美咲正在做出門的準備。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呃，",
    "voice": "vo_adv_1214004_000",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "便當有帶了。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "要給真陽小姐她們的伴手禮也帶了。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "其他",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "沒帶到的東西……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "真是的，",
    "voice": "vo_adv_1214004_001",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "美咲姐姐還沒好嗎～？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我們快點走嘛～！",
    "voice": "vo_adv_1214004_002",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n真陽姐姐",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "在等我們喔～",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我、",
    "voice": "vo_adv_1214004_003",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我知道啦！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我正在",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "檢查東西有沒有帶齊，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你們等我一下！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "好──♪",
    "voice": "vo_adv_1214004_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "要照顧小朋友，這是當然的吧。",
    "voice": "vo_adv_1214004_005",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n因為我可是成熟的淑女。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這不重要，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "來，這給你。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你是負責拿行李的，",
    "voice": "vo_adv_1214004_006",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n要確實",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "把便當和點心搬過去喔。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "如果不認真工作，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就不給你吃點心。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那麼，",
    "voice": "vo_adv_1214004_007",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "快點走吧！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n今天可是最佳的賞花日啊♪",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……咦？",
    "voice": "vo_adv_1214004_008",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這再怎麼說，也太耀眼了吧？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就算是好天氣，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "也該有個限度吧～！？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊，",
    "voice": "vo_adv_1214004_009",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你總算回來了。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "居然敢買東西讓淑女等這麼久，你很大牌嘛。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "聽好了，",
    "voice": "vo_adv_1214004_010",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我想你應該知道，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n今天我可是",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "勉為其難來陪你的。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我原本",
    "voice": "vo_adv_1214004_011",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是預定要和家人一起去賞花。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可是，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "因為沒辦法大家一起去了……",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n所以媽媽",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "才說什麼",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "如果是和你一起就能去……",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過，",
    "voice": "vo_adv_1214004_012",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你也是多虧如此，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n才能夠和我這麼出色的淑女",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "一起賞花，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你要心存感激喔。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "話說回來，",
    "voice": "vo_adv_1214004_013",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "剛才去買了什麼？",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n……為什麼要藏起來啊，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這不是反而讓人更在意嗎？",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "算了，",
    "voice": "vo_adv_1214004_014",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "成熟的大人是不會隨便亂追問的呢。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n就交給你帶路了。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你說過有推薦的賞花地點吧。",
    "voice": "vo_adv_1214004_015",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我很期待你到底會",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "帶我去哪裡～♪",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "background",
    "bg_id": "510360"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……欸，",
    "voice": "vo_adv_1214004_016",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這裡是",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "附近的林蔭大道吧？",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我沒看到",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "哪裡有什麼櫻花木啊。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你應該不會",
    "voice": "vo_adv_1214004_017",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "說什麼……",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "要我賞那邊的蒲公英",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這種蠢話吧？",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "只要繼續沿著河川走，",
    "voice": "vo_adv_1214004_018",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就會走到櫻花道？",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這麼說的話，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我們還得再走一段路才行嗎！？",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "討厭，",
    "voice": "vo_adv_1214004_019",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "早知道要走路，我就不會穿什麼高跟鞋來了～",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我還以為是要去時尚的櫻花景點耶。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊！",
    "voice": "vo_adv_1214004_020",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "等、",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "等等！",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你再走慢一點啦！",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "男性要配合女性的走路速度，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這不是應該的嗎？",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "如果是紳士，就應該懂得體貼淑女。",
    "voice": "vo_adv_1214004_021",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n麻煩你振作點！",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "唔哇～",
    "voice": "vo_adv_1214004_022",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你看那邊那些男生。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "明明還是這種冷冷的季節，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "他們居然穿得那麼少到處跑。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真虧他們那樣不會感冒呢。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "放長假",
    "voice": "vo_adv_1214004_023",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "能盡情出去玩，是讓人很高興，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "但媽媽老是嘮叨著要我念書……",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "比想像中更不輕鬆呢。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "怎樣啦？",
    "voice": "vo_adv_1214004_024",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你那什麼擔心的眼神？",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我先說清楚了，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我可是有認真在念書喔。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "像是今天該念的份，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
