    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "由我去見你吧！",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "still",
    "still_id": "121400402"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "沒錯！",
    "voice": "vo_adv_1214004_055",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這根本不算什麼嘛♪",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n如果我們相隔得很遠，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那我只要去見你就行了。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就算相隔得有點遠，",
    "voice": "vo_adv_1214004_056",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "只要搭飛機就馬上到了。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "即使很難每天見面，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "但如果想見面，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "還是能見得到面不是嗎？",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "所以，",
    "voice": "vo_adv_1214004_057",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "假如你要去到很遠的地方，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我也會特別去見你，",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
