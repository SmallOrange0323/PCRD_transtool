    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "但是我",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "會成長得更多，然後馬上就追上你的。",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "明年的這個時候，",
    "voice": "vo_adv_1214004_059",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我肯定會變成",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "比現在更優雅",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "又更成熟的淑女！",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "所以你",
    "voice": "vo_adv_1214004_060",
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "也要好好練習",
    "voice": null,
    "unit_id": 105032
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n讓自己能夠完美地帶領淑女，",
    "voice": null,
