[
  {
    "type": "background",
    "bg_id": "500033"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "馬車競賽的當天――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "馬車的操作法也練習不少次了，",
    "voice": "vo_adv_5012006_000",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "今天就一起加油吧，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那麼，",
    "voice": "vo_adv_5012006_001",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "馬車競賽終於要開始了！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這次也聚集了許多無所畏懼的勇者，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "想要成為競賽英雄而前來！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "觀眾",
    "words": "唔喔喔喔喔！！",
    "voice": "vo_adv_5012006_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "呀！？　",
    "voice": "vo_adv_5012006_003",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "真、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "真是歡聲雷動啊。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "開始緊張起來了……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那、",
    "voice": "vo_adv_5012006_004",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩和我組隊，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "真的沒問題嗎？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是、",
    "voice": "vo_adv_5012006_005",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是嗎？　",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "欸嘿嘿，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "聽到前輩這麼說",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n我覺得好像能更加努力了。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好，",
    "voice": "vo_adv_5012006_006",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "絕對不能扯後腿才是……！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "因為，",
    "voice": "vo_adv_5012006_007",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "運動神經比較好的人，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "怎麼想都是真琴啊。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雖然霞說，",
    "voice": "vo_adv_5012006_008",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "哀嘆之女神若出現，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我會比任何人\\n都能更快感覺到，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雖然是這麼說，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但還是很不安……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但是，",
    "voice": "vo_adv_5012006_009",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不能示弱對吧……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "得回報大家的期待才行！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好……",
    "voice": "vo_adv_5012006_010",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "集中、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "集中啊步未。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "深呼吸、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "深呼吸……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "呼、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "哈。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "仔、",
    "voice": "vo_adv_5012006_011",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "仔細想想，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是兩人一起坐馬車對吧。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "就在這麼近的地方，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "簡直像做夢一樣……！　",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "啊，",
    "voice": "vo_adv_5012006_012",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不行。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這可是攸關前輩的性命，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n這種時候怎麼能只顧自己……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我真是笨蛋笨蛋！　",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但是、",
    "voice": "vo_adv_5012006_013",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但是，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "時不時會碰到手臂吧……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雖然很害羞但又好開心……！　",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那麼馬車競賽！　",
    "voice": "vo_adv_5012006_014",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "Ready？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "Go！！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦！？　",
    "voice": "vo_adv_5012006_015",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "討厭，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "開始了嗎！？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "出、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "出發吧！！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "still",
    "still_id": "501200601"
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "在這場比賽的途中，",
    "voice": "vo_adv_5012006_016",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "哀嘆之女神一定會出現，盯上前輩。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "反過來由我們來埋伏她……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "霞雖然",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n外表看似穩重，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但其實是很大膽的人呢。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "馬車競賽是由",
    "voice": "vo_adv_5012006_017",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n市區出發前往郊外，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "然後再返回市區的長程賽道。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "在那之中，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "市區的廣場附近，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是最多人聚集的地方……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "預測的襲擊地點，",
    "voice": "vo_adv_5012006_018",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "就在那個廣場。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但是",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "往郊外去時，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "應該還不會有所行動。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "應該是會在賽事最高潮，",
    "voice": "vo_adv_5012006_019",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "所有人目光集中的最終階段。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n所以從郊外回到市區的時候，應該就會發動攻擊……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "對吧。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好的，",
    "voice": "vo_adv_5012006_020",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……那、",
    "voice": "vo_adv_5012006_021",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "可以",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "聽我說幾句話嗎？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我",
    "voice": "vo_adv_5012006_022",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不太擅長表達自己的情感，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n可以拿來當做話題的事",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "也都沒有，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "從以前就很難融入團體之中……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但是最近，",
    "voice": "vo_adv_5012006_023",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我好像有了些改變……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "和公會的大家是如此，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "和這次認識的大家也是這樣。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "真琴對於",
    "voice": "vo_adv_5012006_024",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "初次見面的我，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n就像面對認識很久的夥伴一樣真心相待。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "霞對我說，",
    "voice": "vo_adv_5012006_025",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我一直看著前輩這件事情，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n是能夠幫助前輩",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "的力量。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我明明只是",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "一直看著前輩而已……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這種幸福的感覺，",
    "voice": "vo_adv_5012006_026",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是前輩給予的。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n前輩",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "讓我和大家能有所聯繫……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "正因如此，",
    "voice": "vo_adv_5012006_027",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我更想守護。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n守護前輩、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "和前輩給予我的幸福。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_5012006_028",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我會",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "盡全力加油！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "回到鎮上了呢。",
    "voice": "vo_adv_5012006_029",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩！　",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "快到廣場了！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "絕對……",
    "voice": "vo_adv_5012006_030",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "絕對",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不會讓前輩受到傷害！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n集結霞、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "真琴、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "還、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "還有我……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "大家的力量！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "still",
    "still_id": "501200602"
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "可惡……",
    "voice": "vo_adv_5012006_031",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "我還想說是誰呢，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "原來是那晚的……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n真令人驚訝。",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "我還以為你什麼都辦不到呢，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "看來是我看走眼了。",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "但是，",
    "voice": "vo_adv_5012006_032",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "也更有樂趣了呢！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n積極的想保護他，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "但卻保護不了……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n那種絕望的滋味，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "也相當有魅力呢！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "等等！",
    "voice": "vo_adv_5012006_033",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "　拜託，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "聽我說句話！！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "關於妳的事情，",
    "voice": "vo_adv_5012006_034",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我調查過了喔。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "連讓妳變成這樣的",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那件傷心往事也是。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就此打住吧。",
    "voice": "vo_adv_5012006_035",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不要再繼續",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "累積憎恨了！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "哈……",
    "voice": "vo_adv_5012006_036",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "哈哈哈！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "　區區人類自認為理解的話對我沒用！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "這經年累月的悔恨！",
    "voice": "vo_adv_5012006_037",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "　迎來絕望的苦悶！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n豈是你們這些人能夠理解的！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "悲嘆度過的每日，",
    "voice": "vo_adv_5012006_038",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "早已忘卻！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n如今這副軀體，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "只剩貪求絕望的心！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "來吧，",
    "voice": "vo_adv_5012006_039",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "就讓你們後悔痛哭、",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "醜態盡出吧！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n接著變成貪戀絕望之人，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "就如我一樣，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n墜落於那",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "永恆的黑暗之中吧！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "你這……",
    "voice": "vo_adv_5012006_040",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不明事理的頑固傢伙！！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "什麼！？",
    "voice": "vo_adv_5012006_041",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "　竟然能防掉我這一擊！？",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這是",
    "voice": "vo_adv_5012006_042",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "來自前輩、珍貴的力量！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n是用來救妳的力量喔！！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "你所深愛的人，",
    "voice": "vo_adv_5012006_043",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雖然我們不知道他的事……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但一定是會希望最愛的人能夠一直笑著！！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "看著現在的妳，",
    "voice": "vo_adv_5012006_044",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我想那個人一定笑不出來的！！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "自認理解的那種話，",
    "voice": "vo_adv_5012006_045",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "不是叫你別說了嗎！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n我的心情，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "只有我才懂！！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "步未。",
    "voice": "vo_adv_5012006_046",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "非常遺憾的，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "她已不是往日的公主了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n在絕望之中",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "墮落為魔物，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "只是一股怨念。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "若無法理解言語，",
    "voice": "vo_adv_5012006_047",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那只能讓她用身體來感受了。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}！　麻煩你給我們最高等級的強化！",
    "voice": "vo_adv_5012006_048",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n看來得對這腦袋頑固的公主，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好好說教一番才行啊！！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "唔喔，",
    "voice": "vo_adv_5012006_049",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "充滿了力量，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "全身開始顫抖！！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "歐呀呀呀呀呀！！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "絕對要",
    "voice": "vo_adv_5012006_050",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "幫助妳……！！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "呀呀呀―！！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "哀嘆之女神……",
    "voice": "vo_adv_5012006_051",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳應該感到非常痛苦吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "讓我們來將妳",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "從詛咒的束縛中解放！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "趕緊乖乖束手就擒吧！！",
    "voice": "vo_adv_5012006_052",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n這麼就，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "搜查結束了！！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "沒想到……",
    "voice": "vo_adv_5012006_053",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "這種",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "事情……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n像人一樣，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "我竟然……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "是",
    "voice": "vo_adv_5012006_054",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "嗎……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n已經",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "不再需要絕望了……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n為何呢、",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "宛如放晴一般……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "……欸，",
    "voice": "vo_adv_5012006_055",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "你呀。",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦？　",
    "voice": "vo_adv_5012006_056",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我！？　",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "和記憶中昔日的我相似的你……",
    "voice": "vo_adv_5012006_057",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n但",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "其實並非如此吧……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n你有著",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "互相信任的夥伴……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "如果我也有",
    "voice": "vo_adv_5012006_058",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "那樣的夥伴……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n可能就和你們一樣，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "有希望活下去了……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那是，",
    "voice": "vo_adv_5012006_059",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "只是戲言罷了。",
    "voice": "vo_adv_5012006_060",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n最後，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "告訴你們……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "就算我的意志消失，",
    "voice": "vo_adv_5012006_061",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "詛咒依舊仍在……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n曾經存在的痛哭",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "並不會停歇……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "在不遠的將來，",
    "voice": "vo_adv_5012006_062",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "渴求絕望的詛咒……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n可能會再次浮現在你們眼前……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我不在意喔。",
    "voice": "vo_adv_5012006_063",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "無論多少次，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我都會奉陪。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "對呀。",
    "voice": "vo_adv_5012006_064",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "如果妳還心存不滿的話，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我會不斷對妳說教的。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "呵呵。",
    "voice": "vo_adv_5012006_065",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "還",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "真可靠呢……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n那就拜託了……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "說完這句話，哀嘆之女神\\n就像漸晴時的霧一般，煙消雲散了。",
    "voice": null,
    "unit_id": null
  }
