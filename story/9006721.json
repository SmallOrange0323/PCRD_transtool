    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n明明只差",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "最後一步了……！",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還是一樣。",
    "voice": "vo_adv_9006721_020",
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n[rub:・]我[/rub][rub:・]所[/rub][rub:・]看[/rub][rub:・]見[/rub][rub:・]的[/rub][rub:・]未[/rub][rub:・]來[/rub][rub:・]只[/rub][rub:・]有[/rub]",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[rub:・]我[/rub][rub:・]們[/rub][rub:・]全[/rub][rub:・]員[/rub][rub:・]死[/rub][rub:・]亡[/rub][rub:・]的[/rub][rub:・]結[/rub][rub:・]局[/rub]……！",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "──！！",
    "voice": "vo_adv_9006721_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "「演算預測的未來」。",
    "voice": "vo_adv_9006721_022",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n雖然聽起來很方便，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "但在這種情況下",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "還真是傷腦筋呢。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "那麼。",
    "voice": "vo_adv_9006721_023",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n讓我將那個[rub:終末‧視界]毀滅的未來[/rub]，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "化為定局吧。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……！？",
    "voice": "vo_adv_9006721_024",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n索爾龍崩毀的身體，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "化為了粒子……",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "正在朝幻境龍后──",
    "voice": "vo_adv_9006721_025",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n匯聚而去──？",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "「[rub:法夫納軌道]滅亡之龍的眼窩[/rub]」。",
    "voice": "vo_adv_9006721_026",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "龍的屍骸，",
    "voice": "vo_adv_9006721_027",
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "竟然變成了幻境龍后的裝備……！？",
    "voice": null,
    "unit_id": 127711
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "話說，",
    "voice": "vo_adv_9006721_028",
    "unit_id": 127811
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這是怎麼回事！？",
    "voice": null,
    "unit_id": 127811
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n這股魔力……！",
    "voice": null,
    "unit_id": 127811
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "索爾龍",
    "voice": "vo_adv_9006721_029",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "本應是作為最終Boss實裝的存在。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "理所當然地，身為最終Boss，",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "原定計畫中也有第二型態",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "與第三型態。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "但說到底，",
    "voice": "vo_adv_9006721_030",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "那也只是企劃階段的構想。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "現階段",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "僅保留變身的空間，",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n我以此為容器，",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "灌入了龐大的資源。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "而現在，",
    "voice": "vo_adv_9006721_031",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我將這隻吞噬了半數世界的巨龍，",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n作為我的強化零件──",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "是將其作為「飼料」。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "好、",
    "voice": "vo_adv_9006721_032",
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "好可怕……",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n如果父親大人醒來，",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "也素這種感覺嗎……！？",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "這、",
    "voice": "vo_adv_9006721_033",
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "這種東西……",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n絕對",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "贏不了的……！",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "是的。",
    "voice": "vo_adv_9006721_034",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n理應如此。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "但勝負這件事，",
