    "voice": "vo_adv_9006721_014",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "只剩下妳了！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n幻境龍后！",
