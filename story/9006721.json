    "voice": "vo_adv_9006721_018",
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……明明應該已經",
    "voice": "vo_adv_9006721_019",
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "將她逼到絕境了。",
