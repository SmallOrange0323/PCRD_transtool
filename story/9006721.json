    "name": "幻境龍后",
    "words": "……啊。",
    "voice": "vo_adv_9006721_037",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n全身起雞皮疙瘩了。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "完全止不住顫抖。",
