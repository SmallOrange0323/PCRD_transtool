    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "芙蕾雅曾說的──",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "所謂的臨戰亢奮嗎？",
