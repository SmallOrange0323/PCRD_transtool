    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n就算看起來毫無勝算……",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們也",
