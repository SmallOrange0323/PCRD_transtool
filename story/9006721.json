    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不到最後一刻",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "誰也說不準。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不就是這麼回事嗎？",
