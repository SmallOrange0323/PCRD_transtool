  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "但竟能將我的索爾龍",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "徹底擊潰。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
