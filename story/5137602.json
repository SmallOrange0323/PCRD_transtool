    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "確かに景色はいいけど……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n寒すぎない？",
    "voice": null,
    "unit_id": 106211
  },
  {
