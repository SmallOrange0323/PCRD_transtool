  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "任務に向かうノウェムとオクトーは、出立前に跳躍王の元へと向かう。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "教授、",
    "voice": "vo_adv_5111602_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ちょっと例のアレ",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "貸してもらうぞ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n跳躍の力！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "よろしくおねがいしまーす。",
    "voice": "vo_adv_5111602_001",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "はぁ……",
    "voice": "vo_adv_5111602_002",
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "まあ",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "任務のためであれば仕方がないですが……",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "いやー、",
    "voice": "vo_adv_5111602_003",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "アストルムだとこれがないから不便なんだよな～",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "アストルムの方が不便だって感じるのって",
    "voice": "vo_adv_5111602_004",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nノウェムくらいだと思うよ、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ほんと。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "いいでしょう。",
    "voice": "vo_adv_5111602_005",
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "\\nただ、",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "無駄遣いはしないように。",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ああ！　",
    "voice": "vo_adv_5111602_006",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "分かってる！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nじゃあな！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "……ふむ。",
    "voice": "vo_adv_5111602_007",
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "\\n",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "警告はしましたよ。",
    "voice": null,
    "unit_id": 107311
  },
