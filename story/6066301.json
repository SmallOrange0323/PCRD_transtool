[
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "海で泳ぎ楽しむのはよいが、",
    "voice": "vo_adv_6044301_000",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そればかりではいかんぞ。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "熾炎戦鬼煉獄血盟暗黒団として、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "他にも成すべきことはあるはず。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "さぁシグルド、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "答えよ──",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "我らがこの海で楽しむべきことを！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "なるほど、",
    "voice": "vo_adv_6044301_001",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "熾炎戦鬼煉獄血盟暗黒団の従者を探すのだな！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\nこの真夏の陽光を浴びたヤドカリだ、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "さぞ力を蓄えているであろう。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "どちらが大きい従者を得られるか",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "競争だ！　",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "行くぞーっ！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "ほほう、",
    "voice": "vo_adv_6044301_002",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "我らの城を",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "この海辺に作り上げるということか！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "その意気やよし。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "では魔法を使い、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "本格的な城塞を築こう！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "だが",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "その前にデザインを確認すべきだな、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "こういう見た目で～――",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "何を言ってるのだぁ！　",
    "voice": "vo_adv_6044301_003",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "貴様、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "常夏のエネルギーを放棄するのか！？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n閃光のシグルドともあろうものが、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そんな体たらくでどうする！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "ええい、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "休むのは後にしろ！　",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "私についてこい！",
    "voice": null,
    "unit_id": 113211
  }
]
