  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "──哼。",
    "voice": "vo_adv_9006608_043",
    "unit_id": 136014
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n即便知曉了，",
    "voice": null,
    "unit_id": 136014
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "於你們也毫無意義。",
    "voice": null,
    "unit_id": 136014
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n畢竟被吾的絲線所束縛的你們，",
    "voice": null,
    "unit_id": 136014
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
