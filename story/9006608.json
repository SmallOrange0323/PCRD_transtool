  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "公主──",
    "voice": "vo_adv_9006608_000",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "突襲！！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "background",
    "bg_id": "501790"
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "唔……！",
    "voice": "vo_adv_9006608_001",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──為了奪回雪菲被搶走的靈魂，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}等人與六凶──魔蜘蛛阿剌克涅展開對決。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "他們躲過如雨水般從空中灑落的傀儡絲線，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n擊退【蠻賊三姊妹】和芙蕾雅，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n終於給予阿剌克涅女士會心一擊──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呼、",
    "voice": "vo_adv_9006608_002",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呼……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這次真的",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "把她逼入絕境了……！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請把雪菲小姐",
    "voice": "vo_adv_9006608_003",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還給我們！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "……別得意忘形了，",
    "voice": "vo_adv_9006608_004",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "暴食公主和你們。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n吾已經說了，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "吾從一開始就沒把你們當作對手。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼！",
    "voice": "vo_adv_9006608_005",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別再嘴硬了……！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "從衰老的鳳凰那裡奪來的權能。",
    "voice": "vo_adv_9006608_006",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n要將其消化比想像中還耗費功夫──",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "……不過，",
    "voice": "vo_adv_9006608_007",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n因為跟你們玩耍的關係，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "讓吾消化了不少。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "果然還是",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "得偶爾動動身體才行呢……！",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……！",
    "voice": "vo_adv_9006608_008",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "阿剌克涅的身體",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "正溢出驚人的魔力和熱度……！",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好、",
    "voice": "vo_adv_9006608_009",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好熱！！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這傢伙",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "跟剛剛完全無法比──！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "很熱的。",
    "voice": "vo_adv_9006608_010",
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n要來了。",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥、",
    "voice": "vo_adv_9006608_011",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "各位！",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n請到我的身後！",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n可可蘿小姐，",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "麻煩妳支援！",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是！",
    "voice": "vo_adv_9006608_012",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n風之精靈，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請給我等守護的加持……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "侵毀吾之居所的罪，",
    "voice": "vo_adv_9006608_013",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "恣意踏在吾渴求不止之世界的罪！",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n還有無數的無禮發言，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "為此化作焦炭懺悔贖罪吧！",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n就在你們無比希望拯救的",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "這個丫頭面前！",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "──唔！！！",
    "voice": "vo_adv_9006608_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "──呵哈哈哈哈……！",
    "voice": "vo_adv_9006608_015",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n這種程度正好暖身……！",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "傳令！",
    "voice": "vo_adv_9006608_016",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n還活著的話就把門打開！",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的芙蕾雅",
    "words": "「……了解了，",
    "voice": "vo_adv_9006608_017",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的芙蕾雅",
    "words": "女士。」",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那、",
    "voice": "vo_adv_9006608_018",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那個魔法陣是……！",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "空間跳躍。",
    "voice": "vo_adv_9006608_019",
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳、",
    "voice": "vo_adv_9006608_020",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳是想逃跑嗎……！？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "說什麼蠢話！",
    "voice": "vo_adv_9006608_021",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n對吾來說，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "真正的戰鬥現在才開始呢……！",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊！",
    "voice": "vo_adv_9006608_022",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n雪菲小姐",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "被帶走了……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "只能追上去了！",
    "voice": "vo_adv_9006608_023",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留、普蕾西亞，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n能阻止那個魔法陣",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "消失嗎！？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留、普蕾西亞",
    "words": "「好！」\\n「嗯。」",
    "voice": "vo_adv_9006608_024",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "900660801"
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "「小雪菲！」\\n「雪菲小姐！」\\n「雪菲！」",
    "voice": "vo_adv_9006608_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──皇女……！！",
    "voice": "vo_adv_9006608_026",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "哦……",
    "voice": "vo_adv_9006608_027",
    "unit_id": 136014
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n烏合之眾一個個聚集起來，",
    "voice": null,
    "unit_id": 136014
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "追在吾身後啊？",
    "voice": null,
    "unit_id": 136014
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n明明應該深刻明白力量上的差距，",
    "voice": null,
    "unit_id": 136014
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "真是愚蠢啊。",
    "voice": null,
    "unit_id": 136014
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……！？",
    "voice": "vo_adv_9006608_028",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "阿剌克涅的頭",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "變成女人了……！？",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "這個妖魔人的姿態",
    "voice": "vo_adv_9006608_029",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "就是阿剌克涅女士的真面目……！？",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "但是這",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "也實在太……！",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "魔力。",
    "voice": "vo_adv_9006608_030",
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n好驚人。",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但、",
    "voice": "vo_adv_9006608_031",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n我們可不能輸……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "──這是吾無法理解的感情。",
    "voice": "vo_adv_9006608_032",
    "unit_id": 136014
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n但你們就對這個龍丫頭",
    "voice": null,
    "unit_id": 136014
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "這麼念念不忘嗎？",
    "voice": null,
    "unit_id": 136014
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n",
    "voice": null,
    "unit_id": 136014
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "不過──",
    "voice": null,
    "unit_id": 136014
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……！",
    "voice": "vo_adv_9006608_033",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "從天空降下",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這麼多的絲線！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "而且絲線的動作",
    "voice": "vo_adv_9006608_034",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "比剛剛",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "還要快上很多──",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不，",
