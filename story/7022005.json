[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "清理",
    "voice": "vo_adv_7022005_000",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "完畢",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "☆",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好厲害！",
    "voice": "vo_adv_7022005_001",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "竟然在一瞬間就解決了那麼多的魔物！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "雖然我照著小七七香說的做了，但沒有很懂，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n那是什麼魔法呀？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "欸嘿嘿～",
    "voice": "vo_adv_7022005_002",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我試著",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "活用了之前",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n初音美眉施展出的轉移魔法喔。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就不解釋得太詳細了，",
    "voice": "vo_adv_7022005_003",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n簡單來說感覺就像是，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "把魔物軀體的一部分",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "和其他物品交換的魔法吧。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但因為我一個人無法妥善控制，",
    "voice": "vo_adv_7022005_004",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "所以這魔法離完成還差得遠，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但總之，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "有成功真是太好了。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯？",
    "voice": "vo_adv_7022005_005",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "因為太大的東西我無法操控，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "所以只有將",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "路邊的小石頭",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "一點點地進行轉移而已唷。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "光是這樣，就有那麼大的威力，",
    "voice": "vo_adv_7022005_006",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "真是不得了的魔法呢。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "以創造新魔法的靈感來說，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "目前發現的結果應該已經足夠了。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "只是，",
    "voice": "vo_adv_7022005_007",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "和你的記憶相關的線索，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "卻還沒有找到呢。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這件事也該來……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唔，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哎呀呀？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n地上好像有一顆奇怪的石頭呢。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是不小心",
    "voice": "vo_adv_7022005_008",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "從其他地方轉移過來的嗎？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唔～嗯，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "看來操控技術還要多加強呢。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不過，",
    "voice": "vo_adv_7022005_009",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這石頭會閃閃發光，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好漂亮呢～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "著實如此哪～",
    "voice": "vo_adv_7022005_010",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呃、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "怎、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "怎麼回事！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n光是不是越變越強了！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嘿咻，",
    "voice": "vo_adv_7022005_011",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好了。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n真的放在這邊就可以了嗎？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "是啊，",
    "voice": "vo_adv_7022005_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "這裡就是我家，這樣就好囉。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n不過話說回來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "小姑娘妳還真有力氣啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n如此重的東西，瞧妳搬得這麼輕鬆。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊、",
    "voice": "vo_adv_7022005_013",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊哈哈～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我可能算是",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "比一般人來得有力氣沒錯啦～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "糟糕，",
    "voice": "vo_adv_7022005_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "這樣對女孩子說，是不是有點失禮啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n妳真的幫了很大的忙，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "謝謝啦。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n那麼先失陪了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "多保重喔～",
    "voice": "vo_adv_7022005_015",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……呼。",
    "voice": "vo_adv_7022005_016",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是不是有點",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "一口氣搬太多了呀～？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那點小事，不用太在意啦～",
    "voice": "vo_adv_7022005_017",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不過由於得抑制住超能力的力道，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "結果似乎反而更累了呢。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "可能是抑制力量產生的反作用吧～",
    "voice": "vo_adv_7022005_018",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不過既然這裡只有你在，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "稍微飄個一下下……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什、",
    "voice": "vo_adv_7022005_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什麼～～～～！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "有女孩子飄在空中！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n好厲害！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "完全重現了魔法少女驚奇甜心的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "初次變身場景！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦！？",
    "voice": "vo_adv_7022005_020",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "哇、",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "哇哇哇……！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯？",
    "voice": "vo_adv_7022005_021",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "剛才她確實看起來是飄在空中啊……",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "錯覺嗎？",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦，",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "{0}也在呀！",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我剛才太驚訝，沒發現到你啊。",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？",
    "voice": "vo_adv_7022005_022",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是你認識的人呀？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯，",
    "voice": "vo_adv_7022005_023",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "總之就是，",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "剛才妳的狀況，",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n乍看之下很像過往",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "某部魔法少女動畫名作的其中一幕，",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "所以我才忍不住變得很激動啦。",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "突然嚇到妳了，",
    "voice": "vo_adv_7022005_024",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "抱歉喔。",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不過……",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳剛才確實是",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "飄在空中吧？",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "欸、",
    "voice": "vo_adv_7022005_025",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呃～～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "怎、",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "怎麼說，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那是～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "什麼！？",
    "voice": "vo_adv_7022005_026",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n意思是初音美眉",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "也是熱愛魔法少女的同好囉？",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊、",
    "voice": "vo_adv_7022005_027",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯、",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n應該算、",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是吧？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "還真沒想到",
    "voice": "vo_adv_7022005_028",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "可以在同年齡層中發現夥伴。",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不，",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "要說的話不朽名作",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "鐵定是能擄獲各種年齡層粉絲的啦！",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不過",
    "voice": "vo_adv_7022005_029",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這下正好。",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "目前",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "電影院正在播映動畫電影的重新剪輯版本。",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n要不要一起去看呀？",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "動、",
    "voice": "vo_adv_7022005_030",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "動畫電影？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "重新剪輯？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "畢竟小七七香",
    "voice": "vo_adv_7022005_031",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "看起來相當期待呢。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我也有點想去看看了。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯，",
    "voice": "vo_adv_7022005_032",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就一起去看吧！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "太好了！",
    "voice": "vo_adv_7022005_033",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那麼，",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "該朝電影院",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "進軍囉！",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "background",
    "bg_id": "510301"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "…………",
    "voice": "vo_adv_7022005_034",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗚、",
    "voice": "vo_adv_7022005_035",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唔嗚……",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "果然",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這部電影看幾次都很棒啊。",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n好不容易互通心意的兩人，",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "在戰鬥結束後，",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "卻面臨",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "超越時空的別離……",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不過",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "故事結尾仍有留下再次相會的希望……",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "…………",
    "voice": "vo_adv_7022005_036",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唉唷～",
    "voice": "vo_adv_7022005_037",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "得回去重新複習動畫啦！",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦，",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "初音美眉？",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳怎麼變得那麼安靜呀？",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "莫、",
    "voice": "vo_adv_7022005_038",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "莫非",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳不喜歡重剪版的新繪製畫面嗎！？",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "當然原本",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "舊版的豪邁筆觸確實令人印象深刻，",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但這次修改過的畫面",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "也是別有一番風味……",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真～～",
    "voice": "vo_adv_7022005_039",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "的好好看喔！！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "而且，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我還是第一次在電影院發出那麼大的喊聲！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "畢竟這次",
    "voice": "vo_adv_7022005_040",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "正好買到應援場的票嘛。",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "多年粉絲們一起",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "大聲加油的光景，",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n可是和單純欣賞電影有著不同的樂趣喔。",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "而且，",
    "voice": "vo_adv_7022005_041",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "勁敵角色的那個女孩，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "實際上竟然不會用魔法，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "而是使用超能力……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "初音美眉？",
    "voice": "vo_adv_7022005_042",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒什麼啦！",
    "voice": "vo_adv_7022005_043",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我看得",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "很開心唷！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這樣呀～",
    "voice": "vo_adv_7022005_044",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "見到妳滿意真是太好了。",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那麼，",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們就準備來享受看完電影後的樂趣吧。",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是還有什麼活動嗎？",
    "voice": "vo_adv_7022005_045",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那當然。",
    "voice": "vo_adv_7022005_046",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "身為阿宅，這可是基本。",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n那就是……",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "回家路上的",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "感想大會！！",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "background",
    "bg_id": "510361"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就在此時，",
    "voice": "vo_adv_7022005_047",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "時空產生了扭曲，",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n而兩人必須兵分兩路才能修復時空……",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "對對對。",
    "voice": "vo_adv_7022005_048",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "雖然一開始是主角打算到時空的另一頭，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n但勁敵角色的女孩卻把她推開……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "如果妳消失，會有很多人傷心吧。",
    "voice": "vo_adv_7022005_049",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我的話……",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就不會有了。",
    "voice": null,
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒有那回事！",
    "voice": "vo_adv_7022005_050",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "因為，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "妳消失的話，我會很傷心呀！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "然後勁敵就開口回道……",
    "voice": "vo_adv_7022005_051",
    "unit_id": 101331
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "儘管我的人生充滿謊言，",
    "voice": "vo_adv_7022005_052",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不是騙人就是被騙，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但最後總算是得到了",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真實的羈絆。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這樣我就已經",
    "voice": null,
    "unit_id": 101231
  },
  {
