    "words": "小七七香！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "而且",
    "voice": "vo_adv_7022005_081",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我剛才用了太多魔法，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "已經累壞啦～",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我可沒有自信能聽進什麼太嚴肅的話題啊！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "今天就先回去吧。",
    "voice": "vo_adv_7022005_082",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "關於祕密的話題，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就下次再聊吧。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呵呵，",
    "voice": "vo_adv_7022005_083",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "說得也是。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "儘管沒有將事情說出口，七七香和初音仍互通了心意，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n滿足地開始往下走，朝塔的出口前進。",
    "voice": null,
    "unit_id": null
  }
]
