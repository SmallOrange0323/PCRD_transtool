[
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和七七香\\n為了擊退魔物的工作而來到普拉諾平原。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "開頭就退場辛苦你啦──",
    "voice": "vo_adv_1013006_000",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊，",
    "voice": "vo_adv_1013006_001",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "怎麼回事，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這個在一開始的草叢就已經練到100等的感覺。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "零手感。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這是什麼限制條件玩法？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喂，",
    "voice": "vo_adv_1013006_002",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "比起這個呀！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我呀，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "最近學會了一個有趣的咒語呦！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "可以試用看看吧？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我沒想參考你的回答──！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "如何？",
    "voice": "vo_adv_1013006_003",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "如何？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喔、喔、喔。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對吧？",
    "voice": "vo_adv_1013006_004",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "太棒了──成功！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哼哼哼，",
    "voice": "vo_adv_1013006_005",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "被下這個咒的人，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n會變得突然想吃甜食喔。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我為這個咒語取了名字！",
    "voice": "vo_adv_1013006_006",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……叫做",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "「甜點」呦……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "當然的啦！",
    "voice": "vo_adv_1013006_007",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "在戰鬥最熱烈的時候，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n能讓對手突然想吃甜食不是嗎？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗚哇，",
    "voice": "vo_adv_1013006_008",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好想吃甜食……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "趁他這麼想時攻擊就對了！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我果然是天才♪",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對吧對吧──！",
    "voice": "vo_adv_1013006_009",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這種魔法才能感覺到浪漫！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "只要施在敵人身上，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "在他變得想吃甜食時就會出現破綻了呢♪",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯──♪",
    "voice": "vo_adv_1013006_010",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我果然是……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "天才♪",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "來、",
    "voice": "vo_adv_1013006_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "來人啊──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯喵？",
    "voice": "vo_adv_1013006_012",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "有人往我們這裡直奔而來？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喂──！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "發生什麼事了嗎──？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "啊啊，",
    "voice": "vo_adv_1013006_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "你們！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "救、",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "救救我們啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喔喔，",
    "voice": "vo_adv_1013006_014",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "總之先冷靜冷靜。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "請詳細說明發生了什麼事。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "呼呼，",
    "voice": "vo_adv_1013006_015",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "我、",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "我們是專門買賣魔法道具的商家，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n……在前往王都的途中時，我們非常重要的商品連同馬車一起被搶走了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你說什麼──！？",
    "voice": "vo_adv_1013006_016",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這可是大事件啊！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "對呀！",
    "voice": "vo_adv_1013006_017",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n而且裡面還包括了非常貴重的魔導書之類的商品……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "貴重的魔導書！？",
    "voice": "vo_adv_1013006_018",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "真的？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那真！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "那、",
    "voice": "vo_adv_1013006_019",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "那真……？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不行啊！",
    "voice": "vo_adv_1013006_020",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不知不覺情緒就高昂起來了！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "別在意呀啾咪！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "小、",
    "voice": "vo_adv_1013006_021",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "小姐妳的用語可真是奇怪呀……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "嗯？",
    "voice": "vo_adv_1013006_022",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "說到奇怪……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "那些傢伙，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n都在使用著沒見過的魔法呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "啊啊……",
    "voice": "vo_adv_1013006_023",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "那應該是「黑暗收藏家」的黨羽吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦！？",
    "voice": "vo_adv_1013006_024",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "叔叔也知道「黑暗收藏家」嘛！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "不，",
    "voice": "vo_adv_1013006_025",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "我也不清楚詳情……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "只有聽過傳聞……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n但是啊，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "既然使出沒看過的魔法，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "也只能聯想到這個了呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯，",
    "voice": "vo_adv_1013006_026",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "男子的弟子們將貴重的魔導書……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "叔叔，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "馬車是往哪個方向走的呢？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "咦？",
    "voice": "vo_adv_1013006_027",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "我記得是往前方",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "洞窟的方向走……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "該、",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "該不會",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "妳要幫我找回來嘛！？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "當然！",
    "voice": "vo_adv_1013006_028",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "請交給我！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "因為我絕不允許有人用魔法做壞事！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "而且，",
    "voice": "vo_adv_1013006_029",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "若和「黑暗收藏家」有關的話更要弄清楚了！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "請放心交給魔法少女七七香吧♪",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "商人大叔所說的是這個洞窟吧──",
    "voice": "vo_adv_1013006_030",
    "unit_id": 101311
  },
  {
