  {
    "type": "dialogue",
    "name": "旁白",
    "words": "承認自己將{0}當成男性來戀慕，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n流夏心中仍有困惑。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但是又不能將「大姐頭會」放著不管──",
