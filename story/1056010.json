    "name": "流夏",
    "words": "啊啊沒錯。",
    "voice": "vo_adv_1056010_001",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就算成立了大姐頭會，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n但如果不能賺錢養活自己，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就只是群社會脫節者聚集在一起而已。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以我決定，",
    "voice": "vo_adv_1056010_002",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要來教你們如何釣魚。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n這是職業訓練。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要好好把技能學起來，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "用自己的雙手來賺錢！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "小弟們",
    "words": "好、",
    "voice": "vo_adv_1056010_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小弟們",
    "words": "好的────！！",
    "voice": null,
    "unit_id": null
  },
  {
