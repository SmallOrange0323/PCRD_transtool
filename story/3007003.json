[
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一個人完成給公會的委託任務後，\\n怜很疲憊地回到了公會小屋。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我回來了。",
    "voice": "vo_adv_3007003_000",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日和還沒回來嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "歡迎回來。她剛剛才出門呢。",
    "voice": "vo_adv_3007003_001",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "妳們沒有擦身而過嗎？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒有耶。……",
    "voice": "vo_adv_3007003_002",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "該不會，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n她又跑去四處搜尋任務的委託人了吧――",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我回來了～！怜、優衣，",
    "voice": "vo_adv_3007003_003",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n有事情想委託我們幫忙的人，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我找到了喔～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……歡，歡迎回來。日和妳呀……",
    "voice": "vo_adv_3007003_004",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……真是的。",
    "voice": "vo_adv_3007003_005",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "把對方趕回去也不太好。就聽聽看吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "謝謝！　",
    "voice": "vo_adv_3007003_006",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你可以進來了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那就不客氣了。",
    "voice": "vo_adv_3007003_007",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "真不好意思，在你們忙的時候……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒關係的啦。",
    "voice": "vo_adv_3007003_008",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼，能說明一下要給我們的委託內容嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這次想委託各位幫忙的，是往返火山期間的護衛任務。",
    "voice": "vo_adv_3007003_009",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "各位是否有聽說過在這個時期，只有在火山才能夠採集到的稀有種類花朵的事情？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "有聽過謠傳。那是很眩目逼人的紅色花朵，",
    "voice": "vo_adv_3007003_010",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果把它送給心上人的話便能傳達愛意之類。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "其實我，想把那朵「結緣花」送給戀人……",
    "voice": "vo_adv_3007003_011",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "然後……向她求婚。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "求婚！　好棒喔！",
    "voice": "vo_adv_3007003_012",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……怜。那個，我……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "唉……我說日和妳啊。為甚麼總是那樣輕易答應別人？",
    "voice": "vo_adv_3007003_013",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n公會經營可不是做慈善事業啊。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣妳也是，太容易被人情綁住不是好事喔。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "抱歉……",
    "voice": "vo_adv_3007003_014",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……話雖如此，如果冷淡地拒絕這種委託的話，",
    "voice": "vo_adv_3007003_015",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n也會影響工會的信譽。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那我們就接下吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怜……！",
    "voice": "vo_adv_3007003_016",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "非常感謝妳們！",
    "voice": "vo_adv_3007003_017",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n請多多指教！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜……謝謝～！",
    "voice": "vo_adv_3007003_018",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還以為妳會說不可以呢……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嘻嘻。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是的……",
    "voice": "vo_adv_3007003_019",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，等這個任務結束之後隔天大家都得好好休息。明白嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好的～！好～！大家往貝利奧火山前進吧～！！",
    "voice": "vo_adv_3007003_020",
    "unit_id": 100111
  },
  {
    "type": "background",
    "bg_id": "500220"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "喝！",
    "voice": "vo_adv_3007003_021",
    "unit_id": 100312
  },
  {
    "type": "background",
    "bg_id": "500220"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘰歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呼……",
    "voice": "vo_adv_3007003_022",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是最後一匹了吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "因為這附近不太有人會靠近，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n比起城鎮附近來說魔物多了很多啊……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這沒什麼啦。",
    "voice": "vo_adv_3007003_023",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "比起這個，感謝你願意和我們一起前來。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "根據花店老闆所言，如果來到這個高度的話，",
    "voice": "vo_adv_3007003_024",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n說不定就能找到！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "大家努力找吧～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "喔，",
    "voice": "vo_adv_3007003_025",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "喔♪",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "請多多指教！",
    "voice": "vo_adv_3007003_026",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──數小時之後",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們也滿用心去找了，但還是找不到呢……",
    "voice": "vo_adv_3007003_027",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不愧是被稱為稀少種類…",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "…",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "雖然還差一點點就會抵達禁止進入的管制區……",
    "voice": "vo_adv_3007003_028",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "只要不放棄一定能找到的！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "大家加油吧～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……找到了。",
    "voice": "vo_adv_3007003_029",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我找到了！！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n看看這個！就在這裡盛開著！！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……真的呢……！",
    "voice": "vo_adv_3007003_030",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "恭喜恭喜！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "非、非常感謝！",
    "voice": "vo_adv_3007003_031",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這就是結緣花……！",
    "voice": "vo_adv_3007003_032",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "能在火山開花真是了不起的事情呢！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊。在這種對植物生長來說極為嚴苛的環境還能開花……真令人感受的生命的奧妙啊。",
    "voice": "vo_adv_3007003_033",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……",
    "voice": "vo_adv_3007003_034",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這樣就好了。如果求婚成功的話，我會和戀人把從花朵取得的種子帶回這裡種植。這麼做的話，下一個想傳達內心想法的人也會來到這裡尋找花朵吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是個好主意。",
    "voice": "vo_adv_3007003_035",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼，在魔物還沒出現之前下山吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜，妳看！",
    "voice": "vo_adv_3007003_036",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n有人正從底下爬上來呢！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你們手上拿著的花～",
    "voice": "vo_adv_3007003_037",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n該不會就是結緣的花吧！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我沒說錯吧？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n可以把這個花讓給我嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那、那是……",
    "voice": "vo_adv_3007003_038",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "請問，為甚麼會想要這朵花呢？",
    "voice": "vo_adv_3007003_039",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n請把理由告訴我們――",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……日和，優衣。看看他們的裝扮。",
    "voice": "vo_adv_3007003_040",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n在火山穿著那麼周到的武裝，肯定不是一般人。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n恐怕是傭兵。不要再多說了立刻保持距離吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯，嗯……！",
    "voice": "vo_adv_3007003_041",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯……雖然不見得是恐怖的人……",
    "voice": "vo_adv_3007003_042",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "知道了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真抱歉，這不是為了拱手交給你們的東西。",
    "voice": "vo_adv_3007003_043",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不好意思了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "欸～拜託啦！我們是傭兵耶！如果連這種小事",
    "voice": "vo_adv_3007003_044",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "\\n都做不好的話，可是很傷我們的自尊耶！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "我可以付你們錢！再考慮一下吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無論如何都不讓步是嗎……",
    "voice": "vo_adv_3007003_045",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "麻煩你帶著那個人，馬上離開這裡吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我們也會在阻止那些傢伙的行動後追上的。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝。",
    "voice": "vo_adv_3007003_046",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "請你也小心。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我知道。真抱歉老是麻煩你。",
    "voice": "vo_adv_3007003_047",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……謝謝你。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你們快走吧！　這裡交給我們！",
    "voice": "vo_adv_3007003_048",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "啊！喂！小伙子等一下嘛！",
    "voice": "vo_adv_3007003_049",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "抱歉",
    "voice": "vo_adv_3007003_050",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "嗚哇！好刺眼！眼睛睜不開……！",
    "voice": "vo_adv_3007003_051",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就在現在吧！　我們上吧，怜、優衣！",
    "voice": "vo_adv_3007003_052",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "照這樣的話應該能順利逃走呢……",
    "voice": "vo_adv_3007003_053",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "太好了。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "傭兵２",
    "words": "咦……？　",
    "voice": "vo_adv_3007003_054",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "傭兵２",
    "words": "欸～！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "傭兵２",
    "words": "\\n你們在前面有碰到我的同伴嗎？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有分隊嗎……！",
    "voice": "vo_adv_3007003_055",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯、嗯～……",
    "voice": "vo_adv_3007003_056",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "沒有碰到呢？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "日和……那種態度馬上就被拆穿了啦……！",
    "voice": "vo_adv_3007003_057",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "欸～你們等一下啦！",
    "voice": "vo_adv_3007003_058",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "咦？你們終於趕上來啦？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怎麼辦？",
    "voice": "vo_adv_3007003_059",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們被夾攻了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "對不起……都是因為我的委託……",
    "voice": "vo_adv_3007003_060",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "事到如今只好乖乖的把花交給他們――",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "――你們給我等一下！",
    "voice": "vo_adv_3007003_061",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n幹嘛讓這群人對你們保持警戒呀！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "真的很抱歉，我的部下造成各位的困擾――",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……妳怎麼會出現在這裡？",
    "voice": "vo_adv_3007003_062",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "你……！還有、那花是……！",
    "voice": "vo_adv_3007003_063",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "什麼嘛～原來是小姐認識的人啊！",
    "voice": "vo_adv_3007003_064",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "如果是這樣的話，早點告訴我們不就好了嘛！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……真的非常抱歉！",
    "voice": "vo_adv_3007003_065",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "其實呢……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳是這班人所屬的傭兵團團長的女兒……？",
    "voice": "vo_adv_3007003_066",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我一直想對你坦白……",
    "voice": "vo_adv_3007003_067",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n但一想到不知你能不能接受，就感到很害怕。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n所以想送你結緣之花再說明一切……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "原來如此！　有想過傭兵先生為甚麼",
    "voice": "vo_adv_3007003_068",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n想要結緣的花，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "原來是這個原因喔。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "因為小姐說什麼要一個人上火山，",
    "voice": "vo_adv_3007003_069",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "\\n我們才擔心地跟上來啦！接著就發現你們已經拿到了這個花，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "所以想請你們賣給我，結果你們就一直逃跑，還真是狼狽啊！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "剛才對不起。我們不明就裡就誤會了……",
    "voice": "vo_adv_3007003_070",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真丟臉……",
    "voice": "vo_adv_3007003_071",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "沒關係啦！",
    "voice": "vo_adv_3007003_072",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "……不過之後的發展",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "\\n就要看這兩個人了吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "………說實話，雖然現在還有點混亂，但對你的感覺是不會改變的。",
    "voice": "vo_adv_3007003_073",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我衷心希望，妳可以收下這朵花！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……好的！",
    "voice": "vo_adv_3007003_074",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我很樂意！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "太好了……！　二人的心意真的相通了！",
    "voice": "vo_adv_3007003_075",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "傭兵２",
    "words": "嗚喔喔喔！那位小姐終於……！！",
    "voice": "vo_adv_3007003_076",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "恭喜恭喜！　",
    "voice": "vo_adv_3007003_077",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "萬歲！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──呱歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "該死的魔物們，對聲音有所反應而聚集過來了嗎……！",
    "voice": "vo_adv_3007003_078",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個……傭兵先生們，",
    "voice": "vo_adv_3007003_079",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n也能請你們幫忙一下嗎？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "好啊！",
    "voice": "vo_adv_3007003_080",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "傭兵",
    "words": "如果能夠幫助小姐的話，我們當然很樂意啊！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "在有困難的時候就要互相幫助幫助，對吧！",
    "voice": "vo_adv_3007003_081",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好～！一個接一個撂倒牠們喔！　",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "喝呀～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "日和一行人順利地打倒了魔物。\\n幾天後，那位男性寫的信寄到了她們手上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "「……今後為了讓二人能變得幸福，",
    "voice": "vo_adv_3007003_082",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我一邊接受她父親的鍛鍊，同時以成為未來的傭兵團團長作為目標。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這次真的很謝謝妳們的幫忙。」",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "兩人看起來很幸福真是太好了呢。",
    "voice": "vo_adv_3007003_083",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "先前遇到傭兵們時還在想會變成怎樣的說……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "唉……沒想到我也會向日和一樣粗心會錯意……",
    "voice": "vo_adv_3007003_084",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "打起精神吧，怜！　",
    "voice": "vo_adv_3007003_085",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "和我一樣是不值得高興的嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不是那個問題啦……",
    "voice": "vo_adv_3007003_086",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……呵呵呵。",
    "voice": "vo_adv_3007003_087",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n對不起。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我忍不住……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "拜託別再取笑我了啦～！",
    "voice": "vo_adv_3007003_088",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我有好好反省了～！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──日和她們在歡笑之餘，\\n也感受到在不斷完成公會收到的委託的過程中，\\n彼此之間的羈絆越來越深厚了。",
    "voice": null,
    "unit_id": null
  }
]
