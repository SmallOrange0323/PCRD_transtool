[
  {
    "type": "dialogue",
    "name": "小棉花糖",
    "words": "汪汪！",
    "voice": "vo_adv_5076321_000",
    "unit_id": 15211
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "喔，",
    "voice": "vo_adv_5076321_001",
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "渺小的人類之子們，",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "總算找到你們了。",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "\\n",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "幸好靈界和現實世界之間的大門還開著。",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "天啊天啊，",
    "voice": "vo_adv_5076321_002",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "小棉花糖！？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還有靈界之王陛下！？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雖說很高興能再相見，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "小棉花糖……",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "氣噗噗的？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "不，",
    "voice": "vo_adv_5076321_003",
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "其實……",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "小地獄犬是乖乖回到靈界了，",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "\\n然而，牠卻撒嬌說",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "還想再和你們玩耍……",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "\\n",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "看來",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "牠真的很喜歡你們呢……",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈～♪",
    "voice": "vo_adv_5076321_004",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們也",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "很喜歡小棉花糖喔～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "再來一起盡情地玩吧～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "對了，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "剛剛就有注意到……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "在陛下身邊",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "有一群跟我們長得很像的孩子，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "他們是誰啊～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "我認為在和小地獄犬玩耍之前，",
    "voice": "vo_adv_5076321_005",
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "\\n必須要先暖身一下，",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "\\n所以，他們是由我從靈界帶來的靈體",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "所喬裝而成的。",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "即便如此，",
    "voice": "vo_adv_5076321_006",
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "他們可是相當難纏的喔。",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "\\n再怎麼說，",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "靈界之王",
    "words": "這就像是跟你們自己戰鬥一樣。",
    "voice": null,
    "unit_id": 7711
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "呵呵呵……",
    "voice": "vo_adv_5076321_007",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "別小看我們是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "可是也身經百戰是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "像這種喬裝成我們的冒牌貨，",
    "voice": "vo_adv_5076321_008",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "沒什麼好怕的是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "來吧，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "讓你們",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "見識一下萬聖節拯救隊",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "貨真價實的強大實力是也！",
    "voice": null,
    "unit_id": 117811
  }
]
