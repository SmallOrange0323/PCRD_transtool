  {
    "type": "dialogue",
    "name": "旁白",
    "words": "霸瞳皇帝釋放出魔力引發爆炸。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n僅此一擊，就將{0}和他的夥伴們全數擊倒了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呼、",
    "voice": "vo_adv_2015002_000",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呼……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可惡……！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "唔、",
    "voice": "vo_adv_2015002_001",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "唔嗚……",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n……那傢伙，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "也太厲害了……",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "大、",
    "voice": "vo_adv_2015002_002",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "大家……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "都沒事吧……？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "總算是……",
    "voice": "vo_adv_2015002_003",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n勉勉強強",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還活著的樣子……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "謝、",
    "voice": "vo_adv_2015002_004",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "謝謝妳，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "粉紅色的大姐姐……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n連我們身上",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "也施放了防禦魔法……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯，",
    "voice": "vo_adv_2015002_005",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "也要謝謝可可蘿妳……",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呼、",
    "voice": "vo_adv_2015002_006",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呼……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不用謝……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "剛剛那個防禦魔法，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n是騎士先生幫我們",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "高度強化的功勞。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不過……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "霸瞳皇帝的力量，",
    "voice": "vo_adv_2015002_007",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "實在太過強大。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就算借助了主人的力量，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也未必能一直安然度過。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n再這樣下去……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……真是丟臉呢。",
    "voice": "vo_adv_2015002_008",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n只不過是稍微",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "陪你們玩玩的程度而已……",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n就已經",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "幾乎沒人能站起來了嗎？",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就這點程度的話，",
    "voice": "vo_adv_2015002_009",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我是不是根本沒有必要",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n特地變成這個姿態呢？",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……唉。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "唔……！",
    "voice": "vo_adv_2015002_010",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n妳以為妳已經贏過我們了嗎……！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……呵。",
    "voice": "vo_adv_2015002_011",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n妳說",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這就算贏了嗎？",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我可不這麼認為呢。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "若真是如此……",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我又豈會如此空虛。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "空虛……？",
    "voice": "vo_adv_2015002_012",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我剛剛……",
    "voice": "vo_adv_2015002_013",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也和克莉絲提娜講過了。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我是",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "「真的不打算」",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "與你們進行戰鬥的。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我不但不打算讓你們見識到這個姿態，",
    "voice": "vo_adv_2015002_014",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也沒有打算",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "將如此重要的王牌用在這個場合。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "為了那即將到來的",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "「真正的戰鬥」，",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我原先是想保留實力的……",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "「真正的戰鬥」……？",
    "voice": "vo_adv_2015002_015",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不是為了",
    "voice": "vo_adv_2015002_016",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "與我們七冠戰鬥……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也不是為了要拿來",
    "voice": "vo_adv_2015002_017",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對付我們這群反叛者……？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n陛下……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "請告訴我們！",
    "voice": "vo_adv_2015002_018",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "妳到底……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是打算和什麼東西戰鬥？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "霸瞳皇帝……！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……",
    "voice": "vo_adv_2015002_019",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這話怎麼是由妳來問呢？",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "優衣。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦……？",
    "voice": "vo_adv_2015002_020",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "算了……",
    "voice": "vo_adv_2015002_021",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也好。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n畢竟這片夕陽，",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也像血海一般美麗……",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n而你們也活不到今晚了，",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就讓我來和你們",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "說點什麼吧。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……說到底。",
    "voice": "vo_adv_2015002_022",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這個世界，",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n本來就是由謊言與假想所建構而成的。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "是想像與虛構的幻想世界。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "安穩地生活在其中的你們，",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "想必根本未曾注意過吧？",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "善與惡，本來應該會",
    "voice": "vo_adv_2015002_023",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "依據觀測者的立場而有所改變。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "然而在這虛構的世界中，",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "卻存在著一個絕對之惡……",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這個世界竟是藉由那絕對之惡的存在",
    "voice": "vo_adv_2015002_024",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "而持續運轉的。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "簡直",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就像在訴說著自己即是「神」呢。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……不可饒恕對吧？",
    "voice": "vo_adv_2015002_025",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n明明這個世界裡的「神」，",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "除了我──",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "霸瞳皇帝之外就再無他人了。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "淨在那邊說些，",
    "voice": "vo_adv_2015002_026",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "唯我獨尊的狂言……！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……不。",
    "voice": "vo_adv_2015002_027",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "先不說別人，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "如果是從千里真那口中所說出來的……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這番話就並非只是唯我獨尊的狂言了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "若要說是為何……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "若要說是為何，自然是因為這名為阿斯特朗的世界，",
    "voice": "vo_adv_2015002_028",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n原本就是我們七冠",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "所創造出來的。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n對吧？",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "變貌大妃。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是的……",
    "voice": "vo_adv_2015002_029",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "而且，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真那。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n就算在我們之中，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n妳也是最出類拔萃的……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "沒錯。",
    "voice": "vo_adv_2015002_030",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n這裡明明是以「神」的身分成長的我，",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "為了以「神」的身分統治一切",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n而創造出來的世界……",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "除了我以外，",
    "voice": "vo_adv_2015002_031",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "若有任何人膽敢坐上「神」座，",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我就必須不計代價將那人給打落在地才行。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "畢竟所謂的「神」，",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "可是唯一且絕對的存在。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "而我，",
    "voice": "vo_adv_2015002_032",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "將會創造出一個符合我心中理想的新世界！",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n擁有天之瞳的我所踏上的霸王之道，",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "是不會被你們所阻礙的！",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那麼就由我來――",
    "voice": "vo_adv_2015002_033",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n將妳那所謂的霸王之道",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "給斬斷吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "――天樓霸斷劍！",
    "voice": "vo_adv_2015002_034",
    "unit_id": 106113
  },
  {
    "type": "background",
    "bg_id": "500783"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……！",
    "voice": "vo_adv_2015002_035",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "諾維姆！？",
    "voice": "vo_adv_2015002_036",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我們也一同助陣！",
    "voice": "vo_adv_2015002_037",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n尾狗刀！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "好啦好啦……",
    "voice": "vo_adv_2015002_038",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "真是的，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "真拿她沒辦法呢。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "――看招！",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "background",
    "bg_id": "500783"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是【王宮騎士團】的純小姐！",
    "voice": "vo_adv_2015002_039",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n還有……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，",
    "voice": "vo_adv_2015002_040",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那個輕浮的人，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "總覺得好像在哪裡看到過！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是之前",
    "voice": "vo_adv_2015002_041",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "大家在搶諾維姆的時候，跟我們打過一場的人唷，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "雖然搞不太清楚狀況，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但現在好像是自己人的樣子。",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……！",
    "voice": "vo_adv_2015002_042",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真琴！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我們也上吧！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是啊！",
    "voice": "vo_adv_2015002_043",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n這應該",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就是我們最後的機會了！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不斷攻擊到底吧，香織！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "優衣妳們也是！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好的！",
    "voice": "vo_adv_2015002_044",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒問題！",
    "voice": "vo_adv_2015002_045",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯！",
    "voice": "vo_adv_2015002_046",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人！",
    "voice": "vo_adv_2015002_047",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請您替大家進行強化吧……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "呀啊啊啊――――！！！",
    "voice": "vo_adv_2015002_048",
    "unit_id": null
  }
]
