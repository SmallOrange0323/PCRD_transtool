    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "雖然我沒有立場說你，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n不過你拋下職務在這裡做什麼？",
