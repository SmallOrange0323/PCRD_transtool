  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "所以沒人願意指派給我重要的任務，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n我才會鬧彆扭，老是惡作劇。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
