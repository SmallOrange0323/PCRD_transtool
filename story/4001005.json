  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是的。",
    "voice": "vo_adv_4001005_039",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n因為隨便認可為公認公會的話，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n管理上會很辛苦呢。",
