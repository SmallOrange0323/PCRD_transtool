    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "不要緊吧？…",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n到底發生什麼事了？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我一直被囚禁在那座監獄裡，",
    "voice": "vo_adv_4001005_071",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n所以不知道現況如何。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊哈哈。",
