  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "涅比亞。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n能夠透過與人接觸的體溫感受到幸福，",
