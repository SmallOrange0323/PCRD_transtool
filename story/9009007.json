  {
    "type": "dialogue",
    "name": "旁白",
    "words": "吉歐‧格黑納某處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n抽獎遊戲的攤販前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "來喲，",
    "voice": "vo_adv_9009007_000",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "蘭德索爾的抽獎攤販來囉～！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n吉歐‧格黑納的各位，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "要不要",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "來試試手氣呀！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "哦，",
    "voice": "vo_adv_9009007_001",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "抽獎呀……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "於吉歐‧格黑納不曾見過之物，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "真是吸引人。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──皇女。",
    "voice": "vo_adv_9009007_002",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "那個……",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "沒抽中的話，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "是拿不到什麼好東西的。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "既然，",
    "voice": "vo_adv_9009007_003",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "都要花錢──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我覺得",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "拿去買點其他東西，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "會更好。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "真是的，默涅呀，",
    "voice": "vo_adv_9009007_004",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "別說掃興之事。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "花錢於這般遊戲上，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "所為非是得失，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "而是興致。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……我，",
    "voice": "vo_adv_9009007_005",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "不是很明白。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "要有玩心。",
    "voice": "vo_adv_9009007_006",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "抽了籤，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "揭曉結果那一刻……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正是",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "樂趣之所在。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "呵呵呵……",
    "voice": "vo_adv_9009007_007",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不愧是騎士閣下，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此言甚妙。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "於結果揭曉之前，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "懷抱著或許能得到獎品",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "的夢想。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n人們想必",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "便是為此付出金錢的吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "夢想──",
    "voice": "vo_adv_9009007_008",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "這個，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我也不太明白。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "呵呵。",
    "voice": "vo_adv_9009007_009",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "那麼默涅，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "汝便去抽一個試試吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n親身體驗乃是最佳的學習呀。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "來吧──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "也來一同遊玩吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "謝謝惠顧！",
    "voice": "vo_adv_9009007_010",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n不管有沒有中獎",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "都不要埋怨啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……這是？",
    "voice": "vo_adv_9009007_011",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n前端",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "是金色的。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哦哦！？",
    "voice": "vo_adv_9009007_012",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "真的假的！？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n小姑娘，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這可是頭獎啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "獎品是現在蘭德索爾",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n最流行的新型遊戲機喔～！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "遊戲、",
    "voice": "vo_adv_9009007_013",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "機……？",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "呵呵呵……",
    "voice": "vo_adv_9009007_014",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "心無所求而抽",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "方得好結果呢。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "那麼店主啊，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家所抽之籤呢？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "啊，",
    "voice": "vo_adv_9009007_015",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳沒抽中呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n來，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "給妳洗碗刷。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……竟然如此。",
    "voice": "vo_adv_9009007_016",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "實在遺憾……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "遺憾──？",
    "voice": "vo_adv_9009007_017",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n皇女，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "不是買下了",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "夢想嗎？",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "這與那",
    "voice": "vo_adv_9009007_018",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "乃兩回事……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……果然，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "所謂夢想不過泡影罷。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雖然出現了這樣的一幕，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "但涅妃‧涅羅等人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n還是盡情地享受了",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "似乎帶有東國文化氛圍的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n夏日祭典。",
    "voice": null,
    "unit_id": null
  }
]
