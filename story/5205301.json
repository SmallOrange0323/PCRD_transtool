  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呵呵呵♪",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n這種程度的對手，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "根本不需要本小姐出場！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "紡希，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "聚光燈就讓給妳吧♪",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嘴上這樣說，",
    "voice": "vo_adv_5205301_001",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但妳心裡其實在暗自盤算，",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "要把最後一擊給搶走對吧？",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n華音妳太好懂了。",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "唔唔……！",
    "voice": "vo_adv_5205301_002",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哼！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "就憑妳也想了解本小姐！？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "真是沒辦法，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "本小姐就陪妳一起上吧！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……感覺妳想讓我先衝進去當誘餌，",
    "voice": "vo_adv_5205301_003",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n所以不好意思失禮一下？",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我捲～",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊捲。",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "咦？",
    "voice": "vo_adv_5205301_004",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "妳把本小姐用絲線綁起來",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "是想做什麼！？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "這樣本小姐無法動彈啊！？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "難、",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "難道說",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "妳想就這樣丟過去！？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這就是我們的！",
    "voice": "vo_adv_5205301_005",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "聯手攻擊！",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "妳這個",
    "voice": "vo_adv_5205301_006",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "沒救的粉紅頭─────！？",
    "voice": null,
    "unit_id": 134911
  }
