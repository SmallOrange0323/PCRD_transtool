[
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "到此為止了，",
    "voice": "vo_adv_5052302_000",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "反逆獸！",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n有我魔法提督在場，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "絕不容許你繼續作惡下去！",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "小心點，",
    "voice": "vo_adv_5052302_001",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "Lovely★莫妮卡！",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n反逆獸",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "不會乖乖束手就擒的。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "牠為了與我們對抗，",
    "voice": "vo_adv_5052302_002",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "似乎變得更強了呢……！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "敵人越變越強了呢……！",
    "voice": "vo_adv_5052302_003",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "不過，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "我們可是也在持續進步的……！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "呵，",
    "voice": "vo_adv_5052302_004",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "正是如此，Purely★栞。",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n我就來回應妳的志氣吧！",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "閃耀吧，",
    "voice": "vo_adv_5052302_005",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "愛之力！",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n──可愛閃光！",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 14111
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "由我擔任先鋒！",
    "voice": "vo_adv_5052302_006",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "全員，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "跟著我上吧──！",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "是！",
    "voice": "vo_adv_5052302_007",
    "unit_id": null
  }
]
