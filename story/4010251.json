[
  {
    "type": "background",
    "bg_id": "509014"
  },
  {
    "type": "background",
    "bg_id": "510120"
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊，",
    "voice": "vo_adv_4010251_000",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "真的來了……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "沒有啦，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊就",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "前幾天",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "你不是有提到這裡嗎？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n說是這一攤的可麗餅吃起來超普通。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "所以",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我就想說",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "你今天搞不好會來──",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "別、",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "別亂想喔？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "這絕對不是",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "那種跟蹤狂的行為喔！",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "咦？",
    "voice": "vo_adv_4010251_001",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "好的……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "謝",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "謝……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "對喔，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "今天是28號嘛，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "是優妮博士的生日。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "嗯，",
    "voice": "vo_adv_4010251_002",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "這麼說來",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "倒也是啦。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n畢竟多數人在阿斯特朗裡的角色",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "都是直接套用本名，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n就連生日",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "也設定成跟本人一樣嘛。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊，哪有，",
    "voice": "vo_adv_4010251_003",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "才不是好嗎？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我可絕對沒有",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "刻意",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "在賣弄迷糊人設喔？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "又不是",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "想讓你留下",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "「原來那個人還有少根筋的一面啊～」之類的印象──",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "──抱歉，",
    "voice": "vo_adv_4010251_004",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "既然你都來祝賀了，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我就跟你說一聲好了。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n你要當今天是我生日也行啦，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "但事實上",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "不是今天",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "就是了……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "站著說話可以嗎？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "還是要坐著？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "坐著好了，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "附近找個地方。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "嚴格來說，我──",
    "voice": "vo_adv_4010251_005",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我是說現在這邊",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "這個姓真行寺的我。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我在戶籍上",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "登記的出生日",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "不是28號，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "而是29號喔。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "２月29號……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "簡單來說就是所謂的",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "「閏日」",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "順帶一提，",
    "voice": "vo_adv_4010251_006",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "據說",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "學齡前的我曾經表示",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n「那我不就四年才能收到一次禮物嗎！」，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "時不時",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "就會在家裡大哭大鬧。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n當然，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我本人毫無印象，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "認為那高機率",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "是後世捏造之言。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "畢竟哪可能",
    "voice": "vo_adv_4010251_007",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "四年才過一次生日啊。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "通常都會",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "選在前一天或隔天慶祝──",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "應該隔天的比例比較高，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "總之平年就是",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "把那個區間視為生日，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "歲數也照常在增長。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "咦？",
    "voice": "vo_adv_4010251_008",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "怎麼會扯到這裡來了……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "在解釋",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我的生日是吧？",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "對，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "雖然不是今天，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "但要當成今天也沒問題。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n總之我想說的是，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "感謝",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "你的生日祝福──",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "嘿嘿。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "真的嗎？",
    "voice": "vo_adv_4010251_009",
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "好讚喔，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "竟然還有兩天生日這種事。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我賺翻了，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "真開心。",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我明天",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "也會在這裡等你──",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "\\n",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊，",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "不對！",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "我今天並沒有在等你啦！",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 111031
  },
  {
    "type": "dialogue",
    "name": "由仁",
    "words": "差點露餡……",
    "voice": null,
    "unit_id": 111031
  }
]
