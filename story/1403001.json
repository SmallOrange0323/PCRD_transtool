  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n要是對埃忒耳模組進行維護的話。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "身為不良品的我，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "也會被隨手",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "刪除掉……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_1403001_047",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……嗯？",
    "voice": "vo_adv_1403001_048",
    "unit_id": 193211
  },
  {
    "type": "still",
    "still_id": "140300103"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "從阿斯特朗那邊，",
    "voice": "vo_adv_1403001_049",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "到吉歐‧提格尼亞的入侵者……？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n真稀奇。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n……啊～",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是受到「再再構築」的影響嗎……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "而且，",
    "voice": "vo_adv_1403001_050",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那些傢伙。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n不就是打倒",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "霸瞳皇帝那些人的傢伙嗎。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "甚至",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "還特製[rub:護身符]抗魔的護符[/rub]來防禦",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "認知修正……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真囂張……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……算了，",
    "voice": "vo_adv_1403001_051",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "管他是哪裡來的傢伙。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n反正從「顛倒之塔」",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "只能做單向的干涉。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我還是",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "一樣無聊──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……嗯嗯嗯？",
    "voice": "vo_adv_1403001_052",
    "unit_id": 193211
  },
  {
    "type": "still",
    "still_id": "140300104"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "感覺",
    "voice": "vo_adv_1403001_053",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n那傢伙……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……好奇怪？",
    "voice": "vo_adv_1403001_054",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n模索路晶的公主騎士──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "畢竟是觸發重置的人，",
    "voice": "vo_adv_1403001_055",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "早就有見過那張臉了。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "因為入侵了背面世界，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "讓我更容易存取了……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n所以我能[rub:・]知[/rub][rub:・]道[/rub]。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那傢伙，",
    "voice": "vo_adv_1403001_056",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "果然很奇怪。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n那傢伙夢想之門的鑰匙孔──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「潛意識入口」，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n為什麼",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這麼毫無防備啊？　",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就像是",
    "voice": "vo_adv_1403001_057",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "有人不斷潛入他的夢中，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n在夢裡為所欲為……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "似的。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……",
    "voice": "vo_adv_1403001_058",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n如果是",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這麼毫無防備的傢伙──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "說不定，",
    "voice": "vo_adv_1403001_059",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可以在他睡著的時候，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n只把精神",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "帶到",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這裡……？　",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "background",
    "bg_id": "501640"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……呵呵。",
    "voice": "vo_adv_1403001_060",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呵呵呵……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "有趣的玩具。",
    "voice": "vo_adv_1403001_061",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n找～",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "到你了……♪",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……那麼，",
    "voice": "vo_adv_1403001_062",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n得想想",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "作戰計畫呢。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "畢竟第一印象？",
    "voice": "vo_adv_1403001_063",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "印刻效應？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這些都很重要嘛。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n也許可以出些問題",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "捉弄他一下──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──對了，",
    "voice": "vo_adv_1403001_064",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "也得決定好",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「我」的名字才行。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n畢竟叫「認知修正小姐」之類的，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "也只會讓人覺得莫名其妙嘛。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真是，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "變得好忙碌啊……！",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "…………\\n……",
    "voice": null,
