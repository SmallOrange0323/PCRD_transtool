[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "咦，",
    "voice": "vo_adv_9500103_000",
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我嗎～？",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n等等，騎士先生！",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n你是認真的嗎？",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "因為",
    "voice": "vo_adv_9500103_001",
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我可是日和的啦啦隊啊，",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我都決定要為你跟日和",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "加油了。",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……沒想到你卻選了我。",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……",
    "voice": "vo_adv_9500103_002",
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "傷腦筋。",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n真的被選中了，",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "果然還是開心得不得了。",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這下頭大了。",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這份心意，",
    "voice": "vo_adv_9500103_003",
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "是因為我是誕生自",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n日和的關係……",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗎？",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n還是說，",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "是我本身的心意……？",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "抱歉，騎士先生。",
    "voice": "vo_adv_9500103_004",
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我明明是姐姐，",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "卻這麼猶豫不決的。",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "真丟臉……",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……是、",
    "voice": "vo_adv_9500103_005",
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗎？",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "謝謝你……",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……！",
    "voice": "vo_adv_9500103_006",
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈哈，",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "你居然在這時用那句話喔？",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n好詐喔，騎士先生……",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗯，",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "已經沒事了！",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "姐姐",
    "voice": "vo_adv_9500103_007",
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "都不了解自己。",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過，",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "總覺得……",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "很開心。",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "因為這表示，",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "或許也有什麼是只屬於我的。",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "所以，",
    "voice": "vo_adv_9500103_008",
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "誕生自日和的我心中，",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n到底有沒有只屬於「埃拉」的心意。",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n以後……",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我要跟你一起確認。",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈。",
    "voice": "vo_adv_9500103_009",
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "像這樣有了新目標……",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n最能讓人有",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "「活著」的感覺呢！",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "只要是跟你一起，",
    "voice": "vo_adv_9500103_010",
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我什麼都辦得到。",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n讓我們像太陽般熱烈燃燒──",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "去抓住",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "今後的未來吧！",
    "voice": null,
    "unit_id": 135541
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 135541
  }
]
