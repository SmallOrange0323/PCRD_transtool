[
  {
    "type": "background",
    "bg_id": "500230"
  },
  {
    "type": "dialogue",
    "name": "怪物",
    "words": "──呱歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "怪物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是魔物……！",
    "voice": "vo_adv_3007001_000",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "大家要小心喔！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "先下手為強！　日和，我們出手吧！",
    "voice": "vo_adv_3007001_001",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哇哇！　等一下呀，怜！",
    "voice": "vo_adv_3007001_002",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "優衣，請妳幫忙支援！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "騎士先生，我們該怎麼辦……！",
    "voice": "vo_adv_3007001_003",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……",
    "voice": "vo_adv_3007001_004",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "明白了！首先，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n是停止魔物的行動對吧！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這個是最後了！",
    "voice": "vo_adv_3007001_005",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "看我的！",
    "voice": "vo_adv_3007001_006",
    "unit_id": 100312
  },
  {
    "type": "background",
    "bg_id": "500230"
  },
  {
    "type": "dialogue",
    "name": "怪物",
    "words": "──嘰歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "怪物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呼……大家辛苦了！",
    "voice": "vo_adv_3007001_007",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "果然來到這裡之後，強勁的魔物也增加了呢……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是啊，但我們也已經變強了。",
    "voice": "vo_adv_3007001_008",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "證據就是我們也收集了相當多的魔珠。",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n還差一點點就可以達到目標了。",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "對呀！如果是我們4人的話，",
    "voice": "vo_adv_3007001_009",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n一定可以抵達索爾之塔的頂峰喔！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "然後……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在塔頂之上，實現願望……！",
    "voice": "vo_adv_3007001_010",
    "unit_id": 100211
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……今天，又做了一樣的夢……",
    "voice": "vo_adv_3007001_011",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "(在夢中出現的那些人是誰……？",
    "voice": "vo_adv_3007001_012",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "還有，在索爾之塔的塔頂能實現願望的事情……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我一直以為，那只是給小孩子聽的童話故事而已……)",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "(雖然我只能朦朧地想起她們的身影，",
    "voice": "vo_adv_3007001_013",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但對於在夢中的我來說，那些人",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n似乎是非常重要的存在……)",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（如果真的有機會能碰面……還真想看看她們呢……）",
    "voice": "vo_adv_3007001_014",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "唉呀！",
    "voice": "vo_adv_3007001_015",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "喔喔！真抱歉。",
    "voice": "vo_adv_3007001_016",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真抱歉！兩位都沒事吧？",
    "voice": "vo_adv_3007001_017",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒事的。我們只是稍微互撞了一下。",
    "voice": "vo_adv_3007001_018",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那就好了。不小心就看著塔頂看到出神……",
    "voice": "vo_adv_3007001_019",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我也是在盯著索爾之塔看的時候，",
    "voice": "vo_adv_3007001_020",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不知不覺就移動了身體……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我也是因為仰望著高塔，",
    "voice": "vo_adv_3007001_021",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n而沒注意到四周環境。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "所以請您不要介意。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這麼說來，",
    "voice": "vo_adv_3007001_022",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我們都是在仰望著這座塔呢！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "總會有些稀奇的事情呢……",
    "voice": "vo_adv_3007001_023",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呀，忘記了報上自己的名字。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我是――",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "來人呀！有小偷呀！",
    "voice": "vo_adv_3007001_024",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "呿！大聲叫吵死人啦！放開我，妳這個女人！",
    "voice": "vo_adv_3007001_025",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "嗚嗚！",
    "voice": "vo_adv_3007001_026",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "誰可以幫我把錢包搶回來……！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "通通給我滾開！不滾開的傢伙，我可是不會輕易放過你的啊！",
    "voice": "vo_adv_3007001_027",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "居然在這種地方搶東西……！",
    "voice": "vo_adv_3007001_028",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個小偷，往我們的方向過來了耶……",
    "voice": "vo_adv_3007001_029",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……我說兩位。小偷就由我們來抓吧！",
    "voice": "vo_adv_3007001_030",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "辦、辦得到嗎…？",
    "voice": "vo_adv_3007001_031",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然是和我無關的閒事啦。",
    "voice": "vo_adv_3007001_032",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……但是，如果對方打算朝我們這裡硬碰硬，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那我只好採取相應的手段了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "什麼！？不想受傷的話就快給我讓路！",
    "voice": "vo_adv_3007001_033",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "首先停止他的行動吧！",
    "voice": "vo_adv_3007001_034",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n然後就交給我們來！",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我試試看……！喝啊！",
    "voice": "vo_adv_3007001_035",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "嗚喔！",
    "voice": "vo_adv_3007001_036",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "妳想跟我打嗎！還真有膽量呢！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗚呀！",
    "voice": "vo_adv_3007001_037",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對、對不起！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "幹得好，那傢伙停下腳步了！",
    "voice": "vo_adv_3007001_038",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看我的！",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "咳喔～！！",
    "voice": "vo_adv_3007001_039",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "最後由我來收尾！",
    "voice": "vo_adv_3007001_040",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n就請你把錢包還來囉！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗚喵喵喵呀～！！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "啊～！！",
    "voice": "vo_adv_3007001_041",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "跟我走吧！",
    "voice": "vo_adv_3007001_042",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n我會好好地審問，看看你有沒有犯下其他的罪！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "嗚……可惡……！",
    "voice": "vo_adv_3007001_043",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "真的很感激妳們……！",
    "voice": "vo_adv_3007001_044",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這份恩情改天一定會回報！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "兩位真厲害！",
    "voice": "vo_adv_3007001_045",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣就一切搞定！勝利勝利（V字手勢）！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯，太好了呢……！",
    "voice": "vo_adv_3007001_046",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真沒想到會那麼順利……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說得沒錯……但你的牽制行動相當準確。",
    "voice": "vo_adv_3007001_047",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯～，妳的名字是……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼說來我還沒自我介紹吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我是怜。請多指教。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我是優衣。",
    "voice": "vo_adv_3007001_048",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怜妳們的攻擊也很厲害呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我是日和！",
    "voice": "vo_adv_3007001_049",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "感覺我們的行動有如不是初次合作般的順利呢！　想起來就和在夢境中所見的一樣呢！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "夢……那麼說來，妳們兩位為甚麼仰望那座塔呢？",
    "voice": "vo_adv_3007001_050",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那個阿，",
    "voice": "vo_adv_3007001_051",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "其實我，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "今天雖然是",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n第一次看見索爾之塔，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但在夢裡面",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n已經看好多次了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "夢中……那個，",
    "voice": "vo_adv_3007001_052",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是不是有和誰一起",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n在各種各樣的地方冒險……然後……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……為了能實現願望，以索爾之塔的塔頂為目標。",
    "voice": "vo_adv_3007001_053",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n妳是想這麼說吧，優衣。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怜，為甚麼妳會……！？",
    "voice": "vo_adv_3007001_054",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……當然囉。我也做了一樣的夢啊。",
    "voice": "vo_adv_3007001_055",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一而再再而三，做了很多次呢……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣的話，會不會怜和優衣就是在夢中與我一同結伴冒險的人呢！？",
    "voice": "vo_adv_3007001_056",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這就很難下定論囉。",
    "voice": "vo_adv_3007001_057",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……不過，我們3人看到的夢是一樣內容的可能性很高。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那麼那麼，我們就確認看看它是不是一樣的吧！",
    "voice": "vo_adv_3007001_058",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "與夢中相同，我們大家一起變強……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "以索爾之塔的塔頂為目標……！",
    "voice": "vo_adv_3007001_059",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這想法不差。我們做了相同的夢，",
    "voice": "vo_adv_3007001_060",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n一定有其意義所在。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然我從一開始就打算即使獨自一人也要前往塔頂，不過如果有夥伴的話就更放心了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那就這樣決定了！",
    "voice": "vo_adv_3007001_061",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n今後請多多指教！　優衣！　怜！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我才是要請你們多關照。日和。優衣。",
    "voice": "vo_adv_3007001_062",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我今天之內就會完成公會設立的手續。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯！　請多關照。日和。怜！",
    "voice": "vo_adv_3007001_063",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼，公會名稱和公會長要怎麼辦呢？",
    "voice": "vo_adv_3007001_064",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "很遺憾我不是適合領導別人的那塊料。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這個位置就讓給妳們兩位的其中一人吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我也不適合當公會長……",
    "voice": "vo_adv_3007001_065",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "日和，可以拜託妳擔任嗎？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可以喔～那接著就是決定公會名稱對吧！",
    "voice": "vo_adv_3007001_066",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……「黎明之星」，",
    "voice": "vo_adv_3007001_067",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "之類的……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我覺得這個不錯呀。",
    "voice": "vo_adv_3007001_068",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日和妳呢？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我認為很好！",
    "voice": "vo_adv_3007001_069",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "只是……感覺好像忘了什麼重要的事情……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "still",
    "still_id": "300700101"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "重要的事情……？",
    "voice": "vo_adv_3007001_070",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……那個，妳是指之前提到的，騎士先生……？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "妳好～。",
    "voice": "vo_adv_3007001_071",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……你是來看索爾之塔的嗎？　為什麼呢？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊～！　我想起來了！",
    "voice": "vo_adv_3007001_072",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n當時還有一個人在啊！　我們的夥伴！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……為什麼這麼重要的事情，會把它給忘了……？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就是這樣……不知為何沒有想起他的事情。",
    "voice": "vo_adv_3007001_073",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n明明在夢中見過很多次……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "難道，你就是夢中的那個他嗎……？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果是的話就很令人高興了但……",
    "voice": "vo_adv_3007001_074",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "夢中的事情，你還能想起多少？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "依稀朦朧是嗎……",
    "voice": "vo_adv_3007001_075",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但如果有那個可能性的話，就得確認一下。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我希望你和我們一起組隊，以索爾之塔的塔頂為目標邁進。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "或許你和我們所見的夢境相同也說不定。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "而且如果你和我們在一起，",
    "voice": "vo_adv_3007001_076",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n說不定也能想起夢境內容之外的其他事情……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你……意下如何呢？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "太好了～！　嘿嘿，今後請多多指教喔！　騎士先生！",
    "voice": "vo_adv_3007001_077",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "請多指教囉。",
    "voice": "vo_adv_3007001_078",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯……再一次多多指教喔。騎士先生。",
    "voice": "vo_adv_3007001_079",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "以夢境為契機而相遇、聯繫在一起的4人冒險譚，\\n即將從這個地點開始──",
    "voice": null,
    "unit_id": null
  }
]
