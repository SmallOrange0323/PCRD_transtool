    "type": "dialogue",
    "name": "莉莉",
    "words": "感覺",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "很開心？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "畢竟這是我第一次",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "像這樣獨自思考要送什麼禮物……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……不。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "若要說第一次，",
    "voice": "vo_adv_1258003_037",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n現在這樣",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "如此強烈地仰慕一個人，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "在我的人生中",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "也是第一次──",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "──呀啊！？",
    "voice": "vo_adv_1258003_038",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "呃啊～！",
    "voice": "vo_adv_1258003_039",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "喂，妳這傢伙！",
    "voice": "vo_adv_1258003_040",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "\\n走路不要搖搖晃晃好嗎，搞什麼啊！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "真、",
    "voice": "vo_adv_1258003_041",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "真的非常抱歉。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n請問您是否有受傷呢？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "好痛～！",
    "voice": "vo_adv_1258003_042",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "痛～死人啦～！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "還不快賠我醫藥費，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "總共一百萬盧幣！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "一、",
    "voice": "vo_adv_1258003_043",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "一百萬……！？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "怎、",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "怎麼這樣……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n我手邊",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "並沒有帶這麼多錢……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "啊啊！？",
    "voice": "vo_adv_1258003_044",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "\\n妳這臭小鬼是看不起我們嗎，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "我看就來好好教妳一下大人的規矩吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "……嗯嗯？",
    "voice": "vo_adv_1258003_045",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "\\n說起來，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "\\n原本以為只是個臭小鬼……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "仔細一看長得挺漂亮的嘛。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "我說～小妹妹啊，",
    "voice": "vo_adv_1258003_046",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "妳就稍微陪我們玩玩吧！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "\\n這樣的話，醫藥費我就讓妳一筆勾銷哪～！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "咦、",
    "voice": "vo_adv_1258003_047",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "可是……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n這樣我會很困擾的……！",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "哇哈哈哈！",
    "voice": "vo_adv_1258003_048",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "\\n聽到沒，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "她還說「我會很困擾的～」咧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "少囉嗦，",
    "voice": "vo_adv_1258003_049",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "乖乖聽話跟我們走！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "反正妳是自己一個人吧？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "\\n我們就好心陪妳玩玩哪～！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "啊……！",
    "voice": "vo_adv_1258003_050",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "啊啊？",
    "voice": "vo_adv_1258003_051",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "\\n你這傢伙又是誰啊～？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "搞什麼啊，",
    "voice": "vo_adv_1258003_052",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "原來有男伴了喔。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "嘖，",
    "voice": "vo_adv_1258003_053",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "有夠無趣～！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "得、",
    "voice": "vo_adv_1258003_054",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "得救了，兄長大人……！",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n真的很感謝您……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "搞什麼！？",
    "voice": "vo_adv_1258003_055",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "\\n竟然是哥哥！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "少騙人了，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "你們長得一點也不像好嗎～！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "而且話說回來……",
    "voice": "vo_adv_1258003_056",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "\\n我",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "看過你啊！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "之前",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "你帶著其他女人走在街上吧！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "\\n還看起來感情還很好的樣子哪～！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "嗚……！",
    "voice": "vo_adv_1258003_057",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "哎～呀～",
    "voice": "vo_adv_1258003_058",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "莉莉小妹妹～",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "瞧妳那副發現被劈腿而大受打擊的表情。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混2",
    "words": "\\n好可憐喔～！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "這個自稱是妳哥哥的可疑人士，",
    "voice": "vo_adv_1258003_059",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混1",
    "words": "\\n我們得幫妳好好教訓教訓他才行呢！",
    "voice": null,
    "unit_id": 811
  },
