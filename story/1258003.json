  },
  {
    "type": "dialogue",
    "name": "藥店的老闆",
    "words": "最新的魔法藥喔～！",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "藥店的老闆",
    "words": "\\n也有大江戶的中藥唷～！",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "藥店的老闆",
    "words": "\\n快來看看～！",
