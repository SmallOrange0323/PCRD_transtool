  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "看起來很好喝呢。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "果汁店的老闆",
    "words": "對吧對吧～！",
    "voice": "vo_adv_1258003_007",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "果汁店的老闆",
    "words": "\\n",
