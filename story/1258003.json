    "type": "dialogue",
    "name": "莉莉",
    "words": "兄長大人他為了我這種人，",
    "voice": "vo_adv_1258003_014",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n特地挪出寶貴的時間。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "因此即便只是微薄的謝禮，",
