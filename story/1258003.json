    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……呼……",
    "voice": "vo_adv_1258003_033",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "思慮過度，",
    "voice": "vo_adv_1258003_034",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "再加上商店街擁擠人潮的熱度……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n讓我的頭又更暈了。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……不過……",
