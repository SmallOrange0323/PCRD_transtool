    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "串燒店的老闆",
    "words": "歡迎看看喔！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "串燒店的老闆",
    "words": "\\n烤雞肉串和烤豬肉串，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "串燒店的老闆",
    "words": "全都～是新鮮現烤的喔～！",
