    "type": "dialogue",
    "name": "果汁店的老闆",
    "words": "我可以給妳折扣當作是見面禮唷～♪",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "啊……！",
    "voice": "vo_adv_1258003_008",
    "unit_id": 125812
