  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "手把手地教導我",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n作為冒險者的須知事項。",
    "voice": null,
    "unit_id": 125812
  },
