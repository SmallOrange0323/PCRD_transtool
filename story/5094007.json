    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "也要享受景色和對話……",
    "voice": "vo_adv_5094007_057",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "像這些露營才有的下酒菜，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n正是能改變人生的露營暢飲啊。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "因此，",
    "voice": "vo_adv_5094007_058",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "既然現在交到了三個露營夥伴，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我想一定能喝到最棒的那一杯吧。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這都是你們露營夥伴的功勞，",
    "voice": "vo_adv_5094007_059",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "謝謝你們。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "所以說……",
    "voice": "vo_adv_5094007_060",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就是這樣，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我們來吃飯吧？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "大家也都肚子餓了吧？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這麼說也對。",
    "voice": "vo_adv_5094007_061",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "既然也和少年會合了，",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我們就來吃飯吧。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這次就別再煮蘑菇了。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那就來煮露營餐吧！",
    "voice": "vo_adv_5094007_062",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n讓我為大家",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "大展廚藝！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一行人開心用完餐後，",
