[
  {
    "type": "background",
    "bg_id": "501590"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "碧一行人恢復了理智，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n準備重新開始團體露營──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗚嗚……",
    "voice": "vo_adv_5094007_000",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "在我們吃著蘑菇的時候，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "火堆熄滅了……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "沒問題的，",
    "voice": "vo_adv_5094007_001",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我和純準備了一堆柴火。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n振作起來，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "重新準備吧。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_5094007_002",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小優花梨說得沒錯，",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "假還長得很呢。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n先升火重新開始露營，",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "讓心情冷靜下來吧。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦～！？",
    "voice": "vo_adv_5094007_003",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你要回去了嗎？",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n這這這這、",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這是為什麼啊！？",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哦……",
    "voice": "vo_adv_5094007_004",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你帶野營道具，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "只是怕搜索我們的時間拖得太久……？",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這樣啊……",
    "voice": "vo_adv_5094007_005",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n你來露營區",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "並不是為了度假……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣的情況，",
    "voice": "vo_adv_5094007_006",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我們也不能硬要你留下來呢……",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "…………請、",
    "voice": "vo_adv_5094007_007",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請等一下！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我……",
    "voice": "vo_adv_5094007_008",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "之前都是在",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n心情非常沮喪的時候，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "一個人進行這個稱作露營的活動。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "收集掉在地上的木材，",
    "voice": "vo_adv_5094007_009",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "搭帳篷、製作椅子，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嘴饞的時候開心品嘗想吃的東西，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "然後，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "晚上靜靜眺望著星空……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我的露營",
    "voice": "vo_adv_5094007_010",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就是這樣獨自一人度過的活動……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "雖然我本身",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "覺得那樣也是過得蠻開心的。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "可是，",
    "voice": "vo_adv_5094007_011",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這次優花梨小姐和純小姐邀我一起參加，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "讓我知道了跟別人一起露營的樂趣！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "並列著搭起帳篷，",
    "voice": "vo_adv_5094007_012",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "討論對方使用的道具，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n大家分頭準備要吃的料理，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還有，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "圍坐在火堆前，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "七嘴八舌談天說地……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "雖然各方面來看，",
    "voice": "vo_adv_5094007_013",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "料理是嚴重失敗了……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但是！",
    "voice": "vo_adv_5094007_014",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "三個人一起露營",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "非常開心！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n這種事",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "在我一個人露營的時候，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n簡直無法想像！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我獨自一人一直進行的露營，",
    "voice": "vo_adv_5094007_015",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n有著單人露營才能體會得到的樂趣……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "跟優花梨小姐和純小姐三個人一起進行的團體露營，",
    "voice": "vo_adv_5094007_016",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n有著只有我們三人才能體會得到的樂趣……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "也就是說……",
    "voice": "vo_adv_5094007_017",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "加入了{0}的四人團體露營，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我想應該也能體會到前所未有的樂趣吧！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我相信一定，",
    "voice": "vo_adv_5094007_018",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "能體驗到日常生活感受不到的暢快感，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還有平常難以啟齒的事情，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n應該也敢開口聊吧……！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "所以說，",
    "voice": "vo_adv_5094007_019",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "{0}的意下如何？",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……來、",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "來跟我們一起……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "露營吧？",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……啊！",
    "voice": "vo_adv_5094007_020",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你也在的話，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "相信露營應該……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是絕對會很開心的！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那麼，",
    "voice": "vo_adv_5094007_021",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我來幫忙紮營吧！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n也麻煩優花梨小姐妳們一起幫忙了！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "純、優花梨",
    "words": "嗯！\\n好！",
    "voice": "vo_adv_5094007_022",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501592"
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……來，",
    "voice": "vo_adv_5094007_023",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "各位，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請喝咖啡。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n趁還沒冷掉之前享用吧。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯，",
    "voice": "vo_adv_5094007_024",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "非常好喝哦。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n濃郁的香氣中",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還帶有微微的甜味呢。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……嗯！",
    "voice": "vo_adv_5094007_025",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這跟平常在工作中喝的",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "截然不同耶！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呵呵呵，",
    "voice": "vo_adv_5094007_026",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真高興能看到大家喝得這麼開心！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒枉費我用心地泡咖啡了！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "小碧，",
    "voice": "vo_adv_5094007_027",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "可以把這些咖啡豆分給我們的公會嗎？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我會請秋乃付妳開的價錢！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不、",
    "voice": "vo_adv_5094007_028",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不用啦！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "想要多少我都可以給哦！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "畢竟我也一直受領班和珠希照顧啊！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說到泡得好喝的祕訣……",
    "voice": "vo_adv_5094007_029",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n除了當然要照正確步驟沖泡外，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還要在心中",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "「變好喝……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "變好喝……」",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這樣默念！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "透過與咖啡豆心靈相通，",
    "voice": "vo_adv_5094007_030",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就能引出其本身的美味哦！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呵呵，",
    "voice": "vo_adv_5094007_031",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "聽起來真有趣。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我會跟公會的所有人一起試看看的。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哎呀～",
    "voice": "vo_adv_5094007_032",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "過去連想都沒想過，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我竟然能跟別人分享這個味道呢！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呼……",
    "voice": "vo_adv_5094007_033",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團體露營",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真棒……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是啊…………",
    "voice": "vo_adv_5094007_034",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n妳說得",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "一點都沒錯……",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……",
    "voice": "vo_adv_5094007_035",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n因為我正在消化特休啊……",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這次",
    "voice": "vo_adv_5094007_036",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是小智她們叫我放假。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n雖然我不需要，",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但我不能無視體恤我的部下的建言。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "起初我是做著高地訓練來度過假期，",
    "voice": "vo_adv_5094007_037",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不過在遇到小優花梨之後，",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "讓我發現到休息的重要性。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "假如我沒放假，",
    "voice": "vo_adv_5094007_038",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "總是繃緊神經的話，",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這股緊張感應該也會傳染給部下們吧。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那樣一來，",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "遇到萬一就有可能會動彈不得……",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "透過我更有彈性的執勤態度，",
    "voice": "vo_adv_5094007_039",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n應該可以替整個團隊帶來",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "正面的效果吧。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "把這次的露營作為教訓，",
    "voice": "vo_adv_5094007_040",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我決定往後",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在合理的範圍內",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "放假休息。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "當然",
    "voice": "vo_adv_5094007_041",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "光只有我這麼悠哉也沒意義。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n未來我想以體恤團員的名義，",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "跟大家一起露營呢。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "{0}也來找出",
    "voice": "vo_adv_5094007_042",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "屬於你自己開心享受露營的方式吧。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要在火堆前重新面對自己也行，",
    "voice": "vo_adv_5094007_043",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要吐露平常說不出口的事情也行，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請你盡情地自由度過吧！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要是有任何能幫上忙的地方，",
    "voice": "vo_adv_5094007_044",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我會盡全力努力幫的！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "而且，",
    "voice": "vo_adv_5094007_045",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "之前在蘭德索爾，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我還擺出很失禮的態度……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那是BB團不該有的舉止……",
