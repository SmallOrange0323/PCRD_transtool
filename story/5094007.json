    "voice": "vo_adv_5094007_046",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我想也為那件事道歉，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "透過露營好好招待你。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我還不敢以",
    "voice": "vo_adv_5094007_047",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "優花梨小姐和純小姐的朋友自居，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但、",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但是我覺得我們是露營夥伴。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "或許靠我一個邊緣人",
    "voice": "vo_adv_5094007_048",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "成不了大事……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但是，",
    "voice": "vo_adv_5094007_049",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "跟露營夥伴一起的話，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我想{0}也能過得很開心吧。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "露營夥伴……",
    "voice": "vo_adv_5094007_050",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "聽起來真棒。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "跟酒友不太一樣，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是令人覺得很舒服的關係呢。",
