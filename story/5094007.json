    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_5094007_051",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是啊。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n是互相",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "都不用太拘謹的關係呢。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嘿嘿，",
    "voice": "vo_adv_5094007_052",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "能聽妳們這麼說讓我放心了。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我也……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "很高興能交到露營夥伴！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我也想跟{0}",
    "voice": "vo_adv_5094007_053",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "當BB團的同志",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "兼露營夥伴！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "…………我說，",
    "voice": "vo_adv_5094007_054",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "抱歉在你們相談甚歡時插嘴……",
