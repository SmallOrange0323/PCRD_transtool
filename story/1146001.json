  {
    "type": "dialogue",
    "name": "旁白",
    "words": "結束【墨丘利財團】工作的優花梨，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n久違地來到了常去的餐廳。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "唔嗯～！",
    "voice": "vo_adv_1146001_000",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "果然工作結束後喝的麥酒最棒了～！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "哎呀，",
    "voice": "vo_adv_1146001_001",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "這不是優花梨嘛。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "要不要來我這裡喝一杯？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呵呵，",
    "voice": "vo_adv_1146001_002",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好哇。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那我就來打擾囉。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "這樣才對嘛！",
    "voice": "vo_adv_1146001_003",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "那麼首先，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "乾杯～！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "乾杯～！",
    "voice": "vo_adv_1146001_004",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咕嘟、",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咕嘟、",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咕嘟……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "噗哈～！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "呵呵，",
    "voice": "vo_adv_1146001_005",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "妳那豪邁的喝法還真是沒變呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "上次見到優花梨",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "已經是好一陣子前了呢，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n妳工作很忙嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "算是吧～～",
    "voice": "vo_adv_1146001_006",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "畢竟是聖誕季，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "有很多事情要忙呢。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但現在總算告一段落了，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "應該能輕鬆一段時間吧。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "話說回來，",
    "voice": "vo_adv_1146001_007",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這間店的客層",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是不是變了？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n總覺得成對的客人特別多耶……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "真是的～",
    "voice": "vo_adv_1146001_008",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "優花梨妳在說什麼啊。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "聖誕節前夕這樣很正常啊。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦？",
    "voice": "vo_adv_1146001_009",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "對耶！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "所以情侶才這麼多啊～！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就是說啊……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "現在是這種時期呢……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……那麼，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "妳呢……？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "我嗎？",
    "voice": "vo_adv_1146001_010",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "我男友",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "要到聖誕節當天才有空～",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "當然，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "那天的行程是一整天膩在一起♪",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這、",
    "voice": "vo_adv_1146001_011",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這樣啊？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "喔～",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "她、",
    "voice": "vo_adv_1146001_012",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "她有男友啊……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "那優花梨呢？",
    "voice": "vo_adv_1146001_013",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我、",
    "voice": "vo_adv_1146001_014",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我嗎？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我呢……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "沒有特別的事……",
    "voice": "vo_adv_1146001_015",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不，應該說根本沒有行程……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "話雖如此，就只有我一個人無所事事也太淒涼了……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "反正她那天要跟男友約會，也不會和我見面……",
    "voice": "vo_adv_1146001_016",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "稍微裝模作樣一下應該",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "沒關係吧……？　",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我也和妳一樣喔！",
    "voice": "vo_adv_1146001_017",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "啊哈哈，",
    "voice": "vo_adv_1146001_018",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "也是，要不然妳也不會聖誕前夕",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n一個人窩在這喝酒了嘛～",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就、",
    "voice": "vo_adv_1146001_019",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就是說啊。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊哈哈哈……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "一豁出去就裝過頭了……",
    "voice": "vo_adv_1146001_020",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊～",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "真是的！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我這個笨蛋笨蛋笨蛋！　",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "所以啊，",
    "voice": "vo_adv_1146001_021",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "優花梨的男友是什麼樣的人啊？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n我好好奇喔～",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這個、",
    "voice": "vo_adv_1146001_022",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "嘛……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "說到我很熟的男生……",
    "voice": "vo_adv_1146001_023",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "也就只有他了吧……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那個啊……",
    "voice": "vo_adv_1146001_024",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "他的年紀",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "比我小……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "哦～～",
    "voice": "vo_adv_1146001_025",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "有點意外耶。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "原來優花梨喜歡年紀小一點的類型啊～～",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "啊，",
    "voice": "vo_adv_1146001_026",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "該不會是因為沒有理想型，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "所以乾脆自己養成一個吧？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不、",
    "voice": "vo_adv_1146001_027",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不是那樣啦。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "雖然他也是有讓人放心不下的地方……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但他遇到陷入困境的人，會和對方一起煩惱、阻止對方犯錯……",
    "voice": "vo_adv_1146001_028",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "也會繼續在對方身邊提供幫助，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "還很有責任感……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "像我上次喝過頭的失敗之類的……",
    "voice": "vo_adv_1146001_029",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "該怎麼說，",
    "voice": "vo_adv_1146001_030",
    "unit_id": 103411
  },
  {
