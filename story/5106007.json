  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "當然在天亮之前，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
