    "name": "拉菲",
    "words": "當然啊！",
    "voice": "vo_adv_5106007_048",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n請純小姐一定要跟我們一起同樂！",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "然後然後！？",
    "voice": "vo_adv_5106007_049",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n我們要去哪間店",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "吃午餐！？",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "不，",
    "voice": "vo_adv_5106007_050",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "我們向有交情的人，",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n租借了沒有在使用的店面……",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "有交情的人？",
    "voice": "vo_adv_5106007_051",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "蘭德索爾有妳們認識的人了嗎？",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "其實啊～",
    "voice": "vo_adv_5106007_052",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我們一起復原亂七八糟的街道、",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n幫忙撿垃圾的時候，",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "有些被艾米變幸福的人，",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "也一起來幫忙了！",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "之前大家不是還分享魔力給我們嗎？",
    "voice": "vo_adv_5106007_053",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "這次真的收到了很多人的善意……",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "蘭德索爾的人真溫暖。",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "艾米，",
    "voice": "vo_adv_5106007_054",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "太好了呢。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "這一切",
    "voice": "vo_adv_5106007_055",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "都要歸功於在場的所有人。",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "請收下我們的禮物吧。",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "就是這樣，",
    "voice": "vo_adv_5106007_056",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n歡迎來到天使的聖誕派對！",
    "voice": null,
    "unit_id": 5512
  },
