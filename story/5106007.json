    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "哇啊！",
    "voice": "vo_adv_5106007_044",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我最愛驚喜了！",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n妳再講詳細一點吧♪",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "聖誕節當天。",
