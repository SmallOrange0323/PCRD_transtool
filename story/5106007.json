    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "拉菲、",
    "voice": "vo_adv_5106007_045",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "艾米！",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n謝謝妳們邀請我們",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "參加派對！",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "舉辦派對和邀請都好突然，",
    "voice": "vo_adv_5106007_046",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我雖然嚇了一跳……",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不過，",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我沒什麼參加派對的經驗，所以很開心。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "純",
