    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "茜里小姐一直在考慮這些啊。",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "繼續",
    "voice": "vo_adv_5106007_039",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "窺探她的內心有點沒禮貌，",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n我們就來想想要送什麼禮物吧。",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那當然！",
    "voice": "vo_adv_5106007_040",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n所以！？",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "要送給依里她們什麼樣的禮物！？",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "……召集大家",
