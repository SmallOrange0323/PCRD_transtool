    "type": "dialogue",
    "name": "依里的訊息",
    "words": "\\n這次",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里的訊息",
    "words": "我不會隱忍著退讓了，妳放心！」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里的訊息",
    "words": "「就像茜里總是希望我得到幸福，",
    "voice": "vo_adv_5106007_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里的訊息",
    "words": "\\n我也",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里的訊息",
    "words": "希望茜里能得到幸福喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里的訊息",
    "words": "\\n妳可愛的姊姊　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里的訊息",
    "words": "依里敬上。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "510600702"
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……姊姊，",
    "voice": "vo_adv_5106007_028",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里最喜歡妳了。",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "謝謝你們",
    "voice": "vo_adv_5106007_029",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "給茜里這麼棒的聖誕禮物。",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥，",
    "voice": "vo_adv_5106007_030",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "請讓茜里參加",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "遊戲會！",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "然後，可以教茜里",
