    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "真不錯！",
    "voice": "vo_adv_5106007_042",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "這樣的話可以也邀請純小姐嗎！？",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n她很照顧我們，",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "服裝的事我也還沒道歉……",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "不錯的提案。",
    "voice": "vo_adv_5106007_043",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n我是還想要",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "給他們其他的驚喜……",
