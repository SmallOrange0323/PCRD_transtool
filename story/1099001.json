  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "午後的蘭德索爾街上，\\n有名四處東張西望的銀髮少女。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "呃……",
    "voice": "vo_adv_1099001_000",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "剛剛在這裡右轉……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咦？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "走到和剛才不一樣的地方了？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那",
    "voice": "vo_adv_1099001_001",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "先回去剛才的地方……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "等等，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "剛才是從哪裡來的……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯～",
    "voice": "vo_adv_1099001_002",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "到底是哪裡呢？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我是",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "右撇子，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "感覺應該會選右邊……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "可是",
    "voice": "vo_adv_1099001_003",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "這如果不問剛才的我，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n又沒自信能確定",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真的是這樣……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咦？",
    "voice": "vo_adv_1099001_004",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "啊、{0}！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "居然在這種地方碰到，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真是非～常巧呢。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "{0}才是，",
    "voice": "vo_adv_1099001_005",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n在這種地方做什麼……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "啊，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你迷路了呢。",
    "voice": "vo_adv_1099001_006",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "所以，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你因為不安",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "才來和我搭話的對吧。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──喂喂，莉雅。",
    "voice": "vo_adv_1099001_007",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那怎麼可能啊，",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "別說那種奇怪的話了。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "唔，",
    "voice": "vo_adv_1099001_008",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "帕克！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n你說奇怪的話是什麼意思？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "還有什麼意思，",
    "voice": "vo_adv_1099001_009",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n這個人",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "是在擔心形跡可疑的莉雅。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "所以才會來跟妳搭話的，這還用說嗎。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我、",
    "voice": "vo_adv_1099001_010",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我才沒有形跡可疑呢！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "只是",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "稍微有點",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "迷路而已。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "只是稍微有點",
    "voice": "vo_adv_1099001_011",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "分不清東西南北而已。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "她逞強的樣子很可愛對吧，",
    "voice": "vo_adv_1099001_012",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "我的女兒。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "你不這麼認為嗎？",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "帕克！",
    "voice": "vo_adv_1099001_013",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "是是，別生氣別生氣。",
    "voice": "vo_adv_1099001_014",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "再說，",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "這還不是莉雅的錯。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "妳不是要證明偶爾不依賴我，",
    "voice": "vo_adv_1099001_015",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n也能自己一個人好好振作嗎？",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "然而，",
    "voice": "vo_adv_1099001_016",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n我看著卻一直覺得忐忑不安。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "因為",
    "voice": "vo_adv_1099001_017",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "來這裡有一段時間了呀，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我想",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "也不能總是",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "依靠帕克和拉姆她們……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "這想法是很了不起，",
    "voice": "vo_adv_1099001_018",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "但是太危險了。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "不過，",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "啊，",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "我想到好主意了。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "我說你。",
    "voice": "vo_adv_1099001_019",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n現在有時間嗎？",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "可以陪一下莉雅嗎？",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "等等，",
    "voice": "vo_adv_1099001_020",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "帕克真是的，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n你不可以麻煩{0}啦。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "這是折衷方案啊，",
    "voice": "vo_adv_1099001_021",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "折衷方案。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "莉雅今天也不想依賴我吧？",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "只能拜託這個人了不是嗎？",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯～",
    "voice": "vo_adv_1099001_022",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那樣子感覺",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不會有點狡猾嗎……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "別在意別在意。",
    "voice": "vo_adv_1099001_023",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "那麼，",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "你的意思如何呢？",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "願意接受嗎？",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "妳看，",
    "voice": "vo_adv_1099001_024",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "這個人是好人啊。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "那",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "莉雅就拜託你了～♪",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真是的，",
    "voice": "vo_adv_1099001_025",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n帕克真是想說什麼就說什麼……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "對不起，",
    "voice": "vo_adv_1099001_026",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "把你給捲進來了。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你如果有其他事情的話，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不用在意我沒關係……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
