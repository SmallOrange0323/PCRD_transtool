    "words": "總覺得",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "他好像比剛剛更強了說。",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不是妳的錯覺。",
    "voice": "vo_adv_5050302_001",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我想他應該是吸收精氣增強力量了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "放著不管的話他會變得越來越強吧？",
    "voice": "vo_adv_5050302_002",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "得要盡快打倒他才行。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就是比速度對吧！",
    "voice": "vo_adv_5050302_003",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我可是",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "很擅長快速移動的！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然應該不是這個問題，",
    "voice": "vo_adv_5050302_004",
