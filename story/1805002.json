  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某一天的午後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這天，可可蘿也仍在照顧{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "右手出布，",
    "voice": "vo_adv_1805002_000",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "左手出布……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "變成凱留小姐的耳朵♪",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐的耳朵～♪",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵，",
    "voice": "vo_adv_1805002_001",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "學得很棒呢，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼，",
    "voice": "vo_adv_1805002_002",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來挑戰下一個吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "右手出拳頭，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "左手出剪刀……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "有人在嗎～",
    "voice": "vo_adv_1805002_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哦？",
    "voice": "vo_adv_1805002_004",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不曉得會是誰來拜訪？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還請在這稍等一會。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "不好意思突然來打擾。\\n{0}呢……？",
    "voice": "vo_adv_1805002_005",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要找主人的話，",
    "voice": "vo_adv_1805002_006",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "他就在這裡……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "噢，太好了。",
    "voice": "vo_adv_1805002_007",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "\\n我是",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "他打工的地方，也就是郵差公會的成員……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "雖然我之前就已得知他打算長期休假，",
    "voice": "vo_adv_1805002_008",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "\\n但這次無論如何都希望{0}能幫忙……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "\\n因此，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "我今天才會前來拜訪。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "事情是這樣的，",
    "voice": "vo_adv_1805002_009",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "由於送貨人員不足和委託數量增加，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "我們的送貨進度已開始落後……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "還請你們好心幫幫忙，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "今天一天就好，可以來幫忙送貨嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔……",
    "voice": "vo_adv_1805002_010",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n畢竟是主人平時受到很多關照的打工雇主，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "考量到往後，也不好就此拒絕。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人他……",
    "voice": "vo_adv_1805002_011",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "目前身體有些不適，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就由在下來替他送貨吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也多少",
    "voice": "vo_adv_1805002_012",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "對蘭德索爾這地區有些熟悉了，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n應能派上用場的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "真的可以嗎？",
    "voice": "vo_adv_1805002_013",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "非常感謝！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "我待會就把貨物跟",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "記載著收件地點的地圖拿過來！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……雖然就這樣",
    "voice": "vo_adv_1805002_014",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "接下了工作……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但在下也無法扔下主人孤身一人，",
    "voice": "vo_adv_1805002_015",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "自己跑出去送貨。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過，只是去送貨的話，應該沒什麼危險，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "若出了什麼事，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "鎮上的大家應該也會伸出援手的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼主人，",
    "voice": "vo_adv_1805002_016",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "待會就和在下一起",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "出門散步吧♪",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "──請在此處",
    "voice": "vo_adv_1805002_017",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "蓋上印章簽收。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "沒問題～",
    "voice": "vo_adv_1805002_018",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "辛苦啦！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼……",
    "voice": "vo_adv_1805002_019",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "送完剛才那一戶，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個地區的貨物就全解決了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看樣子似乎可以平安結束送貨工作，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下感到安心多了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": "vo_adv_1805002_020",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "出來散步感覺如何呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那真是太好了。",
    "voice": "vo_adv_1805002_021",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "今日天氣也不錯，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "相當適合散步呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼，",
    "voice": "vo_adv_1805002_022",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "往下個地區前進吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下看看，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "接下來是……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "根據地圖所標示，",
    "voice": "vo_adv_1805002_023",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "應當在這附近才是……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真古怪，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "遍尋不著感覺像是目標的宅邸呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": "vo_adv_1805002_024",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您知道",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這戶人家在哪嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": "vo_adv_1805002_025",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您莫非",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是睏了？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "畢竟說是散步，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還比較像是做了充分的運動，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n會想睡也是情有可原。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "回去後",
    "voice": "vo_adv_1805002_026",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就來睡午覺吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只不過，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在那之前得完成送貨工作才行……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "地圖上的標示是，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呃……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "啊！",
    "voice": "vo_adv_1805002_027",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "是大哥哥～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "喂～！",
    "voice": "vo_adv_1805002_028",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "來一起玩嘛～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔？",
    "voice": "vo_adv_1805002_029",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
