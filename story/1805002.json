  {
    "type": "dialogue",
    "name": "主婦3",
    "words": "可可蘿，",
    "voice": "vo_adv_1805002_058",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "主婦3",
    "words": "洗好的碗盤放在那邊的棚架上可以吧？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的，",
    "voice": "vo_adv_1805002_059",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "碗盤請放在那邊……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔唔……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "果然還是",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "讓在下也幫忙吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "不用啦，",
    "voice": "vo_adv_1805002_060",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "沒關係。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "家事就交給我們吧。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "\\n大家可都是經驗相當老道的家庭主婦了，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但、",
    "voice": "vo_adv_1805002_061",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也不能就這樣全都讓各位幫忙呀……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "我們平時",
    "voice": "vo_adv_1805002_062",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "都很受他的關照，這彼此互相照顧一下而已啦。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "而且呀，",
    "voice": "vo_adv_1805002_063",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "他在送貨時，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "\\n老是會吃可可蘿讓他帶在身上的飯糰，吃得津津有味呢。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "「多虧了這個，我才能如此努力」。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "他之前是這麼對我說的。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "所以呢，",
    "voice": "vo_adv_1805002_064",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "我們平時能夠得到他的關照，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "\\n說到頭來，也是多虧了可可蘿妳唷。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "我們一直以來都很想找機會回報一下，",
    "voice": "vo_adv_1805002_065",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "主婦1",
    "words": "因此，可可蘿妳就和他一起好好地休息吧。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "still",
    "still_id": "180500201"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下為主人捏飯糰時，",
    "voice": "vo_adv_1805002_066",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也並未考慮到如此長遠的層面。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下只是，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一心一意想為主人送貨的工作出份力，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n然後將這份心意捏進每一個飯糰中而已。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "未料在下為主人的奉獻，",
    "voice": "vo_adv_1805002_067",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "竟在因緣際會之下，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "回報到自身上，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n此事在下著實始料未及。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "still",
    "still_id": "180500202"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但也多虧如此，",
    "voice": "vo_adv_1805002_068",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "今日在下才能",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "與主人如此共度時光。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為了主人……",
    "voice": "vo_adv_1805002_069",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還有，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為了大家，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下得再更誠心奉獻才行呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但在那之前……",
    "voice": "vo_adv_1805002_070",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下就順著大家的好意，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n和主人",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一同悠閒度過今日吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": "vo_adv_1805002_071",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感謝您今日陪伴在下",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n去進行在下不太熟悉的送貨工作。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您一定相當累了吧。",
    "voice": "vo_adv_1805002_072",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n老實說，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也走到有些累了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們一起",
    "voice": "vo_adv_1805002_073",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "睡午覺吧……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "可可蘿讓{0}的頭靠在自己肩上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n露出安詳的表情，進入了夢鄉。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  }
]
