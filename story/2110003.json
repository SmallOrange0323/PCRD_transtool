    {
        "name": "克蕾琪塔",
        "words": "秘書一號！？",
        "voice": "vo_adv_2110003_126"
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n妳怎麼還在這裡到處閒晃啊！？",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "因為很危險，我不是叫妳趕緊去避難了！",
        "voice": null
    },
    {
        "name": "秘書",
        "words": "有危險的是克蕾琪塔小姐吧。",
        "voice": "vo_adv_2110003_127"
    },
    {
        "name": "秘書",
        "words": "\\n竟然單槍匹馬地，",
