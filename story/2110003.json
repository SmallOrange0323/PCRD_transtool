    },
    {
        "name": "尾狗刀",
        "words": "做出成果吧。",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "\\n我還得先洗清自己",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "被認為是故意放走那名少年的嫌疑呢。",
