    },
    {
        "name": "彌勒",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "一心想成為「神」的他，",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "想必也是認為身為權力者一事，",
