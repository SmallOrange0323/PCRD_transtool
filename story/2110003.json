    },
    {
        "name": "彌勒",
        "words": "不過……",
        "voice": "vo_adv_2110003_098"
    },
    {
        "name": "彌勒",
        "words": "那只是為了我們的目的，",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n只不過是輔助「神」降臨的道具之一。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n要是你有",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "與目的不同的打算……",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "真是的──",
        "voice": "vo_adv_2110003_099"
    },
    {
        "name": "尾狗刀",
        "words": "\\n你是不是太緊張過度了啊？",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "\\n我只是讓那個女人溜掉，",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "就這麼吹毛求疵──",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "我不是在說那個女人的事。",
        "voice": "vo_adv_2110003_100"
    },
    {
        "name": "彌勒",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "話說回來，",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "身為公主騎士的少年",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "被替換成萬能人偶這件事，",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n你當時在場就已經注意到了吧？",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "咦？",
        "voice": "vo_adv_2110003_101"
    },
    {
        "name": "尾狗刀",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "什麼嘛──",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "\\n這怎麼可能呢。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "抱歉，",
        "voice": "vo_adv_2110003_102"
    },
    {
        "name": "彌勒",
        "words": "\\n我問了一個毫無意義的問題。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n假如真是如此，",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "你也不可能會承認吧。",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "……",
        "voice": "vo_adv_2110003_103"
    },
    {
        "name": "彌勒",
        "words": "你的確很有能力。",
        "voice": "vo_adv_2110003_104"
    },
    {
        "name": "彌勒",
        "words": "\\n但我不認為你是真心提供協助的。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "你不惜犧牲甚多，",
        "voice": "vo_adv_2110003_105"
    },
    {
        "name": "彌勒",
        "words": "來協助讓「神」復活──",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "你究竟是想",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "從中獲得什麼呢？",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "……",
        "voice": "vo_adv_2110003_106"
    },
    {
        "name": "尾狗刀",
        "words": "我想，",
        "voice": "vo_adv_2110003_107"
    },
    {
        "name": "尾狗刀",
        "words": "這才是真正毫無意義的提問吧？",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "因為就算真是這樣，",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "我也不可能會告訴你嘛──",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "比起這個，",
        "voice": "vo_adv_2110003_108"
    },
    {
        "name": "尾狗刀",
        "words": "我才想問你呢。",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "\\n使「她」恢復原狀後要怎麼辦，",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "你還沒說過吧？",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "呵呵。",
        "voice": "vo_adv_2110003_109"
    },
    {
        "name": "彌勒",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "這沒什麼大不了的。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n因為，",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "我也對地位和權力不感興趣。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "沒錯──",
        "voice": "vo_adv_2110003_110"
    },
    {
        "name": "彌勒",
        "words": "曾經身為這王座主人的那位霸瞳皇帝。",
