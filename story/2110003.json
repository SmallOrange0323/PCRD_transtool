    },
    {
        "name": "彌勒",
        "words": "團隊嗎？",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "喂，",
        "voice": "vo_adv_2110003_093"
    },
    {
        "name": "尾狗刀",
        "words": "大姊。",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "\\n既然腳可以動的話，",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "勸妳還是快逃吧。",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "……唔！",
