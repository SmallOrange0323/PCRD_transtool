    },
    {
        "name": "克蕾琪塔",
        "words": "就是說啊。",
        "voice": "vo_adv_2110003_132"
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n這就是所謂不幸中的大幸吧。",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "然後呢。",
        "voice": "vo_adv_2110003_133"
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n蘭德索爾市內現況如何？",
