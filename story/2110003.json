    },
    {
        "name": "克蕾琪塔",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "但深入虎穴還是有收穫的。",
        "voice": null
    },
    {
        "name": "秘書",
        "words": "所以，",
        "voice": "vo_adv_2110003_129"
    },
    {
        "name": "秘書",
        "words": "您是指？",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "至少",
        "voice": "vo_adv_2110003_130"
    },
    {
        "name": "克蕾琪塔",
        "words": "陛下和少年他們，",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n似乎從險境裡安全逃脫了。",
