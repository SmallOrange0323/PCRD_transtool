    },
    {
        "name": "彌勒",
        "words": "都是你的功勞。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n關於這件事，",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "我對你感激不盡。",
