    },
    {
        "name": "尾狗刀",
        "words": "結果反而是我被試探了。",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "\\n誰叫他那邊的手牌比較多，",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "這也是沒辦法的事。",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "算了，也沒差了。",
        "voice": "vo_adv_2110003_122"
    },
    {
