    },
    {
        "name": "彌勒",
        "words": "\\n我很期待你的表現喔。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n尾狗刀先生。",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "是是。",
        "voice": "vo_adv_2110003_119"
    },
    {
        "name": "尾狗刀",
        "words": "\\n那就掰啦──",
        "voice": null
    },
    {
        "type": "background",
        "bg_id": "500095"
    },
    {
        "name": "尾狗刀",
        "words": "……呼。",
        "voice": "vo_adv_2110003_120"
    },
    {
        "name": "尾狗刀",
        "words": "原本想試探他一下，",
