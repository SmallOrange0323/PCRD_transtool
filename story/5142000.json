    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "惠理子大人！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "有您來替我們教育新兵，",
    "voice": "vo_adv_5142000_066",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n我們【王宮騎士團】訓練所",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n想必能達到更高的境界！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "啊啊……！！",
    "voice": "vo_adv_5142000_067",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n還請您栽培薰陶新兵們吧……！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n順便連同我也一起～～～！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "沒什麼大不了的。",
    "voice": "vo_adv_5142000_068",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "只是稍微",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "讓他變得比較容易答應我的請求而已。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "比起這個……！",
    "voice": "vo_adv_5142000_069",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "請您等我，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n我一定會",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "帶著勳章回來的！",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "啊啊……！",
    "voice": "vo_adv_5142000_070",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您真是太無欲無求了。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n這樣的您",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "也好棒。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "但是不用客氣，",
    "voice": "vo_adv_5142000_071",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n我可是您的伴侶。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "無論您許了什麼願望，我都會實現的！",
    "voice": null,
    "unit_id": 129911
  },
  {
