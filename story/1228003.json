  {
    "type": "dialogue",
    "name": "旁白",
    "words": "下了船後，{0}和禊走在海灘上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這時兩人看見了一家大排長龍的店面。",
    "voice": null,
    "unit_id": null
  },
