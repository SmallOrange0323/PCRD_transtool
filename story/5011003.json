    "type": "dialogue",
    "name": "璃乃",
    "words": "所謂的愛，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "難道對方未對妳動心",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就沒有意義了嗎？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "咦？",
    "voice": "vo_adv_5011003_037",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我",
    "voice": "vo_adv_5011003_038",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "最喜歡哥哥了，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n所以只是和他在一起，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我就覺得很幸福了。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為想在一起，所以我會付出行動，",
    "voice": "vo_adv_5011003_039",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n因為最喜歡他，才想將很多愛傳達給他。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "可可亞烏拉",
    "words": "巧克♪",
    "voice": "vo_adv_5011003_040",
    "unit_id": 10911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呵呵，",
    "voice": "vo_adv_5011003_041",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我當然也最喜歡小可囉！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我們要一～直",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在一起喔！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "可可亞烏拉",
    "words": "巧克巧克♪",
    "voice": "vo_adv_5011003_042",
    "unit_id": 10911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "…………",
    "voice": "vo_adv_5011003_043",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "惠理子不是嗎？",
    "voice": "vo_adv_5011003_044",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我……",
