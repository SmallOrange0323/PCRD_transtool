    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對吧？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n總之希望這個回答能敷衍過去……！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "從我想擺脫邊緣人的角度來看，",
    "voice": "vo_adv_1346004_047",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "也被他們打動了！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我也",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好想有那種搭檔，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "想做做看那種互動……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n真的讓我",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "產生了那種想法呢！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗚，",
    "voice": "vo_adv_1346004_048",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好像在欺騙團長一樣，我好過意不去……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n但這也是",
