  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對不起……！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呃，",
    "voice": "vo_adv_1346004_049",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團長？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n你怎麼了，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "一直盯著我看……？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗚咦──！！？",
    "voice": "vo_adv_1346004_050",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n團團團團長，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你、",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你突然做什麼……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n在眾目睽睽之下！！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就算不是這樣也不太好啊！！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "電影院的客人1",
    "words": "啊～",
    "voice": "vo_adv_1346004_051",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "電影院的客人1",
    "words": "有人在做耶♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "電影院的客人1",
    "words": "\\n那個舉動，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "電影院的客人1",
    "words": "是剛才那部電影裡面出現過的對吧～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "電影院的客人1",
    "words": "\\n嗯～我可以理解想要模仿的心情啦。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "電影院的客人2",
    "words": "就是兩個人在街上擁抱那一幕嘛。",
    "voice": "vo_adv_1346004_052",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "電影院的客人2",
    "words": "\\n在典型的動作電影當中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "電影院的客人2",
    "words": "沒想到會出現那麼有戀愛感的發展……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "電影院的客人2",
    "words": "\\n現在真的很流行這樣呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "電影院的客人1",
    "words": "有些感想說會想和情侶一起來看，",
    "voice": "vo_adv_1346004_053",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "電影院的客人1",
    "words": "好像可以理解～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "電影院的客人1",
    "words": "\\n我下次也想和男朋友來看～♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "什麼──！！？",
    "voice": "vo_adv_1346004_054",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我沒聽說有這種陷阱啊！！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，",
    "voice": "vo_adv_1346004_055",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒有，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不是這樣……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n要說是認知的分歧，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還是不幸錯過呢……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "的很抱歉，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團長！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "其實我",
    "voice": "vo_adv_1346004_056",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "因為私人的原因，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "幾乎不記得電影的內容……！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我剛才是隨便配合你的話講，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對不起！！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我不想讓團長失望，",
    "voice": "vo_adv_1346004_057",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不想破壞開心的氣氛！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我的想法很膚淺吧，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真的非常抱歉！！！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦……？",
    "voice": "vo_adv_1346004_058",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n那樣我當然是很感激……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "可是你沒關係嗎？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "still",
    "still_id": "134600401"
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗚哇啊……",
    "voice": "vo_adv_1346004_059",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n不不不不，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這個……！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "作為主角的男性",
    "words": "「別開玩笑了。",
    "voice": "vo_adv_1346004_060",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "作為主角的男性",
    "words": "\\n這樣將來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "作為主角的男性",
    "words": "可要忙著當小鬼頭的保母啦。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "作為搭檔的女性",
    "words": "「哎呀，",
    "voice": "vo_adv_1346004_061",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "作為搭檔的女性",
    "words": "你不願意嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "作為搭檔的女性",
    "words": "\\n有時候這種人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "作為搭檔的女性",
    "words": "反而會成為溺愛小孩的父母喔。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這哪裡是動作大片啊！",
    "voice": "vo_adv_1346004_062",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要騙人看不同類型的電影也不是這樣的啊！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n明明就把心力放在主角和女主角的戀愛過程上面不是嗎！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n團長，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你居然能面無表情地看完啊！！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "甜蜜蜜的戀愛要素多到我都要消化不良了……！",
    "voice": "vo_adv_1346004_063",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我居然指著這個，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說我也想要有那種夥伴！？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我真的那麼說了嗎！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對團長說！？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我瘋了嗎！？　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "作為搭檔的女性",
    "words": "「哪天我們說給小孩聽吧。",
    "voice": "vo_adv_1346004_064",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "作為搭檔的女性",
    "words": "\\n爸爸和媽媽拯救了世界",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "作為搭檔的女性",
    "words": "的故事。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咿啊啊啊啊啊啊啊！！",
    "voice": "vo_adv_1346004_065",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n住手啊啊啊啊啊啊！！！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1346004_066",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "做為像電影一樣拯救了平行世界的獎勵，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這個夢再適合不過了對吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過話說回來，",
    "voice": "vo_adv_1346004_067",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "碧這個人",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "以旁觀者的角度看來，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n真的是個熱鬧又有趣的女生呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n雖然她本人那樣說，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但是身邊的大家也都對她印象很好吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你也做得很好。",
    "voice": "vo_adv_1346004_068",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "多虧有你，對碧來說，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這大概會是她難忘的回憶。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……從各方面來說都是。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "畢竟，",
    "voice": "vo_adv_1346004_069",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "聽到「想談一場像電影一樣的戀愛」這種話，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n當然會想要滿足她嘛。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……雖然要忽略",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她本人沒有這個意圖這點就是了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你也成長了許多，",
    "voice": "vo_adv_1346004_070",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "可以理解這種浪漫了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不枉費我一路看著你走來啊～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "之後也照這樣繼續努力吧。",
    "voice": "vo_adv_1346004_071",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n因為你是碧",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "無可替代的搭檔啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500980"
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "碧，",
    "voice": "vo_adv_1346004_072",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "騎士先生？",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n不可以邊駕駛邊打瞌睡啦，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "請快點起來～！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是、",
    "voice": "vo_adv_1346004_073",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是！",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我沒睡！",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n下次我會好好看電影……",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦？",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "你們兩個都還好嗎？",
    "voice": "vo_adv_1346004_074",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n你們好像突然同時失去意識，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "害我嚇了一跳。",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不，",
    "voice": "vo_adv_1346004_075",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我很好，",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我一直醒著！",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "也沒有做什麼奇怪的夢，",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對吧，團長！？",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒有沒有！",
    "voice": "vo_adv_1346004_076",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n那一定",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是你誤會啦～！！",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "哇～",
    "voice": "vo_adv_1346004_077",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "請不要在駕駛艙內亂動～！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "碧一行人拯救世界的冒險，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣劃下句點。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然而跨越時空建立起來的羈絆，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "將存在於各人的心中，\\n持續閃耀直到永遠。",
    "voice": null,
    "unit_id": null
  }
]
