    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "為了維護我的尊嚴！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真的",
    "voice": null,
