[
  {
    "type": "background",
    "bg_id": "500980"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "碧和{0}坐上巨型克蘿茜，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在傳送門內的異空間中前進。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "很快就能回到蘭德索爾了呢。",
    "voice": "vo_adv_1346004_000",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n感覺已經好久沒回去了！",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n希望大家也都平安……",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "是啊。",
    "voice": "vo_adv_1346004_001",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "回去之後我有好多話想跟大家說！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n例如碧和騎士先生的結婚典禮！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不不不克蘿茜小姐！",
    "voice": "vo_adv_1346004_002",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n那不太好！",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n百分之百會讓人誤會的，",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "所以希望妳能保守秘密～！",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "background",
    "bg_id": "500802"
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "我們從打倒的宇宙蓋登中",
    "voice": "vo_adv_1346004_003",
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "成功收回一部分米奈娃的力量。",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "\\n",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "不過或許是皇帝消滅後的影響，",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "力量好像正在急速消失。",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "但是只要趕緊處理，",
    "voice": "vo_adv_1346004_004",
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "應該就能打開門，",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "\\n送你們回到原本的世界。",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "\\n這部分的工作",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "就交給我們吧。",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我知道了！",
    "voice": "vo_adv_1346004_005",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n在那之前，",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我們會努力盡我們所能來幫忙的。",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "是啊，",
    "voice": "vo_adv_1346004_006",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "敵人的攻擊",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "四處破壞了許多建築物。",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "在回去的門打開之前，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我們就來幫忙重建城市吧。",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "好，",
    "voice": "vo_adv_1346004_007",
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "拜託你們了。",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "\\n",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "……雖然戰爭結束了，",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "但是要過上和平的日子還為時尚早。",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "\\n",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "應該會需要花上很長的時間來重建。",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "不過……",
    "voice": "vo_adv_1346004_008",
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "現在我們可以",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "慢慢開始往前走了。",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "\\n",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "我感覺將肩膀上的重擔卸下來了。",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "真的很謝謝你們。",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "師傅，",
    "voice": "vo_adv_1346004_009",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "之後妳打算怎麼辦？",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "和大家一樣啊。",
    "voice": "vo_adv_1346004_010",
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "\\n為這座城市，",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "以及",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "「我們的世界」的重建付出全力。",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "\\n",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "在那之後……",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "……我想去找他。",
    "voice": "vo_adv_1346004_011",
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "妳說的，",
    "voice": "vo_adv_1346004_012",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是這邊的團長嗎……？",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "其實……",
    "voice": "vo_adv_1346004_013",
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "在最後的戰役時，",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "\\n我看到一道光",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "離開蓋登的身體飛向天邊。",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "我覺得只要追著那道光走，",
    "voice": "vo_adv_1346004_014",
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "就能再次見到他。",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "\\n",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "我沒有明確的證據，",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "冥",
    "words": "可是我有這種感覺。",
    "voice": null,
    "unit_id": 53011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我知道了……",
    "voice": "vo_adv_1346004_015",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "太好了。",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n雖然我們只能幫到這邊，",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n但是妳要加油喔！",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "background",
    "bg_id": "500980"
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "如果是師傅，",
    "voice": "vo_adv_1346004_016",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "一定能再次見到那邊的團長。",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我們也在自己的世界",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "做我們能做的事情吧。",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗯……",
    "voice": "vo_adv_1346004_017",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "可以看見前方越來越亮了。",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我們已經到了嗎？",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "沒有沒有，",
    "voice": "vo_adv_1346004_018",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "好像還要",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "再一下子喔？",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n妳是不是看錯了？",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "可是，",
    "voice": "vo_adv_1346004_019",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我的眼前真的變得好亮……",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "究竟發生什麼事了啊～～！？",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "碧和{0}約在車站前碰面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "雖然還沒到約好的時間……",
    "voice": "vo_adv_1346004_020",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不過",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "依團長的個性，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說不定就快要來了……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n天啊天啊天啊，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我開始緊張了……！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我可是三個小時前就來了！",
    "voice": "vo_adv_1346004_021",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n畢竟，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "和團長去看電影可是重要活動啊！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n當然需要充足的時間做好心理準備吧！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "兩個人去電影院……",
    "voice": "vo_adv_1346004_022",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "聽起來就好充實！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n在和朋友進行的活動之中",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是親密度最高的吧？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我居然會有這一天，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真是做夢也想不到……！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真慶幸我有鼓起勇氣約他……！",
    "voice": "vo_adv_1346004_023",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n那一天我放手一搏以不成功便成仁的氣勢突擊他，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n實在是太感激我自己了……！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……對了，",
    "voice": "vo_adv_1346004_024",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我一個衝動就預訂了電影票，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n但是完全沒先查過最重要的電影是什麼。",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我記得，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好像是充滿極限震撼演出的動作電影……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊嗚咿！！",
    "voice": "vo_adv_1346004_025",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團、",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團長！？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n呃，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這個……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "早、",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "早安啊！！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "今天在這個好日子裡，",
    "voice": "vo_adv_1346004_026",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你願意",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "答應我自私的邀約，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我實在是",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "開心又幸運……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "總之我非常高興！！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哇啊啊啊……！",
    "voice": "vo_adv_1346004_027",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我們",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "心意相通呢！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n這就是電影的力量……！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還沒開始看電影我就感動了……！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好，",
    "voice": "vo_adv_1346004_028",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請多指教！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我們一起欣賞會令人雙手緊握、",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "熱血沸騰的動作片吧！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……本來",
    "voice": "vo_adv_1346004_029",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "應該是要這樣的……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "still",
    "still_id": "134600401"
  },
  {
    "type": "dialogue",
    "name": "作為主角的男性",
    "words": "「你就是我新的搭檔？",
    "voice": "vo_adv_1346004_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "作為主角的男性",
    "words": "\\n不是要當小鬼頭的保母？」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這座位是怎麼回事！？",
    "voice": "vo_adv_1346004_031",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團長的臉好近！！！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n隔板呢，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "扶手跑去哪了？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n電影不是",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "坐在各自的座位上觀看的嗎！！？　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我看看預訂畫面……",
    "voice": "vo_adv_1346004_032",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這是什麼，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "情侶座位！？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n難道是我訂錯了！？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "等一下，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我連有這種東西都不知道啊！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我要立刻離開，",
    "voice": "vo_adv_1346004_033",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不然我的內心會一發不可收拾！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n可是",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "中途離席是不是違反看電影的禮儀！？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n那我該怎麼辦！？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不行，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "無處可逃！！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "作為搭檔的女性",
    "words": "「你欠我一次。",
    "voice": "vo_adv_1346004_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "作為搭檔的女性",
    "words": "\\n真是的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "作為搭檔的女性",
    "words": "當『小鬼頭的保母』有夠累人。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "作為主角的男性",
    "words": "「好好好，",
    "voice": "vo_adv_1346004_035",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "作為主角的男性",
    "words": "抱歉啦。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "作為主角的男性",
    "words": "\\n妳這個人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "作為主角的男性",
    "words": "其實個性很好嘛。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我的心臟，",
    "voice": "vo_adv_1346004_036",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒有跳出來吧！？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n要被團長發現了！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "他會覺得我很噁心！！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n到時候我就",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "活不下去了！！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不過這裡是電影院……！",
    "voice": "vo_adv_1346004_037",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n音響很大聲，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "他應該不會發現我的心臟跳得有多激動？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n只要他不貼在胸前確認的話……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "still",
    "still_id": "134600402"
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦，",
    "voice": "vo_adv_1346004_038",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "等一下──！！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團長，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "握住了我的手！？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n不妙啊，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我現在手汗狂噴！！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n連團長的手都會變得溼答答的！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "可是",
    "voice": "vo_adv_1346004_039",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我沒辦法甩開！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我要忍耐，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要撐下去！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n雖然我完全不知道還剩幾分鐘，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不過要撐到電影結束……！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "background",
    "bg_id": "510280"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "吸，",
    "voice": "vo_adv_1346004_040",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "吐……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n奇、",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "奇怪……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "在外面？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "電影",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "已經結束了啊……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是、",
    "voice": "vo_adv_1346004_041",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是啊！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我的心臟都快要從嘴巴跳出來了，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "很過癮的體驗……！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這個啊，",
    "voice": "vo_adv_1346004_042",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我個人覺得看點是……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦？",
    "voice": "vo_adv_1346004_043",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "完全不記得電影的內容？",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n因為我一直在看團長，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "一直在想團長的事……！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n怎麼辦，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哪裡是看點？　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "正常來說",
    "voice": "vo_adv_1346004_044",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "都會在看完電影之後互相討論感想嘛！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n這樣下去我會沒資格當現充，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "讓團長失望然後退回邊緣人！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我不要這樣！　",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這、",
    "voice": "vo_adv_1346004_045",
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這個……",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "果然",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "主角和搭檔的羈絆很棒呢！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n在片尾高潮前的那一場戲，",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我都看得目不轉睛了！",
    "voice": null,
    "unit_id": 104033
  },
  {
    "type": "dialogue",
    "name": "碧",
