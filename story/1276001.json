  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "結束在薩拉薩利亞的冒險，{0}與流夏在居住處",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n悠閒地度過回國前的這段時間時，精靈前來拜訪兩人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼～",
    "voice": "vo_adv_1276001_000",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是和平呢。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "能讓我們",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "作為食客自由自在地過著，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是太感謝了。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "流夏姐姐雖然這麼說，",
    "voice": "vo_adv_1276001_001",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "但是妳看起來好像很無聊……",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我看起來很無聊嗎？",
    "voice": "vo_adv_1276001_002",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "的確，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我是覺得生活能再稍微有一點刺激呢。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "比如說，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "像是這種的……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "那是",
    "voice": "vo_adv_1276001_003",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "什麼動作？",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哦，",
    "voice": "vo_adv_1276001_004",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "果然看得出來嗎？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "畢竟",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我和小哥認識很久了呢。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "每個土地都有當地的魚種，",
    "voice": "vo_adv_1276001_005",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "根據不同魚種，會有各式各樣的釣法。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我至今只要是旅行過的地方，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "無論是哪裡我都會去釣一次魚。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然這麼說，",
    "voice": "vo_adv_1276001_006",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但是這裡本身並沒有水域。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看來也只能放棄了呢。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "這裡有綠洲啊……",
    "voice": "vo_adv_1276001_007",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那裡與其說是這塊土地，",
    "voice": "vo_adv_1276001_008",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不如說是被搬過來的地方吧。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "況且，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那裡現在對薩拉薩利亞的人們來說，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是很重要的水域不是嗎？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要我帶著玩樂的心情去釣魚，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "感覺實在不太好意思。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "原來如此……",
    "voice": "vo_adv_1276001_009",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n如果是這樣的話，那麼還是別在那邊釣魚比較好。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "嗯……",
    "voice": "vo_adv_1276001_010",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "既然這樣，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "這種的妳覺得如何？",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這張紙是什麼？",
    "voice": "vo_adv_1276001_011",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我看看，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "傳統魚法……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "流沙釣？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "這裡的沙漠",
    "voice": "vo_adv_1276001_012",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "有魔物潛伏在沙中。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "所以",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我試著把那些魔物",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "當成是要捕獲的魚。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你還是一樣這麼亂來呢。",
    "voice": "vo_adv_1276001_013",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣的話，也不會對環境造成問題，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還能夠驅除魔物啊……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不錯嘛，",
    "voice": "vo_adv_1276001_014",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我喜歡。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我就來試試看吧！",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "當然，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你也會和我一起來吧？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "background",
    "bg_id": "502060"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "流夏與{0}和精靈一同前往了市場。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼，",
    "voice": "vo_adv_1276001_015",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們該怎麼去釣魚才好呢？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "既然說是傳統，應該有制定出什麼方法吧？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "那當然！",
    "voice": "vo_adv_1276001_016",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n走，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我們去和那邊的人們打聽看看吧。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "好啊！",
    "voice": "vo_adv_1276001_017",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "我們走吧，搭檔！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "好喔！",
    "voice": "vo_adv_1276001_018",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "要盡情釣一番，來大賺一筆！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你們該不會",
    "voice": "vo_adv_1276001_019",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是要出發去流沙釣吧？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "是啊，",
    "voice": "vo_adv_1276001_020",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "你們有什麼事嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n該不會……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "是對流沙釣有興趣？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果方便，希望能向你們討教一下……",
    "voice": "vo_adv_1276001_021",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "哦哦，",
    "voice": "vo_adv_1276001_022",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "這表示我們的釣魚法知名度也提升了啊。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "好啊！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "如果有問題，我們來回答你們！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈，",
    "voice": "vo_adv_1276001_023",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣事情就好辦了。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我想問的",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是關於設置。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "設置？",
    "voice": "vo_adv_1276001_024",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "不，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "我們沒有用陷阱……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我不是那個意思，",
    "voice": "vo_adv_1276001_025",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所謂的設置",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是指釣具的組成。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n像是要使用",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "多粗和多長",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "的魚線，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "以及魚鉤大小",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "和倒刺的形狀等等。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "哦、",
    "voice": "vo_adv_1276001_026",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "哦哦……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "這個嘛。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
