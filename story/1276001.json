    "name": "路邊攤老闆",
    "words": "哎呀呀，",
    "voice": "vo_adv_1276001_051",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "你們是新婚夫妻啊。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "\\n這樣的話，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "這東西你們也拿去吧。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這東西",
    "voice": "vo_adv_1276001_052",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "與其說是粗線，感覺更像繩索呢。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n拿這個當釣線不會太粗了嗎？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "這不是釣線，",
    "voice": "vo_adv_1276001_053",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "這原本是商隊橫渡流沙地帶的習俗。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "夫婦一起前往沙漠時，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "會用這個綁住彼此的身體。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "\\n這樣一來，當其中一方快被沙子流走時，就有人能支撐住不是嗎？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果支撐不住，",
    "voice": "vo_adv_1276001_054",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不就會一起被沙子流走嗎？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "那就等那時候再說！",
    "voice": "vo_adv_1276001_055",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "因為夫妻是一心同體的啊。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "總比只有其中一方倖存下來好吧？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "\\n先生你不這麼覺得嗎？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "哎呀呀，",
    "voice": "vo_adv_1276001_056",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "和太太不一樣，感覺真不可靠呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "\\n從剛才不管是買東西還是處理任何事都是太太在做的……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "你們接下就要去釣魚了，這樣子沒問題嗎？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "串燒店的老闆",
    "words": "雖然看起來就是太太比較年長，",
    "voice": "vo_adv_1276001_057",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "串燒店的老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "串燒店的老闆",
    "words": "但只會對太太言聽計從也不好喔。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈……",
    "voice": "vo_adv_1276001_058",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "身為一家之主，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是會希望",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n他能再稍微有點擔當呢。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "擔當",
    "voice": "vo_adv_1276001_059",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "嗎？",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "是啊，",
    "voice": "vo_adv_1276001_060",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "所謂的擔當……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "這個嘛，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "就是指做人可靠。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "嗯……",
    "voice": "vo_adv_1276001_061",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我並不覺得他不可靠就是了。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼，",
    "voice": "vo_adv_1276001_062",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也做好準備了，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們差不多要出發了。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "受你們照顧了。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "這沒什麼，",
    "voice": "vo_adv_1276001_063",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "難得第一次釣魚。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "得盛大歡送你們才行啊。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "路邊攤老闆",
    "words": "\\n祝你們大豐收！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "串燒店的老闆",
    "words": "如果釣到大魚，也要賣給我們這裡喔！",
    "voice": "vo_adv_1276001_064",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈，",
    "voice": "vo_adv_1276001_065",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果有釣到獵物，會再帶來給你們看的！",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "接下來",
    "voice": "vo_adv_1276001_066",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嘛。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不小心就聊得太開心了呢。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們前往漁場吧。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯？",
    "voice": "vo_adv_1276001_067",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n那是……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "剛才那些人啊！",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "唔啊……",
    "voice": "vo_adv_1276001_068",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "真是太倒楣了……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "我還以為要死掉了……",
    "voice": "vo_adv_1276001_069",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你們還好嗎？",
    "voice": "vo_adv_1276001_070",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼全身都是沙子。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "是你們！",
    "voice": "vo_adv_1276001_071",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "哎呀～",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "的確多虧有你們的建議，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n我們的釣竿和釣線才都沒斷掉……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "但也因此被獵物狠狠拖著跑，才搞成這副德性。",
    "voice": "vo_adv_1276001_072",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "再說在流沙上腳根本踩不住啊……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原來如此，",
    "voice": "vo_adv_1276001_073",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "由流沙構成的區域裡沒有能夠踩穩的地方啊……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "根本沒辦法釣魚。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "看來是這樣呢……",
    "voice": "vo_adv_1276001_074",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "對不起，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我想不到好的點子。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過",
    "voice": "vo_adv_1276001_075",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "既然是這樣，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也是有辦法的。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n這裡",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就由我來提供點子吧。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "有辦法？",
    "voice": "vo_adv_1276001_076",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "那是什麼意思？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "事到如今怎麼可能會有什麼辦法……",
    "voice": "vo_adv_1276001_077",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "只要造船就行了。",
    "voice": "vo_adv_1276001_078",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果不能陸釣，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那還有船釣吧？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "妳說船？",
    "voice": "vo_adv_1276001_079",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "那種東西要去哪裡找……",
    "voice": "vo_adv_1276001_080",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果沒有就自己造。",
    "voice": "vo_adv_1276001_081",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "造出能在沙上行駛的",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "船！",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "background",
    "bg_id": "501530"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}與流夏在市場收集材料後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人專注地敲著鐵鎚，於是……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "居、",
    "voice": "vo_adv_1276001_082",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "居然真的造出來了……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "好",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "強啊，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "小姐妳太厲害了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "是啊！",
    "voice": "vo_adv_1276001_083",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "這可是為祖先代代流傳的流沙釣",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "踏出了新的一步啊！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "應該連一天的時間都還沒過吧……",
    "voice": "vo_adv_1276001_084",
