[
  {
    "type": "background",
    "bg_id": "500420"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哇啊啊……",
    "voice": "vo_adv_7003000_000",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好厲害的一座塔啊，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是看不到頂端的那種？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "超有趣的～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那就是露娜之塔了，",
    "voice": "vo_adv_7003000_001",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真是有夠大了呢……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "歌詞的靈感不斷湧現出來了。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "得趕緊記下來！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才",
    "voice": "vo_adv_7003000_002",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你的記憶就在那裡了對吧。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "今天就由我們來好好幫幫你了！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯。",
    "voice": "vo_adv_7003000_003",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "受了你不少的照顧，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "至少也該讓我報答你一下才對。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "話是這麼說，",
    "voice": "vo_adv_7003000_004",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我還真沒想到\\n【慈樂之音】的望望居然和秀才認識呢。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真是嚇我一跳～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也是啊。",
    "voice": "vo_adv_7003000_005",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒想到超級模特兒鈴奈\\n和{0}互相認識呢。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呵呵。",
    "voice": "vo_adv_7003000_006",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "和{0}在一起",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n真的會發生很多事情呢。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "在認識的服飾店裡",
    "voice": "vo_adv_7003000_007",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "看到你準備開始工作，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n過去一看",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就見到{0}和鈴奈\\n一面談笑風聲――",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "之後不一會兒便一起來探險了呢。",
    "voice": "vo_adv_7003000_008",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真是嚇了我一跳。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……想說不知怎麼回事，",
    "voice": "vo_adv_7003000_009",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "鈴奈\\n還取了一個這麼可愛的稱呼。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可愛的稱呼，",
    "voice": "vo_adv_7003000_010",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是說秀才嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": "vo_adv_7003000_011",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒錯沒錯，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就是那個。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不愧是望望，",
    "voice": "vo_adv_7003000_012",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你知道秀才的好對吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "果然就是秀才對吧！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？",
    "voice": "vo_adv_7003000_013",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊、",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊啊～",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　我就覺得是秀才嘛！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "到、",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "到底是什麼意思啊……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好了秀才，",
    "voice": "vo_adv_7003000_014",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "走吧走吧♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n包在我身上！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "讓我來幫秀才",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "找回記憶吧！",
    "voice": null,
    "unit_id": 101611
  }
]
