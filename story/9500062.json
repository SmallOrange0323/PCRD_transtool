  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什……",
    "voice": "vo_adv_9500062_000",
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你剛剛",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說了什麼？",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n小哥該、",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "該不會是覺醒了！？",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n覺醒為",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真正的……變態！",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呼……",
    "voice": "vo_adv_9500062_001",
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥你完全",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "太搞不清楚狀況了！",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n一直都是這樣狀況外。",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "明明是小哥，",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "卻沒見過世面啊。",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還是不明白嗎？",
    "voice": "vo_adv_9500062_002",
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "連自己為什麼挨罵都不知道？",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以我才會生氣啊！",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "聽好了，",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "身為小哥你的老大，",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我會好好教你的，",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "給我仔細聽著！",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "聽好了，",
    "voice": "vo_adv_9500062_003",
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我和小哥──",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "早就已經",
    "voice": "vo_adv_9500062_004",
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "締結羈絆了不是嗎？",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "家族之間的羈絆……",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還有……",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "更加深厚的、",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "只屬於我和小哥的羈絆喔。",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "老大與手下的羈絆？",
    "voice": "vo_adv_9500062_005",
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n因為是小哥……",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呃……",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以是兄妹的羈絆……？",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哇、",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哇啊啊，",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那、",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那部分",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎怎",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎樣都無所謂啦。",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "難道一直都只有我",
    "voice": "vo_adv_9500062_006",
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是這麼想嗎？",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n現在",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "才那麼鄭重地說出口，",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n是因為這對哥哥而言",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "並不是理所當然的嗎？",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過，",
    "voice": "vo_adv_9500062_007",
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "算了……",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這次就算你及格吧。",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要是你選了我以外的人……",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔唔唔……",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "在幻境龍后之前，",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥就已經被燒成灰燼了喔！",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "既然明白了，",
    "voice": "vo_adv_9500062_008",
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "喏！",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "快、",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "快點",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "牽我的手吧！",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我要讓大家見識見識！",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我們的……",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "羈絆……",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "絕",
    "voice": null,
    "unit_id": 106641
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對切不斷！！",
    "voice": null,
    "unit_id": 106641
  }
]
