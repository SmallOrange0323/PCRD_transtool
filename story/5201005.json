[
  {
    "type": "background",
    "bg_id": "502510"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "七冠們從過去的記憶中被召喚出來，並招致破壞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就在發生此現象時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}與菲歐",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看見了身為「愛梅斯」原型的少女的過去。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我的名字是",
    "voice": "vo_adv_5201005_000",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "幸雨澄花。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n──是「愛梅斯」",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "這個角色的原型玩家。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "……嗯。",
    "voice": "vo_adv_5201005_001",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我是",
    "voice": "vo_adv_5201005_002",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "參與《阿斯特朗傳奇》開發過程的",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "其中一名實驗品。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n你是透過我的身體",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "看見那個過去的。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "幸雨澄花……",
    "voice": "vo_adv_5201005_003",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "妳說妳是愛梅斯的",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "原型……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "原來在這個世界流傳的「女神愛梅斯」",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是個玩家嗎！？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "女神……",
    "voice": "vo_adv_5201005_004",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n但我沒做什麼足以讓大家",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "那樣稱呼我的事呢。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "就連現在，",
    "voice": "vo_adv_5201005_005",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我也在對你們的世界",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "造成麻煩。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "麻煩……",
    "voice": "vo_adv_5201005_006",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "難道說，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "像是那個什麼測試的霸瞳皇帝，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "還有在各地作亂的七冠，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "現在發生的這些現象",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "都是妳……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "原因都出在澄花妳身上嗎……？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "……沒錯。",
    "voice": "vo_adv_5201005_007",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n「愛梅斯」這副身體裡留存的資料",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "被人盯上了。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "身體裡留存的資料？",
    "voice": "vo_adv_5201005_008",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "就是你們至今一直看著的──",
    "voice": "vo_adv_5201005_009",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我的記憶。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我的記憶中充滿了《阿斯特朗傳奇》",
    "voice": "vo_adv_5201005_010",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n開發過程中的重要情報。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n對方似乎是想要那些情報。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我原本",
    "voice": "vo_adv_5201005_011",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "在很久以前就凍結帳號，",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n維持這樣一直沒有醒來……",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "本該是這樣的。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n但好像有某個人",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "重新啟動了我的帳號。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "從再構築前就存在的",
    "voice": "vo_adv_5201005_012",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "「愛梅斯」重新啟動了，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "現在發生在這個世界的是……！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "真那先生……",
    "voice": "vo_adv_5201005_013",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "霸瞳皇帝出現，",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "與NPC消失。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "現在發生的這個現象",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "叫做「過去版本覆蓋」。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "因為有人想將我……",
    "voice": "vo_adv_5201005_014",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "將「愛梅斯」的資料強行提取出來，",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n所以過去版本的《阿斯特朗傳奇》",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n正打算覆蓋現行的版本。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "原來如此……",
    "voice": "vo_adv_5201005_015",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我的這副模樣",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "也是來自過去……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我引導晶小姐、",
    "voice": "vo_adv_5201005_016",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "似似花小姐",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "和克莉絲小姐，",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n去抵擋從過去現身的七冠，",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n但這樣無法徹底解決問題。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "因此……",
    "voice": "vo_adv_5201005_017",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我有事情想拜託",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "活在「現在」的你們。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "拜託我們？",
    "voice": "vo_adv_5201005_018",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "請把我──",
    "voice": "vo_adv_5201005_019",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "消除掉。",
    "voice": "vo_adv_5201005_020",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "在我的記憶",
    "voice": "vo_adv_5201005_021",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "全被奪走之前。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "在過去──",
    "voice": "vo_adv_5201005_022",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "將現在覆蓋之前。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "消除",
    "voice": "vo_adv_5201005_023",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是指……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "把妳消滅掉",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "的",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "意思……？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "是的，",
    "voice": "vo_adv_5201005_024",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "沒有時間了。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n如果再繼續被提取記憶，",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "這個世界整體都會受到影響。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我不希望……",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "這種事發生。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "澄花，等一下，",
    "voice": "vo_adv_5201005_025",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "妳是登入遊戲的玩家對吧？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n那只要登出不就好了嗎！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "然後，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "妳再把身上戴的mimi……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "……我已經",
    "voice": "vo_adv_5201005_026",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "辦不到",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "這件事了。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "──！",
    "voice": "vo_adv_5201005_027",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "既然這樣，",
    "voice": "vo_adv_5201005_028",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "就更不能這麼做了不是嗎……？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我原本",
    "voice": "vo_adv_5201005_029",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "就是應該已經消失的存在。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n我現在待在這裡，",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "本身就是個錯誤。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "拜託你們，",
    "voice": "vo_adv_5201005_030",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "{0}、",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "菲歐。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n我想",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "守護這個世界。",
    "voice": null,
