[
  {
    "type": "background",
    "bg_id": "501710"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "結束了聖誕節的視察，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "返回吉歐‧提格尼亞的萊拉耶爾。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了與她一起巡迴回憶之地，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}也跟著一起同行。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "──終於回到吉歐‧提格尼亞了……！",
    "voice": "vo_adv_1328004_000",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "果然，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還是熟悉的地方最讓人安心。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "今天一定都累了，",
    "voice": "vo_adv_1328004_001",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士也來城裡休息吧。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "巡迴回憶之地，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "留到明天再出發。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那麼，",
    "voice": "vo_adv_1328004_002",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我們前往城裡──",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "萊拉耶爾殿下，",
    "voice": "vo_adv_1328004_003",
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "那副模樣是……！？",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "\\n",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "發生了什麼事……！？",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "簡直像是惡魔一樣……！",
    "voice": "vo_adv_1328004_004",
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "\\n聖誕節",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "原來是很恐怖的祭典嗎……！？",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "咦咦……！？",
    "voice": "vo_adv_1328004_005",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "請、",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "請等一下，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "請讓我做說明……！",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我已經完全",
    "voice": "vo_adv_1328004_006",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "習慣這身打扮了……",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n沒想到",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "會引起騷動，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還真是盲點呢……",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "聖誕季結束後，",
    "voice": "vo_adv_1328004_007",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "應該就會恢復成原本的樣子才對，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但看來似乎",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還會再維持一陣子……",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是啊。",
    "voice": "vo_adv_1328004_008",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "雖然勉強平息了騷動，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n但再這樣下去，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "對聖誕節的誤解會擴散開來。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "果然，",
    "voice": "vo_adv_1328004_009",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "有必要找個機會傳達正確的聖誕節訊息。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我想讓各位居民也能",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "更深入理解蘭德索爾的文化。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "可以嗎？",
    "voice": "vo_adv_1328004_010",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "如果你能幫忙做確認的話",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那就太可靠了。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "background",
    "bg_id": "501720"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "──果然",
    "voice": "vo_adv_1328004_011",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "象徵聖誕節的",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n聖誕樹是不可或缺的。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "要重現聖誕樹，",
    "voice": "vo_adv_1328004_012",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "可以用巧克力棒之類的……",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n不對，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "或許還有更好的點心。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "先來",
    "voice": "vo_adv_1328004_013",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "找波波爺討論一下會不會比較好……",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n不，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "感覺聖誕樹本身會被他改造……",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "嗯……",
    "voice": "vo_adv_1328004_014",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "要考慮的事情太多，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "遇到了瓶頸。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_1328004_015",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "看來先休息一下比較好。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n用吃點心與喝茶，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "來轉換一下思緒。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "哎呀……",
    "voice": "vo_adv_1328004_016",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這道光芒是──",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "background",
    "bg_id": "510091"
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "終於",
    "voice": "vo_adv_1328004_017",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "抵達你的房間了。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "「扮家家酒」也",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "逐漸進入佳境♪",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "親愛的，",
    "voice": "vo_adv_1328004_018",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "振作一點啊。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "不是約好要一起吃火鍋的嗎？",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "明明還一起挽著手",
    "voice": "vo_adv_1328004_019",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "出門購物約會不是嗎。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "想起來了？",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "是啊。",
    "voice": "vo_adv_1328004_020",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n回到家前的空中散步，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "真的很開心呢♪",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "雖然在引人注目的商店街",
    "voice": "vo_adv_1328004_021",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "稍微引起了一點騷動，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "但已經沒事了。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "因為",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "這裡是你的家呀。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "在這裡，",
    "voice": "vo_adv_1328004_022",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "只有我跟你……",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "兩人獨處。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "不管做什麼，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "都不會引起騷動。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "來吧，",
    "voice": "vo_adv_1328004_023",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "讓我們來繼續夫妻約會。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "你想要",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "做什麼呢？",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "……",
    "voice": "vo_adv_1328004_024",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "遊戲是嗎。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "雖然我也",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "很喜歡阿斯特朗……",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "但現在先放一邊吧。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "在有限的時間裡，",
    "voice": "vo_adv_1328004_025",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "像這樣玩著扮家家酒。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n應該做點像是夫妻會做的事吧？",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "我想想……",
    "voice": "vo_adv_1328004_026",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
