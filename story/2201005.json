    },
    {
        "type": "dialogue",
        "name": "可璃亞",
        "words": "總、",
        "unit_id": 126011,
        "voice": "vo_adv_2201005_001"
    },
    {
        "type": "dialogue",
        "name": "可璃亞",
        "words": "總算是……",
        "unit_id": 126011
    },
    {
        "type": "dialogue",
        "name": "普蕾西亞",
        "words": "打倒了。",
        "unit_id": 126111,
        "voice": "vo_adv_2201005_002"
    },
    {
        "type": "dialogue",
        "name": "普蕾西亞",
        "words": "\n呢。",
        "unit_id": 126111
    },
    {
        "type": "dialogue",
        "name": "旁白",
        "words": "【幻變少女】解放了神祕力量，"
    },
    {
        "type": "dialogue",
        "name": "旁白",
        "words": "\n擊破了抓住{player}和貪吃佩可的魔物們。"
    },
    {
        "type": "dialogue",
        "name": "旁白",
        "words": "\n但是，她們那副姿態……"
    },
    {
        "type": "background",
        "background": "500253"
    },
    {
        "type": "still",
        "still": "end"
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "……兄長大人，",
        "unit_id": 125811,
        "voice": "vo_adv_2201005_003"
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "\n不好意思，",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "讓您久等了……",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "\n",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "我現在",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "就把繩子割斷。",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "可璃亞",
        "words": "貪吃佩可小姐也是，",
        "unit_id": 126011,
        "voice": "vo_adv_2201005_004"
    },
    {
        "type": "dialogue",
        "name": "可璃亞",
        "words": "\n因為很危險，",
        "unit_id": 126011
    },
    {
        "type": "dialogue",
        "name": "可璃亞",
        "words": "請別亂動喔。",
        "unit_id": 126011
    },
    {
        "type": "dialogue",
        "name": "貪吃佩可",
        "words": "謝謝妳們。",
        "unit_id": 105812,
        "voice": "vo_adv_2201005_005"
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "【幻變少女】的各位……",
        "unit_id": 105911,
        "voice": "vo_adv_2201005_006"
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "\n",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "那個，",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "\n在下也要",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "向妳們道謝。",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "各位幫忙救出了主人和貪吃佩可小姐，",
        "unit_id": 105911,
        "voice": "vo_adv_2201005_007"
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "\n",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "真是感激不盡。",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "\n",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "……不過……",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "……能請妳們",
        "unit_id": 106011,
        "voice": "vo_adv_2201005_008"
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "解釋一下嗎？",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "\n各方面都需要。",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "３人",
        "words": "…………",
        "unit_id": 1,
        "voice": "vo_adv_2201005_009"
    },
    {
        "type": "background",
        "background": "500253"
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "我並不打算",
        "unit_id": 106011,
        "voice": "vo_adv_2201005_010"
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "到處去和別人大肆宣傳啦，",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "\n",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "但妳們的",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "這副模樣……",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "\n總覺得好像曾經在哪",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "看過呢。",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "……首先，",
        "unit_id": 125811,
        "voice": "vo_adv_2201005_011"
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "\n",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "我要先為我們的隱瞞",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "鄭重道歉。",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "\n",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "都怪我們，",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "才害你們",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "受了無謂的傷……",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "普蕾西亞",
        "words": "對不起。",
        "unit_id": 126111,
        "voice": "vo_adv_2201005_012"
    },
    {
        "type": "dialogue",
        "name": "貪吃佩可",
        "words": "不會不會！",
        "unit_id": 105811,
        "voice": "vo_adv_2201005_013"
    },
    {
        "type": "dialogue",
        "name": "貪吃佩可",
        "words": "\n",
        "unit_id": 105811
    },
    {
        "type": "dialogue",
        "name": "貪吃佩可",
        "words": "畢竟這點程度的危機，",
        "unit_id": 105811
    },
    {
        "type": "dialogue",
        "name": "貪吃佩可",
        "words": "我們至今也遇過好幾次了，",
        "unit_id": 105811
    },
    {
        "type": "dialogue",
        "name": "貪吃佩可",
        "words": "\n",
        "unit_id": 105811
    },
    {
        "type": "dialogue",
        "name": "貪吃佩可",
        "words": "我們完全不介意……",
        "unit_id": 105811
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "就和這傢伙說的一樣，",
        "unit_id": 106011,
        "voice": "vo_adv_2201005_014"
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "妳們可以不用太介意喔。",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "\n",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "……如果是不得不隱瞞的事，",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "我們也是有的，所以……",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "……我們過去身為",
        "unit_id": 125811,
        "voice": "vo_adv_2201005_015"
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "「世界管理者的末端裝置」，",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "\n使用這股力量……",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "\n傷害了很多人，",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "犯下了數不清的罪孽。",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "就算從「末端裝置」的身體中",
        "unit_id": 125811,
        "voice": "vo_adv_2201005_016"
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "獲得解放，",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "\n這股可憎的力量仍殘留在我們的體內，",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "\n就像是",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "牢牢黏附於靈魂的汙穢一樣……",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "以幾位的立場而言，",
        "unit_id": 105911,
        "voice": "vo_adv_2201005_017"
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "使用那股力量",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "是很令人迷惘的……",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "是這樣吧。",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "\n",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "正因如此，",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "幾位才需要護衛──",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "\n在下能否",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "這麼想呢？",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "普蕾西亞",
        "words": "嗯。",
        "unit_id": 126111,
        "voice": "vo_adv_2201005_018"
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "我很理解妳們會對使用力量",
        "unit_id": 106011,
        "voice": "vo_adv_2201005_019"
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "感到迷惘的心情……",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "\n",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "畢竟我之前",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "也捨棄了從陛下那裡得到的力量。",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "兄長大人……",
        "unit_id": 125811,
        "voice": "vo_adv_2201005_020"
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "……那個，",
        "unit_id": 125811,
        "voice": "vo_adv_2201005_021"
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "\n",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "我們先前之所以不使用這股力量，",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "有一部分",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "的理由",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "\n當然是因為我們不太想面對過去……",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "但更重要的是，",
        "unit_id": 125811,
        "voice": "vo_adv_2201005_022"
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "\n我們害怕",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "會被兄長大人和大家",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "討厭。",
        "unit_id": 125811
    },
    {
        "type": "dialogue",
        "name": "貪吃佩可",
        "words": "是的☆",
        "unit_id": 105811,
        "voice": "vo_adv_2201005_023"
    },
    {
        "type": "dialogue",
        "name": "貪吃佩可",
        "words": "\n力量不分好壞，",
        "unit_id": 105811
    },
    {
        "type": "dialogue",
        "name": "貪吃佩可",
        "words": "重點是看如何使用！",
        "unit_id": 105811
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "……謝謝",
        "unit_id": 125813,
        "voice": "vo_adv_2201005_024"
    },
    {
        "type": "dialogue",
        "name": "莉莉",
        "words": "各位。",
        "unit_id": 125813
    },
    {
        "type": "dialogue",
        "name": "普蕾西亞",
        "words": "接下來，",
        "unit_id": 126113,
        "voice": "vo_adv_2201005_025"
    },
    {
        "type": "dialogue",
        "name": "普蕾西亞",
        "words": "\n我們也會，",
        "unit_id": 126113
    },
    {
        "type": "dialogue",
        "name": "普蕾西亞",
        "words": "戰鬥。",
        "unit_id": 126113
    },
    {
        "type": "dialogue",
        "name": "普蕾西亞",
        "words": "唷。",
        "unit_id": 126113
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "不過，",
        "unit_id": 106011,
        "voice": "vo_adv_2201005_026"
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "妳們有幹勁是很不錯啦，",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "\n",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "凱留",
        "words": "但也別太仰賴借來的力量喔。",
        "unit_id": 106011
    },
    {
        "type": "dialogue",
        "name": "貪吃佩可",
        "words": "就算妳們的力量變得再怎麼強大，",
        "unit_id": 105811,
        "voice": "vo_adv_2201005_027"
    },
    {
        "type": "dialogue",
        "name": "貪吃佩可",
        "words": "\n類似於戰鬥經驗值的東西依然不足──",
        "unit_id": 105811
    },
    {
        "type": "dialogue",
        "name": "貪吃佩可",
        "words": "\n這點好像沒有變呢。",
        "unit_id": 105811
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "是的。",
        "unit_id": 105911,
        "voice": "vo_adv_2201005_028"
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "\n若還不習慣使用廚刀，",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "卻想快速地精於使用，",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "可可蘿",
        "words": "\n是會弄傷自己的手的。",
        "unit_id": 105911
    },
    {
        "type": "dialogue",
        "name": "普蕾西亞",
        "words": "嗯……",
        "unit_id": 126113,
        "voice": "vo_adv_2201005_029"
    },
    {
        "type": "dialogue",
        "name": "可璃亞",
        "words": "會拜託各位進行護衛，",
        "unit_id": 126013,
        "voice": "vo_adv_2201005_030"
    },
    {
        "type": "dialogue",
        "name": "可璃亞",
        "words": "\n也是因為",
        "unit_id": 126013
    },
    {
        "type": "dialogue",
        "name": "可璃亞",
        "words": "我們真的是",
        "unit_id": 126013
    },
    {
        "type": "dialogue",
        "name": "可璃亞",
        "words": "新手冒險者。",
        "unit_id": 126013
    },
    {
        "type": "dialogue",
        "name": "可璃亞",
        "words": "我們真的很希望",
        "unit_id": 126013,
        "voice": "vo_adv_2201005_031"
    },
    {
        "type": "dialogue",
        "name": "可璃亞",
        "words": "能和平地過日子，",
        "unit_id": 126013
    },
    {
        "type": "dialogue",
        "name": "可璃亞",
        "words": "\n",
        "unit_id": 126013
    },
    {
        "type": "dialogue",
        "name": "可璃亞",
        "words": "不用再與任何人戰鬥，",
        "unit_id": 126013
    },
    {
        "type": "dialogue",
        "name": "可璃亞",
        "words": "但……",
        "unit_id": 126013
    },
    {
        "type": "dialogue",
