  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你終於來了，{0}。",
    "voice": "vo_adv_1031500_000",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "很抱歉遲到了？",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不用在意，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因為",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也花了點時間說服爸爸，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n要他安靜地在家待著。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這下子",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們就能靜下來慢慢談了。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "送給我的？",
    "voice": "vo_adv_1031500_001",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "難道是",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "慶祝生日的禮物嗎？",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我可以打開看看嗎？",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "原來是",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "塔羅牌嗎。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嘻嘻，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "上頭的圖案真可愛……",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然",
    "voice": "vo_adv_1031500_002",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "平常很少用這類不習慣的道具來占卜，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n不過這樣一來隨手都能占卜，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "一目了然的結果",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也讓人樂在其中呢。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝你的禮物。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "之後",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我會幫公會的大家",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "用它來占卜看看。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這該不會是",
    "voice": "vo_adv_1031500_003",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "慶祝生日的禮物吧？",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這是那本很有名的恐怖小說呢。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n不過因為有些年代了，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因此我不曾讀過。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝你的禮物。",
    "voice": "vo_adv_1031500_004",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "若是不介意的話我們一起讀吧？",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不敢看？",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "沒關係的，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我跟",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "其他許多夥伴都會一起陪你。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "新、",
    "voice": "vo_adv_1031500_005",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "新爸爸？",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這是……",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "骷髏頭鑰匙圈？",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這麼說來，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "今天好像是我的生日。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝你的禮物。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過這個骷髏頭",
    "voice": "vo_adv_1031500_006",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不但小巧，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "動起來也可愛又逗趣呢。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "要是也能像它一樣可愛就好了。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "剛剛的話",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請不要告訴我爸爸喔。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "其實",
    "voice": "vo_adv_1031500_007",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "今天占卜時就已經算出，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "本日會是個好日子。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "只是沒想到",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "竟然是這麼令人開心的事。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我會珍藏這段回憶，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "將它帶進自己墳墓裡頭。",
    "voice": null,
    "unit_id": 103112
  }
]
