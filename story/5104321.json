[
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "在、",
    "voice": "vo_adv_5104321_000",
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "在那群魔像中，",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n還有我們的冒牌貨混在裡面喔！？",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼，",
    "voice": "vo_adv_5104321_001",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不論外表如何掩飾，說到底也只是冒牌貨。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而且",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這種場面實在是太容易理解了。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "「超越出現於眼前的自身的幻影」……",
    "voice": "vo_adv_5104321_002",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "對英雄來說，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這就像是特別量身訂做的情境不是嗎？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊！",
    "voice": "vo_adv_5104321_003",
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "的確也是能這麼想呢……！",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "既然如此，",
    "voice": "vo_adv_5104321_004",
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我會戰勝這場困境，",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "然後在作為英雄的方面更上一層樓的！",
    "voice": null,
    "unit_id": 123911
  }
]
