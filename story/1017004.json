[
  {
    "type": "background",
    "bg_id": "500060"
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嚼嚼。",
    "voice": "vo_adv_1017004_000",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n嚼……",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯嗯～果然還是有哪裡不太一樣呢～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我用和你一起採收的「像苦瓜的東西」，",
    "voice": "vo_adv_1017004_001",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n試著重現故鄉的料理啊～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過還是只做得出「類似的料理」呢？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "似是而非啊～",
    "voice": "vo_adv_1017004_002",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n的確已經非常像了，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "但總覺得微妙地缺少什麼東西呢～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "調味？口感？外觀？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯～讓人真懊惱呢～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "原本為了感謝你幫忙我採收……",
    "voice": "vo_adv_1017004_003",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n想要給你嚐嚐我故鄉最美味的料理的……",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過做成這樣，根本算不上是答謝呢～？",
    "voice": "vo_adv_1017004_004",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "連我「感謝」之意的百分之一都還表達不出來啊～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯？",
    "voice": "vo_adv_1017004_005",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n已經很好吃了嗎？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "聽你這麼說是讓我鬆了一口氣……",
    "voice": "vo_adv_1017004_006",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n不過你也不用勉強自己吃下去呢～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "剩下來的話我會拿去給【哞哞自衛隊】的大家吃啦。",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "其實我今天是負責煮飯的人～要幫【哞哞自衛隊】煮飯啦。",
    "voice": "vo_adv_1017004_007",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你要是全部都吃光的話，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我就必須再料理一次了，反而更麻煩呢～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗚啊！？",
    "voice": "vo_adv_1017004_008",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n這怎麼回事，周遭好像在發光耶～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "奇怪了奇怪了，我有碰到什麼不該碰的魔法陣嗎？",
    "voice": "vo_adv_1017004_009",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我常常因為這種失誤而惹大家生氣啊～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "background",
    "bg_id": "510050"
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "喂～{0}！",
    "voice": "vo_adv_1017004_010",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n嗨──呵☆",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真巧呢～你在這裡幹什麼？你好嗎～？",
    "voice": "vo_adv_1017004_011",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "奇怪了……反應真是冷淡，",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "難道你忘記我了嗎？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈～這也沒什麼關係啦，",
    "voice": "vo_adv_1017004_012",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我們再從頭開始變成好朋友就可以了～！",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "船到橋頭自然直呢～♪",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊，為什麼要用「喜屋武香織」的全名叫我呢？",
    "voice": "vo_adv_1017004_013",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "而且還加上了「小姐」，感覺很陌生讓我好寂寞呢～？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "哎呀？你呀……該不會是，",
    "voice": "vo_adv_1017004_014",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n吃漢堡太大口吃得滿嘴都是，所以講不出話啦～？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "話說看起來塞住喉嚨了，這樣可是會窒息的呦？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "抱歉呀～！",
    "voice": "vo_adv_1017004_015",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我幫你拍拍背喔，拍、拍！",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n你沒事吧～？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈～♪",
    "voice": "vo_adv_1017004_016",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯，看來你有好好記得我，讓我放心了呢～！",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我雖然把每個人都當作朋友，",
    "voice": "vo_adv_1017004_017",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "但並不代表我只想跟大家當泛泛之交呢～？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我想要和你",
    "voice": "vo_adv_1017004_018",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "變成更好的朋友呢～♪",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n要是你不討厭的話啦！",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯？",
    "voice": "vo_adv_1017004_019",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我是為了空手道全國大會才會來到東京～",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n不過大會已經結束了，",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "直接回去的話感覺很浪費，所以才會四處閒晃呢～",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈～",
    "voice": "vo_adv_1017004_020",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n感覺都市的東西都好稀奇呢～♪",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就像是早一點到來的暑假～",
    "voice": "vo_adv_1017004_021",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "爺爺和奶奶也都叫我要去「增廣見聞」呢～",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過我身上沒什麼錢，",
    "voice": "vo_adv_1017004_022",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n在住宿和食物這部分實在很頭痛呢。",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "反正，船到橋頭自然直啦～♪",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "雖然都市和沖繩很不一樣，不過在這裡生活的同樣都是人～",
    "voice": "vo_adv_1017004_023",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "只要保持誠意與大家接觸，大家也都會溫柔對待我呢～",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯？你說要是肚子餓的話可以吃你的漢堡？",
    "voice": "vo_adv_1017004_024",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "搶別人的飯吃讓我有點過意不去呢～沒關係嗎？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你說點太多了，吃不完？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_1017004_025",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我可不是為了討飯吃，",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "才向你搭話的呦。",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過我很高興～謝謝你！",
    "voice": "vo_adv_1017004_026",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n你真的很溫柔呢～",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "最喜歡你啦♪",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我要開動了～",
    "voice": "vo_adv_1017004_027",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嚼嚼♪",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈……☆",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n漢堡這種美國食物也是故鄉的味道呢～！",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真是讓人懷念呢～",
    "voice": "vo_adv_1017004_028",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過總覺得，好像還少了什麼呢？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊，搞不好是缺了調味料呢？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "加上這個奶奶直傳的醬汁呀～",
    "voice": "vo_adv_1017004_029",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n只要有這個醬汁，隨時都能感受到故鄉的味道呢～？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "所以我才會隨身帶著這醬汁呦～啊哈哈♪",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真的非常謝謝你！",
    "voice": "vo_adv_1017004_030",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n多虧了你和我一起吃飯，感覺心靈和肚子都超滿足的呢～！",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "要是不麻煩的話下次再陪我吧，現實世界和阿斯特朗都要呦♪",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "奶奶直傳的醬汁……",
    "voice": "vo_adv_1017004_031",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n真好奇是什麼味道呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "對我來說，味覺算是一種未知的領域呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "對你來說，速食店的漢堡呢，",
    "voice": "vo_adv_1017004_032",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n也算是一種讓人懷念的「故鄉的味道」吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n難怪你能夠了解香織的心情呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你的情況也像是遠離故鄉，",
    "voice": "vo_adv_1017004_033",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不斷地到處流浪呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "哎呀，總而言之呢……",
    "voice": "vo_adv_1017004_034",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛剛看見的，是如同夢境一般的情景唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你會看到怎樣的「夢」，",
    "voice": "vo_adv_1017004_035",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n感覺應該取決於與你建立羈絆的對象。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你會看到這樣的「夢」，",
    "voice": "vo_adv_1017004_036",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n應該就代表著你心中的某處也在懷念「故鄉」吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "讓這樣的你在「夢」裡看到故鄉的一隅，",
    "voice": "vo_adv_1017004_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "感覺是有些殘酷呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過現在也沒有其他能做的事情。",
    "voice": "vo_adv_1017004_038",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你就品嚐故鄉的料理，療癒心靈繼續耐心等待吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就像香織那樣呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，今天就先聊到這裡吧……",
    "voice": "vo_adv_1017004_039",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "掰掰，下次見囉♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500060"
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……？",
    "voice": "vo_adv_1017004_040",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n怎麼了，剛剛是在發呆嗎……？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "果然料理不太合你口味嗎？",
    "voice": "vo_adv_1017004_041",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n總覺得你看起來沒有什麼精神，心情也不美麗呢……？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你說我也一樣嗎？",
    "voice": "vo_adv_1017004_042",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "是這樣嗎……？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我果然還是有點寂寞呢，",
    "voice": "vo_adv_1017004_043",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "畢竟一直都無法回到故鄉呀～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過呀，船到橋頭自然直啊～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "雖然我還沒有辦法回到真正的故鄉，",
    "voice": "vo_adv_1017004_044",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n不過只要將蘭德索爾變成「第二個故鄉」就好了呀～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "自己重要的地方逐漸增加，感覺好像賺到了呢～☆",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "雖然我偶爾應該還會像這樣……",
    "voice": "vo_adv_1017004_045",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "感到有點哀傷，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過依舊能展露笑容呢～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我會和最喜歡的人們在一起",
    "voice": "vo_adv_1017004_046",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n開心地唱歌跳舞過生活呦～♪",
    "voice": null,
    "unit_id": 101711
  }
]
