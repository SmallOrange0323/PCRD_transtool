[
    {
        "type": "still",
        "still": "211501001",
        "still_id": "211501001"
    },
    {
        "name": "終炎巨神",
        "words": "……！",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "吸收了累積在「漆黑薔薇城」之中的魔力，",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "\\n再加上將厄莉絲納入體內當成操縱者後，",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "\\n「終炎巨神」變得無比巨大。",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "它一邊徘徊一邊釋放著猛烈的熱氣，",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "\\n打算將整個阿斯特賴亞大陸化為焦土。",
        "voice": null
    },
    {
        "type": "background",
        "bg_id": "500135"
    },
    {
        "type": "still",
        "still": "end"
    },
    {
        "name": "霸瞳皇帝",
        "words": "──好了，",
        "voice": "vo_adv_2116002_000"
    },
    {
        "name": "霸瞳皇帝",
        "words": "那麼……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "雖然剛才對凱留那麼說……",
        "voice": "vo_adv_2116002_001"
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n但我在目前這種遠不及平常能力的狀態下，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "該怎麼打贏那東西呢？",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "……那個魔物的體積，",
        "voice": "vo_adv_2116002_002"
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n大概相當於",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "蘭德索爾王城，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n移動速度",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "大約相當於馬的小跑步吧……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "放射出的魔力熱風",
        "voice": "vo_adv_2116002_003"
    },
    {
        "name": "霸瞳皇帝",
        "words": "在一瞬間便將周遭化成了灰燼。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n就算只有餘波，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "也能造成半徑數公里的嚴重火災……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n要是普通的魔物或人類，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "在還沒搞清楚狀況前就會被燒得焦黑吧。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "此外……",
        "voice": "vo_adv_2116002_004"
    },
    {
        "name": "霸瞳皇帝",
        "words": "剛才一見面就往它身上招呼的",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "破壞魔法，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n看來也幾乎沒有造成傷害。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "現在的我",
        "voice": "vo_adv_2116002_005"
    },
    {
        "name": "霸瞳皇帝",
        "words": "沒辦法連續使出那種威力的攻擊……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "這樣的話，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "雖然很不甘心，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "但是果然無法從正面擊潰它呢。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "……可是，",
        "voice": "vo_adv_2116002_006"
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n就算外貌多少有些改變……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "之前的開發列表中",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "有這種怪物存在嗎？　",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "……沒辦法清楚地回想起來。",
        "voice": "vo_adv_2116002_007"
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "真讓人火大……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "腦袋",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "好像還有點模糊不清。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n感覺就像是被人找麻煩一樣。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "算了，",
        "voice": "vo_adv_2116002_008"
    },
    {
        "name": "霸瞳皇帝",
        "words": "無所謂。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "反正我的目的不是討伐它。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n我的目標是內容物……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "厄莉絲，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "還有",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "米奈娃……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "只要將米奈娃拿到手，",
        "voice": "vo_adv_2116002_009"
    },
    {
        "name": "霸瞳皇帝",
        "words": "我就能逆轉一切。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "不……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "追根究柢，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "那本來就是我應該得到的東西。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "我絕不允許除了我以外的人",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "任意驅使她。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "如果要說順便一提，",
        "voice": "vo_adv_2116002_010"
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n雖然已經是過去的事了，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "但它剛才打算燒死我的舊寵物貓，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n這件事也很不可饒恕呢。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "……不過，",
        "voice": "vo_adv_2116002_011"
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n米奈娃目前",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "與自稱是厄莉絲的草野優衣複製體合而為一，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n而那個厄莉絲",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "則是在那個魔物裡頭……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "這樣一來，",
        "voice": "vo_adv_2116002_012"
    },
    {
        "name": "霸瞳皇帝",
        "words": "我想想，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n首先應該試試看，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n能不能從外部",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "操控那個魔物吧。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "──麻煩你別做出不識相的舉動喔？",
        "voice": "vo_adv_2116002_013"
    },
    {
        "name": "彌勒",
        "words": "\\n霸瞳皇帝。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "誰啊？",
        "voice": "vo_adv_2116002_014"
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n厄莉絲的夥伴嗎？",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "日安，",
        "voice": "vo_adv_2116002_015"
    },
    {
        "name": "彌勒",
        "words": "\\n我的名字是彌勒。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "因為有些緣由……",
        "voice": "vo_adv_2116002_016"
    },
    {
        "name": "彌勒",
        "words": "\\n目前我正在協助厄莉絲小姐達成她的願望。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "喔，",
        "voice": "vo_adv_2116002_017"
    },
    {
        "name": "霸瞳皇帝",
        "words": "這樣啊。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "你這種僕役角色",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "不值得我浪費時間──",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "雖然",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "我原本想這麼說。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "但你的身體，",
        "voice": "vo_adv_2116002_018"
    },
    {
        "name": "霸瞳皇帝",
        "words": "還挺奇怪的嘛。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n我稍微有點感興趣了。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "還有，",
        "voice": "vo_adv_2116002_019"
    },
    {
        "name": "霸瞳皇帝",
        "words": "你那張臉。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n我勉為其難有些印象。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "你在「現實」中，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "是不是某個奇怪組織的",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "首領？",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "這個嘛，",
        "voice": "vo_adv_2116002_020"
    },
    {
        "name": "彌勒",
        "words": "究竟是不是呢？",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n因為我的個性不太會拘泥於過去。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "從不懂得自己思考的烏合之眾手中，",
        "voice": "vo_adv_2116002_021"
    },
    {
        "name": "霸瞳皇帝",
        "words": "吸取一切有價值的事物。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "雖然我不是不能",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "理解這種手段……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "但是信仰的對象竟是想像中的存在這點，令人不敢恭維呢。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "至少",
        "voice": "vo_adv_2116002_022"
    },
    {
        "name": "霸瞳皇帝",
        "words": "得讓自身化為「神」，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "再來著手吧？",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "對，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "沒錯──",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "就像我一樣。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "……",
        "voice": "vo_adv_2116002_023"
    },
    {
        "name": "彌勒",
        "words": "呵。",
        "voice": "vo_adv_2116002_024"
    },
    {
        "name": "彌勒",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "呵呵呵呵……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "……有什麼好笑的？",
        "voice": "vo_adv_2116002_025"
    },
    {
        "name": "彌勒",
        "words": "神？",
        "voice": "vo_adv_2116002_026"
    },
    {
        "name": "彌勒",
        "words": "\\n你說神？",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n就憑你，",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "是絕對無法到達神的境界的。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "說到底，",
        "voice": "vo_adv_2116002_027"
    },
    {
        "name": "彌勒",
        "words": "\\n你這雙足步行的猴子只不過是腦袋發達了一點，",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n竟敢僭稱自己為「神」，",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "自我意識過剩也該有個限度。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "……看來你偏好童話書裡會出現的",
        "voice": "vo_adv_2116002_028"
    },
    {
        "name": "霸瞳皇帝",
        "words": "那種「神」呢。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "只要隨便讓你見識一個奇蹟，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "是不是就能滿足你了？",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "不必了。",
        "voice": "vo_adv_2116002_029"
    },
    {
        "name": "彌勒",
        "words": "\\n只要睜大雙眼，",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "奇蹟處處可見。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n你應該也知道",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "超能力者與靈異體質者的存在。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "而且……",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "──「mimi」，",
        "voice": "vo_adv_2116002_030"
    },
    {
        "name": "彌勒",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "這儀器用了某種方式，",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n使得「讓靈魂潛入電腦中的奇蹟」，淪為可反覆重現的技術。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "但是即使在目前被發現的超能力者當中，",
        "voice": "vo_adv_2116002_031"
    },
    {
        "name": "彌勒",
        "words": "\\n也找不到這種異能。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "那麼……",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "究竟是誰？",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "怎麼辦到的？",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "這件事……",
        "voice": "vo_adv_2116002_032"
    },
    {
        "name": "霸瞳皇帝",
        "words": "我當然",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "心裡有底。",
        "voice": null
    },
    {
        "name": "彌勒",
