    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然一度陷入苦戰，",
    "voice": "vo_adv_5054402_001",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n但只要結果是好的，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "一切就皆大歡喜了。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "辛苦了。",
