    "type": "dialogue",
    "name": "初音",
    "words": "你和小栞",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "還出現在夢中呢。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "什麼？",
    "voice": "vo_adv_1284004_040",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "夢的內容？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n那個嘛……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就是我乘著茄子，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "拉著風箏飛在空中，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n而你",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "也要跟我們一起去環遊世界冒險……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_1284004_041",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我也搞不懂自己在講什麼呢。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "總之，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是個有好兆頭又很快樂的初夢喔～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "所以，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "今年一定也會是個快樂的一年！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "雖然剛剛才說過，",
    "voice": "vo_adv_1284004_042",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是真的很謝謝你的賀年卡！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "今年，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "還有往後的每一年，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小初音都要請你多多指教了～！",
