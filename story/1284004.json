[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接下新年第一份工作的{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與初音一起在郊外等候栞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "遊俠裝扮的小栞",
    "voice": "vo_adv_1284004_000",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真的很帥氣呢～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n怎麼還不快來呢～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "對啊～",
    "voice": "vo_adv_1284004_001",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你忘記委託內容了嗎？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不過畢竟才剛開工，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "還沒收心也是難免的嘛～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你記得，",
    "voice": "vo_adv_1284004_002",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "【森林守衛】和遊俠要在今天進行聯合調查嗎？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n為了管理山林的自然環境，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "需要借助雙方的知識和見聞。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "所以說，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞今天是遊俠喔～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，",
    "voice": "vo_adv_1284004_003",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "說人人到，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "她就在那邊了……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n奇怪？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那好像不是小栞……？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？",
    "voice": "vo_adv_1284004_004",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是不是有點刺眼啊！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗚、",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗚哇啊啊～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "510103"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "總算找到你了～！",
    "voice": "vo_adv_1284004_005",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "新年快樂！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯，",
    "voice": "vo_adv_1284004_006",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "今年也請多多指教唷！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不瞞你說，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我寫了賀年卡喔！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是我卻不知道最重要的住址，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "只好到處找你了～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "聽說最近",
    "voice": "vo_adv_1284004_007",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好像很少人會寄賀年卡了，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不過，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我就是想親筆寫一張送給你。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n而且當面交給你的話，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "還能看見你有什麼反應呢！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "所以說呢，",
    "voice": "vo_adv_1284004_008",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "來！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n送你小初音的親筆賀年卡！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "欸嘿嘿～",
    "voice": "vo_adv_1284004_009",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我就是想看你這個笑容～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n不枉費我絞盡腦汁地寫了呢！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？",
    "voice": "vo_adv_1284004_010",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你要現在開始寫嗎？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我要看我要看！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我跟你一起回去～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "background",
    "bg_id": "510090"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "打、",
    "voice": "vo_adv_1284004_011",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "打擾了。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "喔～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你的房間長這樣啊。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我好像是第一次",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "進到男生的房間耶……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "話說，",
    "voice": "vo_adv_1284004_012",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你整理得真乾淨。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "看來你有認真地",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "大掃除呢！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n果然厲害～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "什麼？",
    "voice": "vo_adv_1284004_013",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我嗎？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不是，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你想嘛，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我絞盡腦汁才寫好了賀年卡……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "比起這個，",
    "voice": "vo_adv_1284004_014",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "來寫賀年卡吧！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "什麼大掃除",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "都是無關的事，不准再提囉！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "來，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "面對桌子坐好！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "專心專心！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "首先，",
    "voice": "vo_adv_1284004_015",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "要想些點子才行呢～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你想好要做成",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "什麼樣的賀年卡了嗎？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，",
    "voice": "vo_adv_1284004_016",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "竟然不告訴我……！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不過，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "說得也是啦。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我就只好等你完成了……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "可是，",
    "voice": "vo_adv_1284004_017",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這樣小初音會很無聊的～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "有沒有什麼我能幫忙的地方呢？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "喔！",
    "voice": "vo_adv_1284004_018",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你想要建議是吧！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "賀年卡",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "確實不能少了喜氣的感覺呢！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "包在我身上～！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "幫你按摩肩膀嗎？",
    "voice": "vo_adv_1284004_019",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "可是，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小初音的按摩費用很貴喔？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你確定嗎？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不收你錢，但你要寫張美美的賀年卡給我喔！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我按我按……",
    "voice": "vo_adv_1284004_020",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒想到我是按摩好手吧？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n放鬆下來後，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是不是有浮現好點子啦？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "什麼？",
    "voice": "vo_adv_1284004_021",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
