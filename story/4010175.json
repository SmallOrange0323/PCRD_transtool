  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "啊嗯……",
    "voice": "vo_adv_4010175_000",
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "哇，",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "好好吃。",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "好久沒吃漢堡了。",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n以前姊姊偶爾會買回來，",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n但在店裡吃的話熱騰騰的真好吃。",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "在平時已經該回去準備晚餐的時間還待在店裡，",
    "voice": "vo_adv_4010175_001",
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "也稍微有點",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "在做壞事的感覺呢？",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……而且",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "還是跟「學長」",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "兩個人一起……",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "嘿嘿……",
    "voice": "vo_adv_4010175_002",
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n居然可以像這樣聽到你的祝福，",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "生日真不錯呢。",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "姊姊和布武機",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "雖然也會幫我慶祝",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "但實在太特別了……",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "咦？",
    "voice": "vo_adv_4010175_003",
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n這是……",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "禮物？",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "可、",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "可以收下嗎？",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "嘿嘿……",
    "voice": "vo_adv_4010175_004",
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "嘿嘿嘿……",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n我高興到",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "不禁懷疑真的可以這麼幸福嗎。",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "感覺今天睡醒時心情會很好……♪",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "居然在放學後約會的情境收到禮物，",
    "voice": "vo_adv_4010175_005",
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "生日還真是讓我做了個美夢……♪",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "啊，",
    "voice": "vo_adv_4010175_006",
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "不，",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "沒什麼啦？",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "那個，",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "呃……",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……如果，",
    "voice": "vo_adv_4010175_007",
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n如果你不介意的話……",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "可以再",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n繼續和我一起慶祝嗎？",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "現在",
    "voice": "vo_adv_4010175_008",
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "打開禮物的話",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "感覺有點可惜……",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "因為打開之後",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "就會醒來了。",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……嘿嘿。",
    "voice": "vo_adv_4010175_009",
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 130131
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "「學長」♪",
    "voice": null,
    "unit_id": 130131
  }
]
