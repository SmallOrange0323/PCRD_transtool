    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "──那一天，",
    "voice": "vo_adv_5220051_001",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n我們和騎士先生一起",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "與幻境龍后戰鬥。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "background",
    "bg_id": "501640"
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "那是賭上「現實世界」和",
    "voice": "vo_adv_5220051_002",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "《阿斯特朗傳奇》",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n兩個世界的最終之戰。",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
