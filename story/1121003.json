[
  {
    "type": "background",
    "bg_id": "500550"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在神殿工作的某一天，\\n休息中的{0}與鈴莓――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "甜心，",
    "voice": "vo_adv_1121003_000",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我們是不是不行了……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我好害怕喔，",
    "voice": "vo_adv_1121003_001",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "達令……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦？　",
    "voice": "vo_adv_1121003_002",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那些人",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是怎麼了呢？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "看起來好像非常消沉的樣子……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "說得也是。",
    "voice": "vo_adv_1121003_003",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n或許有什麼我們能幫得上忙的地方！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個～",
    "voice": "vo_adv_1121003_004",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n請問你們遇到了什麼麻煩嗎？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……其實我們",
    "voice": "vo_adv_1121003_005",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "剛才去求籤。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n想說",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "要一起來確認今後的運勢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "結果我們的",
    "voice": "vo_adv_1121003_006",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "戀愛運卻是最差的！！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "同時抽到戀愛運最差的籤，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這機率到底有多低啊！！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我們交往了三年！　",
    "voice": "vo_adv_1121003_007",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "都快接近終點了說！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "沒想到我們的關係竟然會以這種方式結束！！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "居、",
    "voice": "vo_adv_1121003_008",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "居然為了籤的結果這麼動搖……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "難道我也是這種感覺嗎……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就、",
    "voice": "vo_adv_1121003_009",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就是說呢。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呃……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我覺得不需要太在意喔。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n籤只是一種叮嚀，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是類似參考的東西。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我也",
    "voice": "vo_adv_1121003_010",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "曾經因為太在意籤的結果，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "而白忙一場……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "就算妳這麼說……",
    "voice": "vo_adv_1121003_011",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "啊，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "對了！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n巫女小姐，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "請妳替我們結緣吧！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦咦～！？　",
    "voice": "vo_adv_1121003_012",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "為、",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "為什麼會變成這樣！？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "該怎麼說呢，",
    "voice": "vo_adv_1121003_013",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳想想！　",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "就算籤的結果很糟糕，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n但只要有巫女小姐的力量，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "感覺就會有辦法克服了！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "的確！　",
    "voice": "vo_adv_1121003_014",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "況且這裡是神殿，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "應該會有結緣之類的儀式吧？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "為了我們那相親相愛的未來，求求妳了！！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那、",
    "voice": "vo_adv_1121003_015",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真的可以讓我來嗎？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要結緣的話，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還是去拜託祭司大人――",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不，",
    "voice": "vo_adv_1121003_016",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "能在這裡相遇也是某種緣份吧，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我們希望能請巫女小姐來做！　",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳不願意嗎！？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……我、",
    "voice": "vo_adv_1121003_017",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我也不清楚自己能做到什麼程度，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但為了兩位，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我會加油的！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "情侶",
    "words": "謝謝妳！",
    "voice": "vo_adv_1121003_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我去向祭司大人",
    "voice": "vo_adv_1121003_019",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "確認關於結緣的問題，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n請在這裡稍等一下。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這裡沒有進行",
    "voice": "vo_adv_1121003_020",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "結緣的儀式！？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "嗯。",
    "voice": "vo_adv_1121003_021",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "我們是有結緣的護身符，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n但這座神殿只有進行",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "消災解厄和祈求健康的儀式而已……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "真是抱歉。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因、",
    "voice": "vo_adv_1121003_022",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為有護身符，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我還以為一定有儀式呢……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我居然沒有確認清楚，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "怎麼會這樣子～……！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "看來只能",
    "voice": "vo_adv_1121003_023",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "跟他們兩人說這裡沒有進行結緣儀式了。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這樣他們又會很消沉吧……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我自己的方式？",
    "voice": "vo_adv_1121003_024",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "可、",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "可是，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這樣自作主張",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真的好嗎？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "只要有想為了他人去做些什麼的心意，",
    "voice": "vo_adv_1121003_025",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n我想一定",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "會有結緣的效果的。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "雖然這並不是神殿正式的儀式，",
    "voice": "vo_adv_1121003_026",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "但如果有事先向他們說明過情況再進行的話，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "我想應該沒問題的。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……我知道了！",
    "voice": "vo_adv_1121003_027",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "可以請你也來幫忙嗎？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n該怎麼進行結緣比較好，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請你和我一起思考！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不好意思，讓你們久等了。",
    "voice": "vo_adv_1121003_028",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "首先，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
