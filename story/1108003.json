[
  {
    "type": "background",
    "bg_id": "500330"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某個假日。\\n因打工地點接連被檢舉，而失去工作的克蘿依，\\n跑到有點遠的隔壁村莊，拜訪形跡可疑的商人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "妳剛剛說妳叫做克蘿依嗎？",
    "voice": "vo_adv_1108003_000",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "想委託妳",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "採集植物。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊。",
    "voice": "vo_adv_1108003_001",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "植物。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "印象中",
    "voice": "vo_adv_1108003_002",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "在圖鑑上這附近……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "有了有了，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "是這傢伙吧。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "這傢伙是瀕臨滅絕的物種，",
    "voice": "vo_adv_1108003_003",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "不能在一般的市面上販賣。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "但是，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "由於能當作某種黑魔術",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "的催化劑，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "所以才有這樣的需求。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "\\n妳對那是什麼樣的術式",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "有興趣嗎？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，完全沒有。",
    "voice": "vo_adv_1108003_004",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n不如說是，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "完全沒有。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "啊，",
    "voice": "vo_adv_1108003_005",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "對於商品不知情工作起來",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "比較方便的意思嗎。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "比起那些，酬勞更重要。",
    "voice": "vo_adv_1108003_006",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "如果採集那種葉子回來，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n真的會用剛剛提到的",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "價格買進嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "生意最講求的可是",
    "voice": "vo_adv_1108003_007",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "信用，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "我們不會",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "對商業夥伴騙人的唷。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "如果願意幫我們採集的話，",
    "voice": "vo_adv_1108003_008",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "\\n就麻煩妳",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "搭著馬車",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "往東邊的森林前進。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "地圖也先給妳吧，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "拿著。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦……",
    "voice": "vo_adv_1108003_009",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "等等，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "等一下。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這裡是。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "哎呀，",
    "voice": "vo_adv_1108003_010",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "妳注意到了嗎。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "\\n雖然是在人類村莊長大但也知道不少呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "沒錯，",
    "voice": "vo_adv_1108003_011",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "那裡是精靈之森。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "城鎮的人――",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "特別像我們這樣的人是沒辦法進入的。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "\\n我們身上的那股味道，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "可是瞞不住森林的守門人呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "不過，",
    "voice": "vo_adv_1108003_012",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "妳的話應該可以想到辦法吧？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "即使墮落了還是同個種族嘛。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "哦，",
    "voice": "vo_adv_1108003_013",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "說我墮落啊……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真好笑。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "如果沒興趣的話",
    "voice": "vo_adv_1108003_014",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "拒絕也沒關係唷。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "無所謂……",
    "voice": "vo_adv_1108003_015",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我只是在想，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那座森林並不是那麼容易能進入而已。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "嗯……？",
    "voice": "vo_adv_1108003_016",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "\\n看來妳，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "好像還不是這邊的人呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "\\n墮落之前收手",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "也是一條路唷，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "小妹妹。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯――，",
    "voice": "vo_adv_1108003_017",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "也是呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但是，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那種事我自己擔心就好唷。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "隨妳高興。",
    "voice": "vo_adv_1108003_018",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "反正酬勞",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "女商人",
    "words": "最後才會付。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "background",
    "bg_id": "500320"
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "噗呼……",
    "voice": "vo_adv_1108003_019",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "怎麼回事――",
    "voice": "vo_adv_1108003_020",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "沒什麼動力――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "咦――？",
    "voice": "vo_adv_1108003_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n姐姐，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "學校明明放假，妳要去哪啊――？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊――，",
    "voice": "vo_adv_1108003_022",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "有點事。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "打工唷。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "工作嗎？",
    "voice": "vo_adv_1108003_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n明明是放假卻要工作嗎？　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "姐姐，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "好偉大――！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "吶吶，",
    "voice": "vo_adv_1108003_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "是怎麼樣的工作？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n麵包店？　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "打掃相關？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n透過魔石廣播",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "賺取廣告收入？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊……",
    "voice": "vo_adv_1108003_025",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "差不多就是那樣吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n先這樣，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我出門了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "background",
    "bg_id": "500320"
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然這麼說……",
    "voice": "vo_adv_1108003_026",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "唉――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "沒辦法。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n是連對家人",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "也說不出口的工作。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過啊……",
    "voice": "vo_adv_1108003_027",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n希望早日能治好媽媽的疾病，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n好讓那些孩子",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "盡量撒嬌啊――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "唉……",
    "voice": "vo_adv_1108003_028",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "早點離開學校，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "找份不錯的工作好了……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "background",
    "bg_id": "500180"
  },
  {
    "type": "dialogue",
    "name": "森林守衛",
    "words": "哦，",
    "voice": "vo_adv_1108003_029",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "森林守衛",
    "words": "哦。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "森林守衛",
    "words": "\\n所以今天，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "森林守衛",
    "words": "是因為遙遠先祖的緣分",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "森林守衛",
    "words": "而來到這座森林參觀？",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "森林守衛",
    "words": "那麼，歡迎您的蒞臨。",
    "voice": "vo_adv_1108003_030",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "森林守衛",
    "words": "\\n請當作自己的故鄉一樣，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "森林守衛",
    "words": "盡情地在這裡放鬆吧。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_1108003_031",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "森林守衛",
    "words": "我們的住處",
    "voice": "vo_adv_1108003_032",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "森林守衛",
    "words": "就在對面，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "森林守衛",
    "words": "\\n散步回去的時候",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "森林守衛",
    "words": "請務必來坐坐。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "森林守衛",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "森林守衛",
    "words": "那麼告辭了，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "森林守衛",
    "words": "遙遠的遠房客人。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊……走掉了。",
    "voice": "vo_adv_1108003_033",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "噗呼……",
    "voice": "vo_adv_1108003_034",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n話說，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "也太容易就放我進來了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "而且沒有",
    "voice": "vo_adv_1108003_035",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "任何監視……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "安全沒問題嗎，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這座森林。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n也太好搞定了吧，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "看守人。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "……不過，",
    "voice": "vo_adv_1108003_036",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "也許這表示",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我受到信任吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "……即使墮落",
    "voice": "vo_adv_1108003_037",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那麼……",
    "voice": "vo_adv_1108003_038",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯――，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "該怎麼辦呢――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話說回來，",
    "voice": "vo_adv_1108003_039",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n在這種滿地都是草的地方",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "找出不熟悉的草，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n看來",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "也不會太順利呢――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "still",
    "still_id": "110800301"
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "欸，",
    "voice": "vo_adv_1108003_040",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好容易就找到了耶。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "欸……",
    "voice": "vo_adv_1108003_041",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話說這個，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "根本像雜草一般，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n瘋狂地長得到處都是嘛。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n稀有度也太低了吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是殺手筆劍嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "什麼啊，",
    "voice": "vo_adv_1108003_042",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這個讓人沒幹勁的冒險。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n好像一秒過關。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n一點",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "都沒有熱血沸騰的感覺。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "噗……",
    "voice": "vo_adv_1108003_043",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "該怎麼辦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "算了，無論如何，",
    "voice": "vo_adv_1108003_044",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n只要拔出這些草",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "帶回去就好了吧……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "唉……",
    "voice": "vo_adv_1108003_045",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "……啊，",
    "voice": "vo_adv_1108003_046",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好累啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "先暫時停下，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "稍微休息好了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "background",
    "bg_id": "500180"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呀啊啊啊啊啊！",
    "voice": "vo_adv_1108003_047",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你、",
    "voice": "vo_adv_1108003_048",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你是誰……！？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我可是什麼都還沒採啊？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，你是……",
    "voice": "vo_adv_1108003_049",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n蛤！？　",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "為什麼{0}會在這裡……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話說回來，等一下。",
    "voice": "vo_adv_1108003_050",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你能不能不要再突然出現在我背後。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這樣會讓我嚇到，害我無意識地發出萌角般的聲音啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這麼一來，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "可能會因名譽損毀而吃上官司喔。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "……那麼？　",
    "voice": "vo_adv_1108003_051",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你在這裡，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "做什麼。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "又是這個啊。",
    "voice": "vo_adv_1108003_052",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，你到底是要迷路多久。",
    "voice": "vo_adv_1108003_053",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n是興趣嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "跟重訓一樣的頻率，每天都來迷路一下嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話說回來，",
    "voice": "vo_adv_1108003_054",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "能用迷路技踏入精靈之森，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n也算是才能的一種，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "應該要好好培養這項才能才是。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦？",
    "voice": "vo_adv_1108003_055",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊――，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "有點事呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "怎麼樣……",
    "voice": "vo_adv_1108003_056",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個……",
    "voice": "vo_adv_1108003_057",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就是，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "該怎麼說……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "採集相關？　",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "花草的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_1108003_058",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "對，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "觀賞用。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n好像聽說這些草，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "非常好拍",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "又好看呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你看看，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "顛覆這個植物界常理的",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嶄新形式――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，很普通啊……",
    "voice": "vo_adv_1108003_059",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就是THE植物啊……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不如說愈看愈覺得它就是普通的雜草……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "算了，",
    "voice": "vo_adv_1108003_060",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "怎麼說呢就是，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "也許",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這樣反而",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "新奇。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "該說是太樸實",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "反而戳到笑點嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這才是真正的",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "「大草原www」。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "麻煩死了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊――，",
    "voice": "vo_adv_1108003_061",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "對――，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "料理用。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n聽說這種葉子，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "非常的美味。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n無論煮或炒都很好吃，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "家庭主婦",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "也會突然為之瘋狂。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "欸、等等……！？\\n{0}，",
    "voice": "vo_adv_1108003_062",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你在做什麼，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你不能吃啦！",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "可以不要突然",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "用那種清爽感，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "做些脫線的事情嘛。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯……",
    "voice": "vo_adv_1108003_063",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就是，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我剛剛說的",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "都是騙人的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "所以就是啊……",
    "voice": "vo_adv_1108003_064",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n吶，可以不要再這樣了嗎，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這麼單純的疑問。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n會讓我想起出門前的弟弟們，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "有種微妙感。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，",
    "voice": "vo_adv_1108003_065",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個眼神啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n那個純真的眼神。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你們啊，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "很像呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個眼神，",
    "voice": "vo_adv_1108003_066",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "其實很有影響力。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "…………",
    "voice": "vo_adv_1108003_067",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好吧，",
    "voice": "vo_adv_1108003_068",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "決定了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n走吧，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "{0}。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我送你到蘭德索爾吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "跟我來――？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "沒關係。",
    "voice": "vo_adv_1108003_069",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不用。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我不做這個了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "果然。",
    "voice": "vo_adv_1108003_070",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然現在才說。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n不過總覺得，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "連對家人都說謊好像不太對呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "只要看到你，",
    "voice": "vo_adv_1108003_071",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "總會那麼想。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "算是那樣吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "所以，要走了。",
    "voice": "vo_adv_1108003_072",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "克蘿依折返回去，\\n用穩健的步伐離開現場。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦？",
    "voice": "vo_adv_1108003_073",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n{0}，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "為什麼不跟上來。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n一直坐在那裡做什麼。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "別這樣。",
    "voice": "vo_adv_1108003_074",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不行。",
    "voice": "vo_adv_1108003_075",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你是乖孩子，乖乖放在那裡。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好了，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不然阿姨給你殺手筆劍。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}不知道為何被激烈反對，\\n且被硬塞了稀有度很低的道具。",
    "voice": null,
    "unit_id": null
  }
]
