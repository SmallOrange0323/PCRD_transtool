  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯──",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯──",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "能成為話題的……",
    "voice": "vo_adv_1080002_001",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "令人想再來一次的……",
