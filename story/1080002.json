    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哎呀，早安。",
    "voice": "vo_adv_1080002_002",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "{0}也起得真早呢。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦？",
    "voice": "vo_adv_1080002_003",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你看到我在抱頭苦思嗎？",
