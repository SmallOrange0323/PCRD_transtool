  {
    "type": "dialogue",
    "name": "男性",
    "words": "一定要告訴大家才行啊！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嘗試在旅館旁邊設置美體設施，",
    "voice": "vo_adv_1080002_042",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "評價反應很好呢！",
