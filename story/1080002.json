    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "為了不讓身為徒弟的{0}看到我出醜，",
    "voice": "vo_adv_1080002_048",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n以後也得好好努力才行。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就這樣，",
    "voice": "vo_adv_1080002_049",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們這一件工作也辦完了，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們也試試看吧？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
