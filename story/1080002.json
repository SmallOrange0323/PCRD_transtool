    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "用舔舔魚作發想的療癒系玩偶──",
    "voice": "vo_adv_1080002_044",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n「舔舔娃娃」的銷售額也是順利成長中，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n能趁這股風潮變成這個度假村的吉祥物呢。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
