  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我在構思籌備只有在這裡才能獲得的體驗。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "而那份體驗，",
    "voice": "vo_adv_1080002_007",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "得在住客的旅程結束之後建立口碑，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n成為話題越傳越廣，這樣才好。",
