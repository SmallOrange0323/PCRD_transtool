  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呼，",
    "voice": "vo_adv_1080002_010",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
