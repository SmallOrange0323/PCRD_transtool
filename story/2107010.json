        "words": "\\n我是來打聲招呼的，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n但看你們氣氛正好，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "就錯過了搭話的時機。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "嗯？",
        "voice": "vo_adv_2107010_086"
    },
    {
        "name": "拉比林斯達",
        "words": "\\n什麼事啊？",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "──原來如此，",
        "voice": "vo_adv_2107010_087"
    },
    {
        "name": "拉比林斯達",
        "words": "\\n你失去讓其他人第一次變身成公主型態時，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n那種「伸出內心之手的感覺」了是吧。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "唔嗯……",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "……我之前也有",
        "voice": "vo_adv_2107010_088"
    },
    {
        "name": "拉比林斯達",
        "words": "稍微提到過。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n你身為公主騎士的能力",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n已經超乎了我的想像。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "所以這些僅僅是",
        "voice": "vo_adv_2107010_089"
    },
    {
        "name": "拉比林斯達",
        "words": "我的推測罷了。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "但是目前",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "你應該不需要那麼擔心，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n我認為你現在",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "正處於累積力量的階段。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "你下次",
        "voice": "vo_adv_2107010_090"
    },
    {
        "name": "拉比林斯達",
        "words": "究竟會讓我見識到什麼樣的奇蹟呢……",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "說實在的，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "我對此非常有興趣，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n可以的話，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "我是很想親眼見證那瞬間的……",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "我要辦一點事情，",
        "voice": "vo_adv_2107010_091"
    },
    {
        "name": "拉比林斯達",
        "words": "\\n會暫時離開街道一陣子。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "嗯，",
        "voice": "vo_adv_2107010_092"
    },
    {
        "name": "拉比林斯達",
        "words": "謝啦……",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "雖然",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "我很想這麼說，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "但我也不能太小心呢。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n畢竟我打算故意讓【憤怒‧軍團】的傢伙們",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "盯上我嘛。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "當然",
        "voice": "vo_adv_2107010_093"
    },
    {
        "name": "拉比林斯達",
        "words": "是會伴隨著風險的。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n但是，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "這麼做有著令我覺得「這點風險不算什麼」的價值，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n因為這是為了少年你",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "「安穩的日常」啊。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "啊，",
        "voice": "vo_adv_2107010_094"
    },
    {
        "name": "拉比林斯達",
        "words": "你沒有必要在意喔，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n畢竟那些傢伙，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "似乎是為了引出我",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "才會盯上你的嘛。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "再說，",
        "voice": "vo_adv_2107010_095"
    },
    {
        "name": "拉比林斯達",
        "words": "\\n一開始把你捲入其中的人……",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "就是我呀。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "當然──",
        "voice": "vo_adv_2107010_096"
    },
    {
        "name": "拉比林斯達",
        "words": "只不過是自願擔任誘餌，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n這點程度根本稱不上是贖罪，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "這我很清楚，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "我這麼做只不過是自我滿足",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "罷了。",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "主公大人──？",
        "voice": "vo_adv_2107010_097"
    },
    {
        "name": "可可蘿",
        "words": "\\n您會感冒喔……",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "……晶小姐？",
        "voice": "vo_adv_2107010_098"
    },
    {
        "name": "可可蘿",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "原來您來了呀。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "晚安啊，",
        "voice": "vo_adv_2107010_099"
    },
    {
        "name": "拉比林斯達",
        "words": "可可蘿。",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "站著說話也不太方便，",
        "voice": "vo_adv_2107010_100"
    },
    {
        "name": "可可蘿",
        "words": "請您",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "進來坐坐吧。",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "\\n在下",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "立刻去倒茶來……",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "啊～",
        "voice": "vo_adv_2107010_101"
    },
    {
        "name": "拉比林斯達",
        "words": "抱歉抱歉，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n我",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "差不多該走了。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "\\n妳的好意",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "我心領了。",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "這樣啊……",
        "voice": "vo_adv_2107010_102"
    },
    {
        "name": "拉比林斯達",
        "words": "……可可蘿，",
        "voice": "vo_adv_2107010_103"
    },
    {
        "name": "拉比林斯達",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "少年他，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "就拜託你照顧囉。",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "好的，",
        "voice": "vo_adv_2107010_104"
    },
    {
        "name": "可可蘿",
        "words": "\\n請交給在下。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "嗯♪",
        "voice": "vo_adv_2107010_105"
    },
    {
        "name": "拉比林斯達",
        "words": "\\n那就再見囉〜",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "嗯？",
        "voice": "vo_adv_2107010_106"
    },
    {
        "name": "拉比林斯達",
        "words": "…………",
        "voice": "vo_adv_2107010_107"
    },
    {
        "type": "background",
        "bg_id": "500022"
    },
    {
        "name": "拉比林斯達",
        "words": "……哈哈，",
        "voice": "vo_adv_2107010_108"
    },
    {
        "name": "拉比林斯達",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "我本來想替他盡一份力，",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "卻反過來受到他鼓勵了。",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "這樣姊姊我",
        "voice": "vo_adv_2107010_109"
    },
    {
        "name": "拉比林斯達",
        "words": "可得好好努力才行呀……",
        "voice": null
    },
    {
        "name": "拉比林斯達",
        "words": "很好～",
        "voice": "vo_adv_2107010_110"
    },
    {
        "name": "拉比林斯達",
        "words": "加油吧──！",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "並且，正如拉比林斯達所說的一樣──",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "之後好一陣子，",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "{0}一行人\\n都過著安穩的日常生活。",
        "voice": null
