[
  {
    "type": "background",
    "bg_id": "502791"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "終於，明天",
    "voice": "vo_adv_5213104_000",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "「公主小餐館」就要正式登場了呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這樣一來，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "「快閃小餐館」也要告一段落了……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "多少，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還是會有點依依不捨呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "多虧大家的支持，",
    "voice": "vo_adv_5213104_001",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "客人們的反應也很好，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "讓我增添了不少自信。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "料理的手藝，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我覺得也似乎有所提升了呢。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "話雖如此，",
    "voice": "vo_adv_5213104_002",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "兩位。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "在招待客人，端上料理時，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n客人們可曾出現過什麼",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奇怪的舉動嗎？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "或許僅是奴家這桌如此──",
    "voice": "vo_adv_5213104_003",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "客人將料理納入口中之際，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n奴家瞧見其",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "或是眼眶濕潤、",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "雙頰飛紅，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "乃至呼出一縷艷麗之氣。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "哎呀，",
    "voice": "vo_adv_5213104_004",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "連涅妃‧涅羅皇女也是嗎……？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "其實",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我這邊的客人也是……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "該、",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "該怎麼說呢，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "露出了恍惚的表情……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "簡直就像是……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "就像是",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "那個……！",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "非常抱歉，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我實在說不下去了……！",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是的，",
    "voice": "vo_adv_5213104_005",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我那時候也是如此。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "說到這個──",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我想起來了……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n那時刻在",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "底座上的格言。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那個……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「能令齒頰生香，",
    "voice": "vo_adv_5213104_006",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "尚為半吊子。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n得使裳福奔騰，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "方稱真行家。」",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "哎呀，",
    "voice": "vo_adv_5213104_007",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "沒想到您",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "竟然還能背出來呢。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "如果把「裳福」……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "理解成「衣服」的話，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n就等於格言所說的事發生了……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "是這個意思嗎？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "但是……",
    "voice": "vo_adv_5213104_008",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我的技藝",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "仍然很不成熟。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "還沒有達到可以自稱",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "真行家的程度。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不──",
    "voice": "vo_adv_5213104_009",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "薇歐莉特公主，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我認為料理",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就是心意",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "與愛情。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "如果是這樣的話，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那妳一定已經是一位",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "行家了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──原來如此。",
    "voice": "vo_adv_5213104_010",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "聽聞用心烹製之料理，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n有時甚至",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "可凌駕廚者之技藝。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "以母親的料理為天下第一者，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "想來亦不在少數。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "呵呵呵──",
    "voice": "vo_adv_5213104_011",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "既如此，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "若奴家等人亦得品嘗用心款待之佳餚，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n這身裳服或許也要迸裂了呢。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呵呵，",
    "voice": "vo_adv_5213104_012",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "妳在開玩笑吧……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "咦，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "發生什麼事了嗎？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "哎呀，",
    "voice": "vo_adv_5213104_013",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "那個飯糰……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "是您親手",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "捏的嗎？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n是為我們做的嗎……？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……恁，",
    "voice": "vo_adv_5213104_014",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "將心意",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "注入其中……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "…………\\n……",
    "voice": "vo_adv_5213104_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "…………",
    "voice": "vo_adv_5213104_016",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你的心意，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我很高興。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但是",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "現在……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "因為剛才試吃太多，",
    "voice": null,
