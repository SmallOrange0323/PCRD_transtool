[
  {
    "type": "background",
    "bg_id": "501050"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "被牛郎花心劈腿，",
    "voice": "vo_adv_6044105_000",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "織女太可憐了。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖說這也是為了讓祭典順利舉辦……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但為了織女，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們必須盡早解決問題。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯，",
    "voice": "vo_adv_6044105_001",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是啊。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這或許會被人說是多管閒事……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但我也沒成熟穩重到看到那眼淚後，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還能對她置之不理呢。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咦，",
    "voice": "vo_adv_6044105_002",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要從這裡開始解釋！？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呃……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "劈腿就是……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n就是",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "到處找女孩子",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "和她們玩在一起的意思。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這是和坦率又單純的你無關的事情啦。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……人的心",
    "voice": "vo_adv_6044105_003",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是很複雜的。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一旦真的喜歡上了，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "無論發生什麼事都很難討厭對方。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n所以才會有句話說",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "先愛上的那方就輸了，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的。",
    "voice": null,
    "unit_id": 113111
  }
]
