    {
        "name": "旁白",
        "words": "還有突如其來，",
        "voice": "vo_adv_2101014_047"
    },
    {
        "name": "旁白",
        "words": "從天而降的",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "喪失記憶的少女——",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "雪菲小姐。",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "加上了，",
        "voice": "vo_adv_2101014_048"
    },
    {
        "name": "旁白",
        "words": "襲擊了蘭德索爾的神祕少年",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "——卡里莎。",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "在暗處蠢動的新敵人之影。",
        "voice": "vo_adv_2101014_049"
    },
    {
        "name": "旁白",
        "words": "\\n隨著重拾公主身分的",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "貪吃佩可一同出現的——",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "全新的力量。",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "陰謀，",
        "voice": "vo_adv_2101014_050"
    },
    {
        "name": "旁白",
        "words": "希望與絕望所交錯的命運之齒輪，",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "開始劇烈轉動……",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "在下等人的冒險與戰鬥的日子，",
        "voice": "vo_adv_2101014_051"
    },
    {
        "name": "旁白",
        "words": "\\n又再一次，",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "揭開了序幕。",
        "voice": null
    },
