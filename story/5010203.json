    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "日和！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "現在高興還太早了唷。",
    "voice": "vo_adv_5010203_002",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "什麼意思……",
    "voice": "vo_adv_5010203_003",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "欸咦咦咦！？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n又出現新的了——！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "即使打倒了又會馬上出現其他的呢……",
    "voice": "vo_adv_5010203_004",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "既然如此，那就在停止出現前繼續解決掉！",
    "voice": "vo_adv_5010203_005",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "兩位，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要上囉！",
    "voice": null,
