  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在離開廢棄教堂的歸途上，突然下起大雪，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n純與{0}加快腳步返回蘭德索爾──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雪越下越大了。",
    "voice": "vo_adv_1242002_000",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我要再加快腳步了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n少年，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你跟得上嗎？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "怎麼了？少年。",
    "voice": "vo_adv_1242002_001",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我們沒時間耽擱了……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "！？",
    "voice": "vo_adv_1242002_002",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有輛馬車翻覆了！",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "車夫倒在地上……",
    "voice": "vo_adv_1242002_003",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你沒事吧！？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "意識還清楚嗎！？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……唔、",
    "voice": "vo_adv_1242002_004",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "唔嗚……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n救、",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "救……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "太好了，",
    "voice": "vo_adv_1242002_005",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "看來還有意識。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你別說話，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我馬上請求支援……！",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不……",
    "voice": "vo_adv_1242002_006",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不是",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我……！",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我只是受點小傷，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "並不礙事……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我想請妳",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "救救……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我太太，她在車廂裡！！",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦，",
    "voice": "vo_adv_1242002_007",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在車廂裡！？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我馬上去確認……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……什──",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……肚子好大。",
    "voice": "vo_adv_1242002_008",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n是孕婦嗎……！",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "孕婦",
    "words": "唔、",
    "voice": "vo_adv_1242002_009",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "孕婦",
    "words": "唔嗚……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "孕婦",
    "words": "\\n好難受……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "孕婦",
    "words": "呼、",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "孕婦",
    "words": "呼……！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "她剛、",
    "voice": "vo_adv_1242002_010",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "剛剛……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "陣痛突然變劇烈……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我便趕緊駕著馬車要送她去蘭德索爾的醫院……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n卻突然下起大雪，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "導致車輪打滑而翻覆……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "唔嗚！",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，少年，那當然……！",
    "voice": "vo_adv_1242002_011",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，我們該怎麼做呢……？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "車輪……",
    "voice": "vo_adv_1242002_012",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "已經完全脫離，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "看來不大可能馬上修好。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "若是請求蘭德索爾的支援……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "對於這種刻不容緩的緊急情況，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不能說是最好的處置方式……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……現在只能這麼做了。",
    "voice": "vo_adv_1242002_013",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "孕婦",
    "words": "……咦！？",
    "voice": "vo_adv_1242002_014",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳、",
    "voice": "vo_adv_1242002_015",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳一把抱起我太太！？",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n……難、",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "難不成",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳要直接跑回蘭德索爾！？",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒錯，",
    "voice": "vo_adv_1242002_016",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "包在我身上吧。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n因著平日的鍛鍊，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我對於自己的體力很有自信。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "孕婦",
    "words": "可、",
    "voice": "vo_adv_1242002_017",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "孕婦",
    "words": "可是……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "孕婦",
    "words": "我很重的！？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這完全不是問題，請放心。",
    "voice": "vo_adv_1242002_018",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "比起平時所穿的鎧甲，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳就像棉花般的輕盈。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "平、",
    "voice": "vo_adv_1242002_019",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "平時所穿的鎧甲……？",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "現在只能拜託妳了……！",
    "voice": null,
    "unit_id": 3311
  },
  {
