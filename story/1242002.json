    "type": "dialogue",
    "name": "助產士",
    "words": "\\n但寶寶在妳懷中",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "助產士",
    "words": "卻睡得十分安穩又香甜。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "助產士",
    "words": "我想妳肯定有顆溫暖的心吧。",
    "voice": "vo_adv_1242002_063",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "助產士",
    "words": "\\n因為這孩子也感受到了",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "助產士",
    "words": "妳的溫暖。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "溫暖……",
    "voice": "vo_adv_1242002_064",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "助產士",
    "words": "呵呵，",
    "voice": "vo_adv_1242002_065",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "助產士",
    "words": "看得出來！",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "喂喂，",
    "voice": "vo_adv_1242002_066",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_1242002_067",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我已經抱得很滿足了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n寶寶就還給爸爸媽媽吧。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "打擾了。",
    "voice": "vo_adv_1242002_068",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我是【王宮騎士團】的騎士。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n我們有接獲馬車翻覆的消息，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "所以前來確認狀況──",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好了，",
    "voice": "vo_adv_1242002_069",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "後續交給他來處理，應該就沒問題了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那麼，我們先離開吧。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "啊，",
    "voice": "vo_adv_1242002_070",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "請等一下。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n希望妳能告訴我妳的名字！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我的名字不重要。",
    "voice": "vo_adv_1242002_071",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "祝你們一家",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "幸福美滿。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "background",
    "bg_id": "500025"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呼，",
    "voice": "vo_adv_1242002_072",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "想不到自己會見證到",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這超乎想像的一幕。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "能夠幫上忙真是太好了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……呵呵。",
    "voice": "vo_adv_1242002_073",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……？",
    "voice": "vo_adv_1242002_074",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為寶寶的體溫還殘留在手上。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我從沒抱過",
    "voice": "vo_adv_1242002_075",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小嬰兒。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我一直以為我這雙手是用來守護王宮，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "打倒王室之敵的手……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……當我抱著那名孕婦奔跑時，",
    "voice": "vo_adv_1242002_076",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n完全不知道該對她展露什麼樣的表情，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "該說些什麼話。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，我從少年你身上",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "找到了答案。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "首先，",
    "voice": "vo_adv_1242002_077",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你曾對我說要露出笑容，對吧？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "當然，",
    "voice": "vo_adv_1242002_078",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "表情也很重要。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，當時那名孕婦",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為太痛苦而雙眼緊閉，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以我就在想，這次",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "或許不是因為表情的關係。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "即便如此，多虧了你，",
    "voice": "vo_adv_1242002_079",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還是讓她得以放下心來。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你知道為什麼嗎？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為你還為她做了一件事。",
    "voice": "vo_adv_1242002_080",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你當時",
    "voice": "vo_adv_1242002_081",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "很溫柔地握住了",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "她的手。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵，",
    "voice": "vo_adv_1242002_082",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為你很自然地就這麼做，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以根本沒察覺到吧。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n真是個心地善良的少年。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……比起話語和表情，",
    "voice": "vo_adv_1242002_083",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有時手的溫度，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n或許更能傳達出心情。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我想這應該沒錯。",
    "voice": "vo_adv_1242002_084",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n連聽不懂話語的嬰兒",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也感受到了我的心情。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯。",
    "voice": "vo_adv_1242002_085",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖說這也是結果論，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但我很慶幸自己沒有穿著平時的鎧甲。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "若是戴著厚重的手甲，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我大概也沒辦法感受到人的溫暖。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "！！",
    "voice": "vo_adv_1242002_086",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……不，",
    "voice": "vo_adv_1242002_087",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "話不能這麼說。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "對我而言，家訓是絕對不能違背的。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……希望",
    "voice": "vo_adv_1242002_088",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "施加在我身上的變裝魔法能盡快解除。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "純轉過身背對著{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n不讓他察覺到自己臉上略顯哀傷的笑容。",
    "voice": null,
    "unit_id": null
  }
]
