[
  {
    "type": "background",
    "bg_id": "510124"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "漫長的戰鬥終於結束，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "逐漸回歸平靜的日常之際──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與某位少女一同來到了公園。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "那個，",
    "voice": "vo_adv_1405004_000",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "騎士先生？",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n你說想帶我來的地方，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "就是這裡嗎？",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n可麗餅的話，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "我已經吃習慣了說……",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "還有不好吃的店嗎？",
    "voice": "vo_adv_1405004_001",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n總之……",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n那我就不客氣了。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "啊呣……",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "still",
    "still_id": "140500401"
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "嗯，",
    "voice": "vo_adv_1405004_002",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "好好吃。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n水果鮮嫩多汁，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "焦糖醬則是",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "帶著淡淡苦味呢。\\n",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "老姊應該也會喜歡",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "這種味道吧。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "奶油選用外交官奶油這點",
    "voice": "vo_adv_1405004_003",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "也很加分呢。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n啊呣……",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "糟糕，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "會讓人忍不住一直吃。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "still",
    "still_id": "140500402"
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "接下來想吃點不一樣的東西。",
    "voice": "vo_adv_1405004_004",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n你看，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "那個菜單上的",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "今日推薦──",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "still",
    "still_id": "140500403"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂，撫瑠無！",
    "voice": "vo_adv_1405004_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n連騎士先生的安排都不問，就把人帶出來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "甚至還讓他請妳吃可麗餅！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n現在不是說自己想吃別的東西",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "的時候吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "140500401"
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "……冷靜一點嘛。",
    "voice": "vo_adv_1405004_006",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "我的確是說有話要談，才把騎士先生叫出來的。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n但是，不是騎士先生把我們帶來公園的嗎？",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "我哪有叫他請客──",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "still",
    "still_id": "140500403"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那不是因為騎士先生",
    "voice": "vo_adv_1405004_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "顧慮到我們突然拜訪嗎！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "還有我們的身體……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "140500401"
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "好好好好，",
    "voice": "vo_adv_1405004_008",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "我知道了啦。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "話說，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "用這副身體的話，就逃不出老姊的手掌心了嗎……",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "真是沒想到啊……",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "嗯？",
    "voice": "vo_adv_1405004_009",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "什麼？",
    "voice": "vo_adv_1405004_010",
    "unit_id": 127832
  },
  {
    "type": "still",
    "still_id": "140500404"
  },
  {
    "type": "dialogue",
    "name": "燐人",
    "words": "是的！",
    "voice": "vo_adv_1405004_011",
    "unit_id": 127732
  },
  {
    "type": "dialogue",
    "name": "燐人",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 127732
  },
  {
    "type": "still",
    "still_id": "140500402"
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "呵呵……",
    "voice": "vo_adv_1405004_012",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "騎士先生超混亂的耶，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "真好玩。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "燐人",
    "words": "所以我不是說要先解釋清楚比較好嘛……",
    "voice": "vo_adv_1405004_013",
    "unit_id": 127732
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "我明明是想按順序解釋的，",
    "voice": "vo_adv_1405004_014",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "結果擅自跑出來的不就是老姊嗎？",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "果不其然，騎士先生都一頭霧水了。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "關於我們為什麼在這裡，",
    "voice": "vo_adv_1405004_015",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "又為什麼會變成這種狀態呢──",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n就讓我代替不擅長解釋的老姊，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n簡單說明一下吧。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "燐人",
    "words": "這句話太多餘了！！",
    "voice": "vo_adv_1405004_016",
    "unit_id": 127732
  },
  {
    "type": "still",
    "still_id": "140500401"
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "話雖如此，",
    "voice": "vo_adv_1405004_017",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "事情其實很簡單。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n就是老姊和我",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "進入了同一副義體，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n反向登入到這邊來了～",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "哇──",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "鼓掌鼓掌鼓掌～",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "這個嘛，",
    "voice": "vo_adv_1405004_018",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "原本是",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "萊拉耶爾殿下提議的。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "萊拉耶爾殿下",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "希望有朝一日她回到",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "[rub:這邊]現實[/rub]時，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n我們也能以女僕的身分",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "一起過來。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "就如騎士先生所知，",
    "voice": "vo_adv_1405004_019",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "我們其實",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "並不存在於這邊。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n如果保持原樣，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "就無法過來這邊。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "如果有能在[rub:這邊]現實[/rub]活動的身體──",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "情況就不一樣了呢。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "我們曾聽可可蘿小姐提過，",
    "voice": "vo_adv_1405004_020",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "有一種叫做",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "「義體」的技術，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "但聽說價格不菲。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "正煩惱該如何是好時……",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "似乎得到了帆稀小姐的幫助。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "如此如此這般這般，",
    "voice": "vo_adv_1405004_021",
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "「燐人撫瑠無」總算誕生了，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "事情大概就是這樣。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "只要能侍奉",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "萊拉耶爾殿下，",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n無論到哪裡，我們都會去的。",
    "voice": null,
    "unit_id": 127832
  },
  {
    "type": "dialogue",
