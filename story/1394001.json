        "words": "隊長！？",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "畢竟你們這些不可靠的傢伙",
        "voice": "vo_adv_1394001_085"
    },
    {
        "name": "艾麗卡",
        "words": "這次很努力。",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "我雖然是臨時指揮官，",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "但也該給點慰勞。",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "只是，",
        "voice": "vo_adv_1394001_086"
    },
    {
        "name": "艾麗卡",
        "words": "\\n在我製作漢堡排的期間，",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "你們要繼續鍛鍊喔。",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "因為你們好歹也是我的公會，",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "【黑森林】的一員。",
        "voice": null
    },
    {
        "name": "精靈族之村的居民１",
        "words": "是，",
        "voice": "vo_adv_1394001_087"
    },
    {
        "name": "精靈族之村的居民１",
        "words": "那當然！",
        "voice": null
    },
    {
        "name": "精靈族之村的居民１",
        "words": "\\n謝謝妳，",
        "voice": null
    },
    {
        "name": "精靈族之村的居民１",
        "words": "隊長……！",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "唉……",
        "voice": "vo_adv_1394001_088"
    },
    {
        "name": "艾麗卡",
        "words": "\\n好不容易才獲得勝利，",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "\\n為什麼會變成我得做漢堡排的局面……",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "……那是",
        "voice": "vo_adv_1394001_089"
    },
    {
        "name": "艾麗卡",
        "words": "什麼意思啊？",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "語氣聽起來不像是挖苦，",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "反而更讓人生氣……",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "是說，",
        "voice": "vo_adv_1394001_090"
    },
    {
        "name": "艾麗卡",
        "words": "你也來幫忙吧。",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "\\n畢竟我對這個世界",
        "voice": null
    },
    {
        "name": "艾麗卡",
        "words": "一竅不通。",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "艾麗卡雖然態度冷淡，",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "\\n但似乎也沒有那麼不情願……",
        "voice": null
    }
]