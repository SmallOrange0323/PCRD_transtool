  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n妳自己又在偷懶了！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n妳從剛才開始就一直在拜託克蘿茜小姐對吧！",
