    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n成功完成心跳加速的危險驚喜吧。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "了解。",
