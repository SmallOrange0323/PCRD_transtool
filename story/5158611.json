    "type": "dialogue",
    "name": "伊緒",
    "words": "我明白了。",
    "voice": "vo_adv_5158611_020",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n果然還是",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "只能那麼做了。",
    "voice": null,
    "unit_id": 132912
  },
  {
