    "name": "萊拉耶爾",
    "words": "沒錯。",
    "voice": "vo_adv_5158611_021",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我們會負起責任，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n哄你入睡的。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那麼，",
    "voice": "vo_adv_5158611_022",
    "unit_id": 132912
  },
