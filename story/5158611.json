    "type": "dialogue",
    "name": "伊緒",
    "words": "來。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n你可以",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "握住我們的手嗎？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "接著，騎士，",
    "voice": "vo_adv_5158611_023",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "請你專心感受",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "手的溫度及觸感。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "沒錯，",
    "voice": "vo_adv_5158611_024",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "做得好……",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "請你緊緊握住，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n但是要溫柔地握，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，",
    "voice": "vo_adv_5158611_025",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "很舒服嗎？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你果然",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "也是男孩子呢。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "既厚實",
    "voice": "vo_adv_5158611_026",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "又剛強……",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n跟我的手指完全不同……",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "怎麼樣呢？",
    "voice": "vo_adv_5158611_027",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你不覺得",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我們好像在交換體溫一樣嗎？",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n來，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "把眼睛閉起來。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n做深呼吸，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "感受我們吧。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這就是",
    "voice": "vo_adv_5158611_028",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "彼此連結的感覺喔。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n很舒服對吧……",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "如何呀，",
    "voice": "vo_adv_5158611_029",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "牽著手",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是不是逐漸放鬆下來了呢？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這樣子",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "有比較能熟睡了嗎？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "still",
    "still_id": "515861101"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾、伊緒",
    "words": "咦咦……！？",
    "voice": "vo_adv_5158611_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……萊拉耶爾，",
    "voice": "vo_adv_5158611_031",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "該怎麼辦呢。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "要是沒辦法哄他入睡，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "身為聖誕節的惡魔，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n可就傷腦筋了……",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那個……",
    "voice": "vo_adv_5158611_032",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "既然如此",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n……這種時候試試搖籃曲",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "怎麼樣呢？",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你有想聽的歌的話，可以跟我說。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，",
    "voice": "vo_adv_5158611_033",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "真是乖孩子。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "來，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "再把眼睛閉起來一次……",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，聖誕節惡魔們有如奇妙夢境般的嘗試，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n反覆持續了下去。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣到了隔天早上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}從神奇的夢裡醒了過來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n枕邊放著似曾相識的聖誕禮物。",
    "voice": null,
    "unit_id": null
  }
]
