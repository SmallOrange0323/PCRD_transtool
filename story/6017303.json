  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這個城鎮好熱鬧呢。",
    "voice": "vo_adv_6017303_000",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n拉姆的世界裡",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "也有像這樣熱鬧的地方，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不過我們",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "平常都待在宅邸裡面。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你問我",
    "voice": "vo_adv_6017303_001",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是什麼樣的地方，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "我也很難解釋。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "既然你失去了記憶，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那應該先去了解",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n自己所在的世界才對吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆不是因為懶得解釋才這麼說喔。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "王都……",
    "voice": "vo_adv_6017303_002",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "就是個",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "人山人海的地方。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "我覺得",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "和這裡沒有什麼太大的差別，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "該怎麼說呢？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "我想應該是被黑暗所掩蓋的部分很像。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "嗯……",
    "voice": "vo_adv_6017303_003",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "有很多必須打掃的地方。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "整理花圃和洗衣服都很辛苦。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不過，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "主要都是雷姆在做就是了。",
    "voice": null,
    "unit_id": 109811
  }
]
