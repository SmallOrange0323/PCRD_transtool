    "words": "…………",
    "voice": "vo_adv_5201006_007",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "能",
    "voice": "vo_adv_5201006_008",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "不能別隨便跟我搭話？",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n目前妳還派不上什麼用場。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n作為實驗鼠就安分地待著吧。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "…………",
    "voice": "vo_adv_5201006_009",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──之後的幾天裡，開發沉默地持續著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "…………",
    "voice": "vo_adv_5201006_010",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "…………",
    "voice": "vo_adv_5201006_011",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "…………",
    "voice": "vo_adv_5201006_012",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "………………………………………………真是令人絕望的命名品味呢。",
    "voice": "vo_adv_5201006_013",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "呵呵，",
    "voice": "vo_adv_5201006_014",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈哈哈！",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "……妳有什麼事嗎？",
    "voice": "vo_adv_5201006_015",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "克莉絲。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真抱歉。",
    "voice": "vo_adv_5201006_016",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "因為你們展開的對話過於有趣，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我實在忍不住。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "區區的自言自語",
    "voice": "vo_adv_5201006_017",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "可稱不上是對話啊。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "別用沒意義的閒聊浪費我的時間。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "畢竟俗話說，",
    "voice": "vo_adv_5201006_018",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "時間就是金錢呢。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "哎呀，",
    "voice": "vo_adv_5201006_019",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n妳是說妳能用金錢來換我的時間嗎？",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "請原諒我的",
    "voice": "vo_adv_5201006_020",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "諸多失禮。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "對了，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我有一份真那大人在等的報告。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "從園上矛依未身上分析出的技能已經編入完成了。",
    "voice": "vo_adv_5201006_021",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "園上……",
    "voice": "vo_adv_5201006_022",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "既然說到技能，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "就是那個實驗品吧。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n真是花了相當長的時間呢。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "連名字都不記得",
    "voice": "vo_adv_5201006_023",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊……",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "花時間是當然的，",
    "voice": "vo_adv_5201006_024",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n畢竟",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那傢伙可稱不上配合。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是因為有晶的居中協調",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "才總算完成。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "……依舊很天真呢。",
    "voice": "vo_adv_5201006_025",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "那個迷宮女王。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "晶身為七冠的同時，也是個與我們不同的",
    "voice": "vo_adv_5201006_026",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "傢伙啊。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "哼，",
    "voice": "vo_adv_5201006_027",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "真讓我覺得噁心。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "妳報告結束的話就走吧。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我也希望能",
    "voice": "vo_adv_5201006_028",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "被真那大人如此熱情地惦記著呢。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那麼",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我告辭了。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "……",
    "voice": "vo_adv_5201006_029",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "惦記他人根本",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "毫無意義啊。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "我要登入了。",
    "voice": "vo_adv_5201006_030",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n趕快準備好。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "background",
    "bg_id": "500146"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "連接過程沒有異常。",
    "voice": "vo_adv_5201006_031",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n不過也理所當然就是了。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我要立刻進行技能的確認。",
    "voice": "vo_adv_5201006_032",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n讀出顯示在介面上的技能吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "500146"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "確認發動。",
    "voice": "vo_adv_5201006_033",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n繼續。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "500146"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "發出的光太強了呢。",
    "voice": "vo_adv_5201006_034",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "多人同時使用的時候可能會損害視力。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "500146"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "真不起眼呢。",
    "voice": "vo_adv_5201006_035",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "如果不再讓外觀華麗點，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n闇系魔法很少會有人選用吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "──那就不必了。",
    "voice": "vo_adv_5201006_036",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這技能是什麼東西啊？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "屬性效果也一如設定。",
    "voice": "vo_adv_5201006_037",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n其實我是想讓重現性再提高一點的。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "但她無論處境如何依舊很囂張呢……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那個實驗品。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "好了，",
    "voice": "vo_adv_5201006_038",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "接下來是命中確認。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n去站在那邊。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "對，",
    "voice": "vo_adv_5201006_039",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那邊就行了。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "把體力上限值設定為無限──",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "──究極混沌。",
    "voice": "vo_adv_5201006_040",
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "500146"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "命中確認……",
    "voice": "vo_adv_5201006_041",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "沒有問題。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "趕快站起來。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "反正也沒有疼痛感吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "以妳的情況是會感受到嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不過與我無關就是了。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "接下來",
    "voice": "vo_adv_5201006_042",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我會用所有種類的技能擊中妳。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n妳要",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "把承受那些時的感覺總結成報告提出來。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……什麼？",
    "voice": "vo_adv_5201006_043",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n妳說希望我在攻擊之前",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "先說明？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我沒必要一一徵詢實驗道具的意見吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "唉……",
    "voice": "vo_adv_5201006_044",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "別說多餘的話。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "被我們善加運用就是妳的使命喔。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "作為實驗品的小天竺鼠。",
    "voice": "vo_adv_5201006_045",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "──幸雨澄花。",
    "voice": "vo_adv_5201006_046",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……",
    "voice": "vo_adv_5201006_047",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "為何突然說這個？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "一決勝負……",
    "voice": "vo_adv_5201006_048",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳該不會",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "以為能用這些技能就可以戰鬥了吧？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "真無聊。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "浪費時間──",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "雖然我是想這麼說，",
    "voice": "vo_adv_5201006_049",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "但還真有意思呢。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳究竟在想什麼，竟然敢向我發起挑戰？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "區區一隻稀有的實驗動物",
    "voice": "vo_adv_5201006_050",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "是想向我請求什麼？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "說說看吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……什麼？",
    "voice": "vo_adv_5201006_051",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "稱呼名字",
    "voice": "vo_adv_5201006_052",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "無法理解呢。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……那對妳有什麼好處？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不過……",
    "voice": "vo_adv_5201006_053",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也是呢……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "好，",
    "voice": "vo_adv_5201006_054",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我就接受妳的挑戰。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n不論是怎樣的老鼠，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "都要給其露出獠牙的機會吧？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "正好，",
    "voice": "vo_adv_5201006_055",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我就先來確認調整中的權能吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "畢竟實戰形式的數據",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "還不夠呢……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那就",
    "voice": "vo_adv_5201006_056",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "趕快上吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不需要特地宣布開始戰鬥。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "500146"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "可惜，",
    "voice": "vo_adv_5201006_057",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "沒打中喔。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "500146"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳是在瞄準哪裡？",
    "voice": "vo_adv_5201006_058",
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "500146"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "連邊都沒沾到呢。",
    "voice": "vo_adv_5201006_059",
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "500146"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……",
    "voice": "vo_adv_5201006_060",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "唉。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "既然妳都來挑戰了，",
    "voice": "vo_adv_5201006_061",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我還以為妳是不是有什麼勝算，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n但看來是毫無對策，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "只不過是得到了技能就得意忘形呢。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不過，",
    "voice": "vo_adv_5201006_062",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳打不中是理所當然的。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n霸瞳天星也可說是幾乎完成了呢。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "對我的",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "大腦負擔有點大就是了。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……怎麼了？",
    "voice": "vo_adv_5201006_063",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n攻擊已經結束了嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "還真不死心呢。",
    "voice": "vo_adv_5201006_064",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n那副模樣……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "令人噁心。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "500146"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "再多加油點吧？",
    "voice": "vo_adv_5201006_065",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "來。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "500146"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這招如何？",
    "voice": "vo_adv_5201006_066",
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "500146"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "呵呵，",
    "voice": "vo_adv_5201006_067",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳完全躲不過嘛。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "喝啊──",
    "voice": "vo_adv_5201006_068",
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "500146"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "──我說，",
    "voice": "vo_adv_5201006_069",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳要持續這場鬧劇到什麼時候？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳的攻擊一次都沒打中，",
    "voice": "vo_adv_5201006_070",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我的攻擊則全都打中了。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我想這場戰鬥的勝負早已分曉了吧？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不如說，",
    "voice": "vo_adv_5201006_071",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這孩子……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……打從一開始就沒躲",
    "voice": "vo_adv_5201006_072",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就只是承受攻擊，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "然後頑強地站起來而已。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳有什麼打算？",
    "voice": "vo_adv_5201006_073",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我也已經修理妳到膩了啊。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……啊？",
    "voice": "vo_adv_5201006_074",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳在說什……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……！",
    "voice": "vo_adv_5201006_075",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n體力的上限值維持在無限狀態……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也就是說，",
    "voice": "vo_adv_5201006_076",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "她的角色是不會戰敗的。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這是我的疏失呢。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我原本心想跟實驗鼠戰鬥不需要什麼規則。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不過也好，",
    "voice": "vo_adv_5201006_077",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不論幾小時，我都會繼續照這方式",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "折磨妳直到妳屈服。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……嘖，",
    "voice": "vo_adv_5201006_078",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "才剛對克莉絲說完時間的價值，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n自己卻落入要浪費時間的境地，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "真不是滋味。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……？",
    "voice": "vo_adv_5201006_079",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "說到底，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這個實驗品的",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "身體撐不住長時間的拷問。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這孩子",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "自己應該是最清楚的才對──",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "──啊啊，是嗎？",
    "voice": "vo_adv_5201006_080",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "是這麼一回事。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n她打從一開始就沒打算",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "以技能對峙跟我決勝負。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "而是在了解「自身利用價值」的前提下，",
    "voice": "vo_adv_5201006_081",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n把那當成了賭金。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "時間沒有限制，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "要是我贏了，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就會失去一個寶貴的實驗品",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "字面意義上的賭上性命。",
    "voice": "vo_adv_5201006_082",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "比我以為的還難對付嘛。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n竟然單方面把勝負的決定權硬推給我。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "囂張的孩子。",
    "voice": "vo_adv_5201006_083",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n在我創造的世界裡，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "並不需要像妳這種類型的人呢……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……沒錯，",
    "voice": "vo_adv_5201006_084",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n一切如我所願的",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "新世界。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不會有任何人妨礙我，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "只有膜拜",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "與崇敬，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "屬於我的世界。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我將會成為那個世界的神。",
    "voice": "vo_adv_5201006_085",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "啊，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "雖然我不曉得其他七冠怎麼想。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n但就算那些傢伙打算妨礙我，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我也會按照我所希望的去做。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "嗯……？",
    "voice": "vo_adv_5201006_086",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳在懷疑什麼？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "真令人不快呢……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "簡直就像想說妳比我還理解我自己一樣嘛。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳──",
    "voice": "vo_adv_5201006_087",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "在「看」著什麼？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "是因為使用靈魂登入嗎？",
    "voice": "vo_adv_5201006_088",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n還是說妳有讀取他人記憶的方法？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "別開玩笑了，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "竟然有除了我以外的人妄圖理解我……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……配合這場鬧劇就到此為止吧。",
    "voice": "vo_adv_5201006_089",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我能肯定，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我是不會認輸的。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "所以，",
    "voice": "vo_adv_5201006_090",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳就認輸吧──",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "──澄花。",
    "voice": "vo_adv_5201006_091",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……哼。",
    "voice": "vo_adv_5201006_092",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳問我真正的",
    "voice": "vo_adv_5201006_093",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "願望嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "真正的願望，除了我之外還有誰能夠理解？　",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我不需要什麼理解我的人。",
    "voice": "vo_adv_5201006_094",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我的這個願望是不會有錯。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我只要，",
    "voice": "vo_adv_5201006_095",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "能夠成為新世界的神就好了──",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "七冠──霸瞳皇帝。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n千里真那為了登上唯一神的寶座而走上孤高的道路，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n從未正視自己心中真正的願望。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510460"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真那大人，",
    "voice": "vo_adv_5201006_096",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我拿午餐過來了。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "我有說不用特地拿過來了吧。",
    "voice": "vo_adv_5201006_097",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "因為晶吵著說要好好吃飯啊。",
    "voice": "vo_adv_5201006_098",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "開發的狀況如何了？",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "妳是想說我有狀況起伏不定的時候嗎？",
    "voice": "vo_adv_5201006_099",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈！",
    "voice": "vo_adv_5201006_100",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n看來我問了個蠢問題呢！",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "不過，",
    "voice": "vo_adv_5201006_101",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "比起研究叛逆的實驗品，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "是要讓人舒服一些呢，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "澄花她。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哦……",
    "voice": "vo_adv_5201006_102",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "您變成以名字來稱呼她了呢。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "能不能別一一說出微不足道的事？",
    "voice": "vo_adv_5201006_103",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n真讓人不快啊。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "這是技能調整的整理報告，",
    "voice": "vo_adv_5201006_104",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n妳拿著這個就快滾吧。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我知道了。",
    "voice": "vo_adv_5201006_105",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "…………",
    "voice": "vo_adv_5201006_106",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "……真殘酷呢。",
    "voice": "vo_adv_5201006_107",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "要我用名字稱呼，",
    "voice": "vo_adv_5201006_108",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "還真是非常殘酷的願望啊。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "明明時候到了",
    "voice": "vo_adv_5201006_109",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "遲早都會消失的。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "沒有人聽見千里真那的低語。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n霸瞳皇帝沒有動冷掉的午餐，",
    "voice": null,
    "unit_id": null
  },
  {
