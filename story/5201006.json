  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──那是過去確實存在過的一段時光。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n妳的意識慢慢地甦醒過來。",
    "voice": null,
