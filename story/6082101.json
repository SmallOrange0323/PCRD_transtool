  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "魚介の本場、",
    "voice": "vo_adv_6056101_000",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "オーマの海♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "究極のお魚以外にも、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "たくさんの海の幸がとれるそうですよ♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "\\nあなたはどんなお魚が食べたいですか？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "おおっ、",
    "voice": "vo_adv_6056101_001",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "焼き魚ですか！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "そのままいただくのもおいしいですけど、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "やっぱり焼くのは定番です♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "炎の上でしたたる脂……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "ぜひ釣りましょう！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "あっ、",
    "voice": "vo_adv_6056101_002",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "もしかして前に食べたサラダのことですか？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "えへへ、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "確かにあの味は簡単に忘れられません♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "ニュルニュルが釣れたら、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "ぜひサラダにしていただきましょう！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "へ？　",
    "voice": "vo_adv_6056101_003",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "手足のあるサメなんているんですか？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "……海で野球をしている時に見たことある……？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "そ、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "そのお話、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "ぺコリーヌ",
    "words": "もう少し詳しくお願いしますっ！",
    "voice": null,
    "unit_id": 105812
  }
]
