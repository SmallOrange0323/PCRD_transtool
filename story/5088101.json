  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "怎麼辦……",
    "voice": "vo_adv_5088101_000",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n咲戀育幼院的狀況感覺不太對勁……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "食物變不見，",
    "voice": "vo_adv_5088101_001",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "廚房的鍋子和湯勺憑空消失，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n甚至還有奇怪的聲響傳出……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "到底是發生什麼事了……！？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "得設法",
    "voice": "vo_adv_5088101_002",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "保衛我們的家園！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "這樣下去，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咲戀育幼院會……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我也來幫忙，",
    "voice": "vo_adv_5088101_003",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "畢竟我可是",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "成熟的淑女！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……呃，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗯，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "雖然我不知道能幫上什麼忙啦！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「但是想設法解決這場危機，",
    "voice": "vo_adv_5088101_004",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "對吧？」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "沒錯沒錯，",
    "voice": "vo_adv_5088101_005",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就是那個！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我們為了保護重要的育幼院，",
    "voice": "vo_adv_5088101_006",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "能做到的事。",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我會找找看的！！",
    "voice": null,
    "unit_id": 102111
  },
  {
