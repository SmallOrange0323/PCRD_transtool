  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與聖獸開心交流的真步與{0}，\\n等回過神已經日落時分了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "轉眼間一天就過去了呢。",
    "voice": "vo_adv_1106004_000",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生，",
    "voice": "vo_adv_1106004_001",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您看呀。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n在夕陽的照射下，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "大海也一閃一閃的。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "宛如",
    "voice": "vo_adv_1106004_002",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "光芒",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "從天而降一般呢。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n璀璨閃耀，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真是好耀眼～",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "哎呀？　",
    "voice": "vo_adv_1106004_003",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這個",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "難道說",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "光芒真的從天而降了？",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真漂亮♪",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "background",
    "bg_id": "510240"
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "啊，",
    "voice": "vo_adv_1106004_004",
    "unit_id": 101032
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生，",
    "voice": null,
    "unit_id": 101032
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您好。",
    "voice": null,
    "unit_id": 101032
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101032
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 101032
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家想說",
