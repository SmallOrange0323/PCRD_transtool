[
  {
    "type": "background",
    "bg_id": "502921"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "夕陽的光輝",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "將泳池染成了橘紅色。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n即使是太陽即將落下的這個時刻，氣溫仍相當炎熱。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而在這當下，有兩個美少女正認真地進行對決。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機、班比",
    "words": "「「剪刀、石頭、",
    "voice": "vo_adv_5219007_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機、班比",
    "words": "布！！」」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好♪",
    "voice": "vo_adv_5219007_001",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是班比贏了♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n那麼就麻煩妳",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "清掃這一區囉♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "啊！？",
    "voice": "vo_adv_5219007_002",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "怎麼又來～！？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n為什麼每次班比都是一次就猜贏啊！？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n這根本是作弊吧，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "作弊仔班比～！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦～",
    "voice": "vo_adv_5219007_003",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "人家沒有作弊呀～？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "畢竟班比可是",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "最強的呢～？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好啦好啦，",
    "voice": "vo_adv_5219007_004",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "布武機！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n動手打掃囉！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "唔唔唔嗚喵～～",
    "voice": "vo_adv_5219007_005",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "～～！！！！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊，",
    "voice": "vo_adv_5219007_006",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n營運要談的事",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "都說完了嗎？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n結果如何？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這樣呀。",
    "voice": "vo_adv_5219007_007",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不過太好了呢。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n至少不是要去坐牢。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "在進行對決喔！",
    "voice": "vo_adv_5219007_008",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n剛才呀──",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嗚哇～！",
    "voice": "vo_adv_5219007_009",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n為什麼",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "人家非得打掃泳池不可啦～！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "怎麼還在抱怨呀～",
    "voice": "vo_adv_5219007_010",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n是幸好魅惑很快就解除，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "大家都不記得發生什麼事，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n才僅止於打掃泳池就好的耶──？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "可是可是～！",
    "voice": "vo_adv_5219007_011",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "帳號被凍結！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "發布的影片也全數刪除！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n甚至連獎金也要通通沒收，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "這樣會不會太過分啦！？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n明明應該要可愛就是正義，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "美少女無罪的呀～！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就──說──了──",
    "voice": "vo_adv_5219007_012",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n只要妳乖乖",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "打掃泳池，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n營運就會幫妳解除帳號的封鎖，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不是這樣說好了嗎！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "加上如果缺零用錢，",
    "voice": "vo_adv_5219007_013",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n營運那邊不是",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "向妳買下了隱身號的設計圖嗎？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n有這筆錢花就不錯了，忍著點！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "更何況隱身號",
    "voice": "vo_adv_5219007_014",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "還免於遭到「拆解」的下場呀。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真是太好了呢，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "隱身號的主人♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "……",
    "voice": "vo_adv_5219007_015",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "那個啊。",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n妳好像有去找營運，替我說話對吧？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n關於這個，怎麼說，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "謝啦。",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不客氣♪",
    "voice": "vo_adv_5219007_016",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那麼，布武機。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n對決的部分",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就算是班比贏了，可以吧♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "啊！？",
    "voice": "vo_adv_5219007_017",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n為什麼！？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "怎麼是算妳贏！？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這也是",
    "voice": "vo_adv_5219007_018",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "沒辦法的事嘛。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n畢竟布武機那邊發布的東西",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "全都不見了。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "這不是說聲「沒辦法嘛」就行得通的好嗎！",
    "voice": "vo_adv_5219007_019",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n我獲得最多愛心數量的這個事實，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n可沒有因此消失啊！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "要我跟班比道歉，",
    "voice": "vo_adv_5219007_020",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n我寧願去舔哥哥的腳！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n……",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不。",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "老實說我也不想那樣做……",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是嗎。",
    "voice": "vo_adv_5219007_021",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那麼，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就當作平手吧。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n畢竟班比因為大意輕敵而輸掉的事，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "確實是真的。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "下次",
    "voice": "vo_adv_5219007_022",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比會拿出全力來贏得對決的♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "真不愧是高尚的吸血鬼大人呢ｗ",
    "voice": "vo_adv_5219007_023",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n……",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "那──麼──？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "要不要來比場",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "延長賽呀～？♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "輸的人就要",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "打掃泳池喔♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哦…………",
    "voice": "vo_adv_5219007_024",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "雖然布武機說是「比賽」，",
    "voice": "vo_adv_5219007_025",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n但其實她只是想把打掃的工作推給班比，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n自己跑去偷懶而已。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "但打掃",
    "voice": "vo_adv_5219007_026",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是布武機和營運約好要做的事呀。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n必須得由布武機自己完成才行吧？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "所以班比就",
    "voice": "vo_adv_5219007_027",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "想到了一個「策略」！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n如果是比猜拳，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比是絕對不會輸給布武機的♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嗚嗚……",
    "voice": "vo_adv_5219007_028",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "人家受夠了……",
    "voice": null,
