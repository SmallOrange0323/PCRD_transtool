[
  {
    "type": "background",
    "bg_id": "510360"
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "猫たちと職場をともにしているわけだが……",
    "voice": "vo_adv_6106105_000",
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "困ったことに、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "いまだに仲良くなれない猫が何匹かいてな。",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n貴公には懐いているようだが、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "なにかコツがあるのか？",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "というと、",
    "voice": "vo_adv_6106105_001",
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "まかないで出している食事に",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n不満があったということか……",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "猫とはいえ味の好みはあるものな。",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nいくつか種類を工面して好き嫌いを探ってみるか。",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "押してだめなら引いてみろ、",
    "voice": "vo_adv_6106105_002",
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "と？　",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "なるほど、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "それであえて",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n興味を引いてみようという作戦か……",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "しかしなんというか貴公は、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n本当に周囲から好かれる術に長けているな。",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "べ、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "別に他意はないが……",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "か、",
    "voice": "vo_adv_6106105_003",
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "神さま……！？　",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "それほど格の高い動物だったのか……",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "しかしそう聞くと、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "あの気位の高さにも納得がいくな。",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n次からは献上品も持参して、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "もっと丁重に接してみるとしよう。",
    "voice": null,
    "unit_id": 105312
  }
]
