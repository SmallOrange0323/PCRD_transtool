[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在廣場散步的伊莉亞與{0}突然被光芒所包覆。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哇，怎麼了！？",
    "voice": "vo_adv_1044008_000",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n又是這道光！！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔……！",
    "voice": "vo_adv_1044008_001",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n發、",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "發生什麼事了！？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "background",
    "bg_id": "510120"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呼……呼……嗚……妾身已經不行了……",
    "voice": "vo_adv_1044008_002",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒想到，太陽居然會大成這樣……",
    "voice": "vo_adv_1044008_003",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n就算戴上帽子，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "體力還是被耗盡了。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只不過想去買個番茄汁而已，",
    "voice": "vo_adv_1044008_004",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身也就到此為止了嗎……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "至少在最後，",
    "voice": "vo_adv_1044008_005",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n真希望能讓妾身咬一口",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "充滿活力的男人的脖子……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯、嗯嗯……！",
    "voice": "vo_adv_1044008_006",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n等、等一下啦！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不要搖這麼大力！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呼、呼……",
    "voice": "vo_adv_1044008_007",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這樣不是害妾身消耗更多體力了嗎！？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喔，你要為了妾身犧牲自己嗎？",
    "voice": "vo_adv_1044008_008",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯嗯，真感動。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n那麼，妾身就不客氣了……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊唔……啊唔啊唔……",
    "voice": "vo_adv_1044008_009",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……不行。",
    "voice": "vo_adv_1044008_010",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n已經連咬的力氣都不夠了……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "倘若庫存的番茄汁還有剩，就不會發生這種事了……",
    "voice": "vo_adv_1044008_011",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……嗯？",
    "voice": "vo_adv_1044008_012",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n那個塑膠袋裡放的該不會――",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是、是蕃茄汁嗎！？",
    "voice": "vo_adv_1044008_013",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "快拿來！",
    "voice": "vo_adv_1044008_014",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n現在馬上拿給妾身！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……",
    "voice": "vo_adv_1044008_015",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "咕嚕！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "咕嚕、咕嚕……呼啊～！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵……",
    "voice": "vo_adv_1044008_016",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵哈哈哈哈，哈～哈哈哈！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身復活啦！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "現在妾身的身體裡，",
    "voice": "vo_adv_1044008_017",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n彷彿湧出了足以征服全世界的力量！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "狗",
    "words": "汪汪！",
    "voice": null,
    "unit_id": 1811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "咦？什麼，是小狗啊……",
    "voice": "vo_adv_1044008_018",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "看在妾身現在心情好的份上。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n小狗，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就讓你靠近妾身吧！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "狗",
    "words": "啊嗚……",
    "voice": null,
    "unit_id": 1811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……嗯？",
    "voice": "vo_adv_1044008_019",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n怎麼了，露出那種苦苦哀求的眼神？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喔……看來，",
    "voice": "vo_adv_1044008_020",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n是想要妾身的番茄汁啊？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "區區下等生物，竟想要妾身的東西……",
    "voice": "vo_adv_1044008_021",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n才不會給你呢！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "狗",
    "words": "啊嗚……",
    "voice": null,
    "unit_id": 1811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……別、別用那種眼神看妾身啦！",
    "voice": "vo_adv_1044008_022",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這、這是妾身的番茄汁……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔……沒辦法。",
    "voice": "vo_adv_1044008_023",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那特別分給你一些，但只有這次哦！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼！？",
    "voice": "vo_adv_1044008_024",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你說妾身很溫柔……？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "別、別別開玩笑了！",
    "voice": "vo_adv_1044008_025",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身可是有朝一日要征服世界的人！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n一點都不溫柔！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "若、若你下次再說妾身溫柔，",
    "voice": "vo_adv_1044008_026",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n就判你死刑！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "still",
    "still_id": "104400801"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯嗯，看來有好好地在反省。",
    "voice": "vo_adv_1044008_027",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n那麼，就當作是賠罪，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n今天一整天，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你都要當妾身的隨從！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "首先是……",
    "voice": "vo_adv_1044008_028",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身肚子餓了！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "帶妾身去這個城裡最好吃的餐廳！",
    "voice": "vo_adv_1044008_029",
    "unit_id": 104431
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "{0}……",
    "voice": "vo_adv_1044008_030",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這是什麼餐廳啊……？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "招牌上寫的是",
    "voice": "vo_adv_1044008_031",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n「蒜頭滿滿餃子專賣店」……？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔啊啊啊啊啊～～！？",
    "voice": "vo_adv_1044008_032",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這是什麼味道啊！！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身最討厭大蒜了啦～！！",
    "voice": "vo_adv_1044008_033",
    "unit_id": 104431
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你啊……",
    "voice": "vo_adv_1044008_034",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "難道不知道大蒜料理，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n很不適合身為吸血鬼的伊莉亞嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "說到底！你怎麼會想到要帶一位淑女去吃大蒜料理餐廳啊……",
    "voice": "vo_adv_1044008_035",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真是的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這是",
    "voice": "vo_adv_1044008_036",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "根據你跟伊莉亞過去的記憶所打造的「夢」喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "而現在的你採取了這樣的行動呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這讓我也看得很開心呢♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次再見囉～♪",
    "voice": "vo_adv_1044008_037",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身討厭大蒜～",
    "voice": "vo_adv_1044008_038",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n……咦？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……妾身又做夢了嗎？",
    "voice": "vo_adv_1044008_039",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "似乎又是個奇妙的夢呢……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵呵，",
    "voice": "vo_adv_1044008_040",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n{0}你在夢中也是妾身的隨從，真令妾身感動。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼？",
    "voice": "vo_adv_1044008_041",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你也做了同樣的夢嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
