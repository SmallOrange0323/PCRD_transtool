  {
    "type": "dialogue",
    "name": "深月",
    "words": "目標，",
    "voice": "vo_adv_5074442_000",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "停止活動。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這麼一來",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "手術也結束了。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "雪，妳也辛苦啦。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "身體狀況沒事吧？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "非常有事～",
    "voice": "vo_adv_5074442_001",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "拚過了頭，累死我了，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "使不上半點力氣啦……",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊，",
    "voice": "vo_adv_5074442_002",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為筋疲力盡",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "而顯得有些慵懶的我，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n應該醞釀出有別平時的美麗了，對不對！？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": "vo_adv_5074442_003",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這樣的我可不常見喔。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "仔細看清楚，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好好烙印在眼裡吧♪",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……我之前就一直這麼覺得了，",
    "voice": "vo_adv_5074442_004",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就各種方面來說，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n妳也許真的很厲害呢。",
    "voice": null,
    "unit_id": 117511
  }
]
