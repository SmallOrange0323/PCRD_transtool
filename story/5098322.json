    "words": "呼",
    "voice": "vo_adv_5098322_000",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "呼……",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n總算打敗",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們的冒牌貨了……",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯……",
    "voice": "vo_adv_5098322_001",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n太好了……",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這樣就沒問題了",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "吧？",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "小繆",
    "words": "繆繆！？",
    "voice": "vo_adv_5098322_002",
    "unit_id": 8411
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "小繆，",
    "voice": "vo_adv_5098322_003",
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "怎麼了……",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇哇！？",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n妳們看，",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "魔物們……！",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "接二連三地來……！",
    "voice": "vo_adv_5098322_004",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "才想說好不容易克服了自己的想法耶。",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "而且",
    "voice": "vo_adv_5098322_005",
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "感覺很強呢……",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n好像和一般的魔物不同。",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "它們一定",
    "voice": "vo_adv_5098322_006",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是透過門獲得了力量。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……不過",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我們沒問題的！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n因為我們沒有輸給自己的心靈！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "鏡華……",
    "voice": "vo_adv_5098322_007",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n嘿嘿，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "是啊！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好──",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們上囉～！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "上囉～！",
    "voice": "vo_adv_5098322_008",
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "小繆",
    "words": "繆繆～！",
    "voice": "vo_adv_5098322_009",
    "unit_id": 8411
  }
]
