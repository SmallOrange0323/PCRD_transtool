  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "欸！？",
    "voice": "vo_adv_9500003_000",
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n等等……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我嗎？",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n是真的，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "選了我？",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那是……",
    "voice": "vo_adv_9500003_001",
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個。",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n跟、",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "跟你一起戰鬥的責任，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就交給我了的意思？",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "能夠被這樣信賴，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "果然還是會感覺很特別……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": "vo_adv_9500003_002",
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對你來說可能是理所當然吧。",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "徹頭徹底的老好人，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都不懂得懷疑別人。",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你的這點，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也覺得不錯就是了……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？",
    "voice": "vo_adv_9500003_003",
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "突、",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "突然間怎麼了……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n幹嘛一臉認真，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還有什麼想說的嗎？",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……",
    "voice": "vo_adv_9500003_004",
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼？",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什、",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什什什……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n最、",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "最重要的人，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "難道說，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那是……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "騙、",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "騙人的吧……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等、",
    "voice": "vo_adv_9500003_005",
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等一下！",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我知道了，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "夠了！",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不用每次都重講一遍，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也能理解啦！",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不要這麼堂堂正正的說出",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "聽的人比較害羞的話！",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，",
    "voice": "vo_adv_9500003_006",
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我會害羞，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是因為討厭。",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n只是有點嚇到了，才不知道該怎麼回覆而已喔？",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊啊真是的，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你在讓我說明什麼啊……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這個，",
    "voice": "vo_adv_9500003_007",
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是平時的",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "「我喜歡大家」，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而是那個吧……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不討厭……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不對，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我很高興。",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為我也對",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "{0}……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒、",
    "voice": "vo_adv_9500003_008",
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒事啦！",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n突然間",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "自覺到自己的心意而仔細感受了之類的",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n才不是那樣呢！",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不要一直吐槽我！",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總之，",
    "voice": "vo_adv_9500003_009",
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在這邊輸了的話就功虧一簣了！",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "和你，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要合力揍飛敵人！",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "然後",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "兩人一起回去！",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "知道了吧！！",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還有……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也是，",
    "voice": "vo_adv_9500003_010",
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "世界上最喜歡你了。",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我不會再說第二遍，",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "絕對",
    "voice": null,
    "unit_id": 106041
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不要忘了喔。",
    "voice": null,
    "unit_id": 106041
  }
]
