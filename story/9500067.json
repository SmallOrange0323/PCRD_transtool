[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_9500067_000",
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哎呀哎呀……",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n少年……",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你在想",
    "voice": "vo_adv_9500067_001",
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "什～～～麼啊！？",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n為什麼會是我！？",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你精神失常了嗎！？",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n這時候！",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "要選陛下才對吧！",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "以常識來思考～～～！",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呼、",
    "voice": "vo_adv_9500067_002",
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呼……",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n因、",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "因為太過動搖……",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我頭暈、胃痛、心悸３種症狀一次全來了。",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n要是這種時候被秘書一號看見的話……",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "噁。",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哈啊……",
    "voice": "vo_adv_9500067_003",
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哈啊……",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "被你這樣輕撫著背，",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "讓我想起來了呢。",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n似乎也曾經有過我酩酊大醉，",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n靠著少年你的肩膀走路",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那樣的夜晚來著……",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呼、",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呼……",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那時的宴會上……",
    "voice": "vo_adv_9500067_004",
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我和你",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "可是把那些違抗陛下的愚蠢貴族們",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n耍得團團轉♪",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我和你，",
    "voice": "vo_adv_9500067_005",
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "當時也是抱持著相同的心情呢。",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不計較任何得失……",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "只是",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "為了幫助陛下。",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "僅僅",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是出於那樣的一個理由，",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我們",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "便極其自然地……",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……呵呵",
    "voice": "vo_adv_9500067_006",
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……呵呵",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呵呵呵呵！",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是啊，",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "沒錯呢。",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "確實、",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "確實？",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n就是那樣，完全",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "一點也沒錯！",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "少年！",
    "voice": "vo_adv_9500067_007",
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你的選擇",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "完全正確無誤喔！",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n在這裡！",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "在這場戰鬥中！",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就在現在！",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "此時此刻！",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n若你要實現「那件事」！",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那麼理應與你配對的另一個人是──",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "身為走在那條道路上、與你並駕齊驅的",
    "voice": "vo_adv_9500067_008",
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "本小姐我！",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n就只有",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我克蕾琪塔‧凱許！",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "陛下始終高居於天空之上，",
    "voice": "vo_adv_9500067_009",
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是如同太陽般照亮人們的光。",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "而我們正是為了守護",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n那樣的陛下在餐桌上",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "展露片刻的那個笑容──",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "好嗎？",
    "voice": "vo_adv_9500067_010",
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "聽清楚了嗎？少年。",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我與",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你，",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "由我們兩人",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "持續從地面支撐著陛下。",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n直到",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "彼此生命走到盡頭。",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不，",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "即使走到盡頭，",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "也要永永遠遠支撐著。",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就算陛下不會知曉……",
    "voice": "vo_adv_9500067_011",
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這也是只屬於我們兩人的",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "誓言",
    "voice": null,
    "unit_id": 118041
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "喔。",
    "voice": null,
    "unit_id": 118041
  }
]
