[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "{0}大人……！",
    "voice": "vo_adv_9500041_000",
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你選擇了我呢。",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "選擇我作為",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "一同迎戰",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "決定世界命運一戰的夥伴……！",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "敵人",
    "voice": "vo_adv_9500041_001",
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "過於強大，",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "再這樣下去幾乎毫無勝算。",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "過……",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "即使手頭資金為０盧幣，",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n只要擁有信念與希望，",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "便能重新振作，這就是商人。",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你",
    "voice": "vo_adv_9500041_002",
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "想要守護世界到底的堅定意志……",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我也",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "確實收到了。",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我發誓，",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "絕對不會",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "讓你後悔這筆投資！",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那是……！",
    "voice": "vo_adv_9500041_003",
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n……你察覺到",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我所懷抱的願望了呢……",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n而且……",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "也同樣",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "期盼著……",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "嗯，",
    "voice": "vo_adv_9500041_004",
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是啊……",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我不知道從何時開始，",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "便一直這樣想著。",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我希望",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "{0}大人能陪在我身邊。",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不是守護我的騎士，",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "也不是侍奉我的管家……",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "而是，",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "作為彼此相愛的兩人。",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "當然，",
    "voice": "vo_adv_9500041_005",
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我也不是沒有猶豫過。",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "身為背負紫藤之名的人，",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "並不是什麼值得稱讚的事。",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "最重要的是，",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不能違背你的心意。",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不過，",
    "voice": "vo_adv_9500041_006",
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "如果是你自己",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "如此期盼的話……",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那我不會再",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "猶豫了。",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我的回答當然是──",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "Yes！",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "！",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n秋乃‧紫藤，",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "在此發誓，",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "會與你相守一生！",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我才是，",
    "voice": "vo_adv_9500041_007",
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "今後也請你",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "多多關照了！",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n只要有你在，",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我就是",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "無敵的商人！",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼，事不宜遲，",
    "voice": "vo_adv_9500041_008",
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "來展開我們第一次的合作行動吧。",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "拯救世界什麼的，",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "正是非常適合作為我們起點的",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "一樁大事業呢！",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103241
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "喔～呵呵呵呵！",
    "voice": null,
    "unit_id": 103241
  }
]
