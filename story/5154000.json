    "words": "說得也是。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我們去看看吧。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": "vo_adv_5154000_067",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你看。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n後面也有門！",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n這邊也掛著看板……",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我看看。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
