  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這裡是阿爾克絲鍊金堂──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在蘭德索爾的小巷裡靜靜佇立著的奇妙房間中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n長著鹿角的少女嘆了一口氣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……唉。",
    "voice": "vo_adv_5154000_000",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "命中注定的王子……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你現在",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在哪裡",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "做什麼呢？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "只是想著你的事情，",
    "voice": "vo_adv_5154000_001",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我的心",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就快要",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "因為心跳加速而破裂了……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "要問原因的話，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "沒錯──",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "Because，",
    "voice": "vo_adv_5154000_002",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "I Love You……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "欸欸露易。",
    "voice": "vo_adv_5154000_003",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n露易絲瑪莉～",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳在自言自語什麼？",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "彩羽！？",
    "voice": "vo_adv_5154000_004",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "真是的！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n不是跟妳說過不要擅自進來嗎！？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "欸──",
    "voice": "vo_adv_5154000_005",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽有敲門喔？",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "敲敲敲敲～的，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "大概敲了一萬下！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "啊啊，",
    "voice": "vo_adv_5154000_006",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "門壞掉了！？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "妳在做什麼啊，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "這個怪力女！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "討厭，",
    "voice": "vo_adv_5154000_007",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽會害羞啦～♪",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "沒有在誇妳！",
    "voice": "vo_adv_5154000_008",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊～啊，",
    "voice": "vo_adv_5154000_009",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "聽到很大的聲音就過來看看了……",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "到底在做什麼啊，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳們兩個。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "等一下苑，",
    "voice": "vo_adv_5154000_010",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "妳們兩個是什麼意思啊。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "做錯事的可是百分之百是彩羽喔！？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不對",
    "voice": "vo_adv_5154000_011",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "露易。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那樣被敲門還沒發現的妳",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "問題也蠻大的。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "反正一定又是沉浸在自己的世界裡妄想了吧。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "妄、",
    "voice": "vo_adv_5154000_012",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "妄想什麼的不要說得這麼難聽……！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n這可是戀愛……！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "純真的初戀喔……！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……唉，",
    "voice": "vo_adv_5154000_013",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "命中注定的王子……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n我該怎麼做，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "才能再見到你呢……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "命中注定的王子？",
    "voice": "vo_adv_5154000_014",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "這、",
    "voice": "vo_adv_5154000_015",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "這麼感興趣的話我就跟妳說吧……！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "那是，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "之前到鎮上買鍊金術素材時的事情……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我和從對面跑來的人",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "在轉角",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "碰一聲的撞到了！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "然後那個人啊。",
    "voice": "vo_adv_5154000_016",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "跑到跌倒的我面前，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "一邊說",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "「對不起，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "妳沒受傷吧？」",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "一邊溫柔的對我伸出手來！！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "沒錯……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "握住他的手那瞬間",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "彷彿被落雷擊中……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我就知道了。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "原來",
    "voice": "vo_adv_5154000_017",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "這就是",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "戀愛啊。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "呀──！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "呀──！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n我說出來了──！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "好，",
    "voice": "vo_adv_5154000_018",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我們就先不說那個，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n我拜託妳的東西，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "完成了嗎？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "尺寸應該都有告訴妳了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "明明是妳主動問的不要無視我啊！？",
    "voice": "vo_adv_5154000_019",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……真是的，",
    "voice": "vo_adv_5154000_020",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "已經完成了。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "就是掛在那邊的衣服。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "喔喔，",
    "voice": "vo_adv_5154000_021",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "用鍊金術",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "居然可以做出這麼好的服裝。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "真不愧是露易。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "哼。",
    "voice": "vo_adv_5154000_022",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "那當然。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "才能超越了身為偉大鍊金術師的奶奶。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "由我！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "天才鍊金術師‧",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "露易絲瑪莉大人出手的話，這都是理所當然的！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "彩羽",
