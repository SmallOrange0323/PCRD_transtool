  {
    "type": "dialogue",
    "name": "望",
    "words": "抱歉……",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n因為從你被風吹動的披風飄來很香的味道。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這是",
    "voice": "vo_adv_5154000_052",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "上禮拜發售的柔軟精對吧？",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我記得是",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "新品項的清新玫瑰香氣。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為【墨丘利財團】大肆的",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n廣告宣傳讓我蠻好奇的，",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哈啊……",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "超棒的……♪",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但是",
    "voice": "vo_adv_5154000_053",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也不只那個……",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n還有在柔軟精中混合的你的香味……",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哈啊♪",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……話說我，",
    "voice": "vo_adv_5154000_054",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "在說些什麼啊！？",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "糟糕……",
    "voice": "vo_adv_5154000_055",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可能是和你兩人獨處所以鬆懈了。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "當……",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "當我沒說！",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你就當作什麼都沒聽到吧……！？",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "接、",
    "voice": "vo_adv_5154000_056",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "接下來……",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "話說回來店在哪裡呢？",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "地圖上顯示",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是在這附近沒錯……",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我看看，",
    "voice": "vo_adv_5154000_057",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "店的名字叫做，",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "阿爾克絲鍊金堂。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "「無所不有的商店」……",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這麼寫著。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……「無所不有的商店」嗎。",
    "voice": "vo_adv_5154000_058",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果是真的那很厲害呢！",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "會是像什麼都有的宮殿一樣",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "很大間的店嗎？",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這附近又沒有那種建築物……",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……好小間。",
    "voice": "vo_adv_5154000_059",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……啊，",
    "voice": "vo_adv_5154000_060",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有看板。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n阿爾克絲鍊金堂……",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是這裡沒錯。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……很抱歉說了這裡很小間！",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那麼，",
    "voice": "vo_adv_5154000_061",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們快進去吧！",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有人在嗎──！",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……？",
    "voice": "vo_adv_5154000_062",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……咦，",
    "voice": "vo_adv_5154000_063",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
