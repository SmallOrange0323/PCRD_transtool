    "type": "dialogue",
    "name": "涅婭",
    "words": "那我改用文字傳達意思不就好了？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我真是天才～",
    "voice": null,
    "unit_id": 123311
  },
