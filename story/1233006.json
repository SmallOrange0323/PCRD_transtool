    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n要變成人類的模樣～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n維持住魔力與精神之間的平衡",
