[
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了調查{0}的身體，涅婭在他睡著時進行夜襲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n只不過，中途涅婭卻不知為何變回了史萊姆。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她被睡迷糊的{0}當作枕頭，就這樣過了一晚……",
    "voice": null,
