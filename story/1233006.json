  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "這樣也很口愛～♪",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "不！",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "現在不是想這種事的時候啦～！　",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "不是我不打算，",
    "voice": "vo_adv_1233006_006",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "是我沒辦法呀～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n討厭～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真是哭哭耶～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "怎麼會這樣～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "啊～",
    "voice": "vo_adv_1233006_007",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "對了對了～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n不知道改成畫圖能不能讓他懂意思～？",
    "voice": null,
    "unit_id": 123311
  },
