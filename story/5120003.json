[
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隨著與各地的魔物們進行交流，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n伊莉亞身為「傳說的吸血鬼」的地位與名聲也漸漸提升。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在這樣的情況中，雪則是──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真令人無法接受。",
    "voice": "vo_adv_5120003_000",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就是這鎮上的那些魔物啊！",
    "voice": "vo_adv_5120003_001",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "大家",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "都不停喊「伊莉亞伊莉亞」把她捧得高高在上。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "明明擁有如此美貌的我就離它們這麼近耶！",
    "voice": "vo_adv_5120003_002",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我說，",
    "voice": "vo_adv_5120003_003",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你也這麼想對吧？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n是這麼想的吧？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵♪",
    "voice": "vo_adv_5120003_004",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n真不愧是",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "一直待在我身邊看著我的美貌的人。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "來，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "給你可以",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "更靠近看我的權利喔……♪",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真奇怪？",
    "voice": "vo_adv_5120003_005",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是因為最近都沒什麼讓你看我的美貌嗎？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那你會鬧彆扭也是難免的呢♪",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "下次我會留時間給你，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "讓你可以單獨",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "仔細地欣賞我的美貌。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "所以說呢，",
    "voice": "vo_adv_5120003_006",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我打算讓這城鎮的魔物們",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "都知道我的美貌！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不……",
    "voice": "vo_adv_5120003_007",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "光是這樣也很無趣呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "既然都要做了，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就招集大量被我的美貌所俘虜的僕人，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "打造「雪的美麗樂園」吧♪",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你當然",
    "voice": "vo_adv_5120003_008",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也會幫忙我對吧？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "眼神游移不定的……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是我太過耀眼讓你不敢直視了，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你的心情我非常了解。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那我們走吧！",
    "voice": "vo_adv_5120003_009",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n就用我的美貌",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "來篡奪這座城鎮吧♪",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "background",
    "bg_id": "501980"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "欸，",
    "voice": "vo_adv_5120003_010",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那邊的魔物。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如何？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你不覺得我很美嗎？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "咦？",
    "voice": "vo_adv_5120003_011",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "\\n這個人類突然在說什麼啊……？",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "來看看",
    "voice": "vo_adv_5120003_012",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這光滑的肌膚有多美麗。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "很細緻",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "又滑順對吧……♪",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如果願意成為被我的美貌所俘虜的僕人，",
    "voice": "vo_adv_5120003_013",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就可以讓你摸摸看喔……♪",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": "vo_adv_5120003_014",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如何？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n你無法抗拒這個魅力吧……？　",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "喂喂，",
    "voice": "vo_adv_5120003_015",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "這肌膚也太柔嫩了吧……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "\\n妳這樣子",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "根本無法抵擋天敵的攻擊啊！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "什麼！？",
    "voice": "vo_adv_5120003_016",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "得讓皮膚變得更堅硬才行啊！",
    "voice": "vo_adv_5120003_017",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "\\n妳這樣",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "在野外可活不下去喔……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……呵。",
    "voice": "vo_adv_5120003_018",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "看樣子",
    "voice": "vo_adv_5120003_019",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "它對美的感覺似乎和我們差太多了呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也是有這種情況呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "去找下一個吧！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗨，",
    "voice": "vo_adv_5120003_020",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那邊的魔物。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n你來看看我的秀髮。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "看看可以為這座灰暗的城鎮",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "增添明亮色彩的亮麗光澤。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如何？",
    "voice": "vo_adv_5120003_021",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你是不是想成為我的僕人了？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": "vo_adv_5120003_022",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這次肯定沒問題。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "無論是什麼樣的魔物",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "都會瞬間迷上我的秀髮。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "唉呀，",
    "voice": "vo_adv_5120003_023",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "這稀薄的毛髮是怎麼回事？",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "\\n毛髮如果不更濃密一點，可是會被笑的喔。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "毛髮要濃密！？",
    "voice": "vo_adv_5120003_024",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "真是的，",
    "voice": "vo_adv_5120003_025",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "真拿妳沒辦法。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "\\n我把我的毛髮分給妳一點吧。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊……",
    "voice": "vo_adv_5120003_026",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "再見啦，",
    "voice": "vo_adv_5120003_027",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "光滑無毛的人類小姐。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "\\n等妳毛髮長得夠濃密了再來吧。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……嗯……",
    "voice": "vo_adv_5120003_028",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哎呀，",
    "voice": "vo_adv_5120003_029",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我真是，竟然這麼地冒失。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "忘記了我的美貌",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "並不是只有外表而已。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我在磨練自己的過程中，",
    "voice": "vo_adv_5120003_030",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "學會了充滿魅力的動作舉止。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "用那樣的動作舉止來訴說我的美貌，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n肯定比較容易讓魔物們了解。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這次真的要上囉！",
    "voice": "vo_adv_5120003_031",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n就用我完美的身材擺出",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n祕藏的姿勢來決勝負！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "魔物３",
    "words": "妳的觸手不夠，觸手不夠啊。",
    "voice": "vo_adv_5120003_032",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我怎麼可能會有什麼觸手啊……！？",
    "voice": "vo_adv_5120003_033",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "唔",
    "voice": "vo_adv_5120003_034",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "～嗯……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這城鎮太奇怪了……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n沒想到魔物們",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "會這麼",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "無法理解我的美貌……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不，",
    "voice": "vo_adv_5120003_035",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這怎麼行。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "居然要我在這裡放棄，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這對我所背負的美貌太失禮了。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我一定",
    "voice": "vo_adv_5120003_036",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n要讓這城鎮的魔物們理解我的美貌！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n因為這就是",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "美麗的我的宿命……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "──呵。",
    "voice": "vo_adv_5120003_037",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n看來妳陷入苦戰了嘛，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雪啊！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "伊莉亞……！",
    "voice": "vo_adv_5120003_038",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n妳為什麼會在這裡？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳還問為什麼，",
    "voice": "vo_adv_5120003_039",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是鎮上的居民們",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n說「有個麻煩的人類在強迫推銷自己的美貌」，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n而跑來投訴了啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "居然說我在強迫推銷我的美貌……！？",
    "voice": "vo_adv_5120003_040",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "的確，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "在見到我美貌的那一刻，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就應該要付錢沒錯……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵！",
    "voice": "vo_adv_5120003_041",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "想必妳也切身體會到了吧？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雪啊，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那就是妳自身美貌的極限！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "才沒有那回事！",
    "voice": "vo_adv_5120003_042",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的美貌",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是沒有極限的！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還真會說啊。",
    "voice": "vo_adv_5120003_043",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這也是個好機會呢！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身早就想要挫挫妳的銳氣了！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "居住在這城鎮的魔物們啊！",
    "voice": "vo_adv_5120003_044",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身和那邊的雪，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你們說究竟是誰比較美麗吧！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "那當然",
    "voice": "vo_adv_5120003_045",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "是伊莉亞大人啊！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "伊莉亞大人～",
    "voice": "vo_adv_5120003_046",
    "unit_id": 1612
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "請您看這裡～♪",
    "voice": null,
    "unit_id": 1612
  },
  {
    "type": "dialogue",
    "name": "魔物３",
    "words": "沒有人可以贏得過伊莉亞大人的美貌！",
    "voice": "vo_adv_5120003_047",
    "unit_id": 1613
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵呵……",
    "voice": "vo_adv_5120003_048",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈～哈哈哈！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n看到了嗎？雪啊！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這就是",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "所謂的絕對之美！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "伊莉亞大人～♪",
    "voice": "vo_adv_5120003_049",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔，",
    "voice": "vo_adv_5120003_050",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真不愧是眷屬，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你注意到了啊……！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身稍微對魔物們施展了點",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "魅惑之力。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……畢竟妾身的外表看起來也是人類，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這就是所謂的以防萬一。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你可別對雪說喔！",
    "voice": "vo_adv_5120003_051",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n畢竟那傢伙一直在擾亂妾身的步調。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身可不想就這樣一直負責吐槽她啊！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "至少讓妾身",
    "voice": "vo_adv_5120003_052",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在這裡掌握一次主導權也不算過分吧……？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身之後會好好道歉的，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……我居然",
    "voice": "vo_adv_5120003_053",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……在美貌上",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "輸了……？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "居然會有比我更美的存在，",
    "voice": "vo_adv_5120003_054",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這種事",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是不應該發生的……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雪啊。",
    "voice": "vo_adv_5120003_055",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妳這樣不願意認輸可是很難看的喔。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "來，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "快點美麗地俯首認輸，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "說「我贏不過伊莉亞大人」吧……♪",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……唔",
    "voice": "vo_adv_5120003_056",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然用魅惑作弊讓妾身感到有點愧疚……",
    "voice": "vo_adv_5120003_057",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但雪啊，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這次就讓妾身拿下勝利吧！　",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我、",
    "voice": "vo_adv_5120003_058",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……妳說什麼……？",
    "voice": "vo_adv_5120003_059",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的美貌",
    "voice": "vo_adv_5120003_060",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是絕對",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不會輸的……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "無論是傳說的吸血鬼還是什麼人，",
    "voice": "vo_adv_5120003_061",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我的美貌都不會輸的！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "既然伊莉亞",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是「統御黑夜之人」……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那我就是",
    "voice": "vo_adv_5120003_062",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "「統御美麗之人」──！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼！？",
    "voice": "vo_adv_5120003_063",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雪正在釋放的是魔力嗎！？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
