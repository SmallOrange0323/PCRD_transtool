[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了參加遊戲同好的線下聚，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n依里來到會合地點等待{0}的到來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "唉……",
    "voice": "vo_adv_5048000_000",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "當初因為是那傢伙邀請，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n才會沒想太多就答應參加，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n事到如今卻緊張起來了……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我……",
    "voice": "vo_adv_5048000_001",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "除了茜里之外，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "熟識的人也就只有公會成員，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "真的有辦法跟初次見面的人聊開嗎……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我怎麼會",
    "voice": "vo_adv_5048000_002",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這麼窩囊啊。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "明明是參加喜歡遊戲的線下聚，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n卻為了這點芝麻小事煩惱。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "今天幸好有{0}陪我一起去，",
    "voice": "vo_adv_5048000_003",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但是這樣下去總不是辦法啊……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "唉……",
    "voice": "vo_adv_5048000_004",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "要是我也能像茜里一樣",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "跟誰都能無所不聊，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n像她一樣舉止大方，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就不用為這種事煩惱了……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "倒是{0}怎麼這麼慢啊？",
    "voice": "vo_adv_5048000_005",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n要是那傢伙今天沒來，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我豈不就得一個人參加線下聚……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這怎麼行！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n算我求你了，你快點來啊！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "怎、",
    "voice": "vo_adv_5048000_006",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "怎麼這麼慢啊{0}！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n才想說要不要乾脆自己先過去呢。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "謝、",
    "voice": "vo_adv_5048000_007",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "謝天謝地，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "他總算是來了……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "總之！",
    "voice": "vo_adv_5048000_008",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "因為你遲到，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "時間所剩不多了，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我們趕緊出發吧！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦？",
    "voice": "vo_adv_5048000_009",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "什麼小女孩……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你們好啊。",
    "voice": "vo_adv_5048000_010",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哇呀！",
    "voice": "vo_adv_5048000_011",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "她、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "她是什麼時候……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這小女孩是誰啊！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸妳，",
    "voice": "vo_adv_5048000_012",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "找我們有事嗎？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還是說",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "妳迷路了？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "still",
    "still_id": "504800001"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "迷路？",
    "voice": "vo_adv_5048000_013",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不是的不是的。",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我是個天使！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n負責指引大家才是我的工作！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n至於迷路這種事，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "一天頂多兩三次而已。",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哼哼！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "聽起來還挺頻繁的嘛……",
    "voice": "vo_adv_5048000_014",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "倒是妳說",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "妳是天使？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "一般所謂的那種天使嗎？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這翅膀跟弓箭",
    "voice": "vo_adv_5048000_015",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "的確是有天使的樣子……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "仔細一看還真的離地飄著呢。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不過",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "感覺又有點冒牌貨的味道。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我、",
    "voice": "vo_adv_5048000_016",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我不是冒牌貨啦！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我可是",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "為了讓大家變得超級無敵幸福",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n而降臨的資優生天使，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "名字叫做",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "拉菲～！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那個……",
    "voice": "vo_adv_5048000_017",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "請問妳叫什麼名字呢？",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦，",
    "voice": "vo_adv_5048000_018",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "名字？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我叫做",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "依里……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那麼依里，",
    "voice": "vo_adv_5048000_019",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "妳現在，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "心中懷抱著很大的煩惱對吧？",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦？",
    "voice": "vo_adv_5048000_020",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "她是怎麼看透我心思的？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n難不成",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "她真的如她所言是個天使……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "就算想瞞",
    "voice": "vo_adv_5048000_021",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "也瞞不過我的喔。",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n因為妳剛剛的自言自語，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "全都被我聽得一清二楚了！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不、",
    "voice": "vo_adv_5048000_022",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不會吧，被她聽見了！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n這下丟臉也就算了，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還被怪怪的小孩纏上，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "到底是怎樣嘛～！　",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "不過依里妳放心。",
    "voice": "vo_adv_5048000_023",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n接下來",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我要幫妳實現願望。",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n讓妳變得",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "超級無敵幸福！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不、",
    "voice": "vo_adv_5048000_024",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不必了啦。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那個，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我想妳該幫助的應該不是我",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n而是那些更有困難的人吧？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "……不，",
    "voice": "vo_adv_5048000_025",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我想幫助依里。",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "只要能讓依里變得幸福，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那麼我一定能……！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦？",
    "voice": "vo_adv_5048000_026",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這話是什麼意思……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "等等，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n為、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
