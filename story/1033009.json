  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n參觀選購",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好心情也GOGO啦～！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "哇！",
    "voice": "vo_adv_1033009_071",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "原來牛姐姐在喔！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n嗯？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "但總覺得講得好爛喔……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "是假貨嗎！？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "才、",
    "voice": "vo_adv_1033009_072",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "才不是假貨啦！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我是本人啦！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "模仿我又沒有……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "……？",
    "voice": "vo_adv_1033009_073",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不對。",
    "voice": "vo_adv_1033009_074",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這孩子是很享受我的搞笑段子。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不能用半吊子的心態",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "面對這孩子。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我到底是不是假貨，",
    "voice": "vo_adv_1033009_075",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n就讓你見識我的搞笑段子一百連發之後",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "再來決定吧！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n可別笑到無法呼吸後再後悔喔！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "來啊！",
    "voice": "vo_adv_1033009_076",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "求之不得！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那我",
    "voice": "vo_adv_1033009_077",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "要開始啦～～！！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是真陽便持續表演搞笑段子，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n聽聞風聲的熟客們也陸續過來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n街道上也充滿了和樂的歡笑。",
    "voice": null,
    "unit_id": null
  }
]
