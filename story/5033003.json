  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "跟初音一起進行特訓的數天後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n霞與栞兩人在巡邏途中遭遇了反逆獸。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "迷霧，",
    "voice": "vo_adv_5033003_000",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "理論，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真實！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n魔法緞帶，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "螺旋！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "瞄準純真的心！",
    "voice": "vo_adv_5033003_001",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n魔法箭矢，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "爆擊！",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "魔法偵探Misty★霞，",
    "voice": "vo_adv_5033003_002",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "用魔法的力量開始搜查！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "魔法獵人",
    "voice": "vo_adv_5033003_003",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "Purely★栞，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n向你的心",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "射出愛之箭！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "小霞、",
    "voice": "vo_adv_5033003_004",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "小栞！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n一口氣解決吧！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "這還用說嗎！",
    "voice": "vo_adv_5033003_005",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n栞，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "我來阻止牠的行動！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "就交給妳來解決牠了——",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "迷霧之彈！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "謝謝妳，",
    "voice": "vo_adv_5033003_006",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "霞！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n這樣就很好瞄準了……！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "一擊就解決你——",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "純真之箭！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "――嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "嗯，",
    "voice": "vo_adv_5033003_007",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "正中紅心！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "都習慣了呢，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "兩位！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "是的。",
    "voice": "vo_adv_5033003_008",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n都是多虧了姊姊的特訓。",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "不知道到底該不該高興呢。",
    "voice": "vo_adv_5033003_009",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "但是，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "的確比較不那麼害羞了……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "別、",
    "voice": "vo_adv_5033003_010",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "別這樣啦，助手先生……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n你這樣盯著看的話，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "還是……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "會難為情的……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "對啊。",
    "voice": "vo_adv_5033003_011",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "比起被別人看，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "被你盯著的話，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "總覺得……",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "有一種心癢癢的感覺……",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "栞、霞",
    "words": "閃亮亮☆",
    "voice": "vo_adv_5033003_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "啊！？",
    "voice": "vo_adv_5033003_013",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n……反射動作！？",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "身體會自動做出反應了呢……",
    "voice": "vo_adv_5033003_014",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "看來妳們做為魔法少女",
    "voice": "vo_adv_5033003_015",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "確實地有在成長的樣子，真是太好了！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "但是，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "還缺少",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "某些東西。",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "意外地要求很多呢……",
    "voice": "vo_adv_5033003_016",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n還有少什麼東西嗎？",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "我們已經可以確實地打倒反逆獸了，",
    "voice": "vo_adv_5033003_017",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "除此之外還需要什麼呢……？",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "要像個魔法少女一樣！",
    "voice": "vo_adv_5033003_018",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "……你說，要像個魔法少女",
    "voice": "vo_adv_5033003_019",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "是嗎……？",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "看剛剛的戰鬥，",
    "voice": "vo_adv_5033003_020",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n小霞跟小栞的戰鬥方式，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "該怎麼說呢……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n就像是很有效率地",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "在狩獵一樣呢。",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "不是，",
    "voice": "vo_adv_5033003_021",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "戰鬥的時候這麼做是理所當然吧。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "對啊……",
    "voice": "vo_adv_5033003_022",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "霞看穿對手的的弱點並製造破綻，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n再由我來射穿……",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "我覺得這樣的配合很好。",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "如果只是普通的戰鬥的話或許沒有問題。",
    "voice": "vo_adv_5033003_023",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "但是……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "這可是魔法少女的戰鬥啊！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "栞、霞",
    "words": "！？",
    "voice": "vo_adv_5033003_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "騎士大人！",
    "voice": "vo_adv_5033003_025",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n魔法少女的力量泉源是什麼，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "你還記得嗎？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "說得沒錯！",
    "voice": "vo_adv_5033003_026",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "魔法少女的力量泉源就是",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "愛與希望！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n將湧現出的愛的力量灌注進魔法，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "胸懷希望地去戰鬥！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "但是，",
    "voice": "vo_adv_5033003_027",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "現在兩位的戰鬥中",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "只能感受到殺意。",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "與其說是魔法少女……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "不如說是野蠻人？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "只是普通地戰鬥就要被說成這樣嗎！？",
    "voice": "vo_adv_5033003_028",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "因為就是這麼重要的事啊。",
    "voice": "vo_adv_5033003_029",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n如果戰鬥的時候不能",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "像個魔法少女",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n讓觀看的人們感受到愛與希望的話，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "就不能算是獨當一面唷！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "的確，",
    "voice": "vo_adv_5033003_030",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "「魔法少女鈴鈴噹」的戰鬥也一直都是",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "光讀著就能讓人雀躍不已呢。",
    "voice": null,
    "unit_id": 112311
  },
  {
