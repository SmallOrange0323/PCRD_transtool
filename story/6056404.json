[
  {
    "type": "background",
    "bg_id": "501161"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你問我新年都怎麼過？",
    "voice": "vo_adv_6056404_000",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我從以前到現在，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "都不太在意什麼新年就是了……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "所以新年有這麼好玩嗎？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大家都做些什麼事啊？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "原來你們說的年菜是指食物嗎！？",
    "voice": "vo_adv_6056404_001",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "如果能吃新年才有的特別食物，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "聽起來應該挺有意思的。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "要是真的很好吃，那我也要吃吃看！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "參拜？",
    "voice": "vo_adv_6056404_002",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……你說去寺院投錢，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "然後向神許願？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可是願望應該不會因為這樣就成真吧……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我開始有點好奇你們是怎麼做的了。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "到時也找我一起去吧！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "毽球板？",
    "voice": "vo_adv_6056404_003",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "記得好像是……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "用板子打像球一樣的東西是嗎？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喔喔，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "果然沒記錯！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這個的話我應該也能樂在其中！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我會把你打得落花流水，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "馬上就去玩玩看吧！",
    "voice": null,
    "unit_id": 114711
  }
]
