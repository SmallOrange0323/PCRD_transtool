  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "散步、散步真開心呀～♪",
    "voice": "vo_adv_1020004_000",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n啦啦啦～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊！是哥哥耶～",
    "voice": "vo_adv_1020004_001",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇～！哥哥一起來玩吧～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇！",
    "voice": "vo_adv_1020004_002",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n什、什麼什麼～？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "好刺眼呦～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗚嗚～！！",
    "voice": "vo_adv_1020004_003",
    "unit_id": 102011
  },
  {
    "type": "background",
    "bg_id": "510330"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥，",
    "voice": "vo_adv_1020004_004",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n謝謝你陪美美一起去買東西～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "今天呢，",
    "voice": "vo_adv_1020004_005",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美是為了",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "買媽媽的生日禮物～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美幫了媽媽許多忙，",
    "voice": "vo_adv_1020004_006",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "存了好多零用錢～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "如果能找到媽媽收到會很",
    "voice": "vo_adv_1020004_007",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n開心的東西就好了呢～♪",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗚哇！",
    "voice": "vo_adv_1020004_008",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "有好多可愛的東西～♪",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這隻兔子先生絨毛娃娃真可愛～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊，這裡也有可愛的絨毛娃娃――",
    "voice": "vo_adv_1020004_009",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……咦？禮物？",
    "voice": "vo_adv_1020004_010",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "對、對喔……美美得專心找要送給媽媽的禮物才行！",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "唔～嗯……要送什麼禮物好呢～？",
    "voice": "vo_adv_1020004_011",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊～！",
    "voice": "vo_adv_1020004_012",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這個蓬蓬的蝴蝶結很適合哥哥呦～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這個髮圈哥哥戴起來應該也非常好看～♪",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……咦？你說美美的目的變了？",
    "voice": "vo_adv_1020004_013",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "說的也是，美美不是要找適合哥哥的東西，",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n而是要找適合送給媽媽的東西～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "但是，媽媽沒有一起來的話，",
    "voice": "vo_adv_1020004_014",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美不知道什麼比較適合她呀～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n哥哥，你覺得美美該怎麼辦才好～？",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "對耶～",
    "voice": "vo_adv_1020004_015",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美只要邊想著媽媽邊找禮物就可以了～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦～！",
    "voice": "vo_adv_1020004_016",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n哥哥與媽媽完全不一樣呦～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不過，既然哥哥都這麼說了，",
    "voice": "vo_adv_1020004_017",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美就試試看～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "唔～嗯……",
    "voice": "vo_adv_1020004_018",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "到底買哪種禮物會讓媽媽開心呢～？",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊！這條項鍊似乎很適合媽媽～",
    "voice": "vo_adv_1020004_019",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "多少錢呢～？",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦～！非常的貴耶～？",
    "voice": "vo_adv_1020004_020",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美的零用錢不夠……",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊！這個戒指也好可愛～",
    "voice": "vo_adv_1020004_021",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n這個的話或許美美就買得起了～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這個要多少錢呢～？",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊……美美的零用錢也買不起戒指呀～",
    "voice": "vo_adv_1020004_022",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "怎、怎麼辦……",
    "voice": "vo_adv_1020004_023",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "適合送給媽媽的禮物都好貴，",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美沒有一個買得起的～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗚……明明美美為了媽媽",
    "voice": "vo_adv_1020004_024",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n努力地存了零用錢……",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n嗚、嗚哇～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……哥、哥哥？",
    "voice": "vo_adv_1020004_025",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "你說不要緊是怎麼一回事？",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "可以送不需要花錢的禮物……？",
    "voice": "vo_adv_1020004_026",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n有、有這樣的東西嗎～？",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦？哥哥，你要去哪裡～？",
    "voice": "vo_adv_1020004_027",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "等等美美～！",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "background",
    "bg_id": "510070"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥，你來公園要做什麼啊？",
    "voice": "vo_adv_1020004_028",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗚哇！這裡有好多花～♪",
    "voice": "vo_adv_1020004_029",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥摘這麼多花打算做什麼啊？",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊，美美知道了～！",
    "voice": "vo_adv_1020004_030",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "是要把花當做禮物吧～！",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦？不是嗎？",
    "voice": "vo_adv_1020004_031",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美看了就知道了……？",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥把花編織在一起，",
    "voice": "vo_adv_1020004_032",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n是在做什麼東西呢～？",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊～！這是項鍊～！",
    "voice": "vo_adv_1020004_033",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n是花朵項鍊！",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "和剛才那間店賣的項鍊幾乎一模一樣～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "原來如此～",
    "voice": "vo_adv_1020004_034",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n只要把花朵項鍊當作禮物就可以了～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美也動手做～♪",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "託哥哥的福，",
    "voice": "vo_adv_1020004_035",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美能做出很棒的禮物了～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "謝謝你，哥哥♪",
    "voice": "vo_adv_1020004_036",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美呢，最～喜――",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好了，辛苦了～♪",
    "voice": "vo_adv_1020004_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "剛剛的情景，是我依照你和美美的「記憶碎片」，",
    "voice": "vo_adv_1020004_038",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n創造出來的「夢」唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "很懷念嗎？嗯，還不清楚啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但話說回來，美美的言行舉止比",
    "voice": "vo_adv_1020004_039",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n實際的年齡還要幼稚許多呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "想送母親生日禮物――",
    "voice": "vo_adv_1020004_040",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這說起來是很令人欣慰。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，為此努力地幫媽媽的做家事，",
    "voice": "vo_adv_1020004_041",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "存零用錢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也就是說，那筆錢原本就是父母的錢不是嗎！？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，就父母而言，即使如此還是會很開心吧。",
    "voice": "vo_adv_1020004_042",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我雖然無法理解父母的感受……",
    "voice": "vo_adv_1020004_043",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但是我已經看過太多為了他人而努力的人了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以或許我還是能理解那種開心的感覺。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "總之，因為美美很迷糊，",
    "voice": "vo_adv_1020004_044",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以你作為她的監護人，要給我好好地照顧美美喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為在「那邊」的話，可能只是迷路而已，",
    "voice": "vo_adv_1020004_045",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但是在「這邊」的話，可就不知道她會遇到什麼危險了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，我的忠告也說完了，",
    "voice": "vo_adv_1020004_046",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這次就先到此為止了，再見囉～♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "唔～嗯……？",
    "voice": "vo_adv_1020004_047",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦？這裡是……？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美好像不小心睡著了……",
    "voice": "vo_adv_1020004_048",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……哥哥也睡到剛剛才醒嗎？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "呼…",
    "voice": "vo_adv_1020004_049",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "…",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美呢，總覺得做了一個不可思議的夢耶～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "在夢裡，美美和哥哥一起去挑選給媽媽的生日禮物～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦？哥哥也做了一樣的夢嗎？",
    "voice": "vo_adv_1020004_050",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "好～厲害！真是不可思議呢～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "但是美美居然能和哥哥做一樣的夢，真開心呢～",
    "voice": "vo_adv_1020004_051",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n欸嘿嘿～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……咦？",
    "voice": "vo_adv_1020004_052",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美在最後想說什麼……？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "那、那是……那個……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "沒、沒什麼～",
    "voice": "vo_adv_1020004_053",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "是哥哥聽錯了啦～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "吶吶，哥哥！",
    "voice": "vo_adv_1020004_054",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "除了在夢中之外，醒來了也和美美一起玩吧～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是在這之後，\\n兩人一起去花田製作了花朵項鍊。",
    "voice": null,
    "unit_id": null
  }
]
