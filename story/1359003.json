[
  {
    "type": "background",
    "bg_id": "502640"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──「有個想讓你見見的人」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}接受了剎鬼的提案，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n再次回到吉歐‧尼布爾黑爾的鬼族村莊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "…………好昏暗啊。",
    "voice": "vo_adv_1359003_000",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n吉歐‧尼布爾黑爾的天空。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "還真是奇妙。",
    "voice": "vo_adv_1359003_001",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n明明是我出生的故鄉。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我的事",
    "voice": "vo_adv_1359003_002",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "也不是什麼急事。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就先休息一下吧，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "騎士公。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……這沒什麼大不了的。",
    "voice": "vo_adv_1359003_003",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n黎薩公的箭矢，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "不過是擦傷程度而已。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼的部下",
    "words": "剎鬼大人！",
    "voice": "vo_adv_1359003_004",
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "剎鬼的部下",
    "words": "\\n",
    "voice": null,
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "剎鬼的部下",
    "words": "非常抱歉，才剛回來就打擾您，",
    "voice": null,
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "剎鬼的部下",
    "words": "有事情要報告……",
    "voice": null,
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "說吧。",
    "voice": "vo_adv_1359003_005",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼的部下",
    "words": "我們收到通報，在夜叉山巔山麓上的殭屍村莊，",
    "voice": "vo_adv_1359003_006",
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "剎鬼的部下",
    "words": "\\n正遭到一群漂流過來的怪物襲擊。",
    "voice": null,
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "剎鬼的部下",
    "words": "\\n",
    "voice": null,
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "剎鬼的部下",
    "words": "希望能盡速前往救援。",
    "voice": null,
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "是那裡嗎……",
    "voice": "vo_adv_1359003_007",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n年輕一輩的呢？",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼的部下",
    "words": "他們的話，",
    "voice": "vo_adv_1359003_008",
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "剎鬼的部下",
    "words": "因為正在進行其他地區的救援，",
    "voice": null,
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "剎鬼的部下",
    "words": "以及「深邃庭園」的警戒……",
    "voice": null,
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "剎鬼的部下",
    "words": "\\n",
    "voice": null,
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "剎鬼的部下",
    "words": "如果要動員的話，",
    "voice": null,
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "剎鬼的部下",
    "words": "只能從這個村莊裡最低限度的人員分派出去。",
    "voice": null,
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "現在把他們叫回來",
    "voice": "vo_adv_1359003_009",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "應該也來不及。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但是派守衛村莊的你們出去也划不來──",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "沒辦法，",
    "voice": "vo_adv_1359003_010",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我就去出個差吧。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n又要麻煩你們看家了。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼的部下",
    "words": "……遵命。",
    "voice": "vo_adv_1359003_011",
    "unit_id": 1414
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "抱歉啊，",
    "voice": "vo_adv_1359003_012",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "騎士公。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "你就在這喝杯茶休息一下吧。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……",
    "voice": "vo_adv_1359003_013",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我說啊，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "騎士公。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n「返魂靈玉」的事情我是很感謝你。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但正因為這樣，",
    "voice": "vo_adv_1359003_014",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我不能在還沒償完債之前又欠下人情。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n這樣子，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "會積欠太多啊。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就算你不在意，",
    "voice": "vo_adv_1359003_015",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我也會",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "在意。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "你這笨蛋，",
    "voice": "vo_adv_1359003_016",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "別跟我扯歪理──",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……",
    "voice": "vo_adv_1359003_017",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "嘖。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "沒時間了。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "隨你便吧。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "不過，",
    "voice": "vo_adv_1359003_018",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "要是有危險記得大聲叫我。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "不對，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "還是立刻拔腿就跑吧。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "這是條件。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "知道了嗎？",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "background",
    "bg_id": "502440"
  },
  {
    "type": "dialogue",
    "name": "骷髏飛龍們",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "喂喂。",
    "voice": "vo_adv_1359003_019",
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n你們這群骨頭們居然在別人的地盤上",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "橫行霸道。",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "明明只剩骨頭了還想擋路。",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "──就把這當作招呼。",
    "voice": "vo_adv_1359003_020",
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n粉碎吧！",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "background",
    "bg_id": "502440"
  },
  {
    "type": "dialogue",
    "name": "骷髏飛龍們",
    "words": "──嘎喔喔喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "骷髏飛龍們",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "──嘖。",
    "voice": "vo_adv_1359003_021",
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n一群接著一群……",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "喂，",
    "voice": "vo_adv_1359003_022",
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "騎士公。",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n我來吸引魔物們的注意。",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "你趁機",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "去找來不及逃跑的人，把他們帶回鬼族的村子去。",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……別擔心。",
    "voice": "vo_adv_1359003_023",
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我馬上就跟上。",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "來吧，",
    "voice": "vo_adv_1359003_024",
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我負責開路。",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "──快去……！",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的女殭屍",
    "words": "這裡，",
    "voice": "vo_adv_1359003_025",
    "unit_id": 422
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的女殭屍",
    "words": "在這裡！",
    "voice": null,
    "unit_id": 422
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的男殭屍",
    "words": "太、",
    "voice": "vo_adv_1359003_026",
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的男殭屍",
    "words": "太好了！",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的男殭屍",
    "words": "我們",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的男殭屍",
    "words": "得救了！",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "background",
    "bg_id": "502430"
  },
  {
    "type": "dialogue",
    "name": "骷髏飛龍",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的男殭屍",
    "words": "噫，",
    "voice": "vo_adv_1359003_027",
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的男殭屍",
    "words": "有隻魔物",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的男殭屍",
    "words": "追過來了！",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "骷髏飛龍們",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的女殭屍",
    "words": "不行，",
    "voice": "vo_adv_1359003_028",
    "unit_id": 422
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的女殭屍",
    "words": "前面也有",
    "voice": null,
    "unit_id": 422
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的女殭屍",
    "words": "魔物！",
    "voice": null,
    "unit_id": 422
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的男殭屍",
    "words": "啊啊，",
    "voice": "vo_adv_1359003_029",
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的男殭屍",
    "words": "完蛋了……",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的男殭屍",
    "words": "\\n",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的男殭屍",
    "words": "我們都要死在這裡了……",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "………………",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "來不及逃跑的男殭屍",
