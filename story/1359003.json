    "name": "剎鬼",
    "words": "\\n還覺得你",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "是個軟弱的小子呢。",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "以為你",
    "voice": "vo_adv_1359003_064",
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "是個用話術來討好公主",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "的騙子。",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但是──",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……抱歉啊。",
    "voice": "vo_adv_1359003_065",
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n看來，",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "是我錯看你了。",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "啊？",
    "voice": "vo_adv_1359003_066",
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "………………",
    "voice": "vo_adv_1359003_067",
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "哈哈哈──",
    "voice": "vo_adv_1359003_068",
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "唔……！",
    "voice": "vo_adv_1359003_069",
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n別、",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "別逗我笑啊。",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n傷口會裂開的……",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "still",
    "still_id": "135900302"
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "──",
    "voice": "vo_adv_1359003_070",
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我要睡了。",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n把你的背借我一下。",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "騎士公。",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……可別忘了我們約好了，",
    "voice": "vo_adv_1359003_071",
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "有個想讓你",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "見的人……",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "………………",
    "voice": "vo_adv_1359003_072",
    "unit_id": 135911
  },
  {
    "type": "background",
    "bg_id": "502640"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n醒過來的剎鬼帶著{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到了某個地方。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "這個村子的墓地。",
    "voice": "vo_adv_1359003_073",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n我想讓你見的人就在這裡……",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "啊，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "有了，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就在那裡。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我的妹妹，",
    "voice": "vo_adv_1359003_074",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就在這塊墓碑下面。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n我想",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "讓她",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "看看你。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "background",
    "bg_id": "502400"
  },
  {
    "type": "background",
    "bg_id": "502640"
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……是啊。",
    "voice": "vo_adv_1359003_075",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n但並不是長相……",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "該怎麼說，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "應該是",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "給人的感覺吧。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "非常地相似。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "話雖如此，",
    "voice": "vo_adv_1359003_076",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "也就只是這樣罷了。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "說到底那個幽靈",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "根本不是鬼族。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……不過，",
    "voice": "vo_adv_1359003_077",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我無法放著她不管，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "這也是事實。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……打掃",
    "voice": "vo_adv_1359003_078",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "差不多就這樣吧。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "謝謝你的幫忙。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "騎士公。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……這位小哥",
    "voice": "vo_adv_1359003_079",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "也在幫妳祈禱呢。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n真是太好了。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……",
    "voice": "vo_adv_1359003_080",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "那麼。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "接下來才是重點。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n我們鬼族",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "有在墳墓前立下誓言",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "的習俗。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "不光是這次的事件。",
    "voice": "vo_adv_1359003_081",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "都是因為我太沒用了，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n才會讓身為外人的你",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "幫了我這麼多次忙。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "所以我發誓。",
    "voice": "vo_adv_1359003_082",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n這份大恩情，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我會用一輩子來──",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……怎麼了。",
    "voice": "vo_adv_1359003_083",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n我可是很認真的啊。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "你有在聽我說話嗎。",
    "voice": "vo_adv_1359003_084",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n我必須為這件事做個了斷。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n從外人那──",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……啊……？",
    "voice": "vo_adv_1359003_085",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "…………",
    "voice": "vo_adv_1359003_086",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n……",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n……",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "呵。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "哈哈！",
    "voice": "vo_adv_1359003_087",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n啊哈哈哈！",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "的確",
    "voice": "vo_adv_1359003_088",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "是呢──",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "把死黨的好意，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "硬說是人情債，也太不知趣了……",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "真",
    "voice": "vo_adv_1359003_089",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "抱歉啊，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "剛才的介紹似乎不太對。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n讓我再重新，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "把你介紹給我的妹妹。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "這傢伙──",
    "voice": "vo_adv_1359003_090",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "是我的死黨公！",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "經歷了靈玉事件與殭屍村救援事件後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與剎鬼建立了堅定羈絆的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n作為剎鬼的死黨公受到了鬼族的歡迎。",
    "voice": null,
    "unit_id": null
  }
]
