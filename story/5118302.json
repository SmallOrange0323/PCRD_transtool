  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "莫夫！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "我們的戰鬥方式，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "你有好好記下來了嗎？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "呵呵，",
    "voice": "vo_adv_5118302_001",
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "那當然。",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "\\n",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "畢竟我可是得到了充分的時間來學習呢。",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "\\n就讓我先給你們一個忠告吧，",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "現在的我與剛才已經不是同一個人了喔。",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "感謝你的忠告。",
    "voice": "vo_adv_5118302_002",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "只不過……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這句話，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就原封不動地奉還給你吧。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "畢竟現在的我們，也和剛才截然不同了。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就算你會預測我們的行動，",
    "voice": "vo_adv_5118302_003",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們也會不斷地超越！",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n現在就證明給你看吧！",
    "voice": null,
    "unit_id": 125511
  }
]
