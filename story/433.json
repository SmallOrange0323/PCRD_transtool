  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就是這個，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這才是我所期望的生死決鬥啊！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n真是愉快呀，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "陛下！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "給我閉嘴。",
    "voice": "vo_adv_0000433_001",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "對現在的我來說，除了轟飛妳們之外，",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n其餘的事都令我不悅。",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈哈！　",
    "voice": "vo_adv_0000433_002",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "別說這麼冷淡的話嘛！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "況且，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "您才不是只有這點程度的對吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n讓我見識您剛剛將我逼至絕境的那股強大力量吧！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "當然，",
    "voice": "vo_adv_0000433_003",
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不用妳說我也是這麼打算的……！",
    "voice": null,
    "unit_id": 106915
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "霸瞳皇帝的攻擊，",
    "voice": "vo_adv_0000433_004",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n威力變得更加強大了……！",
    "voice": null,
    "unit_id": 105911
  }
