[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某一天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正在打工送貨的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n見到茉莉的身影，出聲叫住了她。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊！",
    "voice": "vo_adv_1239002_000",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我還想說是誰，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "原來是{0}啊！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "看你這樣，",
    "voice": "vo_adv_1239002_001",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "現在正在打工吧？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n辛苦了！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "對了，",
    "voice": "vo_adv_1239002_002",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我接下來要去特訓了！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我想要趕快成為",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "配得上那副鎧甲的",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "正義的夥伴！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不不不，",
    "voice": "vo_adv_1239002_003",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "對我來說還太早了！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "在鏡子前面一看",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就會很清楚，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我看起來就像是",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "穿上了",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不合身的衣服一樣。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不是有個詞",
    "voice": "vo_adv_1239002_004",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "叫作「架勢」嗎？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "純或者",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "族長都有",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那種很厲害的架勢。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但是",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我完全",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "沒有這種架勢啊！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我超級遜的，",
    "voice": "vo_adv_1239002_005",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n重點是",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我對不起製作鎧甲給我的媽媽。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "所以現在",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我要埋頭特訓！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "可惜歸可惜，",
    "voice": "vo_adv_1239002_006",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我也不能因為可惜就穿啊！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "而且",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我沒有把它收起來喔，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我把它供在房間裡最顯眼的位置，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "每天都在看著它！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我看到",
    "voice": "vo_adv_1239002_007",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "鎧甲上都快被我穿出洞來了，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "看得媽媽也說了",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "「我特地做給妳的，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "妳快點穿上吧」！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……奇怪？",
    "voice": "vo_adv_1239002_008",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n你和媽媽",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "講的幾乎是一樣的話……？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n奇怪了～？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "才、",
    "voice": "vo_adv_1239002_009",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "才才才沒有呢！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我穿起來感覺比之前更有壓力……",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不對，才沒有這回事！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我第一次",
    "voice": "vo_adv_1239002_010",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "穿的時候當然也",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "很緊張，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n但是",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "冷靜下來想一想，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我收到的東西",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好像比我認為的更不得了……",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是說",
    "voice": "vo_adv_1239002_011",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "怎麼搞得我好像在找藉口一樣！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "收回收回！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我收回前言！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n請你當作沒聽到～！！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "總而言之，",
    "voice": "vo_adv_1239002_012",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我的決心不會改變！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "首先",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我要磨練到自己能接受的程度！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "其他的以後再說！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那麼",
    "voice": "vo_adv_1239002_013",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我差不多要走了！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n你打工",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也加油喔！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "真的嗎！？",
    "voice": "vo_adv_1239002_014",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n嘿嘿，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那我要好好努力，好好表現",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "給你看！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好──",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "今天也要認真訓練～！！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}看著茉莉活力十足跑開的背影，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n重新開始送貨。",
    "voice": null,
    "unit_id": null
  },
