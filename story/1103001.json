  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在夏天的某一天，{0}\\n收到了寄給咲戀育幼院的信件。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "哎呀，",
    "voice": "vo_adv_1103001_000",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "早安，{0}。",
