    "name": "咲戀",
    "words": "嗎……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是啊。",
    "voice": "vo_adv_1103001_004",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "最近一直在工作，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "孩子們也吵著想出去玩，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "而且每天都很熱……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好吧，",
    "voice": "vo_adv_1103001_005",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "決定了！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n偶爾大家一起出去玩吧！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "因為住宿會很花錢，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "所以要當天來回！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
