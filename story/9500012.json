[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……咦。",
    "voice": "vo_adv_9500012_000",
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n{0}……",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真的",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要選我嗎？",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "像我這樣的人，",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "像我一樣，",
    "voice": "vo_adv_9500012_001",
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "除了認真以外沒有其他優點，",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "又死板拘謹的女孩子，",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n待在你身邊，",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "只會帶來負擔吧……",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我一直",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是這麼想的……",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……",
    "voice": "vo_adv_9500012_002",
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "明明我一直想著，",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "應該由我來傳達心意的……",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n沒想到，",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "被你搶先一步了呢。",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……呵呵……",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你還記得嗎？",
    "voice": "vo_adv_9500012_003",
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我第一次開個人演唱會的時候……",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n是你溫柔地開導了",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "在最後關頭怯場的我。",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "然後──",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還為我唱了歌。",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那是一首為了鼓勵我而唱的",
    "voice": "vo_adv_9500012_004",
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "聲援歌。",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "拜託了，{0}。",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n可以請你",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "再為我唱一次嗎？",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊啊……",
    "voice": "vo_adv_9500012_005",
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "身體逐漸充滿了力量……",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n你的心意",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "透過歌聲傳達過來了。",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n是改變曾經懦弱的我的",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "溫暖歌聲……！",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "曾說過",
    "voice": "vo_adv_9500012_006",
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "害怕在人前唱歌的我，",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "受到望的邀請，",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "與紡希一起，",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "３人組成了【慈樂之音】。",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "也遇到了蘭法小姐……",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "與其他唱喚士夥伴。",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我能成為如今的我，",
    "voice": "vo_adv_9500012_007",
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "一定是",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "多虧了你。",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "雖然這種時候說這些有點奇怪……",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但請讓我向你道謝。",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還有，",
    "voice": "vo_adv_9500012_008",
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這次",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "也讓我唱歌吧。",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……一首誓言之歌。",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是包覆著",
    "voice": "vo_adv_9500012_009",
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你與我未來的，",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104241
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "獻給風的誓言……♪",
    "voice": null,
    "unit_id": 104241
  }
]
