[
  {
    "type": "background",
    "bg_id": "500997"
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ねずみを追い払うのにもだいぶ慣れてきたね。",
    "voice": "vo_adv_5040702_000",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "それにしても、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "なんでこんなにチーズを狙うのかな？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "チーズ以外にも食べ物はあるじゃん。",
    "voice": "vo_adv_5040702_001",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nまっひ～には悪いけど、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ドングリとかくるみとかの方が",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nおいしいと思う。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "んー、",
    "voice": "vo_adv_5040702_002",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "でもよく考えたらあたし、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "牧場のチーズを",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nきちんと味わったことないな。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "このチーズはお土産用だから",
    "voice": "vo_adv_5040702_003",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "食べちゃダメだよね。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ん～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "でも",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "さっきから",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ドングリにはない",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "独特な匂いが食欲を刺激して……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "なんて言うんだろう……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "生命の源みたいな感じで芳醇な……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "チーズもなかなか……",
    "voice": "vo_adv_5040702_004",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "いや！　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "いやいや！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nやっぱりドングリの方がいいよ！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "うん、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "絶対ドングリの方がいい！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "ねずみ",
    "words": "ちゅ～！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "わっ！？　",
    "voice": "vo_adv_5040702_005",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "また出た！！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "しかもさっきのねずみより大きい！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "そんなにチーズが欲しいの？",
    "voice": "vo_adv_5040702_006",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "余計にチーズのこと調べたくなっちゃったじゃん。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "さっさと追い払わせてもらうよ！",
    "voice": "vo_adv_5040702_007",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n覚悟してね！",
    "voice": null,
    "unit_id": 102611
  }
]
