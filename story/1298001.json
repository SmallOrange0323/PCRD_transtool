  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那種東西就趕快撕……",
