[
  {
    "type": "background",
    "bg_id": "501680"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "【王宮騎士團】訓練營地。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在那裡，正由本期也擔任教官的真琴",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n進行著嚴格的指導。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "──喝啊！",
    "voice": "vo_adv_1298001_000",
    "unit_id": 129811
  },
  {
    "type": "background",
    "bg_id": "501680"
  },
  {
    "type": "dialogue",
    "name": "新兵1",
    "words": "咕唔",
    "voice": "vo_adv_1298001_001",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新兵1",
    "words": "唔……！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "怎麼了？",
    "voice": "vo_adv_1298001_002",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳一直在採取防禦啊！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n再這樣下去要被壓制住了喔！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就像這樣……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呢！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "background",
    "bg_id": "501680"
  },
  {
    "type": "dialogue",
    "name": "新兵1",
    "words": "啊嗚！",
    "voice": "vo_adv_1298001_003",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "今天就先到此為止。",
    "voice": "vo_adv_1298001_004",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳還有很多不足之處啊。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "新兵1",
    "words": "是……",
    "voice": "vo_adv_1298001_005",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新兵1",
    "words": "對不起……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……不過，",
    "voice": "vo_adv_1298001_006",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳的動作比之前好了很多呢。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我充分明白妳的努力了。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就照著這個步調加油吧，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "安博。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "好、",
    "voice": "vo_adv_1298001_007",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "好的！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "謝謝妳，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "真琴教官！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "\\n為了能回應妳的期待，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "我會精進自己的！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "那我告辭了！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那麼，",
    "voice": "vo_adv_1298001_008",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "上午的訓練就到此結束了啊。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n休息一下吧……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喔哇！？",
    "voice": "vo_adv_1298001_009",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你剛剛一直在看嗎！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n為什麼你會在這裡！？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊啊，",
    "voice": "vo_adv_1298001_010",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "原來如此……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "因為在營地裡不太能跟家人取得聯繫呢。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "所以郵差送來的信，",
    "voice": "vo_adv_1298001_011",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n會是新兵們的動力。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "辛苦你了。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "看起來是那樣嗎？",
    "voice": "vo_adv_1298001_012",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……如果真是這樣，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那也是你們的功勞吧。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "因為你就是我第一個",
    "voice": "vo_adv_1298001_013",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "指導戰鬥方法的對象啊。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那之後不知道是什麼樣的緣由，",
    "voice": "vo_adv_1298001_014",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我還成了大小姐們的防身術講師……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "做著做著，",
    "voice": "vo_adv_1298001_015",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就習慣了教導沒有經驗的人戰鬥。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "多虧如此，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我才有辦法擔任教官呢。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……不過，",
    "voice": "vo_adv_1298001_016",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我也沒能夠完美地回應",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n新人們的期待就是了。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不，",
    "voice": "vo_adv_1298001_017",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "完全不是什麼大事。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "只不過……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n最近不知為何，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "希望入團的人變得比以前多啊。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "隸屬於其他班的新人們",
    "voice": "vo_adv_1298001_018",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好像常常在說，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n想進我的……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "想進到真琴教官的班",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呢。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "當然，",
    "voice": "vo_adv_1298001_019",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "班是不能輕易更換的。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n不然紀律會亂掉啊。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過，",
    "voice": "vo_adv_1298001_020",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "無法滿足他們的願望總覺得很抱歉啊……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n就只是這種事而已。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……但話說回來，",
    "voice": "vo_adv_1298001_021",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "為什麼會想進我的班呢？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "雖然自己講有點怪，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但我可是相當嚴厲的喔。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真是的，",
    "voice": "vo_adv_1298001_022",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "到底是怎麼回事啊……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "真琴教官！",
    "voice": "vo_adv_1298001_023",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "\\n謝謝妳",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "剛剛和我比試！",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哦，",
    "voice": "vo_adv_1298001_024",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "安博。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳現在要去吃午餐嗎？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "是的！",
    "voice": "vo_adv_1298001_025",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "所以那個……",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "妳不介意的話",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "要不要一起吃？",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "其實，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "我有做了",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "教官的便當來！",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可以嗎？",
    "voice": "vo_adv_1298001_026",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那我就不客氣地享用吧！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "新兵2",
    "words": "啊──",
    "voice": "vo_adv_1298001_027",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "新兵2",
    "words": "只有安博也太奸詐了！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "新兵2",
    "words": "真琴教官！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "新兵2",
    "words": "\\n我",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "新兵2",
    "words": "也有做了三明治過來，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "新兵2",
    "words": "妳要不要吃呢！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哈哈，",
    "voice": "vo_adv_1298001_028",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "謝啦！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那我也不客氣了。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我記得……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳是佐藤吧。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "謝謝妳啊！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "哇……！",
    "voice": "vo_adv_1298001_029",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "\\n我",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "明明是其他班的，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "妳卻記得我呢！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我每期",
    "voice": "vo_adv_1298001_030",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "都會盡量記住所有人的臉跟名字。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n因為妳們是肩負蘭德索爾未來",
    "voice": null,
    "unit_id": 129811
  },
  {
