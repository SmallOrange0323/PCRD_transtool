  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我很難說出要撕了扔掉啊……",
    "voice": null,
    "unit_id": 129811
  },
