    "name": "怜",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說的也是呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不好好享受難得的祭典就太浪費了呢。",
    "voice": null,
