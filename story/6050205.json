    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n沒有必要感到不好意思呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "多虧{0}，我不再迷惘了，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 114011
  },
  {
