  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "博士的",
    "voice": "vo_adv_6076204_000",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "發明技術，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "一點也不輸給",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "東國的",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "機關技術呢。",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "像我的笛子",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "能夠藉由笛聲",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "喚來妖魔是也，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n不知將軍的裝備",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "具有什麼樣的能力呢？",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這個裝置，",
    "voice": "vo_adv_6076204_001",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我之前就一直覺得",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "很不可思議是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n為何",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "可以將捕捉到的",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "大量小棉花糖們",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "全都吸進去呢……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "到底是根據什麼樣的原理呢。",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "博士真是個",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "充滿謎團的人物是也……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哦……",
    "voice": "vo_adv_6076204_002",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "原來背上的",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "捕獲機",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "還具有這樣的功能是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "所以，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我們",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "初次遇到小棉花糖時，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n將軍也是",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "追著牠的反應",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "才趕來的吧！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "的確，",
    "voice": "vo_adv_6076204_003",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "妖魔是",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "靈界的居民……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "所以會具有",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我們不知道的攻擊能力是也。",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我的制服也是",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "博士製作的，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "同樣能夠抵擋妖魔的攻擊！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "萬一將軍陷入危機，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "就由我來當",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "你的盾牌吧──！",
    "voice": null,
    "unit_id": 117811
  }
]
