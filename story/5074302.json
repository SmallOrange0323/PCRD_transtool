[
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀呀，",
    "voice": "vo_adv_5074302_000",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "力量變得比剛才更強大了呢。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真不愧是自稱世界支配者的傢伙呢。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳佩服個什麼勁啊！？",
    "voice": "vo_adv_5074302_001",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我們陷入大危機啦！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "危機？",
    "voice": "vo_adv_5074302_002",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳應該也多少經歷過",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "一些激戰了吧？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "才這種程度就哀哀叫，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n可別想要我當妳的主治醫師喔？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……看來，",
    "voice": "vo_adv_5074302_003",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我好像跟很不得了的人物扯上關係了。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為了我的美麗，我什麼都願意做喔。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "所以",
    "voice": "vo_adv_5074302_004",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我們趕快打倒這個肌肉怪物，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "然後妳就要當我的主治醫師！",
    "voice": null,
    "unit_id": 117611
  }
]
