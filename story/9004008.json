  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "嗯！",
    "voice": "vo_adv_9004008_004",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n只要五位魔法少女團結一心，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "就沒什麼好怕的！",
    "voice": null,
    "unit_id": 114211
