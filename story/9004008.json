  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "……嗯？",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "五位？",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "{0}……！\\n什麼時候……！",
    "voice": "vo_adv_9004008_005",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "出現得太突然了，害我嚇一跳……！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "不過，",
    "voice": "vo_adv_9004008_006",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "這時機正好。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n我們現在",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "剛好要去調查某件事。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "上次的可疑三人組",
    "voice": "vo_adv_9004008_007",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n正在反覆進行充滿謎團的會面──我們收到這項情報。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n說不定和反逆獸有關，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "似乎有必要深入調查。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "如何？",
    "voice": "vo_adv_9004008_008",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "閣下要不要也一起來？",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n要是能一同戰鬥的話，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "感覺會很安心。",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "background",
    "bg_id": "501450"
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "這裡還是沒有變，是個具有獨特氛圍的空間呢……",
    "voice": "vo_adv_9004008_009",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "這裡還沒有被拆掉呀……",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "恐怕是巨大邪惡有所謀劃，",
    "voice": "vo_adv_9004008_010",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "才故意留下來的……！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "魔法少女們的嶄新戰鬥",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "搞不好就要開始了……！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "果然栞是會對這種事情",
    "voice": "vo_adv_9004008_011",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "感到興奮的類型呢……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "那邊──",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
