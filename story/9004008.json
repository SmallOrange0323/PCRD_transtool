  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "當然，",
    "voice": "vo_adv_9004008_001",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "都準備好了哦。",
