  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "這麼一來，",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "弟弟也會很高興的吧！",
