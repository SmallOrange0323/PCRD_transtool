    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "雖然聽不太見，",
    "voice": "vo_adv_9004008_015",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n但感覺她們果然在計畫壞事……？",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "那就只能把她們抓起來了……！",
    "voice": "vo_adv_9004008_016",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "好在",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "我們還沒有被發現，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "發動奇襲……",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "呃，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "閣下……！？",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "不要堂堂正正地走出去啦……！",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "哎呀，",
    "voice": "vo_adv_9004008_017",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "{0}。",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n能用精神飽滿的聲音打招呼，很了不起哦。",
