  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "只要立他為模範生，",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n而大家也和他一樣乖的話，",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "我想他也會很高興的♪",
    "voice": null,
    "unit_id": 101812
  },
  {
