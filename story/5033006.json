[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "霞跟栞的力量因為摩拉被綁走而變弱，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n反逆獸則因為靜流的愛的力量而變得更加巨大。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n魔法少女們陷入了一籌莫展的險境。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "好了，",
    "voice": "vo_adv_5033006_000",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "魔法少女們。",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "讓開吧？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "弟弟是需要姐姐的。",
    "voice": "vo_adv_5033006_001",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "得用姐姐的愛",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "來守護弟弟呢。",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "……靜流小姐的樣子很奇怪。",
    "voice": "vo_adv_5033006_002",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "她的感情失控了嗎？",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "是因為反逆獸巨大化以後所造成的影響嗎……！？",
    "voice": "vo_adv_5033006_003",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "嗯，",
    "voice": "vo_adv_5033006_004",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "雖然應該要這麼做……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n但老實說，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "狀況並不樂觀呢。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "是的。",
    "voice": "vo_adv_5033006_005",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "摩拉在",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "靜流小姐的手上……",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n也因為這樣，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "我們的力量正在一點一點流失……",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "再加上……",
    "voice": "vo_adv_5033006_006",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "反觀對方",
    "voice": "vo_adv_5033006_007",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n接收了靜流小姐跟摩拉的力量，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "變得更強了。",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "現在的狀況實在是……",
    "voice": "vo_adv_5033006_008",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "沒有戰勝的可能呢。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "那麼",
    "voice": "vo_adv_5033006_009",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "放棄不就好了嗎？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "嗚哇！？",
    "voice": "vo_adv_5033006_010",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "呀啊！？",
    "voice": "vo_adv_5033006_011",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "妳～們看。",
    "voice": "vo_adv_5033006_012",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n我們之間的力量差距這麼明顯唷？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "乖乖的把弟弟交出來就好了。",
    "voice": "vo_adv_5033006_013",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n不會有事的唷？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "姐姐只是",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "想要好好地疼愛弟弟而已喔。",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "我不會去破壞街道，",
    "voice": "vo_adv_5033006_014",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "也沒有打算傷害他人喔？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "不行的……！",
    "voice": "vo_adv_5033006_015",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "要是滿足了她的愛，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n反逆獸也會",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "變得更加強大……！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "這樣的話，",
    "voice": "vo_adv_5033006_016",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "這條街道就……！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "真是的，",
    "voice": "vo_adv_5033006_017",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "把人說得像是壞人一樣。",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n姐姐要生氣囉？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "就算是弟弟的請求，",
    "voice": "vo_adv_5033006_018",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "也辦不到呢。",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n把這孩子還給你們的話，",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "你們又會開始妨礙我對吧？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "才沒那回事呢。",
    "voice": "vo_adv_5033006_019",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n跟這些孩子們在一起的話，",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "就會覺得什麼事都做得到呢。",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "牠們是會幫助姐姐傳達愛意的",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "好孩子喔？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "……唉。",
    "voice": "vo_adv_5033006_020",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "不論如何",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "都要拒絕姐姐的愛嗎？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n姐姐覺得好受傷喔。",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "是那些魔法少女的錯嗎？",
    "voice": "vo_adv_5033006_021",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "助手先生——",
    "voice": "vo_adv_5033006_022",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "嗚咕！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "危險——",
    "voice": "vo_adv_5033006_023",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "啊嗚！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "兩個人的……",
    "voice": "vo_adv_5033006_024",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "變身都……！？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "這樣子魔法少女就沒用了。",
    "voice": "vo_adv_5033006_025",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "沒有這孩子的力量，就沒辦法變身了吧？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "萬事休矣",
    "voice": "vo_adv_5033006_026",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗎……！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呼、",
    "voice": "vo_adv_5033006_027",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呼……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "竟然、",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "敗在這種地方……！",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……",
    "voice": "vo_adv_5033006_028",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "快點逃跑吧，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n你被抓住的話，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就真的結束了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……就算攻擊不起作用，",
    "voice": "vo_adv_5033006_029",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我們還是能夠爭取時間。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "請你快點想辦法逃走……！",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "居然還能站得起來啊。",
    "voice": "vo_adv_5033006_030",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "……對了！",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n也告訴妳們兩位",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "我對弟弟的愛吧！",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "！？",
    "voice": "vo_adv_5033006_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "只要用這些孩子們的力量，",
    "voice": "vo_adv_5033006_032",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "應該就能",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n把我的愛傳達給大家了♪",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "然後未來，",
    "voice": "vo_adv_5033006_033",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "再把姐姐的愛",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n也傳達給蘭德索爾的人們吧……♪",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生！",
    "voice": "vo_adv_5033006_034",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不行啊，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "快點逃……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "快點逃跑！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗚，",
    "voice": "vo_adv_5033006_035",
    "unit_id": 103811
  },
