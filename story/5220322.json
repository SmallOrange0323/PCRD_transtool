  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "烏爾姆！",
    "voice": "vo_adv_5220322_001",
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n妳還好嗎！？",
    "voice": null,
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那股力量，",
    "voice": "vo_adv_5220322_002",
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "似乎消耗相當劇烈呢。",
    "voice": null,
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "敵人正不斷糾纏並攻擊那些已經疲憊的對手。",
    "voice": null,
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n過於深入敵陣可是很危險的。",
    "voice": null,
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……我知道。",
    "voice": "vo_adv_5220322_003",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "但即便如此，",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我也不能退縮。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我已經……",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不想再",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "迷惘下去了。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……是嗎。",
    "voice": "vo_adv_5220322_004",
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n妳已經",
    "voice": null,
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "下定決心了呢。",
    "voice": null,
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "這裡就讓我來",
    "voice": "vo_adv_5220322_005",
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "挺身而出！",
    "voice": null,
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我一定會",
    "voice": null,
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "保護烏爾姆的！",
    "voice": null,
    "unit_id": 140611
  }
]
