[
  {
    "type": "background",
    "bg_id": "501992"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "蘭法小姐。",
    "voice": "vo_adv_5120080_000",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然我知道她過去做了很多事情，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但是在美的面前",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n一切罪過",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "都是無力的……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "應該不能這樣說吧。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過她那輕透而虛無縹緲的氛圍，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "確實不是能輕易模仿的呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "聽說她是無人能媲美的歌姬，",
    "voice": "vo_adv_5120080_001",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為了將我的美",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "傳達給全世界的人們，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n希望她能為了我吟唱頌歌。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "美麗的我，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "被美麗的歌聲給讚頌著。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這真是個超棒的主意啊……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "希望有天能拜託她看看呢♪",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "美空小姐的臉上",
    "voice": "vo_adv_5120080_002",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然看起來總是掛著明朗的笑容……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但是在那深處",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n似乎隱藏著什麼呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如果能夠窺視她的內心，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是不是可以找到",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n存在其中的美呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真是個高難度的美啊！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過，",
    "voice": "vo_adv_5120080_003",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "沒想到居然會有連我都無法看穿的美呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然很不甘心……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但是關於這件事，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "似乎是我輸了呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "難道說，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "她有著",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只有你知道的一面嗎？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然涅婭小姐",
    "voice": "vo_adv_5120080_004",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "她的方向性跟我不同，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但是我覺得她",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n對美有著相當的堅持呢～",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我感覺她知道要怎麼展現",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n自身魅力的方法。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我說中了嗎？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但是",
    "voice": "vo_adv_5120080_005",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我覺得她對於比自己年紀小的男孩子，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "所展開的攻勢有點太激烈了。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n稍微冷靜一點會比較好吧？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過話說回來，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "她頭上那個",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n有彈性的黃色東西是什麼呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "感覺我好像有在哪裡看過啊……",
    "voice": null,
    "unit_id": 126311
  }
]
