  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗯嗯，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "有這麼回事呢，開幕式──",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "──咦，",
    "voice": "vo_adv_5064601_001",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "有嗎？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真的有啦。",
    "voice": "vo_adv_5064601_002",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不是有老師跟不認識的阿姨之類的上台，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n講無聊的廢話講超久的嗎？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那克蘿依學姐",
    "voice": "vo_adv_5064601_003",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n有專心在聽",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "老師們的話嗎？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "有聽。",
    "voice": "vo_adv_5064601_004",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n是有在聽。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但是什麼都不記得到都讓人驚訝了。",
    "voice": null,
    "unit_id": 116211
  }
]
