[
  {
    "type": "background",
    "bg_id": "501870"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "逛蘭祭會場的{0}和七七香，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在看似正在爭吵的一行人面前停下腳步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "所以說，",
    "voice": "vo_adv_1237002_000",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "妳講得不是很奇怪嗎？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n根本就無視上下文的脈絡了嘛。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "一點都不奇怪。",
    "voice": "vo_adv_1237002_001",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n正常得很。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "不如說這是常識好不好。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "到底是哪個偏僻鄉下的常識啊？",
    "voice": "vo_adv_1237002_002",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n妳讀得還不夠深入吧？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊～",
    "voice": "vo_adv_1237002_003",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "爭論得好激烈耶……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯，我想也是。",
    "voice": "vo_adv_1237002_004",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你就是這樣的人，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n果然會在意吧……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不會，",
    "voice": "vo_adv_1237002_005",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那種事情算是家常便飯……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不過還是會有點在意呢。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "真拿你沒辦法……",
    "voice": "vo_adv_1237002_006",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我也不想在難得的蘭祭看到有人起爭執。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哈囉哈囉～",
    "voice": "vo_adv_1237002_007",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "幾位姐姐，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "可以打擾一下嗎？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "妳是在叫",
    "voice": "vo_adv_1237002_008",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "我們嗎？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "啥……",
    "voice": "vo_adv_1237002_009",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "幹嘛？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n我們和跟風仔可沒什麼好談的喔。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "而且還帶著男人……",
    "voice": "vo_adv_1237002_010",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "是來亂的嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "帶帶帶、",
    "voice": "vo_adv_1237002_011",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "帶著男人！？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不不不、",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不是啦他跟我不是那種關係……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不，",
    "voice": "vo_adv_1237002_012",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "重點不是這個！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……哎呀～不好意思啊，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我只是",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "感覺妳們好像在起爭執……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "這跟妳沒關係吧？",
    "voice": "vo_adv_1237002_013",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "而且妳知道我們在說什麼嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是赤空，",
    "voice": "vo_adv_1237002_014",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對吧？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "只聽到那麼一小段對話為什麼會知道？",
    "voice": "vo_adv_1237002_015",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n難道妳跟蹤我們！？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那很簡單啊，",
    "voice": "vo_adv_1237002_016",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n你們三個人都帶著週邊……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "啊……",
    "voice": "vo_adv_1237002_017",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "然後，",
    "voice": "vo_adv_1237002_018",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "如果是解釋不同而起爭執，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n那就不是在講四騎士而是司天！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我是這樣猜測的～",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "說、",
    "voice": "vo_adv_1237002_019",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "說對了……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n妳滿厲害的嘛。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "是說旁邊這位，你還好嗎？",
    "voice": "vo_adv_1237002_020",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n跟得上話題嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊哈～抱歉抱歉。",
    "voice": "vo_adv_1237002_021",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "赤空是現在",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "在男女之間都很受歡迎的奇幻作品啦！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "當然它不是普通的奇幻作品，",
    "voice": "vo_adv_1237002_022",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "在每座島上譜寫出有哭有笑的各種劇情，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n還有裡面的角色都超棒的！！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "妳很懂嘛。",
    "voice": "vo_adv_1237002_023",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "沒錯……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n我們是司天推。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "只不過，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "這個人一直在說莫名其妙的話……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "啥？",
    "voice": "vo_adv_1237002_024",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "哪裡莫名其妙？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n光輝可是如字面上所示的，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n「受」到高塔的忌妒欸！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "我說啊，",
    "voice": "vo_adv_1237002_025",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "光輝跟做為備份的兄弟湊在一起才比較自然！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n他們的感情可是重到他差點惡墮喔？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n妳到底都看了什麼啊？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "我說了，",
    "voice": "vo_adv_1237002_026",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "現在的光輝不是當時的光輝。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n這妳們總該懂吧？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n所以高塔沒有理由執著於他。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "塔是孤傲的總受。",
    "voice": "vo_adv_1237002_027",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "只有這個可能。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哦哦哦……",
    "voice": "vo_adv_1237002_028",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這可真是業障重啊……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "兄×光！",
    "voice": "vo_adv_1237002_029",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "塔×光！",
    "voice": "vo_adv_1237002_030",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "塔是全方位受！",
    "voice": "vo_adv_1237002_031",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那惡呢……？",
    "voice": "vo_adv_1237002_032",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性們",
    "words": "那個另當別論。",
    "voice": "vo_adv_1237002_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊哈哈哈，",
    "voice": "vo_adv_1237002_034",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我想也是……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊，",
    "voice": "vo_adv_1237002_035",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n要怎麼說，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們不會直接說角色的名字，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n而是用暗號那樣的感覺稱呼。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不知道為什麼。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "對啊，為什麼呢？",
    "voice": "vo_adv_1237002_036",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "以前呀……",
    "voice": "vo_adv_1237002_037",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "發生過很多事喔。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "很多，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "真的……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那、",
    "voice": "vo_adv_1237002_038",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那是歷經百戰的戰士的風範……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呃，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "現在不是被人的氣場壓倒的時候！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這個，",
    "voice": "vo_adv_1237002_039",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "說起來塔的概念",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是從別的系統引進的，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n兄弟中被稱為哥哥的存在",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "也不是光輝。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "那是哪來的消息？",
    "voice": "vo_adv_1237002_040",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "確實，",
    "voice": "vo_adv_1237002_041",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "關於他們名字來源的神話是這麼寫的……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n但那沒有直接的關係吧？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "一般來說可能沒有關係，",
    "voice": "vo_adv_1237002_042",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但赤空這種作品不可能沒考慮這一點。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對了，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "既然知道神話的話，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "兄弟中的哥哥……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n妳還記得出現在哪裡嗎？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "炎之柱……！",
    "voice": "vo_adv_1237002_043",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "咦！",
    "voice": "vo_adv_1237002_044",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "那不是出現在夢裡的巨人嗎？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喔，",
    "voice": "vo_adv_1237002_045",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳很了解嘛喵～",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n真厲害～",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "等等，",
    "voice": "vo_adv_1237002_046",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "我來整理一下。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n光輝和塔是從高次元降臨的，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n光輝做了自己的仿造品還有兄弟跟惡",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "來管理這個世界……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "那不是仿造品！",
    "voice": "vo_adv_1237002_047",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "那個光輝是光輝本人！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n還有，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "塔雖然自己被貶到下界但仍然想回到天界……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "是啊……",
    "voice": "vo_adv_1237002_048",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "那就是塔的優點啊……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n沒有回報的孤傲之人！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "想利用別人卻反遭人利用的可憐體質！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "妳懂嗎！？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "塔這個角色",
    "voice": "vo_adv_1237002_049",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "怎麼說呢，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是之前大戰中敵方的大頭目，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n表現得非常唯我獨尊，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但是被比他高次元的敵人陷害，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n被幽禁起來，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是個",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不走運但很受歡迎的角色呢。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "咦～",
    "voice": "vo_adv_1237002_050",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "還有其他作品中有出現",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "這麼有特色的角色嗎？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "……下次請你告訴我，",
    "voice": "vo_adv_1237002_051",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n我想聽一聽當作參考……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "妳真的很喜歡",
    "voice": "vo_adv_1237002_052",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "這種類型耶……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喔喔，",
    "voice": "vo_adv_1237002_053",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "人的喜好都有偏好呢……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呃，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "回到正題……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我一直在想啊～",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n炎之柱",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "到底是什麼呢？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "他是配合世界毀滅而出現的呢，",
    "voice": "vo_adv_1237002_054",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n簡直就像是針對世界的功能一樣……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "說起來他的存在是事先設定好的嗎？",
    "voice": "vo_adv_1237002_055",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n與他成對的存在被當成了分身……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "惡獲得與分身相近的能力只是突發狀況，",
    "voice": "vo_adv_1237002_056",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n很難認為是事先設定好的。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "至於分身，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "怎麼說呢，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "要說是虛無嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "炎之柱",
    "voice": "vo_adv_1237002_057",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "頂多只能算是天界系統方的備份是嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "跟兄弟不就撞設定了嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "原來如此，",
    "voice": "vo_adv_1237002_058",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "作為天界系統方備份的炎之柱，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n和現世備份的兄弟，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "說不定是互相補足的。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "創造的人，",
    "voice": "vo_adv_1237002_059",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "就是原本的光輝對吧？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "那就是說他瞞著塔暗中安排的囉？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "嗚",
    "voice": "vo_adv_1237002_060",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "怎麼會……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n光輝其實也對哥哥有箭頭嗎……？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "這樣的話，",
    "voice": "vo_adv_1237002_061",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "光輝也顧不得塔了呀……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這麼想的話，",
    "voice": "vo_adv_1237002_062",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就完全是……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性們、七七香",
    "words": "愛啊……",
    "voice": "vo_adv_1237002_063",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒錯！",
    "voice": "vo_adv_1237002_064",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "在萌的面前我們是同志！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n哎呀，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "集結了眾人的英明睿智，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "真是不錯的宅宅對談啊……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "真的，",
    "voice": "vo_adv_1237002_065",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "聊得好起勁。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "我好像很久沒有這麼熱情地跟別人討論了。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "妳啊，",
    "voice": "vo_adv_1237002_066",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "年紀輕輕卻不簡單耶。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "我也還得繼續多學一點才行……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "老實說我小看妳了……",
    "voice": "vo_adv_1237002_067",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "我現在好尊敬妳啊。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不小心談出結論談到都忘記時間了呢。",
    "voice": "vo_adv_1237002_068",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "不過，",
    "voice": "vo_adv_1237002_069",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性3",
    "words": "這樣好嗎？",
