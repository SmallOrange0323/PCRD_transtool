    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳是指什麼？",
    "voice": "vo_adv_1237002_070",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "感覺妳、",
    "voice": "vo_adv_1237002_071",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "聊得超級興奮……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "在相方面前",
    "voice": "vo_adv_1237002_072",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "聊這種話題沒關係嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "什麼──！？",
    "voice": "vo_adv_1237002_073",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n不、",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不是……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "他、",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "才不是什麼相方……",
