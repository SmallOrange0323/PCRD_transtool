  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "難道你知道然後故意裝傻！？",
