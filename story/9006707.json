    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "用這種只學了皮毛的招式，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就以為能當我的對手嗎？",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳的預知精準度，",
    "voice": "vo_adv_9006707_009",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就連我預知精準度的──",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這個嘛。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n就算我放寬評分標準，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳恐怕連20％都不到。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這代表什麼意思，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳明白嗎？",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…………啊、",
    "voice": "vo_adv_9006707_010",
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊哈哈……♪",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我真的",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好開心……♪",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n居然有",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "陛下的20％……",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我真是",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "厲────",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呀！！？",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "真是的……",
    "voice": "vo_adv_9006707_011",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳果然",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "什麼都不懂呢。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳啊？",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就像是剛學會西洋棋規則的孩子一樣。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "和身為頂尖大師的我相比，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "預判的深度完全不同。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也就是說──",
    "voice": "vo_adv_9006707_012",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我能[rub:・]預[/rub][rub:・]知[/rub][rub:・]妳[/rub][rub:・]的[/rub][rub:・]預[/rub][rub:・]知[/rub]。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n[rub:・]我[/rub][rub:・]能[/rub][rub:・]預[/rub][rub:・]知[/rub][rub:・]妳[/rub][rub:・]無[/rub][rub:・]法[/rub][rub:・]預[/rub][rub:・]知[/rub][rub:・]的[/rub][rub:・]事[/rub]。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我能看穿10步棋，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "並在只能看穿３步的妳，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "註定走投無路之處時，放置雷擊。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "所以──",
    "voice": "vo_adv_9006707_013",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n妳的任性也該適可而止了吧？",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳那防禦雷擊的護身符，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也快撐不住囉。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "凱留",
