  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "能不能別說這種讓人噁心的話……",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那可是不敬之罪喔？",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不過──",
    "voice": "vo_adv_9006707_022",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n就算不說這些，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我也會收拾掉妳們幾個的。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n【破曉之星】。",
    "voice": null,
    "unit_id": 106914
  },
