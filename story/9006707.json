    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n還真是",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "做了個不知羞恥的事啊。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳到底是像誰呢。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "──",
    "voice": "vo_adv_9006707_005",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "來吧。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n用妳那雙「眼睛」預知，",
