  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "──光之精靈啊，",
    "voice": "vo_adv_9006707_017",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "進行治癒吧……！",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……抱、",
    "voice": "vo_adv_9006707_018",
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "抱歉啊。",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "大家。",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 139112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為我那句",
