[
  {
    "type": "background",
    "bg_id": "501031"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在這座島嶼的生活",
    "voice": "vo_adv_5092431_000",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就到今天了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "發生太多事情，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n這幾天時間充實得像是過了好幾個月一樣呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是啊，",
    "voice": "vo_adv_5092431_001",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然並非都是開心的事，",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過在迎來結束時",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還是會很捨不得。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那當然啦。",
    "voice": "vo_adv_5092431_002",
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "一開始是靈媒師消失，",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "還有密室事件、",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "三項測驗",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n加上原生生物的襲擊、",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "古代遺跡的困難陷阱、",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "和邪龍死鬥。",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "還有──",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "杏奈，妳太誇張了，",
    "voice": "vo_adv_5092431_003",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "太誇張了啦。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哇，",
    "voice": "vo_adv_5092431_004",
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "糟糕，",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不小心說出我想寫的題材了……",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過，",
    "voice": "vo_adv_5092431_005",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "一想到回到蘭德索爾之後",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我們又要回歸各自的生活，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n就覺得有點寂寞呢……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哼，",
    "voice": "vo_adv_5092431_006",
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳在說什麼。",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們可是同生共死的夥伴，",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n如此強大的緣分",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是不可能這麼簡單地被切斷的。",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "杏奈說得沒錯。",
    "voice": "vo_adv_5092431_007",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就算暫時離別，",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我們的靈魂",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "一定會互相吸引，",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "讓我們再次相遇的。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "哈哈，",
    "voice": "vo_adv_5092431_008",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳們兩個都這麼說的話那一定沒錯。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n感傷就到此為止，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好好享受在島上最後的時間吧！",
    "voice": null,
    "unit_id": 101411
  }
]
