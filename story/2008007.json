  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "欸嘿嘿……♪",
