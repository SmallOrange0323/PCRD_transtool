  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不對，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "變成比之前還要好的聲音了～！",
