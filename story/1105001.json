  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "夏季的某一天，\\n{0}正在蘭德索爾的廣場上散步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊～",
    "voice": "vo_adv_1105001_000",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "有了有了！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "找到你了～！　",
    "voice": "vo_adv_1105001_001",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我本來還覺得很快就能找到呢，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n{0}還真是神出鬼沒呢～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過在蘭德索爾跑來跑去",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "也是不錯的運動呀～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯？　",
    "voice": "vo_adv_1105001_002",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你要幫我擦汗嗎～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "{0}你人真好呢～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那我們走吧！",
    "voice": "vo_adv_1105001_003",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "好了啦好了啦～♪",
    "voice": "vo_adv_1105001_004",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "船到橋頭自然直，",
    "voice": "vo_adv_1105001_005",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "船到橋頭自然直～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "抵～達～！",
    "voice": "vo_adv_1105001_006",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯？　",
    "voice": "vo_adv_1105001_007",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "怎麼了嗎～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n為什麼露出好像踩到眼鏡蛇的表情～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你以為跟之前一樣",
    "voice": "vo_adv_1105001_008",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "要去火山嗎？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "今天不是喔～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "夏天去火山實在太熱了嘛～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "今天啊，",
    "voice": "vo_adv_1105001_009",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "在那邊的舞台有舞會喔～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "大家一起吃吃喝喝熱熱鬧鬧，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "一起跳舞的宴會喔～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "其實啊，",
    "voice": "vo_adv_1105001_010",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我被人拜託在宴會上演奏呢～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "說是請我",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "演奏故鄉的樂器～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "所以啊，我想要讓{0}也聽聽看我的演奏，",
    "voice": "vo_adv_1105001_011",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n就把你帶過來啦～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……這麼說起來，",
    "voice": "vo_adv_1105001_012",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "有點強行就把你給拉來了，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n你會有其他事情要辦嗎？　",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "因為找到{0}太開心了，\\n不小心就",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "一頭熱起來了呢～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "太好了～",
    "voice": "vo_adv_1105001_013",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n不要總是衝動行事，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我經常被霞這樣說呢～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "是這樣嗎～？　",
    "voice": "vo_adv_1105001_014",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那以後有什麼事情的時候，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我都會帶{0}一起去喔～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "有空的話沒關係對吧～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我放心了～！",
    "voice": "vo_adv_1105001_015",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那麼那麼，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我去換衣服囉～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n說到海邊",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "當然就是泳裝囉～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "久等了～！",
    "voice": "vo_adv_1105001_016",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "陽光直接照射到肌膚上",
    "voice": "vo_adv_1105001_017",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真是舒服呢～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯？　",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "為什麼一副不可思議的表情～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "跟平常沒什麼差別？",
    "voice": "vo_adv_1105001_018",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "才沒這回事呢～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "布料比較少，",
    "voice": "vo_adv_1105001_019",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "材質也不一樣喔――？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "來來來，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "摸摸看～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "對吧～",
    "voice": "vo_adv_1105001_020",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不一樣對吧～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "懂了的話就好～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯～",
    "voice": "vo_adv_1105001_021",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "換上泳裝之後",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "總覺得能聽見海洋的聲音呢～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "過來吧～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "過來吧～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "像是在這麼說呢～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "但是，",
    "voice": "vo_adv_1105001_022",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我要好好忍耐想衝進海裡的衝動。",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n派對是晚上開始，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "所以得趁現在好好練習呢～！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這就是今天",
    "voice": "vo_adv_1105001_023",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "要演奏的樂器喔～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這個叫作三線喔～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "形狀很有趣吧～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "在我的故鄉，",
    "voice": "vo_adv_1105001_024",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "每個小孩都會跟爺爺奶奶學習怎麼彈～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我一演奏啊，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不論人還是動物，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就連魔物都會開始跳舞喔～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那就",
    "voice": "vo_adv_1105001_025",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "稍微來彈彈看吧～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "～♪",
    "voice": "vo_adv_1105001_026",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊！",
    "voice": "vo_adv_1105001_027",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "唉呀～",
    "voice": "vo_adv_1105001_028",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n弦剛好就斷掉了呢～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "明明就有經常在換弦呢～？",
    "voice": "vo_adv_1105001_029",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "時機真糟呢～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯？　",
    "voice": "vo_adv_1105001_030",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "比起正式上場的時候斷掉要好～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "時機可以說是不錯嗎～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊～",
    "voice": "vo_adv_1105001_031",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒有帶替換用的弦來呢～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯～。",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真是困擾啊～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "誰嗎……",
    "voice": "vo_adv_1105001_032",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "誰啊？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那個啊～！",
    "voice": "vo_adv_1105001_033",
    "unit_id": 110511
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "記得應該是",
    "voice": "vo_adv_1105001_034",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "在這邊～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嗚喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "有了有了～♪",
    "voice": "vo_adv_1105001_035",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這孩子的鬍鬚很強韌又有彈性，",
    "voice": "vo_adv_1105001_036",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n正好可以拿來當樂器的弦呢～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "看起來毛髮也～",
    "voice": "vo_adv_1105001_037",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "很濃密～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "很可愛吧～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嗚喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯？　",
    "voice": "vo_adv_1105001_038",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "很危險？　",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒問題的～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n這孩子只是警戒心很強，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不會攻擊人的～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過，",
    "voice": "vo_adv_1105001_039",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就算說「請給我鬍鬚～」，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n好像也不是這樣",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就會乖乖給我的氣氛呢～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這種時候",
    "voice": "vo_adv_1105001_040",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就要用這個啦～！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n該讓三線出場囉～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "雖然有一根弦斷掉了，",
    "voice": "vo_adv_1105001_041",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過只要這樣彈～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――嘰歐歐歐歐歐！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你看～",
    "voice": "vo_adv_1105001_042",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "牠變得乖乖的了吧～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n這些孩子啊，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "用這些長長的鬍鬚",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "來感受聲音喔～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "聽到好聽的聲音的時候啊，",
    "voice": "vo_adv_1105001_043",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就能傳達彼此的感情了喔～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――嘰歐歐歐歐歐！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈～",
    "voice": "vo_adv_1105001_044",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "好癢喔～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那麼，",
    "voice": "vo_adv_1105001_045",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "可以給我一點你的鬍鬚嗎～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──呀喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "謝謝～",
    "voice": "vo_adv_1105001_046",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "幫大忙了呢～！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那就",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "在這裡換弦吧～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "把這邊捻在一起、",
    "voice": "vo_adv_1105001_047",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那邊纏起來、",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這裡綁起來，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "然後再把弦台立起來，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "一點一點的調音～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "弄成和弦的話～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "完成～♪",
