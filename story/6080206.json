  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "彦星殿があんなにダメ人間だったとはね～",
    "voice": "vo_adv_6044206_000",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "大体、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "織姫ちゃんって超絶美少女がいるのに",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n他の子とキャッキャウフフしたいとか贅沢極まりない！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "その通り！　",
    "voice": "vo_adv_6044206_001",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "欲張りすぎ！　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "けしからん！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n太古の昔から、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "欲に溺れたものは身を滅ぼすものなんじゃよ。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\nというわけで彦星ーっ、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "首を洗って待ってろよーっ！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "そうだねぇ……",
    "voice": "vo_adv_6044206_002",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "というわけで",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "ここはやっぱり魔法少女の出番だー！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "ちょっぴり刺激的な魔法の力で、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "彦星殿を説得してやるー！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "えっ、",
    "voice": "vo_adv_6044206_003",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "私だったら？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "そりゃあ悲しい、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "と思うよ。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "やっぱり好きになった男の人には、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "\\n自分だけを見ていてほしいっていうか……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "ナナカ",
    "words": "って何言わせんのさぁっ！？",
    "voice": null,
    "unit_id": 113311
  }
]
