[
  {
    "type": "background",
    "bg_id": "510360"
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "にゃっ、",
    "voice": "vo_adv_6106206_000",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "いいこと思いついたにゃ！　",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "お店で猫のグッズを",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n売るっていうのはどうかにゃ？　",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "副収入があればカフェも儲かって",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nモニカも大喜びにゃ。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "キミ、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "なにかいいアイデアはないかにゃ？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "なるほどにゃ！　",
    "voice": "vo_adv_6106206_001",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "推しの猫に肉球でスタンプしてもらうんだにゃ？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "おうちに飾ってもらえば、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "見るたびに推しの猫が恋しくなって",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nついついお店に通ってしまう……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "何人も猫の魅力には抗えないのにゃ！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "──す、",
    "voice": "vo_adv_6106206_002",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "素晴らしいアイデアなのにゃ！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "お店の集客だけでなく、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "猫派の勢力を誇示することもできちゃうにゃ！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nそしてゆくゆくはランドソル全土を、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "猫が支配するのにゃ～！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "うにゃっ！？　",
    "voice": "vo_adv_6106206_003",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "い、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "いくら同じ猫だからって……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nあたしはモフるのもお触りも禁止だにゃ！　",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "非売品なのにゃ！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "……ま、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "まあ、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "キミにだけなら売ってあげてもいいけどにゃ……？",
    "voice": null,
    "unit_id": 107911
  }
]
