    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "稍微加筆記錄下來，",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "以方便流傳而已……！",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "朱色之嚙──！",
