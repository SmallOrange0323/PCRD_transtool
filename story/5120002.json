[
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "伊莉亞在傳說的吸血鬼的傳頌之地，受到推崇而成為了此地之主。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n伊莉亞坐上王座後，魔物們紛紛來到她的跟前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "512000201"
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "伊莉亞大人，",
    "voice": "vo_adv_5120002_000",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "萬歲～！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "\\n伊莉亞大人，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "萬歲～！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈哈哈！",
    "voice": "vo_adv_5120002_001",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "看到了嗎？{0}啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身之前雖然沒有清楚告訴過你，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n但妾身原本",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "可是像這樣受到魔物們崇敬的存在。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如何？",
    "voice": "vo_adv_5120002_002",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有再次認識到妾身的偉大了嗎？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯嗯。",
    "voice": "vo_adv_5120002_003",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你果然是個可愛的傢伙。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是",
    "voice": "vo_adv_5120002_004",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你不需要尊稱妾身為大人喔。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "因為你是特別的啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳心情真好呢，",
    "voice": "vo_adv_5120002_005",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "伊莉亞。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不對，雪，",
    "voice": "vo_adv_5120002_006",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳稱呼妾身還不加上大人嗎。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不然妳就在那裡跟魔物們",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "一起對妾身下跪也可以。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "來吧來吧，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "像它們那樣俯首崇敬妾身。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳在說些什麼啊？",
    "voice": "vo_adv_5120002_007",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n它們是因為我亮麗的秀髮太過耀眼，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "才睜不開眼睛低下頭的。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "它們明明是在喊伊莉亞大人萬歲啊！？",
    "voice": "vo_adv_5120002_008",
    "unit_id": 126211
  },
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……不過",
    "voice": "vo_adv_5120002_009",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然是暫時享受了被人奉承的感覺，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但說要妾身領導這些傢伙，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "究竟該做些什麼才好啊？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "若是行程，",
    "voice": "vo_adv_5120002_010",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "已經都安排好了。",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯，",
    "voice": "vo_adv_5120002_011",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "說來聽聽吧。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "關於傳說的吸血鬼復活",
    "voice": "vo_adv_5120002_012",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "並降臨於此地的消息。",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "已經透過生活於黑暗之物的情報網",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "傳到各地去了。",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "喔～",
    "voice": "vo_adv_5120002_013",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳變得那麼有名了呀，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "伊莉亞。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "這是當然的。",
    "voice": "vo_adv_5120002_014",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n傳說的吸血鬼復活，",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "是我們魔族以及黑暗魔物們的夙願。",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "而這樣的伊莉亞大人所在的這塊地，",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "正是我們的憧憬之地。",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "現在也不斷有想申請移居至此地者前來。",
    "voice": "vo_adv_5120002_015",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "希望伊莉亞大人",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "可以謁見它們。",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身來到這裡還未滿一天的時間，它們就已經過來了嗎！？",
    "voice": "vo_adv_5120002_016",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "謁見……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "太拘謹的儀式讓人很提不起勁啊……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "還請您見諒。",
    "voice": "vo_adv_5120002_017",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "與來自各地的來訪者們建立良好的關係，",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n若能順利讓它們服從，",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "不僅能提升伊莉亞大人的地位、",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "宣揚您的名聲，",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n還能加速傳說的復活吧。",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如果在這裡被它們討厭，",
    "voice": "vo_adv_5120002_018",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不僅會降低伊莉亞的地位，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "名聲一落千丈，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還會毀了讓傳說復活的機會呀。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳為什麼要給妾身製造壓力！？",
    "voice": "vo_adv_5120002_019",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯，",
    "voice": "vo_adv_5120002_020",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這反而更令人提不起勁了。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "眷屬啊，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你有沒有什麼好辦法？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "原來如此，",
    "voice": "vo_adv_5120002_021",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "由你來擔任妾身的發言人進行謁見啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這真是個好辦法！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "交給我吧♪",
    "voice": "vo_adv_5120002_022",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我會讓大家",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "都變成我美貌的俘虜的！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好，",
    "voice": "vo_adv_5120002_023",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就交給你們了！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身就坐在那裡表現出妾身的威嚴吧！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "！？",
    "voice": "vo_adv_5120002_024",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……這些玩笑先撇開不談。",
    "voice": "vo_adv_5120002_025",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "既然這是讓妾身完全復活的捷徑，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那也只能去做了。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "去把那些前來謁見妾身的傢伙",
    "voice": "vo_adv_5120002_026",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "都帶過來吧。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "是！",
    "voice": "vo_adv_5120002_027",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "我去將它們帶過來。",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "來看看，",
    "voice": "vo_adv_5120002_028",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "究竟會是些什麼樣的傢伙──",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼！？",
    "voice": "vo_adv_5120002_029",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "啊，",
    "voice": "vo_adv_5120002_030",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "失禮了。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "\\n不小心就順著習性大聲吼叫了……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "原來那是習性啊……",
    "voice": "vo_adv_5120002_031",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "伊莉亞‧奧恩斯坦大人。",
    "voice": "vo_adv_5120002_032",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "\\n此次恭喜您復活。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "\\n能拜見您的尊容，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "真是我的榮幸……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯。",
    "voice": "vo_adv_5120002_033",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不需要那麼拘謹，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "抬起頭來吧。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "真、",
    "voice": "vo_adv_5120002_034",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "真不愧是流傳於傳說之中的吸血鬼大人……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "\\n連對我等這些區區的魔物都如此寬宏大量……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "今日",
    "voice": "vo_adv_5120002_035",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "我帶來了我等一族要獻給伊莉亞大人的貢品。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "貢品啊。",
    "voice": "vo_adv_5120002_036",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯嗯，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "很有心啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "請您收下這個。",
    "voice": "vo_adv_5120002_037",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "\\n這是我等一族培育出的",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "最高級──",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "──大蒜。",
    "voice": "vo_adv_5120002_038",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "大蒜！？",
    "voice": "vo_adv_5120002_039",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "……請問怎麼了嗎？",
    "voice": "vo_adv_5120002_040",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呃、",
    "voice": "vo_adv_5120002_041",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呃……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那個，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦？",
    "voice": "vo_adv_5120002_042",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n話說回來，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我記得大蒜好像是吸血鬼的弱點吧？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哦哦，",
    "voice": "vo_adv_5120002_043",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雪說得很好！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "畢竟妾身沒辦法直接親口說出自己不喜歡呢，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雪啊，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就照這個樣子婉轉地告訴它吧……！　",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "不，",
    "voice": "vo_adv_5120002_044",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "並不是那麼回事。",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "如果只是普通的吸血鬼，或許是那樣沒錯。",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n但是傳說的吸血鬼",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "是不存在弱點的。",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "咦？",
    "voice": "vo_adv_5120002_045",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "是的，",
    "voice": "vo_adv_5120002_046",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "根據魔族之間流傳的消息，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "據說",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "\\n傳說的吸血鬼",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "「愛吃本應是弱點的大蒜，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "\\n而且還是生吃」。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "究竟是誰",
    "voice": "vo_adv_5120002_047",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "散布那種謠言的！？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "莫非伊莉亞大人……",
    "voice": "vo_adv_5120002_048",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "您怕大蒜……？",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "咦？",
    "voice": "vo_adv_5120002_049",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n啊，不是……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "才沒有那回事、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喔……？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如果在這裡被它們討厭，",
    "voice": "vo_adv_5120002_050",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不僅會降低伊莉亞的地位，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "名聲一落千丈，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還會毀了讓傳說復活的機會呀。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔唔唔……",
    "voice": "vo_adv_5120002_051",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身腦中的雪在對妾身低語……！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是個不管到哪都會讓人不得安寧的傢伙……！　",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦？",
    "voice": "vo_adv_5120002_052",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "伊莉亞怎麼了？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為什麼要瞪我……？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我什麼話都沒說耶……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如果在這裡拒絕，",
    "voice": "vo_adv_5120002_053",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "會有損妾身身為統御黑夜之人的威嚴……！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好吧，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只能做好覺悟了……！　",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是、",
    "voice": "vo_adv_5120002_054",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是啊……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是看起來好可口的大蒜……！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身就不……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "客氣了……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊，",
    "voice": "vo_adv_5120002_055",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你……！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "啊啊，",
    "voice": "vo_adv_5120002_056",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "你怎麼會做出這種事……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "{0}啊……",
    "voice": "vo_adv_5120002_057",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "竟然為了妾身……！　",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵，",
    "voice": "vo_adv_5120002_058",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "看來吾之眷屬也很喜歡啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這次的貢品",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是不錯。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身就",
    "voice": "vo_adv_5120002_059",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "認同你們為統御黑夜之人的",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "同胞吧……！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "是──！",
    "voice": "vo_adv_5120002_060",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "\\n不勝感激……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呼……",
    "voice": "vo_adv_5120002_061",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是的，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒想到偏偏是帶大蒜來。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "幸好想辦法熬過了。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這也是多虧妾身有優秀的眷屬！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈～哈──",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我說伊莉亞。",
    "voice": "vo_adv_5120002_062",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n魔物間流傳的是",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "傳說的吸血鬼喜歡大蒜對吧？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這樣的話，",
    "voice": "vo_adv_5120002_063",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "之後的貢品應該也都會是大蒜吧？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊──",
    "voice": "vo_adv_5120002_064",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "傳說的吸血鬼大人，",
    "voice": "vo_adv_5120002_065",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "恭喜您復活！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "\\n請您看看",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "我等種族引以為傲的特大大蒜！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物３",
    "words": "這是",
    "voice": "vo_adv_5120002_066",
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "魔物３",
    "words": "獻給您的貢品，炒大蒜！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "魔物4",
    "words": "請收下我們",
    "voice": "vo_adv_5120002_067",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物4",
    "words": "徹夜縫製的大蒜圖案禮服！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物5",
    "words": "請收下有大蒜香氣的抱枕──",
    "voice": "vo_adv_5120002_068",
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "──這是地獄啊！",
    "voice": "vo_adv_5120002_069",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這與其說是謁見，",
    "voice": "vo_adv_5120002_070",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n不如說已經變成像是",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "「送大蒜給傳說的吸血鬼會」了。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "傳說……",
    "voice": "vo_adv_5120002_071",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這傳說的流傳方式太奇怪了……！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "究竟是怎麼傳，才會傳成那樣的內容啊……！？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "……咳咳。",
    "voice": "vo_adv_5120002_072",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "伊莉亞大人，",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "下面的來客還在等──",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "嗨，",
    "voice": "vo_adv_5120002_073",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "打擾啦……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "哦，",
    "voice": "vo_adv_5120002_074",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "妳就是傳說的吸血鬼啊。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "\\n什麼啊，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "還以為會是怎麼樣的怪物，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "\\n結果這不是和人類沒兩樣嗎……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "感覺來了個很好懂的傢伙呢。",
    "voice": "vo_adv_5120002_075",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過我是分不出它和其他魔物有什麼不同就是了。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊～",
    "voice": "vo_adv_5120002_076",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你就是那個吧？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "聽到傳說的吸血鬼復活的傳聞，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "所以企圖打倒妾身，來藉此宣揚自己的名聲吧？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "真是佩服，",
    "voice": "vo_adv_5120002_077",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "本大爺的野心",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "也全都被妳看透了啊！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "\\n",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "本大爺",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "就是來終結那個什麼傳說的！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "光是沒帶大蒜來，就令人感到療癒了。",
    "voice": "vo_adv_5120002_078",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "為、",
    "voice": "vo_adv_5120002_079",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "為什麼會感到療癒！？",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那還用說？",
    "voice": "vo_adv_5120002_080",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "客人專程來這一趟，當然要好好招待了。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就讓它見識見識",
    "voice": "vo_adv_5120002_081",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "統御黑夜之人的力量吧……！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳其實只是想宣洩",
    "voice": "vo_adv_5120002_082",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "對大蒜的仇吧？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "哼，",
    "voice": "vo_adv_5120002_083",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "雖然不太懂怎麼了，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "\\n但這可以當成是妳接受挑戰了吧！？",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好。",
    "voice": "vo_adv_5120002_084",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "──就稍微陪你玩玩吧。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "……！",
    "voice": "vo_adv_5120002_085",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "\\n好驚人的氣魄……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "真是佩服……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "\\n哦哦，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "我得注意保持距離才行啊……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哼，",
    "voice": "vo_adv_5120002_086",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "長得那麼高大，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "個性倒是挺膽小的啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "那當然，",
    "voice": "vo_adv_5120002_087",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "我可是知道的喔。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "\\n傳說的吸血鬼",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "可以將脖子伸長到很驚人的距離來吸血對吧？",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "\\n",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "聽說甚至能遠遠伸到那掛在天空上的月亮啊！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……嗯？",
    "voice": "vo_adv_5120002_088",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "而且",
    "voice": "vo_adv_5120002_089",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "眼睛還會射出將一切燃燒殆盡的奇怪光線，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "\\n口中可以吐出能腐蝕任何東西的氣息對吧！？",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "\\n我怎麼可能會隨便接近妳……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哇～",
    "voice": "vo_adv_5120002_090",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "伊莉亞好厲害～！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我也稍微離遠一點好了。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "慢著，雪，",
    "voice": "vo_adv_5120002_091",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身可做不到那種事啊！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "而且眷屬啊，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你為什麼要雙眼充滿期待地看著妾身！？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喂，你這傢伙！",
    "voice": "vo_adv_5120002_092",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n是在哪裡知道那種傳說的！？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "咦？",
    "voice": "vo_adv_5120002_093",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "就是鎮上賣的",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "\\n《詳解傳說的吸血鬼》這本書上寫的啊？",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "\\n……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "妳看，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "看似兇惡的魔物",
    "words": "就是這本。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "……！",
    "voice": "vo_adv_5120002_094",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "拿來給妾身看看！",
    "voice": "vo_adv_5120002_095",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "上面寫了什麼？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n「傳說的吸血鬼幾乎已克服了任何弱點，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n會用白木樁蓋房子，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在太陽底下跳踢踏舞……」",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這什麼鬼啊！？",
    "voice": "vo_adv_5120002_096",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "究竟是誰寫出這種東西的……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "哦哦，伊莉亞大人！",
    "voice": "vo_adv_5120002_097",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "這麼說來，",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "今天天氣很好，要不要外出散步──",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "──作者，",
    "voice": "vo_adv_5120002_098",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "布拉德。",
    "voice": null,
