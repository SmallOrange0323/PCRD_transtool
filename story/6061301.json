  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "舞會啊，",
    "voice": "vo_adv_6061301_000",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "對千金小姐們來說，是她們所嚮往的舞台，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n卻不是我的風格。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我最不擅長應付這種場合了。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "什麼，",
    "voice": "vo_adv_6061301_001",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "連你也對舞會有興趣？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你只是想跟我一起跳舞……？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那、",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那就沒辦法了，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我會好好考慮一下的。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你、",
    "voice": "vo_adv_6061301_002",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你在說什麼啊……！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "像我這種人對於舞會什麼的……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呃，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "穿上這樣的洋裝根本毫無說服力……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是啊！",
    "voice": "vo_adv_6061301_003",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "力量與力量之間的碰撞！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "很令人熱血沸騰！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……不過，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這裡的貴族好像不喜歡這種的，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這方面就",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "讓我在工作上盡情發揮吧。",
    "voice": null,
    "unit_id": 115911
  }
]
