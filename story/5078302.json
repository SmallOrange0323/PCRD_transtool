  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n你們也只能囂張到現在了！",
    "voice": null,
    "unit_id": 15312
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n我就用更強大的黑暗力量",
