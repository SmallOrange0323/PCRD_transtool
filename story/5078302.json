    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "是我們最心愛的地方！",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "我們會齊心合力，",
    "voice": "vo_adv_5078302_008",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "拿下勝利讓你瞧瞧！",
