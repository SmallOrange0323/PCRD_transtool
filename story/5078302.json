    "unit_id": 15312
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "你就算變得再強大，",
    "voice": "vo_adv_5078302_006",
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "我們也不會輕言放棄！",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "這個蘭德索爾",
