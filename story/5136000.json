    "type": "dialogue",
    "name": "涅比亞",
    "words": "「這個世界」檢測到異常的證據。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "也就是說……",
    "voice": "vo_adv_5136000_101",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "──是「警告」喔。",
    "voice": "vo_adv_5136000_102",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n來自《阿斯特朗傳奇》的警告。",
