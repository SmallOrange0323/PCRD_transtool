  {
    "type": "dialogue",
    "name": "旁白",
    "words": "厄莉絲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在錯綜複雜的念頭和因果的交織之下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n誕生於「阿斯特朗傳奇」的存在，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n最後成了「一切的元兇」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "513600002"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "513600003"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "另一個人，\\n「草野優衣」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "501200"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "…………",
    "voice": "vo_adv_5136000_000",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在與厄莉絲戰鬥後，經過了一段時間……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n優衣隻身前往精靈族之村修行。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "…………呼。",
    "voice": "vo_adv_5136000_001",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n就練到這裡吧。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "村裡的女性",
    "words": "唉呀，",
    "voice": "vo_adv_5136000_002",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "村裡的女性",
    "words": "優衣小姐。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "村裡的女性",
    "words": "\\n妳好。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "村裡的女性",
    "words": "\\n妳在冥想嗎？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "妳好。",
    "voice": "vo_adv_5136000_003",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "現在正好結束了。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "因為我要準備回蘭德索爾，",
    "voice": "vo_adv_5136000_004",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n還想跟村裡的各位道別。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "村裡的女性",
    "words": "這麼說來妳回蘭德索爾的日子，",
    "voice": "vo_adv_5136000_005",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "村裡的女性",
    "words": "就是今天呢。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "村裡的女性",
    "words": "\\n時間真是一眨眼就過了……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "村裡的女性",
    "words": "請妳一定",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "村裡的女性",
    "words": "要再來玩喔。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "村裡的女性",
    "words": "\\n村裡的每個人",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "村裡的女性",
    "words": "都會歡迎妳的。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝謝妳。",
    "voice": "vo_adv_5136000_006",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我一定",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "會再來的。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "background",
    "bg_id": "500180"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與此同時。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "約定好要去接優衣的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}暫時從背面世界返回，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正與怜跟日和一同前往精靈族之村。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哼哼哼～♪",
    "voice": "vo_adv_5136000_007",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n真想趕快見到優衣呢～♪",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日和。",
    "voice": "vo_adv_5136000_008",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n離得太遠會很危險喔。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n要是突然有魔物衝出來就糟了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊，",
    "voice": "vo_adv_5136000_009",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對喔！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一想到能見到好久不見的優衣，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不小心就……！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嘿嘿……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我明白妳的心情。",
    "voice": "vo_adv_5136000_010",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這幾個禮拜以來，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣和我們都很專心地在修行。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們過去從來沒有這麼久",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "都沒見到面呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊，",
    "voice": "vo_adv_5136000_011",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是這樣啊！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "所以才會覺得過了非常久吧！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "{0}。\\n你也沒有去見她對吧？",
    "voice": "vo_adv_5136000_012",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不過，",
    "voice": "vo_adv_5136000_013",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那時大家都嚇了一跳吧？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n當優衣說她想去精靈族之村修行的時候。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n而且還是要一個人去。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "雖然我沒有詳細地問……",
    "voice": "vo_adv_5136000_014",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n但她之所以這麼做，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "果然是因為厄莉絲吧。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……恐怕是吧。",
    "voice": "vo_adv_5136000_015",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這樣想感覺是最合理的。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "當時──",
    "voice": "vo_adv_5136000_016",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "打倒終炎巨神，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要前往索爾之塔塔頂的時候。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我們和優衣分開了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……嗯。",
    "voice": "vo_adv_5136000_017",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n變成優衣和厄莉絲獨處了吧。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "然後……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "當我們趕到時……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……厄莉絲，",
    "voice": "vo_adv_5136000_018",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "已經消失了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我能理解優衣因為那件事，",
    "voice": "vo_adv_5136000_019",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而想要變強的心情。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……就連現在，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "她肯定也對厄莉絲的事感到很後悔。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……包含我也是。",
    "voice": "vo_adv_5136000_020",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "別說拯救厄莉絲了，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我連幫助受傷的優衣都做不到。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "在關鍵時刻卻沒辦法待在她身邊。",
    "voice": "vo_adv_5136000_021",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我們明明是夥伴的……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒有比這更窩囊的事了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……我的想法，",
    "voice": "vo_adv_5136000_022",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也是一樣的。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "當時一定有我們能做到的事。",
    "voice": "vo_adv_5136000_023",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n一定有我們能更努力達成的事才對……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可是……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我什麼都，",
    "voice": "vo_adv_5136000_024",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "辦不到……！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生……",
    "voice": "vo_adv_5136000_025",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和、怜",
    "words": "…………",
    "voice": "vo_adv_5136000_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……",
    "voice": "vo_adv_5136000_027",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……能聽到你這麼說真是太好了。",
    "voice": "vo_adv_5136000_028",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "background",
    "bg_id": "501220"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊！",
    "voice": "vo_adv_5136000_029",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n各位～！",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "日和、怜",
    "words": "優衣！\\n優衣！",
    "voice": "vo_adv_5136000_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "大家，",
    "voice": "vo_adv_5136000_031",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好久不見了。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n謝謝你們來接我！",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "當然要來接妳囉～！",
    "voice": "vo_adv_5136000_032",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n妳看起來過得很好，太好了♪",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呵呵♪",
    "voice": "vo_adv_5136000_033",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生你……",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "也過得好嗎？",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣，",
    "voice": "vo_adv_5136000_034",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳修行得如何了？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我感覺比以前更能夠",
    "voice": "vo_adv_5136000_035",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "分辨精靈的模樣囉。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "村民們也對我很好喔。",
    "voice": "vo_adv_5136000_036",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不光是幫助我修行，",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n甚至還讓我閱讀了好多文獻。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "文獻啊……",
    "voice": "vo_adv_5136000_037",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那的確是在蘭德索爾讀不到的呢，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n得來精靈族之村才行。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "多虧這樣我學到了很多喔。",
    "voice": "vo_adv_5136000_038",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "包括精靈的事、大自然的事，",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "還有瑪那的事。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "當然，",
    "voice": "vo_adv_5136000_039",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我的知識量肯定比不上",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "精靈族之村的村民或可可蘿……",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但跟以前的我比起來，",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "現在知道得更詳細了。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原來如此……",
    "voice": "vo_adv_5136000_040",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳學到了更深入的內容了啊。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "精靈的存在和其擁有的力量，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "既有很多不明之處又很複雜。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我明白妳為什麼要待在這裡這麼久了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這的確是修行呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗚嗚……",
    "voice": "vo_adv_5136000_041",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n對我來說是有點累人的修行呢～",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "發抖發抖發抖……！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵，",
    "voice": "vo_adv_5136000_042",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也是啊。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果是修行的話，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無論如何都會想活動身體。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "各位，",
    "voice": "vo_adv_5136000_043",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝謝你們。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n願意聽我這麼任性的請求。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不過少了一人……",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "公會的委託",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是不是變得很難接？",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "其實啊！",
    "voice": "vo_adv_5136000_044",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們也進行了修行喔！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n就在妳待在精靈族之村的這段期間裡♪",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是、",
    "voice": "vo_adv_5136000_045",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "夥伴在修行的時候，",
    "voice": "vo_adv_5136000_046",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我們怎麼能悠哉度日呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "剛好前一陣子，",
    "voice": "vo_adv_5136000_047",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不是設立了冒險者用的訓練所嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "所以我們兩個就去參加了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n無論是冒險者",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "或是觀眾都有好～多好多人！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "由於是國家設施",
    "voice": "vo_adv_5136000_048",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "所以設備很齊全，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n參加者的水準也很高。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是很適合試試身手的地方。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……這樣啊。",
    "voice": "vo_adv_5136000_049",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n妳們也去修行了呢。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "總覺得好開心♪",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那樣的話，",
    "voice": "vo_adv_5136000_050",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "該不會……",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n騎士先生所說的「背面世界」，",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "妳們也都還沒去嗎？",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這還用說嗎！",
    "voice": "vo_adv_5136000_051",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怎麼能丟下優衣",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就跑去冒險呢！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊！",
    "voice": "vo_adv_5136000_052",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我不是那個意思啦！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "抱歉喔，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵，",
    "voice": "vo_adv_5136000_053",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們很清楚你的情況。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n所以別在意。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生……",
    "voice": "vo_adv_5136000_054",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "當時沒辦法馬上前往「背面世界」，",
    "voice": "vo_adv_5136000_055",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真抱歉。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n難得",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你特地邀請我們。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "只是……",
    "voice": "vo_adv_5136000_056",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n在出發去冒險之前，",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我想先好好學習。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "為了能夠",
    "voice": "vo_adv_5136000_057",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "確實幫上大家的忙。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我想找出只有我",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "能做到的事。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……而這一點，",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "肯定很難一邊冒險",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "一邊進行……",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然在旅途中的訓練也很重要，",
    "voice": "vo_adv_5136000_058",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但是沉下心來",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好好地鍛鍊自己，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也是同等重要的事。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就是這麼回事吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好～！",
    "voice": "vo_adv_5136000_059",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們馬上回蘭德索爾去吧！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "接下來的冒險要去哪，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就等那之後再思考！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣、怜",
    "words": "嗯！",
    "voice": "vo_adv_5136000_060",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……但是，",
    "voice": "vo_adv_5136000_061",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣真的可以嗎？",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我想要……",
    "voice": "vo_adv_5136000_062",
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "去冒險。",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 115611
  },
  {
    "type": "dialogue",
    "name": "優衣",
