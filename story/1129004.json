    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哇～\\n這蛋糕看起來好好吃喔……☆",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……咦？",
    "voice": "vo_adv_1129004_042",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n你說我從小就是愛吃鬼？",
