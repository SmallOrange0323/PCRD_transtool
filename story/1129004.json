  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好～",
    "voice": "vo_adv_1129004_027",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "專心專心──",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "──啊！",
    "voice": "vo_adv_1129004_028",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你記得這個繪本嗎",
