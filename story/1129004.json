    "name": "愛梅斯",
    "words": "哥哥，辛苦你了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "有個可愛的妹妹很不得了吧？",
