  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "馬上就變得很愛睏，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n從來沒有把繪本聽到最後過呢～",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過哥哥也有錯喔！",
    "voice": "vo_adv_1129004_035",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "每次都一邊讀",
