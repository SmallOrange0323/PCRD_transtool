  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "從集訓返家的幾天後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "牧場周圍也沒有任何異狀。",
    "voice": "vo_adv_5116007_000",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這樣就",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "巡過一輪了呢。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "栞栞，",
    "voice": "vo_adv_5116007_001",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "辛苦啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n雖然時間有點早，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過要不要來吃午餐？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，",
    "voice": "vo_adv_5116007_002",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "已經到這個時間了啊。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "嘎嚕嚕……",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "喵特也辛苦啦。",
    "voice": "vo_adv_5116007_003",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……我說，",
    "voice": "vo_adv_5116007_004",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "栞栞。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我很感謝妳留下來……",
    "voice": "vo_adv_5116007_005",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳沒必要跟我們客氣喔。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "客氣……",
    "voice": "vo_adv_5116007_006",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "妳",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "在說什麼啊？",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "聽說",
    "voice": "vo_adv_5116007_007",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "只要持有遊俠資格，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n對於獵人體系的公會來說是很搶手的啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "比起待在像我這樣貧窮的公會裡，",
    "voice": "vo_adv_5116007_008",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n不如去那裡的待遇也比較好……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真陽……",
    "voice": "vo_adv_5116007_009",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那個……",
    "voice": "vo_adv_5116007_010",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "為了栞栞著想的話，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "去其他公會會比待在我這裡好吧。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……其實，",
    "voice": "vo_adv_5116007_011",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "當我拿到證書的時候有受到邀請，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n問我說要不要加入獵人公會成為正式的遊俠。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "既然這樣，",
    "voice": "vo_adv_5116007_012",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "為什麼……？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為──",
    "voice": "vo_adv_5116007_013",
    "unit_id": 103813
  },
  {
    "type": "background",
    "bg_id": "500371"
  },
  {
    "type": "dialogue",
    "name": "集訓櫃台人員",
    "words": "──那麼，",
    "voice": "vo_adv_5116007_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "集訓櫃台人員",
    "words": "通過最終測驗的所有人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "集訓櫃台人員",
    "words": "\\n請收下證書。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這就是",
    "voice": "vo_adv_5116007_015",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "遊俠資格的證書……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是啊，",
    "voice": "vo_adv_5116007_016",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也非常努力了。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "栞小姐，",
    "voice": "vo_adv_5116007_017",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝您。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "相信並守候主人……",
    "voice": "vo_adv_5116007_018",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您讓在下",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在這場集訓中",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "學到了，",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也有那樣子的強韌意志。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "哪裡，",
    "voice": "vo_adv_5116007_019",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我才是",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "受到了可可蘿和",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n{0}",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "很多的幫助……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "集訓櫃台人員",
    "words": "栞小姐、",
    "voice": "vo_adv_5116007_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "集訓櫃台人員",
    "words": "可可蘿小姐，請確認遊俠動物登記證",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "集訓櫃台人員",
    "words": "\\n上面的資料",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "集訓櫃台人員",
    "words": "是否有缺漏。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，",
    "voice": "vo_adv_5116007_021",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我看看，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "只要寫我的名字",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "和所屬公會──",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "嗨，",
    "voice": "vo_adv_5116007_022",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "恭喜你們通過了。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n幸好你們還沒回去。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "教官先生，",
    "voice": "vo_adv_5116007_023",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感謝您",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如此貼心。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您是為了祝賀",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "才特地過來的嗎？",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "呃，",
    "voice": "vo_adv_5116007_024",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "我真的是誠心祝賀各位啦……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "不過我找你們是有別的事情。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "我就直話直說了……",
    "voice": "vo_adv_5116007_025",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n你們三個",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "有沒有打算加入獵人公會？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這是",
    "voice": "vo_adv_5116007_026",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "在邀我們……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "轉移公會會籍嗎？",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "嗯，",
    "voice": "vo_adv_5116007_027",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "你們要這麼想也無所謂。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "在集訓中見到你們，",
    "voice": "vo_adv_5116007_028",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "我就一直在注意了。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "畢竟有人強烈推薦你們啊。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "集訓營地的醫生",
    "words": "……是我推薦的，",
    "voice": "vo_adv_5116007_029",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "集訓營地的醫生",
    "words": "\\n",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "集訓營地的醫生",
    "words": "我很希望跟你們一起工作。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "集訓營地的醫生",
    "words": "解決這次事情的俐落手腕，",
    "voice": "vo_adv_5116007_030",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "集訓營地的醫生",
    "words": "\\n",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "集訓營地的醫生",
    "words": "以及",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "集訓營地的醫生",
    "words": "身為遊俠的資質……",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "集訓營地的醫生",
    "words": "最重要的是，",
    "voice": "vo_adv_5116007_031",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "集訓營地的醫生",
    "words": "你們想保護包含了魔物和動物生態系的意志。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "集訓營地的醫生",
    "words": "\\n你們可以",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "集訓營地的醫生",
    "words": "當作",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "集訓營地的醫生",
    "words": "我是看中這些才來挖角的。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "我們每年",
    "voice": "vo_adv_5116007_032",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "都會從合格者之中",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "去找我們認為「",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "就是他！」",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "這樣的人聊聊。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n只要願意轉會籍，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "我們可以提供比大部分公會還優渥的條件。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "別看我們這樣，",
    "voice": "vo_adv_5116007_033",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "我們可是深受高層信賴的公會喔。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "畢竟",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "我們可是有在頒發遊俠的公認執照啊。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "怎麼樣？",
    "voice": "vo_adv_5116007_034",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "我覺得條件不差喔。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "若有其他需求，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "條件的部分也能協議──",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對不起。",
    "voice": "vo_adv_5116007_035",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "很高興能受到賞識，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但我無法答應。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "當機立斷也是遊俠的必要資質，",
    "voice": "vo_adv_5116007_036",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "不過",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "能讓我問一下理由嗎？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我會參加這場集訓……",
    "voice": "vo_adv_5116007_037",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是因為我想為了支持我的人，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n增加自己的能力。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "搞不好我",
    "voice": "vo_adv_5116007_038",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "轉移會籍……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "去賺很多錢，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "然後寄錢給他們，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "從大家的生活層面來看，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "或許會比較好吧。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "他們不僅生活無法過得很奢侈，",
    "voice": "vo_adv_5116007_039",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n身上也不是說有很多錢，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "還有很多",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "辛苦的事。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但是，",
    "voice": "vo_adv_5116007_040",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "想待在他們身邊，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我想跟大家在一起。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對於只要有一點點小小幸福就能滿足的我……",
    "voice": "vo_adv_5116007_041",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我想跟那些",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "給予我無數溫暖的人一起。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常不好意思……",
    "voice": "vo_adv_5116007_042",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n恕在下",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "婉拒您的邀約。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下的職責是",
    "voice": "vo_adv_5116007_043",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "給予主人指引，",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並支持著主人。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人的所在之處",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是在下的棲身之地。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "這樣啊，",
    "voice": "vo_adv_5116007_044",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "所以，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "我猜你也是……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "對吧？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "雖然沒必要跟我道歉……",
    "voice": "vo_adv_5116007_045",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "但是被那樣真誠的眼神看著讓人很不好意思呢。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "我知道了，",
    "voice": "vo_adv_5116007_046",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "就放棄邀請你們轉移公會會籍吧。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "不過，",
    "voice": "vo_adv_5116007_047",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "可以說是相對的嗎……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "要是我們委託工作給你們的話沒有問題吧？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "工作……",
    "voice": "vo_adv_5116007_048",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "委託",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們嗎？",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "當然只是",
    "voice": "vo_adv_5116007_049",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "單純的工作委託。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n平常你們可以優先處理自己公會的活動。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n……這個條件你們覺得如何？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯，",
    "voice": "vo_adv_5116007_050",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "能幫的話我們很樂意幫。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "background",
    "bg_id": "500150"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……事情就是這樣。",
    "voice": "vo_adv_5116007_051",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為我的歸宿",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "果然還是這裡呢。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "栞栞……",
    "voice": "vo_adv_5116007_052",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……這樣啊，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我明白了。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "栞栞都那樣說了，",
    "voice": "vo_adv_5116007_053",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那我",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "也不會再多說什麼啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳想待就盡情待在這裡吧！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "現在是因為栞栞有回來我才敢說，",
    "voice": "vo_adv_5116007_054",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "當初聽到妳說要去集訓時，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我心裡可是擔心得不得了的啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我想說",
    "voice": "vo_adv_5116007_055",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳終於厭倦我了嗎……！？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "難道，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這就是所謂的離婚嗎？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真、",
    "voice": "vo_adv_5116007_056",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真陽，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "妳是這樣看待我的嗎？",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我怎麼可能",
    "voice": "vo_adv_5116007_057",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "會那樣想呢……！",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我不知道有多麼感謝",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真陽",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "還有大家呢……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "栞、",
    "voice": "vo_adv_5116007_058",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "栞栞也沒資格說別人啦？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我有說過根本不需要",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n去在意",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "喵特的飯錢啊！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真陽，",
    "voice": "vo_adv_5116007_059",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "妳真是的……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……呵呵，",
    "voice": "vo_adv_5116007_060",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊哈哈哈♪",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵……",
    "voice": "vo_adv_5116007_061",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "果然",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "光用想的是無法讓對方知道呢。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是啊。",
    "voice": "vo_adv_5116007_062",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "說相聲也是一樣的啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n裝傻和吐嘈要讓對方了解，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "必須更簡單易懂才行呢。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這個聲音是……！",
    "voice": "vo_adv_5116007_063",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "聽起來",
    "voice": "vo_adv_5116007_064",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好像鈴鐺聲呢。",
