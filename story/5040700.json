[
  {
    "type": "background",
    "bg_id": "500997"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "正當【伊麗莎白牧場】的成員們忙著做牧場溫泉",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n的開張準備時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n似乎遇到了什麼問題而傷透腦筋。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯～",
    "voice": "vo_adv_5040700_000",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真傷腦筋啊。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "該怎麼辦才好呢。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "如果我再",
    "voice": "vo_adv_5040700_001",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "多努力一點……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "可是現在",
    "voice": "vo_adv_5040700_002",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "需要小栞再多做一點傳單才行啊。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我會盡快把工作做完的，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "交給我來吧。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "大家怎麼一臉煩惱的樣子啊，",
    "voice": "vo_adv_5040700_003",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "怎麼了？　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "發生了什麼事嗎？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "鈴鈴！　",
    "voice": "vo_adv_5040700_004",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳來得正好！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "什、",
    "voice": "vo_adv_5040700_005",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "什麼什麼？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n如果是麻煩事的話我可不要喔？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這樣啊……",
    "voice": "vo_adv_5040700_006",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "看來還是得靠我們幾個想想辦法了。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是啊。",
    "voice": "vo_adv_5040700_007",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n畢竟鈴天天發傳單應該也累了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊～真是的！　",
    "voice": "vo_adv_5040700_008",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "到底是怎樣啦！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n妳們不說我怎麼知道是怎麼回事！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "先說說看嘛！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是嗎？　",
    "voice": "vo_adv_5040700_009",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就是啊，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我們在整理倉庫的時候",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n找到了熟成過的起司，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好像可以拿來當成給客人的伴手禮。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "可是起司的香味",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也吸引了很多老鼠過來。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以得要有個人在這裡看守以防起司被老鼠吃掉。",
    "voice": "vo_adv_5040700_010",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但我們幾個",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "手邊都有工作抽不開身。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊～",
    "voice": "vo_adv_5040700_011",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我的確",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "因為傳單發完了，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "所以正無事可做。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "鈴鈴，",
    "voice": "vo_adv_5040700_012",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然我知道妳應該也很累了，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過妳能不能",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "幫忙看守起司呢？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "…………",
    "voice": "vo_adv_5040700_013",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果妳真的很累的話",
    "voice": "vo_adv_5040700_014",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不用勉強沒關係！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "看守的工作也不輕鬆嘛！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對啊。",
    "voice": "vo_adv_5040700_015",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我只有做做傳單而已，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "還是讓我來看守……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "妳們不用那麼顧慮我沒關係啦。",
    "voice": "vo_adv_5040700_016",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我來做吧，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我來看守起司。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真的可以嗎！？",
    "voice": "vo_adv_5040700_017",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯。",
    "voice": "vo_adv_5040700_018",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖說是警衛，不過對手是老鼠吧？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這根本不算什麼啦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真的可以嗎？",
    "voice": "vo_adv_5040700_019",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n妳不用勉強喔？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就是說啊。",
    "voice": "vo_adv_5040700_020",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n鈴妳一直",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "走來走去應該也累了吧。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我沒事的！　",
    "voice": "vo_adv_5040700_021",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖說這工作的確很麻煩，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n不過畢竟我們人手不足，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "能做的事我還是會去做的！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這件事就交給我！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "妳們去忙自己的工作吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "鈴鈴，",
    "voice": "vo_adv_5040700_022",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真的很謝謝妳。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "等工作告一段落我們也會來幫忙！",
    "voice": "vo_adv_5040700_023",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以不用勉強也沒關係喔。",
    "voice": "vo_adv_5040700_024",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "…………妳們幾個",
    "voice": "vo_adv_5040700_025",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "到底是怎麼看我的啊。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還是很感謝妳們願意幫忙啦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那就先這樣囉～鈴鈴。",
    "voice": "vo_adv_5040700_026",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n起司就交給妳啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好好好。",
    "voice": "vo_adv_5040700_027",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "妳們就放一百二十個心吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過就是起司而已，就由我來保護吧。",
    "voice": null,
    "unit_id": 102611
  }
]
