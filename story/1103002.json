  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "解決了走失的問題，\\n咲戀與{0}在海灘上放鬆。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好了，",
    "voice": "vo_adv_1103002_000",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要做些什麼呢……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n不好不好。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "把重要的事情給忘了。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我記得包包裡……",
    "voice": "vo_adv_1103002_001",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有了。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這個這個。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "很在意這個小瓶子嗎？",
    "voice": "vo_adv_1103002_002",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這個",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "叫做『防曬油』，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是有防曬效果的乳液。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n不過還是試作品。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "之前鈴莓",
    "voice": "vo_adv_1103002_003",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "在海之家打工時，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有說過曬傷的肌膚刺刺的很痛",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對吧？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我一直有在想。",
    "voice": "vo_adv_1103002_004",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "如果有比市面上的防曬用品",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n效果更好的東西就好了。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "因此，",
    "voice": "vo_adv_1103002_005",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我便到處尋找能夠預防曬傷的藥草，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n經過調合的結果",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就是這個了。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "難得來到海邊了，",
    "voice": "vo_adv_1103002_006",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "得試試看才行呢。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "如果能證實效果，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這也能是",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "一筆不錯的生意吧？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就是這麼回事，",
    "voice": "vo_adv_1103002_007",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "首先從手開始……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "比想像中",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "更冰涼呢。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是因為藥草的成分吧。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "全身也都要塗到……",
    "voice": "vo_adv_1103002_008",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "感覺不錯。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "再來是――",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "吶，{0}。",
    "voice": "vo_adv_1103002_009",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n你可以",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "用這防曬油",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "幫我塗背後嗎？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "謝謝。",
    "voice": "vo_adv_1103002_010",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那就",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "麻煩你了。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嘿咻……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "still",
    "still_id": "110300201"
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我想你應該知道，",
    "voice": "vo_adv_1103002_011",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "如果敢碰奇怪的地方，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我可不會輕易放過你喔？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我會不會太信任他了？",
    "voice": "vo_adv_1103002_012",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要這人潮混雜之中",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "尋找鈴莓",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也很不容易。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "而且，",
    "voice": "vo_adv_1103002_013",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "{0}這傢伙也不可能會做出奇怪的舉動吧。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……啊啊，",
    "voice": "vo_adv_1103002_014",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是這樣啊。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對{0}",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "感到放心啊……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯……！　",
    "voice": "vo_adv_1103002_015",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊、",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對不起，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我只是覺得很癢。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n對對，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就是這個感覺，麻煩你了。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要避免有地方漏掉，",
    "voice": "vo_adv_1103002_016",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "每個地方都要塗到喔……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "感覺就好像",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "變成女王了呢。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "still",
    "still_id": "110300202"
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呀！？\\n喂、",
    "voice": "vo_adv_1103002_017",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "喂！",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "誰說你可以把",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n手伸到泳裝底下的啊！？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "咦？　",
    "voice": "vo_adv_1103002_018",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "因為那是沒塗到的地方？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那麼說是沒錯……",
    "voice": "vo_adv_1103002_019",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呀！？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真、",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真是的，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "害人家發出怪聲音了啦！",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "把手指伸進女孩子的泳裝是怎麼一回事，",
    "voice": "vo_adv_1103002_020",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n你好歹也注意一下吧？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呀啊啊！？",
    "voice": "vo_adv_1103002_021",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "笨、",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "笨蛋，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你又伸進來了啦！？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "咦？　",
    "voice": "vo_adv_1103002_022",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "剛才只是手指滑掉了？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真是的，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "很容易讓人誤會耶！",
    "voice": null,
    "unit_id": 110311
  },
