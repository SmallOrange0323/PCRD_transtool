[
  {
    "type": "background",
    "bg_id": "501582"
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "對初夢許的願",
    "voice": "vo_adv_5134066_000",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就算能夠夢見想做的夢，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n但也不一定保證會實現吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過",
    "voice": "vo_adv_5134066_001",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這種事最重要的就是心意吧？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好了，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "問題是……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "該許願要結婚呢，",
    "voice": "vo_adv_5134066_002",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還是許願研究有進展呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就先試著自問自答看看吧……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "still",
    "still_id": "513406601"
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "深月，",
    "voice": "vo_adv_5134066_003",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "妳仔細想想。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "\\n人只要活在世上，就是孤獨的。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "所以放棄結婚吧，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "妳應該要將自己奉獻給科學研究。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "still",
    "still_id": "513406602"
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "不是那樣的深月，",
    "voice": "vo_adv_5134066_004",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "人生若只有研究可是會很空虛的。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "妳想想看往後歲數增加時的事。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "只有自己一個人的飯桌，",
    "voice": "vo_adv_5134066_005",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "\\n妳一定無法忍受的。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "still",
    "still_id": "513406603"
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "別被蠱惑了。",
    "voice": "vo_adv_5134066_006",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "只要透過研究",
    "voice": "vo_adv_5134066_007",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "確立了新的醫療技術，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "肯定能拯救眾多生命，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "而且還能獲得財富與名聲喔。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "still",
    "still_id": "513406604"
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "但卻沒有能分享那份喜悅的伴侶。",
    "voice": "vo_adv_5134066_008",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "而且我其實",
    "voice": "vo_adv_5134066_009",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "也不是為了財富跟名聲進行研究的。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "這只是對著無法結婚的這個現實",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "所說的藉口而已。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "still",
    "still_id": "513406605"
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "那不就是極度自罰",
    "voice": "vo_adv_5134066_010",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "又主觀的想法嗎？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "still",
    "still_id": "513406606"
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "說得好像在人生中的幸福",
    "voice": "vo_adv_5134066_011",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "就只有建立家庭而已，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "\\n這種說法",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "否定了其他形式的多樣性喔。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "still",
    "still_id": "513406607"
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "但是如果有機會結婚的話，",
    "voice": "vo_adv_5134066_012",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "\\n妳",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "早就結婚了吧？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "still",
    "still_id": "513406608"
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "妳不覺得那種正確論點",
    "voice": "vo_adv_5134066_013",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "\\n只會撕裂自己的心靈而已嗎？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "still",
    "still_id": "513406609"
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "就算不自己撕裂自己的心靈，",
    "voice": "vo_adv_5134066_014",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "\\n也早就因為定期收到熟人的結婚報告，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "而傷痕累累了。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "明白的話就不要賭氣，",
    "voice": "vo_adv_5134066_015",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "結婚派深月",
    "words": "\\n乖乖許願結婚……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "still",
    "still_id": "513406610"
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "慢著。",
    "voice": "vo_adv_5134066_016",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "\\n那樣就下結論還太早了。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "首先",
    "voice": "vo_adv_5134066_017",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "要再次定義幸福的本質，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "\\n之後",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "再依此",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "研究派深月",
    "words": "選擇結婚還是研究……",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "still",
    "still_id": "513406611"
  },
  {
    "type": "dialogue",
    "name": "腦海中的深月們",
    "words": "結婚……",
    "voice": "vo_adv_5134066_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "腦海中的深月們",
    "words": "研究……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "腦海中的深月們",
    "words": "結婚……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "腦海中的深月們",
    "words": "\\n研究……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "腦海中的深月們",
    "words": "結婚……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "腦海中的深月們",
    "words": "研究……！\\n結婚！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "腦海中的深月們",
    "words": "研究！結婚！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "腦海中的深月們",
    "words": "研究！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501580"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………",
    "voice": "vo_adv_5134066_019",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "進行了腦內會議，",
    "voice": "vo_adv_5134066_020",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "結果就整晚都沒睡……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n別說初夢了，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "整個精疲力盡，全身無力……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過，",
    "voice": "vo_adv_5134066_021",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這份迷惘",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也正是答案吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不管是研究還是結婚，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "對我來說都是同等重要的事。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就算只明白了這件事，",
    "voice": "vo_adv_5134066_022",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也是很有意義的吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這應該也會是度過這新的一年的參考呢♪",
    "voice": null,
    "unit_id": 105111
  }
]
