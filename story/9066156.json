    "name": "普蕾西亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "……呼。",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "總算是打倒了……",
    "voice": "vo_adv_9066156_001",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "還真是",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
