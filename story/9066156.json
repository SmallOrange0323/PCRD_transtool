    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……我們",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "還得更加努力才行。",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是啊……",
    "voice": "vo_adv_9066156_003",
