    "voice": "vo_adv_9066156_011",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您們不要緊嗎！？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n好像發生了戰鬥……",
    "voice": null,
    "unit_id": 105911
