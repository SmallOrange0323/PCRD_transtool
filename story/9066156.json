  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "但是。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n發現了一個",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "【美食殿堂】跟【幻變少女】的",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "共通點呢。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我們也是一樣，",
    "voice": "vo_adv_9066156_004",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "有著「能共同跨越困難的夥伴」。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n我再次切身體會到這件事了。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那也是多虧了",
    "voice": "vo_adv_9066156_005",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "有兩位一同煩惱、",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "一同努力。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n所以說，",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我們之後也一起加油吧。",
