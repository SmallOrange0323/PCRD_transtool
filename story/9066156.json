  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……為了總有一天",
    "voice": null,
    "unit_id": 125813
  },
