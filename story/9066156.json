    "words": "千鈞一髮呢。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "再次感受到",
    "voice": "vo_adv_9066156_002",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我們跟【美食殿堂】的差距了呢。",
