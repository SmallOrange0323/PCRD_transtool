    "type": "dialogue",
    "name": "莉莉",
    "words": "能夠成為一流的冒險者。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_9066156_006",
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n會加油。",
    "voice": null,
    "unit_id": 126113
