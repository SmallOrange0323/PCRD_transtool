[
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了貼身採訪望的假日，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}今天也和她一起在海邊散步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那",
    "voice": "vo_adv_1172002_000",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "今天也要麻煩你囉！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我的採訪員。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哼哼哼～♪",
    "voice": "vo_adv_1172002_001",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "問得好！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "今天呢……",
    "voice": "vo_adv_1172002_002",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "說到夏天，就少不了這個！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "海邊遊玩必備的行程，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也就是海灘運動～！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "主流的衝浪運動也不錯，",
    "voice": "vo_adv_1172002_003",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "以享受放假的時光來說，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n悠哉地搭乘遊艇也很好玩喔。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "另外",
    "voice": "vo_adv_1172002_004",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好像還有用潛水魔法遊覽海底的活動……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "選項太多了，真讓人苦惱呢～",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯？",
    "voice": "vo_adv_1172002_005",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這道聲音",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是什麼啊……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "在那邊！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿，",
    "voice": "vo_adv_1172002_006",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你看你看！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那是什麼啊？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n那個東西在海上咻～地奔跑著耶！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "而且速度還很快！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "它往碼頭的方向過去了呢。",
    "voice": "vo_adv_1172002_007",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n岸上好像也有擺出招牌。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊！",
    "voice": "vo_adv_1172002_008",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個人好像要上岸了。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們去問一下詳情吧！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不好意思～！",
    "voice": "vo_adv_1172002_009",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "啊，",
    "voice": "vo_adv_1172002_010",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "歡迎光臨。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n兩位客人",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "是來搭乘「高速小艇」的嗎？",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "高速小艇……？",
    "voice": "vo_adv_1172002_011",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "是新型態的海上娛樂喔。",
    "voice": "vo_adv_1172002_012",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n就是駕駛這艘小型船，",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "在海面上奔馳。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哦～",
    "voice": "vo_adv_1172002_013",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好像很有趣！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這會不會很難操縱？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "簡單啦",
    "voice": "vo_adv_1172002_014",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "簡單！",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "因為這東西的賣點就是簡單到連初學者都能開著到處跑啊。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "我們也有提供",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "能體驗一天的出租服務。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "對了，",
    "voice": "vo_adv_1172002_015",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "如果你們有興趣的話，",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n願不願意來當免費體驗員啊？",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "可能因為這是很新穎的海灘運動，",
    "voice": "vo_adv_1172002_016",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n知道的人不多，",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "所以完全沒有客人上門……",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "反正再這樣下去，",
    "voice": "vo_adv_1172002_017",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "店也是有開跟沒開一樣。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "為了招攬更多的顧客，",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "希望你們能多告訴我一些感想。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿，",
    "voice": "vo_adv_1172002_018",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們一起試試看吧。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "當第一個體驗的人，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這樣好像很有趣不是嗎？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就這麼決定！",
    "voice": "vo_adv_1172002_019",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那我們",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要兩個人一起搭！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "太好啦。",
    "voice": "vo_adv_1172002_020",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "那我就先從駕駛方法開始教起囉。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n如果兩個人一起搭乘──",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呃～",
    "voice": "vo_adv_1172002_021",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "扭轉這個就會加速……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這邊的握桿是減速……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": "vo_adv_1172002_022",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我知道操縱的方法了。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n那要出發囉。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們走～！！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "still",
    "still_id": "117200201"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊哈哈♪",
    "voice": "vo_adv_1172002_023",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "感覺會很舒暢耶！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿嘿，",
    "voice": "vo_adv_1172002_024",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就是說啊♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "會讓人有種",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好像真的能前往任何地方的感覺。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過，",
    "voice": "vo_adv_1172002_025",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這個明明這麼好玩，竟然都沒有客人上門。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n大家都去玩其他的海灘運動了嗎？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好可惜喔。",
    "voice": "vo_adv_1172002_026",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要是能讓大家知道有這種活動，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一定會很受歡迎的。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯……",
    "voice": "vo_adv_1172002_027",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為撞到人會很危險，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n所以不能太靠近人多的沙灘，也是客人少的一大要因呢……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要是能讓其他人從遠處看過來，也能感受到這份魅力就好了。",
    "voice": "vo_adv_1172002_028",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯～",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要用跟跳舞一樣，在客人面前表演之類的方法嗎……？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "譬如",
    "voice": "vo_adv_1172002_029",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "像這樣……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n提升速度後再迴轉！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "然後",
    "voice": "vo_adv_1172002_030",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "再向左右兩側蛇行！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿呀～♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "接下來～",
    "voice": "vo_adv_1172002_031",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就一鼓作氣地加速……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "然後跳躍！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": "vo_adv_1172002_032",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "剛才那樣可能挺不錯的！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這次就嘗試用迴旋力來轉彎吧！",
    "voice": "vo_adv_1172002_033",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
