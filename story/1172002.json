  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我可以試試看嗎？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "still",
    "still_id": "117200201"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯……",
    "voice": "vo_adv_1172002_061",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我想這速度已經夠快了，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但要空翻的話，這個力道還不太夠呢。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是因為不夠乾脆俐落嗎……？",
    "voice": "vo_adv_1172002_062",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n就像這樣，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "感覺就像把整個身體更加用力地向後拉……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……呵呵，",
    "voice": "vo_adv_1172002_063",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但今天明明是難得跟你一起度過的假日呢。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這明明也不是工作，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們卻這麼努力地在練習。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……不過啊，",
    "voice": "vo_adv_1172002_064",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "像是大家驚訝到合不攏嘴的表情，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n還有",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "眼神閃閃發亮的笑容。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一想像到那些畫面，",
    "voice": "vo_adv_1172002_065",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我就會湧現出幹勁。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n雖然我自己也覺得很不可思議。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這麼看來，",
    "voice": "vo_adv_1172002_066",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我果然很喜歡用自己的表演讓人露出笑容呢。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不管身在哪裡，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "又在做些什麼……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我都不會忘記這件事。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們好不容易",
    "voice": "vo_adv_1172002_067",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "來到只差臨門一腳的階段了。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "當然就會想全力以赴地嘗試到最後吧！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那麼，",
    "voice": "vo_adv_1172002_068",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你可以陪我再一次就好嗎？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然有可能會",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "頭上腳下地掉進海裡。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我要用加速到極限的最快速度上囉！",
    "voice": "vo_adv_1172002_069",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你也要抓緊囉！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": "vo_adv_1172002_070",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "速度漸漸上來了……！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n就用這股力道，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "讓船稍微下沉……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "然後再順著水面上浮的力道",
    "voice": "vo_adv_1172002_071",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "加速到極限，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就是現在──！　",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "來了！",
    "voice": "vo_adv_1172002_072",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就是這個時候！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "still",
    "still_id": "117200203"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "成功了……",
    "voice": "vo_adv_1172002_073",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "剛才",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "成功了對吧？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊哈哈！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好厲害，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真的成功了！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "好、",
    "voice": "vo_adv_1172002_074",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "好厲害……！",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "老闆",
    "words": "\\n居然真的空翻成功了……！",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯……！",
    "voice": "vo_adv_1172002_075",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可能搞懂了。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "大概就是",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "像這樣加速……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "然後在這個時機",
    "voice": "vo_adv_1172002_076",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "跳躍！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊哈哈♪",
    "voice": "vo_adv_1172002_077",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "成功了成功了！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n你也看到了吧？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "風景轉了一圈！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這招",
    "voice": "vo_adv_1172002_078",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一定會讓客人嚇一跳吧。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要是加進表演裡，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一定能讓大家看得目不轉睛啊。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "嘿，",
    "voice": "vo_adv_1172002_079",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "那邊從剛才開始就一直有浪花掀起……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n那是小艇嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "我怎麼覺得",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "它有飛到空中……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "那、",
    "voice": "vo_adv_1172002_080",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "那東西……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "剛才空翻了吧……！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n是說，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "那艘船上的是不是望望啊？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "117200201"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊哈哈……",
    "voice": "vo_adv_1172002_081",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "被發現了呢。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我是想說，希望這能當成表演的參考，",
    "voice": "vo_adv_1172002_082",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但引來注目的",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "卻是我們呢。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "該怎麼辦呢……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "很棒喔～",
    "voice": "vo_adv_1172002_083",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "很帥氣喔～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性3",
    "words": "\\n接下來還會表演什麼啊～？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我們也能做出那種技巧嗎？",
    "voice": "vo_adv_1172002_084",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n我",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "想試試看～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對了，",
    "voice": "vo_adv_1172002_085",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "既然現在",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "博得了客人的關注，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n趁這時候表現給他們看就好啦。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "讓他們知道用這艘高速小艇",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "能玩得這～麼開心。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們也經歷了非常快樂的體驗，",
    "voice": "vo_adv_1172002_086",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n當作是回禮，就多服務他們一點吧。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好～！",
    "voice": "vo_adv_1172002_087",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那麼，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就再來表演最後一次吧！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這是祕藏的華麗技巧，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要上囉～～！！",
    "voice": null,
    "unit_id": 117211
