  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "但是下次再合體的話，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n小卡里莎的屁股可能就會爆炸啊──",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那、",
    "voice": "vo_adv_5148080_012",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那是那麼亂來的招式嗎……！？",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "要使用它時",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "要付出巨大的代價呢……",
    "voice": null,
    "unit_id": 131611
  },
