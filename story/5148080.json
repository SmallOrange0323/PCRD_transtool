  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n史萊姆們",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是在跟怪奇怪靈戰鬥？",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n這是什麼情況啊？",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "啊──",
    "voice": "vo_adv_5148080_001",
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "被拍到了嗎──",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "這個",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "是秘密的特訓喔──",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "被發現了嗎──",
    "voice": "vo_adv_5148080_002",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
