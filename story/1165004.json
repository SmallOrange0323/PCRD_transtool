[
  {
    "type": "background",
    "bg_id": "500891"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和祈梨眺望著夕陽，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一起吃著飯糰。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "工作完以後吃的飯別有一番風味呢！",
    "voice": "vo_adv_1165004_000",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n畢竟連只有撒鹽的飯糰，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "吃起來都會這麼好吃！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦！？",
    "voice": "vo_adv_1165004_001",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你連茶都有準備好嗎！？",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不愧是我未來的親信！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是貼心！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……呼～",
    "voice": "vo_adv_1165004_002",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是洗滌身心啊。",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n不管是茶，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還是小哥背後那耀眼的夕陽……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……不對，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "再怎麼說都太耀眼了吧！？",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥，",
    "voice": "vo_adv_1165004_003",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你的身體又在發光了！！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "該不會",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "又是這個套路吧──！？",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "background",
    "bg_id": "510301"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗚……",
    "voice": "vo_adv_1165004_004",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我本來是不參加網聚主義的人，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n都特地空出時間去參加了……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "他們居然露出「這傢伙比想像中還要無趣呢」的表情，",
    "voice": "vo_adv_1165004_005",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n後來直到最後",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "都把我當作空氣對待，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是一群混蛋人渣……！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……啊嗚！？",
    "voice": "vo_adv_1165004_006",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "痛痛……",
    "voice": "vo_adv_1165004_007",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對、",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對不起撞到你了…………",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……咦，",
    "voice": "vo_adv_1165004_008",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是小哥！？",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是的！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我真是白道歉了！！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……！",
    "voice": "vo_adv_1165004_009",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我、",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我才沒有在哭呢！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n這是，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "因為",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "夕陽有一點刺眼……！！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "總而言之，",
    "voice": "vo_adv_1165004_010",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我今天",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "已經不想和任何人說話了。",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你就放著我，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "別管我了……！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不、",
    "voice": "vo_adv_1165004_011",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不要再盯著我看了……！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥你這樣",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "很多管閒事啦……！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你要是再煩下去，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我就叫警察喔！！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "欸妳看那邊……",
    "voice": "vo_adv_1165004_012",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "發生什麼事了啊？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n我們是不是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "該出手幫她比較好？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "欸，",
    "voice": "vo_adv_1165004_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "那女生在哭欸，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "你該不會……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "對她做了什麼吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n如果真是如此的話──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊嗚！？",
    "voice": "vo_adv_1165004_014",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n又、",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "又是這個發展……！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "我說，",
    "voice": "vo_adv_1165004_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "妳沒事嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n妳看起來很害怕。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊，",
    "voice": "vo_adv_1165004_016",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那個……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不、",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不是……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n不是的……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "……？",
    "voice": "vo_adv_1165004_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n總之，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "我們一起去警察局──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我、",
    "voice": "vo_adv_1165004_018",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我就說了！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n真、",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真的沒什麼啦……！！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "啊！",
    "voice": "vo_adv_1165004_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "她走掉了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n感覺她態度怪怪的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "是個有點奇怪的女生呢……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "那個，",
    "voice": "vo_adv_1165004_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "先生，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "對不起喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n看來是我們搞錯了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510121"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……呼，呼。",
    "voice": "vo_adv_1165004_021",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我絕對",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "又被當作是「奇怪的傢伙」了……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n這一切都是因為……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是的！",
    "voice": "vo_adv_1165004_022",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n為什麼小哥你也跟來了！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說到頭來！",
    "voice": "vo_adv_1165004_023",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我不是不擅長說話，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n而是嘴巴跟不上",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "思考的速度而已啊！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說話吞吞吐吐的，",
    "voice": "vo_adv_1165004_024",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "聲音會越來越小，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n還常常低下頭，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這些都是我的特色……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我可不是被戲弄、",
    "voice": "vo_adv_1165004_025",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "被嘲笑、",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "被無言以對、",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "被無視……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "被做了這些事以後還不會受傷的，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n那麼奇怪的人啊……！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗚嗚……",
    "voice": "vo_adv_1165004_026",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "為什麼我今天",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "一直遇到這種事啊。",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我只是",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "因為他們說「想和妳當朋友」才會去參加網聚的，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n他們都是些不尊重人的混蛋，好討厭！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "既然要遭受這種待遇，",
    "voice": "vo_adv_1165004_027",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我不如一直待在家裡玩阿斯特朗還比較好！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我一個人獨處，",
    "voice": "vo_adv_1165004_028",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "比這好上百億萬倍！！！！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……你為什麼不說話？",
    "voice": "vo_adv_1165004_029",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n既然都露出那麼傷腦筋的表情了，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你只要生氣",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "或是離開不就好了嗎！！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥你也是吧，其實你心裡",
    "voice": "vo_adv_1165004_030",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n也是覺得我──",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼！？",
    "voice": "vo_adv_1165004_031",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你在開玩笑嗎！？",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n為什麼我得陪小哥你玩──",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "still",
    "still_id": "116500401"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "來吧！",
    "voice": "vo_adv_1165004_032",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n小哥你也",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "一起來唱歌！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……因為你是音癡所以不想唱？",
    "voice": "vo_adv_1165004_033",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我不接受！！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你都說著「去使盡全力紓解壓力吧！」，強拉我來唱歌，",
    "voice": "vo_adv_1165004_034",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n還讓我Cosplay成我最喜歡的動畫角色了！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥你多少也來傷一下腦筋吧！",
    "voice": "vo_adv_1165004_035",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "來，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "拿起麥克風！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘿嘿！",
    "voice": "vo_adv_1165004_036",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n下一首我點了櫻井望的新歌！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n這首歌要和其他人一起唱，才嗨得起來呀！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1165004_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n祈梨她啊，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "一開始我還擔心會變成怎麼樣，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但最後她好像有盡全力在玩耍，真是太好了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "現在想想，",
    "voice": "vo_adv_1165004_038",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那孩子一直都在尋找棲身之處呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就像她在阿斯特朗世界裡有順利找到歸屬一樣，",
    "voice": "vo_adv_1165004_039",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n在現實之中，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "其實棲身之處也就在她身邊，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n希望她總有一天會察覺到這點。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "直到那天為止，",
    "voice": "vo_adv_1165004_040",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你都要有耐心地照顧那孩子喔！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500891"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……啊！？",
    "voice": "vo_adv_1165004_041",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "剛、",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "剛才那是怎麼一回事！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "雖然是個很讓人不開心的夢，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但是最後──",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……小哥一如往常，是個愛多管閒事的傢伙呢。",
    "voice": "vo_adv_1165004_042",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我也並不討厭",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你這樣的個性啦！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……咦，",
    "voice": "vo_adv_1165004_043",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "已經這麼晚了！？",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "糟糕了！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要是太晚還在外面遊蕩，我就會被扣零用錢！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……對了，",
    "voice": "vo_adv_1165004_044",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就說我是為了照顧小哥，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n不知不覺就拖到很晚好了！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以小哥，",
    "voice": "vo_adv_1165004_045",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你就以證人身分跟著我來吧！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是{0}被祈梨從背後推拉著，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n離開了傍晚的小巷。",
    "voice": null,
    "unit_id": null
  }
]
