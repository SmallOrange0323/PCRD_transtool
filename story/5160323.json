[
  {
    "type": "dialogue",
    "name": "大蛇",
    "words": "嘶啊啊啊啊啊啊！",
    "voice": null,
    "unit_id": 18911
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "唔！",
    "voice": "vo_adv_5160323_000",
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這是何等壓迫感……",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n這似乎",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就是那隻大蛇認真起來的樣子呢。",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是啊，",
    "voice": "vo_adv_5160323_001",
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒想到至今為止的激戰居然只是暖場，",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "真是驚人啊。",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "哎呀，",
    "voice": "vo_adv_5160323_002",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "但是妳看起來完全不覺得辛苦嘛？",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "確實呢。",
    "voice": "vo_adv_5160323_003",
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然是些微的差錯就會喪命的極限戰鬥，",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但是以那隻大蛇為對手的話，",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "會讓我不可思議地興奮起來。",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妳不也是這樣嗎？",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "梅杜莎。",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "嗯。",
    "voice": "vo_adv_5160323_004",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "明明又痛又辛苦，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n但是對手是那孩子的話，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我卻完全不會覺得討厭。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我想要",
    "voice": "vo_adv_5160323_005",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "好好面對那孩子。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n我覺得",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我好像能跟那孩子好好相處呢。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是嗎。",
    "voice": "vo_adv_5160323_006",
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那麼",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我來幫妳吧，",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "梅杜莎。",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "因為就算",
    "voice": "vo_adv_5160323_007",
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "想面對對方，",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n不先讓牠",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "冷靜下來的話不行啊。",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "咲戀、",
    "voice": "vo_adv_5160323_008",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "莫妮卡……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "謝謝妳們！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "那麼，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我們也要",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "使出全力上了喔！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "咲戀、莫妮卡",
    "words": "「嗯！」\\n「好！」",
    "voice": "vo_adv_5160323_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "等一下等一下等一下──！",
    "voice": "vo_adv_5160323_010",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n不要無視我啦──！",
    "voice": null,
    "unit_id": 134911
  }
]
