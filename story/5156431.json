    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "才沒那種事。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我其實稍微有點……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "寂寞哦？",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "因為，",
    "voice": "vo_adv_5156431_002",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "像這麼嚴酷的國家，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "也沒有蠻賊貪鯊號，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "雖然一開始真的很不安，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "也有點害怕……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "但是，",
    "voice": "vo_adv_5156431_003",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "正因為如此，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n才能跟姊姊還有布武機以真心話對談，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "又或者說，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n互相幫助，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "變得更像是姊妹了",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "的感覺……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "嘿嘿。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "──呃，",
    "voice": "vo_adv_5156431_004",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "姊姊！？",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "布武機！？",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n咦、",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "已經走到門口了！？",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嘖。",
    "voice": "vo_adv_5156431_005",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n被發現了～ｗｗ",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……難道說妳們打算丟下我，",
    "voice": "vo_adv_5156431_006",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "先回到蘭德索爾嗎！？",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "因為妳實在太陰沉了啦。",
    "voice": "vo_adv_5156431_007",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "想一起回去的話就別碎碎念了，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "趕快過來！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "嗚嗚……",
