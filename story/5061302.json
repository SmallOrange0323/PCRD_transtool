[
  {
    "type": "dialogue",
    "name": "真步",
    "words": "哎呀呀，",
    "voice": "vo_adv_5061302_000",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "魔物的公主殿下",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "情緒很激動呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哦，",
    "voice": "vo_adv_5061302_001",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "也就是第二回合要開打了嗎？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n真有趣！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就讓她瞧瞧我們的真本事！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "上吧上吧──！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "等等，",
    "voice": "vo_adv_5061302_002",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真琴！",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……沒辦法，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "看來她已經徹底熱血沸騰了。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "要接近已經變成那般狀態的真琴",
    "voice": "vo_adv_5061302_003",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是非常危險的喔。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "莉瑪，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "妳就和咱們一起",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "專注於後方支援吧？",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這、",
    "voice": "vo_adv_5061302_004",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣好嗎……",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我也要跟",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真琴一起到前頭作戰！",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我想這才是",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "拯救公主殿下的捷徑！",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "所以，真步，",
    "voice": "vo_adv_5061302_005",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就拜託妳支援我們了！",
    "voice": null,
    "unit_id": 115811
  }
]
