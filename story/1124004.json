    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "那個，",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "跑完一整首歌沒問題嗎？",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "也就是做好覺悟了對吧……",
    "voice": "vo_adv_1124004_027",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我會連同你的份，",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "一起加油的！",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "女性的司儀",
    "words": "看來做好準備了呢。",
    "voice": "vo_adv_1124004_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性的司儀",
    "words": "\\n那麼跑者，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性的司儀",
    "words": "請開始跑吧——！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性的司儀",
    "words": "……好的，",
    "voice": "vo_adv_1124004_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性的司儀",
    "words": "聚光燈亮起來了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性的司儀",
    "words": "\\n開始自我介紹之後",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性的司儀",
    "words": "音樂就會開始了——！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "112400402"
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我是參賽編號10號的",
    "voice": "vo_adv_1124004_030",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "島村卯月！",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "請大家，",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "多多指教！",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "唔喔！　",
    "voice": "vo_adv_1124004_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "那個女生，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "聲音很響亮呢——！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "穿著制服的話，所以是",
    "voice": "vo_adv_1124004_032",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "高中生？　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "不過，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "是哪裡的學校啊？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "果然沒錯……",
    "voice": "vo_adv_1124004_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳果然有著出眾的偶像素質啊……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510301"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "今天硬是要求妳參加果然沒有白費功夫。",
    "voice": "vo_adv_1124004_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n妳讓我欣賞了一場非常棒的表演喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "過獎了，",
    "voice": "vo_adv_1124004_035",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我還",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "需要更加努力呢……",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "不過",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "聽你這樣說我很開心。",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "雖然甄選的優勝者變成了其他選手，",
    "voice": "vo_adv_1124004_036",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "怎麼樣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n如果妳不嫌棄的話，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "要不要在我的事務所",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "正式出道呢！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "咦咦！？",
    "voice": "vo_adv_1124004_037",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n不是說會從甄選名單裡排除的嗎！",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "從名單裡排除了啊！",
    "voice": "vo_adv_1124004_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n但那是另一回事了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳就直接出道吧！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "拜託了！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "拜託了！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "對、",
    "voice": "vo_adv_1124004_039",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "對不起！　",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我已經心有所屬了，",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n所以不能接受您的邀約！",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……呵，",
    "voice": "vo_adv_1124004_040",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "被這麼直接了當地甩掉，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那也沒辦法了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我明白了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "雖然很可惜但還是放棄吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "嗚齁齁……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "呼……",
    "voice": "vo_adv_1124004_041",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "能、",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "能拒絕掉真是太好了。",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "只是著急過頭，",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "說了些奇怪的話就是了……",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是的，",
    "voice": "vo_adv_1124004_042",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我已經下定決心了，不論過去或未來，",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "都要和製作人一起努力走下去。",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "不會有其他人選的。",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "欸嘿嘿……",
    "voice": "vo_adv_1124004_043",
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "這件事，",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "要對小凜和未央保密喔。",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "萬一傳進了製作人的耳裡，",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "可是很害羞的。",
    "voice": null,
    "unit_id": 112431
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，",
    "voice": "vo_adv_1124004_044",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這次的夢境怎麼樣……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "呃，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "現在應該不是問你感想的時候。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "怎麼回事啊，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這個？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "似乎是混雜了各種情報處於混亂的狀態呢。",
    "voice": "vo_adv_1124004_045",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "或許是因為那些孩子是「外側」的存在吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這場夢境，",
    "voice": "vo_adv_1124004_046",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也說不準是不是在那邊發生過的事……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "從頭到尾也只能說是異常狀況呢，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真是的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500331"
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "……咦，",
    "voice": "vo_adv_1124004_047",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我們，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是睡著了嗎……？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "雖說睡在樹蔭下很舒服，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "但居然睡到這時候……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "說起來，",
    "voice": "vo_adv_1124004_048",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我做了不可思議的夢喔。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n在偶像的甄選活動裡，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n以燦爛的笑容向大家進行表演的夢……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "難道說，",
    "voice": "vo_adv_1124004_049",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我在無意間想著",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n要成為能夠做到那種表演的偶像嗎？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "嘿嘿，",
    "voice": "vo_adv_1124004_050",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "為了不輸給夢裡",
    "voice": "vo_adv_1124004_051",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n展現出精彩表演的我自己，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "會加油的！",
    "voice": null,
