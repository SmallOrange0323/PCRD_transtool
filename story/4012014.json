  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我有訂購",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "能讓自己變得更美的藥，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n商品準備好了嗎？",
