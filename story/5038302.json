[
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真的假的。",
    "voice": "vo_adv_5038302_000",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n那個臭遜廢鐵丸又復活了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，那這要怎麼辦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "而且它的火力和輸出似乎也受到了大幅的強化。",
    "voice": "vo_adv_5038302_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哎呀呀～",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "自我修復再加上反覆的自我學習真是令人敬畏。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n這應該是墨團",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "驚人的技術吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不，根本是困擾至極好嗎！？",
    "voice": "vo_adv_5038302_002",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "浪費技術力好歹也要有個限度啊！？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "切嚕～☆",
    "voice": "vo_adv_5038302_003",
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "好朋友X",
    "words": "\\n切啪哩扣‧切啦哩噗‧切嗶啦啪～～～～～～！",
    "voice": null,
    "unit_id": 13211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": "vo_adv_5038302_004",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這傢伙突然間怎麼搞的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "完全聽不懂到底在講什麼——",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你……",
    "voice": "vo_adv_5038302_005",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你怎麼會講出這麼恐怖的話，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好朋友X！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我絕對不會讓你得逞的！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "聖德蕾莎女子學院",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就由琪愛兒等人來保護！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，",
    "voice": "vo_adv_5038302_006",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "它剛剛講了啥？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n為什麼琪愛兒突然進入戲劇化模式？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n它說了那麼惡劣的話嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哎呀呀，",
    "voice": "vo_adv_5038302_007",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "看來切嚕語的功能也強化了的樣子。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "琪愛兒、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "克蘿依，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "在它繼續強化之前粉碎它吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "優妮們，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "使出全力上吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是啊！",
    "voice": "vo_adv_5038302_008",
    "unit_id": 110911
  },
  {
