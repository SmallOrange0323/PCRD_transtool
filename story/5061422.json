  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "在激戰那麼久以後還那麼興奮地宣示勝利，",
    "voice": "vo_adv_5061422_001",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "當然會變成那樣啦。",
    "voice": null,
    "unit_id": 115911
