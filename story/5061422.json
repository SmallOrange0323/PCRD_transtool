  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過，做得好哦。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這場勝利都多虧了妳呢。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不，",
    "voice": "vo_adv_5061422_002",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我之所以能戰鬥到現在，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n都是多虧了真琴和真步哦。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳們兩位為我上了課，",
    "voice": "vo_adv_5061422_003",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "而且在戰鬥當中也時常幫助我不是嗎？",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這場勝利是大家的功勞，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "對吧♪",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真有莉瑪的風格呢～",
    "voice": "vo_adv_5061422_004",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不過，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們也是",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "被妳的這種地方給吸引了吧。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好了，",
    "voice": "vo_adv_5061422_005",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "戰鬥已經結束了。",
    "voice": null,
    "unit_id": 115811
  },
