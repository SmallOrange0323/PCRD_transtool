[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "真琴跟{0}一邊解決海邊遊客的困擾，\\n一邊繼續巡邏。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呼。",
    "voice": "vo_adv_1104003_000",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "海灘的狀況",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "終於穩定下來了呢。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "連喘息的空閒都沒有。",
    "voice": "vo_adv_1104003_001",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n雖然知道會很忙碌，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒想到會忙到這種程度。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過",
    "voice": "vo_adv_1104003_002",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "到現在還沒有出現溺水的人，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n或者傷患之類的，也算是好事。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "如果在海邊發生意外",
    "voice": "vo_adv_1104003_003",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可是攸關生命呢。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們沒有出場機會",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "才是真正的好事啊。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這麼說起來，",
    "voice": "vo_adv_1104003_004",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "游泳的技術怎麼樣啊？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "對了，",
    "voice": "vo_adv_1104003_005",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "之前跟公主她們一起去海邊的時候，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n你好像差點溺水吧。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯嗯，",
    "voice": "vo_adv_1104003_006",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "幾乎不會游泳對吧？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "到底是怎樣的程度，",
    "voice": "vo_adv_1104003_007",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你游給我看一下吧。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊～",
    "voice": "vo_adv_1104003_008",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n原來如此呢。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要自稱是海岸巡守員，",
    "voice": "vo_adv_1104003_009",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "有點不夠呢。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喔，",
    "voice": "vo_adv_1104003_010",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那是哪來的自信啊。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n去拿東西？　",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是什麼啊……？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "密技？",
    "voice": "vo_adv_1104003_011",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　什麼啊？密技是指什麼？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n喂，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你要跑去哪裡啊？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊……",
    "voice": "vo_adv_1104003_012",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我還以為你這麼有自信",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是有什麼祕密呢。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "原來是游泳圈啊！",
    "voice": "vo_adv_1104003_013",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "而且好像還很得意啊？",
    "voice": "vo_adv_1104003_014",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n嗯？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　有這個就不會溺水了？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}覺得沒問題的話，",
    "voice": "vo_adv_1104003_015",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n是沒有什麼不好啦……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過呢，",
    "voice": "vo_adv_1104003_016",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n要是真的發生什麼事情，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還是先讓我去救人吧。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你可不要逞強啊。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "海邊的意外",
    "voice": "vo_adv_1104003_017",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要是發生二次災害可是很恐怖的。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊，",
    "voice": "vo_adv_1104003_018",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯～",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "二次災害就是呢，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要去救人的傢伙結果自己",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "也溺水了，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "之類的吧。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "也就是適得其反的意思啦。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦？",
    "voice": "vo_adv_1104003_019",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　你問我適得其反的意思是？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那個……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊啊這個對話就是二次災害啊！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不對，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "雖然有點不一樣啊！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "總之呢――",
    "voice": "vo_adv_1104003_020",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "小孩！",
    "voice": "vo_adv_1104003_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "　有小孩子溺水了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "！",
    "voice": "vo_adv_1104003_022",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "快點走吧！",
    "voice": "vo_adv_1104003_023",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂！",
    "voice": "vo_adv_1104003_024",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "溺水的人在哪裡！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "在那邊！",
    "voice": "vo_adv_1104003_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "怎麼一個小孩子在那麼遠的地方！？",
    "voice": "vo_adv_1104003_026",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是被海流沖走的嗎！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "等等，",
    "voice": "vo_adv_1104003_027",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "馬上過去！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}在這裡等著，",
    "voice": "vo_adv_1104003_028",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "聽懂了吧！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗚喔喔――！",
    "voice": "vo_adv_1104003_029",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "很好，",
    "voice": "vo_adv_1104003_030",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "趕上了！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "嗚哇、",
    "voice": "vo_adv_1104003_031",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "啊！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我來救你了！",
    "voice": "vo_adv_1104003_032",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "冷靜一點，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好好抓住我。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "呼、",
    "voice": "vo_adv_1104003_033",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "呼……！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不要亂動，",
    "voice": "vo_adv_1104003_034",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好好抓住我喔。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好了，",
    "voice": "vo_adv_1104003_035",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "到岸邊了。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "已經沒事了。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "冷靜下來，深呼吸。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "有沒有哪裡會痛呢？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "……姊姊。",
    "voice": "vo_adv_1104003_036",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦？",
    "voice": "vo_adv_1104003_037",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　怎麼了？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "姊姊她……",
    "voice": "vo_adv_1104003_038",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "跟我在一起……！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n拜託……",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "快去",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "救救姊姊！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "？",
    "voice": "vo_adv_1104003_039",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "漂到更遠去了……！",
    "voice": "vo_adv_1104003_040",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可惡！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "給我等著……！",
    "voice": "vo_adv_1104003_041",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還差一點……",
    "voice": "vo_adv_1104003_042",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可惡，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
