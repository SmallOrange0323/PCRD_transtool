  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "霸瞳皇帝被打倒過了幾天的某日，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n日和見證完城市和人們取回平穩的生活後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n該回去基礎世界的日子到了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "但是……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈，",
    "voice": "vo_adv_5208007_000",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "抱",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "歉，日和！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我沒辦法",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "讓日和回到原本的世界了！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦咦咦咦咦～～～！？",
    "voice": "vo_adv_5208007_001",
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦，",
    "voice": "vo_adv_5208007_002",
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "等等，埃拉，",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣我很困擾啊！",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怎麼回事！？",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗯──",
    "voice": "vo_adv_5208007_003",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "就是啊，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我啊。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n好像沒有管理者的權限了呢──！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "哎呀──",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這下頭疼啦──",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈哈哈！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳完全不覺得頭疼吧！？",
    "voice": "vo_adv_5208007_004",
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "到底是怎麼回事啦～～～！？",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈！",
    "voice": "vo_adv_5208007_005",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不知道！！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "志那都應該會懂吧～？",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我有告訴怜，妳去問她！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "說笑的～",
    "voice": "vo_adv_5208007_006",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "日和回不去，所以問不了吧。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "那麼",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "日和，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我們去街上找要一起住的家吧！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦咦～",
    "voice": "vo_adv_5208007_007",
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……嘿嘿嘿！",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不過，",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "太好了！",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……嗯？",
    "voice": "vo_adv_5208007_008",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "因為",
    "voice": "vo_adv_5208007_009",
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "當管理者",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "很辛苦吧，",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "今後",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有身為普通女孩子的",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "快樂未來在等著妳喔！",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "太好了呢，",
    "voice": "vo_adv_5208007_010",
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "埃拉！",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n辛苦妳了！",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈……",
    "voice": "vo_adv_5208007_011",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "真的是個好孩子呢，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "大姐姐都有罪惡感了！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "對不起啊日和，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "其實妳可以直接回去沒問題喔！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是這樣嗎！？",
    "voice": "vo_adv_5208007_012",
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "所以啦，",
    "voice": "vo_adv_5208007_013",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "麻煩你囉，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "騎士先生♪",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "抱歉啊，",
    "voice": "vo_adv_5208007_014",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "日和。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我是因為想跟日和再待一下",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "才忍不住說了謊。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "安布拉",
    "words": "喵～",
    "voice": null,
    "unit_id": 1731
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈，",
    "voice": "vo_adv_5208007_015",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "安布拉，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "你也很寂寞嗎喵～？",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這下得告別了。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n畢竟日和",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "有日和自己的未來呢。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "埃拉……",
    "voice": "vo_adv_5208007_016",
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "日和，",
    "voice": "vo_adv_5208007_017",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "讓我再次感謝妳吧。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "大家的「惡夢症」也已經消失，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n從現在開始可以邁向嶄新的未來了。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "埃拉與志那都",
    "voice": "vo_adv_5208007_018",
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還保留著記憶對吧……",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈，",
    "voice": "vo_adv_5208007_019",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "是～啊！",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "雖然有好多想要忘記的記憶，",
