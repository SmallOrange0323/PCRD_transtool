    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "想起這個世界，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "那我會很開心的。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "即便身處的世界不同。",
    "voice": "vo_adv_5208007_024",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我也會",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "常常仰望天空，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "常常",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "想念妳喔。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯……",
    "voice": "vo_adv_5208007_025",
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
