    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是不自然的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你是不是為了複製品世界的未來，",
