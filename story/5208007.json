    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "但還是有",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "更多不想忘記的事呢♪",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……好了。",
    "voice": "vo_adv_5208007_020",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n這次真的真的，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "要說再見了。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……欸，日和。",
    "voice": "vo_adv_5208007_021",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "在這個最後，",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我可以抱緊妳嗎？",
