    "type": "dialogue",
    "name": "日和",
    "words": "嗯。",
    "voice": "vo_adv_5208007_022",
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我也",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "想抱緊妳。",
    "voice": null,
    "unit_id": 135712
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……日和。",
    "voice": "vo_adv_5208007_023",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我們彼此，",
