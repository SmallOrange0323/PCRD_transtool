[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在露娜之塔裡前進的{0}一行人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n遭到一大群魔物包圍。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "被這麼多魔物包圍的話，",
    "voice": "vo_adv_7019003_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "無論是要前進還後退都沒辦法啊……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你們兩個",
    "voice": "vo_adv_7019003_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不要離開我身邊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n少年麻煩照顧好莫妮卡。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可是。",
    "voice": "vo_adv_7019003_002",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就算是純閣下，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "要獨自對付這麼多的敵人──",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "喝啊啊啊！！",
    "voice": "vo_adv_7019003_003",
    "unit_id": 104711
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "…………不。",
    "voice": "vo_adv_7019003_004",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是我杞人憂天了啊。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "現在要",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "以閣下的安全為最優先。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然很不甘心，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但我們就退後吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好",
    "voice": "vo_adv_7019003_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣就結束了呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唉。",
    "voice": "vo_adv_7019003_006",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我原本還想說",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這次一定要大顯身手的……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但事情沒有那麼順利啊。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……唔！？",
    "voice": "vo_adv_7019003_007",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下！",
    "voice": "vo_adv_7019003_008",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "小心後面！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……呼。",
    "voice": "vo_adv_7019003_009",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "真是好險。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "要是我沒殺牠，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下就會被劈成兩半了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "莫妮卡，",
    "voice": "vo_adv_7019003_010",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳沒事吧！？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喔。",
    "voice": "vo_adv_7019003_011",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這點小傷不成問題。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "抱歉。",
    "voice": "vo_adv_7019003_012",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "明明有我在現場……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "快別那麼說。",
    "voice": "vo_adv_7019003_013",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n或許在純閣下眼裡，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我看起來既嬌小又不可靠，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n但我也是軍人。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "身為軍人，",
    "voice": "vo_adv_7019003_014",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然侍奉的國家不同，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但守護人民就是我們的職責。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "既然他平安無事，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n這個傷口",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就是我的勳章！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "莫妮卡……",
    "voice": "vo_adv_7019003_015",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "說得也是呢。",
    "voice": "vo_adv_7019003_016",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "莫妮卡是",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "傑出的軍人。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……是我不明白那點呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後，{0}一行人在用完餐後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n便各自小睡片刻。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n接著過了一段時間後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……喔。",
    "voice": "vo_adv_7019003_017",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你已經可以起來了嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n莫妮卡她──",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "…………",
    "voice": "vo_adv_7019003_018",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "呼喵呼喵。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵，",
    "voice": "vo_adv_7019003_019",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "她應該是累了吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那麼，為了不要吵醒她，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我們就小聲說話吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……說是這麼說，",
    "voice": "vo_adv_7019003_020",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但要說什麼才好呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n像這種時候，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我對根本不會閒聊，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n無聊透頂的自己",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "感到很失望。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我想想。",
    "voice": "vo_adv_7019003_021",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "莫妮卡的睡臉……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n像小孩子一樣天真無邪，很可愛呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "而且我剛才抱起她的時候，",
    "voice": "vo_adv_7019003_022",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "她輕到讓我嚇了一跳。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n感覺一受到魔物攻擊",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就會被打飛。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以身體才會擅自做出反應，",
    "voice": "vo_adv_7019003_023",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "認為自己必須要保護她才行。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……我明明很清楚",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "她是大人，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "而且是很有本事的軍人。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "當然。",
    "voice": "vo_adv_7019003_024",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n看過她一路上的言行舉止和身手後，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "很難不明白。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "而且她也跟我一樣，",
    "voice": "vo_adv_7019003_025",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n擁有想保護人民的堅定信念。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "明明是那樣，",
    "voice": "vo_adv_7019003_026",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我這人卻……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我總會不由得盯著她",
    "voice": "vo_adv_7019003_027",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "比茉莉更加嬌小的身體。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n順便",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "連手跟嘴巴都動了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這已經",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "像是反射動作一樣。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "都是我害",
    "voice": "vo_adv_7019003_028",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "莫妮卡看起來很沮喪。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我該怎麼做才好……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵，",
    "voice": "vo_adv_7019003_029",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "說得也是呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n要開口才能傳達給她。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我想找機會",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好好跟她聊聊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "畢竟她也是",
    "voice": "vo_adv_7019003_030",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n跟我有相同抱負的",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "「同志」。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "即使隔著堅固的頭盔，",
