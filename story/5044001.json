  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "數日後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}與流夏、杏奈和七七香動身前往這趟度假的目的地──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "順利抵達～！",
    "voice": "vo_adv_5044001_000",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n哎呀，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "路途比想像中",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "還要遙遠呢～",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯，",
    "voice": "vo_adv_5044001_001",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "因為來這裡的路很不好認啊。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "難怪會被說是",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "隱密的私房景點呢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "話說回來，",
    "voice": "vo_adv_5044001_002",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們有決定住宿的地點了嗎？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n事先聲明，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我可不接受因為找不到空房，最後必須露宿野外喔！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哼哼哼～",
    "voice": "vo_adv_5044001_003",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不必擔心！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n七七香已經預約好房間了",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒事沒事☆",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……雖然，",
    "voice": "vo_adv_5044001_004",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "當時被其他通訊魔法強行截斷，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "讓人有一點點不安。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "喂，",
    "voice": "vo_adv_5044001_005",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要是難得出來度假還得露宿野外，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我可不原諒妳喔！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "只要有屋簷和被窩，",
    "voice": "vo_adv_5044001_006",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我是不介意露宿──",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "流夏妳對度假的標準再高一點好嗎！",
    "voice": "vo_adv_5044001_007",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "夠了，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要是真的沒地方住，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就由我和七七香用魔法做出一個家……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不對，",
    "voice": "vo_adv_5044001_008",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "在想對策之前，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "該先去旅館報到才對。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "反正也得先放行李，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "快去確認看看吧。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "了解啦～",
    "voice": "vo_adv_5044001_009",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n解決完住宿問題後，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "大家一起",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "去海邊玩吧！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喔，",
    "voice": "vo_adv_5044001_010",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這個提議不錯嘛。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "去海邊散散步也很舒服，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我贊成。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "怎麼可能只是散個步而已～",
    "voice": "vo_adv_5044001_011",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "既然都來度假了，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就應該要",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "換上泳裝才對！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不是，",
    "voice": "vo_adv_5044001_012",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就算妳這麼說，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我又沒有帶泳衣來，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這也沒辦法吧？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哼哼哼，",
    "voice": "vo_adv_5044001_013",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "別擔心！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我早就知道會是這樣，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "於是準備了七七香精選泳衣唷☆",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "竟然！",
    "voice": "vo_adv_5044001_014",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": " 沒想到連我們的份都有準備……！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n妳這傢伙，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "難道擁有預知未來的真實之眼嗎！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哼哼哼，",
    "voice": "vo_adv_5044001_015",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "或許有喔～♪",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……七七香。",
    "voice": "vo_adv_5044001_016",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳是怎麼幫我們挑泳衣的？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n該不會，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是趁我們睡覺時偷偷量了我們的身材──",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "等等！",
    "voice": "vo_adv_5044001_017",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "暫停暫停！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": " 我才沒有做什麼奇怪的事喔！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "只是用魔法大略測量了一下而已！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": " 我也不知道更精確的數值啦～！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳什麼時候做了那種事……",
    "voice": "vo_adv_5044001_018",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還真是不能大意呢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我知道了啦，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼等等換上泳衣後",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就去海灘吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我準備了超級適合妳們兩個的泳衣，",
    "voice": "vo_adv_5044001_019",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好好期待吧☆",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n喲呵，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喲呵呵呵呵……！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "movie",
    "movie_id": "504400101"
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "問你喔。",
    "voice": "vo_adv_5044001_020",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你覺得",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們的泳衣",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "怎麼樣呀？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "大家都超適合的對吧～？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咦……",
    "voice": "vo_adv_5044001_021",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "被你這樣稱讚，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "讓人有點害羞啊……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這股戀愛喜劇的氛圍……！",
    "voice": "vo_adv_5044001_022",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呵，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這都是多虧了七七香的精選泳衣喔。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你是認真的嗎！？",
    "voice": "vo_adv_5044001_023",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": " 你真的這麼認為嗎！？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這件泳衣不管怎麼看都是不合身的吧～！！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "確實是比",
    "voice": "vo_adv_5044001_024",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一般泳衣",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還小了一個尺寸呢……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "幸好",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我的這件",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是合身的。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哦哦，",
    "voice": "vo_adv_5044001_025",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你的眼光真高！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n竟然能體會性感魔法少女的魅力，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "還不錯嘛～！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗚嗚，",
    "voice": "vo_adv_5044001_026",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳太卑鄙了！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n妳自己挑的泳衣，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "當然會很適合妳啊！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那麼，",
    "voice": "vo_adv_5044001_027",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們就馬上來……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "看招，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "杏奈美眉～！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗚哇！？",
    "voice": "vo_adv_5044001_028",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": " 妳、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳做什麼～！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呀哈哈、",
    "voice": "vo_adv_5044001_029",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯哼哼，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "快來",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "抓我啊～！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看她們玩得那麼開心，",
    "voice": "vo_adv_5044001_030",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "想必是真的很想來度假吧。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "天曉得她們到底有多期待呢……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……好，",
    "voice": "vo_adv_5044001_031",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們表現出享受度假的樣子了。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這樣一來，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "關於「祈願竹」的事應該不會被發現！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "畢竟製造驚喜感很重要嘛。",
    "voice": "vo_adv_5044001_032",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們是不是",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "差不多該去蒐集情報了？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是啊──",
    "voice": "vo_adv_5044001_033",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這裡好像會舉辦和七夕有關的祭典，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我們只要問了關於祭典的事，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "自然也能得到「祈願竹」的情報……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "了吧！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那麼，",
    "voice": "vo_adv_5044001_034",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們現在就若無其事地",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "提議休息……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "唔唔～！",
    "voice": "vo_adv_5044001_035",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": " 這樣玩一玩，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我突然覺得口乾舌燥耶！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n這附近，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "有沒有什麼，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "適合休息的地方啊！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊啊～！",
    "voice": "vo_adv_5044001_036",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": " 那裡好像，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "有一間能讓人好好放鬆的店喔！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "流夏姐也，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "和我們一起，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "去那裡休息一下嘛～！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要休息是無所謂啦……",
    "voice": "vo_adv_5044001_037",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過妳們兩個",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是怎麼啦？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "來，",
    "voice": "vo_adv_5044001_038",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "這是妳點的飲料。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "請慢用～",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "大叔，",
    "voice": "vo_adv_5044001_039",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "能佔用你一點時間嗎？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n聽說這村子",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "會在七夕時舉辦祭典，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這是真的嗎？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "喔，",
    "voice": "vo_adv_5044001_040",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "是啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "在這個村子裡",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "有著祭拜織女大人與牛郎大人的神殿。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "每一年，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "村子裡都會舉辦慶祝七夕的祭典。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "傳說中織女大人、",
    "voice": "vo_adv_5044001_041",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "牛郎大人",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "以及銀河中的",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "眾多星辰精魄，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "都會齊聚於此，實現人們的心願喔。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哦哦，",
    "voice": "vo_adv_5044001_042",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "還真是個充滿奇幻色彩的由來呢。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "根據傳說，",
    "voice": "vo_adv_5044001_043",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "曾經甚至人能夠從村子前往銀河，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "與眾星辰對話呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "不過，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "到了現在",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "這也只是個童話故事罷了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "有夢想是件好事啊。",
    "voice": "vo_adv_5044001_044",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "竟然能夠參與淵源已久的祭典，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們真是來對時機了呢。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "只不過，",
    "voice": "vo_adv_5044001_045",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "今年是否能如期舉辦還不太好說……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "什麼！？",
    "voice": "vo_adv_5044001_046",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這是為什麼！",
    "voice": "vo_adv_5044001_047",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": " 莫非",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是「機關」從中作梗！？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "機關……？ ",
    "voice": "vo_adv_5044001_048",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "不是，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "是因為今年織女大人和牛郎大人感情不睦。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n兩位的化身都已經降臨於神殿，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "卻似乎出現了點問題。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯？",
    "voice": "vo_adv_5044001_049",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": " 所謂的化身",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是指？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "畢竟兩位星宿，",
    "voice": "vo_adv_5044001_050",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "實際上身處銀河啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n所以在七夕的前一週，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "祂們會將類似於自己分身的化身派來人間。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喔。",
    "voice": "vo_adv_5044001_051",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "降臨這片土地的兩人，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "感情不睦是嗎？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "明明是這麼難得的祭典，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是可惜了啊。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "大叔大叔！",
    "voice": "vo_adv_5044001_052",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": " 我還有一個問題……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "請問",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "「祈願竹」",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "和那個七夕祭典",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "有關係嗎？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "哎呀，",
    "voice": "vo_adv_5044001_053",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "妳們竟然還知道「祈願竹」的事。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n有喔，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "七夕祭典開幕後，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "「祈願竹」就會出現。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n它會從裝飾著短冊的細竹，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "變為閃閃發光的祈願竹。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "順便一問，",
    "voice": "vo_adv_5044001_054",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "有從祭典之外的管道",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "獲得「祈願竹」的方法嗎……？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "我想大概是沒有吧。",
    "voice": "vo_adv_5044001_055",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n「祈願竹」",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "只會在那個時候出現。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "怎、",
    "voice": "vo_adv_5044001_056",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "怎麼會……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "該怎麼辦，七七香。",
    "voice": "vo_adv_5044001_057",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n這樣的話，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們不就得不到「祈願竹」了嗎！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好的我沒轍了～！",
    "voice": "vo_adv_5044001_058",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這樣說然後就此放棄，這種事我辦不到啊。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n況且我是真的很想為釣竿的事向流夏姐陪罪！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，",
    "voice": "vo_adv_5044001_059",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你有沒有什麼",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "好辦法？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對耶！",
    "voice": "vo_adv_5044001_060",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這樣下去沒辦法獲得「祈願竹」的話，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那就反過來思考。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我們來幫",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "織女和牛郎解決問題",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不就行了嗎！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "唔姆……",
    "voice": "vo_adv_5044001_061",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "有道理呢。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但是，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要怎麼和流夏說？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我們突然熱心助人，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "她不會覺得很奇怪嗎？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "超奇怪呀～",
    "voice": "vo_adv_5044001_062",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n畢竟我們公會",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "可都是些糟糕到出名的問題人物嘛～",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你們幾個，",
    "voice": "vo_adv_5044001_063",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "從剛剛開始就在",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說什麼悄悄話？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哇！",
    "voice": "vo_adv_5044001_064",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": " 沒、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒有啦，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒什麼是也～！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": " 對吧？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就、",
    "voice": "vo_adv_5044001_065",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就是啊！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": " 妳想太多了，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哈哈哈！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……",
    "voice": "vo_adv_5044001_066",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "算了。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我有事",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "想問你們。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哦哦？",
    "voice": "vo_adv_5044001_067",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": " 是什麼事呢？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "流夏姐？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "今天",
    "voice": "vo_adv_5044001_068",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不是聽說七夕祭",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可能會中止嗎？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我們要不要",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "來想想辦法？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "難得的祭典要是就這樣中止了，",
    "voice": "vo_adv_5044001_069",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你們不覺得有點可憐嗎。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "能碰上這種事也算是某種緣分，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以我想幫幫他們。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你也願意來幫忙嗎？",
    "voice": "vo_adv_5044001_070",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": " 謝謝。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "至於妳們兩個，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要是想好好度假的話，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我是不會強迫──",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "真巧呢～流夏姐！",
    "voice": "vo_adv_5044001_071",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "其實",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們剛剛也在想著要為七夕祭做點什麼喔！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咦，",
    "voice": "vo_adv_5044001_072",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣啊？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "祭典也是度假行程的一部分。",
    "voice": "vo_adv_5044001_073",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要是沒享受到祭典，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們不就白來了。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對吧！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒錯沒錯！",
    "voice": "vo_adv_5044001_074",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": " 我們剛剛也是在討論",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "想參加祭典的事啦！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不必擔心喔，",
    "voice": "vo_adv_5044001_075",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "流夏。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "有了我們的協助，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這個問題",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "肯定馬上就解決了！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總覺得，",
    "voice": "vo_adv_5044001_076",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "被妳這麼一說",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我反而不安起來了，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是錯覺吧……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總之，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "到了明天，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們再去打聽看看牛郎織女的事。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "儘管原因各異，眾人的目的卻只有一個，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n那就是，解決織女與牛郎之間的問題。",
    "voice": null,
    "unit_id": null
  }
