[
  {
    "type": "dialogue",
    "name": "貪吃佩可的聲音",
    "words": "──然後呢！",
    "voice": "vo_adv_9008015_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可的聲音",
    "words": "\\n榮登蘭德索爾的飯糰美食第一名的是──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留的聲音",
    "words": "──給我等一下，",
    "voice": "vo_adv_9008015_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留的聲音",
    "words": "貪吃佩可！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留的聲音",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留的聲音",
    "words": "明明",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留的聲音",
    "words": "第二名和第三名都還沒介紹啊──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501620"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "…………",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}拿著廣播的收訊設備，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到了北方山脈，厄莉絲所居住的城堡中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500510"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………",
    "voice": "vo_adv_9008015_002",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………騎士先生。",
    "voice": "vo_adv_9008015_003",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你來找我了呀。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………",
    "voice": "vo_adv_9008015_004",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n是",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "有什麼事嗎？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "廣播……",
    "voice": "vo_adv_9008015_005",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "即使聽了，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我也仍然，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "沒辦法",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "到外面去喔。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "更何況，",
    "voice": "vo_adv_9008015_006",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我聽了也不會感到開心有趣。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不過，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "也是……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "既然這是騎士先生喜愛的事物……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "只是收聽一會，",
    "voice": "vo_adv_9008015_007",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "或許無妨。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生很努力地",
    "voice": "vo_adv_9008015_008",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "在幫忙，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n這我知道喔。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "偶爾，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "也能稍微聽見你的聲音。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "還請你，",
    "voice": "vo_adv_9008015_009",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "努力到最後。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我",
    "voice": "vo_adv_9008015_010",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "嗎？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……我",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "辦得到嗎？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "既然騎士先生都這麼說了……",
    "voice": "vo_adv_9008015_011",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "目前的我",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "還無法做到。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我先待在這裡收聽吧。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不過，",
    "voice": "vo_adv_9008015_012",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "有朝一日……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可的聲音",
    "words": "──好了接下來！",
    "voice": "vo_adv_9008015_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可的聲音",
    "words": "\\n備受關注的蘭德索爾肉類美食第一名是──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留的聲音",
    "words": "就──說──了──！",
    "voice": "vo_adv_9008015_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留的聲音",
    "words": "\\n別突然就從第一名開始介紹啦",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留的聲音",
    "words": "～！",
    "voice": null,
    "unit_id": null
  }
]
