[
  {
    "type": "background",
    "bg_id": "500081"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "凱留與{0}今天依然在準備考試。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n眼看考試的日子就快到了，兩人也準備得很有幹勁。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……已經這麼晚了？",
    "voice": "vo_adv_5126702_000",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們持續讀了很長一段時間呢。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "稍微休息一下吧。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "今天的狀況感覺滿不錯的，你念書很專注呢。",
    "voice": "vo_adv_5126702_001",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n看來考試",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說不定真的有機會拿高分喔……♪",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯，",
    "voice": "vo_adv_5126702_002",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "幹嘛直盯著我的臉看？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你是有什麼話想說嗎？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊？",
    "voice": "vo_adv_5126702_003",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我怎麼可能會喜歡讀書！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呃……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你說讀書時的我",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看起來",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很樂在其中……？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那是……",
    "voice": "vo_adv_5126702_004",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "或許是這樣吧。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "老實說我自己也覺得很不可思議呢……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我是真的沒有很喜歡讀書喔。",
    "voice": "vo_adv_5126702_005",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為我覺得拚命去記住",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "一堆對將來沒有用處的知識，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n是完全沒有意義的事。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": "vo_adv_5126702_006",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "為什麼我會這麼熱中呢……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "到底是為什麼？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……！",
    "voice": "vo_adv_5126702_007",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "了解未知的事物很有趣……",
    "voice": "vo_adv_5126702_008",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…嗯，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "或許是吧。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "多增加一些新的知識和經驗，",
    "voice": "vo_adv_5126702_009",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n也是很有趣呢。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……在【美食殿堂】的日子",
    "voice": "vo_adv_5126702_010",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "大概就是這個樣子吧。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為遇見了貪吃佩可她們，",
    "voice": "vo_adv_5126702_011",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n結果每天都被捲入",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "意想不到的新事件呢！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……我話先說在前頭，",
    "voice": "vo_adv_5126702_012",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還有你也是喔？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "和你相遇之後……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n讓我學到了",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "許多未知的事物。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "像這樣來學校上課，",
    "voice": "vo_adv_5126702_013",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "放學後讀書複習，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "感受著從窗戶吹進來的輕柔微風……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還有……",
    "voice": "vo_adv_5126702_014",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所謂的青春，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這一切，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都是因為有你……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為有與你相遇，我才能體會到……！",
    "voice": "vo_adv_5126702_015",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你、",
    "voice": "vo_adv_5126702_016",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你說什麼",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也是啊……！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我可沒說",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我很慶幸與你相遇什麼的喔！！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……但我也沒說我覺得討厭。",
    "voice": "vo_adv_5126702_017",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "或者該說，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我不是討厭，而是……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……！",
    "voice": "vo_adv_5126702_018",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n感、",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "感覺好熱呢！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們把窗戶打開吧！！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了，",
    "voice": "vo_adv_5126702_019",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別再聊廢話了！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "考試馬上就要到了！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們要來做最後衝刺，好好努力！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是兩個人就在",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n流入新鮮空氣的教室裡，繼續準備考試──",
    "voice": null,
    "unit_id": null
  }
]
