[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}被雪叫了出來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "讓你久等了。",
    "voice": "vo_adv_1008008_000",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那麼我們就去約會吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦？我沒有說過是約會嗎？",
    "voice": "vo_adv_1008008_001",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n好啦，既然能夠和我約會，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n這些小事都不重要對吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那麼接下來，要先去哪裡──",
    "voice": "vo_adv_1008008_002",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哇，好刺眼……！？",
    "voice": "vo_adv_1008008_003",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n這是，之前的那個！？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "唔哇～",
    "voice": "vo_adv_1008008_004",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "{0}，難得和我一起出門，",
    "voice": "vo_adv_1008008_005",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "多仔細看我一點也沒關係唷？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你看，因為我這麼可愛呢，",
    "voice": "vo_adv_1008008_006",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n所以可以多多欣賞我一點唷？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊，原來如此！",
    "voice": "vo_adv_1008008_007",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是因為我太耀眼了，無法直視我對吧？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "僅僅是存在於世上，就會傷害到人……",
    "voice": "vo_adv_1008008_008",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊，我是多麼罪孽深重啊。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦？為什麼要嘆氣呢？",
    "voice": "vo_adv_1008008_009",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……總覺得你啊，從剛才開始就有點冷淡呢？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要是繼續擺著那種態度，我就要另尋新歡了唷？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只要我使出真本事，",
    "voice": "vo_adv_1008008_010",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n馬上就會被人搭訕的！",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "欸，妳真可愛啊！",
    "voice": "vo_adv_1008008_011",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊，已經來了嗎……？",
    "voice": "vo_adv_1008008_012",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我明明就還沒表現我自己……",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真不愧是我呢！",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要是像我這麼可愛的話，也就沒有必要表現了唷。",
    "voice": "vo_adv_1008008_013",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你也這麼想對吧？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "嗯？什麼啊，原來有男人跟著喔……",
    "voice": "vo_adv_1008008_014",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n比起那種不起眼的傢伙，還是跟我玩比較好吧？",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "欸～該怎麼做呢。",
    "voice": "vo_adv_1008008_015",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我和這個人有很深的羈絆呢。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為呀，我們是赤裸裸坦誠相見的夥伴呢……嘻嘻。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哎呀，",
    "voice": "vo_adv_1008008_016",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "{0}也真是的，\\n害羞起來真是可愛！",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "喂喂喂！",
    "voice": "vo_adv_1008008_017",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n不要無視我在那邊恩恩愛愛的！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "既然這樣我也脫光和妳親密接觸吧！",
    "voice": "vo_adv_1008008_018",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n過來我這裡！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不要啦～",
    "voice": "vo_adv_1008008_019",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n{0}，救我呀～",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "怎樣，你要妨礙我嗎？",
    "voice": "vo_adv_1008008_020",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "只顧著自己快活！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n絕對饒不了你！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "拜託，不要吵架！",
    "voice": "vo_adv_1008008_021",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n不要為了我爭執！",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，聽到我美麗的聲音耳朵都快融化了對吧？",
    "voice": "vo_adv_1008008_022",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過，既然是為了我吵架我就不能不出聲唷！",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這樣啊……都是我太美的錯……",
    "voice": "vo_adv_1008008_023",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你是想這麼說對吧？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "沒錯！就是因為我這麼可愛，所以才有錯的！",
    "voice": "vo_adv_1008008_024",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊，我多麼地罪孽深重……",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "你們兩個，囉哩八唆的吵死了！",
    "voice": "vo_adv_1008008_025",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n既然這樣，用盡全力也要讓妳聽話！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "唔哇，生氣了耶……",
    "voice": "vo_adv_1008008_026",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "看起來不像是能和平對話解決的呢。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我不想讓這個人受傷呢……",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "欸？等等，怎麼了？",
    "voice": "vo_adv_1008008_027",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n為什麼要抓住我的手？",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這樣啊，是為了逃走……",
    "voice": "vo_adv_1008008_028",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……唔，嗯。我知道了。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "絕對不要放開我的手唷？",
    "voice": "vo_adv_1008008_029",
    "unit_id": 100832
  },
  {
    "type": "background",
    "bg_id": "510351"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呼，呼，呼……",
    "voice": "vo_adv_1008008_030",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "總算是逃掉了呢。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n長的太過可愛就會發生這種事，真累人呢。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但是，這就是上天施加在太美麗的我身上，",
    "voice": "vo_adv_1008008_031",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n類似天罰般的東西呀。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真是沒辦法……",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "畢竟比我還要有魅力的事物，",
    "voice": "vo_adv_1008008_032",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n在這個世上是不存在的呢！",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊，但是……",
    "voice": "vo_adv_1008008_033",
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n你拉住我的手的時候……",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有一點點帥唷。",
    "voice": null,
    "unit_id": 100832
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "從今以後，也絕對不要放開我的手唷？",
    "voice": "vo_adv_1008008_034",
    "unit_id": 100832
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，辛苦了。",
    "voice": "vo_adv_1008008_035",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛剛看見的，是如同夢境一般的情景唷。",
    "voice": "vo_adv_1008008_036",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我想你醒來以後很快就會忘記的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以沒關係，現在不用太在意哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過雪不管在「那邊」還是「這邊」，",
    "voice": "vo_adv_1008008_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n完全都沒有改變呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "他覺得自己比誰都可愛。",
    "voice": "vo_adv_1008008_038",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n因為是最可愛的，所以認為就算弄得大家團團轉，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n造成其他人的困擾也不會有問題，大概是這樣吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "對這樣的想法毫無疑慮地深信不疑還挺可怕的呢。",
    "voice": "vo_adv_1008008_039",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯，不過這種厚臉皮的地方也是他的優點，",
    "voice": "vo_adv_1008008_040",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "說實在真的有點羨慕呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，說太多閒談也沒用，",
    "voice": "vo_adv_1008008_041",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這次就先這樣吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "再見囉～♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "終於醒來了呢？",
    "voice": "vo_adv_1008008_042",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我們好像又睡著了唷。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "然後呀，我做了一個不可思議的夢。",
    "voice": "vo_adv_1008008_043",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我夢到，你幫我逃離一個搭訕的男人……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你果然也做了同樣的夢嗎？",
    "voice": "vo_adv_1008008_044",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，果然我們兩個人，是心意相通的呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊，這樣可不行。我們是在約會呢。",
    "voice": "vo_adv_1008008_045",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為不小心睡著，把時間都浪費掉了呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那我們快走吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊，等等！",
    "voice": "vo_adv_1008008_046",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我今天想要被緊緊牽著手漫步呢～",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嘻嘻，絕對不要放開我的手唷？",
    "voice": "vo_adv_1008008_047",
    "unit_id": 100811
  }
]
