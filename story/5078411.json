  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "三位。",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "既然再過不久就要結束了，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n要不要以正義魔法少女的模樣",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "一起擺個招牌姿勢呢！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "「蘭德索爾的和平",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "由我們守護！」",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "類似這種感覺！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "說得也是……",
    "voice": "vo_adv_5078411_004",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "兩位",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "都準備好了嗎？",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "好的，",
    "voice": "vo_adv_5078411_005",
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "伊緒老師！",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "擺個完美姿勢吧♪",
    "voice": "vo_adv_5078411_006",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "這蘭德索爾──",
    "voice": "vo_adv_5078411_007",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "──是屬於老師的♪\\n──是屬於空花的♪\\n──是屬於姐姐的♪",
    "voice": "vo_adv_5078411_008",
    "unit_id": 101812
  }
