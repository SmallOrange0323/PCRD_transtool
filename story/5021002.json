[
  {
    "type": "background",
    "bg_id": "500710"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在海水浴場發現玩偶們莫名消失後，\\n【哞哞自衛隊】的成員們便開始在海邊尋找著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我從海邊頭一路跑到尾端了，",
    "voice": "vo_adv_5021002_000",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n四處都沒看到玩偶們的蹤影～！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "應該不會是遭小偷對吧。",
    "voice": "vo_adv_5021002_001",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我們的行李都還在，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "何況",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要偷走那麼多隻玩偶太引人注目了。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "說是玩偶們自己擅自",
    "voice": "vo_adv_5021002_002",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "跑到其他地方，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n還比較",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "有可能呢。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "自己擅自……",
    "voice": "vo_adv_5021002_003",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "大家……",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是不是",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "已經討厭人家了。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真琴！",
    "voice": "vo_adv_5021002_004",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "抱、",
    "voice": "vo_adv_5021002_005",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "抱歉公主！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　我不是那個意思！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "而且",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳那麼珍惜那些玩偶們，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n它們根本不可能會討厭妳的啦！？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "嗯，",
    "voice": "vo_adv_5021002_006",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不要緊。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "如果是自己跑出去的話，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n那它們也一定會自己回來的。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "先別說那個，",
    "voice": "vo_adv_5021002_007",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "我們先吃午餐吧。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "今天可是難得的假期，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "應該要悠悠哉哉地度過呢。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真步……",
    "voice": "vo_adv_5021002_008",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "公主……",
    "voice": "vo_adv_5021002_009",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生……",
    "voice": "vo_adv_5021002_010",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但是。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊",
    "voice": "vo_adv_5021002_011",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "對了、",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我剛剛在游泳的時候發現附近有個漁村～！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "也許我們能在那裡找到線索也說不定～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "如果霞在場的話，",
    "voice": "vo_adv_5021002_012",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "肯定會說",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要先去打聽情報的吧。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真琴、",
    "voice": "vo_adv_5021002_013",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "香織……",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那樣沒關係嗎？",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "謝謝。",
    "voice": "vo_adv_5021002_014",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "謝謝",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "大家……",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "別放在心上。",
    "voice": "vo_adv_5021002_015",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "既然決定要找了，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們還是先填飽肚子吧。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n三明治能直接拿來吃很方便呢，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "總之先吃點食物墊墊肚子吧。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "說起來肚子真餓扁了～！",
    "voice": "vo_adv_5021002_016",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "吃飽了",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "再開始展開調查吧～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "background",
    "bg_id": "500700"
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦，",
    "voice": "vo_adv_5021002_017",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這種地方竟然有漁村。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這裡似乎很吵雜呢～？",
    "voice": "vo_adv_5021002_018",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n是不是在舉辦祭典呀～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "跳舞就交給我吧～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就祭典而言，",
    "voice": "vo_adv_5021002_019",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這些聲音又有點太刺耳了。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "有種不祥的預感……",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊、",
    "voice": "vo_adv_5021002_020",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "去問那個男的吧！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n吶、",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "能否打擾你一下？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "呀！？",
    "voice": "vo_adv_5021002_021",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "　",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "什、",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "什麼啊，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "是人啊。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "你不要嚇我。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "幹嘛突然怕成這樣啊。",
    "voice": "vo_adv_5021002_022",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……我有這麼恐怖嗎？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真琴一點都不恐怖唷～",
    "voice": "vo_adv_5021002_023",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "打起精神來～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "突然向您搭話，",
    "voice": "vo_adv_5021002_024",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真抱歉呢，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "因為",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這個村子好像很吵雜，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "發生什麼事了嗎？",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "――出現了。",
    "voice": "vo_adv_5021002_025",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊！",
    "voice": "vo_adv_5021002_026",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　你說什麼？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "奄美魔物出現了！",
    "voice": "vo_adv_5021002_027",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "奄美魔物？",
    "voice": "vo_adv_5021002_028",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "　沒聽過的名字呢？",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是某種動物嗎？",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……不是～",
    "voice": "vo_adv_5021002_029",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "知道～",
    "voice": "vo_adv_5021002_030",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒想到會在這種地方",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "聽到故鄉的詞彙呀～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "原來是香織故鄉的詞彙呀。",
    "voice": "vo_adv_5021002_031",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "確實",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "用字挺奇怪的呢。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "公主也差不多吧。",
    "voice": "vo_adv_5021002_032",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "話說，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那個奄美魔物",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是什麼意思？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "奄美魔物",
    "voice": "vo_adv_5021002_033",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "在我的家鄉――",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "――就是惡靈、",
    "voice": "vo_adv_5021002_034",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "妖怪的意思～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "哦。",
    "voice": "vo_adv_5021002_035",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "有人知道這個詞真令我意外。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "這個漁村以前",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "是由一群移居到這裡的人們所建造的，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n他們曾是位於這片海洋遙遠另一邊的某國國民。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "奄美魔物",
    "voice": "vo_adv_5021002_036",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "好像就是那個國家傳過來的詞彙……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那一定就是我的家鄉了～！",
    "voice": "vo_adv_5021002_037",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "居然能聽到家鄉的故事，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "總覺得好高興呀～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "一點都不值得高興吧！？",
    "voice": "vo_adv_5021002_038",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n惡惡惡惡靈和妖怪！？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這就表示……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "沒錯。",
    "voice": "vo_adv_5021002_039",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n剛才",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "奄美魔物一出現，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "就有不少村民遭殃了。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "遭殃了是什麼意思，",
    "voice": "vo_adv_5021002_040",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "到底是怎麼一回事！？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "據說奄美魔物",
    "voice": "vo_adv_5021002_041",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "會奪取靈魂～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "傳聞眾說紛紜，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "「穿過跨下，奪取靈魂」",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "是其中一個著名的妖怪傳說～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "將、",
    "voice": "vo_adv_5021002_042",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "將靈魂……？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "雖然那並不是在奪取性命，",
    "voice": "vo_adv_5021002_043",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "但受到奄美魔物襲擊的人",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "會失去氣力",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "無法動彈。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "實際上，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "那些被襲擊的人們",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "現在都臥病在床。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那樣的確",
    "voice": "vo_adv_5021002_044",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "很像是",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "被奪走靈魂呢。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯～",
    "voice": "vo_adv_5021002_045",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真琴，妳怎麼啦～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "　走路姿勢變內八了唷～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "像平時那樣邁開大步走路呀～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳、",
    "voice": "vo_adv_5021002_046",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳說什麼啊？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　我一直以來都是這樣走路啊！？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好歹我也是女孩子好嗎！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "蛤、",
    "voice": "vo_adv_5021002_047",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "蛤！？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　才沒有這種事好嗎！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我怎麼可能因為那種傳言就感到害怕啊！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你那什麼意思啦。",
    "voice": "vo_adv_5021002_048",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n講的好像是我平常",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "一點都不可愛啊！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呃嗯、",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我也不是想要你說我可愛還怎樣啦……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "總之，",
    "voice": "vo_adv_5021002_049",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我沒在害怕啦！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　你在幹嘛，{0}，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "怎麼蹲下來了，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n為什麼往我這過來……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呀！？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "原來如此，",
    "voice": "vo_adv_5021002_050",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "跨坐在肩膀上就不怕被妖怪穿過跨下了～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "{0}真聰明呀♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真好呢，",
    "voice": "vo_adv_5021002_051",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真琴。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "下一個可以換我嗎……♪",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不不不、",
    "voice": "vo_adv_5021002_052",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "重點不在這好嗎！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "快放我下來！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　用腳夾死你喔！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "還真有活力呢，",
    "voice": "vo_adv_5021002_053",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "你們幾個。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "讓我也稍微放鬆起來了。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "能讓您安心",
    "voice": "vo_adv_5021002_054",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n我們家公會",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "最自豪的就是成員感情融洽唷。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不過，",
    "voice": "vo_adv_5021002_055",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "話題不小心扯遠了，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所以說那個",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "奄美魔物",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "長什麼樣子呢？",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們",
    "voice": "vo_adv_5021002_056",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "現在雖然有重要的事情要去處理，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但身為【哞哞自衛隊】，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "一旦看到遇上困難的人可不能坐視不管呢。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n你願意告訴咱們詳情嗎。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "好的。",
    "voice": "vo_adv_5021002_057",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n我也是剛才偶然間",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "看到那種輕飄飄地飛在空中的模樣，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "那個",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "我怎麼看都覺得是――",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "――玩偶的樣子。",
    "voice": "vo_adv_5021002_058",
    "unit_id": 311
  }
]
