  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團、",
    "voice": "vo_adv_9500019_000",
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團長，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真的選我就可以了嗎？",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你沒事吧？",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒有發燒吧？",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不是說有什麼問題……！",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就是，",
    "voice": "vo_adv_9500019_001",
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那、",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個……",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我真的",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "很開心。",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n很開心團長願意選擇……",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這樣的我。",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個，",
    "voice": "vo_adv_9500019_002",
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "可以",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "捏一下我的臉頰嗎？",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好痛",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "痛痛痛痛，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "果然很痛，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這不是夢對吧？",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n看來不是因為我邊緣人到極點，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "才做了有痛覺的夢。",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "能被團長選擇……",
    "voice": "vo_adv_9500019_003",
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我既開心",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "又緊張。",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "曾覺得朋友是遙不可及的夢想的我……",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個以前無法跟任何人搭話的我，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n如今，已經能像這樣",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "和團長及",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "其他人說話了。",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說起來，",
    "voice": "vo_adv_9500019_004",
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我還和團長一起",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n拯救了別的世界呢！",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n甚至還坐上巨大的機器人，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "展開了一場奇幻無比的大冒險喔！",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嘿嘿……",
    "voice": "vo_adv_9500019_005",
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "因為有團長在身邊……",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n在ＢＢ團的每一天，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "都成為了我的寶物。",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n好希望",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這樣的日子",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "能一直持續下去啊。",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "如、",
    "voice": "vo_adv_9500019_006",
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "如果，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就算未來交到了更多朋友，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n就算變得",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "能和大家聊天了……",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我只是假設喔，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但即便如此……",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我與團長的羈絆",
    "voice": "vo_adv_9500019_007",
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "永遠是",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "特別且珍貴的。",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n今後，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我也想和團長",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "一起去冒險。",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "至今為止，",
    "voice": "vo_adv_9500019_008",
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我與團長一起經歷過好多冒險呢。",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "所以，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我與團長的關係……",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "光是用",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "「朋友」來形容的話，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "總覺得好像有點不夠呢。",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對我而言，",
    "voice": "vo_adv_9500019_009",
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團長",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是特別的人。",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n如果硬要用",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "言語來表達的話──",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那麼，",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就、",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就、",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就就",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就就就就是……！！！",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n戀、",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "戀、",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "戀……",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗚──！",
    "voice": null,
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就是",
    "voice": "vo_adv_9500019_010",
    "unit_id": 104041
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "「戀人」之類的吧────！",
    "voice": null,
    "unit_id": 104041
  }
]
