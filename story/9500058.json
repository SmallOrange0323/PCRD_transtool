[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": "vo_adv_9500058_000",
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "什麼意思？",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n不，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我剛剛沒怎麼在聽，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "來龍去脈大概有一半都搞不懂。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n簡單來說……",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呃，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就是你心目中的",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "第一是我？",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "哦……",
    "voice": "vo_adv_9500058_001",
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，是這樣啊。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n呃，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那就，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好吧，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我就當作",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "被選中了。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "謝啦。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，不對啦……",
    "voice": "vo_adv_9500058_002",
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n抱歉，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我很難做反應，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我完全大意了。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "突然被你那樣說會嚇到的啊。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那樣太狡猾了吧。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦咦……",
    "voice": "vo_adv_9500058_003",
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "因為，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你最近",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "都不太來德蕾女了啊。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n好像",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "總是跑來跑去，到其他女人那裡。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，",
    "voice": "vo_adv_9500058_004",
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我是沒關係喔？",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "反正照例又是在幫助別人吧，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那樣完全沒問題啊──？",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然是沒關係，",
    "voice": "vo_adv_9500058_005",
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但還是",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不太好喔？",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "大家都說很",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "寂寞啊。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "優妮和琪愛兒啊，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "瑪麗亞啊，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "還有班上的人之類的。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "然後，我",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "自己也算",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "多少……",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "稍微……",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "還蠻寂寞的？",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦、",
    "voice": "vo_adv_9500058_006",
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦？",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "什麼？",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "──",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我沒聽清楚。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n等……",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "再一次。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "再把",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "剛剛的話說一次看看。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "哈，",
    "voice": "vo_adv_9500058_007",
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好噁。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話是這麼說，",
    "voice": "vo_adv_9500058_008",
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但剛剛有一瞬間",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "對那種台詞心動了的自己實在太噁了……",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n糟透了吧。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是壞男人和溺愛他的糟糕女人嗎？",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n根本就是一路走向不幸家庭的夫妻嘛。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，",
    "voice": "vo_adv_9500058_009",
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "暫時不用了。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "因為現在的情況很尷尬。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n搞不好我會變成我不想成為的那類女人。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，",
    "voice": "vo_adv_9500058_010",
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "確實啊，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n實際來說的話，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "感覺你就會組建一個幸福的家庭喔。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "感覺超有可能。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "畢竟跟你在一起時，",
    "voice": "vo_adv_9500058_011",
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我偶爾也會這麼想嘛。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "總覺得",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "想跟你一起養小孩",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "之類的？",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我也不太清楚呢。",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呼……",
    "voice": "vo_adv_9500058_012",
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "既然如此，為了光明的未來，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "總之先去拯救世界",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "吧──",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "喂，走吧，",
    "voice": null,
    "unit_id": 110841
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "爸爸。",
    "voice": null,
    "unit_id": 110841
  }
]
