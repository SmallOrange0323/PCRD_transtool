[
  {
    "type": "background",
    "bg_id": "501930"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "未菈帶路所抵達的目的地，是旅館的前面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂喂，",
    "voice": "vo_adv_5111003_000",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這種地方是你們的根據地？",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n就只是一間旅館耶。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這還真是……",
    "voice": "vo_adv_5111003_001",
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "完全沒想到呢。",
    "voice": null,
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "呵呵，",
    "voice": "vo_adv_5111003_002",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "你們以為會是一棟邪惡的宮殿嗎？",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "我說過了吧？",
    "voice": "vo_adv_5111003_003",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "我們既不是侵略者，",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "也不是大壞蛋。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "我們原本只是冒險者……",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "不需要什麼鋪張的城堡。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "在經歷無數冒險之後，",
    "voice": "vo_adv_5111003_004",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "\\n回到旅館時",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "感覺最令人安心，",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "你們懂吧？",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "正因為是隨處可見的普通旅館，",
    "voice": "vo_adv_5111003_005",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "\\n才會成為我和亞斯來能感受到幸福的",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "回憶場所。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……這樣啊。",
    "voice": "vo_adv_5111003_006",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那麼，",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們就趕快和亞斯來做個了──",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "樂園守護者",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 17111
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那、",
    "voice": "vo_adv_5111003_007",
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那是……！",
    "voice": null,
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不安與恐懼的魔物……",
    "voice": "vo_adv_5111003_008",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "而且還是一大群。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還想說一路上都沒看到半隻，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "卻在這最糟糕的時機出現了。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "不是我召喚它們的。",
    "voice": "vo_adv_5111003_009",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "它們是樂園守護者……",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "\\n是防止我們的理想不受破壞、",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "守護幸福的存在。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那就是從人身上跑出來的魔物啊……",
    "voice": "vo_adv_5111003_010",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過，",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "既然對手是魔物，就沒什麼好顧慮的了！",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我要盡情地大鬧一場囉！",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你、",
    "voice": "vo_adv_5111003_011",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你在說什麼啊！",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我怎麼可能那麼做！",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳沒時間應付這些小嘍囉了不是嗎？",
    "voice": "vo_adv_5111003_012",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n打掃就交給我們吧。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對啊！",
    "voice": "vo_adv_5111003_013",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n妳快點去做個了斷，",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "取回重要的胸針吧！",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你們……！",
    "voice": "vo_adv_5111003_014",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "知道了！",
    "voice": "vo_adv_5111003_015",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "{0}，謝謝你！",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你們一定要追上來喔！",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "滾開滾開──！",
    "voice": "vo_adv_5111003_016",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大壞蛋諾維姆要登場",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "了──",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "──咦？",
    "voice": "vo_adv_5111003_017",
    "unit_id": 125013
  },
  {
    "type": "background",
    "bg_id": "501940"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這、",
    "voice": "vo_adv_5111003_018",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這裡是……",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "花田？",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我剛剛",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是走進了旅館裡，",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "對吧？",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "這裡是我和亞斯來",
    "voice": "vo_adv_5111003_019",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "第一次的冒險時抵達的花田。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "沒錯，",
    "voice": "vo_adv_5111003_020",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "所以我把這代表我們幸福回憶的地方",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "實體化了。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "\\n",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "我們一輩子都忘不了……",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "這景象非常美麗吧？",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "亞斯來……！",
    "voice": "vo_adv_5111003_021",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "好了，",
    "voice": "vo_adv_5111003_022",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "妳總算來了啊，",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "矛依未。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "\\n妳終於下定決心了嗎？",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "對，",
    "voice": "vo_adv_5111003_023",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我的答案，你好好聽著！",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "快給我把這傢伙變回胸針！",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "啊，好痛，",
    "voice": "vo_adv_5111003_024",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "諾維姆，給我等一下～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n妳這樣對我，會不會太過分了啊？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "少囉嗦！",
    "voice": "vo_adv_5111003_025",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "竟然隨便使用我的回憶！",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我絕對饒不了你！",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "嗯，",
    "voice": "vo_adv_5111003_026",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "看來妳不太中意的樣子呢。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "\\n",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "看來我做錯了，",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "我道歉。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "不過，",
    "voice": "vo_adv_5111003_027",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "像這樣與幸福的回憶面對面，妳應該了解了吧？",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "未來是不確定的，",
    "voice": "vo_adv_5111003_028",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "而且可能受到他人影響，變成我們不希望的模樣。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "正因如此，",
    "voice": "vo_adv_5111003_029",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "只要持續觀看",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "永遠幸福、溫柔又美好的過去，",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "\\n",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "就不會受傷、",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "也不必受苦，",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "難道不是嗎？",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "對，",
    "voice": "vo_adv_5111003_030",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "沒錯……",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "因為我現在也仍然為與尾狗刀離別這件事感到悲傷。",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我也很想回到和尾狗刀一起做壞事的那段時光。",
    "voice": "vo_adv_5111003_031",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n雖然這傢伙是冒牌貨，",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但和他聊天的這段時間真的很快樂……",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但即使如此……",
    "voice": "vo_adv_5111003_032",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "和緊抓著幸福回憶不放相比，",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我更想要在未來與搭檔重逢！",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "然後",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "再創造新的回憶！",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "阻礙我的人，",
    "voice": "vo_adv_5111003_033",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我將讓他嚐到大壞蛋的怒火！",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n明白了嗎！？",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "矛依未……",
    "voice": "vo_adv_5111003_034",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "妳和我是有著相同境遇，如同鏡子般的存在。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "可是，",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "可是為什麼我們會如此不同呢？",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "我相信我們正在做的事情並沒有錯……",
    "voice": "vo_adv_5111003_035",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "然而，",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "妳那堅信未來的模樣……",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "讓我覺得有些耀眼。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "呵呵──！",
    "voice": "vo_adv_5111003_036",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳發現我滿溢的壞蛋魅力了嗎？",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n妳很有品味嘛！",
    "voice": null,
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "未菈……",
    "voice": "vo_adv_5111003_037",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "看來妳",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "稍微被矛依未感化了呢。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "亞斯來，",
    "voice": "vo_adv_5111003_038",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "不是的……",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "我……",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "矛依未，",
    "voice": "vo_adv_5111003_039",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "我本來希望",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "讓妳透過幸福的時間",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "\\n",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "了解在回憶中生活有多棒。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "甚至使用了將回憶中重要的人實體化的",
    "voice": "vo_adv_5111003_040",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "這種",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "特殊方法。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "但是",
    "voice": "vo_adv_5111003_041",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "我卻無法改變妳的心意。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "\\n",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "再這樣下去，妳會阻礙我們的目標吧。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "所以──",
    "voice": "vo_adv_5111003_042",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "亞斯來……！",
    "voice": "vo_adv_5111003_043",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "不能那麼做！",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "我要奪走",
    "voice": "vo_adv_5111003_044",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "妳的回憶。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊……",
    "voice": "vo_adv_5111003_045",
    "unit_id": 125013
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "矛依未……",
    "voice": "vo_adv_5111003_046",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "怎麼會這樣……",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗚哇！",
    "voice": "vo_adv_5111003_047",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這是怎麼回事？",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這真的是旅館裡面嗎？",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘉夜、",
    "voice": "vo_adv_5111003_048",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}！",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n那邊好像有人……",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "騙人，",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "倒在地上的，",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是矛依未……？",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂，我說你們！",
    "voice": "vo_adv_5111003_049",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "明明說自己是樂園的引導者，說要救人，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n那這是怎麼回事啊！",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "我們溝通過了。",
    "voice": "vo_adv_5111003_050",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "然而，",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "我們沒能互相理解。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "\\n",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "所以",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "為了讓她不再繼續感到痛苦──",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "我把她的回憶全都奪走了。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "把回憶……",
    "voice": "vo_adv_5111003_051",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "全都？",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "現在的她",
    "voice": "vo_adv_5111003_052",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "回憶全都消失了，",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "\\n",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "因此向未來邁進的意志也消失了。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "就像",
    "voice": "vo_adv_5111003_053",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "陷入了時間停止的狀態。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "雖然感受不到幸福，",
    "voice": "vo_adv_5111003_054",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "但也",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "感覺不到痛苦。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "\\n",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "這也",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "可說是另一種救贖吧。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "抱歉，",
    "voice": "vo_adv_5111003_055",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "都怪我力量不足，",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "\\n",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "所以沒能讓妳成為樂園的居民……",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你這傢伙，",
    "voice": "vo_adv_5111003_056",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "在開什麼玩笑──",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "對不起……",
    "voice": "vo_adv_5111003_057",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "我沒能",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "阻止亞斯來……",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "\\n",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "真的，",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "很對不起……",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "未菈……",
    "voice": "vo_adv_5111003_058",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "亞",
    "voice": "vo_adv_5111003_059",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "斯來……",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "這麼做是不對的……",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "這樣子根本稱不上是幸福。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "\\n沒必要做到這種地步啊！",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "我也感到十分遺憾啊。",
    "voice": "vo_adv_5111003_060",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "\\n",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "但是，",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "為了實現和妳共同的目標，",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "\\n讓所有人都成為樂園的居民，",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "這也是不得已而為之。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "希望妳能原諒我。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "啊……",
    "voice": "vo_adv_5111003_061",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "那時候",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "你也是這樣……",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "說是為了",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "目標……",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "\\n你真的是",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "一點都沒變呢……",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "那時候……？",
    "voice": "vo_adv_5111003_062",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "唔，",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "我不明白妳在說什麼。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "未菈",
    "words": "…………",
    "voice": "vo_adv_5111003_063",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "好了，",
    "voice": "vo_adv_5111003_064",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "就只剩下你們了。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "\\n",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "抵抗是沒有意義的，",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "至少",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "要讓你們幾個",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "成為樂園的居民──",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "混帳，給我閉嘴！",
    "voice": "vo_adv_5111003_065",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "喝啊啊──！",
    "voice": "vo_adv_5111003_066",
    "unit_id": 124811
  },
  {
    "type": "background",
    "bg_id": "501940"
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "……唔。",
    "voice": "vo_adv_5111003_067",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "\\n",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "說什麼都沒用嗎？",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "我們其實並不想跟你們戰鬥的。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就算你們不想，",
    "voice": "vo_adv_5111003_068",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們倒是挺想的！",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "我知道了。",
    "voice": "vo_adv_5111003_069",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "就像你們擁有堅信的事物一般，",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "\\n",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "我也有必須達成的使命。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "既然你們打算刀劍相向──",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "那我也",
    "voice": "vo_adv_5111003_070",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "要做出相應的對策了。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "background",
    "bg_id": "501940"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呃，",
    "voice": "vo_adv_5111003_071",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不愧是前冒險者，真難纏。",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是啊，",
    "voice": "vo_adv_5111003_072",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但感覺這傢伙的強大不僅於此。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我有不好的預感……",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "別掉以輕心了！",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "我並不想再繼續傷害你們。",
    "voice": "vo_adv_5111003_073",
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "請你們",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "收起武器吧。",
    "voice": null,
    "unit_id": 17211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "唔，",
    "voice": "vo_adv_5111003_074",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那高高在上的姿態，",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有點討厭耶。",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n好像自己已經贏了一樣。",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "身為偶像，",
    "voice": "vo_adv_5111003_075",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我比任何人都更能看見未來的希望，",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "並且持續給予許多人勇氣！",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n所以我不會在這種地方止步不前！",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我才不管你們發生過什麼事。",
    "voice": "vo_adv_5111003_076",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但是，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我也是靠著這雙拳頭活到了現在。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我絕對不會屈服於過去！",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜、望",
    "words": "喝啊啊啊啊啊！！",
    "voice": "vo_adv_5111003_077",
    "unit_id": null
  }
]
