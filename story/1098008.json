[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾天後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}邀請拉姆一起去散步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "話說回來，",
    "voice": "vo_adv_1098008_000",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n為什麼拉姆非得陪你一起散步不可。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆沒在跟你討論開不開心。",
    "voice": "vo_adv_1098008_001",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n而是不知道這樣漫無目地走著到底有什麼意義。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆要回去了。",
    "voice": "vo_adv_1098008_002",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "什麼？",
    "voice": "vo_adv_1098008_003",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "反正一定又是在計劃什麼才會把拉姆給帶出來對吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你有問題想問？",
    "voice": "vo_adv_1098008_004",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……你問說拉姆有沒有開始變得信任你們，",
    "voice": "vo_adv_1098008_005",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "還以為你要問什麼呢……",
    "voice": "vo_adv_1098008_006",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098008_007",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "唉……",
    "voice": "vo_adv_1098008_008",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n你以為擺出一副悲傷的表情",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆就會溫柔地回答你的話可就大錯特錯了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098008_009",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……不過。",
    "voice": "vo_adv_1098008_010",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "與你們處在一起，",
    "voice": "vo_adv_1098008_011",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n至少讓拉姆，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "了解到了一件事。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "哎呀，",
    "voice": "vo_adv_1098008_012",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "已經走到公會小屋了呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "散步可以結束了吧。",
    "voice": "vo_adv_1098008_013",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n拉姆已經累了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "拉姆！",
    "voice": "vo_adv_1098008_014",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "歡迎妳來！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一定很累了對吧。",
    "voice": "vo_adv_1098008_015",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這邊請，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請到那裡坐吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "…………\\n不用妳說拉姆也會休息的。",
    "voice": "vo_adv_1098008_016",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "因為多虧了某人讓我浪費了體力。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "{0}，辛苦了。",
    "voice": "vo_adv_1098008_017",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n拉姆那傢伙，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還是一樣很冷漠呢……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": "vo_adv_1098008_018",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "時機勉強沒問題。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n雖然稍微早到了一點，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但總算是有準備好了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "拉姆她有起疑嗎？",
    "voice": "vo_adv_1098008_019",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……嗯，",
    "voice": "vo_adv_1098008_020",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很好。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "以你來說做得很棒了！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可，",
    "voice": "vo_adv_1098008_021",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可蘿仔，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "準備好了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "了解了！",
    "voice": "vo_adv_1098008_022",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "要上了哦。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n預備……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "美食殿堂",
    "words": "「拉姆！」\\n「拉姆小姐。」\\n「拉姆！」",
    "voice": "vo_adv_1098008_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "什麼？",
    "voice": "vo_adv_1098008_024",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "其實我們，",
    "voice": "vo_adv_1098008_025",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n為拉姆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "準備了一個驚喜派對！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "鏘鏘鏘～！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這是──",
    "voice": "vo_adv_1098008_026",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "傳說的番薯！",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒錯，",
    "voice": "vo_adv_1098008_027",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "正是那個傳說的番薯。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n居然一眼就能看出來，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真不愧是拉姆小姐。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "當然啊，",
    "voice": "vo_adv_1098008_028",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "怎麼可能忘記。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n拚上性命去採的番薯，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不管是過去還是未來都只有那次了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過……",
    "voice": "vo_adv_1098008_029",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那時候採到的番薯",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "應該都被大家吃完了……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那這番薯是從哪來的呢？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是不可思議……！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯哼。",
    "voice": "vo_adv_1098008_030",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "其實啊。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們居然居然，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "為了能讓拉姆開心，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n又再一次",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "去到那個地方採集傳說的番薯了！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "居然特地，",
    "voice": "vo_adv_1098008_031",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "又再一次……",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "上一次，",
    "voice": "vo_adv_1098008_032",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉姆小姐透過",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n親自招待我們傳說的蒸番薯，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來表達感謝之意。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是拉姆小姐才是，",
    "voice": "vo_adv_1098008_033",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n從平日就",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "陪著我們一起，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總是",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "幫了我們很多忙。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆可沒有幫你們的意思。",
    "voice": "vo_adv_1098008_034",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "失禮了。",
    "voice": "vo_adv_1098008_035",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這只是",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就結果來說。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過",
    "voice": "vo_adv_1098008_036",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下幾人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n事實上真的有受到拉姆小姐的幫助。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以",
    "voice": "vo_adv_1098008_037",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下幾人才會打算，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這次換成由我們這邊，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來對拉姆小姐表達感謝之意。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098008_038",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過畢竟對象是妳啊？",
    "voice": "vo_adv_1098008_039",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以想說普通的方法妳應該不會高興。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以才會，",
    "voice": "vo_adv_1098008_040",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n像這樣計劃了一個驚喜派對。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳看，",
    "voice": "vo_adv_1098008_041",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這麼多傳說的番薯！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳應該也沒想過，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可以再吃到它吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098008_042",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼哼。",
    "voice": "vo_adv_1098008_043",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就算是拉姆，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也被嚇到說不出話來了吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼哼哼哼！！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱、",
    "voice": "vo_adv_1098008_044",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要是太得意過頭的話，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "驚喜派對的價值會有降低的危險……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗚……",
    "voice": "vo_adv_1098008_045",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也對。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為採番薯的過程實在是太辛苦了，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以我不禁就。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不會，",
    "voice": "vo_adv_1098008_046",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下很了解您的心情。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這段路途並沒有輕鬆到，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n因為是第二次",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就能比較簡單……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "委婉一點講",
    "voice": "vo_adv_1098008_047",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就是個地獄呢☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然已經有所覺悟……",
    "voice": "vo_adv_1098008_048",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但果然還是超乎想像的嚴酷，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就連凱留小姐，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "途中也都眼眶泛淚。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "甚至還有一些地方",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是讓貪吃佩可小姐背著走的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這樣虧妳還能擺出那副得意的臉呢，",
    "voice": "vo_adv_1098008_049",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "凱留。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別、",
    "voice": "vo_adv_1098008_050",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別再提我的事了！！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "聽好囉？",
    "voice": "vo_adv_1098008_051",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n所以說，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們想說的是……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "想對妳……",
    "voice": "vo_adv_1098008_052",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對拉姆妳。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "表達感謝之意，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就是這樣啦。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉姆小姐。",
    "voice": "vo_adv_1098008_053",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n您可以允許在下幾人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n來舉辦蒸番薯的驚喜派對嗎。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098008_054",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "哈！",
    "voice": "vo_adv_1098008_055",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n對拉姆表達感謝是理所當然的事。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n隨你們喜歡吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……不過話說回來，",
    "voice": "vo_adv_1098008_056",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n居然能將那番薯給採了這麼多回來。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真的是，",
    "voice": "vo_adv_1098008_057",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "太不正常了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……拉姆小姐她……？",
    "voice": "vo_adv_1098008_058",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n看起來，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好像有點開心。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對吧？",
    "voice": "vo_adv_1098008_059",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我也這麼認為！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看起來有點開心對吧！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是太好了。",
    "voice": "vo_adv_1098008_060",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n因為在下幾人一直煩惱著該如何讓拉姆小姐開心，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n只想著這件事，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一路祕密準備了過來。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們做到了～！",
    "voice": "vo_adv_1098008_061",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n驚喜",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大成功☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嘿嘿。",
    "voice": "vo_adv_1098008_062",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如何啊，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "拉姆！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "如果妳是說讓拉姆驚喜這件事的話……",
    "voice": "vo_adv_1098008_063",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n確實你們準備了傳說的番薯讓拉姆嚇一跳，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "但你們私底下在計劃著什麼，這拉姆早就發現了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……咦？",
    "voice": "vo_adv_1098008_064",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦咦咦！？",
    "voice": "vo_adv_1098008_065",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也就是說",
    "voice": "vo_adv_1098008_066",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "該不會……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "如果想瞞著拉姆還得再做得更好一點呢。",
    "voice": "vo_adv_1098008_067",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這陣子，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "很常從廚房裡傳來",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n有人正在談論著拉姆的聲音──",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "而且公會小屋也一直聞得到番薯的味道。",
    "voice": "vo_adv_1098008_068",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "很明顯是在研究蒸番薯的方法。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "居、",
    "voice": "vo_adv_1098008_069",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "居然，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "早就露餡了！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "順便姑且還是說一下。",
    "voice": "vo_adv_1098008_070",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你們為了生火而想放進爐灶的柴火，",
    "voice": "vo_adv_1098008_071",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n之前下雨時淋濕了，所以是燒不起來的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可、凱留",
    "words": "……咦！！！！",
    "voice": "vo_adv_1098008_072",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雖然你們為了今天而把柴火保存在屋簷下，",
    "voice": "vo_adv_1098008_073",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n但雨水是會飄進那裡的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真是不小心呢，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "凱留。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "確實……",
    "voice": "vo_adv_1098008_074",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n前陣子剛下過雨……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳……",
    "voice": "vo_adv_1098008_075",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳有發現的話倒是說一聲啊！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們這樣鬼鬼祟祟不就顯得很丟臉嗎！！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "別太小看拉姆好嗎。",
    "voice": "vo_adv_1098008_076",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那種不解風情的事拉姆怎麼可能會做呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "如果是為了拉姆而準備的東西，",
    "voice": "vo_adv_1098008_077",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n那麼好好收下才是該有的禮貌。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉姆小姐……",
    "voice": "vo_adv_1098008_078",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "而且，",
    "voice": "vo_adv_1098008_079",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "如果還是傳說的番薯。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n沒在最佳狀態下收下就太可惜了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "所以說，",
    "voice": "vo_adv_1098008_080",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "{0}，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "把力量借給拉姆吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這是在懲罰你帶著拉姆四處走動浪費體力。",
    "voice": "vo_adv_1098008_081",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "別站著發呆啊，",
    "voice": "vo_adv_1098008_082",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n你平常對貪吃佩可她們做的那個也對拉姆做吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉姆小姐……！",
    "voice": "vo_adv_1098008_083",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "芙拉！",
    "voice": "vo_adv_1098008_084",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇、",
    "voice": "vo_adv_1098008_085",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇哇哇哇！？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n風把柴火……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一瞬間就吹乾了！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "把番薯放到上面的容器後，",
    "voice": "vo_adv_1098008_086",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n就把火種加進柴火裡吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好、",
    "voice": "vo_adv_1098008_087",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好的～～！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉姆小姐，",
    "voice": "vo_adv_1098008_088",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n準備，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都完成了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "如果不想被燒傷的話，",
    "voice": "vo_adv_1098008_089",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n就離遠一點。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……呼！",
    "voice": "vo_adv_1098008_090",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇啊啊啊啊！",
    "voice": "vo_adv_1098008_091",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這次換成柴火，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "被芙拉的風給一口氣……！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "蒸番薯最重要的就是火候。",
    "voice": "vo_adv_1098008_092",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n好好看著拉姆是怎麼做的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "美食殿堂",
    "words": "哇啊啊啊啊……！",
    "voice": "vo_adv_1098008_093",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "蒸好的傳說番薯，",
    "voice": "vo_adv_1098008_094",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n熱騰騰閃亮亮☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "香甜的味道裡還帶了點，",
    "voice": "vo_adv_1098008_095",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n撲鼻的極致香氣。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是……",
    "voice": "vo_adv_1098008_096",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n明明是要給驚喜，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "結果卻還是讓拉姆幫忙了……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總覺得",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有點不甘心～",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "跟你們特地去採集傳說番薯所耗費的勞力比起來，這根本不算什麼。",
    "voice": "vo_adv_1098008_097",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "越來越覺得不甘心了！",
    "voice": "vo_adv_1098008_098",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆只是，",
    "voice": "vo_adv_1098008_099",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "在對善意做出回應而已。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……你居然還記得？",
    "voice": "vo_adv_1098008_100",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……算了，也罷。",
    "voice": "vo_adv_1098008_101",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "關於你們，拉姆了解到一件事。",
    "voice": "vo_adv_1098008_102",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那就是，",
    "voice": "vo_adv_1098008_103",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "想再多也沒有用。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "因為有太多拉姆無法理解的行為了。",
    "voice": "vo_adv_1098008_104",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n對於無法理解的事想再多也沒有用不是嗎。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "所以，對於你們的善意，",
    "voice": "vo_adv_1098008_105",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆決定就這樣直接收下了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "到頭來，",
    "voice": "vo_adv_1098008_106",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆的結論就是這樣做最好。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉姆小姐……",
    "voice": "vo_adv_1098008_107",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n原來您之所以接受這個派對，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n是因為這個緣故。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……可、",
    "voice": "vo_adv_1098008_108",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可是啊。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n一直都無法了解，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "拉姆妳，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "覺得這樣就好了嗎……？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n都不會想要",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "稍微去",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "了解一點嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真是蠢問題呢，",
    "voice": "vo_adv_1098008_109",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "凱留。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "想要知曉一切，那是何等「強欲」。",
    "voice": "vo_adv_1098008_110",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n而且有不知道的事情存在，才比較不會無聊啊。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊……",
    "voice": "vo_adv_1098008_111",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是嗎……！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "當然，如果會危及雷姆及愛蜜莉雅大人的話，",
    "voice": "vo_adv_1098008_112",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n拉姆也不會坐視不管的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不過至少你們看起來不會去打那種壞主意。",
    "voice": "vo_adv_1098008_113",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "既然如此，",
    "voice": "vo_adv_1098008_114",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "公會【美食殿堂】。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "從今以後也要好好取悅拉姆哦。",
    "voice": "vo_adv_1098008_115",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳哦……",
    "voice": "vo_adv_1098008_116",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n別隨便把人當成搞笑藝人啊。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "哎呀。",
    "voice": "vo_adv_1098008_117",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "妳這不是很有自知之明嗎，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "凱留。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "比起這種事，",
    "voice": "vo_adv_1098008_118",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n這難得的傳說蒸番薯，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "來趁熱吃吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "接受善意的方式，",
    "voice": "vo_adv_1098008_119",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳再重新思考一下會比較好哦！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好啦好啦小凱留。",
    "voice": "vo_adv_1098008_120",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼就趕快！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "來開動吧～☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個味道…………",
    "voice": "vo_adv_1098008_121",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是至今為止，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "吃過最好吃的呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "確實……",
    "voice": "vo_adv_1098008_122",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "比之前吃的時候，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還要更好吃……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "為什麼！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "…………\\n還真的是，",
    "voice": "vo_adv_1098008_123",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
