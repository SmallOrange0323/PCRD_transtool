[
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "真的是有夠難纏的傢伙。",
    "voice": "vo_adv_5061322_000",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "好啊，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "妾身就親自當妳們的對手吧。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n妳們以為可以輕易打倒我嗎？",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "唔！",
    "voice": "vo_adv_5061322_001",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好強的氣場……",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這壓迫感可夠我們受了。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n相當麻煩呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真琴，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "妳還撐得住嗎？",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂喂公主，",
    "voice": "vo_adv_5061322_002",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳以為是在跟誰說話啊？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我們可是不管面對什麼樣的對手，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "都不會退縮的【哞哞自衛隊】耶！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "她",
    "voice": "vo_adv_5061322_003",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真的好強……",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "她看起來更是寂寞的樣子。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我能明白她的心情。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "因為我也常因外表而遭人拒絕。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過，",
    "voice": "vo_adv_5061322_004",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我被夥伴們拯救了。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n正因為是這樣的我，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "一定可以救得了她……",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我會救她的！　",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我要上囉，公主殿下！",
    "voice": "vo_adv_5061322_005",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我絕對不會",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "放棄妳的！",
    "voice": null,
    "unit_id": 115811
  }
]
