    "name": "莉瑪",
    "words": "真的嗎！？",
    "voice": "vo_adv_1052012_034",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "謝謝，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我等妳來！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "士兵",
