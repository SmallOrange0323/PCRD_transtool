    "voice": "vo_adv_1052012_030",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "實在非常抱歉。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n看來是",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "我們誤會了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "因為妳那身玩偶裝實在過於真實了……",
    "voice": "vo_adv_1052012_031",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？　",
    "voice": "vo_adv_1052012_032",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是、",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是嗎？　",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊、",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我才是，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真對不起。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "啊、",
    "voice": "vo_adv_1052012_033",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "是！　",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "話又說回來，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "真是有魄力的演技呢！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "\\n",
