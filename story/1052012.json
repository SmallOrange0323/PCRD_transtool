  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "決定出演舞台劇的莉瑪，\\n連日努力不懈地進行嚴厲又熱烈的練習。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "對不起！　",
    "voice": "vo_adv_1052012_000",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "麻煩讓我再來一次！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "不，",
    "voice": "vo_adv_1052012_001",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "先休息一下吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "要好好休息，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "轉換一下氣氛吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "辛苦了。",
    "voice": "vo_adv_1052012_002",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "謝謝你",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "每天都這樣",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "陪在我身邊。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我都一直被罵，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你看著也覺得很沒意思吧？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你說沒這回事？　",
    "voice": "vo_adv_1052012_003",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就算是為了願意這麼對我說的你，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我必須努力才行呢！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "女性工作人員",
    "words": "我拿水來了喔，",
    "voice": "vo_adv_1052012_004",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性工作人員",
    "words": "莉瑪。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哇～！　",
    "voice": "vo_adv_1052012_005",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "謝謝妳！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "女性工作人員",
    "words": "莉瑪，",
    "voice": "vo_adv_1052012_006",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性工作人員",
    "words": "妳的表現越來越好了，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性工作人員",
    "words": "保持這個步調繼續加油！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性工作人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性工作人員",
    "words": "那麼，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性工作人員",
    "words": "我還有",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性工作人員",
    "words": "別的工作先走了！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "除了你之外，",
    "voice": "vo_adv_1052012_007",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "還有其他",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那樣關心我的人在，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我不努力可不行呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就算是導演，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也是為我好才責罵我的。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "其實我",
    "voice": "vo_adv_1052012_008",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "對被罵這件事",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "還挺樂在其中的。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "因為我總是被人所畏懼，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "所以覺得很新鮮吧？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "能夠盡全力，",
    "voice": "vo_adv_1052012_009",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "然後被責罵、",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "被鼓勵。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真的讓我好開心。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "正因為如此，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我更應該要回應大家的期待呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "會加油的，請好好看著我喔！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "住戶",
    "words": "就是那裡！",
    "voice": "vo_adv_1052012_010",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "是這裡嗎！",
    "voice": "vo_adv_1052012_011",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n那個把魔物帶到城鎮裡的劇團！！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呀！？　",
    "voice": "vo_adv_1052012_012",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "怎麼了怎麼了！？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "女性工作人員",
    "words": "魔、",
    "voice": "vo_adv_1052012_013",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性工作人員",
    "words": "魔物！？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性工作人員",
    "words": "\\n在哪裡！？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "做什麼啊，",
    "voice": "vo_adv_1052012_014",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "你這傢伙！　",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "怎麼突然間硬闖進來！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "大、",
    "voice": "vo_adv_1052012_015",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "大家冷靜下來！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "已經習慣這種事情了！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是啊，",
    "voice": "vo_adv_1052012_016",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "事情果然會變成這樣……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n至今事情都像奇蹟般順利進行，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但這也無可奈何呢……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就、",
    "voice": "vo_adv_1052012_017",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就是說呢！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "都已經到這地步了，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我怎麼可以放棄呢！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "！？",
    "voice": "vo_adv_1052012_018",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n對啊！　",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這裡才沒有什麼魔物呢！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "你們鬼鬼祟祟在說些什麼！",
    "voice": "vo_adv_1052012_019",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "要是想反抗，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "我是不會客氣的！！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "看來就算這樣你們也沒有要放棄啊。",
    "voice": "vo_adv_1052012_020",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n要讓你們嚐點苦頭了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "展現練習的成果？　",
    "voice": "vo_adv_1052012_021",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是因為",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "魔物不會演戲嗎？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也是呢！　",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "會盡全力去做的！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "請你好好看著喔，{0}。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "做、",
    "voice": "vo_adv_1052012_022",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "做什麼！？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "\\n不准妳再靠近了！！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要是想殺的話，",
    "voice": "vo_adv_1052012_023",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那就動手殺吧！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我也",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "和你同樣",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "留著鮮紅的血，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n你就用那雙眼好好確認吧！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我是人類！　",
    "voice": "vo_adv_1052012_024",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "即使被變成這個樣子，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我的血與心，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n也依然是個人類啊！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不如乾脆",
    "voice": "vo_adv_1052012_025",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "讓我流著",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "青藍之血、擁有冰冷的心，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我就無須受到這樣的折磨了！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "來吧，",
    "voice": "vo_adv_1052012_026",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "用那把劍",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "割斷我的喉嚨吧！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那麼，",
    "voice": "vo_adv_1052012_027",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "在那之後",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你若是能有那麼一點後悔之心，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n就能毫無疑問地",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "相信我是個人類了……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我、",
    "voice": "vo_adv_1052012_028",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我做到了！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我覺得這是我有史以來演得最好的一次！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但這次",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "說不定就會變成我最後一次演戲了……",
