    "name": "莉瑪",
    "words": "那麼，",
    "voice": "vo_adv_1052012_038",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "重新開始練習吧！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "練習期間雖然發生了不少事，",
    "voice": "vo_adv_1052012_039",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n但不管是哭是笑，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "都終於要正式演出了……",
