    "name": "莉瑪",
    "words": "到那時候，",
    "voice": "vo_adv_1052012_047",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不曉得我是否能夠穿上這套禮服呢？",
