[
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當{0}正和禊在挖地洞時，\\n突然被一陣詭異的光線給包圍住。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗚哇，好刺眼！？",
    "voice": "vo_adv_1004008_000",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這道光，是之前的……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗚哇哇哇！！",
    "voice": "vo_adv_1004008_001",
    "unit_id": 100411
  },
  {
    "type": "still",
    "still_id": "100400801"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥，早安──！",
    "voice": "vo_adv_1004008_002",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n早晨令人神清氣爽呢！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……一大早的太有精神了？",
    "voice": "vo_adv_1004008_003",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n是這樣嗎？",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊不管早上中午晚上，",
    "voice": "vo_adv_1004008_004",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n隨時都超有精神的！耶耶！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "而且呢～哥哥！你快點看！",
    "voice": "vo_adv_1004008_005",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n這衣服超級帥的吧？",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "欸嘿嘿，這是媽媽買給禊的呢～",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊想要讓哥哥看這件衣服，",
    "voice": "vo_adv_1004008_006",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n所以才會叫哥哥過來的～",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，不只這件事情而已！",
    "voice": "vo_adv_1004008_007",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n禊還有重要的事情呢！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥，你看這個！",
    "voice": "vo_adv_1004008_008",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這個東西，是這附近的地圖吧？",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這是在爸爸的房間裡找到的～",
    "voice": "vo_adv_1004008_009",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "然後呀，哥哥看這裡！有個記號呢！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這一定是爸爸畫的記號！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510070"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "既然爸爸特地在這裡畫上記號，",
    "voice": "vo_adv_1004008_010",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n表示一定有什麼東西！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "說不定，這裡可能埋著寶藏呢！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥真是太上道了！",
    "voice": "vo_adv_1004008_011",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那我們趕快去找寶藏吧～！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "欸～才不會發生什麼事咧～",
    "voice": "vo_adv_1004008_012",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥太愛操心了～",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n我們去找找看呀～",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們已經離目標很近了！",
    "voice": "vo_adv_1004008_013",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯……再前面一點嗎？",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "應該就在這附近吧……",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦？腳下好像有奇怪的聲音……",
    "voice": "vo_adv_1004008_014",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……挖！地板開了個洞！？",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哇啊啊啊！？",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好痛痛……",
    "voice": "vo_adv_1004008_015",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n這是陷阱地洞嗎？",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "是爸爸挖的嗎？",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥，你沒事吧？",
    "voice": "vo_adv_1004008_016",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊哈哈！真是拿你沒辦法呀，哥哥！",
    "voice": "vo_adv_1004008_017",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥要振作一點呀～",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯！",
    "voice": "vo_adv_1004008_018",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n禊對於地洞陷阱很在行！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "像這種高度的地洞，才不會受傷呢！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不過，禊沒想到這裡竟然會有地洞陷阱，",
    "voice": "vo_adv_1004008_019",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n哥哥也嚇了一跳吧？",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "真不愧是爸爸！",
    "voice": "vo_adv_1004008_020",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n如果是禊的話，可沒辦法挖得這麼漂亮呢！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯……",
    "voice": "vo_adv_1004008_021",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n不過為什麼會在有地洞的地方",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n畫上記號呢？",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "奇怪？",
    "voice": "vo_adv_1004008_022",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n哥哥，好像有東西埋在這裡呢！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這是什麼東西呀？",
    "voice": "vo_adv_1004008_023",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們挖出來看看吧？",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嘿咻、",
    "voice": "vo_adv_1004008_024",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嘿咻……",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這個東西……是木箱？",
    "voice": "vo_adv_1004008_025",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n這是爸爸埋在這裡的嗎？",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥，要怎麼處理呢？",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊知道了！",
    "voice": "vo_adv_1004008_026",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這樣的話，禊要對著哥哥打開囉！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……嗯嗯，這樣呀！",
    "voice": "vo_adv_1004008_027",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊覺得這樣很好！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好啦！哥哥就一口氣打開箱子吧！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嘿咻！打開囉！",
    "voice": "vo_adv_1004008_028",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "呀哈哈哈！",
    "voice": "vo_adv_1004008_029",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n是拳擊手套呢！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這個木箱果然是嚇人箱。",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "如果是禊的話，",
    "voice": "vo_adv_1004008_030",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n一定也會在這裡加點惡作劇的！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……咦？",
    "voice": "vo_adv_1004008_031",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n箱子裡面好像還有什麼東西！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "原來這不只是嚇人箱而已啊。",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊！這個，是爸爸寫的信！",
    "voice": "vo_adv_1004008_032",
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "他相信禊會找到箱子，所以才埋在這裡吧！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "呀呼──！",
    "voice": null,
    "unit_id": 100432
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "愛惡作劇的爸爸啊～",
    "voice": "vo_adv_1004008_033",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "原來禊的個性是像爸爸呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過話說回來，你呀……",
    "voice": "vo_adv_1004008_034",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "明明年紀比較大，但卻完全被當成惡整的對象了吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你要振作一點呀～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯嗯，不過禊看起來很開心……",
    "voice": "vo_adv_1004008_035",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n說不定保持現在的樣子也不錯，對吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "剛剛的情景，是我依照你和禊的「記憶碎片」",
    "voice": "vo_adv_1004008_036",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n創造出來的「夢」唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如何呢？你做了個好「夢」嗎？",
    "voice": "vo_adv_1004008_037",
    "unit_id": 190011
  },
