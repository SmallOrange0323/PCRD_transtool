  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在聖德蕾莎女學院的學校生活剛開始不久，\\n碧來到了{0}的身旁。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "「校園種姓制度」，",
    "voice": "vo_adv_1107002_000",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你知道這個詞彙嗎……？",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "看來你好像不知道呢。",
    "voice": "vo_adv_1107002_001",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我來說明一下。",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "所謂校園種姓制度，",
    "voice": "vo_adv_1107002_002",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "總而言之",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就是學校內的排序。",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n每間學校都存在著",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n像這樣的階級制度……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "在聖德蕾莎女學院內，",
    "voice": "vo_adv_1107002_003",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "也有彼此心照不宣的階級制度，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n據說位於下層的人",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是不可以隨意先跟上層階級的人說話的。",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "反過來，",
    "voice": "vo_adv_1107002_004",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "周圍的人會對",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "上層階級的學生投射羨慕的目光，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是十分醒目的存在……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不、",
    "voice": "vo_adv_1107002_005",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不是，怎麼可能，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我怎麼可能想變成那樣的上層階級，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n簡直是不自量力的小孬孬！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但是，",
    "voice": "vo_adv_1107002_006",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "如果能成為上層的話，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n結交朋友應該是件簡單的事吧，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我想……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "自從插班過來後，",
    "voice": "vo_adv_1107002_007",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "連、",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "連一個",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "朋友都還沒交到……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "所以就開始在想……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這些事了。",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "上層階級這種事，",
    "voice": "vo_adv_1107002_008",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對我來說簡直是夢想中的夢想……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "終於中午了……！",
    "voice": "vo_adv_1107002_009",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我今天",
