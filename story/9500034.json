  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦……",
    "voice": "vo_adv_9500034_000",
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "學、",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "學長……？",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊、",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那個……",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生……",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "哎呀呀，",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真是讓人吃驚呢。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n沒想到偷走我芳心的真兇，",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "竟然會選擇我。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過呢，",
    "voice": "vo_adv_9500034_001",
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在這裡的我，",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "只不過是扮演出來的我而已。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真正的我……",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "其實一點也不",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "落落大方……",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我只是一個在遊戲裡做夢的",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "女孩子而已喔。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "即便如此，",
    "voice": "vo_adv_9500034_002",
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n助手先生還是會說，",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是我就好，對嗎？",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這……",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我真的……",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "非常開心。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呵呵。",
    "voice": "vo_adv_9500034_003",
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "試著捏了捏臉頰，真的會痛呢──",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "看來這並不是一場夢。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "至今為止，",
    "voice": "vo_adv_9500034_004",
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我們一起經歷了很多事呢。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "一起並肩仰望過煙火，",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也像戀人一樣",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "牽過手。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n真的發生過好多好多事，不過……",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生，",
    "voice": "vo_adv_9500034_005",
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你還記得吧，",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那一天的謎題──",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n現在，",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我再問你一次。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "「好喜歡你」",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這句話，",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你覺得是誰說的呢？",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是我，",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還是小霧？",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呵呵，",
    "voice": "vo_adv_9500034_006",
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不愧是我的搭檔！",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "答對了喔。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你終於解開了",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "最後的謎題。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……可是為什麼，",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗚、",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗚、",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我笑不太出來……",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "…",
    "voice": "vo_adv_9500034_007",
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "…",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過！",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這時候還是得笑著回答才行呢。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n小霧",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "一定也會這麼說的。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "謝謝你，",
    "voice": "vo_adv_9500034_008",
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我一直在等你喔。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n……等你解開",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我那差點就要變成懸案的戀心。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n如此一來，",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我的心就屬於你了。",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "今後，",
    "voice": "vo_adv_9500034_009",
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "無論是作為助手、",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "搭檔，",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n還有……",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "作為戀、",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "戀人……",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n都請你",
    "voice": null,
    "unit_id": 101441
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "多多指教了！",
    "voice": null,
    "unit_id": 101441
  }
]
