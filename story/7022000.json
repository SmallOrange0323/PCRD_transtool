    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "讓在下數數質數，鎮定下來。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這座露娜之塔有不少傳聞。",
