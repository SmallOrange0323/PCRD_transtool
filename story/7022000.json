    "type": "dialogue",
    "name": "七七香",
    "words": "來找新魔法的點子！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "等著瞧吧，",
    "voice": "vo_adv_7022000_009",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "難攻不落的露娜之塔，",
