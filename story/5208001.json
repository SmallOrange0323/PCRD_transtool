    "type": "dialogue",
    "name": "旁白",
    "words": "\\n伺服器名：「獵犬座α」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "翠綠色的索爾之塔下方，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n是一片前所未見的景色。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502630"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……這裡就是傳聞中的",
    "voice": "vo_adv_5208001_023",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "東國啊。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒想到第一次造訪此地，竟然是在這個世界。",
    "voice": "vo_adv_5208001_024",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這地方的氣氛",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "很像大江戶……",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不對，",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是反過來吧。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "印象中大江戶是",
    "voice": "vo_adv_5208001_025",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "為了傳播東國的文化所做出來的城鎮。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n所以這裡其實才是正宗的。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n是這樣沒錯吧，",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "志那都？",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……？",
    "voice": "vo_adv_5208001_026",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n志那都……？",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……嗯，",
    "voice": "vo_adv_5208001_027",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "怎麼了。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個，",
    "voice": "vo_adv_5208001_028",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳為什麼要躲在陰影裡……？",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……咦？",
    "voice": "vo_adv_5208001_029",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n該不會，",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳在怕生……？",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不、",
    "voice": "vo_adv_5208001_030",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不對，",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那不可能。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "剛重逢時確實有點不自在，",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但之後我們也有好好聊過……",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們好好聊過了對吧",
    "voice": "vo_adv_5208001_031",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "志那都？",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "啊……",
    "voice": "vo_adv_5208001_032",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "嗯。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n妳好……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "顯而易見地非常怕生……！！",
    "voice": "vo_adv_5208001_033",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不……",
    "voice": "vo_adv_5208001_034",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不對，",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不會的！",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "或許是因為關係數值被重置了……？",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n難不成",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "和這個世界的重置有關……",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……不，",
    "voice": "vo_adv_5208001_035",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "和重置",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "完全無關。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這只是普通的怕生而已。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊……",
    "voice": "vo_adv_5208001_036",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "果然",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是這樣啊……",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "唔……",
    "voice": "vo_adv_5208001_037",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我知道的，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "每次",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "都是這樣。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "即使彼此花時間熟悉了，",
    "voice": "vo_adv_5208001_038",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "一旦稍久不見，還是會變得如此陌生。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "難以抓到",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "當時",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "說話的感覺……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "為什麼……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我總是",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這樣……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "唉……",
    "voice": "vo_adv_5208001_039",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……呵呵。",
    "voice": "vo_adv_5208001_040",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n妳一點都沒變呢，",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "志那都。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……不，",
    "voice": "vo_adv_5208001_041",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "好不容易又見面了。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "雖然稍有驚嚇，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "但我非常開心。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "說真的，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "看到妳從天上掉下來時，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我嚇了一大跳。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那是我要說的話。",
    "voice": "vo_adv_5208001_042",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "多虧妳的幫忙得救了。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "風的權能果真厲害呢。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳還借我這麼漂亮的衣服。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "不是什麼值得道謝的事。",
    "voice": "vo_adv_5208001_043",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "就妳說的事情始末來看，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我認為",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "保持低調比較妥當。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過……",
    "voice": "vo_adv_5208001_044",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是不可思議呢。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這件和服，",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "和我在那邊的世界所擁有的那件",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "非常像。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "也是會有這種事吧。",
    "voice": "vo_adv_5208001_045",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "所謂因果，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "有時會重疊，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n或是擦身而過，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "有時也會在交錯之中持續流動。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……不過，怜。",
    "voice": "vo_adv_5208001_046",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "妳是怎麼來到這裡的？",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哦哦，",
    "voice": "vo_adv_5208001_047",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是多虧了",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "{0}，",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n以及厄莉絲願意幫忙我們。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "她好像分析了當時協助你們返回的紀錄，",
    "voice": "vo_adv_5208001_048",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n然後建了一個新的傳送機制。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳看，",
    "voice": "vo_adv_5208001_049",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這就是",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "傳送用末端裝置……",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也可以說是類索爾魔珠吧。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "透過這個，",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好像也能暫時和我們的世界聯絡。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "竟然……",
    "voice": "vo_adv_5208001_050",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "不愧是基礎世界的原管理者。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n辦事規模實在超乎想像……",
    "voice": null,
    "unit_id": 135612
  },
