  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "你很懂嘛♪",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n這樣啊、這樣啊～",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n原來哥哥今後也想",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "一直、一～直",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "被禊捉弄呀？",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊就相信",
    "voice": "vo_adv_9500014_001",
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥一定會這麼說的！",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "畢竟哥哥是",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊探險隊的二號隊員嘛♪",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊要特別獎勵這樣的隊員喔，",
    "voice": "vo_adv_9500014_002",
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "今天",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "限、",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "定！",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n會給你和禊一起惡作劇的權利！",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n你覺得會是什麼樣的惡作劇呢～～？",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "就是呢，",
    "voice": "vo_adv_9500014_003",
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們去妨礙那些壞蛋，",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n讓他們想把這個世界",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "搞得一團糟的計畫泡湯，",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這就是禊的惡作劇！",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咪嘻嘻，",
    "voice": "vo_adv_9500014_004",
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n禊現在就好期待",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "看到壞蛋吃癟的表情了呢！",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥！",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……那個，",
    "voice": "vo_adv_9500014_005",
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "其實禊",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "有一點點害怕。",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n因為敵人真的很強，",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "感覺完全沒有勝算……",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n萬一輸掉的話……",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不管是哥哥，",
    "voice": "vo_adv_9500014_006",
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "還是美美、鏡華，",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "以及禊所珍惜的一切，",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n全部都會不見……",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "一想到這裡，",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊就好害怕……",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不",
    "voice": "vo_adv_9500014_007",
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "過，",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "現在已經沒事了。",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "因為，",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥給了禊很多勇氣♪",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不管敵人再怎麼強大，",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊都相信我們一定會更強！",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "是嗎？",
    "voice": "vo_adv_9500014_008",
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥也是呢……",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咪嘻嘻♪",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那麼，",
    "voice": "vo_adv_9500014_009",
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊也會帶著哥哥給的勇氣努力加油的。",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "為了今後也能一～直",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "和哥哥一起冒險♪",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好～",
    "voice": "vo_adv_9500014_010",
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們出發吧，哥哥！",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "接下來，",
    "voice": null,
    "unit_id": 100441
  },
  {
    "type": "dialogue",
