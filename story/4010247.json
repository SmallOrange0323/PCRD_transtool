  {
    "type": "dialogue",
    "name": "斜",
    "words": "哇啊……！",
    "voice": "vo_adv_4010247_000",
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "\\n有好多甜甜圈～！",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "可以嗎可以嗎？",
    "voice": "vo_adv_4010247_001",
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "\\n真的可以",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "全部吃掉嗎？",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "斜會全～",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "部吃光光喔？",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "嘿嘿，",
    "voice": "vo_adv_4010247_002",
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "謝謝～！",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "這麼豪華的生日，",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "斜還是頭一次體驗到♪",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "嚼嚼嚼……",
    "voice": "vo_adv_4010247_003",
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "甜蜜蜜～♪",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "哈，",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "真幸福……",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "\\n今天的晚餐有這個就夠了。",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "是～",
    "voice": "vo_adv_4010247_004",
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "……被罵了啦，",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "嘿嘿。",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "……最近庫露露雖然會來找斜玩，",
    "voice": "vo_adv_4010247_005",
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "\\n但我們都有",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "打工之類的事要忙，時間常常對不上……",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "你願意像這樣",
    "voice": "vo_adv_4010247_006",
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "陪在斜的身邊，",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "甚至",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "還幫斜慶祝生日，",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "\\n斜真的",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "超級超級",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "開心的啦～♪",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "畢竟",
    "voice": "vo_adv_4010247_007",
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "兔子太寂寞的話可是會死掉的♪",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "啊，",
    "voice": "vo_adv_4010247_008",
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "對了！",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "把你的生日告訴斜吧！",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "下次換斜來幫你慶祝！",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "雖然可能不會",
    "voice": "vo_adv_4010247_009",
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "像今天這麼豪華……",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "但斜會用",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "同等的誠意",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "盡全力幫你",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "好好慶祝的！",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "\\n斜要讓你",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "跟現在的斜一樣，",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "覺得",
    "voice": null,
    "unit_id": 136231
  },
  {
    "type": "dialogue",
    "name": "斜",
    "words": "「今年肯定會是個好年！」♪",
    "voice": null,
    "unit_id": 136231
  }
]
