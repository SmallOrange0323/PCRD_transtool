  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n只要重新",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "設定語言的部分——",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊，",
    "voice": "vo_adv_5038002_094",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那個沒辦法改喔。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "為什麼！？",
    "voice": "vo_adv_5038002_095",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "因為，切嚕語就是這個孩子的特色啊？",
    "voice": "vo_adv_5038002_096",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n連這個都不認同也太過分了吧？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這跟歧視有什麼不同！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "拜託妳們！",
    "voice": "vo_adv_5038002_097",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "請妳們包容這個孩子的不同！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "請培養能包容",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "切嚕語的寬闊胸襟！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真、",
    "voice": "vo_adv_5038002_098",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真是熱切喵……！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "明明她說的話都很離譜，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n為什麼講到後來卻好像我們有道德上的問題喵……！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "總之，拜託妳們！",
    "voice": "vo_adv_5038002_099",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n只要這個孩子能夠大賣，切嚕、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "切嚕",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就能夠成為世界的共通語言……！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "來，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "學長你也一起低頭拜託她們吧！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "學長，",
    "voice": "vo_adv_5038002_100",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你這樣不夠有誠意啦！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n頭要再低一點！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "　把腳彎起來！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "　雙手貼在地面上！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "小墨丘利們！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "　學長他都向妳們下跪了耶！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "什麼……",
    "voice": "vo_adv_5038002_101",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "學長，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你是認真的嗎？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n謝、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你竟然為了切嚕語做到這個地步……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "小墨丘利們！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "　學長都忍辱做到這個地步了！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "手段用盡以後終於開始動之以情了喵！？",
    "voice": "vo_adv_5038002_102",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那、",
    "voice": "vo_adv_5038002_103",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那個……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n那麼琪愛兒的簡報",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n就到此為止，這樣可以嗎……？　",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這樣可以吧？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我知道了。",
    "voice": "vo_adv_5038002_104",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n那麼雖然很遺憾，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就切嚕結束吧。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那麼秋乃。",
    "voice": "vo_adv_5038002_105",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n關於創業企劃",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "「會說話的小琪愛兒」，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "請做出最後的決定！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "…………！",
    "voice": "vo_adv_5038002_106",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "以零盧幣收場！",
    "voice": "vo_adv_5038002_107",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "怎麼這樣～～～～～～～～！",
    "voice": "vo_adv_5038002_108",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "會說話的小琪愛兒",
    "words": "切嚕～～～～～～～～！",
    "voice": "vo_adv_5038002_109",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "「會說話的小琪愛兒」和其製作者的慘叫聲，",
    "voice": null,
