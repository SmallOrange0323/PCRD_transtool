  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "彦星に浮気されちまって、",
    "voice": "vo_adv_6044105_000",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "織姫はかわいそうだね。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "祭りを開催するためってのもあるけど……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "織姫のために、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "早く問題を解決してあげないとね。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "ああ、",
    "voice": "vo_adv_6044105_001",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "そうだね。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "余計なお世話って言われちまうかもしれないけど……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "あの涙を見て放っておけるほど、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "アタシは大人しい人間じゃないのさ。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "え、",
    "voice": "vo_adv_6044105_002",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "そこからなのかい！？　",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "ええと、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "浮気ってのは……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\nこう、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "色んな女の子に",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "声をかけて遊ぶってことなんだよ。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "まあ、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "素直で純粋なお前さんにゃ関係ないことさ。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "……気持ちってのは",
    "voice": "vo_adv_6044105_003",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "難しいもんなんだよ。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "一度好きになっちまったら、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "何かあっても嫌いになれないもんさ。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n惚れちまった方が負けとは",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "よく言ったもんだよ、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "まったく。",
    "voice": null,
    "unit_id": 113111
  }
]
