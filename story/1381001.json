[
  {
    "type": "background",
    "bg_id": "502040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "蘭德索爾國際博覽會因為「六凶」梅莉莎而陷入一片混亂。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了處理此事，萊拉耶爾暫時回到吉歐‧提格尼亞，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n隨後便獨自離開城堡去尋找傳說食材。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "各位，",
    "voice": "vo_adv_1381001_000",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還有克蘿茜──",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "請等等我。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我一定",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "會拯救大家的……！",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "為了和獄蜂戰鬥，",
    "voice": "vo_adv_1381001_001",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "以及拯救被當成人質的人們，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我必須獲得",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吉歐‧提格尼亞的傳說食材才行……！",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "…………",
    "voice": "vo_adv_1381001_002",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……至今為止，",
    "voice": "vo_adv_1381001_003",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我還沒有獨自一人",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "去尋找食材過。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n總是會有人",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "陪在我身邊。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "然而……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "烏爾姆還沒醒過來，",
    "voice": "vo_adv_1381001_004",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "琳德正在照顧她……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n實在不能",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "讓她陪我出來。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……烏爾姆……",
    "voice": "vo_adv_1381001_005",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_1381001_006",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這可不行。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n不小心",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就沮喪起來了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n明明大家",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "都在各自奮戰著……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "傳說食材……",
    "voice": "vo_adv_1381001_007",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "「彩虹蜜糖果實」，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n雖然知道就在這座森林裡……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "光從空中俯瞰，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "也十分廣闊呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "根據書籍記載，",
    "voice": "vo_adv_1381001_008",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那是長在",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這座森林某處的樹上。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "線索只有這些……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "果然應該把城裡的人帶來，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n用人海戰術嗎……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_1381001_009",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這樣就好了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "城裡需要警備，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n能飛的人也不多。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "而且，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "帶著食材回去後，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n為了能馬上開始料理，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "也需要讓他們先準備好。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "最重要的是，",
    "voice": "vo_adv_1381001_010",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我是這個國家的公主。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n情況緊急，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "而且可能有危險的話，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n就該由我來行動。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "在尋找食材的途中，",
    "voice": "vo_adv_1381001_011",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "說不定會遭到獄蜂襲擊。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n雖然不覺得",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "獨自行動是最佳選擇，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但到了緊要關頭，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我也無法保證能夠保護同行者。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "實際上，",
    "voice": "vo_adv_1381001_012",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "在蘭德索爾時就被用人質威脅……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n使得行動受到限制。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_1381001_013",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "所以，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "沒問題的。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n單獨行動這件事",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "一定沒有錯，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "應該……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "background",
    "bg_id": "501770"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呼……",
    "voice": "vo_adv_1381001_014",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不愧是傳說食材，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n果然沒那麼容易找到呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "因為從空中看也沒有進展，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就下來地面看看了……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_1381001_015",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不過真是令人著急呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我完全不知道，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "要如何有效率地尋找東西。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n深切體會到",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "自己的無力……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_1381001_016",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n找不到的話，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就一直搜尋到找到為止……！",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "…………",
    "voice": "vo_adv_1381001_017",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "話雖如此，",
    "voice": "vo_adv_1381001_018",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這座森林這麼廣闊──",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n只靠我一人，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不知道得花多少上多久。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n明明時間有限……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "您不是一個人喔，",
    "voice": "vo_adv_1381001_019",
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "萊拉耶爾殿下～！",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "呼、",
    "voice": "vo_adv_1381001_020",
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "呼，",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "終於追上了……",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你們……！",
    "voice": "vo_adv_1381001_021",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n來這裡做什麼……！？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "當然是",
    "voice": "vo_adv_1381001_022",
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "來幫助萊拉耶爾殿下的。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "\\n",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "嗅",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "嗅……",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "水果的味道……",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "雖然不知道是什麼水果，",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "\\n但是有香氣從這裡傳來！",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "好了，我們走吧，",
    "voice": "vo_adv_1381001_023",
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "萊拉耶爾殿下。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n城裡的警備以及烹調準備都有好好在進行，",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "請您放心。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n在這裡的，",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "都是有空檔的人。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "很感謝",
    "voice": "vo_adv_1381001_024",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你們的協助。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不知道什麼時候會被捲入危險之中。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n趕快回去城裡吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "要說危險，",
    "voice": "vo_adv_1381001_025",
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "不管在哪裡都一樣。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "城裡的警備",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "跟烹調準備都沒問題的話，",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n剩下的我們所能做的，",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "就只有幫助萊拉耶爾殿下了。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "…………",
    "voice": "vo_adv_1381001_026",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "……非常抱歉，",
    "voice": "vo_adv_1381001_027",
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "違背您的命令。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "\\n但是──",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "不久前，",
    "voice": "vo_adv_1381001_028",
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "魔物襲擊城堡時。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n琳德──",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "still",
    "still_id": "138100101"
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "呃、",
    "voice": "vo_adv_1381001_029",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "呃……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "沒、",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "沒錯，各位！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n萊拉耶爾殿下現在，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "正在戰鬥！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "是為了守護這個國家，",
    "voice": "vo_adv_1381001_030",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "為了守護我們！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "可是，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "她卻要我們躲起來……！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我……",
    "voice": "vo_adv_1381001_031",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "到目前為止，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n公主殿下交代我做的事",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我全都聽她的話去做了。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "但是……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我今天第一次，",
    "voice": "vo_adv_1381001_032",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "想要違背萊拉耶爾殿下的命令。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n忍不住",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "產生了這樣的想法……！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "background",
    "bg_id": "501770"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "所、",
    "voice": "vo_adv_1381001_033",
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "所以……",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "我們也是。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n就算被雷劈，",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "也要盡力做自己能做的事。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n我們是這麼想的。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……這樣啊。",
    "voice": "vo_adv_1381001_034",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n琳德她……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "因為找傳說食材找得很辛苦，",
    "voice": "vo_adv_1381001_035",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "的確是希望有人來幫忙。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "而且大家",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "都是各自思考過才來到這裡的……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "既然這樣，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……我明白了。",
    "voice": "vo_adv_1381001_036",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n大家一起",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "尋找傳說食材吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "老實說，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "有各位的協助，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "真的幫了我大忙。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "從西北方向樹叢那邊飄來氣味的水果",
    "voice": "vo_adv_1381001_037",
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "\\n應該有12種才對。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "雖然分頭去確認了，",
    "voice": "vo_adv_1381001_038",
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "但全都不是。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n右手邊也一樣。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n剩下從正面傳來的氣味，",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "但還沒收到好消息。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "原來如此……",
    "voice": "vo_adv_1381001_039",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "狗頭人",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "先嗅出水果的氣味，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n再由半身人去搜索。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不是單純採取人海戰術，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "而是很好地分工合作呢……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "咦……！？",
    "voice": "vo_adv_1381001_040",
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n真、",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "真的嗎……！？",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "找到了！",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "我們找到了，",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "萊拉耶爾殿下！",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "有了……",
    "voice": "vo_adv_1381001_041",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "真的找到了……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n這就是傳說食材……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "「彩虹蜜糖果實」！",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不過，",
    "voice": "vo_adv_1381001_042",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "沒想到……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "居然會在小徑裡面。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "森林深處再更深的地方……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "從空中不可能找得到，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "只有我自己的話，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "一定也會錯過",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那條小徑。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "呀……！？",
    "voice": "vo_adv_1381001_043",
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_1381001_044",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "魔物！？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "雖然不是魔蜂，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但難道是被傳說食材吸引過來的……？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "比起那個……！",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "嗚呀啊啊……！？",
    "voice": "vo_adv_1381001_045",
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "\\n竟、",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "竟然想讓老人家減壽，",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "真是恐怖的魔物……！",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "可惡……",
    "voice": "vo_adv_1381001_046",
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "若是試圖傷害我的國民，",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n無論是誰都不可饒恕……",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n納命來吧。",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "白雷夜天！",
    "voice": "vo_adv_1381001_047",
    "unit_id": 126512
  },
  {
    "type": "background",
    "bg_id": "501770"
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "反省自己的行為，",
    "voice": "vo_adv_1381001_048",
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "消失吧。",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呼……",
    "voice": "vo_adv_1381001_049",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "各位，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "沒事吧？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "是的……",
    "voice": "vo_adv_1381001_050",
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "謝謝您，",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "萊拉耶爾殿下！",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "\\n多虧了萊拉耶爾殿下，",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "大家都沒有受傷！",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "太好了……",
    "voice": "vo_adv_1381001_051",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "大家都平安無事。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那麼，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "既然出現魔物了，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就不能悠哉地待在這裡。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n希望可以盡快",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "把水果運出去……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "把水果帶回去這件事，",
    "voice": "vo_adv_1381001_052",
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "已經拜託巨人族了。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "\\n雖然我們",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "無法拿多少，",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "\\n但巨人族可以輕鬆搬運",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "比我們多好幾倍的數量。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "說得也是呢。",
    "voice": "vo_adv_1381001_053",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呵呵……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "有如此可靠的國民，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我感到很驕傲。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "好了，",
    "voice": "vo_adv_1381001_054",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "大家都在城裡等著。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "把水果帶回去吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "background",
    "bg_id": "501710"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士？",
    "voice": "vo_adv_1381001_055",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你也來這邊了嗎？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "平安",
    "voice": "vo_adv_1381001_056",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "取得了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n多虧了大家幫忙。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "萊拉耶爾殿下，",
    "voice": "vo_adv_1381001_057",
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "請收下。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "\\n這是要給萊拉耶爾殿下，",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "以及傳說食材搜索隊的慰勞品。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "哎呀，",
    "voice": "vo_adv_1381001_058",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是蛋糕……？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "這是留在城裡的人製作的蛋糕。",
    "voice": "vo_adv_1381001_059",
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "\\n這次去搜索傳說食材，",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "辛苦您了。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "還有，",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "\\n恭喜您。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "他們所做的蛋糕",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "是帶著這樣的意涵。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "做得相當精緻呢。",
    "voice": "vo_adv_1381001_060",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "明明應該很忙碌才對，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "真是感謝大家。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "剛才",
    "voice": "vo_adv_1381001_061",
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "我聽製作蛋糕的人說了。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n雖然費工，",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "但是正因為有大家一起分工，",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n才能夠製作出很多份。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "狗頭人族烤蛋糕，",
    "voice": "vo_adv_1381001_062",
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "貓妖精打發奶油，",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n巨人族去採放在上面的水果，",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n半身人做最後收尾……",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "聽說是這樣。",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "原來是這樣呀。",
    "voice": "vo_adv_1381001_063",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n眾人齊心協力",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "完成了這些事……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……是啊。",
    "voice": "vo_adv_1381001_064",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士也請用。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我們一起",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "享用大家的心意吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "真的。",
    "voice": "vo_adv_1381001_065",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n這多種風味的和諧，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "正是大家心意的結晶呢……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "雖然蛋糕可以一個人製作，",
    "voice": "vo_adv_1381001_066",
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "\\n但也能夠大家一起製作。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "\\n不需要一個人",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "包辦所有事情喔，",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "老狗頭人",
    "words": "萊拉耶爾殿下。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……是啊。",
    "voice": "vo_adv_1381001_067",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "說得沒錯。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不管是尋找，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還是製作，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "都不需要獨自承擔……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "各位",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "讓我學到了很重要的事。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "感謝你們",
    "voice": "vo_adv_1381001_068",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "和我一起尋找傳說食材。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "也感謝",
    "voice": "vo_adv_1381001_069",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "留在城裡的人們，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "負責警備",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "和烹調準備，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n而且還為我們",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "製作了蛋糕。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "在不安的情緒中，",
    "voice": "vo_adv_1381001_070",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "各自做到自己能做的事……",
