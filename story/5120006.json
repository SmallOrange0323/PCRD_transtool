  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}跟雪成功在儀式途中救出了伊莉亞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……感謝你，",
    "voice": "vo_adv_5120006_000",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "吾之眷屬啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身差點──",
    "voice": "vo_adv_5120006_001",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就要成為",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你的敵人了。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你……！",
    "voice": "vo_adv_5120006_002",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "伊莉亞伊莉亞，",
    "voice": "vo_adv_5120006_003",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳有看到嗎？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "在儀式中威風凜凜地現身，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我美麗的模樣！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳不覺得那是襯托我的",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "最棒演出嗎？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不要把妾身的危機當成演出啊！",
    "voice": "vo_adv_5120006_004",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身確實被妳給救了。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雪啊……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "做的好。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……",
    "voice": "vo_adv_5120006_005",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不客氣♪",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "比起那個，",
    "voice": "vo_adv_5120006_006",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳接下來打算怎麼做？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然逃離舉行儀式的場地了，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是這裡還在城鎮裡。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "布拉德不會就這樣",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "放咱們逃走的吧。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "追兵很快就──",
    "voice": "vo_adv_5120006_007",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "──伊莉亞、",
    "voice": "vo_adv_5120006_008",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "大人。",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "似乎已經來了呢。",
    "voice": "vo_adv_5120006_009",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但是……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "他給人的感覺好像不太一樣呢？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "這是、",
    "voice": "vo_adv_5120006_010",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "為什麼……",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "為什麼、",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "您要拒絕復活……",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "您是傳說的吸血鬼。",
    "voice": "vo_adv_5120006_011",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "您是這個世界的支配者。",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "您是我的一切……！",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "布拉德……",
    "voice": "vo_adv_5120006_012",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "伊莉亞大人啊啊啊啊啊啊啊啊啊啊啊──！",
    "voice": "vo_adv_5120006_013",
    "unit_id": 17611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗚哇，",
    "voice": "vo_adv_5120006_014",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "他變成魔物了！？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n那個人",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不是魔族嗎！？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "──伊莉亞、",
    "voice": "vo_adv_5120006_015",
    "unit_id": 17611
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "大人──！",
    "voice": null,
    "unit_id": 17611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "他會變形",
    "voice": "vo_adv_5120006_016",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是因為這股龐大魔力的關係吧……！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你這傢伙，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是對自己用了那個魔力結晶嗎！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是愚蠢……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那可不是普通魔族能操控的東西……！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不行！",
    "voice": "vo_adv_5120006_017",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不能試圖跟他戰鬥！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為什麼",
    "voice": "vo_adv_5120006_018",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不能跟他戰鬥啊？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "對面可是一邊喘著粗氣，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "一邊用熱情的眼神看著我們啊？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……贏不了。",
    "voice": "vo_adv_5120006_019",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊？",
    "voice": "vo_adv_5120006_020",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有纏附著相同魔力的妳應該懂吧。",
    "voice": "vo_adv_5120006_021",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n他現在",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "把為了讓「傳說的吸血鬼」復活",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n而累積起來的所有力量，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "都寄宿在自己身上……！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只靠人類的力量……",
    "voice": "vo_adv_5120006_022",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是不可能戰勝他的。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……不行啊。",
    "voice": "vo_adv_5120006_023",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如果跟那股魔力相碰撞的話，",
    "voice": "vo_adv_5120006_024",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身可能會沒辦法維持自我。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……那是怎樣啊。",
    "voice": "vo_adv_5120006_025",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n難道說伊莉亞……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳怕了嗎？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼！？",
    "voice": "vo_adv_5120006_026",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n才不是呢！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身才沒有感到害怕……！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "伊莉亞──",
    "voice": "vo_adv_5120006_027",
    "unit_id": 17611
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "大人啊啊啊啊啊！",
    "voice": null,
    "unit_id": 17611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哼～",
    "voice": "vo_adv_5120006_028",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "原來如此啊。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好喔……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那麼妳就退下吧。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n這個表現機會，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就由我全盤接收了。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雪，",
    "voice": "vo_adv_5120006_029",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "住手啊！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳敵不過他的……！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "礙事、",
    "voice": "vo_adv_5120006_030",
    "unit_id": 17611
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "啊──！",
    "voice": null,
    "unit_id": 17611
  },
  {
    "type": "background",
    "bg_id": "501982"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵……♪",
    "voice": "vo_adv_5120006_031",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼！？",
    "voice": "vo_adv_5120006_032",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n防禦……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "住了……！？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "他的那一擊……！？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "什麼啊，",
    "voice": "vo_adv_5120006_033",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "傳說的吸血鬼之力，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也沒什麼了不起的嗎。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
