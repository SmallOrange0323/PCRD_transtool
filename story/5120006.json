  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身的力量……！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──把身體、",
    "voice": "vo_adv_5120006_081",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "交給我──",
