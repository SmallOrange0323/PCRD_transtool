  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……消失吧。",
    "voice": "vo_adv_5120006_082",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不知是誰過去所殘存的意志啊。",
    "voice": null,
    "unit_id": 126211
  },
