    "name": "優花梨",
    "words": "團長～",
    "voice": "vo_adv_5094003_048",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "妳酒量蠻好的嘛──！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵……",
    "voice": "vo_adv_5094003_049",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n平常我是滴酒不沾，",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但畢竟現在在放假嘛。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊～！",
    "voice": "vo_adv_5094003_050",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "還是太硬梆梆了～！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "妳要再更放鬆，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "放鬆～！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咕嚕……",
    "voice": "vo_adv_5094003_051",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咕嚕……",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咕嚕……！",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": "vo_adv_5094003_052",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真好喝！",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n把工作拋諸腦後所喝的麥酒",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "原來這麼好喝啊！",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "很棒哦～！",
    "voice": "vo_adv_5094003_053",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就是這樣～！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n妳剛剛的態度",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就是非常棒的上司哦！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哦，",
    "voice": "vo_adv_5094003_054",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣啊！",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "看來能抬頭挺胸回去了呢！",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n謝謝妳的指導，",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小優花梨！",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "天真！",
    "voice": "vo_adv_5094003_055",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "純，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "妳太天真了！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "妳",
    "voice": "vo_adv_5094003_056",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "才剛站到麥酒之道的入口前！",
