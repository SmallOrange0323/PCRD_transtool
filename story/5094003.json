  {
    "type": "dialogue",
    "name": "碧",
    "words": "才會主動跟妳說來交個朋友吧」。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "「萬物會不斷變遷。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不能以為任何事都能如妳所願喔」",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "大樹、",
    "voice": "vo_adv_5094003_097",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "小鳥，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還有風兒，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n謝謝你們告訴我這麼多金玉良言！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好朋友號，",
    "voice": "vo_adv_5094003_098",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你聽我說！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "邊緣人空間的效果開始發威囉！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我可以清楚聽到",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "大自然跟我喊話的聲音了！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不是靠耳朵聽，",
    "voice": "vo_adv_5094003_099",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "而是用心去感應……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這正是",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "邊緣精神受到療癒的證據！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我必須銘記大自然告訴我的教誨……",
    "voice": "vo_adv_5094003_100",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "揮別那個直到昨天仍自我感覺良好的自己！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "做出鄉下土包子才會有的輕率舉動，",
    "voice": "vo_adv_5094003_101",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "結果給女子學院以及玩具工廠的大家添麻煩……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還有……",
    "voice": "vo_adv_5094003_102",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還有",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "最重要的是……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我沒臉見跟我志同道合的團長……！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "宣誓！",
    "voice": "vo_adv_5094003_103",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "發誓再也不會忘記自己是邊緣人的精靈族！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n邊緣人代表──",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "碧！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "很好～！",
    "voice": "vo_adv_5094003_104",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我要再次以鄉下邊緣人的精靈族",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "重新面對人生囉──！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "碧再次能聽到大自然的聲音，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n成功找回了身為邊緣人的初衷。",
    "voice": null,
    "unit_id": null
  }
