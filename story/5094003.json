  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咕嚕。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗯！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "泡得真好喝！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這種咖啡豆果然",
    "voice": "vo_adv_5094003_036",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "跟山上的氣氛很搭呢～",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "香氣濃郁，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還帶有微微甜味……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這最適合拿來放鬆了。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "畢竟平常工作前喝的，",
    "voice": "vo_adv_5094003_037",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n都是帶著苦味，拿來提神的品種。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "在不同的地點和時間下，",
    "voice": "vo_adv_5094003_038",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就是要跟著更換豆子種類才行呢！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n有這杯咖啡才能有這樣的隱居山林體驗啊～",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呼～",
    "voice": "vo_adv_5094003_039",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n果然在深山喝咖啡，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "才能讓心靈得以休息啊～",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不知有多久……",
    "voice": "vo_adv_5094003_040",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒能像這樣一個人靜靜地度過了……？",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "畢竟最近",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "每天都跟很多人往來啊……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊……！？",
    "voice": "vo_adv_5094003_041",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n這也就是說，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我身為邊緣人每天過得是失敗的！？",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗚嗚……",
    "voice": "vo_adv_5094003_042",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我很習慣失敗，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n不過沒把失敗當成失敗的打擊真的好大……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我原本覺得自己已經習慣都會的生活而有所成長……",
    "voice": "vo_adv_5094003_043",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n看來我完全會錯意了！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "太自我感覺良好了！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "唉……",
    "voice": "vo_adv_5094003_044",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "明明我其實是毫無溝通能力，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不擅長交際，很笨拙的邊緣精靈族啊……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊……",
    "voice": "vo_adv_5094003_045",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我漸漸開始想起",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "自己是怎樣的人了……！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒錯！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這就是我！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "本來的真正自我！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "很好！",
    "voice": "vo_adv_5094003_046",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我的狀況漸入佳境了──！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n來找回身為邊緣人的我囉──！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "background",
    "bg_id": "501592"
  },
  {
