    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "麥酒之力",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "可不只有這點程度啊～！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "什麼……？",
    "voice": "vo_adv_5094003_057",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "麥酒之力……？",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n快教教我！",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為了部下，",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我需要那股力量！",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我就在等妳這句話！",
    "voice": "vo_adv_5094003_058",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我當然會教妳～！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n就傳授我所知的麥酒之力，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "來感謝妳幫我搭帳棚的事吧！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "而且，",
    "voice": "vo_adv_5094003_059",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "兩個人一起喝麥酒，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n搞不好會更接近最棒的那一杯啊！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好，",
    "voice": "vo_adv_5094003_060",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "純，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "妳聽好了。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n所謂的麥酒，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "光是喝著它的確就夠好喝了。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但是，",
    "voice": "vo_adv_5094003_061",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n說到能更凸顯它好喝的存在就是──？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有、",
    "voice": "vo_adv_5094003_062",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有那種東西……？",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "有啊！",
    "voice": "vo_adv_5094003_063",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n那就是",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "下酒菜！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯，",
    "voice": "vo_adv_5094003_064",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我想也是。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊！",
    "voice": "vo_adv_5094003_065",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n什麼嘛～",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就只有這樣啊～",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "妳心裡是這麼想的對吧？",
