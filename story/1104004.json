  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還用問嗎！",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要去救牠啊！",
    "voice": "vo_adv_1104004_022",
    "unit_id": 104331
  },
  {
    "type": "still",
    "still_id": "110400401"
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好乖好乖，",
    "voice": "vo_adv_1104004_023",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒有事吧―？",
