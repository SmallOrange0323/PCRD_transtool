    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "一直看著河那邊？",
    "voice": null,
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你說什麼！？",
    "voice": "vo_adv_1104004_019",
    "unit_id": 104331
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不會吧，",
