  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "マシューさんたちの悩みも分かってくる気がするッス。",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "あの見た目じゃその……",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "いろいろと難しいッスからね。",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "そうッスよね……",
    "voice": "vo_adv_6050306_001",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "って、",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ちょっと待つッス。",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\nひょっとして、",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "自分もその枠に入ってるッスか？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "自分はマスコットじゃないッスよ！！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "気休めはいいッスよ……",
    "voice": "vo_adv_6050306_002",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "って、",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "そうじゃないんスか？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\n確かに",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "見た目で油断させて、",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ってのは",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ありッスね！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "諦めずに考えてみることも大切ッスね！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "あんたも怖さとは縁のない人ッスもんね。",
    "voice": "vo_adv_6050306_003",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "一緒に考えてくれるとありがたいッス。",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\nそれでもだめなら",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ツムギさんに相談するッスよ。",
    "voice": null,
    "unit_id": 114111
  }
]
