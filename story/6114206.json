[
  {
    "type": "background",
    "bg_id": "501950"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵，",
    "voice": "vo_adv_6114206_000",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我想到好點子了喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "在店裡販售貓咪小物",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "怎麼樣喵？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "只要有兼職收入，咖啡廳就能賺錢，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n莫妮卡也會很開心的喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你有沒有",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "什麼好主意喵？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "原來如此喵！",
    "voice": "vo_adv_6114206_001",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "請自己支持的愛貓用肉墊當成印章來蓋喵？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "只要擺在家裡，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "每次看到就會很想念自己支持的愛貓，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n不禁一直來店消費……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "任何人都抗拒不了貓的魅力喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "──這、",
    "voice": "vo_adv_6114206_002",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這主意真是太棒了喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不只替店裡招攬客人，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "還能彰顯貓派的勢力喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n然後將來貓咪",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "將支配整個蘭德索爾喵～！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗚喵！？",
    "voice": "vo_adv_6114206_003",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就算同樣是貓……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n也禁止摸我或是碰我喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我是非賣品喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……不、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "唯獨你，要我賣給你也行喵……",
    "voice": null,
    "unit_id": 125111
  }
]
