    "words": "就只能去找新人了！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "……那個，",
    "voice": "vo_adv_5078001_093",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n我也可以跟你們去嗎？",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n因為我好像",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "帶給你們麻煩了。",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "我可不能讓你一個人奮戰。",
    "voice": "vo_adv_5078001_094",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n而且在我體內的",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "這份……",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "黑暗力量",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "也說不定會派上用場。",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "說得也是……",
    "voice": "vo_adv_5078001_095",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "儘管是很危險的力量，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n但剛才畢竟也逼退了反逆獸……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "嗯，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "跟我們來吧，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "伊緒！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "謝謝，",
    "voice": "vo_adv_5078001_096",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "我──",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n會以黑暗老師的身分",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "加油的♪",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "……哎呀？",
    "voice": "vo_adv_5078001_097",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n我真是的，",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "又說自己是什麼黑暗老師……",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "黑暗力量的影響立刻就顯現出來了……",
    "voice": "vo_adv_5078001_098",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "那麼，騎士大人！",
    "voice": "vo_adv_5078001_099",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "趕快出發去尋找魔法少女吧──",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──你們說出發，",
    "voice": "vo_adv_5078001_100",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是要去哪裡呢～？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "是誰！？",
    "voice": "vo_adv_5078001_101",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嘻嘻嘻，",
    "voice": "vo_adv_5078001_102",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嘻嘻……♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "這、",
    "voice": "vo_adv_5078001_103",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "這個笑聲……！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n該不會是……！？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "沒錯──",
    "voice": "vo_adv_5078001_104",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "──黑暗被虐狂，",
    "voice": "vo_adv_5078001_105",
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "又來了～～～～！",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "趕跑了反逆獸，",
    "voice": "vo_adv_5078001_106",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "阻止失控的伊緒才不久，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在我們面前現身的",
