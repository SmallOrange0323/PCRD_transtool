    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是因為那個要用來當研磨劑材料的植物害的嗎？",
