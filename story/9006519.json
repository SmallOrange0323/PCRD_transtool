[
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下，",
    "voice": "vo_adv_9006519_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "讓你們久等了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我們【純白之翼】前來助陣囉！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喝啊啊啊啊啊！！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這邊這隻就交給我是也！",
    "voice": "vo_adv_9006519_001",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n決定天下走向的大決戰，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "出陣是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "咻啪啪啪啪！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喔喔喔，",
    "voice": "vo_adv_9006519_002",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "大爆炸──！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "來了好像很強的人──！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "真是太可靠了～！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵呵……",
    "voice": "vo_adv_9006519_003",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "以爆炸為背景佇立的我",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也很美呢……！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻……",
    "voice": "vo_adv_9006519_004",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "身體也因為爆炸氣浪熱起來了……♪",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然好像也有怪怪的人來了……",
    "voice": "vo_adv_9006519_005",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "呵，",
    "voice": "vo_adv_9006519_006",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "不管來幾個人都一樣！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n因為這本古文書",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "也記載了能將大範圍燃燒殆盡的咒語啊！！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "偷偷、",
    "voice": "vo_adv_9006519_007",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "地……！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "唔，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "就是現在！！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "什！？",
    "voice": "vo_adv_9006519_008",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "妳做什麼……！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "難道說古文書……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "可惡！？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "成功了……！　",
    "voice": "vo_adv_9006519_009",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我拿到",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "古文書了～！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n當過怪盜的經驗，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "在這裡派上用場了～！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯！",
    "voice": "vo_adv_9006519_010",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "真不愧是",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "步未！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好了，你這壞蛋……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "做好覺悟吧！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你已經",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒有勝算了！！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "呼哈哈哈哈……",
    "voice": "vo_adv_9006519_011",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "妳說我沒勝算？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n一介賤民，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "還以為自己贏過我了嗎？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "一副游刃有餘的樣子，",
    "voice": "vo_adv_9006519_012",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼回事啊？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n是發瘋了嗎～？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n──啊！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "該不會，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是因為我太可愛了……！？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "哈──哈哈哈！",
    "voice": "vo_adv_9006519_013",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n我哪可能會發瘋！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "即使古文書被奪走了",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "也無所謂。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n基本的操作用咒語，我都已經記在腦袋裡了！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "而且啊……",
    "voice": "vo_adv_9006519_014",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n侍奉彌勒大人的",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "──可不只我一人哦！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "呵呵呵……",
    "voice": "vo_adv_9006519_015",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "正是如此。",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "\\n好久不見了呢，",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "「深月醫生」。",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……哎呀。",
    "voice": "vo_adv_9006519_016",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "竟然在這種奇怪的地方見到你呢，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "院長？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "什……！",
    "voice": "vo_adv_9006519_017",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n那個人，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "應該被深月醫生打倒了才對啊！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我聽說他被關進大江戶的監獄裡了……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼會！？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "嘿嘿嘿，",
    "voice": "vo_adv_9006519_018",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "那種程度的監獄，",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "要逃脫簡直易如反掌。",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "\\n我打算好好報答",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "那個摧毀我醫院的女人，",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "\\n因此千里迢迢地來到蘭德索爾……",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "沒想到全世界",
    "voice": "vo_adv_9006519_019",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "都開始燃燒了起來！",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "\\n",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "呀哈哈……",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "這也是個好機會……！",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "\\n",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "深月！",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "我要把妳",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "跟這個世界一起轟得煙消雲散！",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "哈哈哈哈，",
    "voice": "vo_adv_9006519_020",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "這位還真是嚇人哪！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n你不覺得嗎……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "惡代官先生？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "是啊。",
    "voice": "vo_adv_9006519_021",
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "噢噢，",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "還真可怕呢。",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "什……！",
    "voice": "vo_adv_9006519_022",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "壞蛋",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "又多了一個！？",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊啊！？",
    "voice": "vo_adv_9006519_023",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那傢伙是……！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n在眾目睽睽下",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "解開空花和服腰帶的",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "變態大叔～！！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦……！",
    "voice": "vo_adv_9006519_024",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那、",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那還真是相當危險的人物呢……！",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "哼，",
    "voice": "vo_adv_9006519_025",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "怕到說不出話了嗎！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "哈哈哈哈……！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "這下你們明白了吧！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n叫來救兵的",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "可不是只有你們啊！！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "來吧兩位，",
    "voice": "vo_adv_9006519_026",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
