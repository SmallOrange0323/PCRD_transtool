  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦，",
    "voice": "vo_adv_9500050_000",
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "天啊天啊！",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n{0}，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家真的可以嗎！？",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n這",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是來真的",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對吧？",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這樣啊……",
    "voice": "vo_adv_9500050_001",
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "原來是真的呢。",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n捏了一下手臂，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的會痛……",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這是真的耶。",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家超開心的呢。",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……",
    "voice": "vo_adv_9500050_002",
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "糟糕，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "眼淚怎麼掉下來了……",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈哈哈……",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家還是第一次",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "開心到哭出來呢。",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n是因為太開心，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "都搞不清楚自己怎麼回事了嗎……",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯，",
    "voice": "vo_adv_9500050_003",
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家沒事……",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才好溫柔啊。",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n現在也陪在人家身邊，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "連人家不擅長的讀書",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "也會陪著人家。",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……",
    "voice": "vo_adv_9500050_004",
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就是喜歡秀才",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這點喔。",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不對，",
    "voice": "vo_adv_9500050_005",
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是超級喜歡，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "超級超級喜歡。",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n更進一步來說，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家喜歡秀才的一切……！",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "等等、",
    "voice": "vo_adv_9500050_006",
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "糟糕……",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不小心把心裡想的全說出來了。",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那人家就趁勢說下去吧！",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "欸欸，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "聽人家說。",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家",
    "voice": "vo_adv_9500050_007",
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "偶爾會想，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n如果人生是一座伸展台，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家希望秀才不是坐在觀眾席上，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n而是在人家身邊，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "陪人家一起往前走。",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這樣的話，",
    "voice": "vo_adv_9500050_008",
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "一定會超級幸福。",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n每一天都會是寶物，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "也會變得特別，對吧？",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家只有對秀才，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "才會有這樣的想法喔！",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……",
    "voice": "vo_adv_9500050_009",
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那個，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你有聽懂",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家說的話嗎？",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "呃，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "也就是說……",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的嗎！？",
    "voice": "vo_adv_9500050_010",
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不愧是秀才♪",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n果然，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "超級合拍的！",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼，",
    "voice": "vo_adv_9500050_011",
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "今後也請多多指教囉♪",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "一起走上甜蜜的伸展台……",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "之前，",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "先一起走上",
    "voice": null,
    "unit_id": 101641
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "勝利的伸展台吧！",
    "voice": null,
    "unit_id": 101641
  }
]
