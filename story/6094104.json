    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "けど、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "もっと喜んでもらいたいから、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "少しアレンジしてみようかな～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "なるほど～、",
    "voice": "vo_adv_6076104_001",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "ワンちゃんって",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "骨が大好きだもんね～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "さすがキミ！　",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "ナイスアイデアさ～♪　",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "早速",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "作ってみよっと！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\nホネホネサーターアンダギーが完成したら、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "一度試食してみてね～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "サーターアンダギーの甘さと",
    "voice": "vo_adv_6076104_002",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "ジャーキーのしょっぱさとで、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\nどんな味になるのか想像もつかないさ～！　",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "けど",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "面白いアイデアかもね～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "他にも何か思いついたら、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "どんどん教えてほしいさ～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "それもそっか！　",
    "voice": "vo_adv_6076104_003",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "だって、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "今のままのサーターアンダギーで、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\nわたあめちゃんは十分喜んでくれてるもんね～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "いつも通り、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "気持ちを込めて",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "サーターアンダギーを作るさ～♪",
    "voice": null,
    "unit_id": 117711
  }
