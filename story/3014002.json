[
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "伊莉亞復活後經過了數天。\\n依里她們被伊莉亞召喚而來到了古城。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就此咱們要開始征服世界！",
    "voice": "vo_adv_3014002_000",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "【惡魔偽王國軍】成立！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "忍一行",
    "words": "…………",
    "voice": "vo_adv_3014002_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎樣啊怎樣啊？",
    "voice": "vo_adv_3014002_002",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "為什麼一臉苦瓜臉啊？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "先別管那些事情，趕快讓宮子復活啦～！",
    "voice": "vo_adv_3014002_003",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "宮子，伊莉亞說她沒辦法。",
    "voice": "vo_adv_3014002_004",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "奴家可沒說沒辦法！",
    "voice": "vo_adv_3014002_005",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只是這麼小的身體，魔力不夠而已……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不，反而是魔力不夠，",
    "voice": "vo_adv_3014002_006",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n所以才變成小孩的樣子……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "想不到『傳說的吸血鬼』竟是個小女孩呢……",
    "voice": "vo_adv_3014002_007",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們的『願望』不能實現了呀……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "伊莉亞，要靠我們5個人征服世界，",
    "voice": "vo_adv_3014002_008",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我想是相當地困難……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔。如果奴家可以恢復原本的力量，就很簡單，",
    "voice": "vo_adv_3014002_009",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n但現在這樣的話……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過放心！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n今天要跟大家介紹幫手！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喂！",
    "voice": "vo_adv_3014002_010",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n出來吧！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "忍一行",
    "words": "啊～！",
    "voice": "vo_adv_3014002_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你、你怎麼會在這裡？",
    "voice": "vo_adv_3014002_012",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你和伊莉亞認識嗎？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊，",
    "voice": "vo_adv_3014002_013",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是你～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你帶著宮子的布丁來了嗎～？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "趕快給宮子！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你好。",
    "voice": "vo_adv_3014002_014",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "順帶一提，你今天的運勢……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……看起來壞到谷底呢，請小心一點。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥！茜里好開心可以見到你～",
    "voice": "vo_adv_3014002_015",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n心跳加速成這樣呢。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "你看，來摸摸看確認一下♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯？什麼？",
    "voice": "vo_adv_3014002_016",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妳們全都和主君認識啊？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "主君也真是好色呢。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過呢，要成為奴家的僕人，",
    "voice": "vo_adv_3014002_017",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這種程度的『魅惑』應該也是理所當然。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哇哈哈哈哈！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "總之，【惡魔偽王國君】的",
    "voice": "vo_adv_3014002_018",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n戰力又增加了！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "即使你當幫手，",
    "voice": "vo_adv_3014002_019",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我一點都不覺得戰力有提升……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是啊。",
    "voice": "vo_adv_3014002_020",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n也只是變成6個人而已，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "要征服世界真是叫人不安啊。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵，擔心人數嗎？",
    "voice": "vo_adv_3014002_021",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "軍隊的戰力",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n的確由人數決定，這是很重要的元素。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也不是不能理解。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但儘管放心。奴家還有闇黑眷族！",
    "voice": "vo_adv_3014002_022",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只要讓他們成為僕人，一下子就",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n組成敢死隊了！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "闇黑眷族～？",
    "voice": "vo_adv_3014002_023",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n那很強嗎～？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵呵，那就讓你們瞧瞧吧！",
    "voice": "vo_adv_3014002_024",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "來吧，蝙蝠們！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "壞巴特",
    "words": "──咕喔喔喔喔喔",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "壞巴特",
    "words": "！",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哇！好、好厲害！這麼多！",
    "voice": "vo_adv_3014002_025",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不愧是吸血鬼！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哇哈哈哈哈！如何啊，看到了吧？",
    "voice": "vo_adv_3014002_026",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "蝙蝠們呀，先在那兒歇息吧……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯？主君，你們怎麼了？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "壞巴特",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好、好痛！要、要做什麼啊！",
    "voice": "vo_adv_3014002_027",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "快、快停下來啊！！！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "牠們怎麼不聽奴家的話！",
    "voice": "vo_adv_3014002_028",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "奴家的魔力竟然變得這麼弱！！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "伊莉亞……",
    "voice": "vo_adv_3014002_029",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n竟然被自己掌控的魔物給擺了一道，是要怎樣呢……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "妳真的是『傳說的吸血鬼』嗎……",
    "voice": "vo_adv_3014002_030",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哇！ ",
    "voice": "vo_adv_3014002_031",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "得、得救了！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n真不愧是奴家的僕人！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什、什麼？",
    "voice": "vo_adv_3014002_032",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……要先逃跑？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這、這樣啊。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n總之先離開吧！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哇！要、要做什麼啊！",
    "voice": "vo_adv_3014002_033",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不要抱起奴家啊！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這樣奴家不就像個小孩一樣嗎！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你也是有些地方挺可靠的嘛。",
    "voice": "vo_adv_3014002_034",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n有點刮目相看了呢……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只有一點點啦。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "伊莉亞，妳的臉很紅耶？",
    "voice": "vo_adv_3014002_035",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "才、才沒有！",
    "voice": "vo_adv_3014002_036",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
