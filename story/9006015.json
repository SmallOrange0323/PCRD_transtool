  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為了與大家一起享用未知的美味料理，",
    "voice": "vo_adv_9006015_014",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n我們不能停下腳步。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哦，",
    "voice": "vo_adv_9006015_015",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可蘿仔，這句話講得不錯嘛。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "未知的大地、",
    "voice": "vo_adv_9006015_016",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "未知的魔物……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
