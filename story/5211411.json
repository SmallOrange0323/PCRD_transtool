    "name": "美空",
    "words": "話說～？",
    "voice": "vo_adv_5211411_012",
    "unit_id": 136312
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n難得的聖誕節，",
    "voice": null,
    "unit_id": 136312
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n來想些更開心的事情吧。",
    "voice": null,
    "unit_id": 136312
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "又",
    "voice": "vo_adv_5211411_013",
    "unit_id": 136312
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "或",
    "voice": null,
    "unit_id": 136312
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "是……",
    "voice": null,
    "unit_id": 136312
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "再來一次，",
    "voice": null,
    "unit_id": 136312
  },
