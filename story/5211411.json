    "words": "城鎮",
    "voice": "vo_adv_5211411_000",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "也完全回復正常了呢。",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯，雖然有魔物出現，",
    "voice": "vo_adv_5211411_001",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但馬上就被我們打倒了嘛。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n聖誕樹也平安無事真是太好了。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不過那個叫阿爾莎特的人，",
    "voice": "vo_adv_5211411_002",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "看起來好像很從容呢。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "如果認真起來，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "或許會更難應付……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就是說啊。",
    "voice": "vo_adv_5211411_003",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……而、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "而且還一直說些奇怪的話，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我是不想再見到她了──",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但是也顧不得這麼說呢。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "…………",
    "voice": "vo_adv_5211411_004",
    "unit_id": 136312
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "美空？",
    "voice": "vo_adv_5211411_005",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "咦？",
    "voice": "vo_adv_5211411_006",
    "unit_id": 136312
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "不，",
    "voice": null,
    "unit_id": 136312
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "沒什麼喔★",
    "voice": null,
    "unit_id": 136312
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 136312
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "下次見面的時候要怎麼做呢～？",
    "voice": null,
    "unit_id": 136312
  },
