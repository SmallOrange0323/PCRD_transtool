    "type": "dialogue",
    "name": "真琴",
    "words": "啊……",
    "voice": "vo_adv_5211411_007",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n美空，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳不要想太多喔？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "咦？",
    "voice": "vo_adv_5211411_008",
