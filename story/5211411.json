  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 136312
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "因為被阿爾莎特逃掉了，",
    "voice": null,
    "unit_id": 136312
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n所以又要重新",
    "voice": null,
    "unit_id": 136312
  },
