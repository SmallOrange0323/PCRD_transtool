    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "真是適合兩位的獎品呢！　",
    "voice": "vo_adv_1018010_048",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "要相親相愛地使用喔～",
