  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "鬧區裡正在舉行美食活動。\\n{0}撥開混雜的人群，\\n向不久前剛抵達碰面地點的伊緒搭話。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……",
    "voice": "vo_adv_1018010_000",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "…………啊，",
    "voice": "vo_adv_1018010_001",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "早安！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "抱歉，",
    "voice": "vo_adv_1018010_002",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我剛才只是在想點事情。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我有發呆這麼久嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不過別在意。",
    "voice": "vo_adv_1018010_003",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n今天是",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "為了答謝你前陣子協助我進行教學參觀，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "讓我們盡情玩得開心吧。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "像這樣和你一起出來玩，",
    "voice": "vo_adv_1018010_004",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "說不定也能轉移注意力。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "沒什麼！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "活動職員",
    "words": "今天前來本會場的各位，",
    "voice": "vo_adv_1018010_005",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "活動職員",
    "words": "\\n要不要來參加邊走邊吃蓋章集點活動呢～？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "活動職員",
    "words": "只要收集吃料理而得到的集點章，",
    "voice": "vo_adv_1018010_006",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "活動職員",
    "words": "\\n就能交換精美的獎品喔～！　",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "活動職員",
    "words": "集章卡在這裡～！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "要不要玩玩看蓋章集點活動？",
    "voice": "vo_adv_1018010_007",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這個嘛，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "難得都來了，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我們也參加看看吧。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，",
    "voice": "vo_adv_1018010_008",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "讓你擔心了嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n不過我沒事的。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "走，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "轉換心情好好玩樂吧！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "分店的店員1",
    "words": "好，",
    "voice": "vo_adv_1018010_009",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "分店的店員1",
    "words": "集點章一個。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "分店的店員1",
    "words": "\\n謝謝惠顧～！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "看起來很好吃呢～",
    "voice": "vo_adv_1018010_010",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我也開動了。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嚼嚼……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嚼嚼…………",
    "voice": "vo_adv_1018010_011",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "…………吞下。",
    "voice": "vo_adv_1018010_012",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊！　",
    "voice": "vo_adv_1018010_013",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "沒有，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不是的！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不是那樣的……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……也是呢，",
    "voice": "vo_adv_1018010_014",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "人家說把心事說給別人聽之後，心情會舒暢點，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "就讓你聽聽我的心事好了。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n能讓我說出這種事情的人，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "也只有你了。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "其實呀，",
    "voice": "vo_adv_1018010_015",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我在邀請你參加這個活動之後，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "有參加了學生時期的同學會。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我好久沒有和以前的同學們見面了，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但是大家都有男朋友，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "聽說大家出去都是雙雙對對的。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "看大家開心聊著男朋友的事，讓我感到好羨慕，",
    "voice": "vo_adv_1018010_016",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我也",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "希望自己有一天",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "能交到可以對朋友說的男朋友。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不知不覺，就發現自己滿腦子都是這些事了，",
    "voice": "vo_adv_1018010_017",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "所以，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "才會比平常還容易發呆和冒失的樣子呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "抱歉，還跟你說這些話！",
    "voice": "vo_adv_1018010_018",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我今天是想回報你才邀你出來的，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "結果卻讓你擔心了。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那個是",
    "voice": "vo_adv_1018010_019",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "約會的邀請……？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我們可是老師和學生。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "怎麼能夠真的去約會～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不過，",
    "voice": "vo_adv_1018010_020",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你也是男孩子，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "也是呢……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那不是少女漫畫常見的橋段嗎！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不行不行，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那怎麼行！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "活動職員",
    "words": "距離活動結束還剩一點時間～！",
    "voice": "vo_adv_1018010_021",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "活動職員",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "活動職員",
    "words": "蓋章集點活動蓋滿集點卡的人，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "活動職員",
    "words": "\\n麻煩",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "活動職員",
    "words": "請盡早去交換獎品～！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不好了！",
    "voice": "vo_adv_1018010_022",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n集點章還沒完全收集到！　",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我們動作快點吧！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "小姐！",
    "voice": "vo_adv_1018010_023",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "\\n你們看起來好像很困擾呢！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯，",
    "voice": "vo_adv_1018010_024",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "難得來參加活動的說……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "呵呵呵……",
    "voice": "vo_adv_1018010_025",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "要不要用",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "我店裡的章魚燒來解決妳的煩惱啊？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那種事做得到嗎？",
    "voice": "vo_adv_1018010_026",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "啊啊！　",
    "voice": "vo_adv_1018010_027",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "偷偷跟妳說，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "其實我食材還有剩……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "所以，",
    "voice": "vo_adv_1018010_028",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "小姐你們還差的集點章數量的份，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "\\n我一起賣給你們算你們便宜，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "你們可以多買點回去吃嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "\\n……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "有困難時就是要互相幫助，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "對吧？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我吃！　",
    "voice": "vo_adv_1018010_029",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嚼嚼、嚼嚼！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊啊嗯，",
    "voice": "vo_adv_1018010_030",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "裡面好燙好濃稠～！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "都要被燙傷了～！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "跟我預料的一樣，",
    "voice": "vo_adv_1018010_031",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "吃得很可口呢！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "好，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "我去幫你們蓋剛才吃掉的份的集點章！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯嗯～",
    "voice": "vo_adv_1018010_032",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我不行了……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n感覺章魚燒都要從肚子裡跑出來了……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你那邊如何……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好厲害！　",
    "voice": "vo_adv_1018010_033",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "全部都吃掉了呢！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你什麼都不用說。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "因為你臉上",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "就寫著「我不行了」。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "之後，",
    "voice": "vo_adv_1018010_034",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "就剩我這最後一個呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n這樣集點章就收集齊了。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "雖然並不是和男朋友約會，",
    "voice": "vo_adv_1018010_035",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但今天是和你兩人單獨外出啊。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "然而，",
    "voice": "vo_adv_1018010_036",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "卻因為我的關係",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "讓你擔心了……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我得把最後這一個吃掉，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "然後去換獎品！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "咦，",
    "voice": "vo_adv_1018010_037",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "可是……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "真的沒關係嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那就……",
    "voice": "vo_adv_1018010_038",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "來，",
    "voice": "vo_adv_1018010_039",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊～～～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，",
    "voice": "vo_adv_1018010_040",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你真的很溫柔呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n一臉認真地張大嘴巴，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "看起來真的好奇怪，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但是我每次都受到你的幫助呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "哦！　",
    "voice": "vo_adv_1018010_041",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "你們還真是閃呢～！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "\\n好，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "那我來幫你們蓋最後一個集點章！　",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "恭喜～！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "太好了！",
    "voice": "vo_adv_1018010_042",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "肚子真的沒問題嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "真不愧是發育期。",
    "voice": "vo_adv_1018010_043",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "今後是不是會變得又更可靠呢。",
