    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "活動職員",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "活動職員",
    "words": "來，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "活動職員",
    "words": "請收下。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哇――！",
    "voice": "vo_adv_1018010_046",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "會是什麼呢？　",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "趕快打開來看看吧！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……",
    "voice": "vo_adv_1018010_047",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這個",
