    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "喂～",
    "voice": "vo_adv_1018010_044",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "工作人員。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "\\n這邊的小姐們，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "分店的店員2",
    "words": "集點章都收集滿囉！",
