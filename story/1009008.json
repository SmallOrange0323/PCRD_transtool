[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "完成工作後在街上漫步的{0}，\\n偶然碰到了修特帕魯。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵……吉格魯特，",
    "voice": "vo_adv_1009008_000",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "找到你了。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我想說來這裡的話，應該就能遇見你。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "因為我和你在前世有深厚的關係。",
    "voice": "vo_adv_1009008_001",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你的想法，我輕而易舉地就能知道。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "新的「組織」已經被發現開始行動了，",
    "voice": "vo_adv_1009008_002",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n今天是為了應對與他們的戰鬥，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你也要準備一下――",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗚，",
    "voice": "vo_adv_1009008_003",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這道光是……！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n「組織」的攻擊",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "來得那麼快嗎！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "保持住清醒啊！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "光線太強烈了……！",
    "voice": "vo_adv_1009008_004",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗚哇哇哇！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "still",
    "still_id": "100900801"
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "呵……我知道的。",
    "voice": "vo_adv_1009008_005",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n這座城叫，龍岩堡！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "哇！",
    "voice": "vo_adv_1009008_006",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "\\n",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "好帥氣喔！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "呵呵，對吧？",
    "voice": "vo_adv_1009008_007",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這座城堡的頂樓，囚禁著一位美麗的公主。",
    "voice": "vo_adv_1009008_008",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n雖然想救出公主，但有一條龍在看守著這座城！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "而接近這座城的人，都會成為那條龍的食物……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "嗚嗚，好可怕喔……",
    "voice": "vo_adv_1009008_009",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "不要害怕。只要交給我，一下子就可以殺死那條龍了。",
    "voice": "vo_adv_1009008_010",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我一定會救出公主的！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "哇！",
    "voice": "vo_adv_1009008_011",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "\\n",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "好厲害，好厲害──！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "因為這些小孩，",
    "voice": "vo_adv_1009008_012",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n是發自內心覺得我說話很有趣，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n所以我不自覺地也很開心。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "……吉格魯特！？想不到是你……！",
    "voice": "vo_adv_1009008_013",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "為、為、為什麼你會在這裡！？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "不、不是！不是這樣的！",
    "voice": "vo_adv_1009008_014",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我是疾風之冥姬，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n怎麼會和小孩們開心地玩在一起呢？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "他們是住在這附近的小孩……",
    "voice": "vo_adv_1009008_015",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "所以就幫忙照顧一下……？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "杏奈姊姊。這個人是誰？",
    "voice": "vo_adv_1009008_016",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "\\n",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "他是姊姊的朋友嗎？",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "啊、喔喔……吉格魯特……",
    "voice": "vo_adv_1009008_017",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "該怎麼解釋才好呢……？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "吉格魯特，是這個……在前世和我一起戰鬥……",
    "voice": "vo_adv_1009008_018",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "至死之前都經常和我在一起的盟友。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "一直在一起？",
    "voice": "vo_adv_1009008_019",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "\\n",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "哇！他是姊姊的丈夫吧！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "不、不是！",
    "voice": "vo_adv_1009008_020",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "那個、是前世的事啦！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "……確實，我們在前世的時候關係親密。",
    "voice": "vo_adv_1009008_021",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n最後我和吉格魯特成為了伴侶――也就是夫妻！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "但這只不過是前世發生的事而已……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "姊姊已經結婚了──！？",
    "voice": "vo_adv_1009008_022",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "如果是夫妻的話就親嘴看看──！",
    "voice": "vo_adv_1009008_023",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "我也想看你們親嘴──！",
    "voice": "vo_adv_1009008_024",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "\\n親嘴、親嘴──！",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你、你們在說什麼！？",
    "voice": "vo_adv_1009008_025",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n我不是說過那是前世的事嗎！？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n這一世的我們不是那種關係……！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "嗯、嗯……所以，是不同的……",
    "voice": "vo_adv_1009008_026",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n那個親嘴什麼的……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "嗚、嗚哇哇哇哇哇！！",
    "voice": "vo_adv_1009008_027",
    "unit_id": 100931
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，辛苦了。",
    "voice": "vo_adv_1009008_028",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "杏奈她，比想像中純情呢──",
    "voice": "vo_adv_1009008_029",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n雖然角色設定上經常會說出很勁爆的話，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但實際上好像還是會對那樣的對話感到困擾。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯，但就是這一點令人覺得可愛呢。",
    "voice": "vo_adv_1009008_030",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然這樣說，但對於那種狀況她好像不太開心啊。",
    "voice": "vo_adv_1009008_031",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以，像你這樣不會過於相信角色設定，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但又沒有完全否認的方式就恰到好處。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是前世的盟友嗎？",
    "voice": "vo_adv_1009008_032",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n真是有趣的設定……該不會她知道了什麼吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "無論如何，你們是一個不錯的組合呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "今後也要在杏奈身邊，",
    "voice": "vo_adv_1009008_033",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n全力地支持她喔？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "閃光的吉格魯特先生。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，這次就先聊到這裡。",
    "voice": "vo_adv_1009008_034",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n掰～掰，再見囉♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……這裡、",
    "voice": "vo_adv_1009008_035",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是哪裡……？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我剛才、在做夢吧……！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉、吉格魯特！",
    "voice": "vo_adv_1009008_036",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "難道，你也作了那個夢！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不、不是！",
    "voice": "vo_adv_1009008_037",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那是另一個世界的我們……！",
    "voice": null,
