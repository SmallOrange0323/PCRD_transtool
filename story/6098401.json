[
  {
    "type": "background",
    "bg_id": "501162"
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "漁師のおっちゃんたちって、",
    "voice": "vo_adv_6056401_000",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "変わった魚の釣り方するよなー。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "アタシもたまに川で釣りはするけどさ、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n結構コツが必要なんだよ……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "好きっていうか……",
    "voice": "vo_adv_6056401_001",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "腹が減った時にやるくらいだな！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n川ごとぶった斬れば、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "すぐに魚が浮いてきて……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "へっ？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "　それは釣りじゃない？　",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "……そうなのか？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "おお、",
    "voice": "vo_adv_6056401_002",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "オマエもそう思うか？　",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "陸の魔物を狙うのは簡単なんだけどな……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "天楼覇断剣でドカーンってさ！　",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "魚だと骨も残んない時があるからな。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "いやー、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "釣りって奥が深いよな！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "今度一緒に釣るか？　",
    "voice": "vo_adv_6056401_003",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "だったらどっちが多く釣れるか、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\nアタシとオマエで勝負だ！　",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ふふっ、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ワクワクしてきたぞ！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\nアタシは天楼覇断剣で釣るからオマエは……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "え？　",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "反則？　",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "知るか！",
    "voice": null,
    "unit_id": 106113
  }
]
