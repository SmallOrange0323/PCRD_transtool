    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "藥房店員",
    "words": "歡迎光臨──♪",
    "voice": "vo_adv_2201002_034",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "莉莉",
