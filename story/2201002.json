    "words": "莉莉妳也",
    "voice": "vo_adv_2201002_073",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n用暱稱",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "來稱呼哥哥怎麼樣？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "如此一來，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "就和我們一樣了喔♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "咦……",
    "voice": "vo_adv_2201002_074",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "但、",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "但是……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那個……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n不會",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "很失禮嗎……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……",
    "voice": "vo_adv_2201002_075",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那、",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那麼……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n恕我冒昧……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "兄長大人……",
    "voice": "vo_adv_2201002_076",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……呵呵♪",
    "voice": "vo_adv_2201002_077",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊！",
    "voice": "vo_adv_2201002_078",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n各位──！！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喂，你們幾個！",
    "voice": "vo_adv_2201002_079",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n現在可不是悠哉吃章魚燒的時候了啦──！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "咦？",
    "voice": "vo_adv_2201002_080",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n凱留小姐，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "還有貪吃佩可小姐？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "各位怎麼那麼慌張？",
    "voice": "vo_adv_2201002_081",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是發生什麼事了嗎？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "關於這點！",
    "voice": "vo_adv_2201002_082",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n是因為我說服失敗了……！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "遠處傳來的聲音",
    "words": "陛下───！",
    "voice": "vo_adv_2201002_083",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "咦？",
    "voice": "vo_adv_2201002_084",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n好像有人在叫妳……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們就是要逃離那傢伙啦！",
    "voice": "vo_adv_2201002_085",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了，你們也快點跑起來！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "瞭。",
    "voice": "vo_adv_2201002_086",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "難道說，",
    "voice": "vo_adv_2201002_087",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是因為貪吃佩可小姐",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n要處理政務，所以沒有空嗎……！？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不，",
    "voice": "vo_adv_2201002_088",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那方面完全沒有問題！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過，我只是說我要暫時離開城鎮，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n行政長官就說她也要同行，勸都勸不聽！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "咦……！？",
    "voice": "vo_adv_2201002_089",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那傢伙雖然是個笨蛋，",
    "voice": "vo_adv_2201002_090",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但卻超有行動力，所以很難應付呢……！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒辦法了，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你們聽好，拎上可蘿仔後就直接出發囉！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可璃亞、莉莉",
    "words": "咦咦咦……！？",
    "voice": "vo_adv_2201002_091",
    "unit_id": null
  }
]
