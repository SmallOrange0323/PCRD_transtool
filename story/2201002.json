[
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──時序回到現在。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}和貪吃佩可被魔物們囚禁了起來……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "220100101"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……大概就是這樣。",
    "voice": "vo_adv_2201002_000",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們從【幻變少女】的那邊",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "承接了護衛的委託喔～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n回想起來了嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿嘿……",
    "voice": "vo_adv_2201002_001",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "太好了☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}，\\n看來你並沒有失憶呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔～嗯。",
    "voice": "vo_adv_2201002_002",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n接受委託後，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還發生了很多事……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": "vo_adv_2201002_003",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "在結束食堂的談話後，到出發前的那段期間內，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們是分頭行動的。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你和莉莉她們聊了些什麼呢？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼，",
    "voice": "vo_adv_2201002_004",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n為了冒險，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下想要著手準備便當。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我去準備用來返回的魔法陣～",
    "voice": "vo_adv_2201002_005",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可要去王宮？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是的。",
    "voice": "vo_adv_2201002_006",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "得先向純小姐、克蕾琪塔小姐她們",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n取得外出旅行的同意才行……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳可要想好說詞喔──？",
    "voice": "vo_adv_2201002_007",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "特別是那個狸貓眼鏡。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n要是妳明說自己要去冒險，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "她搞不好會說「我也要跟隨陛下～！」",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就跟著過來了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊哈哈……",
    "voice": "vo_adv_2201002_008",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "說實話，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "跟我這個公主比起來，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n要是克蕾琪塔小姐不在，城市的經濟才會真正變得不妙呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人。",
    "voice": "vo_adv_2201002_009",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下能不能",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拜託主人跑腿，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "去買些必需品呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝您，",
    "voice": "vo_adv_2201002_010",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下會準備好備忘清單的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "因為能預期這將是一場漫長的冒險，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要準備的東西可能會有點多……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "…………",
    "voice": "vo_adv_2201002_011",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "趕快趕快，",
    "voice": "vo_adv_2201002_012",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "莉莉？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n這可是機會喔……？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……好、",
    "voice": "vo_adv_2201002_013",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "好……！",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那個……",
    "voice": "vo_adv_2201002_014",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "既、",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "既然這樣……！",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n不介意的話，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n能不能也讓我們幫忙採買呢……？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是……",
    "voice": "vo_adv_2201002_015",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n【幻變少女】的各位",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可是委託人……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "請別放在心上♪",
    "voice": "vo_adv_2201002_016",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n不只是行前準備，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我們也想在旅途中幫上忙……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "最起碼要避免拖累你們，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我們會盡力幫忙的。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "搬東西。",
    "voice": "vo_adv_2201002_017",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n會幫忙唷。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下明白了。",
    "voice": "vo_adv_2201002_018",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n主人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "幾位就拜託您照顧了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是、",
    "voice": "vo_adv_2201002_019",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是……！",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……♪",
    "voice": "vo_adv_2201002_020",
    "unit_id": 126012
  },
  {
    "type": "background",
    "bg_id": "500610"
  },
  {
    "type": "dialogue",
    "name": "食品店店員",
    "words": "歡迎光臨──♪",
    "voice": "vo_adv_2201002_021",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那麼，{0}大人，",
    "voice": "vo_adv_2201002_022",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n一開始要買什麼呢？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "罐頭。",
    "voice": "vo_adv_2201002_023",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n肉乾。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n之類的？",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是乾糧呢。",
    "voice": "vo_adv_2201002_024",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這些的確",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "好像很重要。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "食品店店員",
    "words": "謝謝──♪",
    "voice": "vo_adv_2201002_025",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……鹽，",
    "voice": "vo_adv_2201002_026",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n還有，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "調味料也？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "就地取得……？",
    "voice": "vo_adv_2201002_027",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "就地取得……！",
    "voice": "vo_adv_2201002_028",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "原來如此♪",
    "voice": "vo_adv_2201002_029",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n為了要替釣上來的魚，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "或是採到的蔬菜等食材調味，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n所以才事先準備了鹽和辛香料呀。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "真的嗎？",
    "voice": "vo_adv_2201002_030",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n真期待……♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_2201002_031",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n好期待……！",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "完全不挑食。",
    "voice": "vo_adv_2201002_032",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "唷。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "不論是什麼食物，",
    "voice": "vo_adv_2201002_033",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我們都不會抱怨的。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "真要說起來，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n我們只是委託護衛的那一方。",
    "voice": null,
    "unit_id": 125812
  },
