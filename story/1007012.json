    "voice": "vo_adv_1007012_045",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "咦？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n你手上",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "為什麼沒有宮子的布丁？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n剛才明明有一大堆的！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "被吃……？",
    "voice": "vo_adv_1007012_046",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "咦咦咦咦咦！？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "被吃掉了？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你這是在",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "說什麼傻話來的！？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "抱歉啦，",
    "voice": "vo_adv_1007012_047",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "小姑娘。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "\\n布丁被我們美味地享用啦。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "就當做是",
    "voice": "vo_adv_1007012_048",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "補償前陣子由你們所帶來的損失吧。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "如此一來就當做互不相欠了。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "──你，",
    "voice": "vo_adv_1007012_049",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "在說什麼蠢話？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "哎，",
    "voice": "vo_adv_1007012_050",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "我知道妳很不爽。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "但是",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "我們也──",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "吃了宮子的布丁？",
    "voice": "vo_adv_1007012_051",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n沒經過宮子允許？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n就你們是嗎？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "喂喂，",
    "voice": "vo_adv_1007012_052",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "先別急啊，小姑娘。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "\\n我們只是想做點惡作劇──",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "布丁不是惡作劇道具來的。",
    "voice": "vo_adv_1007012_053",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "總、",
    "voice": "vo_adv_1007012_054",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "總之呢。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "讓我們聊一下如何。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
