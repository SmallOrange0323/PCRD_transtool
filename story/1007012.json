    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "挑哪個好呢……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "嗯嗯嗯～？",
