  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "莫名其妙的好冷啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "\\n外頭明明那麼晴朗……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "抖抖。",
