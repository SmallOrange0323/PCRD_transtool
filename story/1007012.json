    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "吃得可真飽！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "\\n感謝招待！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "……嗯？",
    "voice": "vo_adv_1007012_033",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "\\n是錯覺嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "怎麼感覺突然變冷了……",
