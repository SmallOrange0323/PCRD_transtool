    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯──？",
    "voice": "vo_adv_1007012_042",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n感覺好像在",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "什麼地方見過你們。",
