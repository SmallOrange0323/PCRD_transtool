  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "誰理你啊！",
