    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "旅行商人們",
    "words": "出、",
    "voice": "vo_adv_1007012_041",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人們",
    "words": "出現啦～！！",
