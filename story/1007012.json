  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "就讓我們稍微找個碴吧。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "\\n只要小兄弟在我們手中，",
