    "type": "dialogue",
    "name": "旅行商人１",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "感覺有多少都吃得下……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "嚼嚼。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "此後過了不久──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n旅行商人們把宮子的布丁一個不剩全都吃光了。",
