    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "嘿嘿嘿，",
    "voice": "vo_adv_1007012_029",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "就該這樣才對！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "我看看",
