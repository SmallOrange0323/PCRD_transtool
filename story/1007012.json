  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "這次換成燈光被……！",
    "voice": "vo_adv_1007012_035",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "看來小姑娘來了。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "\\n很好，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "可別離開我身邊啊。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "緊緊拿好護符──",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人們",
    "words": "咦？",
    "voice": "vo_adv_1007012_036",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "喂……",
    "voice": "vo_adv_1007012_037",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "喂喂喂、",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "喂！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旅行商人２",
    "words": "\\n變成一片漆黑啦！？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "background",
    "bg_id": "500570"
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "什麼嘛……",
    "voice": "vo_adv_1007012_038",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旅行商人１",
    "words": "嚇死人了。",
