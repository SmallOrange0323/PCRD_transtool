[
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "海に来たのはいいけど、",
    "voice": "vo_adv_6044101_000",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "泳いでばっかりってのも疲れちまうもんだね。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n何か息抜きに他のことをしたいもんだけど、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "何がいいかねぇ……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "お前さんは、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "何かやりたいこととかないのかい？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "ああ、",
    "voice": "vo_adv_6044101_001",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "ありかもしれないね。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "多分、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "この辺りに……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "よっと！",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\nで、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "何匹捕まえるんだい？　",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "腹が膨れるなら10匹くらいは……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "え、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "何って、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "食事用に捕まえるんじゃないのかい？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "砂遊びねぇ……",
    "voice": "vo_adv_6044101_002",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "あ、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "そうだ。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "ちょっと試したいことがあるんだけど",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n山盛りに砂を積んでくれるかい？　",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "そう、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "その感じで。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "はぁっ！",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "……うーん、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "刀で斬って形を整えるのは難しいみたいだね。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "こういう日差しのいいところで寝るのも気持ちがいいんだよね。",
    "voice": "vo_adv_6044101_003",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "……そういえば、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "向こうでハンモックを見たんだよ。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\nちょっとのんびり揺られてこようじゃないか。",
    "voice": null,
    "unit_id": 113111
  }
]
