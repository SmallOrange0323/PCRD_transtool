[
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "そしてまた、ある日の昼下がり。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nランドソル王宮城門前に立つ黒鉄の鎧の前に、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n再び二つの影が集っていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "502700001"
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "マツリ団員、",
    "voice": "vo_adv_5027007_000",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "トモね～ちゃんといっしょに",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ただいま戻りましたッス！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "おかえり、",
    "voice": "vo_adv_5027007_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "トモちゃん",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "マツリちゃん。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n無事でよかったよ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\nさっそく",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "【ドラゴンズネスト】の調査報告をしてもらってもいいかな？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "はい。",
    "voice": "vo_adv_5027007_002",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "船団の構成員のほとんどは、",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ギャングやならずものたちでした。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ですが",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "今回の『開拓』は、",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ギャングとしての活動ではなく、",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n【ドラゴンズネスト】本来のギルド活動のようでした。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ギャングにギルドの手伝いをさせるなんて",
    "voice": "vo_adv_5027007_003",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "すごいことしちゃうッスね、",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ホマレさん……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "彼女たちが探していたのは、",
    "voice": "vo_adv_5027007_004",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "遺跡と",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "そこに眠る何か……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "そこで手に入れた物を",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "どう使うかまでは分かりませんけど。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "ふむ……",
    "voice": "vo_adv_5027007_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "『島』には文明の痕跡はないって話だったんだけど、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\nその口ぶりじゃあ、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "遺跡は存在していたみたいだね。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "still",
    "still_id": "502700701"
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "したッス！",
    "voice": "vo_adv_5027007_006",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "　",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "あと",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "なんか",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ドラゴンみたいなのもいたッス！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "そうそう、",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "あの人も一緒にいたッス！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\nなんか",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "仲良しさんみたいだったッスよ。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "そうだったのかい？",
    "voice": "vo_adv_5027007_007",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\nそれは興味深いね。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "正確には",
    "voice": "vo_adv_5027007_008",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "遺跡の残骸",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "って感じだったのと、",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ドラゴンみたいな生物だね。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "あの『島』は一筋縄じゃいきませんよ。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "管理協会も苦労するはずだ。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "それよりも──",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "ドラゴン族のほうが危険……",
    "voice": "vo_adv_5027007_009",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "とでも言いたそうだね。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ただ、",
    "voice": "vo_adv_5027007_010",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ギャングとしての活動をしていたとしても……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "彼女たちは、",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n純粋に悪意だけで",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "動いているギルドではないみたいです……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "すみません、",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "かなり私見がはいっちゃってますね。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "いや、",
    "voice": "vo_adv_5027007_011",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "トモちゃんがそう言うのであれば",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "私は信じるよ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\nキミのそういう目利きには、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "いつも助けられているしね。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "カヤさんもイノリさんも",
    "voice": "vo_adv_5027007_012",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "決して悪い人じゃないッス！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "まあ……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ホマレさんは何考えてるかよく分からないッスけど……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "いえ、",
    "voice": "vo_adv_5027007_013",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "気になるところはありますけど、",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "あの人とも知り合いでしたし……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\nきっと",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "大丈夫だと思います。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "502700702"
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ッスね！",
    "voice": "vo_adv_5027007_014",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "　仲良くなれると思うっス！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "なるほど、",
    "voice": "vo_adv_5027007_015",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "少年の知り合いだというのなら",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "そうかもしれないね。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\nしかし、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "なんだか二人とも",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "ちょっと見ない間に成長したんじゃないかな。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n特にトモちゃんは",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "出発前よりもずいぶんと大人びて見えるよ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ッス！",
    "voice": "vo_adv_5027007_016",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "　前よりも",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "頼りがいあるッス！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "そうかなあ？",
    "voice": "vo_adv_5027007_017",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "　自分じゃあよく分からないですけど……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "【ドラゴンズネスト】と",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "あの人のおかげかもしれないですね。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "じゃあ、",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "お礼も兼ねて",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ご飯のついでに",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "あの人をからかいにでもいこうか？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "いいッスね！",
    "voice": "vo_adv_5027007_018",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "　",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ちょうどランドソルの料理が恋しかったところッス！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "ふむ、",
    "voice": "vo_adv_5027007_019",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "もうすぐ定時だし、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "よければ私も行こうかな。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n二人の労を",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "ねぎらわないといけないからね。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "ジュンさんのおごりですか？",
    "voice": "vo_adv_5027007_020",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "　",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "やった！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "\\nよし、",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "マツリちゃん、",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "トモ",
    "words": "いつもの店まで競争だよ！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "あ、",
    "voice": "vo_adv_5027007_021",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ずるいッスよトモね～ちゃん！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\n待つッスよ～！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "で、",
    "voice": "vo_adv_5027007_022",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "どうなんだよボス。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "今回のことは",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "まるでムダ足だったってわけじゃないんだろ？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "ギルドの仕事としてはそうだね～",
    "voice": "vo_adv_5027007_023",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "でも",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "ドラゴンを探すっていう",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "第一の目的は果たせなかったかな～……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "……管理協会と騎士団に影響力のある貴族たちには",
    "voice": "vo_adv_5027007_024",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "根回しは済んでる。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "大丈夫。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "どうせすぐにまた、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "エルピス島の仕事は回ってくるよ。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "街でくすぶってる無法者を",
    "voice": "vo_adv_5027007_025",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "しばらくの間厄介払いできるし、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n王宮や管理協会にとって",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "『私たち』はまだ利用価値があるから。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "トモちゃんとマツリちゃんの上司、",
    "voice": "vo_adv_5027007_026",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "ジュンさんだったかな？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "その人にはいつか、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "今回のお礼をしないと……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "【王宮騎士団（NIGHTMARE）】も油断させたかったけどね～",
    "voice": "vo_adv_5027007_027",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "カヤちゃんってば",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "こういう時に限って覚醒しかけちゃうんだもん。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "やっぱり警戒……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "されちゃったよね？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "当然です。",
    "voice": "vo_adv_5027007_028",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "あの時のカヤぴぃ、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ちょっとどころかクッソ怖かったです……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "怒ったボスより怖かったです。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "悪かったよ。",
    "voice": "vo_adv_5027007_029",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "つい頭に血が上っちまってさ。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "っていうか",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "覚醒っての、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "しちゃ悪かったみたいに言うじゃん。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\nさせたいのかさせたくないのか、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "どっちかにしてくれよ……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "させたいんだけど、",
    "voice": "vo_adv_5027007_030",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "時と場所は選んでね☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "でも",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "他に収穫がなかったわけじゃないよ？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\nカヤちゃんのこともそうだけど～……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "これも。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "その石版、",
    "voice": "vo_adv_5027007_031",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ドラゴンもどきのオモチャじゃないですか。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "まさかっ！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "……それをこっちで売って",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ギルドの資金源にするです？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "残念。",
    "voice": "vo_adv_5027007_032",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "全然違いま～す☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "　",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "これは",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "あの子が集めた遺跡の出土品だよ？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n今のこの世界の歴史だと、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "エルピス島って",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "先日の発見より前まで、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "長～い間",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "アストライア大陸と交流がないはずなんだよねー☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "でもこの石板は、",
    "voice": "vo_adv_5027007_033",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "そんなに昔のものじゃない。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n年代的には",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "エルピス島から人類がいなくなってからつくられたもの。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "ね～☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "　明らかに矛盾があるでしょ～？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "うん？",
    "voice": "vo_adv_5027007_034",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "　つまりどういうことです？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "決定的じゃないにしろ、",
    "voice": "vo_adv_5027007_035",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "証拠は集まってるってことだろ。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "『この世界が間違ってる』ってことのさ。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "そういうことー☆",
    "voice": "vo_adv_5027007_036",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n時を遡る程の改変を行えても、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "細かいところは見逃しちゃったんだね。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "つまり……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "私たちのつけいる隙は、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "十分にある",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "って思わない？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "そういえばさ、",
    "voice": "vo_adv_5027007_037",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "イノリはなんか",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "ドラゴンもどきの言ってることが分かる",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\nみたいなこと言ってなかったか？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "なんとなく、",
    "voice": "vo_adv_5027007_038",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ですけど……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "もし",
    "voice": "vo_adv_5027007_039",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "ボスとラーゴみたいな感じだったらさ、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "ドラゴンもどきのヤツからなにか聞き出せないか？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "それはありえるかも～♪",
    "voice": "vo_adv_5027007_040",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "　",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "近しい種族との意思疎通能力も、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n私だけじゃなくて",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "ドラゴン族としての能力かもしれないし。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n調べてみる価値はあるかも。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "じゃあ、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "もう一回",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "あの島にいっちゃおっか☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ふええ！？",
    "voice": "vo_adv_5027007_041",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "　またですか？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nしばらくは文明社会でのんびりしたいですよ！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "オレは楽しみだけどな！",
    "voice": "vo_adv_5027007_042",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "とはいえ、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "街での喧嘩屋の依頼も",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
