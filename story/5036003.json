    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n若是這樣的話她一定就……！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……哇！",
    "voice": "vo_adv_5036003_006",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "皮喵！",
    "voice": "vo_adv_5036003_007",
    "unit_id": 4411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……{0}？",
    "voice": "vo_adv_5036003_008",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還有……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……嗚！",
    "voice": "vo_adv_5036003_009",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "痛痛痛，",
