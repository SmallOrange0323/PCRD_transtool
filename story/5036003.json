    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留！",
    "voice": "vo_adv_5036003_010",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n妳認得出來我嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我是妳最要好的摯友，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "貪吃佩可呀～☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "蛤！？",
    "voice": "vo_adv_5036003_011",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n別、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別隨便把自己說成是人家的摯友……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別開玩笑了笨蛋！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "啊。",
    "voice": "vo_adv_5036003_012",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "凱留的語尾……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "那個「喵」不見了呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "太好了，",
    "voice": "vo_adv_5036003_013",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "凱留變回原樣了呢♪",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔……！",
    "voice": "vo_adv_5036003_014",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳、",
    "voice": "vo_adv_5036003_015",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳們在說什麼呀～？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我才不是",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那種會說什麼「喵」的人嘛～",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我什麼都不記得了呢～",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "「偶像凱留，",
    "voice": "vo_adv_5036003_016",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "華麗登場喵～♪」",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「凱留凱留～☆」",
    "voice": "vo_adv_5036003_017",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "閉嘴啦——————！！！",
    "voice": "vo_adv_5036003_018",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我宰了妳們喔！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我真的會宰了妳們唷！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "啊哈哈，",
    "voice": "vo_adv_5036003_019",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "抱歉抱歉。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊啊真是夠了！",
    "voice": "vo_adv_5036003_020",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真的，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "到底為什麼每次都是我遇上這種爛事啊……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "那個，",
    "voice": "vo_adv_5036003_021",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "凱留。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n在妳還有些混亂的時候，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "很抱歉，但是……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "妳在被「盆栽小花」抓走了之後，",
    "voice": "vo_adv_5036003_022",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n到底遇到了什麼事，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "可不可以說給我們聽呢？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "方才與凱留小姐組成臨時團體的",
    "voice": "vo_adv_5036003_023",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n【Prosperity】的兩位，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都已經失去意識了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "儘管似乎並未受傷……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "然而要談話似乎是不可能的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以說，",
    "voice": "vo_adv_5036003_024",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n到底是什麼讓事情變成這樣了呢？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "原因是……",
    "voice": "vo_adv_5036003_025",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "「那個」唷。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "「那個」是……",
    "voice": "vo_adv_5036003_026",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "啊！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在「盆栽小花」的根部",
    "voice": "vo_adv_5036003_027",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有個拳頭般大小的洞……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n僅有該處，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "景色與周遭不相同呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "難道是空間，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "發生了扭曲不成……？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這個是，",
    "voice": "vo_adv_5036003_028",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "剛剛",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "島村村妳看到的那個嗎！？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哦——",
    "voice": "vo_adv_5036003_029",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我看看？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n有四角形石造建築物，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n真的和這邊比起來，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "感覺完全不一樣呢——",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "吶、",
    "voice": "vo_adv_5036003_030",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "吶，未央、",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "卯月。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n這個街頭的景色……！",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "是我們住的街道呀！",
    "voice": "vo_adv_5036003_031",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n絕對沒有錯！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "雖然還沒有完全想起來……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "但絕對是這樣沒錯！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "皮喵！",
    "voice": "vo_adv_5036003_032",
    "unit_id": 4411
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "\\n皮喵皮喵～！",
    "voice": null,
    "unit_id": 4411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "只要能穿過這裡……",
    "voice": "vo_adv_5036003_033",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "是不是就能",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "回到那邊了啊？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "可是這個洞",
    "voice": "vo_adv_5036003_034",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "非常小呢。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n當然對我們來說也是太小了，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "但是如果要讓皮喵太穿得過去的話，\\n洞就得變得相當大才行呢……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "皮喵……",
    "voice": "vo_adv_5036003_035",
    "unit_id": 4411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如果洞不再更大一點的話，",
    "voice": "vo_adv_5036003_036",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n卯月的屁股可能也會卡住嘛～",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "嗚呀！？",
    "voice": "vo_adv_5036003_037",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我、",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "才沒有那麼大呢～！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可是……",
    "voice": "vo_adv_5036003_038",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "從現狀來看，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "儘管是眾人中體型最瘦小的在下，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n也無法順利通過如此小的洞口。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "倘若各位想要回去，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼就得將洞再擴大一些才行了呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是呢。",
    "voice": "vo_adv_5036003_039",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n然後……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那好像也是這隻盆栽混蛋的目的呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼，",
    "voice": "vo_adv_5036003_040",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這就表示「盆栽小花」，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n它也想要回到那邊的意思嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好像是。",
    "voice": "vo_adv_5036003_041",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是目前的狀況，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "似乎是能量還不夠，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n而且好像光是要開啟這大小的洞就用盡全力了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "能量……？",
    "voice": "vo_adv_5036003_042",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我是不知道它原本是怎樣啦……",
    "voice": "vo_adv_5036003_043",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但在這個世界中的「盆栽小花」，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n好像能從演唱會上觀眾們的熱情中獲得能量。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是這樣嗎！",
    "voice": "vo_adv_5036003_044",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n竟然可以從觀眾的熱情中獲得力量……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "簡直就",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "像是偶像一樣呢♪",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "嘛，",
    "voice": "vo_adv_5036003_045",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "但它和我們不一樣，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n「盆栽小花」不能自己開演唱會嘛。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "畢竟它就只是個盆栽嘛☆",
    "voice": "vo_adv_5036003_046",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "啊……",
    "voice": "vo_adv_5036003_047",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那麼，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "「盆栽小花」把\\n新人偶像們全都抓走了的理由，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "難不成……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒錯。",
    "voice": "vo_adv_5036003_048",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就算想要熱情的能量，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n但只靠妳們【new generations】，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n一次所能夠炒熱的觀眾也還是有限。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以，",
    "voice": "vo_adv_5036003_049",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那些即使只有一點點想要成為偶像的孩子們，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n也被它用魔法的花粉操縱，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "聚集起來",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "並且進行訓練。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "它似乎是想用這種方法來獲得更多觀眾的熱情。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而在下等人想要救出被囚禁的人們，",
    "voice": "vo_adv_5036003_050",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n因此被操縱了的凱留小姐一行人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n方才才會試圖阻撓吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "如果剛才的話都是真的……",
    "voice": "vo_adv_5036003_051",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "那還真不得了呢，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "這個「盆栽小花」。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n明明一臉傻呼呼的樣子。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這個嘛，",
    "voice": "vo_adv_5036003_052",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我懂妳們懷疑的心情。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我當然也一樣，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如果沒有被這傢伙操控過，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我也沒有機會知道剛剛那些事。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "話說回來……",
    "voice": "vo_adv_5036003_053",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我有件事很在意，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "凱留。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼啊？",
    "voice": "vo_adv_5036003_054",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "剛剛妳是說，",
    "voice": "vo_adv_5036003_055",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n「那些即使只有一點點想要成為偶像的孩子們」",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "這樣",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "對吧？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "啊。",
    "voice": "vo_adv_5036003_056",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n這表示，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "凱留凱留妳……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "竟有此事。",
    "voice": "vo_adv_5036003_057",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n原來您也想成為偶像嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦，",
    "voice": "vo_adv_5036003_058",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是這樣的嗎小凱留？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊啊啊啊啊——！",
    "voice": "vo_adv_5036003_059",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是啦！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不對，",
    "voice": "vo_adv_5036003_060",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "或許也沒有不是也說不定！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只有一點點啦，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真的就只有一點點而已啦！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "更何況像我這種歲數的女孩子一般來說，",
    "voice": "vo_adv_5036003_061",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n都會想要像偶像一樣穿上漂漂亮亮的衣服受人寵愛吧！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n多少都有這樣想過吧！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "啊哈哈……",
    "voice": "vo_adv_5036003_062",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "嘛，",
    "voice": "vo_adv_5036003_063",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "雖然偶像並不是那麼簡單呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "不不，",
    "voice": "vo_adv_5036003_064",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我懂唷，凱留凱留的心情！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "原本就已經是偶像的凜未央卯月三人先不講……",
    "voice": "vo_adv_5036003_065",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可！　",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還有可蘿仔！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "為什麼妳們兩個，",
    "voice": "vo_adv_5036003_066",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒有被「小球根」給抓走呀！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳們完全沒有想過",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "想要當偶像之類的嗎！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下……",
    "voice": "vo_adv_5036003_067",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "作為主人的隨從之事，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "便是一切。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "當然，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "倘若主人如此期望，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那麼要同時擔任偶像與隨從，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也會樂意為之。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我的話，",
    "voice": "vo_adv_5036003_068",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "繼承家業應該是第一目標吧。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而且漂亮的衣服我也穿習慣了嘛。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……啊，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "當然我也不是真的對偶像一點興趣都沒有喔？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這種兩光的安慰還不如不要講——！",
    "voice": "vo_adv_5036003_069",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊～",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的～！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那隻盆栽混蛋，",
    "voice": "vo_adv_5036003_070",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "竟然讓我受到這種恥辱……！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n果然我還是用攻擊魔法把它燒個精光好了！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "妳、",
    "voice": "vo_adv_5036003_071",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "妳冷靜一點呀，凱留。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "對啊。",
    "voice": "vo_adv_5036003_072",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "剛才妳用貓屬性當賣點，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "也是真的很可愛唷？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "嗯嗯。",
    "voice": "vo_adv_5036003_073",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "雖然……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我是",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "犬派就是了。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而且，",
    "voice": "vo_adv_5036003_074",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果妳把「盆栽小花」整個燒掉，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n【new generations】的三個人，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n可能就會",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "回不去原本的世界了呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "嗯……",
    "voice": "vo_adv_5036003_075",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "唔……",
    "voice": "vo_adv_5036003_076",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……吶、",
    "voice": "vo_adv_5036003_077",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "卯月。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "未央。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n妳們真的",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "想要回到那邊去嗎？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "那個、",
    "voice": "vo_adv_5036003_078",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "那個……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我、",
    "voice": "vo_adv_5036003_079",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我也不知道……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n畢竟，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我們根本還沒有完全回想起來呀。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "……可是……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "……在那邊，",
    "voice": "vo_adv_5036003_080",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "好像……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "有著什麼",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "非做不可的事情……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……嗯。",
    "voice": "vo_adv_5036003_081",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n好像",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "正值什麼很重要的事情前夕……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n我也有這種感覺。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "好～！",
    "voice": "vo_adv_5036003_082",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n既然這樣的話……！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我們來找",
    "voice": "vo_adv_5036003_083",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "回去的辦法吧！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "說的也是。",
    "voice": "vo_adv_5036003_084",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n畢竟在對面的世界，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "說不定也有人在擔心我們嘛。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "嗯。",
    "voice": "vo_adv_5036003_085",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n而且也不是一定沒辦法再回到這邊來了嘛！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我也想要把忘掉的事情，",
    "voice": "vo_adv_5036003_086",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "好好地想起來呢！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "原本的我們",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "到底是什麼樣的人……！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "若各位，",
    "voice": "vo_adv_5036003_087",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是如此地希望的話……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼在下等人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也必定會助各位一臂之力。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真拿妳們沒辦法呢。",
    "voice": "vo_adv_5036003_088",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "既然這樣我也奉陪到最後吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可以吧？{0}。",
    "voice": "vo_adv_5036003_089",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "皮喵！",
    "voice": "vo_adv_5036003_090",
    "unit_id": 4411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "真的",
    "voice": "vo_adv_5036003_091",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "很謝謝大家！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "那就拜託你們了。",
    "voice": "vo_adv_5036003_092",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "既然都決定好了……",
    "voice": "vo_adv_5036003_093",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那接下來該怎麼辦呢？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "藉由凱留小姐所提供的情報，",
    "voice": "vo_adv_5036003_094",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n應盡之事，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "或多或少也明確了許多。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "簡單說就是要讓那個連接空間的洞，",
    "voice": "vo_adv_5036003_095",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n變大到能讓人穿過就好了對吧？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "為此，",
    "voice": "vo_adv_5036003_096",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "必須要提供「盆栽小花」能量才行……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "而「盆栽小花」的能量，",
    "voice": "vo_adv_5036003_097",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n則是得從人們觀賞偶像演唱會時，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n所散發出來的熱情中",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "獲得的對吧？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "雖然不知道是什麼原理……",
    "voice": "vo_adv_5036003_098",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "但是只要大家開心起來，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n就能獲得能量的這一點倒是挺討人喜歡的。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "可是，",
    "voice": "vo_adv_5036003_099",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "因為只靠我們",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n能帶動的人數不夠，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "所以它才會抓走新人偶像的對吧。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "要是就這樣不管那些被操縱的偶像們",
    "voice": "vo_adv_5036003_100",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也不好呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果有方法能",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "讓那些人也順利得救……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "有能夠",
    "voice": "vo_adv_5036003_101",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "兼顧兩者的方法就好了呢。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "比方說，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "像是讓更多、",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "更多的人們聽見我們的歌聲之類的……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "嗯……",
    "voice": "vo_adv_5036003_102",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "——咦咦咦！？",
    "voice": "vo_adv_5036003_103",
    "unit_id": null
  }
