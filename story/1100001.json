[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一個人走在街上，\\n看見正在討論事情的鈴奈。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "大家情緒很低落耶？",
    "voice": "vo_adv_1100001_000",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "明天是在海邊拍攝，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "大家興奮一點呀～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "有關那件事……",
    "voice": "vo_adv_1100001_001",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "因為平時配合的工作人員身體不適，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n現在負責攝影的人手不足。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦，",
    "voice": "vo_adv_1100001_002",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的嗎！？　",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真糟糕呢！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不好意思。",
    "voice": "vo_adv_1100001_003",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n是我們這邊出了狀況，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我們一定會想辦法的……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "請不要這麼說～！",
    "voice": "vo_adv_1100001_004",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "大家是好夥伴吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "一起來想辦法吧！",
    "voice": "vo_adv_1100001_005",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家也問問認識的人看可不可以",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊～～～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才！？　",
    "voice": "vo_adv_1100001_006",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的假的！？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n時間點也太巧了吧～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "話說，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "現在不是笑的時候――！！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "喂，",
    "voice": "vo_adv_1100001_007",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才明天有空嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n明天要去海邊拍攝，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "如果你能來幫忙，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那就太好了――",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "之類的。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的！？　",
    "voice": "vo_adv_1100001_008",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才超級體貼～♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "剛好有空所以來幫忙？",
    "voice": "vo_adv_1100001_009",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "謝謝秀才！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n能撥空來幫忙真的超級感謝！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，",
    "voice": "vo_adv_1100001_010",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "既然如此",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那今天也來陪我準備吧！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "走吧，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你說去哪裡，",
    "voice": "vo_adv_1100001_011",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "當然是去買泳衣～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "去海邊的話，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可愛的泳衣可是必備！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才",
    "voice": "vo_adv_1100001_012",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你看你看～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n好多可愛的泳衣呢～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "感覺辣妹風格的泳衣很適合人家，",
    "voice": "vo_adv_1100001_013",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但會不會太暴露呢？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "試穿那邊的可愛泳衣應該也很有趣♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈――",
    "voice": "vo_adv_1100001_014",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "糟糕！　",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "超級可愛的啦！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "喂喂喂，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才也這麼覺得嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？　",
    "voice": "vo_adv_1100001_015",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你說事務所不是早有準備好泳衣嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "當然有準備泳衣呀～",
    "voice": "vo_adv_1100001_016",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但是",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家也想帶自己挑選的泳衣去呀？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "想讓粉絲看到人家各種不同的一面，",
    "voice": "vo_adv_1100001_017",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "大概是這種想法？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "需要秀才的意見參考！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "話說，",
    "voice": "vo_adv_1100001_018",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才喜歡什麼款式的泳衣？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n可愛風格？　",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還是性感風格？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦，",
    "voice": "vo_adv_1100001_019",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你說不太清楚？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家穿給你看，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "感覺對了就告訴我吧～♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼，",
    "voice": "vo_adv_1100001_020",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我去換泳衣唷～♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "將將！",
    "voice": "vo_adv_1100001_021",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n這件泳衣，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "如何呢？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才？　",
    "voice": "vo_adv_1100001_022",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "怎麼了，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "整個人僵住。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "快說些話吧～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？　",
    "voice": "vo_adv_1100001_023",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為太可愛所以看傻了？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "被這麼直白稱讚，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家會害羞啦～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可愛嗎？",
    "voice": "vo_adv_1100001_024",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "糟糕！　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我現在超嗨的！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "既然秀才的反應也很好，",
    "voice": "vo_adv_1100001_025",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n一定要買下這件泳衣吧！　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我瞧瞧，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "價錢是……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦……",
    "voice": "vo_adv_1100001_026",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "8000盧幣！？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我以為頂多5000盧幣的說……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "超出預算啦……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……咦？　",
    "voice": "vo_adv_1100001_027",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "上面好像貼著貼紙。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "20%的折扣？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "欸～欸～秀才！　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
