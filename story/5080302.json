  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不，",
    "voice": "vo_adv_5080302_001",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那個蛋糕原本就是為了別人而做的……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真陽，",
    "voice": "vo_adv_5080302_002",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在此我們就仰賴宮子的力量吧！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "把這裡收拾好，",
    "voice": "vo_adv_5080302_003",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "等宮子冷靜下來再說明吧。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "她會聽我們說嗎……？",
    "voice": "vo_adv_5080302_004",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家要把你變成布丁喲──！！",
    "voice": "vo_adv_5080302_005",
