[
  {
    "type": "dialogue",
    "name": "華音",
    "words": "喔～",
    "voice": "vo_adv_5160301_000",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呵呵呵！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n在新的一年",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "開幕的同時，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "蘭德索爾的",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "新的",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "公主！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n公主華音大人",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "誕、",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "生、",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "了！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "喔～！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "來吧，",
    "voice": "vo_adv_5160301_001",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "地位卑微的各位♪",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n盡情向我低頭、",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "崇拜我、",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "讚頌我、",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "跪在我面前吧！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "就跪在",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "本小姐的",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "腳邊吧～～～！！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "真是的，",
    "voice": "vo_adv_5160301_002",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "說什麼公主啊！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "那傢伙",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "是連腦子都很新年快樂嗎？",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然俗話說",
    "voice": "vo_adv_5160301_003",
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "什麼跟煙都喜歡高處，",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "會這樣也是難免的吧。",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "應該說！",
    "voice": "vo_adv_5160301_004",
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "哪有公主穿得像她一樣不檢點！",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n給我知恥啊！",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "好氣──！",
    "voice": "vo_adv_5160301_005",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "一個個都是很失禮的小姑娘們！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "既然如此，我就讓妳們全部變成蛇的飼料，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "把她們一口吞掉吧！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n可不要違背本小姐的期待喔！？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然那個自認是公主的蝙蝠女",
    "voice": "vo_adv_5160301_006",
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "似乎決定要作壁上觀了……",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但是棘手的是那隻大蛇啊。",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是啊，",
    "voice": "vo_adv_5160301_007",
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不只是很巨大而已，",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "牠的力量也是規格外的呢。",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "明明是那樣，",
    "voice": "vo_adv_5160301_008",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "卻被那種人隨意使喚，真可憐啊……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "在打倒華音之後，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我就順便解放牠吧！",
    "voice": null,
    "unit_id": 133611
  }
]
