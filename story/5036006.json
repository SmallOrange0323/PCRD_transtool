    "words": "骨折り損のくたびれ儲けってヤツだよな？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "だね……",
    "voice": "vo_adv_5027006_078",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "【王宮騎士団（NIGHTMARE）】には色々バレちゃったし",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n開拓の仕事も予定通りには進んでないから、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "報酬ゼロどころか、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n完全に赤字だよ～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "みんなしばらくは、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "お給料なしです☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "カヤ・イノリ",
    "words": "ど……",
    "voice": "vo_adv_5027006_079",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "カヤ・イノリ",
    "words": "どちくしょ～！！\\nど……どちくしょ～です～！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "密林に、二人の少女の慟哭がこだまする。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nこうして、エルピス島を巡る【ドラゴンズネスト】の探索は\\nいったんの幕を閉じるのであった。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "これは……",
    "voice": "vo_adv_5027006_080",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "正義が勝った、",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ってことッスかね？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
