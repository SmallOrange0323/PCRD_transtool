    "type": "dialogue",
    "name": "珠希",
    "words": "……感覺",
    "voice": "vo_adv_4010252_018",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "收到了兩份禮物喵。",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "對了喵！",
    "voice": "vo_adv_4010252_019",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我馬上來試試坐墊坐起來的感覺喵！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "來吧，",
    "voice": "vo_adv_4010252_020",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}也一起坐喵！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n不靠近一點的話，",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "會坐不下的喵。",
    "voice": null,
    "unit_id": 104632
  },
