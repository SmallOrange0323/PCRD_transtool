    "name": "珠希",
    "words": "而且",
    "voice": "vo_adv_4010252_015",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這是……！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n坊間流傳的",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "「貓咪一躺就廢坐墊」喵！？",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "據說軟綿綿的，",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就算買給自己用，",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "也會被貓咪搶走，根本坐不到……！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊……",
    "voice": "vo_adv_4010252_016",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "太感謝了喵～～～～～～～！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n雖然收到坐墊也很開心，",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n但你為了我工作這點，",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "讓我超級開心喵！",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "因為……",
    "voice": "vo_adv_4010252_017",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我在旁邊一直看著喵。",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n你沒有偷懶，",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "一直很努力地",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n和我一起經營鯛魚燒店喵……",
    "voice": null,
    "unit_id": 104632
  },
