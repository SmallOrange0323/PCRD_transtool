  {
    "type": "dialogue",
    "name": "珠希",
    "words": "今天也辛苦你來鯛魚燒店幫忙喵～",
    "voice": "vo_adv_4010252_011",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n只要有{0}在，",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n對接客和開發新口味鯛魚燒都有所幫助喵。",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過，",
    "voice": "vo_adv_4010252_012",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你最近經常來幫忙，",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n是有什麼想要的東西喵？",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "是這樣喵？",
    "voice": "vo_adv_4010252_013",
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "有買到想要的東西真是太好了喵。",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n一口氣把工作賺來的錢",
    "voice": null,
    "unit_id": 104632
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "花完的瞬間",
