[
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "『お見合いしましょう』なんて言われても、",
    "voice": "vo_adv_6054202_000",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "興味ないのよね。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\nそもそも、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "考える余裕だってないし……",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "……あたしの幸せも考えるべきだって？",
    "voice": "vo_adv_6054202_001",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "そんな真剣な顔で言われると",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "調子狂うというか、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "でも、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "あんたの気持ち、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "とってもうれしいわ。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "あたし、",
    "voice": "vo_adv_6054202_002",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "実業家としてはまだ新米なのよ？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\nそれに救護院のこともあるし……",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "え？　",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "手伝う？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "ふふ、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "それじゃ今度、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "買い物するのを手伝ってね！",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "そうよね。",
    "voice": "vo_adv_6054202_003",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "あたしたちにはまだ早いわよね。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n真剣に相手を探しに来ている人たちの邪魔はしたくないし……",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "今日は久しぶりに、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "あんたとゆっくりお話しようかな。",
    "voice": null,
    "unit_id": 114511
  }
]
