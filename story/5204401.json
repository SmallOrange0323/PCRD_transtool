  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "小荷姆倒下！",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n是彩羽贏了喔！",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "好，",
    "voice": "vo_adv_5204401_001",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "露易，就是現在。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n趁現在",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "復原瑪莉絲黛菈吧。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "交給我吧，苑！",
    "voice": "vo_adv_5204401_002",
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n……",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "來吧，祖母，",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "老實地──",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "荷姆荷姆",
    "words": "好戲現在才要開始～～～！！",
    "voice": "vo_adv_5204401_003",
    "unit_id": 19311
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "……！！",
    "voice": "vo_adv_5204401_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "啊──",
    "voice": "vo_adv_5204401_005",
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "小荷姆！",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n把奶奶扛在肩上逃走了！？",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不……",
    "voice": "vo_adv_5204401_006",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "感覺不是那樣。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n她是在引誘我們到開闊、",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "沒有障礙物、便於戰鬥的地方啊。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "怎麼辦？",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "露易。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "追上去吧……！",
    "voice": "vo_adv_5204401_007",
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n能阻止祖母的",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "就只有我們了！",
    "voice": null,
    "unit_id": 132311
  }
]
