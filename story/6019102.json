  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "美咲這個人，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "難得可以來渡假，",
