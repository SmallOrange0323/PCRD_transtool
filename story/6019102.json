  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "竟然說那麼壞心眼的話，是想怎樣嘛～？　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "太過分了啦～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就算你要我冷靜，",
    "voice": "vo_adv_6019102_001",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "也沒辦法那麼輕易的就冷靜下來啊～？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "生氣就不可愛了？　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的嗎？　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "明天就是活動了，糟糕了～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我已經不氣了！　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "完全沒在生氣了～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不會吧吧吧吧！　",
    "voice": "vo_adv_6019102_002",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才也氣呼呼嗎～？",
