[
  {
    "type": "background",
    "bg_id": "502460"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "蘭德索爾國際博覽會閉幕後又過了段時間……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在吉歐‧尼布爾黑爾的巨鯨城，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n薇歐莉特主辦的晚宴即將開始。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎士先生，",
    "voice": "vo_adv_1380002_000",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "今天謝謝",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "您來幫忙。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "就麻煩您",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "擔任我的護衛，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n同時協助晚宴進行了。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "謝謝您的",
    "voice": "vo_adv_1380002_001",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "這份心意。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n格蕾斯的話，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我今天也交代她絕對要安靜休養。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "畢竟不能再讓她",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "繼續逞強了。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "background",
    "bg_id": "502480"
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……聽好了，",
    "voice": "vo_adv_1380002_002",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "騎士氏。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n在這次的晚宴",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "，要請你代替我，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n全力支援公主。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "睜大眼注意周遭，",
    "voice": "vo_adv_1380002_003",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "哪怕是多細微的事都不能放過。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n隨時跟公主一同行動，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "守在半徑一公尺的距離內，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n必要時，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "則以身相護。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "沒錯，",
    "voice": "vo_adv_1380002_004",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "若要打個比方，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "就像是支持妻子工作的主夫那樣盡心盡力──",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我、",
    "voice": "vo_adv_1380002_005",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我說……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "格蕾斯！",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n別向騎士先生",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "灌輸一些奇怪的事……！",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "開玩笑的，",
    "voice": "vo_adv_1380002_006",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "大概有一半是。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……總之，騎士氏，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我的份也麻煩你了。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "如果公主出了什麼事，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我會化成怨靈找你算帳的。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "background",
    "bg_id": "502460"
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "既跟黎薩的事之後，",
    "voice": "vo_adv_1380002_007",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "前幾天的國際博覽會也是……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n都是因為我不爭氣，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "才讓格蕾斯",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "又勉強自己。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "如今",
    "voice": "vo_adv_1380002_008",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我掌握了黃泉鯨命的力量，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "所以希望",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "她能稍微休息一下。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "雖然",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "會麻煩到騎士先生……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎士先生……",
    "voice": "vo_adv_1380002_009",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "還是跟平時",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "一樣溫柔……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……唔……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "別、",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "別誤會了，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "薇歐莉特。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n騎士先生是英雄，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "對所有人",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "都同樣溫柔……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……啊，",
    "voice": "vo_adv_1380002_010",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "非",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "常抱歉。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n我還沒說明今天晚宴的事吧。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "這次儘可能地",
    "voice": "vo_adv_1380002_011",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "多邀請了一些來賓。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n我們吉歐‧尼布爾黑爾",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "各地都零星散布著小村莊，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n也很少",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "有機會",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "可以問候所有人民──",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "──不對。",
    "voice": "vo_adv_1380002_012",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "剛剛那是……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "藉口",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "吧。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "從過去直到最近為止……",
    "voice": "vo_adv_1380002_013",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我都沒有身為公主的自覺，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n對「黃泉的餐桌」的貴族們言聽計從，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n無法",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "在大家面前抬頭挺胸……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "但是，",
    "voice": "vo_adv_1380002_014",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我學會控制「怠惰」，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "並且",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "透過這次的國際博覽會，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "讓我得以",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "面對自身國家的驕傲。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "現在的我一定可以……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "所以。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我想",
    "voice": "vo_adv_1380002_015",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "邀請各地的代表，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n希望能夠多少",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "與大家建立起信賴關係……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "因此，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "才舉辦了這場晚宴。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "謝謝您，",
    "voice": "vo_adv_1380002_016",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "那麼，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我們先逐桌",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "跟來賓打招呼吧──",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "服務生？",
    "words": "……呵呵。",
    "voice": "vo_adv_1380002_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "服務生？",
    "words": "……護衛只有那個瘦巴巴的小子嗎。",
    "voice": "vo_adv_1380002_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "服務生？",
    "words": "\\n守護騎士格蕾斯不在，真是幸運。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "服務生？",
    "words": "\\n……雖然沒有私人恩怨，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "服務生？",
    "words": "但這畢竟是委託。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "去死吧，",
    "voice": "vo_adv_1380002_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "公主……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "殭屍來賓",
    "words": "什麼，",
    "voice": "vo_adv_1380002_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "殭屍來賓",
    "words": "這是冥海鯙魚嗎……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "殭屍來賓",
    "words": "\\n我聽說因為牠有股獨特的腥味，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "殭屍來賓",
    "words": "所以難以下嚥啊……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "呵呵，",
    "voice": "vo_adv_1380002_021",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "這都是多虧了",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "來自吉歐‧提格尼亞的香草。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n討厭的腥味完全消失了吧？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "風味和口感",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "都十分出色，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "請務必品嚐看看。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "啊啊，",
    "voice": "vo_adv_1380002_022",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "那是",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "使用吉歐‧格黑納魔物製作的炸肉排。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n以往的主流吃法",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "似乎都是淋上醬汁享用，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "但目前正流行吉歐‧尼布爾黑爾產的岩鹽……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "小孩子殭屍來賓",
    "words": "哇啊，",
    "voice": "vo_adv_1380002_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小孩子殭屍來賓",
    "words": "真是好吃♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小孩子殭屍來賓",
    "words": "\\n欸欸，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小孩子殭屍來賓",
    "words": "公主殿下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小孩子殭屍來賓",
    "words": "這邊的料理是什麼～？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我看看，",
    "voice": "vo_adv_1380002_024",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "這邊的是──",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "──那麼，",
    "voice": "vo_adv_1380002_025",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "請各位繼續享用餐點。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "最後一道",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "是我親自烹調的料理，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我國傳說中的……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……唔。",
    "voice": "vo_adv_1380002_026",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "啊啊，",
    "voice": "vo_adv_1380002_027",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎士先生……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "很抱歉。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n……我",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "似乎有些累了……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……明明還有尚未問候的客人，",
    "voice": "vo_adv_1380002_028",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "真是丟臉……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "即便如此，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "因為騎士先生一直看著我……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n讓我感覺",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "能比平常更加努力。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……這是騎士先生的體貼。",
    "voice": "vo_adv_1380002_029",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n為了不讓來賓們看見，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "悄悄地用手環住我的腰，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n慢慢地",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "引導我走向後方……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "然後，",
    "voice": "vo_adv_1380002_030",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "將水杯",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "溫柔地",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "放到我嘴邊……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎士先生他……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "是多麼地紳士。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n這個模樣，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "簡直就像是王子殿下──",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……王子殿下。",
    "voice": "vo_adv_1380002_031",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n換句話說，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "那",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "就是公主的伴侶……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "對吧。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "background",
    "bg_id": "502480"
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "就像是支持妻子工作的主夫那樣盡心盡力──",
    "voice": "vo_adv_1380002_032",
    "unit_id": 133012
  },
  {
    "type": "background",
    "bg_id": "502460"
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……王子……",
    "voice": "vo_adv_1380002_033",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "丈夫……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "唔……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "啊！",
    "voice": "vo_adv_1380002_034",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "沒……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "沒什麼。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "已經沒事了，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "好了，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我們回去吧……！",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "──各位，",
    "voice": "vo_adv_1380002_035",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "今天真的非常感謝。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n最後要請各位品嚐的，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "是使用吉歐‧尼布爾黑爾傳說中的食材，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "至高蝦",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "的極品料理──",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "……嘖，",
    "voice": "vo_adv_1380002_036",
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "沒想到我竟然完全無法出手……",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "\\n",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "那個陪同的斯文男人，",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "\\n武力姑且不論，",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "專注力強，是個認真的傢伙……！",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "……不過，",
    "voice": "vo_adv_1380002_037",
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "我可是一流的殺手。",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "\\n薇歐莉特公主，",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "我已經調查過，妳最後會向眾人問候。",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "\\n沒錯……",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "就站在那座吊燈下……！",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "呵呵……",
    "voice": "vo_adv_1380002_038",
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "只要用這個裝置，就能啟動機關，",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "\\n讓那盞吊燈",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "直直地朝著公主落下──",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……公主是不死生物，",
    "voice": "vo_adv_1380002_039",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n就算頭部被砸爛",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "也不會死喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "哼，",
    "voice": "vo_adv_1380002_040",
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "沒有問題。",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "\\n",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "我已經把吊燈的其中一個裝飾，",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
    "words": "\\n換成從蘭德索爾引進的「寶玉」。",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "殺手",
