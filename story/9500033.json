[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生……",
    "voice": "vo_adv_9500033_000",
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n人家，",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "一直",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "在等待這一刻。",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "雖然人家在心裡",
    "voice": "vo_adv_9500033_001",
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "默念過無數次，",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這就是命運……",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但當這一刻真的到來時，",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "內心深處果然……",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還是會",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "揪得緊緊的呢……♪",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "騎士之誓……",
    "voice": "vo_adv_9500033_002",
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n之前，",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生也對人家發過誓。",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那個時候，",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "都還在夢中……",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不過，",
    "voice": "vo_adv_9500033_003",
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這次……",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是真的呢。",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不再是夢，",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "而是真的",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "在人家面前發誓……",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "至今為止，",
    "voice": "vo_adv_9500033_004",
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "一直都在公主身邊",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "守護她。",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "你的奉獻、",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "你的勇氣，",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還有你的愛……",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n這一次，",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "輪到人家來回應了。",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生──",
    "voice": "vo_adv_9500033_005",
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家好愛你。",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n人家",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "比世界上的任何人",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "都還要愛",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "此時此刻站在這裡的王子先生。",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "公主的心",
    "voice": "vo_adv_9500033_006",
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "永遠",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "與王子同在。",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "無論是戰鬥的時候，",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還是和平的時候。",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "無論",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "何時──",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家的──",
    "voice": "vo_adv_9500033_007",
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "公主的心，",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "都會",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "在你身邊。",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵，",
    "voice": "vo_adv_9500033_008",
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "今後不管發生什麼事，",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們都要在一起喔。",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n無論遇到什麼情況，",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們都要攜手克服困難。",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們走吧，",
    "voice": "vo_adv_9500033_009",
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生。",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n去守護",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們的……",
    "voice": null,
    "unit_id": 101041
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "大家的未來。",
    "voice": null,
    "unit_id": 101041
  }
]
