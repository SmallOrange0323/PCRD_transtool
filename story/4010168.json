  {
    "type": "dialogue",
    "name": "步未",
    "words": "{0}前輩，",
    "voice": "vo_adv_4010168_000",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "你、",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "你好！",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "今天",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "為了慶祝我的生日，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n前輩幫我規劃了這個外出企劃……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "呃，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗚嗚……",
    "voice": "vo_adv_4010168_001",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "超級緊張的……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "明明只是跟{0}前輩去吃飯而已……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但是",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "一想到",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是兩人單獨外出，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "果然還是……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗯、",
    "voice": "vo_adv_4010168_002",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗯……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "{0}前輩。",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "呼……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "你邀請我一起出來，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我非常的高興！",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雖然至今為止",
    "voice": "vo_adv_4010168_003",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "家人或是朋友也有幫我慶生過。",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但像這樣度過生日，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "還是第一次……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那、",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那就請多多包涵了。",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……咦、",
    "voice": "vo_adv_4010168_004",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "剛剛的說法，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "會不會",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "讓人覺得，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n{0}前輩對我來說",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是比朋友",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "還重要的人……？　",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好、",
    "voice": "vo_adv_4010168_005",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好的！",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n請多多指教，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "{0}前輩！",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不對，",
    "voice": "vo_adv_4010168_006",
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那才不是「誤會」呢……",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "所以",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我就坦率地享受吧。",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n享受和{0}前輩度過的，",
    "voice": null,
    "unit_id": 105531
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "珍貴的時間……",
    "voice": null,
    "unit_id": 105531
  }
]
