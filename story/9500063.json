[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……曾經許下「想讓大家都",
    "voice": "vo_adv_9500063_000",
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "成為公主」這個願望的",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "溫柔的你。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n但是就連這樣的你，",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n總有一天也會迎來必須選擇某一個人的時刻……",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……",
    "voice": "vo_adv_9500063_001",
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你已經不記得",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這段對話了吧？",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "畢竟是夢裡的事嘛。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過，這樣啊，",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這就是你的選擇。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n你說，你想讓我成為",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "心目中",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "第一的公主。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯～",
    "voice": "vo_adv_9500063_002",
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過，",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這樣是不是很奇怪～？",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n你本來",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就是會想和我建立連結的人嗎～？",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我",
    "voice": "vo_adv_9500063_003",
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是個只想做快樂的事的人喔？",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n只是在這個扭曲的遊戲世界裡，",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "賭上性命享樂的人而已。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n照你的觀念，",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "應該是無法理解我的人才對。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "所以我……",
    "voice": "vo_adv_9500063_004",
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "沒有嘗試過那樣的",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "模擬喔。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n因為我覺得",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那是不可能的。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n即使試遍了其他所有人……",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "唯獨我這條路線，",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我沒有嘗試過。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "哦，",
    "voice": "vo_adv_9500063_005",
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n為什麼你會那樣想呢？",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……！",
    "voice": "vo_adv_9500063_006",
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……",
    "voice": "vo_adv_9500063_007",
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵……",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n那",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就當作是這樣吧。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你想想，我這個人",
    "voice": "vo_adv_9500063_008",
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "有點狡猾啊。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我現在",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "可是做了一場夢呢。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n那我也",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "沒有理由把這場夢讓給其他女孩子啊。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "欸，{0}，",
    "voice": "vo_adv_9500063_009",
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我啊，",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "已經決定好，",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "等這場戰鬥結束之後──要開始畫漫畫。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "當然，",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我的助手就是{0}喔。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是以我最喜歡的阿斯特朗為舞台，",
    "voice": "vo_adv_9500063_010",
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "並非攻略的",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "另一個故事。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "它表面上雖然是冒險漫畫，",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但其實",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是一部少女漫畫。",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "總是希望能幫助誰的少年，以及",
    "voice": "vo_adv_9500063_011",
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n在偷偷幫助著",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那樣的他的同時，",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n不知不覺間掉入戀愛陷阱的",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "純情少女的故事……",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "說笑",
    "voice": null,
    "unit_id": 106741
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "的♪",
    "voice": null,
    "unit_id": 106741
  }
]
