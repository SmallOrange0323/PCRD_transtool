  {
    "type": "dialogue",
    "name": "旁白",
    "words": "似似花們的戰鬥",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "猶如魔法與魔法相互碰撞的光之洪水。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n最終，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就在{0}的眼睛開始適應交錯的閃光之際……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "為什麼",
    "voice": "vo_adv_1338004_000",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "打不中。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "\\n像那個胡鬧的克莉絲提娜一樣只顧著閃躲……！",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "對於遲遲無法分出勝負，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "分身們開始感到心急。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而似似花",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "沒有放過這個破綻。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是時候了呢。",
    "voice": "vo_adv_1338004_001",
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "很好的判斷。",
    "voice": "vo_adv_1338004_002",
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n來……",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "輪到你出場了喔，",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "格列戈爾。",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "格列戈爾",
    "words": "…………",
    "voice": null,
    "unit_id": 133814
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "什麼，",
    "voice": "vo_adv_1338004_003",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "是什麼時候……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "提爾納諾。",
    "voice": "vo_adv_1338004_004",
    "unit_id": 133813
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "被一連串光線貫穿的一名分身，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "化為光的粒子消失了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "怎麼",
    "voice": "vo_adv_1338004_005",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "可能……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "光是一擊就有如此威力……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "\\n妳那是什麼表情！",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "是打算變成令人厭惡的真那嗎？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "但",
    "voice": "vo_adv_1338004_006",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "如果是那種過強的火力……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "\\n是無法輕易控制的吧！",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "似似花的分身像是要把{0}當作盾牌一般，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n直直朝著這裡過來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "嗯，",
    "voice": "vo_adv_1338004_007",
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "確實是過剩的火力呢。",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "正因如此……",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "喝！",
    "voice": "vo_adv_1338004_008",
    "unit_id": 191011
  },
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "嘎哈！",
    "voice": "vo_adv_1338004_009",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "\\n什麼，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花的分身",
    "words": "真軌……？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "作為平時使用的暴力，",
    "voice": "vo_adv_1338004_010",
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這個才更適合喔。",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這就是所謂的適應，",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n明白嗎？",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "似似花大人的公主騎士，",
    "voice": "vo_adv_1338004_011",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "真軌！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n現已到來！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n那副模樣就代表",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "果然這邊的才是分身吧？",
