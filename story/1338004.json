    "type": "dialogue",
    "name": "？？？",
    "words": "我進入了據說是她正在開發中的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\nVR遊戲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "說真的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我對於那並非是現實的這一事實感到驚訝。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n然而，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在那個地方所發生的現象，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "盡是在現實中不可能發生的事。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "過於真實的世界……",
    "voice": "vo_adv_1338004_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "創造被稱作阿斯特朗的那個VR空間的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n似乎是超級AI。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "應該可以說，正是這種處理能力",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "與運算力，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n充分彰顯出",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "他們這些創造出該AI的七冠的才能吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "而且最重要的是……",
    "voice": "vo_adv_1338004_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在那個世界中的她，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "簡直是等同神的存在。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n一下以妖精的模樣",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "進行壓倒性的破壞，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "一下又創造出有著人工智慧的人物們",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n那副模樣",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "深深吸引了我的目光。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「世界應由有能力的人管理」",
    "voice": "vo_adv_1338004_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "雖然我過去一直認為",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n這番話是不可能實現的妄想，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "但若有這個AI，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "或許就有可能。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n不，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "如果是她的話，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "一定會實現的吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "既然如此，",
    "voice": "vo_adv_1338004_032",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我也想要看看。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n正因為是她所實現的世界，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "才存在我所追求的正義。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我想要在那裡",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "實現自己的正義。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我",
    "voice": "vo_adv_1338004_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在阿斯特朗這個地方",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "宣誓將作為騎士效忠。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n作為公主騎士，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "狂真咲真軌",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n向變貌大妃",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "現士實似似花大人宣誓……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……上面是這樣寫的。",
    "voice": "vo_adv_1338004_034",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "唉……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "量還真是相當多呢～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊啊，",
    "voice": "vo_adv_1338004_035",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這個？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是叫K報告，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是政府的機密文件。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "至於是誰寫的……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就先保密吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "咦，",
    "voice": "vo_adv_1338004_036",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "感覺很可疑……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你說",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n嗯──",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "算是吧～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n雖然以內容上來看非常有可能……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "儘管如此，該說是做得",
    "voice": "vo_adv_1338004_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "太完美了嗎……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "還有，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你認為",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那個人會漏掉關於自己的情報",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n被以這種方式留下來嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "算了，",
    "voice": "vo_adv_1338004_038",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "原本的資料似乎早已經消失了就是，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就只是單純漏掉了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "還是有什麼意圖才留下訊息的呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "唉，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "光想可能也沒用吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話說回來，",
    "voice": "vo_adv_1338004_039",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你還真是被相當麻煩的對象給盯上了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我能說的……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就只有",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "請堅強地活下去吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "哎呀，",
    "voice": "vo_adv_1338004_040",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "時間差不多了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那麼就",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "加油吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n掰掰──",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}醒來後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "眼前是被寂靜所包圍的古城，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n先前在那裡的光之洪水簡直就像是一場夢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在更高處的地方，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "似似花正將飄浮的光之粒子聚集於手中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "哎呀，",
    "voice": "vo_adv_1338004_041",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你終於醒了啊。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n會因為那點衝擊波就失去意識，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n看來鍛鍊似乎還不夠呢。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "好了，",
    "voice": "vo_adv_1338004_042",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這下子分身們已經回收完畢了。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n作戰結束。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你們兩位",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "都做得很好。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "是，",
    "voice": "vo_adv_1338004_043",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "感謝您的誇獎！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "尤其是{0}。",
    "voice": "vo_adv_1338004_044",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n作為誘餌，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你非常努力了呢。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是啊。",
    "voice": "vo_adv_1338004_045",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n雖然我打從一開始就不可能會輸，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但只有我們的話，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "分身們也會警戒，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n並躲起來不現身吧。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "而且，",
    "voice": "vo_adv_1338004_046",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "如果是我的分身，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n就絕對不會傷害你。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n因為我有創造那樣的記憶。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "分身",
    "voice": "vo_adv_1338004_047",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "打從一開始就全部都在我的掌握中。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "對了……",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "陷入像這次一樣的情況時，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你覺得最危險的事是什麼？",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是我的力量",
    "voice": "vo_adv_1338004_048",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "落入其他七冠的手中。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "所以，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我在分身身上",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "所留下關於七冠的記憶，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n也是特別讓人火大的內容。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "當然，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我並沒有捏造就是了。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "好了，",
    "voice": "vo_adv_1338004_049",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那我們走吧，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n朝這座城堡的深處。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我有說過了吧，",
    "voice": "vo_adv_1338004_050",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n這個地方擁有情報。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "畢竟這裡",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "曾經是我的根據地。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "似乎是",
    "voice": "vo_adv_1338004_051",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "因為再構築而流轉到這樣的地方來了呢。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "如果是最深處，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "損傷應該也很少吧。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "分身們可能",
    "voice": "vo_adv_1338004_052",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "正是因為這樣才把這座城堡當成住處。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "明明我沒有賦予她們這個地方的詳細記憶才對……",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "還真是不可思議呢。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "呼……",
    "voice": "vo_adv_1338004_053",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n再一次",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "辛苦你們了呢。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n格列戈爾也是。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "格列戈爾",
    "words": "…………",
    "voice": null,
    "unit_id": 133814
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "哎呀，",
    "voice": "vo_adv_1338004_054",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你說，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "能久違地大鬧一場很開心。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "偶爾創造這樣的機會也不錯呢。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "話雖如此……",
    "voice": "vo_adv_1338004_055",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "又要製作分身的時候，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n那種運用",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也會增加你的負擔就是了。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "呵呵，",
    "voice": "vo_adv_1338004_056",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是讓你辛苦了呢。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n一直以來謝謝你了。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n不愧是我最棒的搭檔……",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "哎呀，",
    "voice": "vo_adv_1338004_057",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n露出那種表情。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你該不會是",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "羨慕了吧？",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "絕對沒有",
    "voice": "vo_adv_1338004_058",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "那回事！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "算了，也罷。",
    "voice": "vo_adv_1338004_059",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n{0}，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你意下如何？",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n要直接成為我的部下嗎？",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "世界應由有能力的人管理。",
    "voice": "vo_adv_1338004_060",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n沒錯，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就是由像我這樣",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "優秀的存在。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "如果有你在，",
    "voice": "vo_adv_1338004_061",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我就能比過去還要更有效率地行使我的力量，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n可以毫無遺漏地",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "管理這個世界吧。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我來管理世界，",
    "voice": "vo_adv_1338004_062",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你來進行支援的話……",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n就結果來說，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不覺得你想幫助的人們",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n能夠得到幫助的機會也會變高嗎？",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我很清楚你也有理想，",
    "voice": "vo_adv_1338004_063",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n如果是我，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就能夠幫助你。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我們的利害也一致，",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我認為你沒有理由拒絕。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "原來如此，",
    "voice": "vo_adv_1338004_064",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "不愧是似似花大人。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "我主人也都這樣說了，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n你何不就試試看。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "雖然我絕對沒有認為自己無能……",
    "voice": "vo_adv_1338004_065",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "但很遺憾，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "我所能做的，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "就只有代替似似花大人",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n處理一些",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "能夠輕易解決的小事而已。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "嗯，",
    "voice": "vo_adv_1338004_066",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "確實是呢。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "可是，",
    "voice": "vo_adv_1338004_067",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "你的公主騎士權能",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n能夠強化似似花大人的力量本身！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "如果是你！",
    "voice": "vo_adv_1338004_068",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "就能成為我主人霸業的真正助力。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n沒有比這更加高尚的榮譽了吧！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "我們兩個公主騎士齊心合作，",
    "voice": "vo_adv_1338004_069",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n成為",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "支持我們的主人，似似花大人的力量吧！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真軌。",
    "voice": "vo_adv_1338004_070",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你給人的壓迫感太強了。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "哎呀，",
    "voice": "vo_adv_1338004_071",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "我忍不住興奮過頭了。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n非常抱歉。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "先到此為止吧。",
    "voice": "vo_adv_1338004_072",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n他應該也很累了呢。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "呵呵，",
    "voice": "vo_adv_1338004_073",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這件事並沒有那麼急喔。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n因為現在還不是該行動的時候。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "哎呀……",
    "voice": "vo_adv_1338004_074",
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 133812
  },
  {
    "type": "dialogue",
    "name": "似似花",
