[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "話說回來，",
    "voice": "vo_adv_7003004_000",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "鈴奈和{0}\\n你們兩個是怎麼相識的？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我和秀才呢，",
    "voice": "vo_adv_7003004_001",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是在點心舖相識的～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才真的是厲害地不得了呢！",
    "voice": "vo_adv_7003004_002",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n還能精通折扣百分比的計算，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "當時的秀才真的是不折不扣的秀才啊～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那，",
    "voice": "vo_adv_7003004_003",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "望望你呢？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我",
    "voice": "vo_adv_7003004_004",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是因為遇上粉絲追逐多虧他才獲救。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過{0}，",
    "voice": "vo_adv_7003004_005",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n他居然不知道我是偶像……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那時候，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "還真有趣。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "蛤啊！？",
    "voice": "vo_adv_7003004_006",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "　",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那還真是不行啊～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "居然不認識望望，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真不敢相信。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊哈哈。",
    "voice": "vo_adv_7003004_007",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是就因為這個契機，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我就意識到自己還努力得不夠……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n相識之後，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我對他滿懷感激之情。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "而且",
    "voice": "vo_adv_7003004_008",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "和{0}在一起，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n感覺能做回原來的自己……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我懂我懂～！",
    "voice": "vo_adv_7003004_009",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "　",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我只要",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "和秀才在一起",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n感覺時間好像一下子就過去了呢。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "到底是為什麼呢？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": "vo_adv_7003004_010",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "鈴奈也是一樣的嗎！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也是這麼覺得！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n果然還是在一起的時間最快樂了吧？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "欸，",
    "voice": "vo_adv_7003004_011",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是不是說了什麼不得了的話……！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家也覺得是這樣！",
    "voice": "vo_adv_7003004_012",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "果然我和望望，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的超合拍的！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "鈴、",
    "voice": "vo_adv_7003004_013",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "鈴奈，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "別說了啦～！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "也就是說秀才",
    "voice": "vo_adv_7003004_014",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n不管是對我或望望而言都是最重要的――",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊…………",
    "voice": "vo_adv_7003004_015",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "…………",
    "voice": "vo_adv_7003004_016",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "最、",
    "voice": "vo_adv_7003004_017",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "最重要的……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "什麼呢？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "　",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊啊、",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "笑死了～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "到底，",
    "voice": "vo_adv_7003004_018",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是什麼呢……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哈哈、",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊哈哈～",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "兩人的乾笑聲，在塔中回蕩著。",
    "voice": null,
    "unit_id": null
  }
]
