  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與阿爾莎特對戰後的數日後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "哇……♪",
    "voice": "vo_adv_5220007_000",
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n這一帶也完全恢復原狀了呢！",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "不愧是騎士先生♪",
    "voice": "vo_adv_5220007_001",
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "吉歐‧提格尼亞也變得相當漂亮了喔！",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n多虧有沃爾加諾一行人也來幫忙！",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "……啊，對了！",
    "voice": "vo_adv_5220007_002",
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我們，",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "原本是在找潛水的地點對吧！",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "潛水的地點嘛……",
    "voice": "vo_adv_5220007_003",
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "這一帶的水位比較淺，",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "感覺不錯對吧？",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "那麼，騎士先生！",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "好♪",
    "voice": "vo_adv_5220007_004",
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "呃，",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我記得萊拉耶爾殿下教過的魔法是……",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n像這樣，",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "再這樣",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "……",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "看我的！",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "……完成了！",
    "voice": "vo_adv_5220007_005",
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "只要戴上這個像泡泡一樣的東西，",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "就能在水裡呼吸了喔？",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "太好了！",
    "voice": "vo_adv_5220007_006",
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "那我們立刻一起……",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "……？",
    "voice": "vo_adv_5220007_007",
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n怎麼了嗎？",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "…………",
    "voice": "vo_adv_5220007_008",
    "unit_id": 140612
  },
  {
    "type": "background",
    "bg_id": "502350"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "讓克蘿小姐……",
    "voice": "vo_adv_5220007_009",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "成為背面世界的管理者……？",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "那個……？",
    "voice": "vo_adv_5220007_010",
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "真的做得到那種事嗎？",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "沒錯，",
    "voice": "vo_adv_5220007_011",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳做得到的。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "並非是原本就能做到，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n而是因為",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳遇見了那邊的他，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "才能做到的吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "人工智慧本應沒有感情。",
    "voice": "vo_adv_5220007_012",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "即便看似擁有感情，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "終究也只是模仿人類罷了。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n一切不過是",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "龐大的演算學習後得出的結果。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "但是，",
    "voice": "vo_adv_5220007_013",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳這個純真無瑕的存在，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n遇見了那個少年，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "締結了羈絆、",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "了解了世界，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳終究……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "在不知不覺中",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "學會了感情並獲得成長。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "喜悅、",
    "voice": "vo_adv_5220007_014",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "憤怒、",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "悲傷、",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "快樂……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "還有願望。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n這一切的感情，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "都是構成名為「阿斯特朗」這個世界的重要資源。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "既然妳已經知曉",
    "voice": "vo_adv_5220007_015",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "並汲取了這些，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "將其化為己有，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n那麼妳一人",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "便足以處理這龐大且",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "正負摻雜的能量。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "然後……",
    "voice": "vo_adv_5220007_016",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "利用幻境龍后留下的這顆蛋作為資源，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n與系統合而為一的話。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "應該連成為世界的管理者都能做到。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不過和米奈娃相比，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳大概就只是個實習管理者吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那顆蛋……！",
    "voice": "vo_adv_5220007_017",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n為什麼連那個都……",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你們在誤會些什麼呢？",
    "voice": "vo_adv_5220007_018",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我只不過是",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "回收了那個山羊女攝取過的東西。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "為了不讓它",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "又被哪個愚蠢的傢伙撿走罷了。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我沒有打算拿來做什麼，",
    "voice": "vo_adv_5220007_019",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "放心吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這種東西，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "對我來說是不需要的。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "但是，",
    "voice": "vo_adv_5220007_020",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳不一樣。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n對於宣稱想守護世界的妳來說，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這東西是必要的。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "沒錯吧？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "…………",
    "voice": "vo_adv_5220007_021",
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我──",
    "voice": null,
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "──請等一下。",
    "voice": "vo_adv_5220007_022",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "萊拉耶爾殿下？",
    "voice": "vo_adv_5220007_023",
    "unit_id": 140612
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這還是第一次與妳對話呢，",
    "voice": "vo_adv_5220007_024",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "提格尼亞地區的公主。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我才是，",
    "voice": "vo_adv_5220007_025",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "能與妳對話是我的榮幸。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "七冠的",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
