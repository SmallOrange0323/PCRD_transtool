  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "哦哦……",
    "voice": "vo_adv_7007001_000",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "果然如同傳聞，裡面有魔物吧。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "奧恩斯坦大臣真的不要緊嗎？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "妳還只是個小孩子，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "害怕的話就和吉格魯特一起躲到我背後……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "很好，",
    "voice": "vo_adv_7007001_001",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那麼{0}啊，拜託你了。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵呵……",
    "voice": "vo_adv_7007001_002",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈～哈哈哈！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n全身充滿了魔力！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "來吧，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "讓你們見識見識這份統御黑夜之人的力量！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "什麼？　",
    "voice": "vo_adv_7007001_003",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "奧恩斯坦大臣變成大人的姿態了！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這就是妾身的",
    "voice": "vo_adv_7007001_004",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真正力量！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "接招吧！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――吼喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哼……",
    "voice": "vo_adv_7007001_005",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真無趣。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎麼了？　",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "修特帕魯啊。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "是奧恩斯坦大臣……",
    "voice": "vo_adv_7007001_006",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "對吧？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯。",
    "voice": "vo_adv_7007001_007",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不好意思嚇到妳了。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "小孩子的模樣不過只是暫時的。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n現在這個模樣才是妾身的真面目喔。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯……",
    "voice": "vo_adv_7007001_008",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "又變小了嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n果然很不方便吶……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "變回小孩子的模樣了……",
    "voice": "vo_adv_7007001_009",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n做到這種事，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "難道",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "真的是吸血鬼？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯？　",
    "voice": "vo_adv_7007001_010",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎麼了？　",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有什麼問題嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "不，",
    "voice": "vo_adv_7007001_011",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "沒事！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "不對！",
    "voice": "vo_adv_7007001_012",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "「真不愧是奧恩斯坦大臣啊！」，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "剛只是這樣佩服了一下而已！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "哈～哈哈哈！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔，",
    "voice": "vo_adv_7007001_013",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是個奇怪的傢伙……",
    "voice": null,
    "unit_id": 104412
  }
