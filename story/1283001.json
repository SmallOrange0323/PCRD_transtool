[
  {
    "type": "background",
    "bg_id": "500893"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "蘭德索爾充滿了新年的歡樂氣氛，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而這股熱鬧氛圍也傳到了幫派地盤的巷弄裡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "要來囉，",
    "voice": "vo_adv_1283001_000",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "「動物園管理員」！",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "「圓形護盾」也已經配置完成！",
    "voice": "vo_adv_1283001_001",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "「蔓延森林」也已經準備就緒。",
    "voice": "vo_adv_1283001_002",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "如果趁這個時候……！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼，",
    "voice": "vo_adv_1283001_003",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就憑這些雜魚，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還以為能贏得過我的",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n「三女神‧慈樂之音六周年紀念版改裝‧",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n超級幫派巨星祈梨大人特別號」嗎？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "完全一動也不動！",
    "voice": "vo_adv_1283001_004",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "可惡！",
    "voice": "vo_adv_1283001_005",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "實在太巨大了！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "別放棄啊！",
    "voice": "vo_adv_1283001_006",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "勝負現在才要開始！",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那麼我就送你們上西天吧！",
    "voice": "vo_adv_1283001_007",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "看",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "招，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咚──！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "少年等人",
    "words": "嗚哇啊啊啊！",
    "voice": "vo_adv_1283001_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哈──哈哈哈──！",
    "voice": "vo_adv_1283001_009",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "根本連比都不用比嘛！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你們想要對抗祈梨大人我，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還早了一百年啊！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "可惡──！",
    "voice": "vo_adv_1283001_010",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "我們輸了！",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "唉，",
    "voice": "vo_adv_1283001_011",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "這樣當然贏不了嘛，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "\\n畢竟她的陀螺幾乎是我們的三倍大……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呀啊啊啊！",
    "voice": "vo_adv_1283001_012",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "欸，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼嘛，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "原來是小哥啊……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我還以為是嘉夜夜，害我嚇了一跳。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "啊，",
    "voice": "vo_adv_1283001_013",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "是祈梨姐姐手下的那個大哥哥。",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "你該不會不知道",
    "voice": "vo_adv_1283001_014",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "什麼是激鬥陀螺吧？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "激鬥陀螺",
    "voice": "vo_adv_1283001_015",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "是現在最流行的戰鬥遊戲。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "參戰者使用改造過的陀螺來對戰，",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "只要把對手撞出賽場，",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "\\n或是保持旋轉到最後的人就是贏家……",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我就是在用這個陀螺",
    "voice": "vo_adv_1283001_016",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "教訓教訓",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n這些小鬼啦。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啥？",
    "voice": "vo_adv_1283001_017",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你在說什麼啊？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這可是官方正版的，哪裡奸詐了！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "是啊，",
    "voice": "vo_adv_1283001_018",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "這是官方推出的聯名商品。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "\\n那上面加裝的零件",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "也都是符合規定的改造零件。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就是說啊！",
    "voice": "vo_adv_1283001_019",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這是慈樂之音6th巡迴演唱會賣的周邊，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是超級限量品！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "慈樂之音有三個人，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以陀螺有三倍大也很合理！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "是、",
    "voice": "vo_adv_1283001_020",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "畢竟是那個慈樂之音嘛，",
    "voice": "vo_adv_1283001_021",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "這也是沒有辦法的。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "不如該說她們已經有節制了。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "對喔，",
    "voice": "vo_adv_1283001_022",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "這傢伙也是慈樂之音的粉絲啊……",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說起來你們可是三打一，",
    "voice": "vo_adv_1283001_023",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我才是該抱怨的人吧！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "話雖如此，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這樣的情況下我還是贏了，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n那就表示我的實力是貨真價實的呢。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "的確是這樣沒錯～",
    "voice": "vo_adv_1283001_024",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "不過即使三打一，",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "我們還是從頭輸到尾……",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "這樣下去，比再多次結果可能也一樣……",
    "voice": "vo_adv_1283001_025",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "畢竟我們一次都沒有贏嘛。",
    "voice": "vo_adv_1283001_026",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "好像也只能下次再來了。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啥？",
    "voice": "vo_adv_1283001_027",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你們該不會不比了吧？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你們難道是想逃跑嗎！？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "說連比都不用比的人不就是妳嗎？",
    "voice": "vo_adv_1283001_028",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "我們必須",
    "voice": "vo_adv_1283001_029",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "要變得更強才行……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "要去修行對吧！",
    "voice": "vo_adv_1283001_030",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "\\n我知道一個好地方，",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "精靈族少年",
    "words": "我們走吧！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "獸人族少年",
    "words": "好！",
    "voice": "vo_adv_1283001_031",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "人族少年",
    "words": "走吧！",
    "voice": "vo_adv_1283001_032",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "欸，",
    "voice": "vo_adv_1283001_033",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "等等……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦咦咦咦？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那些傢伙，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "居然就這樣走掉了……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是的，",
    "voice": "vo_adv_1283001_034",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "最近的年輕人就是吃不了苦，真不像話！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "只不過是讓他們見識了一下成熟大人的財力，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n竟然就夾著尾巴逃走了……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "都不覺得丟臉嗎？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你在胡說什麼啊！",
    "voice": "vo_adv_1283001_035",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我要是對他們放水，那才叫不成熟！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你說什麼？",
    "voice": "vo_adv_1283001_036",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我只是陪他們玩玩而已！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n因為我是大人，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以不得不去應付小孩啦！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "身為長輩，",
    "voice": "vo_adv_1283001_037",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n就是要讓小鬼好好認清自己的實力，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這就是激鬥陀螺的……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不對，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是新年帝王祈梨大人的使命！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呵呵呵……",
    "voice": "vo_adv_1283001_038",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳自稱",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是帝王啊。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n很敢說嘛～",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼！？",
    "voice": "vo_adv_1283001_039",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你是……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是那個好像一直都在地盤邊緣曬太陽的老爺爺！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你笑什麼笑啊！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "這當然是因為，",
    "voice": "vo_adv_1283001_040",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "看妳那點程度就在那邊嚷嚷的模樣太滑稽了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "不過比個陀螺就自稱帝王，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "真是可笑至極。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啥！？",
    "voice": "vo_adv_1283001_041",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "像你這種只會呆站在一旁的老爺爺，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n不管對身為帝王的祈梨大人說什麼，我都不會被你激怒啦。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "沒有用的！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "好吧，",
    "voice": "vo_adv_1283001_042",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我就來回應你這個",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "粗糙的挑釁吧。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "祈梨大人我會像對付那些小鬼一樣，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "徹底把你打趴！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說吧，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你要比什麼？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "只會呆站在一旁……？",
    "voice": "vo_adv_1283001_043",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "原來妳是這麼看老夫的啊。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你還在那邊說什麼啊？",
    "voice": "vo_adv_1283001_044",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要比的話",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就趕快說你要比什麼！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "妳說這話還真是天真啊。",
    "voice": "vo_adv_1283001_045",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "比賽，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "早就已經開始囉。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊？",
    "voice": "vo_adv_1283001_046",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你說",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "他的手裡好像抓著什麼？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "看來那邊那位年輕人已經注意到了啊……",
    "voice": "vo_adv_1283001_047",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "注意到老夫的",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "這條「線」。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "他的手上",
    "voice": "vo_adv_1283001_048",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "的確抓著一條線耶。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n線看起來是往上延伸的，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這該不會……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是風箏嗎！？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "正是如此。",
    "voice": "vo_adv_1283001_049",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "老夫就是那個擁有60年放風箏資歷的",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "天空霸主席茲爺爺。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "天空霸主席茲爺爺！？",
    "voice": "vo_adv_1283001_050",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不，",
    "voice": "vo_adv_1283001_051",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "從來沒聽過……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我只是看到一把年紀的成年人一副很威風地報上愚蠢的名號，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n覺得很驚訝而已……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "呵，",
    "voice": "vo_adv_1283001_052",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "妳就儘管耍嘴皮子吧。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "和某個連風箏都沒注意到，就自稱是新年帝王的蠢蛋相比，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "老夫這根本不算什麼。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔……",
    "voice": "vo_adv_1283001_053",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘴巴還真會說啊。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "他說的也的確有道理……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "哦？",
    "voice": "vo_adv_1283001_054",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "看來妳終於明白了啊。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "那麼，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "妳要收回妳那愚蠢的帝王宣言嗎？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼！",
    "voice": "vo_adv_1283001_055",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我才不會做那種丟臉的事。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就讓我陪你玩玩吧！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我要撂倒你，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "成為真正的帝王！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥！",
    "voice": "vo_adv_1283001_056",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "跟我來！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我們要去買風箏！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "席茲爺爺，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你可不准逃跑喔！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "老夫就在這裡，不躲也不藏。",
    "voice": "vo_adv_1283001_057",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "倒是妳，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "可別就這樣逃之夭夭囉。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哈！",
    "voice": "vo_adv_1283001_058",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我現在就告訴你！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我會讓你輸到哭出來的！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "阿姨！",
    "voice": "vo_adv_1283001_059",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "給我最厲害的風箏！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "哎呀，",
    "voice": "vo_adv_1283001_060",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "祈梨，歡迎光臨。",
