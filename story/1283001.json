  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我們年輕人的風箏都還沒飛起來，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n那樣的老頭子卻已經讓風箏飛在空中，太不合理了……",
