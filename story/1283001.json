    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n就算看起來再怎麼像真的，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n妳有什麼證據可以證明那是真正的席茲……",
