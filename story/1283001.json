    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "當上帝王妳就滿意了嗎？",
    "voice": "vo_adv_1283001_084",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎麼樣？",
    "voice": "vo_adv_1283001_085",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "事到如今你還不服輸嗎？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "不是那樣的。",
    "voice": "vo_adv_1283001_086",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "妳難道不想超越帝王……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "坐上神的寶座嗎？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n妳打倒了老夫，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "就有資格向上挑戰……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "我把這個交給妳吧。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這個……",
    "voice": "vo_adv_1283001_087",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是什麼？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n「年神祭參加券」？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "拿著這個去懷舊點心店吧。",
    "voice": "vo_adv_1283001_088",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n妳可以在那邊詢問詳細的內容……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "席茲爺爺……？",
    "voice": "vo_adv_1283001_089",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "今年是龍年……",
    "voice": "vo_adv_1283001_090",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "這也許是命中註定的吧。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "那麼就再會了！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎麼有種自顧自地把話說完就溜走的感覺……",
    "voice": "vo_adv_1283001_091",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼……",
    "voice": "vo_adv_1283001_092",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那還用說嘛。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n既然如此，不管是神還是什麼，我都會坐上寶座的！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "快走吧，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "圍繞在年神上的奇妙戰鬥就此展開。",
    "voice": null,
    "unit_id": null
  }
]
