  {
    "type": "background",
    "bg_id": "500893"
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "呵呵呵……",
    "voice": "vo_adv_1283001_068",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "看來妳沒有逃跑呀。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "\\n我們來比賽誰的風箏飛得高，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "席茲爺爺",
    "words": "沒問題吧？",
