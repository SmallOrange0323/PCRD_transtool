  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "算了，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "也可以啦。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我就買這個吧。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "祈梨，",
    "voice": "vo_adv_1283001_066",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "如果妳贏了……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "不，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "現在就先不說了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店",
    "words": "妳要拿出全力，別留下遺憾囉。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗯？",
    "voice": "vo_adv_1283001_067",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "總覺得有點奇怪……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過現在沒空在意那個了。",
