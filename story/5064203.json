[
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "噗……",
    "voice": "vo_adv_5064203_000",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "結束了～",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "怎麼樣，",
    "voice": "vo_adv_5064203_001",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "認輸了嗎！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "可惡的神祕暗黑組織憂妮們！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "到底是什麼東西啊？",
    "voice": "vo_adv_5064203_002",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "那個叫憂妮們的。",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "我們學校才沒有那種「們」──",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "唔！",
    "voice": "vo_adv_5064203_003",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不好，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "憂妮們分裂後要逃跑了！",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "豈能就這樣放虎歸山！",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "各位我們追！",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "追上去湮滅所有證據！",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "湮滅證據……？",
    "voice": "vo_adv_5064203_004",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊啊不是，",
    "voice": "vo_adv_5064203_005",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "更正。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是為了守護學園的和平，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n正義的優妮們要繼續戰鬥！",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是啊！",
    "voice": "vo_adv_5064203_006",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "讓正義的好朋友社吧繼續戰鬥吧！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "啊……！",
    "voice": "vo_adv_5064203_007",
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "給我等一下，",
    "voice": null,
    "unit_id": 7112
  },
  {
    "type": "dialogue",
    "name": "瑪麗亞",
    "words": "話還沒──",
    "voice": null,
    "unit_id": 7112
  }
]
