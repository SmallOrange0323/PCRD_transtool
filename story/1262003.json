[
  {
    "type": "background",
    "bg_id": "500950"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "旅行最終日的隔天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n收拾完回程行李的伊莉亞垂頭喪氣地，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n望著原本裝著番茄汁但已空空如也的玻璃杯。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……唉。",
    "voice": "vo_adv_1262003_000",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒想到會變成如此意料之外的旅行。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……真是令人感到鬱悶啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "難道幹勁十足地來蜜月旅行這種事就是個錯誤嗎……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "帶了那麼多行李，",
    "voice": "vo_adv_1262003_001",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "結果幾乎都沒用到。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "特地寫好的行程表和確認清單",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n也是一個都沒有完成。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……雖說如此，",
    "voice": "vo_adv_1262003_002",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "令人心滿意足的鄉村料理、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "眺望美麗的景色、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n被人民們感謝、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還品嚐到了極品的番茄汁。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這絕非是段糟糕的時光。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這裡是片非常好的土地、",
    "voice": "vo_adv_1262003_003",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這次也是很好的旅行。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "和那傢伙……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "卻什麼事都沒做到。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如果沒辦法獲得",
    "voice": "vo_adv_1262003_004",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "內心唯一想要的東西……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n那麼除此之外的東西妾身都不需要啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哼。",
    "voice": "vo_adv_1262003_005",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真不是支配者該有的",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "膚淺想法啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "越是去想那傢伙的事情，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就會越是失去支配者該有的樣子。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……既然如此，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "乾脆──",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "──唔嗯。",
    "voice": "vo_adv_1262003_006",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那麼，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "回去古城吧。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n……「眷屬」啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "background",
    "bg_id": "500142"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯嗯……",
    "voice": "vo_adv_1262003_007",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "已經入夜了啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在馬車上晃呀晃的，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就不小心睡著了。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔、",
    "voice": "vo_adv_1262003_008",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔嗯。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然現在已經恢復了原本的模樣，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不過在小孩子狀態的時候還是有些勉強自己，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "所以可能有點累了。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "──要是",
    "voice": "vo_adv_1262003_009",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這趟旅程全部",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "都只是一場喧鬧的夢就好了。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "現在",
    "voice": "vo_adv_1262003_010",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "大概到哪裡了？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n太陽也下山了，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是不是差不多也要到蘭德索爾了。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這樣啊。",
    "voice": "vo_adv_1262003_011",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那麼",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "似乎還會花點時間呢。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這下",
    "voice": "vo_adv_1262003_012",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "該在哪裡提出那件事呢……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n說到底，要怎麼提出來比較好？　",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身都不知道自己有這麼膽小呢。",
    "voice": "vo_adv_1262003_013",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n明明蘭德索爾已在不遠處，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "旅行就要準備進入尾聲了──",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯、",
    "voice": "vo_adv_1262003_014",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎麼了，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "突然停下馬車……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "瀑布……？",
    "voice": "vo_adv_1262003_015",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "知、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "知道了知道了。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "從馬車上下去就行了吧。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不用這樣蹦蹦跳跳！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你是兔子嗎！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "background",
    "bg_id": "501372"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "──這、",
    "voice": "vo_adv_1262003_016",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這不是……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "猶如幻境一般的美景嗎。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "飄在空中的月亮",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也映照在水面上飄著呢……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真沒想到在蘭德索爾附近",
    "voice": "vo_adv_1262003_017",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "能看到如此絕景……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這就是所謂的",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "燈下黑吧。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵，",
    "voice": "vo_adv_1262003_018",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你記住妾身說的話了啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n真是聰明的傢伙呢。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你這傢伙啊……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……天上的月亮",
    "voice": "vo_adv_1262003_019",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "和水面上的月亮。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就像在照鏡子一般相似的模樣，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "卻絕對不會有任何交集，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n在遠方相互照映著彼此──",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "簡直就跟妾身",
    "voice": "vo_adv_1262003_020",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "和這傢伙一樣啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……吶，",
    "voice": "vo_adv_1262003_021",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n知道「吸血鬼無法渡過流水」",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這件事嗎？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯。",
    "voice": "vo_adv_1262003_022",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有謠言說",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這是吸血鬼的弱點之一。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "其實",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "並沒有這回事。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如果無法渡過流水，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n那就會連沐浴都沒有辦法呢。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過，",
    "voice": "vo_adv_1262003_023",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身到最近……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "似乎理解了",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這句話真正的意思。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "流水",
    "voice": "vo_adv_1262003_024",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "所指的──",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也就是區隔不同種族或身分，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那道看不見的邊界。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "站在流水兩側的人",
    "voice": "vo_adv_1262003_025",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "肯定互不相容。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "支配者和人民。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "吸血鬼和人類。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "主人",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "和眷屬……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你和妾身……",
    "voice": "vo_adv_1262003_026",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "肯定也是這樣的吧。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "今後你如果繼續和妾身待在一起，",
    "voice": "vo_adv_1262003_027",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就算沒有香水之力，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n也會有許多危難降臨到你身上。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "然後",
    "voice": "vo_adv_1262003_028",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "即使如此……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你還是會一副無所謂的樣子……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "跟在妾身身旁吧。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "眷屬啊。",
    "voice": "vo_adv_1262003_029",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身對於這樣的你……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n感到無比憐愛，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也感到無比恐懼。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過是出來旅行而已，",
    "voice": "vo_adv_1262003_030",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就遇到了那種事對吧？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n如果妾身跟你一起私奔的話……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "感覺我們彼此",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "遲早有一天會變得很奇怪。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "所以乾脆……",
    "voice": "vo_adv_1262003_031",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "跟妾身……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……試試？",
    "voice": "vo_adv_1262003_032",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "究竟在說什麼──",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊！？",
    "voice": "vo_adv_1262003_033",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你要做什麼！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你不放手嗎……！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你打算帶妾身去哪裡！？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不不不、",
    "voice": "vo_adv_1262003_034",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不用來到岸邊",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也能欣賞景色吧～！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "等一下，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "連等都不等嗎！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "算了，不等也沒關係！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n但你至少",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "告訴妾身要做什麼吧！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不要不說話！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這樣會讓人很不安啊！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "咦咦！",
    "voice": "vo_adv_1262003_035",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "把妾身帶來這種地方……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n究竟是想要試什麼？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "玩、",
    "voice": "vo_adv_1262003_036",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "玩水……？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "──停、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "停下！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你要去哪裡！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "該不會",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是打算在這個瀑潭游泳吧！？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不是不太會游泳嗎！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……你說水沒有那麼深？",
    "voice": "vo_adv_1262003_037",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "即、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "即使如此，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "像這樣腰部以下都泡到水裡……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n要是感冒了怎麼辦。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你還不快點回來嗎！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……你、",
    "voice": "vo_adv_1262003_038",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如、",
    "voice": "vo_adv_1262003_039",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如果讓雙腳",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "踏入眼前的流水裡……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n如果走到那傢伙的身邊……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那傢伙就無法",
    "voice": "vo_adv_1262003_040",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "再回到一般人的生活。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "而妾身──",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也將不再是支配者、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不再是單純的主人了。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……眷、",
    "voice": "vo_adv_1262003_041",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "眷屬啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身呢──",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔！",
    "voice": "vo_adv_1262003_042",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊啊啊～～～！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n只、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只不過是水而已，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "又能對妾身怎麼樣──",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔，",
    "voice": "vo_adv_1262003_043",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好冷！？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "才不會冷呢！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "很快",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就會習慣了！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好了，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在那邊等著不要動！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "──什麼流水！",
    "voice": "vo_adv_1262003_044",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼邊界！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "支配者應有的模樣？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這種事情",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "由妾身來決定！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n做決定的人才正是支配者不是嗎！　",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身的自由，",
    "voice": "vo_adv_1262003_045",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "由妾身支配。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這可不是任何人能奪走的！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "流水這種小事，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身可是──",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不會屈服的！！　",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……如、",
    "voice": "vo_adv_1262003_046",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如何。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這樣就滿意了嗎。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "結果你",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是想嘗試什麼？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……啊？",
    "voice": "vo_adv_1262003_047",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "該、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "該不會你……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n為了確認妾身說的迷信，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就做出了這種事？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "──唔哈哈哈、",
    "voice": "vo_adv_1262003_048",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊哈哈哈！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊哈哈哈哈！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身不是說了只是謠言嗎！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "為了這個，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你還特地",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n像這樣泡到水裡……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔哈哈哈哈！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈哈哈哈哈！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是的，",
    "voice": "vo_adv_1262003_049",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你還真是個有趣又奇怪的傢伙啊！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n如果這個謠言是真的，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身因此而出了什麼事的話，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你打算怎麼辦？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……嗯。",
    "voice": "vo_adv_1262003_050",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "結果",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也沒發生什麼事呢。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "看來是杞人憂天了呢。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那麼……",
    "voice": "vo_adv_1262003_051",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "主人和眷屬，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "我們一個個",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "都全身溼透了呢。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "要做的事情就只有一個。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你說",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是吧？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哼，",
    "voice": "vo_adv_1262003_052",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "太天真了！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你剛剛手邊",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在製作水槍這種事，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身早就看穿了！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "反正等一下",
    "voice": "vo_adv_1262003_053",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "會回到妾身的城堡了。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那就讓你全身從頭到腳都濕透吧。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身就證明給你看──",
    "voice": "vo_adv_1262003_054",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "流水什麼的妾身才不怕！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呼──",
    "voice": "vo_adv_1262003_055",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "一開始覺得水很冰涼刺骨，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "習慣之後就很舒服。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n夜風吹拂在溼透的肌膚上……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "感覺別有一番風味呢。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "涼爽而帶有濕氣、",
    "voice": "vo_adv_1262003_056",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在月光下呈現出藍色調的夜色……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n如果黑夜有香氣，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "或許就是這個味道呢。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n要是有這種香水，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "想必會很適合現在的妾身吧。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "果然，",
    "voice": "vo_adv_1262003_057",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "夜晚真好。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n安靜、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "溫柔……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有時溫暖、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有時寒冷。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "夜晚的寂靜",
    "voice": "vo_adv_1262003_058",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "正是妾身所鍾愛、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也是必須由妾身所支配的事物。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "吾之眷屬啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你也這麼認為嗎？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "──唔？",
    "voice": "vo_adv_1262003_059",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哎呀、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哎呀哎呀哎呀……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒有在看天上的月亮，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "反而是對妾身看入迷了啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵，",
    "voice": "vo_adv_1262003_060",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這就是所謂",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "美貌水靈動人的吸血鬼呢。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n再加上月光的妝點……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "簡直是難以用言語形容的美麗對吧？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你似乎很喜歡妾身這副模樣，",
    "voice": "vo_adv_1262003_061",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但若是被這樣盯著看……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那、",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那個……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n稍微，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有點難為情。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "噯，",
    "voice": "vo_adv_1262003_062",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身並不是要怪你盯著妾身看……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n但你的視線，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是否有點太沒分寸了？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……不過，",
    "voice": "vo_adv_1262003_063",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "終於有一件像蜜月旅行的事情了。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n雖然無法否認",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "戲水什麼的有點像小孩子在玩耍──",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但不知為何，",
    "voice": "vo_adv_1262003_064",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這令人感到十分地神清氣爽。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不是作為支配者，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也不是以主人的身分……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n就只是妾身",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "照著妾身自己的想法來行動。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這種自由的感覺，",
    "voice": "vo_adv_1262003_065",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "已經多久沒有過了呢。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真想乾脆",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "把身上的裝束全數褪去。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在那傢伙面前",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不能做出這麼不知羞的事情……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過，",
    "voice": "vo_adv_1262003_066",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這也是多虧那傢伙",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "帶著妾身……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n越過了流水前往對岸呢。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "邂逅從未見過的景色，",
    "voice": "vo_adv_1262003_067",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "正是旅行的醍醐味。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n名為自由的未知絕景……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n確實映入了",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身的眼簾。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……妾身",
    "voice": "vo_adv_1262003_068",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "得向你道謝才行。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你讓妾身見到了",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在活過的漫長時光中都從未見過的景色。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵，",
    "voice": "vo_adv_1262003_069",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒錯呢。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也許就是那樣呢。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……來吧，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "今晚",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就原諒你那沒有分寸的視線吧。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n把妾身的美豔姿態，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好好地烙印在眼裡吧。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不論經歷多少歲月、",
    "voice": "vo_adv_1262003_070",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "多少危難……",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n即使有事物會將妾身和你分隔開來，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也絕對不要忘記喔。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……妾身所選的",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "頭號眷屬啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在溫柔的月光下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n伊莉亞和{0}盡情戲水後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人在馬車的車伕席上肩並著肩，啟程歸去。",
    "voice": null,
    "unit_id": null
  }
]
