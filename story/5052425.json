  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "やったねお姉ちゃん！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n私たち、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "こんなにいっぱい倒しちゃったよ！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "そうね、",
    "voice": "vo_adv_5048425_001",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "自分でも驚いてるわ。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "アカリと一緒なら、",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "こんなにも強くなれるのね。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "うん！　",
    "voice": "vo_adv_5048425_002",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "私たち二人そろえば怖いものなし、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\nランドソル一、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "ううん、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "世界一の双子だね♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "そ、",
    "voice": "vo_adv_5048425_003",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "それは言い過ぎじゃない？",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "でも、",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "あながち間違いじゃないって思えるわ。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\nそれだけ強くなれたってことなのかな？　",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "だとしたらうれしいわ。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "でも、",
    "voice": "vo_adv_5048425_004",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "これで満足してちゃダメよね。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\nそう、",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "これは通過点よ。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "まだまだイケるってところ、",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "見せてあげるわ！",
    "voice": null,
    "unit_id": 113811
  },
