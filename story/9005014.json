  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n雪菲的臉上難掩焦急之色。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呼、",
    "voice": "vo_adv_9005014_000",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呼……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n紀念日",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "馬上就要到了……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "誇下海口說要自己製作禮物，",
    "voice": "vo_adv_9005014_001",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "結果卻來不及完成……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這種事太難啟齒了。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "可是",
    "voice": "vo_adv_9005014_002",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "該怎麼辦才好……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我還沒有畫完啊──！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "打擾啦，",
    "voice": "vo_adv_9005014_003",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們進來囉──？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n畫漫畫的地方就是這裡嗎？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "哇～",
    "voice": "vo_adv_9005014_004",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好棒喔。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "雪菲小姐",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "妳很努力在畫呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們來幫忙啦～！",
    "voice": "vo_adv_9005014_005",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "有我們在，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "勝過百人之力喔～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "看樣子",
