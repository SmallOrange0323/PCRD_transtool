    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "感謝妳願意",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "幫我這個忙☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳還真是毫不客氣地在使用我的能力呢。",
