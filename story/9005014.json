    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我可能一不小心，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n就會先得知小雪菲的禮物內容了嘛。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "原來如此。",
    "voice": "vo_adv_9005014_024",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n妳是那種",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "會把喜歡的食物留到最後的類型啊。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……？",
    "voice": "vo_adv_9005014_025",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "只要是食物我都最喜歡了♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n會把它們通通吃光光喔。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "…………",
    "voice": "vo_adv_9005014_026",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "總之，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "該做的我都做了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n妳就儘管期待明天的成果吧。",
