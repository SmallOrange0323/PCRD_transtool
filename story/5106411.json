  {
    "type": "dialogue",
    "name": "茜里",
    "words": "神聖的一天",
    "voice": "vo_adv_5106411_000",
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "就要結束了呢～",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "聖誕節給茜里的印象",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "一直都是要與情人共度，",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n但是……",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "像這樣和很多人一起放縱，",
    "voice": "vo_adv_5106411_001",
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "感覺也很特別呢～",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里超級興奮的。",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "對吧，",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊？",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "妳、",
    "voice": "vo_adv_5106411_002",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "妳的用詞好像怪怪的，",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗯，",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不過",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "茜里說的可能……",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "沒錯吧。",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "聖誕節是要和大家一起過的，",
    "voice": "vo_adv_5106411_003",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我以為",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這個活動一輩子和我無緣。",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n可是……",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗯，",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我覺得",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "真的",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "很開心。",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵，",
    "voice": "vo_adv_5106411_004",
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那就再好不過了。",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "對了，還有一點時間，",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳們待會要做什麼？",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "該不會要去約會？",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "依里、茜里",
    "words": "……！！",
    "voice": "vo_adv_5106411_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊，",
    "voice": "vo_adv_5106411_006",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不，",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "呃……",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "…………",
    "voice": "vo_adv_5106411_007",
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唉呀，",
    "voice": "vo_adv_5106411_008",
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "看來還有尚未解決的問題呢。",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳們一路都一起共患難，",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以一定可以的，",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我保證。",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n──來吧，",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "努力到最後吧！",
    "voice": null,
    "unit_id": 124211
  }
]
