[
  {
    "type": "dialogue",
    "name": "美空",
    "words": "奇怪？",
    "voice": "vo_adv_5148302_000",
    "unit_id": 131211
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n牠看起來很有精神耶──",
    "voice": null,
    "unit_id": 131211
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 131211
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "不如說，",
    "voice": null,
    "unit_id": 131211
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "牠好像變得比剛剛更強了？",
    "voice": null,
    "unit_id": 131211
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "是魔導具的影響嗎～？",
    "voice": "vo_adv_5148302_001",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "魔力也變多了，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "似乎失控得比剛剛更嚴重了。",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "不如說……",
    "voice": "vo_adv_5148302_002",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n有種讓人不舒服的氣魄傳了過來啊……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n是我的錯覺嗎？",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "這麼說來～",
    "voice": "vo_adv_5148302_003",
    "unit_id": 131211
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "那隻史萊姆。",
    "voice": null,
    "unit_id": 131211
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n看起來好像在用下流的表情笑著呢～",
    "voice": null,
    "unit_id": 131211
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 131211
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "牠是不是在想著，",
    "voice": null,
    "unit_id": 131211
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "這次我絕對要",
    "voice": null,
    "unit_id": 131211
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "把泳裝溶掉～",
    "voice": null,
    "unit_id": 131211
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "之類的呀？",
    "voice": null,
    "unit_id": 131211
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯～",
    "voice": "vo_adv_5148302_004",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真的呢。",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "牠是像到誰啊～？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "真是隻恐怖的史萊姆呢……",
    "voice": "vo_adv_5148302_005",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n無論如何，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "要提高警覺才行……！",
    "voice": null,
    "unit_id": 131611
  }
]
