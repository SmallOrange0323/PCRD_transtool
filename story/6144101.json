  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "芙菈瓦村裡，",
    "voice": "vo_adv_6144101_000",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n有種好多花呢～",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "你喜歡",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "什麼樣的花呢？",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "原來如此……",
    "voice": "vo_adv_6144101_001",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "像是藤花",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "或是堇菜……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n還有鳶尾花之類的，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "感覺是你會喜歡的呢♪",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "你有空的話，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我們一起去看看吧！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "果然",
    "voice": "vo_adv_6144101_002",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還是會讓人有活力的花比較好呢！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "對面那邊有開了很多的鬱金香，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "光是看著",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我就開始感到幸福了～♪",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦那個，",
    "voice": "vo_adv_6144101_003",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呃……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就是，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "它吃掉小蟲子的模樣，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "也是很可愛呢！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大概吧……",
    "voice": null,
    "unit_id": 130811
  }
]
