[
  {
    "type": "background",
    "bg_id": "502910"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "『R＆Aリゾート』開業までわずかと迫ったある日。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n{0}が雑用をしていると、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n船着き場で騒ぐクレジッタを見かけた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "──おっそ～い！　",
    "voice": "vo_adv_1400001_000",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "冒険者はまだですの遅いですわ遅すぎですわっ！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nこちとら緊急クエストとしてギルドに依頼を出しておりますのよ。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n報酬額下げられても文句は言わせませんからね",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "時は金なりなのですから！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "まあまあ、",
    "voice": "vo_adv_1400001_001",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "気長に待ちましょうよ。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nせっかくのリゾート地ですし。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "な～～～にを悠長なことを言っておりますの？",
    "voice": "vo_adv_1400001_002",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nこうしている間にもいつ魔物が……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "って、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "出ましたわっ！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "警備も間に合いませんし、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "仕方ありませんわね",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "下がってなさい秘書１号！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ミリオンフリッピングっ！！",
    "voice": "vo_adv_1400001_003",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──ギャオオオオオッ！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……ったく、",
    "voice": "vo_adv_1400001_004",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "このリゾートを荒らしたらただじゃ置きませんわよ。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n魔物とか関係ありませんわ。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n出るとこ出て",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "損害賠償ふんだくってやりますからね。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──グオオオオオッ！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……っ！？　",
    "voice": "vo_adv_1400001_005",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "もう一匹隠れてやがったんですの！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "こんのっ……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "background",
    "bg_id": "502910"
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "っ、",
    "voice": "vo_adv_1400001_006",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "冷たっ！？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……いえ、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "助かりましたわっ！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nどぉりゃぁああ～っ！！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──ギャオオオオオッ！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "ナイスアシストです騎士さん。",
    "voice": "vo_adv_1400001_007",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "クレジッタさま、",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "徹夜明けで無理すると",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "ケガじゃ済みませんよ？",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nそもそも",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "戦闘よりもデスクワークの方なんですし。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "うるっさいですわよ秘書１号",
    "voice": "vo_adv_1400001_008",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "開業が遅れるよりマシでしょうが！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……ですが少年には、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "礼を言っておきますわ。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "何やらものすごい濡れてしまいましたが……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "まあいいでしょう。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……ええ。",
    "voice": "vo_adv_1400001_009",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "少し前にわたくしたちが海の主を退治したでしょう、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あの鮫の。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nその影響で",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "この辺りの魔物たちが活性化されてしまってるようなのです。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "それで魔物討伐の依頼を出したんですが、",
    "voice": "vo_adv_1400001_010",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "その冒険者たちがまだ来ない……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……はぁっ！？",
    "voice": "vo_adv_1400001_011",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ちょ、",
    "voice": "vo_adv_1400001_012",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ちょっとちょっとどういうことですの……！？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nあなたたち、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "どんどん体が縮んで……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……いえ、",
    "voice": "vo_adv_1400001_013",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "私たちではありません。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "クレジッタさま……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "どうやらまた……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "きゃああぁぁあああッッ！！？",
    "voice": "vo_adv_1400001_014",
    "unit_id": 140011
  },
  {
    "type": "still",
    "still_id": "521800201"
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "な……っ、",
    "voice": "vo_adv_1400001_015",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "な……っ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nな・な・な……っっ！！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "なんでまた巨大化しておりますの～～～っ！？",
    "voice": "vo_adv_1400001_016",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "これ完っ全に『巨大化の秘薬』の効果ですわよね！？",
    "voice": "vo_adv_1400001_017",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "でも、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "一体なぜ……！？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nわたくし秘薬なんてぶっかけられておりませんけど……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……いえ。",
    "voice": "vo_adv_1400001_018",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そういえば、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "先ほど……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "クレジッタさま、",
    "voice": "vo_adv_1400001_019",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "ここに秘薬の空き瓶が。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n騎士さんが整理していた不用品の中に",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "紛れ込んでいたようです。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "な、",
    "voice": "vo_adv_1400001_020",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "なんと杜撰な……っ！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "少年、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "これはいったいどういう事なんですの！？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "って",
    "voice": "vo_adv_1400001_021",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "本当にどういう事ですのっっ！？！？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "な、",
    "voice": "vo_adv_1400001_022",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "なんでまたわたくしの谷間にすっぽり挟まっておられるのかしら！？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……助けようと駆け寄ったら巻き込まれた……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "って知りませんわっ！！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nあっ、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "こら秘書１号っ！　",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "今あなた一瞬ニヤッとしましたわねニヤッと！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "全くなんでわたくしがこんな目にぃぃ……っ！　",
    "voice": "vo_adv_1400001_023",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ほら",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "秘書１号っ！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nいろんな角度から見てないで",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "早く『小さくなる秘薬』を捜しなさいっ！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そして少年っ！　",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あなたはさっさとそこをお退きなさいっ！！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "それから数十分後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "ふむ……",
    "voice": "vo_adv_1400001_024",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "どうやら",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "『小さくなる秘薬』はないようです。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
