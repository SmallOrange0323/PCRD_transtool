  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "重建活動告一段落，{0}他們\\n為了修復「皇家裝備」的劍，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "四處走訪蘭德索爾的鐵匠鋪。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鐵匠‧三男",
    "words": "啊……",
    "voice": "vo_adv_1383003_000",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "鐵匠‧三男",
    "words": "沒辦法呢。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "鐵匠‧次男",
    "words": "……辦不到。",
    "voice": "vo_adv_1383003_001",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "鐵匠‧長男",
    "words": "嗯～～～～～～～～",
    "voice": "vo_adv_1383003_002",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎麼樣？",
    "voice": "vo_adv_1383003_003",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我的貪吃劍，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "修得好嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "鐵匠‧長男",
    "words": "……這是我沒看過的金屬",
    "voice": "vo_adv_1383003_004",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "鐵匠‧長男",
    "words": "和技術。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "鐵匠‧長男",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "鐵匠‧長男",
    "words": "不是普通手法能夠修得好的東西。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "鐵匠‧長男",
    "words": "所以說，",
    "voice": "vo_adv_1383003_005",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "鐵匠‧長男",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "鐵匠‧長男",
    "words": "我投降。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "鐵匠‧長男",
    "words": "辦不到辦不到。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯～",
    "voice": "vo_adv_1383003_006",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家都說沒辦法呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "製作「皇家裝備」的人──",
    "voice": "vo_adv_1383003_007",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n要是能聯絡到拉比林斯達小姐的話，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n就能獲得線索了……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是在聯絡上之前，",
    "voice": "vo_adv_1383003_008",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就這樣放著不管的話，感覺也很可憐……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "想為它做點什麼。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然折斷時",
    "voice": "vo_adv_1383003_009",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還說了「至今為止謝謝你了！」",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這種話。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n但觸碰它的時候……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "總覺得它好像很失落。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……哎呀。",
    "voice": "vo_adv_1383003_010",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "看你的眼神好像覺得很不可思議呢？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我偶爾",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "能夠感受到它的心情喔。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n當然，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也可能只是我的妄想。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯～",
    "voice": "vo_adv_1383003_011",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "只靠我們的知識實在無法解決，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這時候就借助大家的力量吧！",
    "voice": null,
    "unit_id": 105812
  },
