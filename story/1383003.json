    "name": "貪吃佩可",
    "words": "啊。",
    "voice": "vo_adv_1383003_017",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒事，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
