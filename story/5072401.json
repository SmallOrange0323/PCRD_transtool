  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊，",
    "voice": "vo_adv_5072401_000",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n這套服裝，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你覺得如何？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "主題是泳裝和偶像！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "還挺不錯的對吧♪",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你看看，",
    "voice": "vo_adv_5072401_001",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這布料的飄逸感，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "在舞台上肯定會很引人注目！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呵呵呵，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這可是我犧牲睡眠時間所設計出來的得意之作呢～！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……唔！",
    "voice": "vo_adv_5072401_002",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我為何非得向騎士先生炫耀不可啊！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "話說回來，你也看得太久了吧！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你知道什麼叫客氣嗎！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦？",
    "voice": "vo_adv_5072401_003",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你說是我讓你看的？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "才不會有這種事！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你是在找藉口嗎！？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n騎士先生實在無可救藥！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我說你啊……",
    "voice": "vo_adv_5072401_004",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你說很適合我？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是是，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就算受到騎士先生的讚賞，我也不會覺得高興。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "隨口問一下……",
    "voice": "vo_adv_5072401_005",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你真的",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這麼認為嗎？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "哦，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是這樣啊。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那好吧，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "要我原諒你也行啦。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……呵呵♪",
    "voice": null,
    "unit_id": 117411
  }
]
