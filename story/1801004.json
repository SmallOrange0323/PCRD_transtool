  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "解決了流氓佔領道路的問題後，過了幾天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n日和來到{0}面前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊──！",
    "voice": "vo_adv_1801004_000",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "找到騎士先生了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嘿～",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這裡這裡──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我有事要問騎士先生所以在找你呢！",
    "voice": "vo_adv_1801004_001",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有找到真是太好了──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……我說，騎士先生！",
    "voice": "vo_adv_1801004_002",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n今天我有事想拜託你！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我呀，",
    "voice": "vo_adv_1801004_003",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "想更加好好掌握公主型態的力量！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "之前戰鬥的時候，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我覺得自己好像還能變得更強！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我想請騎士先生再和我去城外特訓……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怎麼感覺，",
    "voice": "vo_adv_1801004_004",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生在發光……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n該不會，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "終於連騎士先生也要變成公主型態了！？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……咦，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "連我都被捲進光裡了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怎麼回事，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "感覺",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好睏……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "background",
    "bg_id": "510121"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊咧？",
    "voice": "vo_adv_1801004_005",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是前輩。",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "呀呵──！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "欸嘿嘿，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "能在這裡碰到前輩真巧呢！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……其實也有點不算是巧合啦♪",
    "voice": "vo_adv_1801004_006",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我剛剛心想著，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真想碰到前輩呢～",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "所以就跑來公園看看。",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n沒想到前輩真的在，我嚇了一跳，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "又好開心喔──！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_1801004_007",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "的確是呢，前輩！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "難得碰面，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "待會我們……",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊咧……？",
    "voice": "vo_adv_1801004_008",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "說話的方式和以往一樣……",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n但為什麼呢？",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "感覺好像沒什麼精神……？",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n前輩，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你怎麼了……？",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……啊，",
    "voice": "vo_adv_1801004_009",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "等一下！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不要站在公園裡，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們找間店坐下來聊吧！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我想好好地",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "聽前輩說話嘛！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "still",
    "still_id": "180100401"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "──嗯～",
    "voice": "vo_adv_1801004_010",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "果然這裡特別讓人放鬆呢──！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "或許是因為來過好多次了，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "感覺就像是我的第二個家一樣──♪",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……那麼",
    "voice": "vo_adv_1801004_011",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "前輩，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你怎麼了嗎？",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "雖然或許光靠我幫不上什麼忙，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但我還是想盡可能地",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "幫助前輩！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "考試的得分",
    "voice": "vo_adv_1801004_012",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不太好……？",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "呼……",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "幸好不是什麼嚴重的問題……",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……啊，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "抱歉！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對前輩來說是很大的煩惱呢！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不過看前輩這麼煩惱，",
    "voice": "vo_adv_1801004_013",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我還以為",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "會是更嚴重的事情呢。",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可能家人生病了，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還是弄丟錢包了，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n或者，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我想想……",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "被處罰不能吃晚餐之類的！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不過，",
    "voice": "vo_adv_1801004_014",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "學習的問題我也沒轍呢……",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我和前輩不同年級，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n也不是什麼很會念書的人……",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "still",
    "still_id": "180100402"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不過，",
    "voice": "vo_adv_1801004_015",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我可以",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "用別的方式來鼓勵前輩喔！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我想想，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "念書的時候幫前輩帶宵夜",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "之類的，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n或是在用功念書的前輩旁邊，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "跳啦啦隊幫忙加油！！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "加油加油，",
    "voice": "vo_adv_1801004_016",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "努力用功，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "前",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "～",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "輩",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "～！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "之類的，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "欸嘿嘿……",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "需要我幫忙加油的話，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "隨時都可以連絡我喔！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n除了深夜之外我都能去前輩家玩……",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不是，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是去前輩家幫忙！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……",
    "voice": "vo_adv_1801004_017",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "前輩，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "為什麼要這樣",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "盯著我看呢？",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "果然，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "在前輩旁邊跳啦啦隊",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是不是太吵了──？",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還是你擔心宵夜的口味？",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "放心啦～！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "別看這樣，我可是對料理……",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "background",
    "bg_id": "510050"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……",
    "voice": "vo_adv_1801004_018",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "抱歉，",
    "voice": "vo_adv_1801004_019",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "完全被前輩看穿了，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "所以我嚇了一跳……",
