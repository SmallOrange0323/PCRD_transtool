  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我想想，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我想想喔……！！　",
    "voice": null,
    "unit_id": 100131
  },
