    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好像說了很容易讓人誤解的話耶！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n那句話好像能解釋成，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
