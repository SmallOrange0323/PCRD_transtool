  {
    "type": "dialogue",
    "name": "チエル",
    "words": "先輩ひまー。",
    "voice": "vo_adv_6023207_000",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "なんか楽しいことないすかー？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n貴重なチエルの青春残量が",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "刻一刻と擦り減ってるんですけど。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "はー、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "勿体なー……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "てか、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "どっか遊びに連れてってくださいよう。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "同じくです。",
    "voice": "vo_adv_6023207_001",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "チエルん家わりとお金持ちだけど、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n両親ちゃんとしてるから",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "子供には子供らしい経済観念を強いるんです。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "てか、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "お金なんかなくたっていくらでも遊べるッ！　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "付いてこい！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "えー、",
    "voice": "vo_adv_6023207_002",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "なんでですかあ。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "いいじゃないですか、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ちょっとぐらい……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "えっ、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "配達の仕事中？　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "あ、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ガチのやつでしたか、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ごめんなさい。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "それじゃ失礼しますね。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "良かったら、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "また今度遊んでやってください。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "はあ……",
    "voice": "vo_adv_6023207_003",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "そうですね、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "本人が言うなら否定はしませんけど。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "でも、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "逆にですよ？　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "何もないってことは制限もないってことです。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n何者にもなれるじゃないですか！　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "可能性に満ちてますよ、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "先輩！",
    "voice": null,
    "unit_id": 110911
  }
]
