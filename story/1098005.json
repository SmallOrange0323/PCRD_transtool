[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在拉姆對【美食殿堂】表達感謝之意後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n過了一段時間的某一天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "拉姆正一個人走在蘭德索爾的街道上──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雷姆跟咲戀一起出門買東西，",
    "voice": "vo_adv_1098005_000",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n拉姆為了打發時間才會來到街上走走……",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這裡依舊還是一樣，",
    "voice": "vo_adv_1098005_001",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是個很悠哉的城鎮呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "嗚嗚……",
    "voice": "vo_adv_1098005_002",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n嗚嗚",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "嗚嗚。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "────？",
    "voice": "vo_adv_1098005_003",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "嗚",
    "voice": "vo_adv_1098005_004",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "嗚……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我的、",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我的……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "本想說怎麼會有小孩子的哭聲，",
    "voice": "vo_adv_1098005_005",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n結果跟小孩在一起的不就是{0}嗎。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這邊也還是老樣子呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "啊……",
    "voice": "vo_adv_1098005_006",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "大哥哥……？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我的玩具……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那是──",
    "voice": "vo_adv_1098005_007",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "他把小孩子的玩具拿走了？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "還以為他是個把善良當作衣服穿在身上的男人，",
    "voice": "vo_adv_1098005_008",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "看來是拉姆搞錯了呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "似乎還不能，",
    "voice": "vo_adv_1098005_009",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "徹底信任他。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那個男人對來到了這個世界的拉姆我們展現出了自然的善良。",
    "voice": "vo_adv_1098005_010",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "而針對這點，",
    "voice": "vo_adv_1098005_011",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆已經親自招待他傳說中的蒸番薯來回報了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "但剛才的行為……",
    "voice": "vo_adv_1098005_012",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "看來有必要修正一下對那個男人的評價。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "以剛才那個樣子，",
    "voice": "vo_adv_1098005_013",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "誰知道他背地裡會是什麼樣的人。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "在雷姆跟愛蜜莉雅大人看到他背地裡的樣子前──",
    "voice": "vo_adv_1098005_014",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "似乎有必要讓拉姆來處理一下呢。",
    "voice": "vo_adv_1098005_015",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "請放心交給拉姆吧。",
    "voice": "vo_adv_1098005_016",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n先放長線讓那個男人逍遙一陣子。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n在那之後，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆會好好地讓他受到懲罰的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "放長線……？",
    "voice": "vo_adv_1098005_017",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "沒錯。",
    "voice": "vo_adv_1098005_018",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "首先要收集證據，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "然後再交給適當的機關來處理。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "為此得先跟蹤他。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這次拉姆不會再失敗了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "雖然不是很清楚……",
    "voice": "vo_adv_1098005_019",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "但好像很有趣！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我也要一起！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……拉姆了解了。",
    "voice": "vo_adv_1098005_020",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你想親自取回自己的東西對吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "但作為交換，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "別再哭了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n跟蹤時如果因為哭聲而被發現就功虧一簣了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n拉姆決定開始跟蹤{0}……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那就是，",
    "voice": "vo_adv_1098005_021",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "所謂的打工嗎。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n在四處奔波送完貨後，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "終於坐下來休息了的樣子。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n在他膝蓋上的是……",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "便當嗎？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這是在用餐休息嗎。",
    "voice": "vo_adv_1098005_022",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這麼說起來，",
    "voice": "vo_adv_1098005_023",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "可可蘿好像有給他一個包袱。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "只是，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "還真大呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "到底在裡面塞了多少小菜。",
    "voice": "vo_adv_1098005_024",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "可可蘿的過度保護真是讓人傷腦筋。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "喂喂，",
    "voice": "vo_adv_1098005_025",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "小哥。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n這裡是我們的位子。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你擋到我們了。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "嗯嗯？",
    "voice": "vo_adv_1098005_026",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "你這東西不錯哦。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n雙層的愛情便當是嗎？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "不僅搶了別人的位子還拿便當出來炫耀，你膽子可真不小啊！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "我才不管你什麼意思呢。",
    "voice": "vo_adv_1098005_027",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "交出來！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "我幫你吃掉。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "看起來就是群沒品的傢伙。",
    "voice": "vo_adv_1098005_028",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不過，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這或許剛好能治治那個男人。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "而且，",
    "voice": "vo_adv_1098005_029",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "在這種情況下應該會露出本性才對。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "來吧──",
    "voice": "vo_adv_1098005_030",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "讓拉姆看看你背地裡骯髒的一面。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "想要的話就來搶回去啊！",
    "voice": "vo_adv_1098005_031",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒們",
    "words": "喂，",
    "voice": "vo_adv_1098005_032",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "暴徒們",
    "words": "你為什麼一動也不動！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "他為什麼呆站在那裡。",
    "voice": "vo_adv_1098005_033",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "難道說是在等對方徹底鬆懈嗎……？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "嗚哇！",
    "voice": "vo_adv_1098005_034",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n這傢伙，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "居然搶回去了！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "以那男人來說搶得還算強硬呢。",
    "voice": "vo_adv_1098005_035",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……為什麼他附上了吃便當用的餐具跟茶飲，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n然後又把便當交還給對方了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "你說雖然是很重要的便當，",
    "voice": "vo_adv_1098005_036",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "但如果有人需要幫助，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n就應該分給對方？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "請我們好好享用……？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你是認真的嗎？",
    "voice": "vo_adv_1098005_037",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你、",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你這傢伙真的是……！！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098005_038",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "……",
    "voice": "vo_adv_1098005_039",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "我心服口服了……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "難怪會有人願意作愛情便當給你。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n很抱歉，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "這個還給你。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "……咦？",
    "voice": "vo_adv_1098005_040",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "你說你沒關係",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "要我們吃",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "就好。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n不行不行！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "那不然至少，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "我們一起吃吧！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你願意跟我們一起吃！？",
    "voice": "vo_adv_1098005_041",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "太好了──！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "那就來交換小菜吧。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "嘿嘿嘿。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n你啊～",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "雖然看起來很軟弱，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "但沒想到是個大好人呢！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "咦？",
    "voice": "vo_adv_1098005_042",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "你說還有其他好人？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n……例如朋友的",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "拉姆？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "拉姆，她人真的那麼好嗎。",
    "voice": "vo_adv_1098005_043",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你都這樣說了那肯定是很好。",
    "voice": "vo_adv_1098005_044",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "是嗎，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "拉姆也是個好人。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "到底都在胡說些什麼。",
    "voice": "vo_adv_1098005_045",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆什麼時候變成那個男人的朋友了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "大哥哥大哥哥。",
    "voice": "vo_adv_1098005_046",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "啊，",
    "voice": "vo_adv_1098005_047",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "等一下！",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……看來把小孩子帶來是拉姆的失策。",
    "voice": "vo_adv_1098005_048",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "玩具修理，",
    "voice": "vo_adv_1098005_049",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n還要很久嗎？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……玩具的，",
    "voice": "vo_adv_1098005_050",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "修理？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "……嗯，",
    "voice": "vo_adv_1098005_051",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我等你。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "大哥哥，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "加油！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "唉……",
    "voice": "vo_adv_1098005_052",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "原來是這樣。",
    "voice": "vo_adv_1098005_053",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n並不是把玩具從小孩子手中搶走，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n而是為了修理而暫時拿過來而已。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "喂，",
    "voice": "vo_adv_1098005_054",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "小哥～",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n你跟我們的共享小菜午餐呢？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "然後是，",
    "voice": "vo_adv_1098005_055",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "對過來找麻煩的對象分享自己的便當……",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "…………",
    "voice": "vo_adv_1098005_056",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "哈！",
    "voice": "vo_adv_1098005_057",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n也就是說真的只是個重度的濫好人而已嗎。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆居然追尋著不存在的另一面，",
    "voice": "vo_adv_1098005_058",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真是浪費時間。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "小弟弟，",
    "voice": "vo_adv_1098005_059",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "這位小哥啊，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "現在正要跟我們一起吃午餐呢。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你先讓他，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "把便當吃完吧，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "咦～",
    "voice": "vo_adv_1098005_060",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "不要。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "因為是我先來的啊。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "暴徒們",
    "words": "唔唔……",
    "voice": "vo_adv_1098005_061",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "唔唔……",
    "voice": "vo_adv_1098005_062",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真是愚蠢。",
    "voice": "vo_adv_1098005_063",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雷姆應該差不多快回來了，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n趕快回家來喝個茶──",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "──那個是。",
    "voice": "vo_adv_1098005_064",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀，",
    "voice": "vo_adv_1098005_065",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "居然在這種地方呢！",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不可以因為是遠足，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就擅自",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "跑出來",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哦？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大家都很擔心，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "快點回來吧。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "美里老師。",
    "voice": "vo_adv_1098005_066",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "被老師找到了……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "但是，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我還不能回去。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "因為大哥哥有說要把我的玩具修好。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_1098005_067",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是這樣嗎。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "但是",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "像這樣偷跑出來可不行哦……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "現在是大家吃便當的時間。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "對了，",
    "voice": "vo_adv_1098005_068",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不如你也一起來如何啊？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我們正在附近的廣場",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "野餐。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "如果你願意來的話",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大家一定很開心♪",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "等等等等！",
    "voice": "vo_adv_1098005_069",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n這傢伙，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "現在是要跟我們──",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這不是{0}嗎。",
    "voice": "vo_adv_1098005_070",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "遇見你正好。",
    "voice": "vo_adv_1098005_071",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我雖然久違地來到街上買東西，",
    "voice": "vo_adv_1098005_072",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但卻因為人太多而跟真軌走散了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你能幫我找一下真軌，",
    "voice": "vo_adv_1098005_073",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "然後把他帶過來嗎。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "對了，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是在鬧區那裡。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "如果是平時我會不管他直接回去，",
    "voice": "vo_adv_1098005_074",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n但是因為今天行李都在真軌那裡。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這個男人的身邊",
    "voice": "vo_adv_1098005_075",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "為何總是會不斷地有人聚集過來。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "為什麼，",
    "voice": "vo_adv_1098005_076",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "無論是誰都能解決的問題，卻要刻意拜託這個男人呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真是無法理解。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "咦咦咦～",
    "voice": "vo_adv_1098005_077",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n先修玩具啦～",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "所以說",
    "voice": "vo_adv_1098005_078",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "要先跟我們一起吃午餐！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……原來如此。",
    "voice": "vo_adv_1098005_079",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n是這樣的情況嗎。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "吶～大哥哥，",
    "voice": "vo_adv_1098005_080",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "你要選誰？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "你最喜歡的是誰～？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "說清楚啊。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不、",
    "voice": "vo_adv_1098005_081",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不行不行。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不可以這麼讓人困擾喔。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "呵呵呵，",
    "voice": "vo_adv_1098005_082",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這問題很直接很好啊。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "他會給出什麼回答，",
    "voice": "vo_adv_1098005_083",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我其實還滿感興趣的。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀，",
    "voice": "vo_adv_1098005_084",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "似似花妳真是的……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "畢竟都對我們那麼溫柔了。",
    "voice": "vo_adv_1098005_085",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n當然是最喜歡",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "我們的對吧？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "是我對吧？",
    "voice": "vo_adv_1098005_086",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "大哥哥。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "到底是如何呢。",
    "voice": "vo_adv_1098005_087",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "到、",
    "voice": "vo_adv_1098005_088",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "到底怎麼樣呢……！",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "看樣子身陷險境呢。",
    "voice": "vo_adv_1098005_089",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "誰叫他不管對誰都那麼好。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "就這樣被逼上絕路吧。",
    "voice": "vo_adv_1098005_090",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "反正這不關拉姆的事。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "濫好人的末路還真是悲哀。",
    "voice": "vo_adv_1098005_091",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n把這件事當作教訓從今以後──",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "────！",
    "voice": "vo_adv_1098005_092",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "美里、小孩",
    "words": "大家……",
    "voice": "vo_adv_1098005_093",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "暴徒們",
    "words": "…………都喜歡？",
    "voice": "vo_adv_1098005_094",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "呵。",
    "voice": "vo_adv_1098005_095",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "討厭啦，",
    "voice": "vo_adv_1098005_096",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這樣",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "讓老師好害羞……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "小孩、流氓們",
    "words": "「嘿嘿嘿～」\\n「嘿嘿嘿～」",
    "voice": "vo_adv_1098005_097",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "既然你都這樣說了，",
    "voice": "vo_adv_1098005_098",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那麼，大家就",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "先來",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "一起吃便當吧！",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n在那之後再修理玩具。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "好嗎，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "還有似似花小姐也是。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是沒辦法。",
    "voice": "vo_adv_1098005_099",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "等你吃完後",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真軌就拜託你了哦。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "小孩、流氓們",
    "words": "耶──！",
    "voice": "vo_adv_1098005_100",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……居然全都喜歡，",
    "voice": "vo_adv_1098005_101",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真是下流。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "本來還以為他表裡如一，",
    "voice": "vo_adv_1098005_102",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n但看來有必要修正一下對他的評價了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真是個花心大蘿蔔。",
    "voice": "vo_adv_1098005_103",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "而且，",
    "voice": "vo_adv_1098005_104",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "還是跟巴魯斯不同類型的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雖然兩邊都差不多就是了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這個男人，",
    "voice": "vo_adv_1098005_105",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "看樣子還是先不要完全信任他比較好。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "為了以防萬一，",
    "voice": "vo_adv_1098005_106",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "暫時先不解除警戒。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "──拉姆的眼睛，",
    "voice": "vo_adv_1098005_107",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "可不會這樣被蒙混過去。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}不但沒發現拉姆的視線，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n還被大家一邊擠來擠去，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一邊享用著便當。",
    "voice": null,
    "unit_id": null
  }
]
