[
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "手裡拿著神祕書本、來到王宮正門前的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哎呀，",
    "voice": "vo_adv_9002003_000",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我聽說了唷，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "配送辛苦了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這本書就是那個……",
    "voice": "vo_adv_9002003_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，沒事，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是我這邊的事啦，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不要在意。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那麼接下來，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就把它交給他們兩個吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n小智！茉莉！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "麻煩妳們了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "了解是也！",
    "voice": "vo_adv_9002003_002",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "用跑的會跌倒啦，",
    "voice": "vo_adv_9002003_003",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "茉莉。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在她們回來之前，",
    "voice": "vo_adv_9002003_004",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "稍微聊一下吧？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在這個王宮的正門前，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "與和你度過的那天一樣呢……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你還記得嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我沒發現你迷了路，",
    "voice": "vo_adv_9002003_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "一個人一直喋喋不休，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n還一起拍了照片。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "still",
    "still_id": "300200301"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也有在王宮中",
    "voice": "vo_adv_9002003_006",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "被小克莉絲捉弄過呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n頭盔被你拿走過……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n現在回想起來",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還是覺得很丟臉啊……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，",
    "voice": "vo_adv_9002003_007",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這些全都是所謂的「回憶」呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n是你",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "與我們之間的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "和你",
    "voice": "vo_adv_9002003_008",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "已經相處很久了呢……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這個事實，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "讓我覺得很幸福唷，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "打從心底的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "純。",
    "voice": "vo_adv_9002003_009",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我和小智姐一起",
    "voice": "vo_adv_9002003_010",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "回來了是也──！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "謝謝妳們兩個。",
    "voice": "vo_adv_9002003_011",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "書本還給你。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "另外，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這是下一個配送地點。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那麼",
    "voice": "vo_adv_9002003_012",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "路上注意安全。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n還有，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "今後也多多指教，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "下次再見了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在【王宮騎士團】諸位成員的目送下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}出發前往下一個配送地點。",
    "voice": null,
    "unit_id": null
  }
]
