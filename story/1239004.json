  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n和「祕密」有點像呢，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我想你應該明白吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "想要保密的原因……",
    "voice": "vo_adv_1239004_069",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不同情境有不同可能。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "至少我敢肯定一件事。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就是啊，",
    "voice": "vo_adv_1239004_070",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果不相信對方，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n是不會坦承自己的",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "祕密的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "茉莉是願意對你坦白祕密的喔，",
    "voice": "vo_adv_1239004_071",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不想被任何人知道的祕密，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n她卻願意讓你知道。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不管內容是什麼，",
    "voice": "vo_adv_1239004_072",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "祕密就是祕密，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n重點在於茉莉的勇氣與決心，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不要忘了這件事。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗯、",
    "voice": "vo_adv_1239004_073",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗯嗯嗯……",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哇啊！？",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n奇怪？",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我不知不覺",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "睡著了！",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "難道說",
    "voice": "vo_adv_1239004_074",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你也是嗎？",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n之前好像發生過類似的事。",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我每次都會嚇到……",
    "voice": "vo_adv_1239004_075",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過我做了一場美夢，",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "所以算了！",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "睡醒之後也很舒服！",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好了！",
    "voice": "vo_adv_1239004_076",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n那",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我們換個心情",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "去吃飯吧！",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "其實今天",
    "voice": "vo_adv_1239004_077",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "媽媽為我準備了好吃的大餐♪",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "說是要慶祝",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "事件解決了！",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "所以",
    "voice": "vo_adv_1239004_078",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "如果你沒事的話，",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n非常希望你一起來……",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你可以嗎？",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好耶！",
    "voice": "vo_adv_1239004_079",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我就知道你會說好！",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我們動作快吧！",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "美食在等著我們了！",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "茉莉和{0}感情融洽地手牽手跑了出去，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他們的新戰役才剛拉開序幕而已。",
    "voice": null,
    "unit_id": null
  }
]
