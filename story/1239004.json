  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這位先生，",
    "voice": "vo_adv_1239004_024",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "謝謝！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "攔得好……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是說",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你不是大哥嗎！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n沒想到會在這裡見到你！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "對了……",
    "voice": "vo_adv_1239004_025",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你看到那張",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "考卷了吧……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你這反應",
    "voice": "vo_adv_1239004_026",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就是完全看透透了啊！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "竟然被大哥看到我這麼丟臉的分數……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "太大意了！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "織原茉莉，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "一失足成千古恨～！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗚啊！",
    "voice": "vo_adv_1239004_027",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你用直率的眼神鼓勵我反而令我心痛……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗚嗚嗚……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "算了，",
    "voice": "vo_adv_1239004_028",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "無論如何幸好",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "找到考卷的是大哥，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n這是不幸中的大幸吧。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "被陌生人看到太可恥了……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "而且……",
    "voice": "vo_adv_1239004_029",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "萬一啊，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "萬一",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "奇蹟發生，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "撿到的是我媽……！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我肯定會被痛罵一頓！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊，",
    "voice": "vo_adv_1239004_030",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我看你的表情，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是不是在問我……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "「回家之後不是會給媽媽看成績嗎」？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "唉呀──是沒錯啦～？",
    "voice": "vo_adv_1239004_031",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n不過我媽",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不知道有考試啊，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這是場突襲考試。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "所以",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "只要不說，她就不會知道吧……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我在想。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "所以啊，",
    "voice": "vo_adv_1239004_032",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大哥！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n這次的考試，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "希望你為我保密！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n拜託你～！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這世界上",
    "voice": "vo_adv_1239004_033",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "有些事還是保密比較好！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "呃──",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "比如說……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "英雄的身分之類的！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "對吧？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "講到英雄就會想到祕密！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "英雄都有祕密呢～！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "唔",
    "voice": "vo_adv_1239004_034",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "唔！？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n確、",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "確實感覺不太一樣……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n同樣是祕密",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "卻天差地別……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是差在哪裡呢？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "──大哥……！！",
    "voice": "vo_adv_1239004_035",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "沒錯……",
    "voice": "vo_adv_1239004_036",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就是這個！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n英雄隱瞞自己的身分，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是為了避免",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "壞人傷害到自己身邊的人！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "可是",
    "voice": "vo_adv_1239004_037",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我卻只是……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "怕被罵就想要保密。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我保護的是自己，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n跟想要保護他人的英雄正好相反！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我竟然沒注意這個差別，",
    "voice": "vo_adv_1239004_038",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "太丟臉了……！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "看來我還不夠",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "成熟呢。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過",
    "voice": "vo_adv_1239004_039",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "幸好大哥提醒，我已經清醒了！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我會",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "正大光明",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "給媽媽看我的考卷！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n大哥，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你在這裡等我一下！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "唔喔喔喔喔！！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾十分鐘後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n跑走的茉莉再度回到{0}身邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我被罵了！",
    "voice": "vo_adv_1239004_040",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "果不其然！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "唉呀，",
    "voice": "vo_adv_1239004_041",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過心情很暢快！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n雖然媽媽很兇，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但是我跟她約定我下次會加油了！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n然後",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "她也為我加油打氣！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "即便英雄在",
    "voice": "vo_adv_1239004_042",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "上半局被敵人的祕密武器逼到絕境，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也會在下半局絕地反攻！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "雖然分前後篇類的故事就不一定了！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "總之",
    "voice": "vo_adv_1239004_043",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我會用功準備下一次考試！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
