  {
    "type": "dialogue",
    "name": "旁白",
    "words": "――兩人依然在聖誕季的鎮上逛著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n雖然度過了一段快樂的時光，但隨著夜越來越深，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n伊莉亞不知為何有些焦躁。",
