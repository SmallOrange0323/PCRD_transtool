    "name": "步未",
    "words": "……說的也是，",
    "voice": "vo_adv_1130001_060",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n讓她們參加茶會放鬆一下，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "或許可以",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "達到支援的成效呢……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "可、",
    "voice": "vo_adv_1130001_061",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "可是，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "像我這樣的人辦的茶會，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n璃乃她們也",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不曉得會不會中意……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "{0}前輩……",
    "voice": "vo_adv_1130001_062",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我、",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我明白了！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n我",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "要辦茶會！！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "為了多少幫上大家的忙，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我也要好好假柚！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──因為想成為大家的助力，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n步未下定決心要舉辦茶會，用自己的方式支援大家。",
