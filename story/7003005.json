  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈啊……",
    "voice": "vo_adv_7003005_000",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈啊……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不行了，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的不行了～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "鈴奈，辛苦了。",
    "voice": "vo_adv_7003005_001",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也到極限了……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "能擊倒魔物真是太好了。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}也是，\\n謝謝你為我們兩個進行了強化……",
    "voice": "vo_adv_7003005_002",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "欸，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？　",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "掉落在那邊的東西難道就是――",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哇！？　",
    "voice": "vo_adv_7003005_003",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "欸，還突然散發出了光芒！？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "什麼什麼這是什麼啊？　",
    "voice": "vo_adv_7003005_004",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這可真是不得了欸！！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈・望",
    "words": "呀啊啊啊！？",
    "voice": "vo_adv_7003005_005",
    "unit_id": 102911
  },
  {
    "type": "background",
    "bg_id": "510070"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一、二、三、四――",
    "voice": "vo_adv_7003005_006",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "一、二、三……",
    "voice": "vo_adv_7003005_007",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我又跳錯了……",
    "voice": "vo_adv_7003005_008",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "舞蹈真的挺難的呢……",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "望望，",
    "voice": "vo_adv_7003005_009",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "抱歉扯了後腿。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "在表演當天，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還找你陪我練習。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可能太小看舞蹈了……",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "聽到望望說，",
    "voice": "vo_adv_7003005_010",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "要在椿丘時裝發表會上\\n辦一場合作表演時，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我還興奮的不得了――",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "在那之後和秀才聊過，",
    "voice": "vo_adv_7003005_011",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "才得知他和望望有認識，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n那應該也能來個私下練習吧",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n覺得應該會挺輕鬆的，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "現在覺得好痛苦……",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你別這麼想，",
    "voice": "vo_adv_7003005_012",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "鈴奈。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "鈴奈並沒有小看舞蹈啊，",
    "voice": "vo_adv_7003005_013",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "覺得你這樣和我一起練習其實非常厲害了哦？",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "腳步姿態那麼優雅，",
    "voice": "vo_adv_7003005_014",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "視線的投放又很拿手，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "其實刺激了我不少呢。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的嗎！？　",
    "voice": "vo_adv_7003005_015",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "謝謝你——！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "望望真的是天使～！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才介紹我認識你的時候還以為是天使降臨，",
    "voice": "vo_adv_7003005_016",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "現在見鬼了你真的就是天使啊！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖、",
    "voice": "vo_adv_7003005_017",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然我不知道你這是在說鬼還是天使……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "總之，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "進行最後衝刺了哦！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也為了陪我們一起練習的{0}，",
    "voice": "vo_adv_7003005_018",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這場表演，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們一定要讓它成功！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "喔～♪",
    "voice": "vo_adv_7003005_019",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈啊，",
    "voice": "vo_adv_7003005_020",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈啊。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗚嗚嗚～",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "動作怎麼也對不上……",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "為什麼～？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "一把注意力放進編舞中，",
    "voice": "vo_adv_7003005_021",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n動作就開始有點不合拍了……",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "馬上就是要進入會場的時間了，",
    "voice": "vo_adv_7003005_022",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "該怎麼辦才好……",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "…………",
    "voice": "vo_adv_7003005_023",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "鈴奈。",
    "voice": "vo_adv_7003005_024",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我有一個提案……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n編舞，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "幫你改的簡單一點如何？",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？",
    "voice": "vo_adv_7003005_025",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "編舞弄得簡單一點，",
    "voice": "vo_adv_7003005_026",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我認為就能讓你更好合拍了。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我會和舞台人員講好的――",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……我不要。",
    "voice": "vo_adv_7003005_027",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "鈴奈？",
    "voice": "vo_adv_7003005_028",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "望望，",
    "voice": "vo_adv_7003005_029",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我絕不要這樣。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我會好好加油的，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們就按照這個編舞來跳吧？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "為了這份工作，",
    "voice": "vo_adv_7003005_030",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還有編舞老師，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n以及為我們製作服裝的設計師還有工匠也是，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n大家都是拼了命為我們而努力的。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就我一個人在偷懶，",
    "voice": "vo_adv_7003005_031",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "說不過去吧。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我好歹，",
    "voice": "vo_adv_7003005_032",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "也是時尚模特兒啊。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "為舞台表演找理由，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "也太遜了。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "欸……",
    "voice": "vo_adv_7003005_033",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對不起，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "明明在扯後腿的人是我，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還一副自以為是地說這些話。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……不不，",
    "voice": "vo_adv_7003005_034",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒有那回事喔。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
