  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "不！",
    "voice": "vo_adv_5036001_001",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "才不是「小花苞」啊！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n對吧，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "澀凜凜！　",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "島村村！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "嗯！",
    "voice": "vo_adv_5036001_002",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "該不會是！",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "「盆栽小花」！？！？",
    "voice": "vo_adv_5036001_003",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500390"
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "——卯月、",
    "voice": "vo_adv_5036001_004",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "未央，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "加上我，凜。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n我們三人組成了一個公會，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "【new generations】。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "原本身為冒險者的我們，",
    "voice": "vo_adv_5036001_005",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n有一天，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "得知了何謂偶像……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "於是",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "就下定了決心，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "「我們也來當偶像吧！」",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "接著在【美食殿堂】的大家，",
    "voice": "vo_adv_5036001_006",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n還有綠色的醜……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "皮喵太的協助下，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我們",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "決定要去參加新人偶像的甄選大會了！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "still",
    "still_id": "503600101"
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "一路上不斷練習，",
    "voice": "vo_adv_5036001_007",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "還舉辦了快閃演唱會。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n雖然為了要當上偶像所經歷的那些時間",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n非常的辛苦……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "嗯，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "但似乎比想像中的還要有趣。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "不過……",
    "voice": "vo_adv_5036001_008",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "越是努力想去成為偶像。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n我們就",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "越是覺得哪裡怪怪的……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "感覺，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n有某種異樣感徘徊在心裡。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500930"
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "然後，",
    "voice": "vo_adv_5036001_009",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "在正式甄選會上，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n我們唱出了那首明明沒聽過卻唱得出來的歌。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "原本還只是依稀覺得奇怪，",
    "voice": "vo_adv_5036001_010",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "這時就更加確信了。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我們果然",
    "voice": "vo_adv_5036001_011",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n忘記了什麼非常重要的事情……！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "background",
    "bg_id": "500930"
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "「盆栽小花」！？！？",
    "voice": "vo_adv_5036001_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "哇啊啊～～！？",
    "voice": "vo_adv_5036001_013",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凱留",
