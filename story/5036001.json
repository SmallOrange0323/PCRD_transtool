    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n在我詠唱完咒語之前，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好好保護我！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好喔，小凱……",
    "voice": "vo_adv_5036001_033",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哈啾！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐？",
    "voice": "vo_adv_5036001_034",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n您在哪兒呢，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "窸窸窣窣窸窸窣窣……！",
    "voice": null,
    "unit_id": 12911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？",
    "voice": "vo_adv_5036001_035",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……哇呀啊啊啊！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留！？",
    "voice": "vo_adv_5036001_036",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "凱──哈啾──！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "之後，",
    "voice": "vo_adv_5036001_037",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我們在花粉的濃霧之中……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "奮戰了許久，",
    "voice": "vo_adv_5036001_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "終於讓小鎮的人們得以逃脫。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "但是無論怎麼找，",
    "voice": "vo_adv_5036001_039",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "都找不到凱留……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500920"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "離了這麼遠的話，",
    "voice": "vo_adv_5036001_040",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n暫時應該就安全了才對……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "有、",
    "voice": "vo_adv_5036001_041",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "有誰！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n有誰有看到我的搭檔嗎！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "那些球根小傢伙……！",
    "voice": "vo_adv_5036001_042",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "\\n竟然把偶像小花苞們，全都抓走了！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "怎麼會發生這種事呀！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "現在失去行蹤的，",
    "voice": "vo_adv_5036001_043",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n好像不只凱留凱留一個人而已的樣子！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個",
    "voice": "vo_adv_5036001_044",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "長著臉的球根魔物",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "抓著人類，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n將她們帶到巨大化的「小花苞」裡了——",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n目擊者",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是這麼描述的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "怎麼會這樣！",
    "voice": "vo_adv_5036001_045",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n那不就表示……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "凱留\\n也被「盆栽小花」給抓走了嗎！？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「盆栽小花」……",
    "voice": "vo_adv_5036001_046",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個……",
    "voice": "vo_adv_5036001_047",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有件事我很在意，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n為什麼妳們幾位，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n會知道那隻魔物的名字呢？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這個嘛……",
    "voice": "vo_adv_5036001_048",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我也還搞不清楚的時候，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這個名字就直接衝出口了。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n就和我很自然地就喊出",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "澀凜凜、島村村的感覺一樣。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我也一樣。",
    "voice": "vo_adv_5036001_049",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n總覺得，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "有一種令人懷念的感覺……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "嗯……",
    "voice": "vo_adv_5036001_050",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n明明感覺",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "就快想起很多事了。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "只要有什麼契機的話說不定……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "啊，",
    "voice": "vo_adv_5036001_051",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "那個……！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n我剛剛，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "有稍微瞄到了一點。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我想那個或許",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "能夠成為想起來的契機也說不定……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳看到了什麼東西呢？",
    "voice": "vo_adv_5036001_052",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n卯月。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "雖然妳們可能無法相信，",
    "voice": "vo_adv_5036001_053",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "但是在花粉濃霧的另一邊……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "在盆栽小花的根部，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n有著和這個地方不一樣，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "另外一個世界的景色。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "雖然只有稍微瞄到一眼，",
    "voice": "vo_adv_5036001_054",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "但是，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我卻有一種非常非常懷念的感覺。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "然後……",
    "voice": "vo_adv_5036001_055",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我想到了。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n會不會那一邊是……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我們現在雖然忘掉了，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n但其實是我們原本生活的世界呢。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "不一樣的世界……",
    "voice": "vo_adv_5036001_056",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "原本生活的世界……",
    "voice": "vo_adv_5036001_057",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果真的是這樣，",
    "voice": "vo_adv_5036001_058",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那會讓人很驚訝呢！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……話說回來",
    "voice": "vo_adv_5036001_059",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……我們之前，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n是不是也有遇過",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n從其他世界到這裡來的人呀？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　小可蘿？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔呣……",
    "voice": "vo_adv_5036001_060",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "確實，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎是有過類似的事情。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "倘若如此……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "【new generations】的各位。",
    "voice": "vo_adv_5036001_061",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n儘管仍是推測，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "然而此事可能性",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎不低。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "為什麼啊？",
    "voice": "vo_adv_5036001_062",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n可蘿可蘿。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "若如方才那位擔任評審的婦人所言，",
    "voice": "vo_adv_5036001_063",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n「小花苞」似乎從許久以前",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就存在於這個小鎮。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "的確，那位婆婆她，",
    "voice": "vo_adv_5036001_064",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n有說過這樣的話……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這樣的「小花苞」，",
    "voice": "vo_adv_5036001_065",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n為什麼會突然",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "成長成為「盆栽小花」呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "或許……",
    "voice": "vo_adv_5036001_066",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是因為聽見了各位的歌聲也說不定。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這是在下的臆測。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "咦咦咦～？",
    "voice": "vo_adv_5036001_067",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n是我們害的嗎！？",
    "voice": null,
