    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "哈啾！",
    "voice": "vo_adv_5036001_016",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n總覺得噴嚏停不下來……！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "這個……",
    "voice": "vo_adv_5036001_017",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "難不成是",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "花粉嗎！？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "就算用布蓋住口鼻，",
    "voice": "vo_adv_5036001_018",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "還是會滲透進來呀……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "哈啾！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "……咦？",
    "voice": "vo_adv_5036001_019",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n遠處的",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "盆栽小花的根部……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n好像有點奇怪，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "就只有那邊……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "景色和周遭",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "不一樣……？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "……噫啊！？",
    "voice": "vo_adv_5036001_020",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "卯月小姐，",
    "voice": "vo_adv_5036001_021",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請您小心！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "花粉濃霧對面，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎潛伏著什麼……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哈啾！",
    "voice": "vo_adv_5036001_022",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這次又是什麼啦──！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "窸窸窣窣……窸窸窣窣……",
    "voice": null,
    "unit_id": 12911
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那個是……",
    "voice": "vo_adv_5036001_023",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "好大的球根！？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "而且，",
    "voice": "vo_adv_5036001_024",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "數量還非常多……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "哈啾！",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "新人偶像1",
    "words": "這、",
    "voice": "vo_adv_5036001_025",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "新人偶像1",
    "words": "這些東西到底是什麼！？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "新人偶像2",
    "words": "呀啊啊！？",
    "voice": "vo_adv_5036001_026",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "新人偶像2",
    "words": "\\n不要碰我，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "新人偶像2",
    "words": "誰來救救我呀──！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "到處都傳來了慘叫聲！",
    "voice": "vo_adv_5036001_027",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哈啾！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "小鎮裡的人們",
    "voice": "vo_adv_5036001_028",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "被襲擊了嗎！？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "可是……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "哈啾！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "視野這麼差的話……",
    "voice": "vo_adv_5036001_029",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n在哪裡有誰被襲擊了，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "根本看不到啊！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "一隻一隻分開看雖然很弱……",
    "voice": "vo_adv_5036001_030",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "哈啾！",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "但再這樣下去，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "大家就危險了！",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哈啾！　",
    "voice": "vo_adv_5036001_031",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊啊真是夠了！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n既然如此……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我就使出全力，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n用攻擊魔法把那個「盆栽小花」連同這些花粉一起轟飛！",
