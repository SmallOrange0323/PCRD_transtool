    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才怪！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "最好是這樣！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那個海中之王",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "到底送了什麼鬼東西啊！",
