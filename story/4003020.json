[
  {
    "type": "background",
    "bg_id": "501970"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "煩死了，",
    "voice": "vo_adv_4003020_000",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "快點倒下啦！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這個大塊頭大叔，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "到底是想打多久啊～！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "！",
    "voice": "vo_adv_4003020_001",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱、",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請等一下。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n對方",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好像……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這、",
    "voice": "vo_adv_4003020_002",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這是在拍手",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "吧？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n該不會",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是在誇獎我們？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "感覺有點不好意思呢～",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊？",
    "voice": "vo_adv_4003020_003",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "搞什麼嘛，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "現在才說這個……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就算你這樣講，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在把你大卸八塊以前，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我可沒有停手的打算──",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯，",
    "voice": "vo_adv_4003020_004",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "精靈們代為傳達說……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「此番戰鬥",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "妳們表現相當精彩，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我要給妳們獎賞。」",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……海中之王是這麼說的。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "──我改變主意了，",
    "voice": "vo_adv_4003020_005",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好，就聽聽他想說什麼吧。",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n既然要送我們東西，",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那倒是能勉為其難地收下。",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐",
    "voice": "vo_adv_4003020_006",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嘴巴上雖然這麼說，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n但尾巴卻很開心似地搖個不停，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是可愛……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳妳妳、",
    "voice": "vo_adv_4003020_007",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳很煩耶！",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這樣搖是想讓對手大意！",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是我",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "故意的！",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也、",
    "voice": "vo_adv_4003020_008",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也就是說接下來是",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "領獎時間嗎！？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "──國王陛下！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "想要吃海鮮吃到飽！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n如果要給我們獎賞，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請務必送我們食物！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喂、",
    "voice": "vo_adv_4003020_009",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喂！",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "白癡佩可，",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳在講什麼啦！",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳要吃的我再抓給妳，",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "現在先選財寶──",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "選財寶又不能拿來吃！",
    "voice": "vo_adv_4003020_010",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "經過剛剛的惡鬥，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我肚子已經餓扁了……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而且",
    "voice": "vo_adv_4003020_011",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "克蕾琪塔小姐有說過，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n財產贈與要辦很多手續，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "吃東西只要撥預算就好了！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然我不太清楚是什麼意思，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但總之好像比較划算！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的，",
    "voice": "vo_adv_4003020_012",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "讓人很難反駁！",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳腦袋到底是好還是不好啦！",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "兩、",
    "voice": "vo_adv_4003020_013",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "兩位，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在妳們爭論的時候……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n已經由在下",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "收下獎賞了……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是食物嗎！？",
    "voice": "vo_adv_4003020_014",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是財寶吧！？",
    "voice": "vo_adv_4003020_015",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不，",
    "voice": "vo_adv_4003020_016",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好像是個有裝飾的……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "小盒子。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "上頭的裝飾相當別緻。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯～",
    "voice": "vo_adv_4003020_017",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看它的大小，",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "應該不是什麼金銀財寶吧。",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n而且不管是它的外觀，",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還是贈與者，",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都讓人有不好的預感……",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不、",
    "voice": "vo_adv_4003020_018",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不是吃的嗎……？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不對，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "食物還有可能放在裡面……！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "快打開看看吧！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等、",
    "voice": "vo_adv_4003020_019",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等一下！",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "絕對不准打開！",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這種故事我在書上看過……",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要是打開了，",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "通常都不會有好下場！",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎、",
    "voice": "vo_adv_4003020_020",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎麼這樣……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n偷偷看一下裡面也不行嗎？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n只是確認一下裡面是不是吃的而已……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別再想吃的了啦！",
    "voice": "vo_adv_4003020_021",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳要是變成慢吞吞的老太婆我可不管喔！",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好了好了，",
    "voice": "vo_adv_4003020_022",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "妳們兩位……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n難得海中之王陛下親自贈送了獎賞，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下們就心懷感激地收下，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "先在此告辭吧。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "精靈們",
    "voice": "vo_adv_4003020_023",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好心地告訴了在下，",
