  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "比起長鰭，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n長腳會比較方便吧？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可以說是生命的奧妙。",
    "voice": null,
    "unit_id": 105913
  },
