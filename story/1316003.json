  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "只差一點就打到了呀……！",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "實、",
    "voice": "vo_adv_1316003_089",
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "實在是不太順利呢……？",
    "voice": null,
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "\\n明明大姐姐都用好像要打爆西瓜的感覺去打了。",
    "voice": null,
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "是叫做氣場嗎？",
    "voice": "vo_adv_1316003_090",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "\\n那個",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "倒是很驚人呢？",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "嗯……",
    "voice": "vo_adv_1316003_091",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "好像也有一點弱耶。",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "\\n該說是手和腳靠得太近了嗎……",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "啊，",
    "voice": "vo_adv_1316003_092",
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "這個我知道！",
    "voice": null,
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "\\n",
    "voice": null,
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "就是",
    "voice": null,
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "「熊突腰」！",
    "voice": null,
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "熊、",
    "voice": "vo_adv_1316003_093",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "熊突",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "腰……？",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……我該不會。",
    "voice": "vo_adv_1316003_094",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n沒有當劍士的資質吧……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "兄長大人……",
    "voice": "vo_adv_1316003_095",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "好的。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……沒錯。",
    "voice": "vo_adv_1316003_096",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n就算我沒有劍術方面的天賦。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n這也不是",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "讓大家吃不成西瓜的理由……！　",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……我要嘗試",
    "voice": "vo_adv_1316003_097",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "再挑戰一次。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "這次我一定要和大家一起吃到西瓜……！",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n莉莉重新下定決心，再次挑戰了打西瓜。",
    "voice": null,
    "unit_id": null
  }
]
