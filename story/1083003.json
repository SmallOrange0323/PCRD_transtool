[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "萬聖節的早上，有人來敲了美咲家的大門。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "來了～",
    "voice": "vo_adv_1083003_000",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是誰啊～？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――吼歐歐歐歐歐！",
    "voice": "vo_adv_1083003_001",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呀啊啊啊啊啊！",
    "voice": "vo_adv_1083003_002",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "為、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "為什麼會有魔物來我家……！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不要靠近我！　",
    "voice": "vo_adv_1083003_003",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "快給我滾開～！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "打倒了……？　",
    "voice": "vo_adv_1083003_004",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "太好了太好了――！　",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我一個人打倒魔物了！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我要去跟班上的男生炫耀……",
    "voice": "vo_adv_1083003_005",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "魔物說話了！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "噫！　",
    "voice": "vo_adv_1083003_006",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "果、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "果然",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "光憑小孩子的力量……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可是，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "要是不在這裡打倒牠，那媽媽他們就……！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……嗯？　",
    "voice": "vo_adv_1083003_007",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "牠剛才",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是不是說話了？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……啊啊啊啊啊！",
    "voice": "vo_adv_1083003_008",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你是{0}吧！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "想瞞混過去也沒用唷！",
    "voice": "vo_adv_1083003_009",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n這套衣服，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不就是之前我們去服飾店我幫你選的那套嗎！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "一大早的，你跑來做什麼啦！",
    "voice": "vo_adv_1083003_010",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嚇死我了……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不對，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我只是稍微被嚇到而已！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你說這是萬聖節的搗蛋？",
    "voice": "vo_adv_1083003_011",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是笨蛋呢……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "萬聖節是要問，要給糖，還是搗蛋選一種啦！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "沒拿到糖果才能夠搗蛋！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是說，",
    "voice": "vo_adv_1083003_012",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你就為了做這種事情還特地早起嗎？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……唉，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你還真像是個小孩子。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過，",
    "voice": "vo_adv_1083003_013",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "偶爾像這樣陪小孩子玩",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "也是一個成熟淑女該做的事情。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "美咲，早安啊～！",
    "voice": "vo_adv_1083003_014",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊，早安。",
    "voice": "vo_adv_1083003_015",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我們接下來",
    "voice": "vo_adv_1083003_016",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n要去學院借教室舉辦萬聖節派對～",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "哦，",
    "voice": "vo_adv_1083003_017",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "在學院開派對啊！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "　",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那不是很棒嗎！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "伊緒老師說我們可以開派對沒問題的～",
    "voice": "vo_adv_1083003_018",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "所以",
    "voice": "vo_adv_1083003_019",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "才想說來約美咲一起去！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "一起去玩吧！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "派對……",
    "voice": "vo_adv_1083003_020",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "對呢，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那我也……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "約她也沒用啦！",
    "voice": "vo_adv_1083003_021",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n美咲才不會來參加這種小孩子氣的派對呢～",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "什麼！？　",
    "voice": "vo_adv_1083003_022",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "為、為什麼突然這麼說！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "因為嘛，",
    "voice": "vo_adv_1083003_023",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "每次我們在玩，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n她不是都會笑我們說簡直就跟小孩子一樣嗎！？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "什……",
    "voice": "vo_adv_1083003_024",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就是這樣！　",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你們真的就是小孩子啊！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我才不會跟你們一樣隨便就玩開了！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那種孩子氣的派對，我才不去呢！",
    "voice": "vo_adv_1083003_025",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "可是，",
    "voice": "vo_adv_1083003_026",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我覺得美咲來參加的話，一定會很好玩的說……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "算了啦，",
    "voice": "vo_adv_1083003_027",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "美咲不是說她不來了嗎，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我們走！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嗯、嗯……",
    "voice": "vo_adv_1083003_028",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "那再見囉，美咲……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……哼！",
    "voice": "vo_adv_1083003_029",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "什麼嘛……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我才不羨慕他們呢！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我最討厭萬聖節了！",
    "voice": "vo_adv_1083003_030",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "才不要呢！",
    "voice": "vo_adv_1083003_031",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "　",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "反正我去了也會覺得不好玩……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那還不如跟你待在一起比較好！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "因為我跟大家不一樣，不是小孩子了，",
    "voice": "vo_adv_1083003_032",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我才不去那種派對呢！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……咦？　",
    "voice": "vo_adv_1083003_033",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你要我回想一下之前可以拿到點心的那個活動？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "要是固執地",
    "voice": "vo_adv_1083003_034",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不說出真正的想法，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n就沒辦法拿到自己真正想要的東西……？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……的確，",
    "voice": "vo_adv_1083003_035",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那時候我說我才不要什麼點心之後，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n結果卻看到了真的很想要的點心，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真的很後悔……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你、",
    "voice": "vo_adv_1083003_036",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你這樣說的話，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我會害羞啦，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "笨蛋。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "唉……",
    "voice": "vo_adv_1083003_037",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "老實說你在這方面有話直說的地方，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n真的很像大人呢。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "連在這種時候都能冷靜應對，",
