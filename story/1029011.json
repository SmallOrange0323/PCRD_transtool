  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隨著祭典的日期一天一天接近，慈樂之音也越來越投入於練習當中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然而──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "結束！",
    "voice": "vo_adv_1029011_000",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……呼，",
    "voice": "vo_adv_1029011_001",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "剛才那段",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "應該算是練得差不多了吧？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯，",
    "voice": "vo_adv_1029011_002",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "動作的確已經調整到位了。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n妳說是吧，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "望？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……",
    "voice": "vo_adv_1029011_003",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "望？",
    "voice": "vo_adv_1029011_004",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": "vo_adv_1029011_005",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "唔",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我覺得還挺不錯的喔。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……我說，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "剛才間奏時的舞步",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是不是只有我有點沒對到拍子啊？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "沒有這回事喔。",
    "voice": "vo_adv_1029011_006",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "對吧，千歌。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是的。",
    "voice": "vo_adv_1029011_007",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "拍子很精準動作也很到位。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "妳不需要在意。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": "vo_adv_1029011_008",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我去休息一下，自己稍微想一想。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "小望她",
    "voice": "vo_adv_1029011_009",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "雖然沒有再繼續讓自己過度操勞，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但這次換成苦惱的心事增加了。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "她太堅持要讓演出完美成功，",
    "voice": "vo_adv_1029011_010",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n所以不管練多少次，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "她都沒辦法滿意的樣子……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這下子",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "感覺誰去跟她說，她也都聽不進去了。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "到底該怎麼辦才好呢……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "說的也是。",
    "voice": "vo_adv_1029011_011",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這種時候交給騎士先生處理也許比較妥當。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果是由受到她信賴的你去說，",
    "voice": "vo_adv_1029011_012",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我想望一定會聽進去。\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那就麻煩你了。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊啊，",
    "voice": "vo_adv_1029011_013",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不管怎麼想，事情都沒辦法如願。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我到底該怎麼辦才好呢……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊……",
    "voice": "vo_adv_1029011_014",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌她們",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "說了什麼嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這樣啊。",
    "voice": "vo_adv_1029011_015",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真是丟臉……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我這樣真是個失職的Center。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "她們兩個說的沒錯，",
    "voice": "vo_adv_1029011_016",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也覺得已經做得很好了。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只不過",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只要一想到",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "「真的是這樣嗎？」、",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n「還可以再做得更好吧？」，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我就會一下子感到不安起來。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "換作是真正的頂尖偶像，",
    "voice": "vo_adv_1029011_017",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n想必就不會煩惱這種事情了……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就、",
    "voice": "vo_adv_1029011_018",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就是……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "燈光是不是",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有點太亮了？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "討、",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "討厭，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "光芒越來越刺眼，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呀啊啊～！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "background",
    "bg_id": "510071"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那一天，{0}排了打工，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n要去當望PV拍攝的工作人員。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性工作人員",
    "words": "不好意思，",
    "voice": "vo_adv_1029011_019",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女性工作人員",
    "words": "我到處都找不到小望……",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "啊啊，",
    "voice": "vo_adv_1029011_020",
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "小望她會稍微離開一會兒。",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "不用在意她也沒關係，",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "趁現在先休息一下吧。",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "嗯？",
    "voice": "vo_adv_1029011_021",
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "我記得你是新來打工的……",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "對啊，",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "她偶爾會像這樣，一個人跑到外面去。",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "沒人知道她是要去哪裡，",
    "voice": "vo_adv_1029011_022",
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "但她回來的時候都會給人一種豁然開朗的感覺，",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n在鏡頭前的表現也會變好，",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "所以也就沒有人會去特別追究了。",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "這算是小望在工作時候的作風，",
    "voice": "vo_adv_1029011_023",
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性工作人員",
    "words": "所以就稍微忍耐一下吧。",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": "vo_adv_1029011_024",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "喂，是{0}嗎？",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我想請你來接我，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我現在在──",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "background",
    "bg_id": "510202"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……",
    "voice": "vo_adv_1029011_025",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}！\\n不好意思突然叫你出來。",
    "voice": "vo_adv_1029011_026",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": "vo_adv_1029011_027",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你已經聽說過我偶爾會溜出來的事了啊。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "每當事情不順遂，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n或是工作遇到困境的時候，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我就會來這個地方。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "──因為",
    "voice": "vo_adv_1029011_028",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這裡是我的原點。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呵呵，",
    "voice": "vo_adv_1029011_029",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你想聽原因嗎？",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "說是這麼說，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也只是件既常見又無聊的陳年往事。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過對我來說",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是段使我決定要成為偶像的重要回憶。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "在我還小的時候，",
    "voice": "vo_adv_1029011_030",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有一次來這裡玩，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "結果跟爸媽走散了。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我當時非常害怕不安，",
    "voice": "vo_adv_1029011_031",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一邊哭著一邊到處亂走，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "結果看到了三個",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "正在練習唱歌跳舞的女孩子。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "她們是",
    "voice": "vo_adv_1029011_032",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我有在電視上看過的，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "名為「偶像」的人。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只不過，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "和我所知道的偶像不同，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n是群努力想成為偶像但技巧還不夠純熟的人。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "still",
    "still_id": "102901101"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過，",
    "voice": "vo_adv_1029011_033",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "即使一個觀眾都沒有，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n她們仍舊用盡全力在展現著自身的魅力。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這景象使我大開眼界，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "原來人可以這麼閃耀奪目。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就連什麼是偶像都還搞不懂的小孩子，",
    "voice": "vo_adv_1029011_034",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也都能感受到她們的熱情，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以回過神來我的注意力都被她們的表演給吸引過去了。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n先前的不安跟淚水全都拋到九霄雲外，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "非常專心地在幫她們加油。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "而她們也對著",
    "voice": "vo_adv_1029011_035",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "僅此一人的小小觀眾，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n露出了滿臉的笑容。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "她們的身影",
    "voice": "vo_adv_1029011_036",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "在我心中留下了深刻的印象，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以我之後就在爸媽的面前，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n試著模仿她們唱歌跳舞。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但畢竟是小孩子在玩扮家家酒，",
    "voice": "vo_adv_1029011_037",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以模仿得一點也不像。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我爸媽卻感覺相當開心，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "笑著誇獎了我。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "以父母來說那是理所當然的反應。",
    "voice": "vo_adv_1029011_038",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我對這樣的反應感到非常高興。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也因此察覺到",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "原來讓人露出笑容，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n是這麼令人開心的事。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要是我的技巧更加熟練的話，",
    "voice": "vo_adv_1029011_039",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也許不只是父母，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n就連朋友或是沒見過的陌生人，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也能夠讓他們露出笑容。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我就想說，",
    "voice": "vo_adv_1029011_040",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "既然如此那我也成為偶像吧。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我想要成為",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "像她們一樣，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "傳遞笑容的人。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n這段回憶就是使我成為偶像的初衷。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……老實說",
    "voice": "vo_adv_1029011_041",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我最近不斷接到大型的工作，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n今天的拍攝也不太順利，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n因此心情有點煩躁。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以",
    "voice": "vo_adv_1029011_042",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我才來這裡讓自己回想起來。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "技巧與完成度雖然重要，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但還有更加重要的事。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "再一次回顧",
    "voice": "vo_adv_1029011_043",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "自己的初衷之後，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我已經不再感到不安了，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "而且現在還有人來迎接我，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以我沒問題的。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對了，",
    "voice": "vo_adv_1029011_044",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "剛才在你來之前，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我想到了一個不錯的表演。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我想要現在就先試試看。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只在你面前表演的，",
    "voice": "vo_adv_1029011_045",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我的特別演出。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你願意欣賞嗎？",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好了，",
    "voice": "vo_adv_1029011_046",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "每個人都有自己的故事。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "見識到了很棒的回憶呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "感到煩惱，",
    "voice": "vo_adv_1029011_047",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就是認真看待一件事情的最佳證據。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但有時候太過鑽牛角尖，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "反而會像是迷路一樣陷入迷惘。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但望的心中其實早就有了能突破困境的答案。",
    "voice": "vo_adv_1029011_048",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n剩下就看她能不能察覺到了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "當她察覺到的時候，她離成為真正頂尖偶像的日子，",
    "voice": "vo_adv_1029011_049",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n應該也就不遠了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "接下來就靠慈樂之音的兩位",
    "voice": "vo_adv_1029011_050",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "和你一起支持她了喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我也很期待那一天的到來。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次見囉──",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦……",
    "voice": "vo_adv_1029011_051",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我這是……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不可以在這裡睡覺喔……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呃，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "剛才我好像也跟著睡著了呢。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是我累了嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "感覺還夢到很不可思議的夢。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦，",
    "voice": "vo_adv_1029011_052",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你也夢到了？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是我懷抱偶像初衷的夢。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "明明自己沒有那段記憶，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "卻沒來由地覺得懷念。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我覺得",
    "voice": "vo_adv_1029011_053",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個夢裡頭有著許多重要的事物。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "感覺還差一點",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就能夠搞清楚那些事物是什麼了……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……你說的對。",
    "voice": "vo_adv_1029011_054",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我並不是獨自一人在當偶像。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "即便是一個人難以處理的問題，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "跟別人一起面對也許就能解決。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只要我們慈樂之音三個人，",
    "voice": "vo_adv_1029011_055",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "然後再加上你……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "像是那個夢裡的偶像一樣，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n互相支持對方就沒問題了對吧！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝你。",
    "voice": "vo_adv_1029011_056",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我已經",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "回想起了很重要的心情，所以已經不要緊了。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好了，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "距離祭典已經沒剩多少時間了，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們就打起精神繼續努力吧！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "不再感到迷惘的望，露出了相當耀眼的燦爛笑容。",
    "voice": null,
    "unit_id": null
  }
]
