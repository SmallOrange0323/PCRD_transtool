  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我真的要筋疲力盡啦……",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過，",
    "voice": "vo_adv_5074308_001",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "他雖然又增強了，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "卻似乎只是在隨便大鬧而已。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "究極的頭腦上哪去了呢？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "變成了這幅德行，",
    "voice": "vo_adv_5074308_002",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "根本也不用提什麼野心了。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真可悲啊，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "院長。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我是一點也不打算同情你啦，",
    "voice": "vo_adv_5074308_003",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n只是同為醫師，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我會負起責任，阻止你的。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這就是最後的手術了。",
    "voice": "vo_adv_5074308_004",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "認命吧，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你無法逃出我的獨眼哦。",
    "voice": null,
    "unit_id": 117511
