[
  {
    "type": "background",
    "bg_id": "500183"
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "あのね、",
    "voice": "vo_adv_5134422_000",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "正直に言うとね。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "\\n……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "結局、",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "最後まで宇宙空間で",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "隕石と激闘を繰り広げてました！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "多分、",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "ホントにただの夢を見てただけっぽいかも！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "うん、",
    "voice": "vo_adv_5134422_001",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "私も無茶を言って悪かったよ。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\nそもそもは、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "ハツネさんの緊張を解くためのアイデアだったのに。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "その夢は見なかったことにしてほしい、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "忘れよう。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "でも、",
    "voice": "vo_adv_5134422_002",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "不安は消えたんじゃないですか？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "さっきまでよりは顔色もよくなってるですよ。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "隕石を壊すこと自体はできたから。",
    "voice": "vo_adv_5134422_003",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "\\n同じやり方はできないけど、",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "自信は十分ついたよ！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "それだけで十分だ。",
    "voice": "vo_adv_5134422_004",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "元々、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "リラックスして本番に臨んでもらうのが目的だったしね。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "あとは現実で隕石を砕くだけです。",
    "voice": "vo_adv_5134422_005",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nあたしたちなら、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "きっとなんとかなるですよ。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n知らねーですけど。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "うん",
    "voice": "vo_adv_5134422_006",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "うん！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "それじゃあ、",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "改めて……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "みんなで、",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "ハツネ",
    "words": "隕石を壊すぞ～！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "お～！！",
    "voice": "vo_adv_5134422_007",
    "unit_id": null
  }
]
