    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "美里老師，",
    "voice": "vo_adv_5046321_001",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "氣氛跟剛剛完全不一樣了～！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好像真的很生氣，",
    "voice": "vo_adv_5046321_002",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "因為牠把我們當成強敵了嗎！？",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不注意一點的話可能會很危險……！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀～",
    "voice": "vo_adv_5046321_003",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "可以的話真想和牠好好相處……",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "看來我們只能",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "戰到小魔物滿意為止了呢。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n如果這樣你就會乖乖的……",
    "voice": null,
    "unit_id": 113511
  },
