  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……早安，",
    "voice": "vo_adv_5208006_000",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "今天早晨真是美好呢。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n昨天睡得好嗎？",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "喝啊啊──！！",
    "voice": "vo_adv_5208006_001",
    "unit_id": 135512
  },
  {
    "type": "background",
    "bg_id": "501651"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……呵呵，",
    "voice": "vo_adv_5208006_002",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "突然就攻擊我是不是太過分了呢。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你們是會跳過",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "最終Boss戰開場白的類型嗎？",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈，",
    "voice": "vo_adv_5208006_003",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "抱歉啦！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我們跟你可不是能開心聊天的關係啊！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "很遺憾，",
    "voice": "vo_adv_5208006_004",
    "unit_id": 135711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也不是聊天就能解決的對手。",
    "voice": null,
    "unit_id": 135711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 135711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "埃拉，",
    "voice": null,
    "unit_id": 135711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我也會在一開始",
    "voice": null,
    "unit_id": 135711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就使出全力的喔！",
    "voice": null,
    "unit_id": 135711
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……呵呵，",
    "voice": "vo_adv_5208006_005",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "要稍微多掙扎一下喔。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我雖然希望世界終結，",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "但過於簡單就太無趣了。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "讓我們開始吧。",
    "voice": "vo_adv_5208006_006",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……開始「絕望」。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "background",
    "bg_id": "501652"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與此同時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n回到志那都的世界的兩人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n也在索爾之塔的頂端",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與霸瞳皇帝戰鬥。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜、志那都",
    "words": "狂風刺擊！！",
    "voice": "vo_adv_5208006_007",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501652"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "八尺瓊勾玉‧",
    "voice": "vo_adv_5208006_008",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "滅葬──",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "background",
    "bg_id": "501652"
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "唔……！！",
    "voice": "vo_adv_5208006_009",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "志那都！！",
    "voice": "vo_adv_5208006_010",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……",
    "voice": "vo_adv_5208006_011",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "可惡，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "明明妳比那時候還強了，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n我卻在拖妳後腿……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……志那都，",
    "voice": "vo_adv_5208006_012",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "動作不太靈活……",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "據說在基礎世界時，力量會受到壓制。",
    "voice": "vo_adv_5208006_013",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "在這裡應該能發揮本來的力量……",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "可是。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……呼",
    "voice": "vo_adv_5208006_014",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……呼。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這是……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "因為。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n……我身為管理者的力量",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "變弱了……？",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "難道說。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "呵呵，",
    "voice": "vo_adv_5208006_015",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "終於注意到了啊？",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "沉迷於虛幻的夢境，",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "連自己的處境都看不清。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "真可悲。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "若這個世界的資源被削減，",
    "voice": "vo_adv_5208006_016",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那麼會",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "最受影響的，",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n當然是身為管理者的妳自己啊。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "嗚……",
    "voice": "vo_adv_5208006_017",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "沒想到",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "在戰鬥層面",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "也有這麼大的影響……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "哎呀……",
    "voice": "vo_adv_5208006_018",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "為此懊惱可不對啊？",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "因為",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "即使沒有弱化，",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳也贏不過我。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這妳應該最清楚啊。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "因為這裡是",
    "voice": "vo_adv_5208006_019",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我打敗了「士條怜」所生的世界。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n敗給我的記憶，",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n想必已經",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "牢牢",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "刻在妳的靈魂之中了吧？",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "而且",
    "voice": "vo_adv_5208006_020",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "即使在重複無數次的輪迴當中，",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n「這個世界」也只能數度挑戰我、",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "敗給我",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "並死去。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我雖沒有當時的記憶，",
    "voice": "vo_adv_5208006_021",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "但透過「霸瞳天星」的力量存取居民們的記憶體所看到的記憶，",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n每一個都是",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "淒涼的悲慘結局呢。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "而且",
    "voice": "vo_adv_5208006_022",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "如今的我是超越程式的存在。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n徒然地重複重置，",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "無論幾次都沒有達到目的的妳……",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "沒有任何可能贏過我喔。",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "唔……！",
    "voice": "vo_adv_5208006_023",
    "unit_id": 135614
  },
  {
    "type": "background",
    "bg_id": "501651"
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嘎啊！！！",
    "voice": "vo_adv_5208006_024",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "為什麼管理者的力量",
    "voice": "vo_adv_5208006_025",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "會在這時變弱……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "唔！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "喝啊！！",
    "voice": "vo_adv_5208006_026",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "埃拉由我來保……！！",
    "voice": "vo_adv_5208006_027",
    "unit_id": 135711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 135711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……呀啊！！",
    "voice": null,
    "unit_id": 135711
  },
  {
    "type": "background",
    "bg_id": "501651"
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "日和……！",
    "voice": "vo_adv_5208006_028",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "呼……",
    "voice": "vo_adv_5208006_029",
