  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "儘管魔物阻擋在",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n登塔的{0}一行人面前──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呼……！",
    "voice": "vo_adv_7021002_000",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "喝！",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n這樣就結束了！",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_7021002_001",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真是驚人。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n想不到深月小姐那麼強。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "她與純那種",
    "voice": "vo_adv_7021002_002",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "以壓倒性力量制服對手的方式不同，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n使用的是抓準對手弱點",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "高效率而確實地解決敵人的戰鬥方式……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "只能以厲害來形容了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_7021002_003",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不必稱讚我哦？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這點程度根本上不了檯面。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "說什麼上不了檯面……",
    "voice": "vo_adv_7021002_004",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不管怎麼看",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "感覺深月小姐",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n連一半的實力都沒展現出來。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就算我拿出真本事也沒有取勝把握……",
    "voice": "vo_adv_7021002_005",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "說來",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這個人真的是醫生嗎？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n從來沒聽說過有醫生這麼厲害的。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_7021002_006",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "怎麼又冒出了一大群。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "小智，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這次讓我們聯手──",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "沒問題的！",
    "voice": "vo_adv_7021002_007",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n身為【王宮騎士團】成員，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這種程度",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我一個人就能解決了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "怎麼能夠抱著沒有取勝把握之類的畏縮想法。",
    "voice": "vo_adv_7021002_008",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n守護城鎮治安的【王宮騎士團】",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n隨時都得保持果敢才行！　",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我要上囉！",
    "voice": "vo_adv_7021002_009",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "看劍看劍看劍！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "太慢了！",
    "voice": "vo_adv_7021002_010",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n用這招解決你！！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呼、",
    "voice": "vo_adv_7021002_011",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "全都打倒了嗎？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n這種程度我一個人也能──",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "糟糕！",
    "voice": "vo_adv_7021002_012",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "還有倖存的……！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………",
    "voice": "vo_adv_7021002_013",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦，",
    "voice": "vo_adv_7021002_014",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "怪了？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_7021002_015",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "看來只是迴光返照呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n妳沒事真是太好了。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦……？",
    "voice": "vo_adv_7021002_016",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "感覺深月小姐做了些什麼。",
    "voice": "vo_adv_7021002_017",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "她做了萬一被我目擊會很頭痛的事嗎？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n可是",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我也沒有證據……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "來，",
    "voice": "vo_adv_7021002_018",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "在魔物再次出現前",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "快點前進吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好、",
    "voice": "vo_adv_7021002_019",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好的。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "說得也是。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "深月小姐……",
    "voice": "vo_adv_7021002_020",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是位深不可測的人。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n如果有什麼萬一，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我一個人真的應付得過來嗎？　",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "跟在大大方方走在前面的深月身後的智的步伐，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看起來有些裹足不前。",
    "voice": null,
    "unit_id": null
  }
]
