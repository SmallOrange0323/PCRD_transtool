[
  {
    "type": "background",
    "bg_id": "501040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "我一出現，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "「我」就一副驚訝的樣子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看來「我」誤會了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "我，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "不是敵人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "那個模樣是……",
    "voice": "vo_adv_5206005_000",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "普蕾西亞，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "妳退下。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯……",
    "voice": "vo_adv_5206005_001",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……不需要戒備。",
    "voice": "vo_adv_5206005_002",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我是協助者。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我一直都在看著，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "此行是要找她的父親吧？",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我來",
    "voice": "vo_adv_5206005_003",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "為妳實現願望──",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "咦──",
    "voice": "vo_adv_5206005_004",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "普蕾西亞……！？",
    "voice": "vo_adv_5206005_005",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "妳把她帶到哪裡去了？",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "遷移到由記憶",
    "voice": "vo_adv_5206005_006",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "編織的幻影裡了。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這樣一來，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就能專注於「我」自身的願望上了。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這次一定",
    "voice": "vo_adv_5206005_007",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "要實現。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n「只有騎士先生和我的永恆世界」。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……妳，",
    "voice": "vo_adv_5206005_008",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是誰……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "正如所見……",
    "voice": "vo_adv_5206005_009",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n我是",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "「我」的夢之殘影。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "在戰鬥中落敗、快要消失時，",
    "voice": "vo_adv_5206005_010",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n「我」的留戀",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "就寄宿在「理想鄉」的殘骸中。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "這就是，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "我。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "難道──",
    "voice": "vo_adv_5206005_011",
    "unit_id": 135011
  },
  {
    "type": "background",
    "bg_id": "501650"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但我……",
    "voice": "vo_adv_5206005_012",
    "unit_id": 129014
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "卻失敗了。",
    "voice": null,
    "unit_id": 129014
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129014
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我沒能，",
    "voice": null,
    "unit_id": 129014
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "創造出",
    "voice": null,
    "unit_id": 129014
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "理想鄉……",
    "voice": null,
    "unit_id": 129014
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n沒能，",
    "voice": null,
    "unit_id": 129014
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "讓騎士先生……",
    "voice": null,
    "unit_id": 129014
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "牽起",
    "voice": null,
    "unit_id": 129014
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我的手……",
    "voice": null,
    "unit_id": 129014
  },
  {
    "type": "background",
    "bg_id": "501040"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不可能……",
    "voice": "vo_adv_5206005_013",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n理想鄉，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "應該沒有完成啊……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "被隔絕的空間，",
    "voice": "vo_adv_5206005_014",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "這就是理想鄉。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n因為有我寄宿，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "它才能以未完成的殘骸形態，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n勉強繼續存在。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "但殘骸就是殘骸。",
    "voice": "vo_adv_5206005_015",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "是因為再再構築的影響，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "被埋在海岸下，全都是錯誤的地帶。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……那麼，",
    "voice": "vo_adv_5206005_016",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "阿賀斗紫布菜的影像",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是妳做的？",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就為了把我引誘至此。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "……是D型檢體和殘骸接觸引發的bug吧。",
    "voice": "vo_adv_5206005_017",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "我剛剛也說了，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "因為有所損毀，錯誤很多。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "一切都是因為D型檢體擁有駭入米奈娃的紀錄，",
    "voice": "vo_adv_5206005_018",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n殘骸",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "誤認她為管理者，進而執行了她的願望……",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "即使想修復殘骸，",
    "voice": "vo_adv_5206005_019",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n沒有米奈娃之力的我也束手無策。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "不過，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "擁有殘渣的",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "「我」來了。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "所以，",
    "voice": "vo_adv_5206005_020",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "我花時間去調查了。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n然後得知，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "透過「我」持有的米奈娃的力量殘渣，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n殘骸已經開始稍稍穩定了。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "願望一開始只能在源自",
    "voice": "vo_adv_5206005_021",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "D型檢體之力的範圍執行。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "但是，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "如今只要是位於海岸範圍的角色，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n就可以分析那種力量，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "並加以應用。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "也就是說，",
    "voice": "vo_adv_5206005_022",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "「我」擁有的力量",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "如今仍對這理想鄉有效。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n只要有「我」在，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "應當就能完整修復理想鄉……",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……是嗎。",
    "voice": "vo_adv_5206005_023",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n果然，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "妳的目標是米奈娃的力量殘渣啊……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "所以──",
    "voice": "vo_adv_5206005_024",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n我希望能將這裡的管理者權限，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "轉讓給",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "「我」。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n收下吧。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "什麼……？",
    "voice": "vo_adv_5206005_025",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "我說過了吧，",
    "voice": "vo_adv_5206005_026",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "我就是「我」。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n是願望轉為闇影的存在。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "想要實現自己的心願。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………",
    "voice": "vo_adv_5206005_027",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "怎麼了？",
    "voice": "vo_adv_5206005_028",
    "unit_id": 129021
