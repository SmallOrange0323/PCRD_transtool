  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯～！",
    "voice": "vo_adv_7008002_000",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n露娜之塔探索得很順利。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "可說是一盤風筍呢～！",
    "voice": "vo_adv_7008002_001",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "咦？",
    "voice": "vo_adv_7008002_002",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "妳……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "妳是要說",
    "voice": "vo_adv_7008002_003",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "一帆風順",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "吧……？　",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "咦咦！？",
    "voice": "vo_adv_7008002_004",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "以這個進度繼續努力的話，",
    "voice": "vo_adv_7008002_005",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥很快",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就能恢復記憶了！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "長久以來的努力",
    "voice": "vo_adv_7008002_006",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "終於可以獲得回報！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "可說是如願伊嫦！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那、",
    "voice": "vo_adv_7008002_007",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那是哪位誰啊……！？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "妳要說的是",
    "voice": "vo_adv_7008002_008",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "「如願以償」",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "吧……！？　",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以說",
    "voice": "vo_adv_7008002_009",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那是誰啊……！？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我很少離開城鎮所以不太清楚，",
    "voice": "vo_adv_7008002_010",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "難不成",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "像這樣故意說錯成語是",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "最近的流行趨勢嗎……？　",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "既然如此，",
    "voice": "vo_adv_7008002_011",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我也來試試……！　",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不過",
    "voice": "vo_adv_7008002_012",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "接下來的路途還很漫長，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們還是要多加小心。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "正、",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "正所謂……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "疏忽",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "會是命……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊哈哈，",
    "voice": "vo_adv_7008002_013",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳說錯了喔～",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "小栞。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "正確說法是",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "疏忽會致命",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "吧～？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "咦……？　",
    "voice": "vo_adv_7008002_014",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "奇怪……？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呵呵呵～",
    "voice": "vo_adv_7008002_015",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我剛剛",
