[
  {
    "type": "background",
    "bg_id": "500280"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "【墨丘利財團】的四人都到齊了。\\n包含{0}在內的五人談起情報：\\n這座島整體是一個叫做島鯨的魔物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "原來如此……",
    "voice": "vo_adv_5005006_000",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "如果珠希你們說的話是真的，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n從海上呼喚這座島的話，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n應該能和島鯨說話呢……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "先商量看看……",
    "voice": "vo_adv_5005006_001",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "如果這樣還是不行的話",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就要使用武力囉！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n然後，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "讓牠把我們送回現實世界唷！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "嗯，",
    "voice": "vo_adv_5005006_002",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "得回去現實才行呢！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對，",
    "voice": "vo_adv_5005006_003",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "無論如何都得回去才行！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不可以喵！",
    "voice": "vo_adv_5005006_004",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不能再逃避現實了喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "來吧，",
    "voice": "vo_adv_5005006_005",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "全部的人坐上木筏，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "往海上出發囉！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "喔，",
    "voice": "vo_adv_5005006_006",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "雖然衝勁十足的嘗試出海了……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不過一直待著的島，",
    "voice": "vo_adv_5005006_007",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "像這樣從外面看也沒有臉啊……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n真的是魔物嗎？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沒錯喵！",
    "voice": "vo_adv_5005006_008",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那是島鯨喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n筆記本裡是這麼寫的喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喂────！",
    "voice": "vo_adv_5005006_009",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你這傢伙────！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "島鯨────！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n快點把我們，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "從這座島放出去喵────！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好奇怪呢，",
    "voice": "vo_adv_5005006_010",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "沒有反應……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "珠希、",
    "voice": "vo_adv_5005006_011",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "美冬……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "該不會，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n妳們",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "之前看到的東西也是幻想？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n那筆記本真的存在嗎……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "應、",
    "voice": "vo_adv_5005006_012",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "應該不是幻想喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n真的可以和島鯨對話才對喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我知道了！",
    "voice": "vo_adv_5005006_013",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "怎麼了，",
    "voice": "vo_adv_5005006_014",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "美冬？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那傢伙，可是很貪心呢！",
    "voice": "vo_adv_5005006_015",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n不能用一副要吵架的樣子搭話，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n說些牠可能有興趣的事情就好了！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "原來如此，",
    "voice": "vo_adv_5005006_016",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼我來試試看吧！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "島鯨大人──！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我有筆好生意想和您談談──！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦？",
    "voice": "vo_adv_5005006_017",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "總覺得，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是不是傳來了隆隆聲……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "地震？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊？",
    "voice": "vo_adv_5005006_018",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "大家，快看那個！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "島正在往上浮！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "still",
    "still_id": "500500601"
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "──喔喔喔喔喔喔！",
    "voice": "vo_adv_5005006_019",
    "unit_id": 10411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "欸！？",
    "voice": "vo_adv_5005006_020",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "島浮上海面，然後出現了臉──！？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那座島，",
    "voice": "vo_adv_5005006_021",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真的是魔物呢……！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "人類啊……",
    "voice": "vo_adv_5005006_022",
    "unit_id": 10411
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "妳指的生意，",
    "voice": null,
    "unit_id": 10411
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "是什麼……？",
    "voice": null,
    "unit_id": 10411
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n難道又是，",
    "voice": null,
    "unit_id": 10411
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "要像之前的人類一樣，",
    "voice": null,
    "unit_id": 10411
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n希望藉由宣傳這座島的存在",
    "voice": null,
    "unit_id": 10411
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "要我放過你們嗎……？",
    "voice": null,
    "unit_id": 10411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不，",
    "voice": "vo_adv_5005006_023",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不是喔。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n你，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要多少錢才願意和我們締結契約呢？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "契約……？",
    "voice": "vo_adv_5005006_024",
    "unit_id": 10411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你，",
    "voice": "vo_adv_5005006_025",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "想要聚集人類的欲望對吧？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要不要和我們【墨丘利財團】聯手，\\n一起做生意？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "會幫你大大宣傳唷？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "名稱就叫做，",
    "voice": "vo_adv_5005006_026",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "「提供僅限一週夢幻般生活的服務」！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我想開始一個",
    "voice": "vo_adv_5005006_027",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "僅限一週讓島鯨幫忙實現客人的欲望，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n然後在快死掉之前",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "強制帶回去的服務！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這個服務，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "一定會很有商機唷！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "秋乃",
    "voice": "vo_adv_5005006_028",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "真是想了些驚人亂來的點子……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不過如果是這樣的話，的確效率也很好呢……",
    "voice": "vo_adv_5005006_029",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n問題是，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "島鯨會不會接受這個提案……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "別……",
    "voice": "vo_adv_5005006_030",
    "unit_id": 10411
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "別胡說八道了……！",
    "voice": "vo_adv_5005006_031",
    "unit_id": 10411
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n這種提案像是變成你們人類的道具一樣，",
    "voice": null,
    "unit_id": 10411
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n你們覺得我會同意嗎啊啊啊啊！",
    "voice": null,
    "unit_id": 10411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "生氣了嗎！？",
    "voice": "vo_adv_5005006_032",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不過，",
    "voice": "vo_adv_5005006_033",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "也是啦，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "畢竟是魔物……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦？",
    "voice": "vo_adv_5005006_034",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n往下沉的島鯨，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n好像同時有什麼從背後噴了出來……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊好痛！",
    "voice": "vo_adv_5005006_035",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "小小硬硬的……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這個是……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "貓幣喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這個錢幣是真實存在的呢……",
    "voice": "vo_adv_5005006_036",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "該不會是，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n以前漂到這座島上的海盜的寶藏也說不定！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "總覺得，意外地發了大財！",
    "voice": "vo_adv_5005006_037",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不過，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "比起那個問題是……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這下子，",
    "voice": "vo_adv_5005006_038",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是不是真的可以回去蘭德索爾的這件事吧……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就是呢……",
    "voice": "vo_adv_5005006_039",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呼啊……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n一想到就突然變得想睡……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呼啊……",
    "voice": "vo_adv_5005006_040",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "雖然這種睡意，已經經驗過好幾次……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n但這次，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "應該是為了要逃離這座島才出現的睡意……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沒問題吧喵……",
    "voice": "vo_adv_5005006_041",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這次，可以好好的……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "回去了吧喵……？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼……",
    "voice": "vo_adv_5005006_042",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "以防萬一把手牽起來吧。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我們……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n【墨丘利財團】，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要一直",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "在一起唷……",
    "voice": null,
    "unit_id": 103211
  }
]
