  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "魔物……",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "恐怕是",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吐舌鬼召喚的",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "夢之產物吧。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n用普通方式戰鬥，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "或許沒什麼效果。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是啊。",
    "voice": "vo_adv_5158321_001",
    "unit_id": 132911
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "而且",
    "voice": null,
    "unit_id": 132911
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那隻魔物，",
    "voice": null,
    "unit_id": 132911
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n看起來",
    "voice": null,
    "unit_id": 132911
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "很堅硬……",
    "voice": null,
    "unit_id": 132911
  },
  {
    "type": "dialogue",
    "name": "弗洛艾",
    "words": "……？",
    "voice": "vo_adv_5158321_002",
    "unit_id": 52412
  },
  {
    "type": "dialogue",
    "name": "弗洛艾",
    "words": "魔物有異狀！",
    "voice": null,
    "unit_id": 52412
  },
  {
    "type": "dialogue",
    "name": "弗洛艾",
    "words": "\\n它對小伊緒有所反應……？",
    "voice": null,
    "unit_id": 52412
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……！",
    "voice": "vo_adv_5158321_003",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "伊緒，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就是那樣。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n請妳像剛才那樣，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "魅惑魔物吧！",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "只要持續魅惑後方的魔物，",
    "voice": "vo_adv_5158321_004",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n或許就能擾亂它們的陣型了。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "咦……",
    "voice": "vo_adv_5158321_005",
    "unit_id": 132911
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "魅惑？",
    "voice": null,
    "unit_id": 132911
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132911
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我",
    "voice": null,
    "unit_id": 132911
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "什麼都沒做啊……？",
    "voice": null,
    "unit_id": 132911
  }
