    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "實現夢想的日子就不遠了……！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "呵呵呵！",
    "voice": "vo_adv_1142003_007",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "今天我就來告訴莫妮卡，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n該如何成為",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "更厲害的魔法少女！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你說什麼！？",
    "voice": "vo_adv_1142003_008",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n竟然還有這種方法嗎！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "摩拉！",
    "voice": "vo_adv_1142003_009",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n快點教我該怎麼做！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "莫妮卡，",
    "voice": "vo_adv_1142003_010",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n妳還記得魔法少女的力量泉源",
