    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……沒錯，",
    "voice": "vo_adv_1142003_005",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我現在感到非常充實。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "自己逐漸培養出提督所需的能力，",
