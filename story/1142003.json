    "name": "莫妮卡",
    "words": "就算你突然這麼說，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "又該如何了解",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "愛與希望呢……？",
    "voice": null,
    "unit_id": 105311
  },
  {
