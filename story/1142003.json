    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "是什麼嗎？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是愛與希望，",
    "voice": "vo_adv_1142003_011",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "對吧？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "沒錯！",
    "voice": "vo_adv_1142003_012",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n對魔法少女來說，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "愛與希望是不可或缺的！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "只要能夠更了解",
    "voice": "vo_adv_1142003_013",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "愛與希望，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "就能成為更厲害的魔法少女！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "原來如此……！",
