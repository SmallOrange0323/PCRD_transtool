    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我的成長嗎！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "那還用說！",
    "voice": "vo_adv_1142003_004",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n看到莫妮卡成長為出色的魔法少女，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我真的很開心呢！",
