    "words": "\\n■開■始■■■。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "……{0}等人齊心協力，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n擊敗了最後的七冠──幻境龍后。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501640"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……啊、",
    "voice": "vo_adv_2218001_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "──麥克風測試、",
    "voice": "vo_adv_2218001_001",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "麥克風測試。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "嗯～",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "果然只要試圖連接蘭德索爾這邊，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "就會有點延遲呢。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "嘛，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不過這也是LoA正在",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "逐漸恢復正常的",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "證據就是了……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "好的，",
    "voice": "vo_adv_2218001_002",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "辛苦了──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……唉，",
    "voice": "vo_adv_2218001_003",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "說真的，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n雖然我也出了一份力，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "但我當時也覺得根本不可能成功呢。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "沒想到，",
    "voice": "vo_adv_2218001_004",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "你們真的打敗了幻境龍后。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "雖然我不是可可蘿或莉莉。",
    "voice": "vo_adv_2218001_005",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不過，你說不定，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n真的具備",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "所謂的英雄資質呢。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "你要這樣說的話……",
    "voice": "vo_adv_2218001_006",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "嘛，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "主要多虧了我呢。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n暗中與【幻變少女】的孩子們配合，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "盡可能地從模組中收集",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n與八斗神所使用的能量",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "相反的",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "「[rub:正面]正面[/rub]能量」。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……還有，",
    "voice": "vo_adv_2218001_007",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "也多虧了米奈娃呢。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "background",
    "bg_id": "501650"
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "……與幻境龍后的戰鬥，",
    "voice": "vo_adv_2218001_008",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "以及",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "連續執行強制回溯，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n導致折損率",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "超過了80％。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "已經無法",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "維持這個角色了。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "……再見，",
    "voice": "vo_adv_2218001_009",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "諾維姆、",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "尾狗刀。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n這樣一來，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "契約就到期了。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "契約到期了……",
    "voice": "vo_adv_2218001_010",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "謝謝妳，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "米奈娃。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "還有……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "對不起。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "不必道歉。",
    "voice": "vo_adv_2218001_011",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n「我」並不會消失……",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n今後，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "我只是會與LoA合為一體，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "繼續維持世界而已。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "多虧有妳……",
    "voice": "vo_adv_2218001_012",
    "unit_id": 106118
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "才能度過難關。",
    "voice": null,
    "unit_id": 106118
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n真的很謝謝妳。",
    "voice": null,
    "unit_id": 106118
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "……我才要謝謝你們。",
    "voice": "vo_adv_2218001_013",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n能從你們身上學到什麼是心，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "不過，",
    "voice": "vo_adv_2218001_014",
    "unit_id": 106118
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我們還要再見啊。",
    "voice": null,
    "unit_id": 106118
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106118
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "一定要喔！",
    "voice": null,
    "unit_id": 106118
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n即使契約結束了，",
    "voice": null,
    "unit_id": 106118
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我們也還是",
    "voice": null,
    "unit_id": 106118
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "妳的朋友啊！",
    "voice": null,
    "unit_id": 106118
  },
  {
    "type": "background",
    "bg_id": "501640"
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……你也別",
    "voice": "vo_adv_2218001_015",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "太在意啦。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "米奈娃好像",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "本來就受到相當嚴重的傷，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "已經快撐不住了。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "況且，",
    "voice": "vo_adv_2218001_016",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "如果你們輸了，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n米奈娃的支配權",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "也會被幻境龍后奪走吧。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n對於討厭七冠的米奈娃來說，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "現在這樣已經比那樣好太多了。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "順帶一提，",
    "voice": "vo_adv_2218001_017",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "米奈娃也回收了",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "厄莉絲藏起來的",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n「登入伺服器的封鎖模式」中的解除程式，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "並託付給了",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "拉比林斯達。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "所以再過不久，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "應該也能正常登出了吧。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……說到底，",
    "voice": "vo_adv_2218001_018",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n她又不是死了？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "只要你還活著，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "總有一天說不定",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "還能再見面的。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "是啊──",
    "voice": "vo_adv_2218001_019",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n她遲早",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "會像這樣",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "闖入你的夢境吧？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "畢竟你的集體潛意識入口",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "超沒防備的。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……",
    "voice": "vo_adv_2218001_020",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "幹嘛啊？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n人家明明在安慰你，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n卻還擺出一副陰沉的表情。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……那傢伙……",
    "voice": "vo_adv_2218001_021",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "──「死了」",
    "voice": "vo_adv_2218001_022",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "吧。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "將那麼多資源塞入角色後，",
    "voice": "vo_adv_2218001_023",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "還能大肆作亂……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n是因為她那麼「深」地",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "潛入這個世界。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n霸瞳皇帝那傢伙好像",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "也說過類似的話吧。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "那種特殊的潛入──",
    "voice": "vo_adv_2218001_024",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "姑且先稱為",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "「[rub:深域]深域[/rub]潛入」吧。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n與被當成實驗品的彌勒不同，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "幻境龍后",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "可是一心想回到現實。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "這也是理所當然的呢，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "畢竟那個外星人的目的是",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "[rub:改造]覆寫[/rub]地球。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "所以，",
    "voice": "vo_adv_2218001_025",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "在被逼到絕境之前，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "她並不會進入深域潛入狀態──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n也就是「第二型態」。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n就算使用那股力量，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "也只會用到還能返回的臨界點。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……",
    "voice": "vo_adv_2218001_026",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不過，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n如果在「這邊」輸給你們，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "她在現實中也會被聯合國軍逼到絕路。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "就算再怎麼使用超能力，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "也敵不過對方在資源上的龐大優勢……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "第二型態的「深域潛入」",
    "voice": "vo_adv_2218001_027",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "應該是設定成無視安全基準……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n甚至設定到",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "對肉體產生回饋的程度吧……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "其他辦法嗎……",
    "voice": "vo_adv_2218001_028",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "或許",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "直接「修正認知」",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "是唯一的辦法了呢。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……不過以我的性能來說，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "無論如何都辦不到就是了。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……別這麼",
    "voice": "vo_adv_2218001_029",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "悶悶不樂、耿耿於懷啦。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n贏家就該抬頭挺胸，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "否則輸家也很難心甘情願認輸吧。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "這可是",
    "voice": "vo_adv_2218001_030",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "我以中立的立場說的喔。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "你們",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "做得很棒。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "別說發揮出原本實力的120％，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "根本是10000％左右吧。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……嘛，",
    "voice": "vo_adv_2218001_031",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不過是有那麼一點，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "該說是站在懸崖邊了嗎？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n甚至一度被推落懸崖，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "還順便",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "讓",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "世界線產生分歧也說不定……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "沒有真實感？",
    "voice": "vo_adv_2218001_032",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "那是當然的吧。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "嘛，",
    "voice": "vo_adv_2218001_033",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "那是當然的吧。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "就像這座「顛倒之塔」",
    "voice": "vo_adv_2218001_034",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "同時遍布於３個背面世界一樣，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n埃忒耳模組也是如此，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "與這個世界中的事物",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "[rub:・]完[/rub][rub:・]全[/rub][rub:・]相[/rub][rub:・]同[/rub][rub:・]的[/rub][rub:・]存[/rub][rub:・]在[/rub]，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n會同時遍布於其他世界線，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "並持續累積紀錄",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "似乎是這樣……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "就算是寄生在模組中的我，",
    "voice": "vo_adv_2218001_035",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n也頂多知道",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "「關上的門」正在增加……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "我能存取的，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "也只有「這個世界線的紀錄」而已。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "誰知道呢。",
    "voice": "vo_adv_2218001_036",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……就當作曾經有過，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不也挺好的嗎？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "「未曾選擇任何人的你」",
    "voice": "vo_adv_2218001_037",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n選擇了幻境龍后，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "並被她所接受……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "也有這樣的可能呢。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "──好了。",
    "voice": "vo_adv_2218001_038",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n差不多就聊到這邊吧。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "你接下來",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "好像還要在蘭德索爾開慶功宴吧？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……嘛，",
    "voice": "vo_adv_2218001_039",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "看心情吧。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "畢竟，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "我也不是完全沒事做。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "七冠打算利用我，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "作為交換，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "似乎會讓我活下去呢。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……再說了，",
    "voice": "vo_adv_2218001_040",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "參加那種人山人海的派對，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n絕對會累死我的……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "哼。",
    "voice": "vo_adv_2218001_041",
    "unit_id": 193211
  },
  {
