  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們兩個都會掉下去的……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我知道了，",
    "voice": "vo_adv_1276002_043",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "把釣竿放掉吧。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n所以不用再……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你是說",
    "voice": "vo_adv_1276002_044",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你能支撐住兩個人嗎？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果太勉強，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "會連船都一起翻覆的……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……你一臉「我明白」的表情呢。",
    "voice": "vo_adv_1276002_045",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呵呵……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你明明都下定決心了，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我如果還退縮的話就太遜了……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我會想辦法",
    "voice": "vo_adv_1276002_046",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "把這傢伙釣上來的。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n背後就交給你囉！",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我平時是不會採取這麼強硬的釣魚方式呢。",
    "voice": "vo_adv_1276002_047",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但是現在即使有點勉強……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也會制服它！",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好，",
    "voice": "vo_adv_1276002_048",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "它開始沒力了……！",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是現在！",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "使勁拉！！",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "上啊啊啊啊！",
    "voice": "vo_adv_1276002_049",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "501530"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}與流夏釣上大獵物後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人以大字形的姿勢躺在甲板上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼……",
    "voice": "vo_adv_1276002_050",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然很想",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "豎起大漁旗，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n但是身體",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "大概暫時動不了了……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "喂，",
    "voice": "vo_adv_1276002_051",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "應該就是那個了吧？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "喂～！",
    "voice": "vo_adv_1276002_052",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "小姐～！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "小哥～！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n你們沒事吧～？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你們……",
    "voice": "vo_adv_1276002_053",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不是回去了嗎？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "因為",
    "voice": "vo_adv_1276002_054",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我們很在意你們的情況，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n所以就一起來看看了。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "唔喔喔！？",
    "voice": "vo_adv_1276002_055",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n這什麼鬼啊！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "好強啊～！",
    "voice": "vo_adv_1276002_056",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n根本是大豐收耶！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "託你們的福。",
    "voice": "vo_adv_1276002_057",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然這麼說，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但是我",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "暫時受夠流沙釣了……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "至少讓我們來幫忙",
    "voice": "vo_adv_1276002_058",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "把東西搬到市場去吧。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "話又說回來，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "真不愧是小姐耶……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這不是我一個人的功勞，",
    "voice": "vo_adv_1276002_059",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是因為",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "有我們兩人的力量。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "嘿嘿，",
    "voice": "vo_adv_1276002_060",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "小哥你很行嘛。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n對你刮目相看了。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n好，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "剩下的就交給我們，你們好好休息吧！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼，",
    "voice": "vo_adv_1276002_061",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就恭敬不如從命。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "先稍微休息一會。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "辛苦了。",
    "voice": "vo_adv_1276002_062",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "釣得開心嗎？",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯，",
    "voice": "vo_adv_1276002_063",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還算滿開心的。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這不重要……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我說你，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "在我們出船釣魚前，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n你是不是也使用了力量？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "啊哈哈，",
    "voice": "vo_adv_1276002_064",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "果然",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "被發現了啊。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還說什麼「果然」啊！",
    "voice": "vo_adv_1276002_065",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n真是的，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你這是什麼意思？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "不過",
    "voice": "vo_adv_1276002_066",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "就我所見，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "效果似乎非常好啊。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這麼說是沒錯……",
    "voice": "vo_adv_1276002_067",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但是拜託你",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "別隨便玩弄",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "人心。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "這樣啊……",
    "voice": "vo_adv_1276002_068",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n抱歉，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "原來我傷害到",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "釣客的自尊了啊。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "自尊？",
    "voice": "vo_adv_1276002_069",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你在說什麼？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我在說的",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是那傢伙的事情。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n是因為我說過",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "希望他能可靠點……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "我使用力量",
    "voice": "vo_adv_1276002_070",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "是針對「希望能釣到很多獵物」",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "這句話喔。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n這是妳自己說過的話，妳不記得了嗎？",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我嗎……？",
    "voice": "vo_adv_1276002_071",
    "unit_id": 127612
  },
  {
    "type": "background",
    "bg_id": "501530"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好，",
    "voice": "vo_adv_1276002_072",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "出發！",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n希望能釣到很多獵物！",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "background",
    "bg_id": "501530"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "確實",
    "voice": "vo_adv_1276002_073",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "有說過呢……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咦？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真的只有這樣嗎？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n其他什麼都……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "是的。",
    "voice": "vo_adv_1276002_074",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n我是有使用力量讓魔物大量出現，",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "\\n但並沒有做其他任何事……",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣啊……",
    "voice": "vo_adv_1276002_075",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原本的他，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就已經",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是那麼可靠了啊。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "然而，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我卻擅自認為",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那是神燈精靈的力量……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呵呵……",
    "voice": "vo_adv_1276002_076",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這個嘛。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我只是想說",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我的修行",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還遠遠不夠呢。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "不過妳看起來",
    "voice": "vo_adv_1276002_077",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "倒是很高興的樣子呢。",
    "voice": null,
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你要記住啊？",
    "voice": "vo_adv_1276002_078",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "特地把這種話說出來，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可就太不解風情了。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "神燈精靈",
    "words": "咦～？",
    "voice": "vo_adv_1276002_079",
    "unit_id": 5313
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在爽朗笑容的圍繞下，載著一行人的沙上船",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n朝著市場前進。",
    "voice": null,
    "unit_id": null
  }
]
