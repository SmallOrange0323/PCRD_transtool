  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "…………（東張西望）",
    "voice": "vo_adv_5215051_000",
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "鏡華大小姐，",
    "voice": "vo_adv_5215051_001",
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "既然身為這次的主角，",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "態度應該要更大大方方吧？",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "來，請您聽聽",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "民眾的聲音。",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……大家",
    "voice": "vo_adv_5215051_002",
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是不是看著我們在說悄悄話啊？",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "感覺剛才被人用手指著",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "說「是變態可疑分子」耶。",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊，",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "甚至移開視線了……",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "哎呀，",
    "voice": "vo_adv_5215051_003",
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我們似乎還登上報紙了呢。",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "吸引了這麼多人的注意，",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "感覺好害羞呢。",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我看看，",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "「出現變態可疑分子了。",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "春天到了。」",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我們果然",
    "voice": "vo_adv_5215051_004",
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "被當成「變態可疑分子」了啊！",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "現在不是在這害羞的時候，",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "快逃走吧……！",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "background",
    "bg_id": "500891"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呼",
    "voice": "vo_adv_5215051_005",
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呼……",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "大家的視線好恐怖……",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "為什麼會變成這樣……",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "歡迎回來。",
    "voice": "vo_adv_5215051_006",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "那麼，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "大家的反應",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "如何呢……？",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "反應，",
    "voice": "vo_adv_5215051_007",
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就是……",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "說我們",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是「變態可疑分子」……",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "感覺",
    "voice": "vo_adv_5215051_008",
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "被看成是壞蛋千金叫成年人打扮成兔子，",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n還用鎖鏈繫著到處散步呢。",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "雖然很遺憾，",
    "voice": "vo_adv_5215051_009",
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但我認為看起來就是這樣喔。",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不趕快想辦法處理這身衣服跟鎖鏈的話，",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n會被當成變態可疑分子而遭到逮捕的……",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "但素因為詛咒的關係，",
    "voice": "vo_adv_5215051_010",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "衣服跟鎖鏈都脫不掉對吧……？",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "有找到解除詛咒的線索了嗎？",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "沒有，",
    "voice": "vo_adv_5215051_011",
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "還沒找到。",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "目前確定的，",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n就只有我負責裝傻，",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "鏡華大小姐負責吐槽這樣。",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這種事不用搞清楚也沒關係。",
    "voice": "vo_adv_5215051_012",
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n妳可是大人，",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請振作一點，別再胡鬧了。",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這真是失禮了。",
    "voice": "vo_adv_5215051_013",
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "目前確定的，",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n就只有身為千金及兔子使魔的",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n鎖鏈共同生活在等著我們的這件事。",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "感、",
    "voice": "vo_adv_5215051_014",
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "感覺一切",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "都會朝著奇怪的方向前進呢……",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不管是我們的生活，",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "還是人際關係……",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "應該說，",
    "voice": "vo_adv_5215051_015",
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "根據某處的情報來看，",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這似乎是有時間限制的。",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "如果沒能及時解開詛咒，",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我們似乎會迎來悲慘結局喔。",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "下回，",
    "voice": "vo_adv_5215051_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "\\n「VILLAINESS　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "避開吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "鏡華的變疑分子毀滅結局」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這種事妳要早點說啊！",
    "voice": "vo_adv_5215051_017",
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "得趕快",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "找到解除詛咒的方法才行……",
    "voice": null,
    "unit_id": 139012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "是的。",
    "voice": "vo_adv_5215051_018",
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這樣下去，",
    "voice": null,
    "unit_id": 138912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n就會迎來「變態可疑分子毀滅結局」。",
    "voice": null,
    "unit_id": 138912
  }
]
