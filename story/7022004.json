    "name": "初音",
    "words": "沒事的！",
    "voice": "vo_adv_7022004_012",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "交給我吧！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "閃亮亮☆",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──嘎喔喔喔喔喔！",
