    "words": "拜託妳了，布武機大人」，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n那我考慮看看也──",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊，",
    "voice": "vo_adv_5219001_055",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "果然還是不用了。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "從～",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "教教班比～♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "……啊？",
    "voice": "vo_adv_5219001_056",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n妳在賣弄什麼風騷？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n都還沒決定哥哥的所有權耶？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦～",
    "voice": "vo_adv_5219001_057",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "因為～",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "布武機沒辦法教我吧～？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "啥？",
    "voice": "vo_adv_5219001_058",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我輕輕鬆鬆就能教啊？ｗ",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n話說，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "比起超雜碎哥哥，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n我使用裝置才更熟練啦！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那",
    "voice": "vo_adv_5219001_059",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "給妳，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比的裝置。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n畫面都還是黑的。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "……",
    "voice": "vo_adv_5219001_060",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "竟然連啟動都還沒，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "真的假的？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "看，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "這裡是按鈕！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n啟動之後就是這裡。",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "要輕輕滑動透視面板。",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "面板？",
    "voice": "vo_adv_5219001_061",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "滑動？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "用手指觸碰畫面！",
    "voice": "vo_adv_5219001_062",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "在觸碰的狀態下移動！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "……話說，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "妳從初期設定開始就超雜碎了嘛。",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "鏡頭光圈先設定為自動──",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯嗯嗯……",
