[
  {
    "type": "background",
    "bg_id": "500190"
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "初音，",
    "voice": "vo_adv_5046101_000",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我有話想和妳說。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "在這個夏天，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "會暫時離開森林～！",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦──！",
    "voice": "vo_adv_5046101_001",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "美里老師不在的話，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我有點擔心能不能做好【森林守衛】的工作……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀～",
    "voice": "vo_adv_5046101_002",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "初音妳一定沒問題的。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n老師完全不用操心。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我才能很放心的外出唷～！",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真的嗎？",
    "voice": "vo_adv_5046101_003",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那就太好了──！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "話說美里老師，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "妳外出是因為有什麼事嗎？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "難道是去放暑假？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_5046101_004",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不是這樣的唷。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是因為",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "有學校拜託我去擔任特約講師～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦──！",
    "voice": "vo_adv_5046101_005",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不愧是美里老師！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n妳要去哪個學校呢──？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "詳細的事情我也還不清楚，",
    "voice": "vo_adv_5046101_006",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過聽說是在海邊附近喲。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不知道會是個什麼樣的地方呢……",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我現在就開始感到期待了呢～！",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好好哦──！",
    "voice": "vo_adv_5046101_007",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我也想去海邊──！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "雖然待在森林裡安安靜靜的也很好，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是說到夏天，果然就是要去海邊呀。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真想盡情地玩耍一番吶──",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀……",
    "voice": "vo_adv_5046101_008",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我可不是去玩樂的唷。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "機會難得，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "如果工作告一段落的話，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "也歡迎初音妳大駕光臨哦～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "太好了──！",
    "voice": "vo_adv_5046101_009",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n謝謝妳，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "美里老師！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我會卯起勁工作的！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵。",
    "voice": "vo_adv_5046101_010",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n會有什麼樣的際遇等待著我呢？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真希望可以成為一個美好的夏天～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "初音、美里",
    "words": "下一回，",
    "voice": "vo_adv_5046101_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音、美里",
    "words": "《美里的夏日聲援！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音、美里",
    "words": "　追夢的盛夏棒球隊》！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501100"
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "來吧各位～",
    "voice": "vo_adv_5046101_012",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "朝著夢想，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "開球～！",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "社員們",
    "words": "喔！！",
    "voice": "vo_adv_5046101_013",
    "unit_id": null
  }
]
