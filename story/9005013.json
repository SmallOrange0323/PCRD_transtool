  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雪菲持續專心畫著漫畫。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n原先在一旁幫忙的【暮光流星群】成員們，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n都外出處理公會的工作了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "一個人畫漫畫",
    "voice": "vo_adv_9005013_000",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "果然有點寂寞……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但我",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不能因此就停下畫筆……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "──需要幫忙的人",
    "voice": "vo_adv_9005013_001",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就是妳嗎！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦！？",
    "voice": "vo_adv_9005013_002",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n什、",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "什麼……！？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "剛才流夏……",
    "voice": "vo_adv_9005013_003",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "剛才我遇到【暮光流星群】她們，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n流夏說有人需要幫忙，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "叫我們過來這裡一趟！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妳是在為那傢伙製作禮物對吧？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我們前來仗義相助是也！",
    "voice": "vo_adv_9005013_004",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "一同製作",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "要獻給將軍的進貢品吧～！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我知道我該擔當什麼角色。",
    "voice": "vo_adv_9005013_005",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "來吧，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "儘管描繪美麗的我吧！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻……",
    "voice": "vo_adv_9005013_006",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "畫什麼都可以對吧？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "什麼都可以……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "請包在空花身上～♪",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那、",
    "voice": "vo_adv_9005013_007",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我應該是",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "幫不上什麼忙……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不過，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "只要能讓前輩開心……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我會努力的！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "謝謝妳們",
    "voice": "vo_adv_9005013_008",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "各位……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n那就拜託妳們了……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "事不宜遲，",
    "voice": "vo_adv_9005013_009",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "看我用忍法‧",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "千手觀音之術",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "來把手變多！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "來人呀，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "請站到我身後把手伸出來～！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呃，",
    "voice": "vo_adv_9005013_010",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那樣反倒浪費一名人力吧……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "…………",
    "voice": "vo_adv_9005013_011",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "紋風不動……",
    "voice": "vo_adv_9005013_012",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "完全進入模特兒狀態了……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我真的",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "非畫這個人不可嗎……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "像這種感覺……",
    "voice": "vo_adv_9005013_013",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n這裡再粗一點……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊嗚嗚……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "再翹高一點……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "流口水～♪",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "妳在畫什麼！？",
    "voice": "vo_adv_9005013_014",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我說妳到底在畫什麼！？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "哇哇哇……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呀嗚……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "等等，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不行，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "現在不是變成小嬰兒的時候……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "步未小姐、",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "步未小姐的狀況呢……！？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個，",
    "voice": "vo_adv_9005013_015",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這裡的背景……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我都",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "幫妳塗黑好了。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "然後還有，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩的髮際線要再更低一點，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n肩寬",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "要再更窄一點，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "披風內裡的布料質感要──",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "檢查得真仔細……",
    "voice": "vo_adv_9005013_016",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但坦白說，我甚至不知道她人在哪裡……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯！",
    "voice": "vo_adv_9005013_017",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然有那個意願，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但我們果然還是",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不擅長這種工作啊！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那妳們還來幹什麼啦～！？",
    "voice": "vo_adv_9005013_018",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在雪菲迴盪的哀號聲中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n漫畫的繪製姑且還算有點進度。",
    "voice": null,
    "unit_id": null
  }
]
