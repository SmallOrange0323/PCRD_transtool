  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在某個晴朗的日子，妮諾和{0}坐在茶館裡，\\n眺望著充滿觀光客，熱鬧又和平的大江戶町。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好悠閒、",
    "voice": "vo_adv_1096004_000",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好悠閒、",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是也。",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n天下太平",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "正是指",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這種情況呢。",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這麼說來，",
    "voice": "vo_adv_1096004_001",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我宣傳的忍者宅邸",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n好像變成了大江戶町",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "最受歡迎的觀光設施了是也。",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "只要忍者宅邸",
    "voice": "vo_adv_1096004_002",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "有很多的客人的話，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍也能找到很多",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "家臣候選人是也。",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "雖然現在",
    "voice": "vo_adv_1096004_003",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍的家臣只有我一人，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不過軍力一定能成長到",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "百萬石之多是也。",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "到時候",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "統一天下也指日可待是也！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "你的誇獎我心領了，",
    "voice": "vo_adv_1096004_004",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這是我的榮幸是也！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這也是將軍",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "威勢的恩賜是也！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "正是如此是也！",
    "voice": "vo_adv_1096004_005",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "　那道光是也！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "呵呵呵，",
    "voice": "vo_adv_1096004_006",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍的厲害之處，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我最清楚了，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n你不用那樣發光",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "也不要緊的是也。",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "唔，",
    "voice": "vo_adv_1096004_007",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哇啊啊啊啊啊啊————！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "still",
    "still_id": "109600401"
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍！",
    "voice": "vo_adv_1096004_008",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "　將軍！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "在這裡見面",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "已經是第100年了是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這是訓練是也！",
    "voice": "vo_adv_1096004_009",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "　",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "要學會忍法",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "得從外表開始是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "嗯？",
    "voice": "vo_adv_1096004_010",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "　附近好像",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "有什麼騷動呢？",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n什麼東西開始了嗎？",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "正式",
    "voice": "vo_adv_1096004_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "開始！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女主角",
    "words": "請多指教～。",
    "voice": "vo_adv_1096004_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哦哦？",
    "voice": "vo_adv_1096004_013",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "嘿嘿嘿，",
    "voice": "vo_adv_1096004_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "小姐，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流氓",
    "words": "\\n要不要跟我們一起玩一下啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女主角",
    "words": "呀――！",
    "voice": "vo_adv_1096004_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女主角",
    "words": "　誰來救救我呀！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "交給妮諾吧！",
    "voice": "vo_adv_1096004_016",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "你被捕了是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "　城裡的和平",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "由妮諾來守護是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "欸欸！？",
    "voice": "vo_adv_1096004_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "　喂……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "妳做什麼啊！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "呵呵呵……",
    "voice": "vo_adv_1096004_018",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我被包圍了是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "沒想到連將軍",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "也是惡黨的",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "手下是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不過！",
    "voice": "vo_adv_1096004_019",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "　正義是必勝的是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n看我的手裏劍攻擊是也。",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "咻咻咻！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "嗚哇！",
    "voice": "vo_adv_1096004_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "　好險！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n導、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "導演……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "不阻止她沒關係嗎！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "還滿有趣的啊……",
    "voice": "vo_adv_1096004_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "\\n繼續拍！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "　不准停止拍攝！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "咦咦咦咦――！？",
    "voice": "vo_adv_1096004_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "呣呣，",
    "voice": "vo_adv_1096004_023",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍被洗腦了，無法解除是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "既然如此……",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍不應該說那種話的是也。",
    "voice": "vo_adv_1096004_024",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n一定是",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "被鬼給利用了是也。",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我來擊退",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "俗世之鬼是也。",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "最終奧義！",
    "voice": "vo_adv_1096004_025",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "　忍法",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "・蜘蛛絲綑綁之術是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n咻啪啪啪啪啪！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "手、",
    "voice": "vo_adv_1096004_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "手腳都被綁住……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "動彈不得了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哈哈哈，",
    "voice": "vo_adv_1096004_027",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "大家都被綁住了是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n總算能守護住",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這座城市的和平是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "呣呣，",
    "voice": "vo_adv_1096004_028",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "那我就此……",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n隱身是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "　",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "忍忍",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是也。",
    "voice": null,
    "unit_id": 103031
  },
