[
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "怎麼可能，",
    "voice": "vo_adv_5017322_000",
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "怎麼可能，",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "怎麼可能……",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "\\n竟然將我……",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "將被魔女所寵愛",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "的我！！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "都已經被打成這樣了",
    "voice": "vo_adv_5017322_001",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n竟然還能動，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真的是讓人受不了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "就讓拉姆來給他致命一擊吧……",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "……等等。",
    "voice": "vo_adv_5017322_002",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "愛蜜莉雅大人？",
    "voice": "vo_adv_5017322_003",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "……喂，",
    "voice": "vo_adv_5017322_004",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你就乖乖投降吧。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n現在",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "還來得及。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我總覺得……！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "那副模樣……",
    "voice": "vo_adv_5017322_005",
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "別用魔女的模樣",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "和我說話！！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "……",
    "voice": "vo_adv_5017322_006",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "愛蜜莉雅大人，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "請您快躲開！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "……！？",
    "voice": "vo_adv_5017322_007",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "您沒事吧，",
    "voice": "vo_adv_5017322_008",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "愛蜜莉雅大人？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯、",
    "voice": "vo_adv_5017322_009",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "喔～",
    "voice": "vo_adv_5017322_010",
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "魔女啊……",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "莎緹拉啊……！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "\\n請給我",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "愛愛愛愛愛愛！！！！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "「不可視之手」竟然比之前還更加厲害了……",
    "voice": "vo_adv_5017322_011",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雖然不願意這樣想，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n但他應該是",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "將執念轉為力量了吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "請您退下，",
    "voice": "vo_adv_5017322_012",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "愛蜜莉雅大人！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n那個大罪司教，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "就由雷姆來……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "沒事的，",
    "voice": "vo_adv_5017322_013",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "雷姆。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "讓我來吧……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "這必須由我來處理。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n魔女…",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "還有魔女教……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "身為王選的候選人……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我不能再讓",
    "voice": "vo_adv_5017322_014",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我們世界的糾葛，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n危害到這個世界了！",
    "voice": null,
    "unit_id": 109911
  }
]
