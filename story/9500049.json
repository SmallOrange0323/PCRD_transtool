[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "欸？",
    "voice": "vo_adv_9500049_000",
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不是吧，",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咦咦？",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n是、",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是我嗎！？",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n應該",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒有弄錯吧？",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……喂，",
    "voice": "vo_adv_9500049_001",
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥。",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你再",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "仔細考慮一下啦。",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我可是",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "見不得光的人喔。",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我既沒有女人味，",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "跟我在一起",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "能不能得到幸福，",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也很難說呢。",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "對小哥而言，",
    "voice": "vo_adv_9500049_002",
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "應該還有很多",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "更適合的女孩子吧？",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n又不像我，",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "跟浮萍一樣居無定所。",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "什……！？",
    "voice": "vo_adv_9500049_003",
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n你有那麼",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "想選我",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗎！？",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我可是",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "為了你著想……",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……不，",
    "voice": "vo_adv_9500049_004",
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是這樣的人啊。",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n既然你的決心",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如此堅定……",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼我也得",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "做好覺悟了呢。",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "先說好，",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我只會說一次，",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以你可要仔細聽好了。",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我最喜歡你了，",
    "voice": "vo_adv_9500049_005",
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "{0}。",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我一直都",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "愛著你。",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "當著你的面，",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "正式說出自己的心意，",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還真是讓人",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "有點難為情。",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以，",
    "voice": "vo_adv_9500049_006",
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "既然小哥",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要選擇我──",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n那我就會為了",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我最重要的小哥，",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "揮舞刀刃。",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "因為這才是",
    "voice": "vo_adv_9500049_007",
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真正的武士呢！",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……到時候",
    "voice": "vo_adv_9500049_008",
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就算你",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "叫我離開，",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也不會聽喔。",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "今後，",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也會一直",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "待在",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥身邊。",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以，",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "往後的日子，",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就請你",
    "voice": null,
    "unit_id": 105641
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "多多指教囉。",
    "voice": null,
    "unit_id": 105641
  }
]
