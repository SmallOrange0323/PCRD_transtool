    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "來去挑戰吧～！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "background",
    "bg_id": "510270"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼要出發囉～！",
    "voice": "vo_adv_1134004_019",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "起飛！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "still",
    "still_id": "113400401"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "哇～",
    "voice": "vo_adv_1134004_020",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "飛得好高！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "而且吹著涼爽的風～！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n真的好舒服喔～！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "{0}覺得如何呢？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "看來你很喜歡呢！",
