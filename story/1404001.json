[
  {
    "type": "background",
    "bg_id": "502290"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在吉歐‧尼布爾黑爾的邊境，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}與黎薩彼此面對面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………",
    "voice": "vo_adv_1404001_000",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……說的也是。",
    "voice": "vo_adv_1404001_001",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "時間稍微從{0}與黎薩的對話",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n往前回溯一些──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502480"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在LoA免於資料刪除危機的幾天後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}來到了吉歐‧尼布爾黑爾。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "庫西",
    "words": "嗚……",
    "voice": null,
    "unit_id": 52211
  },
  {
    "type": "background",
    "bg_id": "502460"
  },
  {
    "type": "dialogue",
    "name": "無頭士兵",
    "words": "{0}閣下，",
    "voice": "vo_adv_1404001_002",
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "無頭士兵",
    "words": "\\n感謝您",
    "voice": null,
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "無頭士兵",
    "words": "今天接受反叛者黎薩‧費妲的",
    "voice": null,
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "無頭士兵",
    "words": "\\n移送任務。",
    "voice": null,
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我在這裡。",
    "voice": "vo_adv_1404001_003",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……放心吧，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "因為我什麼都做不到。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "無頭士兵",
    "words": "已對黎薩小",
    "voice": "vo_adv_1404001_004",
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "無頭士兵",
    "words": "……",
    "voice": null,
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "無頭士兵",
    "words": "對這個人",
    "voice": null,
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "無頭士兵",
    "words": "施加了抗咒術的術式。",
    "voice": null,
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "無頭士兵",
    "words": "\\n另外，",
    "voice": null,
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "無頭士兵",
    "words": "武器與皇家裝備也都已經沒收，",
    "voice": null,
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "無頭士兵",
    "words": "\\n所以她應該",
    "voice": null,
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "無頭士兵",
    "words": "不會對{0}閣下造成危害。",
    "voice": null,
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "無頭騎士",
    "words": "這次的「放逐」處罰",
    "voice": "vo_adv_1404001_005",
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "無頭騎士",
    "words": "是出於薇歐莉特殿下的慈悲。",
    "voice": null,
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "無頭騎士",
    "words": "\\n妳要清楚這一點，",
    "voice": null,
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "無頭騎士",
    "words": "途中絕對不要惹出任何麻煩。",
    "voice": null,
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "無頭騎士",
    "words": "\\n明白了嗎？",
    "voice": null,
    "unit_id": 52611
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "嗯，",
    "voice": "vo_adv_1404001_006",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我明白。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……那就",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "麻煩你囉。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "background",
    "bg_id": "502430"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "移送任務……",
    "voice": "vo_adv_1404001_007",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n實際上就是趁著放逐的機會，順便",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "把罪人公開示眾吧。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我是有聽說會有同行者，",
    "voice": "vo_adv_1404001_008",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n但沒想到會是你啊。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "你還記得",
    "voice": "vo_adv_1404001_009",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那時候的約定呢。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……那孩子",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "過得還好嗎……？",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……這樣啊。",
    "voice": "vo_adv_1404001_010",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "畢竟從小就一直在一起了，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "會那樣也沒辦法呢。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "看樣子，",
    "voice": "vo_adv_1404001_011",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "你現在也還在照顧牠吧……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "果然有把牠託付給你真是太好了。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "雖然很抱歉給你添了麻煩，",
    "voice": "vo_adv_1404001_012",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n但能聽到那孩子的事，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我也稍微放心了。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "background",
    "bg_id": "502440"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "途中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}與黎薩",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n短暫停留在某個村子裡當作休息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但是……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女殭屍",
    "words": "是黎薩大人……",
    "voice": "vo_adv_1404001_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女殭屍",
    "words": "\\n竟然要被放逐，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女殭屍",
    "words": "好可憐……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性殭屍",
    "words": "妳在說什麼！",
    "voice": "vo_adv_1404001_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性殭屍",
    "words": "那個女人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性殭屍",
    "words": "不只背叛了這個國家，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性殭屍",
    "words": "\\n還把這個世界搞得亂七八糟的喔！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性殭屍",
    "words": "\\n一般來說要處刑才對吧……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女殭屍",
    "words": "雖然是那樣……！",
    "voice": "vo_adv_1404001_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女殭屍",
    "words": "\\n但黎薩大人確實很優秀吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女殭屍",
    "words": "\\n姑且不論現在，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女殭屍",
    "words": "畢竟以前的薇歐莉特殿下，說實話很不可靠……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………",
    "voice": "vo_adv_1404001_016",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "村民們",
    "words": "「沒想到三魔姬屬竟然會做這種事……」\\n「黑暗精靈族也墮落了啊。」\\n「看她那表情。一定根本沒在反省啦……」",
    "voice": "vo_adv_1404001_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那是理所當然的反應吧。",
    "voice": "vo_adv_1404001_018",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "考量到我至今做過的事，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n沒被處刑才奇怪嘛。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "明明如此，",
    "voice": "vo_adv_1404001_019",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "竟然把讓人陷入假死狀態沉睡當成處罰。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那孩子真是的……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "這種處罰，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n根本就像在說這有什麼內幕一樣吧。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "或許是多虧我過去的所作所為吧。",
    "voice": "vo_adv_1404001_020",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n別看我這樣，以前",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我可是作為三魔姬屬之首四處奔走喔。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "一邊留心一族的事，一邊對政治提出意見。",
    "voice": "vo_adv_1404001_021",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n有需要的話，就到各地視察，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "整理意見書，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "甚至還會進行幕後協調。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "還有……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "安撫剎鬼、",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "鼓勵雪野，也算是我的工作吧？",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那時候的我也算是相當忙碌，",
    "voice": "vo_adv_1404001_022",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n雖然也有很多令人傻眼的事……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "但現在想起來，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "倒也不算太糟呢。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "當然，",
    "voice": "vo_adv_1404001_023",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "你放心，我可沒打算事到如今還說什麼「想回去」。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "畢竟，結果",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那些也都因為我跟隨幻境龍后，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "而全部化為泡影了。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……從別人的角度來看，",
    "voice": "vo_adv_1404001_024",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我一定是備受眷顧的",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "吧。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n地位也好，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "工作也好，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "一切都是。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……可是……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈族男性",
    "words": "黎薩‧費妲……",
    "voice": "vo_adv_1404001_025",
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈族男性",
    "words": "把我們一族搞得一團糟！",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈族男性",
    "words": "\\n都是因為妳失控，",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈族男性",
    "words": "我們才……！",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………",
    "voice": "vo_adv_1404001_026",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "唔……！",
    "voice": "vo_adv_1404001_027",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……你",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "為什麼……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈族男性",
    "words": "誒……",
    "voice": "vo_adv_1404001_028",
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈族男性",
    "words": "都是因為你保護那女人！",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈族男性",
    "words": "\\n我們一族的恥辱……",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈族男性",
    "words": "趕快滾出這個村子！",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………",
    "voice": "vo_adv_1404001_029",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "你",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "為什麼要保護我？",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "因為……",
    "voice": "vo_adv_1404001_030",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那是沒辦法的吧。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n實際上，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "的確是因為我，而讓黑暗精靈族的",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n立場變成趨近於最糟的狀態。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "從他們的角度來看，",
    "voice": "vo_adv_1404001_031",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我讓他們至今建立起來的地位都失去了，是最差勁的女人。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n光是沒被刺，我就覺得謝天謝地了。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不如說，",
    "voice": "vo_adv_1404001_032",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "你才是根本沒有保護我的道理才對啊。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "畢竟原本是敵對關係，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "反正我也無法抵抗，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n你明明只要默默看著就好了。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………",
    "voice": "vo_adv_1404001_033",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "你真的是個爛好人呢。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我非常明白薇歐莉特公主為什麼信任你了。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那至少",
    "voice": "vo_adv_1404001_034",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "給我看看傷口吧。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n療傷藥我還是有帶著的。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……姑且說一下，",
    "voice": "vo_adv_1404001_035",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不要",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "看我這樣，我對藥學可是很拿手的。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n因為在這裡，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "醫學上的事",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "是我們一族的看家本領。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "跟蘭德索爾的精靈族一樣，",
    "voice": "vo_adv_1404001_036",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我們這類古老的知識是很豐富的喔。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "雖然這裡也有很多陰森可怕的東西，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n但我不會做奇怪的事的，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "要是你能相信我，我會很高興的。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……說的也是呢。",
    "voice": "vo_adv_1404001_037",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n沒必要對",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "像你這樣的人說啊。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……好，",
    "voice": "vo_adv_1404001_038",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "治療完成。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不需要道謝。",
    "voice": "vo_adv_1404001_039",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n因為說到底，原本就是",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我的錯，你只是被我牽連而已。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "總之，",
    "voice": "vo_adv_1404001_040",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我們還是快點離開這個村子比較好吧。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "畢竟也會給村民添麻煩……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "都沒怎麼能休息到，對不起。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "background",
    "bg_id": "502290"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "到了呢。",
    "voice": "vo_adv_1404001_041",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "謝謝你跟我一起來到這裡。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "雖然還受了傷，",
    "voice": "vo_adv_1404001_042",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "總覺得一團糟……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "但說真的，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "你是同行者，讓我的心情非常輕鬆。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "什麼？",
    "voice": "vo_adv_1404001_043",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………",
    "voice": "vo_adv_1404001_044",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我說過了吧。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "說因為希望世界能為自己而",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "存在──",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……我之前",
    "voice": "vo_adv_1404001_045",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "應該是那樣想的才對啦……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "background",
    "bg_id": "502460"
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "妳曾經說過",
    "voice": "vo_adv_1404001_046",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "「希望世界能為自己而存在」。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "並且還說，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "這份願望若是與我們在一起，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "是絕對無法",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "實現的。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "或許，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "確實是那樣沒錯。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "但是。",
    "voice": "vo_adv_1404001_047",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "妳的那份念想……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "妳內心的那份飢渴。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "其實，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "就算真的得到了世界，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n也永遠無法填滿的，不是嗎？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "請務必面對妳所生存的世界──",
    "voice": "vo_adv_1404001_048",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "以及，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "面對妳自己。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "background",
    "bg_id": "502290"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "被說了那種話之後，",
    "voice": "vo_adv_1404001_049",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "總之我協助了他，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n也和阿爾莎特戰鬥了……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "但我果然還是不明白啊。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我的飢渴是從何而來？",
    "voice": "vo_adv_1404001_050",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我其實",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "希望變得如何？",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n明明是自己的事，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "卻感覺像是想抓住雲朵一樣……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "沒有實感。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n表面上認真的我，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "和內心並非如此的我，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "彼此矛盾著……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………",
    "voice": "vo_adv_1404001_051",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……說的也是。",
    "voice": "vo_adv_1404001_052",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "畢竟我讓世界那麼混亂，",
    "voice": "vo_adv_1404001_053",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我根本沒資格和那孩子在一起。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "咦……？",
    "voice": "vo_adv_1404001_054",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "自己的",
    "voice": "vo_adv_1404001_055",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "心情……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……我果然不能理解呢。",
    "voice": "vo_adv_1404001_056",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n你",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "為什麼要幫我到那種地步？",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "是嗎……",
    "voice": "vo_adv_1404001_057",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "你始終很溫柔",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "呢。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我有點羨慕",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "你那一點。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……是啊。",
    "voice": "vo_adv_1404001_058",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "雖然我覺得在這裡安靜度過一生也不賴，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n但那種事",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "對我而言太奢侈了吧。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……既然如此，",
    "voice": "vo_adv_1404001_059",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那我就不客氣地拜託你了。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "雖然時間不長，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "但請多指教囉。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，{0}為了了解黎薩真正的心情，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n便和她一起行動了。",
    "voice": null,
    "unit_id": null
  }
]
