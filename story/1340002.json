    "name": "菲歐",
    "words": "所以不用在意。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "更重要的是，",
    "voice": "vo_adv_1340002_103",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "如果是米奈娃大人",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n賦予的使命，",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我就一定要完成。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n因為我……",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "要成為",
    "voice": "vo_adv_1340002_104",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "獨當一面的",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "嚮導小妖精！",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "……妳有",
    "voice": "vo_adv_1340002_105",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "一顆善心。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "我也會助妳一臂之力。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "以我作為嚮導老君的身分，",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "引導迷途之人。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "謝謝你，",
    "voice": "vo_adv_1340002_106",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "小可可蘿的爸爸！",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "──妖精啊，",
    "voice": "vo_adv_1340002_107",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "感覺如何？",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "真是令人驚訝。",
    "voice": "vo_adv_1340002_108",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……跟另一邊的我一模一樣。",
    "voice": "vo_adv_1340002_109",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "我運用了義體技術。",
    "voice": "vo_adv_1340002_110",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "若是如此至少能夠掩人耳目。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "嗯。",
    "voice": "vo_adv_1340002_111",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "謝謝你──",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "──宙叔叔。",
    "voice": "vo_adv_1340002_112",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "！",
    "voice": "vo_adv_1340002_113",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "奇怪？",
    "voice": "vo_adv_1340002_114",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n對不起，",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "總覺得剛才",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "自然而然就……",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "不……",
    "voice": "vo_adv_1340002_115",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "無妨。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "──祝妳順利達成使命。",
    "voice": "vo_adv_1340002_116",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "棗宙露出溫和的笑容。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n菲歐不知為何對那副表情抱有懷念般的情感。",
    "voice": null,
    "unit_id": null
  }
]
