  {
    "type": "dialogue",
    "name": "旁白",
    "words": "突然顯示在畫面上的「登出」於愛梅斯面前自行啟動。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n因此失去意識的她，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "再次甦醒時──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "呼……",
    "voice": "vo_adv_1340002_000",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "呼……",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這是怎樣……",
    "voice": "vo_adv_1340002_001",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "到底是怎樣……？",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n簡直",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "莫名其妙……！　",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "為什麼我會在現實世界？",
    "voice": "vo_adv_1340002_002",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n這裡到底",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是哪裡？",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n醫院？",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "還是研究所？　",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "最重要的是，",
    "voice": "vo_adv_1340002_003",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這副身體……",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這是澄花的",
    "voice": "vo_adv_1340002_004",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "身體對吧？　",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "幸雨澄花──",
    "voice": "vo_adv_1340002_005",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是「愛梅斯」這個角色的玩家。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "可是",
    "voice": "vo_adv_1340002_006",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "她已經──",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不行。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n完全沒辦法理清思緒！　",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "能夠當作線索的，",
    "voice": "vo_adv_1340002_007",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是這台「mimi」……",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "啊……",
    "voice": "vo_adv_1340002_008",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "啊～",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這是",
    "voice": "vo_adv_1340002_009",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我……",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "菲歐的聲音吧。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n好像是從「mimi」發出來的……",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是變聲功能嗎？",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "至少",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "現在像這樣思考的我，",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "確定是菲歐沒錯。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "從目前的狀況想到的可能性",
    "voice": "vo_adv_1340002_010",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "就只有一個。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "菲歐",
    "voice": "vo_adv_1340002_011",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "從愛梅斯身上登出，",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n進入了幸雨澄花的身體裡。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "重點不在於可能與否，",
    "voice": "vo_adv_1340002_012",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n只是以刪去法得出的",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "結論來看，",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "唯有剩下這個答案。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "也就是說，",
    "voice": "vo_adv_1340002_013",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "只要使用「mimi」，",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "再次……",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "──潛入，",
    "voice": "vo_adv_1340002_014",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "阿斯特朗。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "…………",
    "voice": "vo_adv_1340002_015",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……",
    "voice": "vo_adv_1340002_016",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不行",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "啊。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "到底該怎麼做才好……",
    "voice": "vo_adv_1340002_017",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n在這種地方醒來，",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "也回不去原本的世界……",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "只有我自己一個人……",
    "voice": "vo_adv_1340002_018",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "…………",
    "voice": "vo_adv_1340002_019",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……{0}……",
    "voice": "vo_adv_1340002_020",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……？",
    "voice": "vo_adv_1340002_021",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "震動……",
    "voice": "vo_adv_1340002_022",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這是",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "從「mimi」傳出來的……！？",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n好友",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "來電……？",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n呃、",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我想想……",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這樣嗎？",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這個聲音……！",
    "voice": "vo_adv_1340002_023",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n你……",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是你嗎！？",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "聲音",
    "voice": "vo_adv_1340002_024",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "真的傳過去了……！",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "嗯",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我沒事……",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "沒事？",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n這不算沒事吧，",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我完全搞不清楚是什麼狀況。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你現在",
    "voice": "vo_adv_1340002_025",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "還在「愛梅斯」的身體面前？",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n這就表示身體並沒有",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "消失對吧……",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "嗯，",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這樣的話",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "應該有辦法回去。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "話說回來，",
    "voice": "vo_adv_1340002_026",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "真虧你能連上通訊呢。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n你是怎麼做到的？",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "臉……",
    "voice": "vo_adv_1340002_027",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是說，",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你該不會為了叫醒我，",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n而打算親我吧？",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n什麼？",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你捏了我的臉頰？",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "哦，",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是喔，",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "啊──",
    "voice": "vo_adv_1340002_028",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我好像想像得到。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "可別對我動粗喔。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n畢竟那好歹也是女神的身體。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……",
    "voice": "vo_adv_1340002_029",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "色鬼！",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不管怎樣，",
    "voice": "vo_adv_1340002_030",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "可以跟你聯繫上真是太好了。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "畢竟就連我",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "都束手無策了。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……好。",
    "voice": "vo_adv_1340002_031",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n感覺好像有辦法解決了。",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "雖然依舊弄不清楚狀況，",
    "voice": "vo_adv_1340002_032",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "但如果不行動，",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "就不會有任何改變。",
    "voice": null,
    "unit_id": 52731
