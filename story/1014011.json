    "words": "\\n雖然是個只要打聽一下再實際跑一趟，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就能明白的簡單事件。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n但能迅速找出答案，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "讓美術社的各位感到開心",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嘿嘿。",
    "voice": "vo_adv_1014011_034",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n能聽學長你這樣說，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真讓人心情愉快。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我之前就想說了，",
    "voice": "vo_adv_1014011_035",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我這個人",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "畏畏縮縮，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "能正常對話的",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就只有學長了……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "能像這樣",
    "voice": "vo_adv_1014011_036",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "和學長沉浸在解決事件的餘韻當中，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n對我來說……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "比什麼都重要。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呵呵，",
    "voice": "vo_adv_1014011_037",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "對了學長，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n你知道嗎？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我們兩人，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在這所學校中",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也變成謠言了唷！",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……啊！",
    "voice": "vo_adv_1014011_038",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不、",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不是！",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖說是謠言，",
    "voice": "vo_adv_1014011_039",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但內容並不是……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n關於我和學長之間的關係……！",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "如果和我們商量煩惱，",
    "voice": "vo_adv_1014011_040",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就會替委託人解決困難的雙人組。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n是這樣的謠言。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "對我來說，",
    "voice": "vo_adv_1014011_041",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我本來期待",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "會以偵探搭檔之名讓眾人知曉，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n但現在還……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "感覺像是",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "學校的便利屋一樣。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過，",
    "voice": "vo_adv_1014011_042",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "現實的偵探跟故事中的不同，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n就像整天在調查東西的",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "便利屋一樣嘛。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "即使如此，",
    "voice": "vo_adv_1014011_043",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也多多少少……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在我本以為是灰色青春的每一天裡，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "都加上了一點色彩。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "謝謝你，",
    "voice": "vo_adv_1014011_044",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "學長。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……",
    "voice": "vo_adv_1014011_045",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "總覺得，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "氣氛變得好害臊喔。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "差不多……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "該回家了吧。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "小霧──",
    "voice": "vo_adv_1014011_046",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還在家裡等著我。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦？",
    "voice": "vo_adv_1014011_047",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "小霧……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在我",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "家裡？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這是為什麼……？　",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "算了，",
    "voice": "vo_adv_1014011_048",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "沒差。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "still",
    "still_id": "101401101"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "然後啊，小霧。",
    "voice": "vo_adv_1014011_049",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n站在犯人身處的教室前",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "感到非常緊張的我，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n是學長給了我勇氣。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "小霧",
    "words": "喵～♪",
    "voice": "vo_adv_1014011_050",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "他說：「霞的想法沒錯喔，",
    "voice": "vo_adv_1014011_051",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n因為有我陪妳，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所以別害怕。」",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嘿嘿……♪",
    "voice": "vo_adv_1014011_052",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n學長，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真是帥氣呢～",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然我自稱偵探是有點狂妄，",
    "voice": "vo_adv_1014011_053",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但如果我真的當了偵探，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "學長就是……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我的助手，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "對吧。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "小霧",
    "words": "……喵？",
    "voice": "vo_adv_1014011_054",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "學長他啊，",
    "voice": "vo_adv_1014011_055",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "會好好地聆聽我的想法並回話，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n藉此替我整理思緒。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "簡直就是，",
    "voice": "vo_adv_1014011_056",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "推理小說裡偵探必備的",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手角色呢。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我跟學長，",
    "voice": "vo_adv_1014011_057",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也許很合得來。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n甚至合拍到",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "可以變成推理小說中的主角搭檔一樣！",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……呃，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我的結論跳太快了嗎？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我說，小霧，",
    "voice": "vo_adv_1014011_058",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳覺得呢？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "小霧",
    "words": "喵～嗚～",
    "voice": "vo_adv_1014011_059",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呵呵，",
    "voice": "vo_adv_1014011_060",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "小霧妳不懂對吧？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "對了，",
    "voice": "vo_adv_1014011_061",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "要不要再戴上mimi試試？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "即使只是說想睡覺或想吃飯",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也可以喔。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好，",
    "voice": "vo_adv_1014011_062",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這樣就行了。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "小霧，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我們來聊天吧──",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "小霧",
    "words": "「名偵探小姐",
    "voice": "vo_adv_1014011_063",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小霧",
    "words": "喜歡學長嗎？」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "101401102"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦！？",
    "voice": "vo_adv_1014011_064",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n小、",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "小霧……！？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳剛剛，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "說什麼──",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦？",
    "voice": "vo_adv_1014011_065",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "騙人，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我剛才說的話",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳都理解了？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
