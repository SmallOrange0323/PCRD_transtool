  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]",
    "voice": "vo_adv_6124402_000",
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]噗哈～！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]外面世界的空氣好新鮮啊！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]嗯？",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]怎樣？小伙子。",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]看你一臉茫然的樣子。",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]有什麼不滿嗎？",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]啊啊！？",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]",
    "voice": "vo_adv_6124402_001",
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]哼哼！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]這不是你的腦袋能理解的對吧！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]稱呼我為「從地獄歸來的超級搖滾老爸大人」",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]也可以喔～？",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]怎樣啦，",
    "voice": "vo_adv_6124402_002",
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]一臉感傷的樣子。",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]你這傢伙擺這種臉給我看，我只覺得噁心！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]趕快收起你那掃興的表情！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]聽懂了沒！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]平常的我",
    "voice": "vo_adv_6124402_003",
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]是將靈魂固定在骷髏頭上的，",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]實際上就像是活著一樣喔！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]所以也能跟美女互相碰觸，",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]也能談戀愛，",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]也能結婚喔～♪",
    "voice": null,
    "unit_id": 2415
  }
]
