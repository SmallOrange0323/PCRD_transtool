[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}來到了隔天即將在蘭德索爾舉辦的\\n演唱會現場佈置打工。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……騎士先生。這時候這麼忙，你來這裡有什麼事嗎？",
    "voice": "vo_adv_1054003_000",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊啊，話說回來是有聽說還有一個人要來做佈置兼差的這回事……",
    "voice": "vo_adv_1054003_001",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過怎麼偏偏又是你……為什麼每次都這樣，真是的……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "算了，也無所謂。這邊也是有能給騎士先生做的簡單工作，",
    "voice": "vo_adv_1054003_002",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n你就帶上臂章去向工作人員詢問看看有什麼活可以幹的吧。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "順帶一提我是這個演唱會的營運負責人，",
    "voice": "vo_adv_1054003_003",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n所以有任何問題的話請一定要向我或是工作人員詢問哦。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那麼，",
    "voice": "vo_adv_1054003_004",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就請你快點去工作吧。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n一直工作到午休以前都不可以休息哦！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "紡希小姐──！第三首歌的照明是藍色的對嗎～？",
    "voice": "vo_adv_1054003_005",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是的！前奏開始前都是藍色系的！",
    "voice": "vo_adv_1054003_006",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n煙霧只要設置在腳邊就好！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "紡希小姐！關於麥克風支架……",
    "voice": "vo_adv_1054003_007",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "在第三首歌結束後會插入談話的部分，請在這個時候處理！",
    "voice": "vo_adv_1054003_008",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呼……",
    "voice": "vo_adv_1054003_009",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "果然還是有點累呢……",
    "voice": "vo_adv_1054003_010",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦？騎士先生。怎麼了嗎？",
    "voice": "vo_adv_1054003_011",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怎、怎麼了這是！？突然間……",
    "voice": "vo_adv_1054003_012",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "雖然一般來說都是送飲料的……",
    "voice": "vo_adv_1054003_013",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過也好啦。我收下了。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊啊，不好意思……",
    "voice": "vo_adv_1054003_014",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這是什麼好甜啊！而且還黏糊糊的……",
    "voice": "vo_adv_1054003_015",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過辛苦了一番，這樣剛剛好感覺還挺不錯的……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "謝謝了。多虧了你讓我有空喘口氣。",
    "voice": "vo_adv_1054003_016",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "為什麼要這麼吃驚啊！？　",
    "voice": "vo_adv_1054003_017",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n看見我這麼老實的樣子很稀奇嗎！？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "先說好，休息時間還沒到喔！",
    "voice": "vo_adv_1054003_018",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "請騎士先生馬上回去工作。好了，快去快去！",
    "voice": "vo_adv_1054003_019",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……不過，還為我操心……真的很謝謝你。",
    "voice": "vo_adv_1054003_020",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……啊，走掉了。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "接下來！趕快結束佈置工作也能爭取更多時間，得好好加油了！",
    "voice": "vo_adv_1054003_021",
    "unit_id": 105411
  },
  {
    "type": "background",
    "bg_id": "500032"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當晚，現場佈置工作結束後的演唱會舞台上──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "105400301"
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "１、２、３、４！１、２、３、４！",
    "voice": "vo_adv_1054003_022",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "乾淨俐落，",
    "voice": "vo_adv_1054003_023",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "確認好最後一個姿勢！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "然後樂曲結束以前，維持這個姿勢……！",
    "voice": "vo_adv_1054003_024",
    "unit_id": 105411
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500032"
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呼……",
    "voice": "vo_adv_1054003_025",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "總算把明天的演出曲目，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "全部都跳完了……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不行了……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "動不了了……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我累過頭了嗎……好像都看見騎士先生的幻覺了……",
    "voice": "vo_adv_1054003_026",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n還是收拾一下回去好了……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "本人！？",
    "voice": "vo_adv_1054003_027",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "　",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "為、",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "為什麼你會在這……！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n比起這個，剛才的你全都看見了嗎！？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "明明只有這個絕對不能給任何人看見的說……！",
    "voice": "vo_adv_1054003_028",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "沒辦法，只能在這裡把騎士先生給綁起來說服一番了……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……剛，剛剛的那些，你都聽見了？",
    "voice": "vo_adv_1054003_029",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……那個，要和我一起去吃個飯嗎？",
    "voice": "vo_adv_1054003_030",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n又唱又跳的，肚子就餓起來了。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那個，這頓我請。所以剛才你看到的，",
    "voice": "vo_adv_1054003_031",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n請你不要對任何人說！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "尤其是小望和千歌，絕對要對她們保密！",
    "voice": "vo_adv_1054003_032",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n請和我約定好！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我們約定好了喔。要是敢毀約我就把你綁起來，",
    "voice": "vo_adv_1054003_033",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n倒吊在門前！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "絕對不可以說哦。要是敢對誰說的話，",
    "voice": "vo_adv_1054003_034",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我就把你綁去當魔物的誘餌哦！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過騎士先生好像口風挺緊的，應該沒問題……",
    "voice": "vo_adv_1054003_035",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那個不好意思！這邊來兩碗拉麵――！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "好的，拉麵兩碗――！",
    "voice": "vo_adv_1054003_036",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生有吃過拉麵嗎？很好吃哦！",
    "voice": "vo_adv_1054003_037",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "在拉麵上來之前，我就告訴你我跳舞的理由吧。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "作為負責服裝的我，得插手偶像的舞蹈編排。",
    "voice": "vo_adv_1054003_038",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n為了確實指正，就必須要對舞蹈動作有相當的把握才行。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "唱歌也是。有很多各種各樣的要點必需注意。",
    "voice": "vo_adv_1054003_039",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……但是，唱歌也好跳舞也好，我是慈樂之音裡頭最外行的。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就算舞沒有小望跳得好，歌也沒有千歌來得會唱……",
    "voice": "vo_adv_1054003_040",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我希望能夠盡量離那兩個人更近一點，不管是舞蹈動作或是歌曲，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我也希望能跟她們站在同樣的高度說話。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "即使再怎麼辛苦，也是現在的我必須去做的事情，",
    "voice": "vo_adv_1054003_041",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n如果人們穿上我親手做的衣服後能散發出最燿眼的光芒，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n那我就必須達成！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "而且這次所準備的服裝，可是我的自信之作喔！",
    "voice": "vo_adv_1054003_042",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n那腰間上的緞帶和裙擺的躍動感！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "能看見小望穿上那件服裝華麗地唱歌……",
    "voice": "vo_adv_1054003_043",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n散發出最燿眼的光彩，啊啊……真是棒極了……！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……好厲害？我、我嗎？",
    "voice": "vo_adv_1054003_044",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "才沒有那回事呢！我只是一直在努力而已……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……咦？我、我嗎？",
    "voice": "vo_adv_1054003_045",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n……在騎士先生的眼中，當時的我是閃耀著的嗎？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "什、什、什麼嘛突然間的！",
    "voice": "vo_adv_1054003_046",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n你這樣稱讚我，也不會發生什麼好事喔！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……騎士先生。那個，你剛才說的，是認真的──",
    "voice": "vo_adv_1054003_047",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "──讓你們久等了！這是你們點的兩碗拉麵！",
    "voice": "vo_adv_1054003_048",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……我什麼都沒說。",
    "voice": "vo_adv_1054003_049",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "來了，這就是拉麵哦！趕快趁熱嘗嘗吧！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……我，成為偶像……我，站上真正的舞台……？",
    "voice": "vo_adv_1054003_050",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……我要不要，試著努力看看……",
    "voice": "vo_adv_1054003_051",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n騎士先生都這麼說了……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不不，我終究只是個幕後吧。",
    "voice": "vo_adv_1054003_052",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n就算被人這麼說，也不是馬上就能辦得到的事情……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過……要是我也能和那兩個人一起，同台閃耀……",
    "voice": "vo_adv_1054003_053",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "紡希的心裡面兩種截然不同的心聲相互衝突，\\n{0}一句話也不說就在一旁守候著。",
    "voice": null,
    "unit_id": null
  }
]
