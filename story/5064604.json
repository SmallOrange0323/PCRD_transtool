[
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "聖學祭也有很多攤販呢。",
    "voice": "vo_adv_5064604_000",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "記得「清廉」隊是不公正手段的溫床呢。",
    "voice": "vo_adv_5064604_001",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "結果而言",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "來賓們是留下了深刻的記憶，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但只能說那也是理所當然的。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不不不，",
    "voice": "vo_adv_5064604_002",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "「賢淑」隊的攤販，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n雖然都是外行人，但也沒有比較差喔。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "克蘿依學姐的傲嬌女僕咖啡廳之類的！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": "vo_adv_5064604_003",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "其他還有？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "其他還有……",
    "voice": "vo_adv_5064604_004",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗯，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "沒什麼印象深刻的。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "真是的，",
    "voice": "vo_adv_5064604_005",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "明年乾脆派遣克蘿依去所有攤販好了。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "聽起來很棒耶！",
    "voice": "vo_adv_5064604_006",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "今年是短袖迷你裙的超可愛風格，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n明年就讓她穿雅致古典的正統派女僕裝吧！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這些傢伙自顧自地在說謝什麼啊……",
    "voice": "vo_adv_5064604_007",
    "unit_id": 110813
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110813
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "總而言之明年的聖學祭就翹掉吧。",
    "voice": null,
    "unit_id": 110813
  }
]
