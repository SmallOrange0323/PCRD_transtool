    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "尤其面對規模如此龐大的對手，",
    "voice": null,
    "unit_id": 134411
  },
