  },
  {
    "type": "dialogue",
    "name": "精靈術士２",
    "words": "\\n連締結契約的精靈也開始受到影響了嗎……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "精靈術士２",
    "words": "\\n不快點的話可就糟糕了！",
