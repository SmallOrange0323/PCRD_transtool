    "type": "dialogue",
    "name": "千歌",
    "words": "請退後！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我們先重整陣勢……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
