  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當蘭法等人正在交談時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n千歌等人則自告奮勇前去牽制精靈們。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501205"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "村中察覺到異狀的精靈術士也聚集到了她們身旁，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在戰力上應是勢均力敵。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然而──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "風之精靈啊……",
    "voice": "vo_adv_5202006_000",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n遏止神智錯亂的",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "汝等之同胞吧……！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "background",
    "bg_id": "501205"
  },
  {
    "type": "dialogue",
    "name": "小精靈們",
    "words": "──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "老實說，",
    "voice": "vo_adv_5202006_001",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這種情況很煎熬……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n沒想到當精靈們出現異常時，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n想向它們借用力量會變得這麼困難……！　",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "扭曲的音寵之精靈",
    "words": "──！！！",
    "voice": null,
    "unit_id": 19212
  },
  {
    "type": "dialogue",
    "name": "精靈術士１",
    "words": "炎之精靈啊──",
