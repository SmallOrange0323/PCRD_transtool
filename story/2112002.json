    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……這是個好機會。",
    "voice": "vo_adv_2112002_033",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n就當作交換情報，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "稍微整理一下情況吧。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "說得也是。",
    "voice": "vo_adv_2112002_034",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我們一直像個局外人，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這樣很寂寞呢。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "唔～",
    "voice": "vo_adv_2112002_035",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n如果是什麼很麻煩的事，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我原本是不太想被捲進去啦……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "只是……",
    "voice": "vo_adv_2112002_036",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "照現在稍微聽到璃乃等人的話來看，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n好像也不是可以說這種話的時候了，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "或者說，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "其實我們早就已經被捲進去了吧～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是的。",
    "voice": "vo_adv_2112002_037",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "只要是這個世界的居民，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒有任何人是不會扯上關係的。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n現在要講的就是這種程度的話題。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "認真說起來，",
    "voice": "vo_adv_2112002_038",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們的公會……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "祕密結社【拉比林斯】，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n原本就是為了解開這世界的謎團而活動的。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "像之前，",
    "voice": "vo_adv_2112002_039",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們去保護諾維姆的那件事，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "也是公會活動的一部分。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "結果，",
    "voice": "vo_adv_2112002_040",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "解開世界謎團這件事，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "也是不知不覺間會長妳自己就解決了呢……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不不，",
    "voice": "vo_adv_2112002_041",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要是沒有和真那交手，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我猜到了現在",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我也還是不會完整想起那些事。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n還有自己真實身分之類的。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "再說了，",
    "voice": "vo_adv_2112002_042",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "目前也還留有很多需要去解開的謎題。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……例如她的安全裝置沒有運作之類的……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不過真的沒有想到，",
    "voice": "vo_adv_2112002_043",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "會長的真實身分居然會是這世界創造者的其中一人……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "說得沒錯～！",
    "voice": "vo_adv_2112002_044",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真是「食料餵雞」的感覺呢！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哪裡有雞！？",
    "voice": "vo_adv_2112002_045",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n已經餵過了嗎！？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就說了，",
    "voice": "vo_adv_2112002_046",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是那個意思……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "話說回來，",
    "voice": "vo_adv_2112002_047",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "拉比林斯達小姐和似似花小姐被盯上的原因，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我記得是……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "厄莉絲小姐說",
    "voice": "vo_adv_2112002_048",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「想要創造一個新的世界」。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n為了這個目的，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "需要從七冠的各位身上獲得情報，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n是這麼一回事對吧。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "似乎是沒錯。",
    "voice": "vo_adv_2112002_049",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "確實我們是擁有著",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "創造世界所需的知識與經驗。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不過這些東西",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "並非不可或缺。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "畢竟實際上，",
    "voice": "vo_adv_2112002_050",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "「創造出來的世界」這個答案",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就已經在我們腳下了。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n只要從中歸納思考，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就應該能推測出創造的方法。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我認為她不需要抓住所有人，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "只要有素材就能創造出足夠舒適的世界。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "世界這種東西",
    "voice": "vo_adv_2112002_051",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是那麼簡單就能創造出來的嗎？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那似似花她們",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "還真是厲害耶……",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不過……",
    "voice": "vo_adv_2112002_052",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我有點能夠理解",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那個叫厄莉絲的人的心情。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我也很想得到一個",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "能和弟弟兩人獨處的世界。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "如果是個舒適的地方，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "感覺一定會更讚。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是，",
    "voice": "vo_adv_2112002_053",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就為了這個目的……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n【憤怒‧軍團】的各位",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就遭到對方利用了呢……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "當然，",
    "voice": "vo_adv_2112002_054",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "以對方的立場來看，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n自然是不可能將逐漸恢復記憶的我們",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "放著不管吧。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "畢竟，",
    "voice": "vo_adv_2112002_055",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "世界的創造者……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "應該說，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "身為「阿斯特朗傳奇」開發者的我們，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n如果",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真的恢復記憶的話。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "首先會考慮的，",
    "voice": "vo_adv_2112002_056",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "想必就是將扭曲的世界復原，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n讓各位玩家",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "可以回歸到「現實」那邊去。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……現、",
    "voice": "vo_adv_2112002_057",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "實……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "現實啊……",
    "voice": "vo_adv_2112002_058",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n如果那真的存在，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n那邊的我",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不曉得會是什麼樣子。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姐姐和我",
    "voice": "vo_adv_2112002_059",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "會不會是同一個種族，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可以一起生活呢……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "現實的我，",
    "voice": "vo_adv_2112002_060",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "一定是哥哥真正的妹妹！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在同一個房間裡",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "一起生活著的！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n不會有錯的！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃～？",
    "voice": "vo_adv_2112002_061",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "要說的話，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "應該是「同一個屋簷下」喔～？",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "姐姐等一下！？",
    "voice": "vo_adv_2112002_062",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不要從後面熊抱住我啦，我才剛吃飽！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……嗚欸。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可、凱留",
    "words": "…………",
    "voice": "vo_adv_2112002_063",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呃……",
    "voice": "vo_adv_2112002_064",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳們說的現實，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我還沒辦法清楚想起來……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過拉比林斯達小姐，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳認為要回去那裡比較好是吧？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是的。",
    "voice": "vo_adv_2112002_065",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "現在或許還沒有什麼真實感，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但這裡只是虛假的世界，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "第一件事，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就是該恢復回正常的狀態才行。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可是……",
    "voice": "vo_adv_2112002_066",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要達成這個目的的話，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "該怎麼做……？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我做了許多調查，",
    "voice": "vo_adv_2112002_067",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "關於無法脫離這個世界的原因──",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要解決「米奈娃的禁錮」，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "需要克服兩個課題。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "課題……",
    "voice": "vo_adv_2112002_068",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "說起來，在以前的阿斯特朗裡，",
    "voice": "vo_adv_2112002_069",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n玩家擁有「回到原本世界」",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這項安全指令──",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就像魔法一樣。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n只是那道魔法",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "因為「再構築」而消失了。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "所以，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要復原回來。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "具體來說就是要進行一次更新，",
    "voice": "vo_adv_2112002_070",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "覆寫這個世界。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n所以我們需要前往索爾之塔的控制室，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n需要爬到塔頂，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "做一些工作才行。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦，",
    "voice": "vo_adv_2112002_071",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就只要這樣而已嗎？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不不，",
    "voice": "vo_adv_2112002_072",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n塔裡可是有一堆超強～的魔物。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "而且通往最上層的門也鎖上了，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "並不是什麼輕鬆的工作喔。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那麼，",
    "voice": "vo_adv_2112002_073",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這是第一項課題……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "另外一個呢？",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯，",
    "voice": "vo_adv_2112002_074",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "再來……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "為了讓玩家角色可以使用「脫離指令」，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n需要對世界裡的所有人",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "進行個別更新。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "丸加、",
    "voice": "vo_adv_2112002_075",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "餃色……？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "個、",
    "voice": "vo_adv_2112002_076",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "個別耕薪……？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊，",
    "voice": "vo_adv_2112002_077",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我想想，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "更簡單的說法……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就像是打疫苗一樣吧。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "打疫苗……",
    "voice": "vo_adv_2112002_078",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "意思就是說，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "作為以防萬一的措施，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n需要先重新做好身體是吧。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哇啊，",
    "voice": "vo_adv_2112002_079",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我不要打針～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "放心吧，",
    "voice": "vo_adv_2112002_080",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "小鈴。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n只要習慣後其實就不可怕了喔。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不不，",
    "voice": "vo_adv_2112002_081",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "小栞妳或許是不怕啦……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可是……",
    "voice": "vo_adv_2112002_082",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "要幫整個世界的人",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "打疫苗的話，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不就要花上幾百萬次不只……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對、",
    "voice": "vo_adv_2112002_083",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對呀。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這麼做的話",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不曉得要花上多少時間……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯～",
    "voice": "vo_adv_2112002_084",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "只要大家同心協力，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "總會有辦法的。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n畢竟目前為止，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "已經完成七成左右了。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦？",
    "voice": "vo_adv_2112002_085",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "而且說起來，",
    "voice": "vo_adv_2112002_086",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "打疫苗又不是只限於皮下注射而已。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "只要能夠有效果，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "口服也是可以的。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
