    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果是那種甜～甜的藥就好了……",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯，",
    "voice": "vo_adv_2112002_090",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我的確是這麼做了。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？",
    "voice": "vo_adv_2112002_091",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "請大家吃的那些可麗餅，",
    "voice": "vo_adv_2112002_092",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n就是藥物，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "也就是「個別更新」了。",
