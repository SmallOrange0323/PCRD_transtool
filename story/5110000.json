[
  {
    "type": "background",
    "bg_id": "500033"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一片祥和的蘭德索爾",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正在盛大舉行著自古以來的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n例行建國慶典「女神祭典」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "公主貪吃佩可和{0}一起",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到慶典進行視察。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊啊，",
    "voice": "vo_adv_5110000_000",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "果然很棒呢……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n城鎮上的人們能帶著笑容過日子。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "當回公主後",
    "voice": "vo_adv_5110000_001",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然經歷了很多辛苦的事，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過大家的幸福是最重要的！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "啊──！",
    "voice": "vo_adv_5110000_002",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "是陛下──！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "陛下──！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗨──！",
    "voice": "vo_adv_5110000_003",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "要盡情享受慶典喔──！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "喔喔，",
    "voice": "vo_adv_5110000_004",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "陛下……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "沒想到有幸在這裡親眼見到您……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我已經沒有遺憾了……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呵呵，",
    "voice": "vo_adv_5110000_005",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "千萬別這麼說。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "明年我還會再來，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "到時候再見面吧。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……咦，",
    "voice": "vo_adv_5110000_006",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "從那邊的攤販傳來不可思議的香味……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n好像是異國料理呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好想吃……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "現在還在視察中……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也、",
    "voice": "vo_adv_5110000_007",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也是呢！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那我們快去買吧，{0}！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "等等，",
    "voice": "vo_adv_5110000_008",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "陛下！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "請不要離我們太遠！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "\\n啊……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "真是隨心所欲啊。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "\\n隨從甚至還是個普通少年，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "真令人困擾。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "不能這麼說。",
    "voice": "vo_adv_5110000_009",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "他可是最理解陛下的人，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "\\n而且親民",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "正是陛下的魅力。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "話是這麼說沒錯，",
    "voice": "vo_adv_5110000_010",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "但是作為騎士團的一員，果然還是會擔心。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "\\n萬一陛下遭遇不測……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "你想太多了。",
    "voice": "vo_adv_5110000_011",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "別說是一般的壞蛋，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "\\n就連我們團員全部一起出擊，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "\\n都不會是陛下的對手。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "現在我們的工作，",
    "voice": "vo_adv_5110000_012",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "\\n就是讓陛下和城鎮的人們",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "能夠無憂無慮地",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "好好享受慶典。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "我覺得",
    "voice": "vo_adv_5110000_013",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "這樣就是在報答",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "\\n為蘭德索爾帶來和平的",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "陛下。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "……也",
    "voice": "vo_adv_5110000_014",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "是呢。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "隊長，",
    "voice": "vo_adv_5110000_015",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "能夠耽誤您一點時間嗎？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "怎麼了？",
    "voice": "vo_adv_5110000_016",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "是發生事件了嗎？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "不是，",
    "voice": "vo_adv_5110000_017",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "雖然不到那種程度。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "\\n",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "不過，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "有人回報在街上目擊可疑人士，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "\\n另外還",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "收到報告說",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "有發生一些小騷動。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "再來就是",
    "voice": "vo_adv_5110000_018",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "收到了幾件通報",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "\\n表示和同行者走散了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "雖然都不是嚴重的案件，",
    "voice": "vo_adv_5110000_019",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "\\n但是",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "數量太多──",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎麼了嗎？",
    "voice": "vo_adv_5110000_020",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "嗚哇！陛、",
    "voice": "vo_adv_5110000_021",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "陛下……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "回來得真快……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "\\n東西都已經買好了嗎？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是的，",
    "voice": "vo_adv_5110000_022",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "買了好多好吃的東西☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我也買了大家的份，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們邊吃邊逛吧！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "呃、",
    "voice": "vo_adv_5110000_023",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "可是……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "謝謝您，陛下。",
    "voice": "vo_adv_5110000_024",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "很榮幸能與您同行。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "我們走吧。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "聽好了，",
    "voice": "vo_adv_5110000_025",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "這件事別傳到陛下耳裡，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "我們自己解決。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "也許民眾只是對慶典感到太興奮而引起糾紛，",
    "voice": "vo_adv_5110000_026",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "\\n或只是在人潮中走散而已，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "\\n我不想",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "讓陛下擔心。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "是！",
    "voice": "vo_adv_5110000_027",
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "遵命！",
    "voice": "vo_adv_5110000_028",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "希望",
    "voice": "vo_adv_5110000_029",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "真的什麼都不會發生……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……",
    "voice": "vo_adv_5110000_030",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "──謝謝惠顧──！",
    "voice": "vo_adv_5110000_031",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呼，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "賣得超級好呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n祈梨，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "趁現在把香腸都烤起來。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗚……",
    "voice": "vo_adv_5110000_032",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我怎麼會落到這個地步……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我做不下去啦混蛋！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唉……",
    "voice": "vo_adv_5110000_033",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "好想去看",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "慈樂之音演唱會……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "本來還想把特地為了這天存的零用錢，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呀哈──！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "地全部用掉……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然我懂妳的心情，",
    "voice": "vo_adv_5110000_034",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但抱怨的話不要對我說，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n去找突然消失、翹掉這個攤販生意的傢伙說。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就因為哪裡都找不到這傢伙，我才這麼辛苦啊！",
    "voice": "vo_adv_5110000_035",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n在工作的時候突然搞消失",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是在想什麼！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "都是因為他，我才會被叫來這裡……",
    "voice": "vo_adv_5110000_036",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "現在老大不在，所以才被小看了啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這只能問本人了。",
    "voice": "vo_adv_5110000_037",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "再怎麼想也無濟於事，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就做好我們該做的──",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊啊──！",
    "voice": "vo_adv_5110000_038",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "在那裡，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那傢伙在那裡！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "咦，",
    "voice": "vo_adv_5110000_039",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真的假的啊？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "翹掉工作在那邊閒晃……",
    "voice": "vo_adv_5110000_040",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n可別想逃！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "欸，",
    "voice": "vo_adv_5110000_041",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "等等，祈──",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n那傢伙，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "自己這樣不也翹班了嗎。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過，",
    "voice": "vo_adv_5110000_042",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "一般來說翹班的話不會這麼大搖大擺地讓人找到吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……希望不是什麼麻煩事就好。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500584"
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "大家──！",
    "voice": "vo_adv_5110000_043",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "謝謝你們今天來聽演唱會──！",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "慶典才剛剛開始，",
    "voice": "vo_adv_5110000_044",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n好好盡情享受吧。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們是",
    "voice": "vo_adv_5110000_045",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "慈樂之音！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們下個演唱會見──！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "哇啊啊啊啊！",
    "voice": "vo_adv_5110000_046",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呼──",
    "voice": "vo_adv_5110000_047",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "恭喜我們第一天非常成功！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是的，",
    "voice": "vo_adv_5110000_048",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "雖然久違地開演唱會讓我很緊張，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但一站上舞台，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "緊張感就一掃而空了。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "因為新歌跟表演，",
    "voice": "vo_adv_5110000_049",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "還有服裝跟演出，",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n都忍不住想趕快公開而心癢癢的呢。",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "觀眾們的反應也很不錯，",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是最棒的起跑狀態喔。",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "慶典期間",
    "voice": "vo_adv_5110000_050",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有好幾次的演出呢。",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們別鬆懈，下次也要加油！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "也是呢。",
    "voice": "vo_adv_5110000_051",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n時不時注意騎士先生有沒有在觀眾席上的小動作也得小心一點，",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n對吧，小望？",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "什什……！",
    "voice": "vo_adv_5110000_052",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我覺得自己是有小心的耶……",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可是",
    "voice": "vo_adv_5110000_053",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "給他門票的時候，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "他說今天要當貪吃佩可小姐的隨從，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n所以不能來，不是嗎？",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我、",
    "voice": "vo_adv_5110000_054",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我在想",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "他有沒有可能把行程調整一下，",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n然後就來看我們……",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳們兩個也很在意吧？",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這、",
    "voice": "vo_adv_5110000_055",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這個，",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "對我來說騎士先生怎麼樣都不重要，",
    "voice": "vo_adv_5110000_056",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n雖然他如果來了至少是能幫我們炒熱演唱會氣氛啦？",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "比起這個，",
    "voice": "vo_adv_5110000_057",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我們快點換衣服去慶祝吧！",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n因為還是第一天，",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就我們三人簡單地慶祝一下今天的成功──",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "啊！",
    "voice": "vo_adv_5110000_058",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "太好了……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "妳們三位",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "都沒事吧？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "問我們有沒有事……",
    "voice": "vo_adv_5110000_059",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是發生了什麼事嗎？",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "不是什麼大事，",
    "voice": "vo_adv_5110000_060",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "只是聽說舞台周圍有奇怪的傢伙出現。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n為了不讓三位出事，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "所以工作人員正在巡邏。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那真是令人困擾呢……",
    "voice": "vo_adv_5110000_061",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那麼，",
    "voice": "vo_adv_5110000_062",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "找到那位可疑人士了嗎？",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "不，",
    "voice": "vo_adv_5110000_063",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "這倒是還沒……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "明天演唱會還會繼續舉辦。",
    "voice": "vo_adv_5110000_064",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "保險起見",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我也一起過去看看。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "沒辦法呢。",
    "voice": "vo_adv_5110000_065",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這樣的話也需要負責捕獲的人對吧。",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我也一起去，",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "千歌。",
    "voice": null,
