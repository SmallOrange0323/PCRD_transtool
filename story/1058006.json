[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}！\\n",
    "voice": "vo_adv_1058006_000",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "阿囉哈～☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你好嗎！",
    "voice": "vo_adv_1058006_001",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "特地把你叫出來，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n抱歉喔～？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘻嘻，今天天氣真好呢！",
    "voice": "vo_adv_1058006_002",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為天氣有點熱，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n冰淇淋吃起來超好吃喔☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你看！",
    "voice": "vo_adv_1058006_003",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "無論哪種口味都讓我難以取捨，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n所以我要把它們全都放上甜筒！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我稱霸全口味了喔～！",
    "voice": "vo_adv_1058006_004",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "冰淇淋的顏色五花八門的，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n非常好看呢♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我好像有點太過貪心，",
    "voice": "vo_adv_1058006_005",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n堆疊的冰淇淋已經超過了我的身高！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "太讚了吧！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，我看不到前面了！",
    "voice": "vo_adv_1058006_006",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是{0}吧，\\n請回答我！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是的，",
    "voice": "vo_adv_1058006_007",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你好～！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你最近都簡稱我為『佩可』呢，",
    "voice": "vo_adv_1058006_008",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n{0}♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "感覺好像更親暱了，我很開心喔～",
    "voice": "vo_adv_1058006_009",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我也可以\\n省略{0}的名字嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊哈哈。",
    "voice": "vo_adv_1058006_010",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒問題啦～我的腸胃",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n可是鍛練過的！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "即使世界毀滅了，",
    "voice": "vo_adv_1058006_011",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我也不會吃壞腸胃……☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "冰淇淋要是吃太多，",
    "voice": "vo_adv_1058006_012",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n身體確實會冷下來呢～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是從中攝取的卡路里會瞬間在體內燃燒，",
    "voice": "vo_adv_1058006_013",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "完美地將體溫維持住～☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唉唷唷……",
    "voice": "vo_adv_1058006_014",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你等一下啦，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n跟你說話害我分心，冰淇淋塔快要倒了！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "冰淇淋",
    "voice": "vo_adv_1058006_015",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n要是掉到地上就悲劇了！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我現在就把它吃掉，",
    "voice": "vo_adv_1058006_016",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嚼嚼嚼♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呼哈，好吃～☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哎呀！？",
    "voice": "vo_adv_1058006_017",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n都是因為突然吃冰的東西，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n冰上了頭頂！ 頭好痛啊！？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，但是我很滿足……",
    "voice": "vo_adv_1058006_018",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "發明冰淇淋的人簡直是天才，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n人類的救世主呢～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唉唷，嘴巴沾到了～",
    "voice": "vo_adv_1058006_019",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我用手帕擦擦喔。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘻嘻，我真不像話呢……♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唉唷，",
    "voice": "vo_adv_1058006_020",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我可不是專程來吃冰淇淋的喔！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "今天是為了之前商量好的事情，",
    "voice": "vo_adv_1058006_021",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n要到政府機關提出創辦公會的申請書！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘻嘻。",
    "voice": "vo_adv_1058006_022",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n{0}要跟我一起想公會名稱，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還要幫我很多忙喔。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "跟他人一起做些什麼事～",
    "voice": "vo_adv_1058006_023",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我覺得非常快樂呢♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "正因為如此。",
    "voice": "vo_adv_1058006_024",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我才有想要",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n創辦公會的念頭。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我一直四處旅行，",
    "voice": "vo_adv_1058006_025",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n過著流浪的生活。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但我果然還是想要有個『歸宿』。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然創辦公會所需的資金，",
    "voice": "vo_adv_1058006_026",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n會用盡我所存的旅費……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但工作再賺就好了。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "總之……",
    "voice": "vo_adv_1058006_027",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n應該沒什麼問題的。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是我如果被政府機關的人看見，可能會引起騷動的。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以我希望{0}",
    "voice": "vo_adv_1058006_028",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n能幫我提交文件就可以。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為{0}說自己喪失記憶，",
    "voice": "vo_adv_1058006_029",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n所以我想困難的事情你大概做不來。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因此你只要把文件交給辦事窗口的人就好了。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我也會跟你一起進去政府機關，",
    "voice": "vo_adv_1058006_030",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過我會一邊遮住臉，在遠處待命。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果你遇到困難，",
    "voice": "vo_adv_1058006_031",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n要跟我打個信號喔。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "作戰內容大致是這樣，",
    "voice": "vo_adv_1058006_032",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "OK嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼，",
    "voice": "vo_adv_1058006_033",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n作戰開始吧～♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "公務人員",
    "words": "是的。",
    "voice": "vo_adv_1058006_034",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "公務人員",
    "words": "\\n您的文件，",
