  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "墨丘利度假村啊……",
    "voice": "vo_adv_1403003_001",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n當然，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "我都「看過了」所以很清楚呢？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "也算不錯嘛～？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "什麼～？",
    "voice": "vo_adv_1403003_002",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n心情還是",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "超級不開心的啊？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "所以呢～",
    "voice": "vo_adv_1403003_003",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "快點，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "還在發什麼呆？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "為了讓我心情變好，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "拿杯果汁過來啊♪",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……",
    "voice": "vo_adv_1403003_004",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "哼哼，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "還不錯啦？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n不過這種程度",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "還沒辦法讓我心情變好♪",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "來，",
    "voice": "vo_adv_1403003_005",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "再來用那邊的扇子幫我搧風吧？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "為了讓我開心♪",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "嗯，",
    "voice": "vo_adv_1403003_006",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "甚好♪",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "話說，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "其實也不會熱啦──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "真不可",
    "voice": "vo_adv_1403003_007",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "思",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "議♪",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n這樣使喚你",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "感覺相當暢快呢～",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "這是",
    "voice": "vo_adv_1403003_008",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "為什麼呢♪",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n是因為像你剛剛說的，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "我有「心」嗎？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不過，",
    "voice": "vo_adv_1403003_009",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "墨丘利度假村啊──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "明明上次才因為屁股相撲",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "大爆炸了。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n馬上就復活了啊，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "有錢就是不一樣～",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "話",
    "voice": "vo_adv_1403003_010",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "說",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "回",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "來～",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "你居然這樣",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "強硬地把人",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "帶到這種地方，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "就這麼",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "想看我穿泳裝嗎？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "真是",
    "voice": "vo_adv_1403003_011",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "拿你沒辦法♪",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n就破例",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "讓你",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "再靠近一點看也可以喔？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "啊？",
    "voice": "vo_adv_1403003_012",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……",
    "voice": "vo_adv_1403003_013",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "喂。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n你的表情──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n像是在隱瞞什麼，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不對，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "更像是不想惹麻煩",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "的表情呢。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "給我說清楚？",
    "voice": "vo_adv_1403003_014",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n不然我要調整你的腦袋囉？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……",
    "voice": "vo_adv_1403003_015",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "唉。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n「[rub:認知修正‧感官誤認]認知修正‧感官誤認[/rub]」──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "呵呵。",
    "voice": "vo_adv_1403003_016",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n沒辦法正常走路吧？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n想從我手中逃跑，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "還早一百年呢……♪",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "你這麼毫無防備，",
    "voice": "vo_adv_1403003_017",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "很容易駭入真是太好了♪",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n那麼──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n去漂漂河玩一下吧，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "旱鴨子♡",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……真是的，",
    "voice": "vo_adv_1403003_018",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n還想說你在隱瞞什麼，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n居然說",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "「目的地不是墨丘利度假村」？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "「只是因為連接背面世界的『門』在附近，",
    "voice": "vo_adv_1403003_019",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "剛好經過」",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……這種事，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "一開始就老實說啊。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "你也不用被丟去漂漂河了。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "當然囉。",
    "voice": "vo_adv_1403003_020",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……本來",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "是想這麼說……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "畢竟都盡情玩弄你了，",
    "voice": "vo_adv_1403003_021",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "就原諒你吧。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n像是倒著溜滑水道、",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n臨時參賽",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "屁股相撲的非官方比賽之類的♪",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "──所以呢？",
    "voice": "vo_adv_1403003_022",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n會經過墨丘利度假村的",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "「能讓我玩得開心的地方」",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n到底是哪裡？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "background",
    "bg_id": "500360"
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "──呃，",
    "voice": "vo_adv_1403003_023",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n這裡",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不是你家嗎？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……打擾了。",
    "voice": "vo_adv_1403003_024",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n哦……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n原來是這種氛圍……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "可可蘿她們呢？",
    "voice": "vo_adv_1403003_025",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不在家？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "哼～",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
