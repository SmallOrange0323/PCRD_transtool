  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……怎麼辦，",
    "voice": "vo_adv_4012021_001",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "感覺到很強烈的視線。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "對方好像在喃喃說些什麼……？　",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……嗯，",
    "voice": "vo_adv_4012021_002",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "看起來可以用得不錯……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n連熔岩也能凍結的劍？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "毫不在意火焰吐息的鎧甲？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "創造的靈感湧出來了……！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……那個。",
    "voice": "vo_adv_4012021_003",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我是覺得不太可能，但是……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n難不成，露易絲瑪莉，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "妳是把我當成素材了？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "啊！！",
    "voice": "vo_adv_4012021_004",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "不、",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "不是的！？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我一點都沒有想要妳的冰龍羽毛……！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……真心話脫口而出囉。",
    "voice": "vo_adv_4012021_005",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "啊嗚！？",
    "voice": "vo_adv_4012021_006",
    "unit_id": 132312
  }
