[
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "成功了！",
    "voice": "vo_adv_5059203_000",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那個龐然大物",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "消失了呢！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣……",
    "voice": "vo_adv_5059203_001",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就結束了嗎？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不，",
    "voice": "vo_adv_5059203_002",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下還是有感覺到氣息。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n看來應該只是暫時擊退牠了，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n但卻沒有打倒牠。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "原來如此啊──",
    "voice": "vo_adv_5059203_003",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不完全把牠收拾乾淨似乎是不會結束呢。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "既然如此就趕快追上去吧！",
    "voice": "vo_adv_5059203_004",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n如果牠跑到村子去就糟了！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好的……！",
    "voice": "vo_adv_5059203_005",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "絕對不能",
    "voice": "vo_adv_5059203_006",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "再讓任何人感到困擾……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n要是發生什麼事，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就讓在下來解決一切……！　",
    "voice": null,
    "unit_id": 115511
  }
]
