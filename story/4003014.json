    "name": "可可蘿",
    "words": "它的味道是不是",
    "voice": "vo_adv_4003014_021",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如高原的湧泉一般純淨呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "…",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "…咕嚕。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "……咦？",
    "voice": "vo_adv_4003014_022",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "咦咦咦咦咦咦～！！？？",
    "voice": "vo_adv_4003014_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這個水",
    "voice": "vo_adv_4003014_024",
    "unit_id": 106012
  },
  {
