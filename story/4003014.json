    "name": "可可蘿",
    "words": "是的……！",
    "voice": "vo_adv_4003014_025",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下也",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "從未遇過這種飲品……！",
