  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "晚安，",
    "voice": "vo_adv_4010228_000",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n謝謝你願意",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "在這種深夜還過來。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是的。",
    "voice": "vo_adv_4010228_001",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n只是……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "平時常見到的那些幽靈們說",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "想慶祝我的生日。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然讓成為幽靈的人們",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "慶祝誕生之日，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "感覺很複雜……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "他們跟父親一起，",
    "voice": "vo_adv_4010228_002",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還說什麼",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "「女兒的生日就辦得豪華點吧」……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n就變得這麼多人了。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是，",
    "voice": "vo_adv_4010228_003",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "多到感覺可以埋住這個庭園……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但沒事的，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "裡面沒有危險人物。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n他們現在正在各自",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "暢談呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……對不起。",
    "voice": "vo_adv_4010228_004",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n對於看不見的你來說，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是很寂寥的光景吧。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但就是、",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我希望……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你也能來。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……這是我個人",
    "voice": "vo_adv_4010228_005",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "的願望。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝你。",
    "voice": "vo_adv_4010228_006",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這個小盒子……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是、",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "禮物嗎？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我能打開嗎……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……這是",
    "voice": "vo_adv_4010228_007",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……戒指、",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗎？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "設計是圓圓又可愛的骷髏頭。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n比父親還要討人喜歡呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦？",
    "voice": "vo_adv_4010228_008",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "各位，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n……要我",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "戴上戒指？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不是，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但是、",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呀，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "大家",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "怎麼拍手了……！",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那、",
    "voice": "vo_adv_4010228_009",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "感覺周遭都嗨起來了。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "方便的話，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "可以把",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這只戒指……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "戴到我手上嗎？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "──用你的",
    "voice": "vo_adv_4010228_010",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "手。",
    "voice": null,
    "unit_id": 103131
  }
]
