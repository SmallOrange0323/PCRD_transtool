[
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "遭到吸血鬼獵人攻擊的隔天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n雪身穿著禮服，站在全身鏡前欣賞著自己的美。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊，",
    "voice": "vo_adv_1263002_000",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真不敢相信……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n今天的我",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也是這麼美！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "穿上漂亮的禮服，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "又顯得更美！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "世上竟然會有這樣的美存在……",
    "voice": "vo_adv_1263002_001",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這簡直",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就是奇蹟啊。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過……",
    "voice": "vo_adv_1263002_002",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "在看到如此美麗的我之後，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我的心中也產生了欲望呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如你所見，",
    "voice": "vo_adv_1263002_003",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "現在的我",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n即使在世界萬物之中，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也是無可比擬的美，對吧？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但是，",
    "voice": "vo_adv_1263002_004",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我想要",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "再變得更加美麗。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為此，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我想藉由",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "穿著更有魅力的漂亮衣服，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "來進一步襯托我的美。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "話雖如此，",
    "voice": "vo_adv_1263002_005",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我也知道這只是我的癡心妄想。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼可能找得到",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "比身上這件禮服更具魅力的衣服……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……不，",
    "voice": "vo_adv_1263002_006",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "等等。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "對了……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我美麗的腦細胞",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "突然閃過了一個絕妙點子！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "仔細想想，這是很簡單的事。",
    "voice": "vo_adv_1263002_007",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n根本不用特地去找其他衣服……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只要將這件禮服的魅力加以展現，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "所有的問題就迎刃而解了！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我",
    "voice": "vo_adv_1263002_008",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只用了１塊結晶，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就變得這麼美。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如果",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "同時使用３塊結晶，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你覺得會變成怎麼樣？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這樣",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "肯定會讓禮服美上３倍啊！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": "vo_adv_1263002_009",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你害怕我會變得",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "比現在更美是嗎？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這也難怪了，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為沒有人能夠想像",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n超越現在的美會是什麼樣子吧。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "老實說，",
    "voice": "vo_adv_1263002_010",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我也很害怕。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "自己",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "竟然要達到",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "超越這世間所能理解的美……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過，",
    "voice": "vo_adv_1263002_011",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為了美，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "什麼事我都會做。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n因為這正是",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我被賦予的使命！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "事情",
    "voice": "vo_adv_1263002_012",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就是這樣！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n那就馬上來",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "試著同時使用10塊結晶看看吧！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不，",
    "voice": "vo_adv_1263002_013",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我要試！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "禮服啊，展現出",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你真正的美來吧──！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好啦，",
    "voice": "vo_adv_1263002_014",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如何！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n看到變得更美的禮服，你有何感想？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "──呃，",
    "voice": "vo_adv_1263002_015",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真奇怪。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n總覺得看起來跟之前沒什麼兩樣……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "果然是這樣呢……",
    "voice": "vo_adv_1263002_016",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "唔，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "想不到我的美之理論竟然是錯的！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "看來",
    "voice": "vo_adv_1263002_017",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不管同時使用幾塊結晶，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n禮服的外觀都不會改變……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但是，",
    "voice": "vo_adv_1263002_018",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我還是想誇獎自己一下。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為了變得更美，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "願意勇敢挑戰！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那麼，",
    "voice": "vo_adv_1263002_019",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我們稍微去外面走走，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "轉換一下心情吧。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我也想要",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "向蘭德索爾的人們",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "分享我的美麗呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊，",
    "voice": "vo_adv_1263002_020",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "陽光好刺眼……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "對了，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你知道",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "太陽為何會如此耀眼燦爛嗎？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那是因為",
    "voice": "vo_adv_1263002_021",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我長得太美，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "讓它看得臉都紅了！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "太陽也是有相當",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可愛的一面呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "嗯……？",
    "voice": "vo_adv_1263002_022",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "那個女孩子……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "真不敢相信，",
    "voice": "vo_adv_1263002_023",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "她怎麼會美成這樣……！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "\\n讓我看得目不轉睛！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哎呀，",
    "voice": "vo_adv_1263002_024",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "街上的人們",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "全都直盯著我看呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這也是情有可原的。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "她簡直就是活生生的藝術品……！",
    "voice": "vo_adv_1263002_025",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "\\n光只是看著她，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "就讓人心動不已！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "\\n這是我第一次",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "有這種感覺……！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "……就是因為這樣，",
    "voice": "vo_adv_1263002_026",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "讓我好想獨自占有她。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "\\n完全不想讓其他人看見她的美……！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……你這麼一說，",
    "voice": "vo_adv_1263002_027",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "的確是呢。總覺得氛圍有點古怪。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "感覺似乎跟平常有哪裡不太一樣……？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "像這樣的美……",
    "voice": "vo_adv_1263002_028",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "我不想讓給任何人……！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "\\n只有我能夠擁有",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "欣賞那份美的權利！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "居民3",
    "words": "妳在說什麼夢話！",
    "voice": "vo_adv_1263002_029",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "居民3",
    "words": "\\n我絕不允許",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "居民3",
    "words": "除了我以外的人直盯著她看！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "啊啊，",
    "voice": "vo_adv_1263002_030",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "我受夠了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "妳煩不煩啊！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "\\n如果妳敢來妨礙我……！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "居民3",
    "words": "啊，好痛！？",
    "voice": "vo_adv_1263002_031",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "居民3",
    "words": "妳打我……！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "居民3",
    "words": "\\n既然這樣，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "居民3",
    "words": "我也要打回去！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "什麼……！？",
    "voice": "vo_adv_1263002_032",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這到底是",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼一回事！？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n就算我再怎麼美，這未免也太──",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "──唔",
    "voice": "vo_adv_1263002_033",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "！？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "現在又怎麼了……！？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我突然",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有一種很不好的預感……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "吸血鬼之力",
    "voice": "vo_adv_1263002_034",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "從中湧現而出……！？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n……原來如此，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是那些結晶的關係嗎！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為同時用了好幾塊結晶，",
    "voice": "vo_adv_1263002_035",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "禮服整個失控了！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "然後，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "街上的人們",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "都被它給魅惑住了！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "連我也想不到會是這種情況……",
    "voice": "vo_adv_1263002_036",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "吸血鬼的禮服",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "竟然具有",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這般力量……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "我要把蘭德索爾的人們全都打飛！",
    "voice": "vo_adv_1263002_037",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "\\n因為只有我",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "能夠欣賞那女孩的美！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "喝啊！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "大家",
    "voice": "vo_adv_1263002_038",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "都殺氣騰騰的……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "再這樣下去，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "蘭德索爾的人們會為了得到我",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "而相互爭執……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如果變成那樣，",
    "voice": "vo_adv_1263002_039",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我或許就成了傾國的美人！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哎呀，",
    "voice": "vo_adv_1263002_040",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這種情況要是持續下去，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "感覺後果不堪設想呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你沒有受到魅惑的影響，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真是不幸中的大幸！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過話說回來，",
    "voice": "vo_adv_1263002_041",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為什麼你沒事呢？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……喔，",
    "voice": "vo_adv_1263002_042",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為你和伊莉亞相處了很長一段時間，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n可能已經對吸血鬼有了抵抗力",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是嗎，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "原來如此呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "一般人應該大多",
    "voice": "vo_adv_1263002_043",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "都對魅惑沒有抵抗力……",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "再這樣下去，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "蘭德索爾搞不好真的會滅亡呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……我",
    "voice": "vo_adv_1263002_044",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不喜歡這樣。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如果是因為我太過美麗，",
    "voice": "vo_adv_1263002_045",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "而導致蘭德索爾滅亡的話，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n那也是沒辦法的事。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這我可以接受。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "然而，",
    "voice": "vo_adv_1263002_046",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如果是因為失控的禮服",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n讓蘭德索爾面臨危機這種事，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我可不喜歡。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "再說……",
    "voice": "vo_adv_1263002_047",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我最沒有辦法接受的是，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "禮服竟然比我本人還來得搶眼！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這種事",
    "voice": "vo_adv_1263002_048",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我絕不允許！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n說到底，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "衣服的存在就只是為了襯托出我的美罷了。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我不會讓禮服",
    "voice": "vo_adv_1263002_049",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "來妨礙我的……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n哪怕是吸血鬼之力，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也沒有辦法阻止我！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "而且，",
    "voice": "vo_adv_1263002_050",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我美麗的腦細胞",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n已經想到解決這個情況的妙計了！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "總之，",
    "voice": "vo_adv_1263002_051",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只要想辦法處理這股魅惑就行了吧？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這種事",
    "voice": null,
    "unit_id": 126311
