[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}走在人潮來來往往的蘭德索爾大街上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n此時一個熟悉的少女咆哮聲，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n傳進了他的耳裡……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "不過──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "天樓霸斷劍～！！！",
    "voice": "vo_adv_1061005_000",
    "unit_id": 106113
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "男子1、男子2",
    "words": "呀啊啊啊啊啊啊～！！！",
    "voice": "vo_adv_1061005_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "剛才那是怎麼回事！？",
    "voice": "vo_adv_1061005_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "有人飛出去了耶……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "差不多到此為止好了。",
    "voice": "vo_adv_1061005_003",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哼哼，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "如何！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "要認輸了嗎！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "男子1、男子2",
    "words": "我、",
    "voice": "vo_adv_1061005_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男子1、男子2",
    "words": "我認輸～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男人1",
    "words": "已經足夠了我很明白了是我們不對～！",
    "voice": "vo_adv_1061005_005",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男人2",
    "words": "非常抱歉我不該勒索他人的～！",
    "voice": "vo_adv_1061005_006",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "很好！",
    "voice": "vo_adv_1061005_007",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "既然有反省，就原諒你們！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n今後別再當什麼壞蛋了，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "記得要當個好人啊！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "男子1、男子2",
    "words": "好的～！",
    "voice": "vo_adv_1061005_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯……？",
    "voice": "vo_adv_1061005_009",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喔喔！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "{0}～！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你最近還好嗎？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我過得很好喔！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "關於這點你別擔心！",
    "voice": "vo_adv_1061005_010",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我下手當然有放輕啊？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……雖然不太能保證有輕到多少啦！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "應該沒事吧？",
    "voice": "vo_adv_1061005_011",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "畢竟他們也算是有保住了小命。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "比起那種事！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你在這做什麼啊？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "幫我？",
    "voice": "vo_adv_1061005_012",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哈哈！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你果然是個好人啊！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我可不會被那種傢伙給打敗啊！",
    "voice": "vo_adv_1061005_013",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n不過",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還是謝啦！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你有這份心意就很夠了！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我四處旅行，",
    "voice": "vo_adv_1061005_014",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "一邊和那剛才那種壞蛋戰鬥！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n畢竟只要不斷打倒壞蛋們，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我總有一天就能成為全世界最壞的壞蛋啦！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還有就是……",
    "voice": "vo_adv_1061005_015",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我正在尋找魔物！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n是個強到不行的不妙傢伙！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n如果你有什麼情報，就告訴我吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "萬事拜託啦！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……光只有我對你提出要求好像有點那個啊。",
    "voice": "vo_adv_1061005_016",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "欸，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你有沒有什麼想要我做的事？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "沒錯。",
    "voice": "vo_adv_1061005_017",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "畢竟我們也一起戰鬥了不少次，你算對我有恩。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n所以我想報恩！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "事情就是這樣。",
    "voice": "vo_adv_1061005_018",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你有什麼要求就儘管說吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這樣啊！",
    "voice": "vo_adv_1061005_019",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那就下次再會囉！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "欸欸，別騙人啦！",
    "voice": "vo_adv_1061005_020",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "總有什麼吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "像是讓你煩惱的事之類的！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "來來，",
    "voice": "vo_adv_1061005_021",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "擠壓一下你的腦袋瓜好好想！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "如何？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "有想到什麼嗎？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……沒有？",
    "voice": "vo_adv_1061005_022",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真的沒有嗎？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n畢竟生活起居大小事",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大多由可可蘿包辦了？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我不是說那種啦，",
    "voice": "vo_adv_1061005_023",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是更加……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "類似世界危機那一類的事啦！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "以你那個性，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n照理說會又被什麼糟糕傢伙給牽扯進邪惡野心裡啊！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……總覺得，",
    "voice": "vo_adv_1061005_024",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我現在是不是看起來很像在勒索人啊？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不行不行！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我又沒有打算讓這傢伙覺得困擾！　",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還是算了！",
    "voice": "vo_adv_1061005_025",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "剛才那些話你忘了吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這樣簡直就像我是壞蛋一樣……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……不對，",
    "voice": "vo_adv_1061005_026",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這樣或許正好？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n反正我確實是壞蛋……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔～嗯……",
    "voice": "vo_adv_1061005_027",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你要去哪～？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n該不會是想逃離我吧……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真的是嗎！？",
    "voice": "vo_adv_1061005_028",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好～",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我改變主意了！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n在你老實交代出煩惱之前，我都不會放你走的！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n畢竟我可是壞蛋啊！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好啦！",
    "voice": "vo_adv_1061005_029",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "快從實招來！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n早說早解脫！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喔喔！？",
    "voice": "vo_adv_1061005_030",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "什麼什麼？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "快告訴我！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是嗎，",
    "voice": "vo_adv_1061005_031",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那還真是傷腦筋！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……喂。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你剛才那是在指我吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n即使是我也聽得出來好嗎！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "搞什麼……",
    "voice": "vo_adv_1061005_032",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n畢竟你常常被捲進麻煩事裡，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我才會想說要是有什麼困擾，我可以幫忙。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "結果目前什麼狀況也沒有喔……",
    "voice": "vo_adv_1061005_033",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但這樣也好啦。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "和平是最好的……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "了解！",
    "voice": "vo_adv_1061005_034",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "既然你這麼說，就交給我吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n那麼從現在起，就請你多指教啦！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……好～",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我會加油～！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……怎麼？",
    "voice": "vo_adv_1061005_035",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你說「之後」，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就是「從現在起」吧？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "放心吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我會有一段時間都負責陪在你身旁的！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你很擅長找出有煩惱的人，所以只要和你在一起，",
    "voice": "vo_adv_1061005_036",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n也會更容易發現壞蛋的存在，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這下正好呢！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "走吧！",
    "voice": "vo_adv_1061005_037",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "出發去找有煩惱的人和壞蛋囉！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這麼說來……",
    "voice": "vo_adv_1061005_038",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我說你啊，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n平時到底是如何發現有煩惱的人啊？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我也想像你一樣找到很多壞蛋。",
    "voice": "vo_adv_1061005_039",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但那些傢伙",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "都躲起來做壞事，要找出來不是很容易啊。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "雖然這樣說有點廢話，",
    "voice": "vo_adv_1061005_040",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但要當擊敗壞蛋的大壞蛋，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n首先得要有做壞事的對象給我擊敗才行得通啊。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "從這角度來看，",
    "voice": "vo_adv_1061005_041",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就算沒有幫助對象，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也可以用各種途徑當上好人，真好哪。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "舉例來說……",
    "voice": "vo_adv_1061005_042",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "像是幫忙撿垃圾，維持道路美觀之類的啊。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這種事即使是為了自己而做，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "結果上也能幫助到其他人吧？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "而且，你明明是已經拯救了這邊世界的英雄，",
    "voice": "vo_adv_1061005_043",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n到現在也還是想去幫助有困難的人。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你真的很了不起耶！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不需要自己把姿態擺這麼低啦！",
    "voice": "vo_adv_1061005_044",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你很了不起喔！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這一點不稍微拿捏一下分寸，",
    "voice": "vo_adv_1061005_045",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n可是會容易被壞蛋逮到機會利用的喔。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我則是從以前開始就會故意把架子擺大一點。",
    "voice": "vo_adv_1061005_046",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n即使如此──",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "唉……",
    "voice": "vo_adv_1061005_047",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊？",
    "voice": "vo_adv_1061005_048",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你說那個人，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是指那邊的大叔？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "他就只是站在房子前而已吧？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊！",
    "voice": "vo_adv_1061005_049",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "等等啊！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "別突然就跑走啦～！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "怎麼回事，",
    "voice": "vo_adv_1061005_050",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "你們是……？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大叔，",
    "voice": "vo_adv_1061005_051",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你有沒有什麼困擾啊？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這傢伙",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在這方面的直覺很準喔！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "是啊，",
    "voice": "vo_adv_1061005_052",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "我確實是煩惱到快想破頭了……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n還有，別叫我大叔。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "我才20幾歲。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "我是",
    "voice": "vo_adv_1061005_053",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "負責指揮這一帶區域整頓工程的人，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "而最後只剩下",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "拆除這棟豪宅的工作沒完成而已。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "然而，",
    "voice": "vo_adv_1061005_054",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "負責的師傅們卻在拆除工程進行到一半時生病，來不了……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "下一個工程",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "預定明天開始，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "但其他師傅們",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "又沒空過來協助。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "現在我得獨自拆除這座大到不行的房子嗎……",
    "voice": "vo_adv_1061005_055",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "我正這樣想，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "在這邊傷透腦筋哪。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真是辛苦啊……",
    "voice": "vo_adv_1061005_056",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你真的很厲害耶……！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n如果是我，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "應該會什麼也沒發現就路過這個人啊……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過這次的事，",
    "voice": "vo_adv_1061005_057",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "感覺不是你有辦法解決的問題。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這棟房子超級大的，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "要趕在今天內拆除，恐怕辦不到吧？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……也是啦。",
    "voice": "vo_adv_1061005_058",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你肯定會這麼說的啊。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "雖然",
    "voice": "vo_adv_1061005_059",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "我很感謝你的好意，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n但光靠在場的我們幾個，是不可能完成這工作的。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "看來我只能",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "乖乖地延後工期了……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "既然如此，就交給我！",
    "voice": "vo_adv_1061005_060",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你們兩個",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "儘管放心吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不用加個小字！",
    "voice": "vo_adv_1061005_061",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你的感謝我就心領了！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "難道",
    "voice": "vo_adv_1061005_062",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "妳會使用魔法？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "除此之外根本不可能解決這狀況。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "畢竟",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "這棟房子大到原本計畫要用炸彈拆除，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "炸藥都已經搬進去了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "沒那麼輕易就能拆掉的。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "魔法？",
    "voice": "vo_adv_1061005_063",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你錯了，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我可是有這傢伙！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "顯現吧，",
    "voice": "vo_adv_1061005_064",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "天樓霸斷劍──！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "從地面冒出了一把劍！",
    "voice": "vo_adv_1061005_065",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "不過，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "這樣果然算是魔法吧……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你們倆離遠一點！",
    "voice": "vo_adv_1061005_066",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "房子什麼的，看我輕鬆砍壞啦！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n正好裡面也放了炸藥！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喝啊啊啊啊──！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "先、",
    "voice": "vo_adv_1061005_067",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "先等等！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "可以先確認完炸藥的量再動手吧──！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "咦？",
    "voice": "vo_adv_1061005_068",
    "unit_id": 106113
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔咿──！！！",
    "voice": "vo_adv_1061005_069",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "沒事吧～！？",
    "voice": "vo_adv_1061005_070",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "所以我才警告妳啊……！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "啊，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "不過房子確實被打壞了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "真是幫了大忙……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "現在這狀況這樣說對嗎……？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我沒事──！",
    "voice": "vo_adv_1061005_071",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "{0}──！",
    "voice": "vo_adv_1061005_072",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n能幫到那個人真是太好了──！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "那孩子都被炸飛了還一邊回話耶……",
    "voice": "vo_adv_1061005_073",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "你的朋友究竟是怎麼回事啊……？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喔～！",
    "voice": "vo_adv_1061005_074",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "下次見啦～！！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "像這樣被轟飛，",
    "voice": "vo_adv_1061005_075",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n就讓我想起和{0}他們敵對的那時候……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n人生會發生什麼事，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還真是難預料呢。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──不曉得是否由於幫助到有困難的人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n矛依未帶著爽朗的笑容飛向了天空另一端，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而{0}也露出微笑揮手送別。",
    "voice": null,
    "unit_id": null
  }
]
