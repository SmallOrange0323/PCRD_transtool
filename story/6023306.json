  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是碧",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "親手製作的人偶嗎？",
