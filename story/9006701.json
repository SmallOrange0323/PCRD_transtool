    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家將守護奴家所愛之子民，",
    "voice": "vo_adv_9006701_017",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "無論彼等身在何方。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n鬼面佛心，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "堅定不移。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n此鐵鑄之身與命，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "直至盡滅方休。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "無論是沉眠於這個世界的靈魂，",
