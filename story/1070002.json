[
  {
    "type": "background",
    "bg_id": "500341"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "前去找似似花無數次的{0}，\\n在課程中漸漸地學會了一般常識。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "107000101"
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "……下一個問題。",
    "voice": "vo_adv_1070002_000",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "一袋裡有100盧幣的蔬菜三個，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n與300盧幣的水果兩個。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "請問買下兩袋",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "會是多少錢？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "答對了。",
    "voice": "vo_adv_1070002_001",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "做得很好。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "算數問題也幾乎都不會答錯了。",
    "voice": "vo_adv_1070002_002",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "和一開始比起來，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "你成長了不少。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "……這或許是個適當的時機。",
    "voice": "vo_adv_1070002_003",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n也教他足夠的常識了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "偶爾會將他",
    "voice": "vo_adv_1070002_004",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "以及與他有來往的少女們",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "包覆住的神祕光芒。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "超越我知識範圍的某種存在，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "也一樣在讓他成長。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "不僅如此，",
    "voice": "vo_adv_1070002_005",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "曾見過的少女們與他的再會。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "看樣子果然",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "只能在你身上賭賭看了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "並非是我的公主騎士真軌，",
    "voice": "vo_adv_1070002_006",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "你才是",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "打倒真那所不可或缺的存在……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "正因為如此，",
    "voice": "vo_adv_1070002_007",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "才更應該避免繼續與你接觸。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "要是讓真那察覺了我這裡的存在，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "就前功盡棄了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "still",
    "still_id": "107000102"
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "{0}。",
    "voice": "vo_adv_1070002_008",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n到今天為止，你都做得很好。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "現在開始進行最終測驗。",
    "voice": "vo_adv_1070002_009",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "只要這測驗能合格，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n想必就算只有你一個人也能出色地生活下去吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "那麼，首先是第一題。",
    "voice": "vo_adv_1070002_010",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n5＋73＋750是？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "答對了。",
    "voice": "vo_adv_1070002_011",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "你也會算複雜的加法了呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n就是這個步調。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "除了我的課程以外，",
    "voice": "vo_adv_1070002_012",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "看來在與其他幾位少女相處的時間中，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n你也有確實成長呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "那麼第二題。",
    "voice": "vo_adv_1070002_013",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n盧幣",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "只能用在去店裡購物。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "是◯還是×？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "答對了。",
    "voice": "vo_adv_1070002_014",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "盧幣，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "也就是",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "金錢不只能夠消費購物，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n也能夠販賣某種東西，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "作為報酬由他人身上取得。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "……如果有這種程度的常識，",
    "voice": "vo_adv_1070002_015",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "就沒問題了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "最終測驗合格。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "background",
    "bg_id": "500341"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "我有個",
    "voice": "vo_adv_1070002_016",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "珍藏的獎勵要給你。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n我想一定會對你有幫助的。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "說不定",
    "voice": "vo_adv_1070002_017",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "她也已經忘記了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "因此這是",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "我作為她的友人要給你的餞別禮。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "你被賦予的",
    "voice": "vo_adv_1070002_018",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "公主騎士之力。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n我教你那力量原本的使用方法吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "你至今為止",
    "voice": "vo_adv_1070002_019",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "似乎都是無意識之中使用的，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "我讓你今後能夠自由地使用力量。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "首先拿起劍。",
    "voice": "vo_adv_1070002_020",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "接著集中精神……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n做得很好。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "然後強烈地去希望吧。",
    "voice": "vo_adv_1070002_021",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "心想希望能幫我或你親愛的人，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "或是希望能成為某人的力量。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "將想法傳達出去。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "……成功了。",
    "voice": "vo_adv_1070002_022",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n沒想到",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "我會有接受你力量的這一天。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "不管怎麼說，",
    "voice": "vo_adv_1070002_023",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "我的課程就到此為止。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "因此，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "該道別了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "明天起你就不能再到這裡來了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "你不能什麼事都要讓人來教你。",
    "voice": "vo_adv_1070002_024",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "因為你是身為一個人類。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "你今後應該要",
    "voice": "vo_adv_1070002_025",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "親自去經歷各種事情，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n然後思考",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "並加以理解。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "無論是有多麼困難的問題在等著你，",
    "voice": "vo_adv_1070002_026",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "都不應該等著別人告訴你解答，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "而是要靠自己去導出答案。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "我相信你能做得到。",
    "voice": "vo_adv_1070002_027",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "因為你是我的學生。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "……明白了嗎？",
    "voice": "vo_adv_1070002_028",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "這麼坦率，很好。",
    "voice": "vo_adv_1070002_029",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "那麼走吧，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n回到等待你的夥伴身邊。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "……嗯，",
    "voice": "vo_adv_1070002_030",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "有緣再見。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "……明天起",
    "voice": "vo_adv_1070002_031",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "這裡，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n除了真軌之外就沒有其他需要招待的人了吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "既然決定了……",
    "voice": "vo_adv_1070002_032",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "守衛。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "聽得到嗎？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "『請問您叫我嗎？",
    "voice": "vo_adv_1070002_033",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "主人。』",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "捨棄這座研究設施。",
    "voice": "vo_adv_1070002_034",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n移動到新的設施去吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "『遵命。",
    "voice": "vo_adv_1070002_035",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "也傳達給真軌。』",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "……這個教材",
    "voice": "vo_adv_1070002_036",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "也必須和這裡一起捨棄了呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "……真沒想到。",
    "voice": "vo_adv_1070002_037",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "與他道別",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n竟會讓我感到寂寞。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "……如果是現在的他，",
    "voice": "vo_adv_1070002_038",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "相信就算我不在也不會有問題吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "……我們無法打倒的你，",
    "voice": "vo_adv_1070002_039",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "是不會有",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "任何不可能的。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這話語並未能傳達給{0}，\\n但似似花仍不禁從口中吐露出對他的期待。",
    "voice": null,
    "unit_id": null
  }
]
