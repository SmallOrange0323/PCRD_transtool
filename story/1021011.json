    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n扮演著魔法師的角色。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "「這溫潤的光芒……",
