  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔哇，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "烤得程度剛剛好，非常好吃呢！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n太讚了吧！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "首先，要先把纏繞在小可蘿身上的觸手給吃掉！",
    "voice": "vo_adv_5004006_083",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n小可蘿可能會被拋出空中，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n請用魔法將她安全接住！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "了、",
    "voice": "vo_adv_5004006_084",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "了解了！",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "運用整理行李所使用的套索魔法套上去……",
