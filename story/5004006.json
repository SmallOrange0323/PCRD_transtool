  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　這麼巨大的魔物，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n愛吃多少都隨我了！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n海鮮萬歲，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "全部盡收於我的胃袋之中囉～！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嚼嚼嚼！",
    "voice": "vo_adv_5004006_089",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好～吃☆",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊啊我復活啦，",
