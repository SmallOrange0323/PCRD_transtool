[
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喝啊啊！",
    "voice": "vo_adv_5004006_000",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n可蘿仔～我們來救妳了！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳還活著的話就回答我一聲！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦，嗚呀？",
    "voice": "vo_adv_5004006_001",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這是什麼……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這裡，是什麼地方？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n剛才明明還在海底遺跡裡的，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎麼就突然變成室外了？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我們可能是被門的傳送魔法，",
    "voice": "vo_adv_5004006_002",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n傳送到其他位置了……",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n不過，回過頭一看那不是我們剛才還在裡頭的海底遺跡嗎？",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好詭異，怎麼這樣接連地變換空間……？",
    "voice": "vo_adv_5004006_003",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我從來沒見過這種現象啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "完全搞不懂",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "現在到底是什麼狀況！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留，妳冷靜一點……",
    "voice": "vo_adv_5004006_004",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n無論如何我們都必須趕快",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "先找到小可蘿。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說、",
    "voice": "vo_adv_5004006_005",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說的也是。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只要趕緊找到她，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就可以跟這個莫名其妙的地方說再見了。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n要思考還是調查，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等之後改天再說了。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊，探測魔法有反應了！",
    "voice": "vo_adv_5004006_006",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "可可蘿小姐應該是在另一側……",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就在水平線",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那裡！",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不，感覺在逐漸靠近……",
    "voice": "vo_adv_5004006_007",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "唔哇啊啊！？",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……！？",
    "voice": "vo_adv_5004006_008",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　有什麼東西從水中冒出來了，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是個龐然大物啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那是什麼啊，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "從沒見過那種魔物！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔哇，",
    "voice": "vo_adv_5004006_009",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好大啊感覺好像很厲害耶……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這魔物的觸手一根一根張牙舞爪的，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n纏在小可蘿身上啊！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "…………",
    "voice": "vo_adv_5004006_010",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔哇，",
    "voice": "vo_adv_5004006_011",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真的！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可蘿仔，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒事吧？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　還有意識嗎？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯，",
    "voice": "vo_adv_5004006_012",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n大家",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都前來營救在下了呢。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "太好了……",
    "voice": "vo_adv_5004006_013",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下好害怕啊。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "突然就被拉進水下，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n以為會就此",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "被魔物當作飼料吃掉，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "正感到絕望了。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才不會讓妳被當作飼料吃掉呢！",
    "voice": "vo_adv_5004006_014",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我們可是【美食殿堂】，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "應該是吃的一方才對喔！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可蘿仔，我們現在就把妳救出來",
    "voice": "vo_adv_5004006_015",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呀啊！？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "危險！",
    "voice": "vo_adv_5004006_016",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔哇，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "魔物揮起觸手開始亂打一通了啊！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n很不妙呢……！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "感覺威力相當大，",
    "voice": "vo_adv_5004006_017",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沙丘都凹出了一個大洞了……！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n被那樣的威力命中的話，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "會直接扁掉的喲！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哇哇，",
    "voice": "vo_adv_5004006_018",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呀啊啊……！？",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "救命啊～！",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊啊，鈴莓！",
    "voice": "vo_adv_5004006_019",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "魔物的觸手居然纏住了腳，不單只能猛烈攻擊，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n還能做到這麼細膩的動作嗎！？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "現在是可以悠悠哉哉佩服人家的時候嗎！？",
    "voice": "vo_adv_5004006_020",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "{0}，\\n來用你的劍砍掉觸手，救救鈴莓那傢伙啊！",
    "voice": "vo_adv_5004006_021",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n要是被拖入海中，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "她會缺氧窒息的……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呀啊！？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "still",
    "still_id": "500400601"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "討厭討厭討厭啊，",
    "voice": "vo_adv_5004006_022",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也被觸手纏住啦！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n喂，{0}，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別光盯著看了快幫忙啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "still",
    "still_id": "500400602"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呀啊啊啊！",
    "voice": "vo_adv_5004006_023",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n黏黏滑滑的～",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好噁心好噁心！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔哇，",
    "voice": "vo_adv_5004006_024",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這情況很不得了了吧……？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇，",
    "voice": "vo_adv_5004006_025",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好險？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦咦，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這次是朝我攻過來了嗎！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n可怕可怕可怕，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "觸手好可怕啊！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這、這是我一直吃海鮮的報應嗎～！？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對不起對不起！",
    "voice": "vo_adv_5004006_026",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是魚肉之類的",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真的很好吃嘛！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "至少我都是料理得很美味來吃下肚的，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以拜託請饒了我吧～！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊，",
    "voice": "vo_adv_5004006_027",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不好了……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n大家都陷入危機了。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "必須做些什麼……",
    "voice": "vo_adv_5004006_028",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n幸好",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不知為何，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下的長槍還在手中。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n只是被觸手纏著，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "實在無法順利活動身軀。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "得想辦法",
    "voice": "vo_adv_5004006_029",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "從纏繞中逃脫出來……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n收拾掉魔物，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "幫助各位才行。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位，",
    "voice": "vo_adv_5004006_030",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "應該都是為了救助在下而來的吧。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n如此溫柔體貼……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "若是害各位受了什麼重傷，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下難辭其咎。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔……",
    "voice": "vo_adv_5004006_031",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n設法挪動身子，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "以長槍朝魔物的要害突刺吧。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊啊，",
    "voice": "vo_adv_5004006_032",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小可蘿不要亂來啊！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n妳亂動的話，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n可能會惹怒魔物對妳造成傷害的……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這個觸手，威力似乎非常強大，",
    "voice": "vo_adv_5004006_033",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n最糟糕的情況……小可蘿的手腳，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n會被撕得四分五裂的。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "該、",
    "voice": "vo_adv_5004006_034",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "該怎麼辦？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n啊啊，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我能做點什麼嗎……？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我這個沒用的東西……！",
    "voice": "vo_adv_5004006_035",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n沒有「皇家裝備」，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我就什麼也做不了了嗎？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔唔～",
    "voice": "vo_adv_5004006_036",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這傢伙！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還想騷擾我的身體到什麼時候啊……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "明明只是個海鮮！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哇呀啊！？",
    "voice": "vo_adv_5004006_037",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "凱留小姐妳不可以使用攻擊魔法啊，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "很危險的！",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "可可蘿",
    "voice": "vo_adv_5004006_038",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "目前還是敵方人質啊！",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n弄得不好可能還會擊中可可蘿的……！？",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔唔，",
    "voice": "vo_adv_5004006_039",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說的也是？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n抱歉，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我太不冷靜了！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n可蘿仔～",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳沒受傷吧！？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒、沒事！",
    "voice": "vo_adv_5004006_040",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下安然無恙！",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咳咳……",
    "voice": "vo_adv_5004006_041",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n唔唔，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "魔物表面燒焦",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "飄出了很美味的香氣。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔～呣，貪吃佩可小姐若是有「皇家裝備」……",
    "voice": "vo_adv_5004006_042",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這種魔物想必，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n馬上就會被整隻做成料理津津有味地吃下肚了吧。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯嗯？　小可蘿，妳快看右邊！",
    "voice": "vo_adv_5004006_043",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n魔物牠焦掉剝離的皮下脂肪處，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n是不是有個閃閃發亮的東西？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那是我的皇冠啊！",
    "voice": "vo_adv_5004006_044",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n是「皇家裝備」的其中一部分！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咦？　啊，確實是的！",
    "voice": "vo_adv_5004006_045",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這個透明又美麗的東西，的確是貪吃佩可小姐的皇冠！",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n為何會出現在這種地方……？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然很莫名其妙，",
    "voice": "vo_adv_5004006_046",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n但請妳把它取到手，丟過來我這邊！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n只要戴上皇冠，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "至少我也能作戰了！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好、",
    "voice": "vo_adv_5004006_047",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好的！",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n貪吃佩可小姐",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只要取回原本其中一部分的力量，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這種魔物",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "根本就不是您的對手是吧？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": "vo_adv_5004006_048",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "相信您！",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "把手伸出去，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "或許能拿得到……！",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯唔！？",
    "voice": "vo_adv_5004006_049",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n咦，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "觸手突然纏得更緊了……！？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小可蘿！？",
    "voice": "vo_adv_5004006_050",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n啊啊不妙，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣下去她會沒命的……！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……嗯？",
    "voice": "vo_adv_5004006_051",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n{0}好像有什麼話想說呢！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你想到什麼",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "能突破這種困境的妙計了嗎！？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好，",
    "voice": "vo_adv_5004006_052",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好的！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　我知道了！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔哇，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎麼感覺突然變得好強勢呀……！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不，",
    "voice": "vo_adv_5004006_053",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我覺得你應該原本就是這樣的人。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "為了大家，總是竭盡全力……",
    "voice": "vo_adv_5004006_054",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n琢磨推敲戰略，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "總是為我們下達最合適的指示。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "為何我有這種感覺呢……？",
    "voice": "vo_adv_5004006_055",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然不知道為什麼，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n但{0}現在有著從未有過的幹勁呢！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好帥氣啊！",
    "voice": "vo_adv_5004006_056",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我就試著相信你，把自己交給你了，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們的命運都託付在",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}身上了哦！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯嗯？什麼啦，你有什麼話想說嗎？ ",
    "voice": "vo_adv_5004006_057",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你有想到什麼妙計可以應對現在的狀況，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我都會全力配合你的，所以就趕緊說吧！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "欸欸欸？",
    "voice": "vo_adv_5004006_058",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n{0}，你到底在說些什麼啊！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n沒問題嗎，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我真的可以相信你嗎！？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "魔法？",
    "voice": "vo_adv_5004006_059",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "前往海底遺跡時所使用的那個嗎？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "用魔法做出含有空氣的皮膜罩住貪吃佩可，",
    "voice": "vo_adv_5004006_060",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n然後使用推進力來高速移動的那招嗎？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "現在，",
    "voice": "vo_adv_5004006_061",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒有被觸手纏上的人也只有貪吃佩可了對吧？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n使用魔法把還能自由活動的……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n送到敵人那邊就對了吧？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯……",
    "voice": "vo_adv_5004006_062",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好吧，就這麼辦。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我現在的魔力，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也已經所剩無幾了。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就把最後的力量擠出來給妳了，",
    "voice": "vo_adv_5004006_063",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要好好感謝我啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n要上了哦貪吃佩可～",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "接下來就靠妳了！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好、好的～！",
    "voice": "vo_adv_5004006_064",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但就算",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "把我送到敵方那裏去，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n到那之後我又該怎麼做呢？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n沒有「皇家裝備」的話我還是沒有力量啊？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，是耶！",
    "voice": "vo_adv_5004006_065",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　你就是看準這一點嗎！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼小凱留……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳就將我，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n送到露出皇冠的位置方向去吧！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯，小心可別咬到舌頭了喔！",
    "voice": "vo_adv_5004006_066",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "上",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "吧啊啊啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "still",
    "still_id": "500400603"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔，",
    "voice": "vo_adv_5004006_067",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呀啊啊啊！？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好厲害，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我居然飛起來了～！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n可怕可怕可怕，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過有點好玩耶～☆",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔……",
    "voice": "vo_adv_5004006_068",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n本來純粹是為了在水中移動所設計的魔法，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n換成在空中操作就必須一邊重新建構，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "操控起來有一定的難度呢。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": "vo_adv_5004006_069",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這點小事可難不倒本小姐凱留我！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "欸！？",
    "voice": "vo_adv_5004006_070",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n不停左右搖晃，好可怕可怕可怕！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留～",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請妳溫柔一點！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我在盡力了，已經很溫柔了啦！",
    "voice": "vo_adv_5004006_071",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n比起這個妳要小心啊，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n魔物不會就讓妳這樣任意行動的！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　要迎擊了……！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊、素！",
    "voice": "vo_adv_5004006_072",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那就是我的任務對吧？",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "貪吃佩可小姐，請妳不要亂動！",
    "voice": "vo_adv_5004006_073",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我會將聚集過來的觸手砍倒，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "作好防備的！",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嘿！",
    "voice": "vo_adv_5004006_074",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n沒有任何失誤，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我的魔法成功了……！",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "still",
    "still_id": "500400604"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呀啊啊啊啊！？",
    "voice": "vo_adv_5004006_075",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我周圍的魔法像煙火般地炸開來了！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好像有點過頭了啊～～",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這到底是什麼情況！？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "吵死了！",
    "voice": "vo_adv_5004006_076",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n別鬼叫了，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "去把妳該做的事情做好！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……啊，糟糕！？",
    "voice": "vo_adv_5004006_077",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n魔物躁動起來，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "皇冠好像要掉出來了！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "欸欸！？",
    "voice": "vo_adv_5004006_078",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　該、",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "該怎麼辦？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n把手伸過去，在掉落之前把皇冠拿到手……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊沒辦法，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就差那麼一點還是拿不到啊！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的，主人。",
    "voice": "vo_adv_5004006_079",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n不需您詳盡的指示，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下也能夠",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "完全理解主人的要求的。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "深呼吸，呼……",
    "voice": "vo_adv_5004006_080",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "集中精神",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "，將主人的命令完美地執行到位吧。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "成功迎擊魔物！",
    "voice": "vo_adv_5004006_081",
