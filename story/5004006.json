    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_5004006_092",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然很可憐，但是適者生存。",
