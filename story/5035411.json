    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "レムはまた",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "一人で頑張ろうとするんだから。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "ちゃんとみんなで戦う！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "　復唱、",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "さん、",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "はい！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "ちゃ、",
    "voice": "vo_adv_5017411_003",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "ちゃんと",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "みんなで戦います……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "よくできました！",
    "voice": "vo_adv_5017411_004",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "ラム",
    "words": "ふふっ……",
    "voice": "vo_adv_5017411_005",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "ラム",
    "words": "レムのそんな顔を見てしまったら、",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "ラム",
    "words": "\\n姉としてやる気を出さざるをえないわね。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "ええ！",
    "voice": "vo_adv_5017411_006",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "\\nあんな悪党は、",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "みんなでけちょんけちょんにしちゃいましょう！",
    "voice": null,
    "unit_id": 109911
  }
