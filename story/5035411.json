  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "姉様。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "大罪司教は、",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "必ずレムが倒してみせます！",
