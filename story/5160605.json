[
  {
    "type": "background",
    "bg_id": "500113"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "その日、サレンディア救護院ではメドゥーサを歓迎して",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n鍋パーティが催されることになった。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "お招きいただき感謝するぞ。",
    "voice": "vo_adv_5160605_000",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nこれはお土産のジュースだ。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ありがと、",
    "voice": "vo_adv_5160605_001",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "モニカ。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nサレン！　",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "モニカが来たわよ。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nアタシも部屋の荷物は片付いたけど……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "いらっしゃいモニカさん。",
    "voice": "vo_adv_5160605_002",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n二人とも、",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "はい、",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "これ着けて。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "これって、",
    "voice": "vo_adv_5160605_003",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "エプロン？　",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "なんでこんなものを……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "モニカさんは料理の準備を手伝って。",
    "voice": "vo_adv_5160605_004",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\nメドゥーサは子どもたちと一緒に配膳をお願いね。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "は、",
    "voice": "vo_adv_5160605_005",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "はああ！？　",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "お手伝いいぃー！？",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "今日はアタシの歓迎パーティーだって聞いたけど？",
    "voice": "vo_adv_5160605_006",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "そうよ。",
    "voice": "vo_adv_5160605_007",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "救護院ではパーティーの主役だって働くの。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n働かざる者食うべからずってね。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\nうちは人数が多いから、",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "お手伝いは当たり前よ。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "うむ、",
    "voice": "vo_adv_5160605_008",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "教育が行き届いているな。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n頑張って準備すればその分早く食べられるし、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n働いた後のご飯はいっそうおいしくなるぞ。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "郷に入っては郷に従え、",
    "voice": "vo_adv_5160605_009",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "とも言うわね。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n二人とも、",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "よろしくね。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "あたしはスズメを手伝ってくるから。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "はぁ、",
    "voice": "vo_adv_5160605_010",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "なんでアタシがこんなことを……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n普段は人の世話なんてしないから面倒ったらないわ……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "子ども１",
    "words": "ママ・サレン！　",
    "voice": "vo_adv_5160605_011",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "子ども１",
    "words": "テーブル拭き終わったよ！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "子ども２",
    "words": "あたしはお皿並べたよ！",
    "voice": "vo_adv_5160605_012",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "頑張ったわね、",
    "voice": "vo_adv_5160605_013",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "二人とも。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\nそれじゃあ今度は他の子のお手伝いしてきてくれる？",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "子どもたち",
    "words": "はーい！",
    "voice": "vo_adv_5160605_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "……あんなちびっ子が文句一つ言わずに働いてるのに、",
    "voice": "vo_adv_5160605_015",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nアタシってば文句ばっか。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "カッコ悪いわね。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "サレン！　",
    "voice": "vo_adv_5160605_016",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "こっちは終わったわよ！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n次は何すればいい？",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "ありがと。",
    "voice": "vo_adv_5160605_017",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "それじゃあ薪の追加を持ってきてちょうだい。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "その後何事もなく準備は進み、食卓には大きな鍋が並んだ。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "これが、",
    "voice": "vo_adv_5160605_018",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "お鍋……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "大きな鍋で具材を煮ただけの料理。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nそれをみんなで囲んで食べるなんて……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "子どもはわちゃわちゃして騒がしいし、",
    "voice": "vo_adv_5160605_019",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nお姉ちゃんたちと暮らしてた頃の優雅な晩餐とは大違いだわ。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nでも……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "全然嫌な感じがしない、",
    "voice": "vo_adv_5160605_020",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ううん、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "すごく楽しい！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nみんなで食べるご飯って、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "こんなにおいしかったんだ……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "メドゥーサ、",
    "voice": "vo_adv_5160605_021",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "お椀が空になっているぞ。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nほら、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ついでやろう。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ありがとう。",
    "voice": "vo_adv_5160605_022",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "お肉いっぱい入れてちょうだい！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "こら、",
    "voice": "vo_adv_5160605_023",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "子どもたちも食べるんだぞ。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "少しは自重しろ。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n代わりに野菜をたっぷり入れてやろう。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "あ！　",
    "voice": "vo_adv_5160605_024",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ひどいことするわね、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "蛇虐待よ蛇虐待！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "あはは、",
    "voice": "vo_adv_5160605_025",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "お肉もまだいっぱいあるから、",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "安心して。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\nまずは野菜をちゃんと食べてからね。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n野菜を先に食べたほうが、",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "美容にもいいらしいわよ？",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "……仕方ないわね。",
    "voice": "vo_adv_5160605_026",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "約束よ。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "お姉ちゃん、",
    "voice": "vo_adv_5160605_027",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "お鍋って楽しいわよ。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nいつか再会したときは、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "アタシが作ってあげるからね！　",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "こうして救護院に暮らすことになったメドゥーサは",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n久々の楽しい夕食の時間を過ごすのだった。",
    "voice": null,
    "unit_id": null
  }
]
