  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "私、",
    "voice": "vo_adv_6054106_000",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "雪投げをするのは生まれて初めてでしたけれど、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\nとても楽しかったですわ♪",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "ええ、",
    "voice": "vo_adv_6054106_001",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "これでまた一つ",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "社会勉強ができましたわ！",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "そうです！　",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "今度雪投げのチームを結成して、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "大会を開くのはいかが？",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "その時はあなたさま、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "ぜひとも運営を手伝ってくださいませ♪",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "私もまさか",
    "voice": "vo_adv_6054106_002",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "ここまで夢中になるとは思っていませんでしたわ！",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "最初はうまくできなくて焦るばかりでしたが、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "あなたさまの機転のおかげで、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "今では楽しい思い出です！",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "まさか",
    "voice": "vo_adv_6054106_003",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "誘っていただけるなんて……",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "どんな魅力的な商談があったとしても",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\nあなたさまとの約束がうれしいのです。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "これからも思い出をたくさん作ってまいりましょう！",
    "voice": null,
    "unit_id": 114411
  }
]
