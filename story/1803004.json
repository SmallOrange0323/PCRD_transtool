[
  {
    "type": "background",
    "bg_id": "500042"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "從雪山返回蘭德索爾的怜與{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n有說有笑地回顧著一天的經歷。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……在大雪紛飛的山頂與幽靈戰鬥什麼的，",
    "voice": "vo_adv_1803004_000",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這種體驗，或許會被人說是看到幻覺了吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要不是你也在場，",
    "voice": "vo_adv_1803004_001",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n連我都要懷疑自己是不是修練過度燒壞腦子了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哎呀，",
    "voice": "vo_adv_1803004_002",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "已經這麼晚了……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "今天謝謝你陪了我這麼久。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你應該也很累了，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我送你回公會小屋吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然當時保持著公主型態，",
    "voice": "vo_adv_1803004_003",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但或許是太急著下山了？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "連我也都精疲力盡了……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……嗯？",
    "voice": "vo_adv_1803004_004",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你看，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個在發光的物體是……？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不對，",
    "voice": "vo_adv_1803004_005",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不是物體在發光……？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那道",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "光……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是什麼……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "老師再見。",
    "voice": "vo_adv_1803004_006",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "今天非常感謝您。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "花藝講師",
    "words": "妳也辛苦了。",
    "voice": "vo_adv_1803004_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花藝講師",
    "words": "關於展覽的事，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花藝講師",
    "words": "\\n記得幫我向士條先生知會一聲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好的。",
    "voice": "vo_adv_1803004_008",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那我就先失陪了。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……完全把我當成傳聲筒呢。",
    "voice": "vo_adv_1803004_009",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我的花藝技術到底有沒有進步，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "老師根本就不在意吧。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "話雖如此，",
    "voice": "vo_adv_1803004_010",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也只是在學著自己沒興趣的東西罷了。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "所以實際上，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我和老師對彼此的不尊重應該是半斤八兩吧。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好了……",
    "voice": "vo_adv_1803004_011",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "轉換一下心情吧。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n難得這麼早結束，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "去散散步再回家好了。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "反正就算回家",
    "voice": "vo_adv_1803004_012",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也沒什麼好事。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……咦？",
    "voice": "vo_adv_1803004_013",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個人",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "該不會是……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗨，",
    "voice": "vo_adv_1803004_014",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "居然在這裡遇見你，還真是巧呢。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "稍微來辦點事。",
    "voice": "vo_adv_1803004_015",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那你……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你的學校在這附近，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "會路過這裡也不奇怪呢。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊……",
    "voice": "vo_adv_1803004_016",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你該不會，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n正打算去哪裡辦事吧？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣啊，",
    "voice": "vo_adv_1803004_017",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那就好。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n難得的寶貴假日，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要是打擾到你就不好了。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我也差不多該──",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "下雨了……？",
    "voice": "vo_adv_1803004_018",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真傷腦筋啊。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我今天沒帶傘出門耶。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我先走了。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你也趁淋濕之前",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "趕快回家吧。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說著說著雨就越下越大了……！",
    "voice": "vo_adv_1803004_019",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還是先找個地方躲雨吧！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呼、",
    "voice": "vo_adv_1803004_020",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呼……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好了，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這裡應該不會淋到雨。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……在這麼短的時間內竟然就濕透了。",
    "voice": "vo_adv_1803004_021",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你我都是……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵，",
    "voice": "vo_adv_1803004_022",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你看看自己。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你現在超級狼狽喔。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n簡直就像從河裡或海裡爬上岸一樣。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這倒也是……",
    "voice": "vo_adv_1803004_023",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哈啾！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就算找人來接，",
    "voice": "vo_adv_1803004_024",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "在這種濕漉漉的",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "狀態下搭車，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n在回到家前就先感冒了吧……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "咦……？",
    "voice": "vo_adv_1803004_025",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你家、",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗎……？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個……",
    "voice": "vo_adv_1803004_026",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……那麼，",
    "voice": "vo_adv_1803004_027",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我就打擾了。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n拒絕難得的邀請也不太禮貌呢。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "background",
    "bg_id": "510090"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……打擾了。",
    "voice": "vo_adv_1803004_028",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……這樣真的可以嗎？",
    "voice": "vo_adv_1803004_029",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不用了啦。",
    "voice": "vo_adv_1803004_030",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我不能這麼麻煩你……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n只要能暫時避雨就行了……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哈啾！",
    "voice": "vo_adv_1803004_031",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……不好意思。",
    "voice": "vo_adv_1803004_032",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那就恭敬不如從命了。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "still",
    "still_id": "180300401"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……我換好衣服了，",
    "voice": "vo_adv_1803004_033",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你可以進來囉。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你家有沒有能晾乾衣服的地方？",
    "voice": "vo_adv_1803004_034",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝、",
    "voice": "vo_adv_1803004_035",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝你……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……",
    "voice": "vo_adv_1803004_036",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……總覺得有點不自在。",
    "voice": "vo_adv_1803004_037",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這裡就是",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他的房間啊……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……話說回來，",
    "voice": "vo_adv_1803004_038",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我是第一次",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "進男孩子的房間耶……！？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊啊啊啊，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "突然緊張起來了……！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣或日和",
    "voice": "vo_adv_1803004_039",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有來過嗎！？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還是說，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他經常帶別的女孩子回來……！？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這麼說來，他剛剛準備換洗衣物的動作，",
    "voice": "vo_adv_1803004_040",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n看起來十分熟練……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不不！",
    "voice": "vo_adv_1803004_041",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我到底在想什麼啊！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n他怎麼可能會是那種人！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呀、是！？",
    "voice": "vo_adv_1803004_042",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊，",
    "voice": "vo_adv_1803004_043",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好啊！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我就不客氣了！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嘶嘶……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好燙！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哈哈、",
    "voice": "vo_adv_1803004_044",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哈哈哈……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "或許是覺得身體冷起來了，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不自覺地想要趕快喝掉……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哈哈哈哈哈……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……呼。",
    "voice": "vo_adv_1803004_045",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好溫暖……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……雨，",
    "voice": "vo_adv_1803004_046",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "下個不停呢。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……那個，",
    "voice": "vo_adv_1803004_047",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我本來沒打算這麼麻煩你的。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n只是",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "想稍微躲個雨而已……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "該怎麼說呢。",
    "voice": "vo_adv_1803004_048",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我覺得很抱歉。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n也對一直給你添麻煩的自己感到心煩……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n畢竟，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我總是受到你的幫助……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……雖然是偶然，但能像這樣",
    "voice": "vo_adv_1803004_049",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "和你待在一起，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n老實說，我覺得很開心。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要是我能",
    "voice": "vo_adv_1803004_050",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "回報你什麼就好了……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "阿斯特朗的……？",
    "voice": "vo_adv_1803004_051",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒問題。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這點小事我當然很樂意奉陪。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說到冒險……",
    "voice": "vo_adv_1803004_052",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你知道嗎？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n聽說有個只在雪山山頂出現的",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "限時任務……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……原來是這樣。",
    "voice": "vo_adv_1803004_053",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你察覺到了我的不自在，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n為我的心情著想才會說這些的吧。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你真的",
    "voice": "vo_adv_1803004_054",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "很溫柔呢。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我都不自覺地",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沉溺於",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那份溫柔中了。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵，",
    "voice": "vo_adv_1803004_055",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "回去後得玩一下阿斯特朗才行呢。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n……真不可思議。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "明明直到剛才我還完全不想回家的。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一想到登入遊戲前",
    "voice": "vo_adv_1803004_056",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "得聽父親的種種嘮叨，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就覺得心情鬱悶，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不太想馬上回家。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊，",
    "voice": "vo_adv_1803004_057",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我的花藝老師住在這附近。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n老師平時會來我家上課，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但今天是我去拜訪她。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你的意思是，我平時太沒氣質，",
    "voice": "vo_adv_1803004_058",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n看起來不像是個大小姐嗎？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……開玩笑的啦。",
    "voice": "vo_adv_1803004_059",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "父母硬逼著我學花藝，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我本來就已經受夠了。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "在阿斯特朗裡砍殺花朵怪物",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "才更合我意呢。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……真奇怪。",
    "voice": "vo_adv_1803004_060",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "明明是在他的房間，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n卻比在我自己的房間裡",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "更輕鬆自在……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……雨啊。",
    "voice": "vo_adv_1803004_061",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "拜託了，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "請就這樣持續下不停吧。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n讓我",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "再多和他待一段時間……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對了。",
    "voice": "vo_adv_1803004_062",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這件衣服",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是你家人的嗎？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我改天得好好答謝……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "still",
    "still_id": "180300402"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是、",
    "voice": "vo_adv_1803004_063",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是你的嗎！？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這、",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣啊……！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我還以為是別人的衣服呢……！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n哦……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原來是你的啊。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……啊啊，",
    "voice": "vo_adv_1803004_064",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "衣服上確實有他的味道……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不對，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我在幹什麼啊啊啊啊！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒、",
    "voice": "vo_adv_1803004_065",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒什麼！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒什麼啦，你別介意！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這、",
    "voice": "vo_adv_1803004_066",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這種感覺……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一旦意識到是他的衣服，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就有種被他抱住的錯覺……！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n冷靜下來，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "冷靜下來啊我！　",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "總算恢復冷靜的怜，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n直到雨停為止，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "都在{0}的房間裡\\n與他共度兩人時光。",
    "voice": null,
    "unit_id": null
  },
