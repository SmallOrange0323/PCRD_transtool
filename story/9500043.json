    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "還以為這份心意要一直藏在心底，",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n現在能把心意傳達給你，感覺輕鬆多了喵！",
    "voice": null,
    "unit_id": 104641
  },
