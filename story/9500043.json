  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "認真的……",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "被你這樣坦率又大方地說出口，",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "讓人有點害羞……",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過，",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "比起害羞，",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我更是開心得不得了喵～！",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……喵哈哈～",
    "voice": "vo_adv_9500043_003",
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n美少女義賊幻影貓的芳心，",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n早就被你偷走了喵。",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我也是剛剛才發現的喵～",
    "voice": null,
    "unit_id": 104641
  },
