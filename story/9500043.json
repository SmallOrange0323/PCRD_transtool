    "name": "珠希",
    "words": "……我會鼓起勇氣，",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但只會說這一次，",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "所以你要聽好了喵。",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}。\\n我",
    "voice": "vo_adv_9500043_005",
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "也喜歡你喵！",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "最喜歡了喵！",
    "voice": null,
    "unit_id": 104641
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n希望你能永遠待在我身邊喵！",
    "voice": null,
    "unit_id": 104641
  },
