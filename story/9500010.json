[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……真沒想到，",
    "voice": "vo_adv_9500010_000",
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "竟然也會有",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我被選中的一天呢。",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n不知怎麼的，",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "讓人感慨萬千啊。",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "回想起來──",
    "voice": "vo_adv_9500010_001",
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那一天，",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我被少年所救。",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "或許少年已經不記得了……",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n但那場相遇正是",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "一切的開端。",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "時光流轉至今，",
    "voice": "vo_adv_9500010_002",
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這個世界正面臨著最大的危機。",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "在這樣的情況下，",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你竟然會選擇我作為公主。",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "命運這種東西",
    "voice": "vo_adv_9500010_003",
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真是不可思議啊。",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "一想到",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我曾經對你做過的事，",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就算被你怨恨也無可厚非……",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "所以我想再一次，",
    "voice": "vo_adv_9500010_004",
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "聽聽少年的決心。",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你真的，",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要選我",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗎？",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這樣啊……",
    "voice": "vo_adv_9500010_005",
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "看來是我問了個不識趣的問題呢。",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "好！",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我也做好覺悟了。",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "從今以後，",
    "voice": "vo_adv_9500010_006",
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我會以你所選擇的公主身分",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "來面對你。",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "來吧，少年。",
    "voice": "vo_adv_9500010_007",
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n這段由我開啟，",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "與你一同展開的故事……",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雖然已經不知道是第幾次世界危機了……",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但我向你保證。",
    "voice": "vo_adv_9500010_008",
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我一定會",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "保護好少年。",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n無論要付出什麼代價。",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你這個可能性所構築的一切……",
    "voice": "vo_adv_9500010_009",
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "培養出的力量、",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "交織而成的羈絆……",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就讓那個膽小的她看看",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這份強大、",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這束光芒吧──",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "所以說，",
    "voice": "vo_adv_9500010_010",
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "背後就交給我吧。",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n區區一兩個世界，",
    "voice": null,
    "unit_id": 106841
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "看我們馬上把它們救下來！",
    "voice": null,
    "unit_id": 106841
  }
]
