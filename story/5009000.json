[
  {
    "type": "background",
    "bg_id": "500023"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "聖誕節即將到來，瀰漫著愉悅氣氛的蘭德索爾街道……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在離中心街道一小段路的巷子裡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n【慈樂之音】的千歌正奮力奔跑著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "500900001"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "哈啊，哈啊！",
    "voice": "vo_adv_5009000_000",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我不行了……！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "「記憶的大精靈霧奇」！",
    "voice": "vo_adv_5009000_001",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n比想像中還要危險，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我竟然解開了如此不得了的封印……！？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊啊，",
    "voice": "vo_adv_5009000_002",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要忘記了！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "逐漸缺少，",
    "voice": "vo_adv_5009000_003",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "逐漸消失，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "逐漸地失去！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我就快要",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "忘記一切了！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "將要忘記唱歌的喜悅，",
    "voice": "vo_adv_5009000_004",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還有身為【慈樂之音】站在舞台上的激昂情緒！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n還有面對{0}，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n有生以來第一次感受到的溫暖心情！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊啊，",
    "voice": "vo_adv_5009000_005",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "全部都要遺忘了！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我、",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "至今是如何走路的呢？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如何呼吸？",
    "voice": "vo_adv_5009000_006",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　心臟如何跳動？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "究竟是如何？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我……？",
    "voice": "vo_adv_5009000_007",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　我是什麼？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n誰？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　我連那個",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "都忘了……？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊……",
    "voice": "vo_adv_5009000_008",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗚、",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "background",
    "bg_id": "500023"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "…………",
    "voice": "vo_adv_5009000_009",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "此時，{0}和寄宿的\\n【咲戀育幼院】的孩子們一起\\n出門採買食物和生活用品。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "順利的買完東西，大家開心地回家途中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哼哼哼～♪",
    "voice": "vo_adv_5009000_010",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n就快要到",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "愉快的聖～誕～節～了～♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "欸，欸嘿……",
    "voice": "vo_adv_5009000_011",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n天氣這麼冷也很有精神呢，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "綾音……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真是的！　胡桃，我不是說過很多次了，",
    "voice": "vo_adv_5009000_012",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不能叫「綾音」，要叫「綾音姊姊」？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "就是啊，胡桃～",
    "voice": "vo_adv_5009000_013",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n對人總是那麼見外不太好喔。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我們是在【咲戀育幼院】感情很好地睡同一張床，",
    "voice": "vo_adv_5009000_014",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n在同一張餐桌吃飯，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "一起生活的家人不是嗎？",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哼哼♪",
    "voice": "vo_adv_5009000_015",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "妳看，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "連噗吉都這麼說了！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "不過，",
    "voice": "vo_adv_5009000_016",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "綾音比同年紀的人還要像孩子呢……",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n要說沒有『姊姊的樣子』的話，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n的確是這樣沒錯呢。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咦咦？",
    "voice": "vo_adv_5009000_017",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "　好過分喔，噗吉～",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "老是愛多嘴！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n再這樣捉弄人，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "小心我在不可燃垃圾日把你給丟了喔？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "…………",
    "voice": "vo_adv_5009000_018",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咦，咦咦？",
    "voice": "vo_adv_5009000_019",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "　",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "對不起！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "　",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "剛才是騙你的，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "說笑的說笑的！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我竟然說了這種無心的話，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "像我這種壞孩子，聖誕老人不會來找我吧？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "…………",
    "voice": "vo_adv_5009000_020",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗚哇啊啊啊！",
    "voice": "vo_adv_5009000_021",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "　噗吉不回答我！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n對不起啦對不起啦，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我道歉就是了，原諒我！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "絕對不會把你丟掉的，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我會永遠和噗吉在一起……！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哇哇……",
    "voice": "vo_adv_5009000_022",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "走路不好好看路的話會跌倒唷，綾音，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n天氣很冷，路面都結凍了……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哇呀啊！？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "胡桃！？",
    "voice": "vo_adv_5009000_023",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "　沒事吧？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯，嗯……",
    "voice": "vo_adv_5009000_024",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "欸嘿嘿，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我真沒用啊……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n剛才還自以為是的要綾音小心，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n結果自己反倒跌倒了……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "妳、",
    "voice": "vo_adv_5009000_025",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "妳沒受傷吧？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n要小心喔～？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯。",
    "voice": "vo_adv_5009000_026",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我沒事啦……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "因為{0}哥哥",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n他馬上抱住我了……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "欸嘿……",
    "voice": "vo_adv_5009000_027",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "謝謝你，哥哥……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n馬上就要到快樂的聖誕節了，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n要是受了傷在床上動彈不得的話，就太慘了嘛……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯嗯。",
    "voice": "vo_adv_5009000_028",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "聖誕夜要和育幼院的大家一起開派對呢，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n要是受傷還是感冒的話就糟糕了！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "難得的聖誕節就會變成討厭的回憶呢～？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "欸嘿，",
    "voice": "vo_adv_5009000_029",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "真的好期待……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "第一次和育幼院的大家",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "一起過聖誕節……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯，",
    "voice": "vo_adv_5009000_030",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "要好好玩個痛快！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n和【咲戀育幼院】的大家一起，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "和家人一起過呢……♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯……♪",
    "voice": "vo_adv_5009000_031",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "　要將育幼院全部裝飾起來，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n還要裝飾巨大的聖誕樹……☆",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "派對那一天",
    "voice": "vo_adv_5009000_032",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "一起唱歌跳舞玩到想睡為止……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "呀啊～☆",
    "voice": "vo_adv_5009000_033",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n還要吃這～麼大的火雞，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "和甜滋滋的蛋糕喔！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "真期待……！",
    "voice": "vo_adv_5009000_034",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "然後帶著幸福的心情入睡，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "隔天醒來枕邊就有聖誕老人的禮物……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "像作夢一樣！",
    "voice": "vo_adv_5009000_035",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n啊啊，真是的，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "快點到來啊，聖～誕～節～♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……奇怪？",
    "voice": "vo_adv_5009000_036",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "　哥哥好像沒什麼精神呢，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是不期待聖誕節嗎？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊……",
    "voice": "vo_adv_5009000_037",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "因為哥哥失憶了，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "所以不知道聖誕節是什麼嗎……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯～？",
    "voice": "vo_adv_5009000_038",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n可是我",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "已經和哥哥說明過聖誕節了喔？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥對於新學到的東西，應該是……\\n不太會忘記才對……？",
    "voice": "vo_adv_5009000_039",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯呀啊啊！？",
    "voice": "vo_adv_5009000_040",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥不要突然跑起來啦，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我會嚇到的……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥，",
    "voice": "vo_adv_5009000_041",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "突然跑走了呢？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "怎、怎麼回事呢？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦……？",
    "voice": "vo_adv_5009000_042",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n綾音妳看，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "有一個人倒在路邊……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "…………",
    "voice": "vo_adv_5009000_043",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哇，",
    "voice": "vo_adv_5009000_044",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真的耶！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n那個人是誰啊，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是哥哥認識的人嗎？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好像在喊著什麼名字……？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我、我也不曉得……",
    "voice": "vo_adv_5009000_045",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n可是倒在這麼冷的路邊睡著的話，說不定會凍死，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "總之得把她帶到屋子裡才行……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥，有辦法搬動這個人嗎？　交給你了！",
    "voice": "vo_adv_5009000_046",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我們先回去育幼院，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "準備一下暖爐之類的……胡桃！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯、",
    "voice": "vo_adv_5009000_047",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "好……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯、",
    "voice": "vo_adv_5009000_048",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "唔……？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊，",
    "voice": "vo_adv_5009000_049",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "醒來了！　",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "沒事吧～？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "現在馬上帶妳去溫暖的地方，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不要死掉喔……？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "死……？",
    "voice": "vo_adv_5009000_050",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　那是",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "什麼？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好可怕，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好可怕！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哇哇，",
    "voice": "vo_adv_5009000_051",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不可以亂動啊……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "死？　",
    "voice": "vo_adv_5009000_052",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是說",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "失去的意思嗎？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要失去了，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要忘記了！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n啊啊，好可怕，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我最怕這種事了！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要來了，",
    "voice": "vo_adv_5009000_053",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要來了！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　那傢伙過來了！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　霧奇要來了！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "全部，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "全部都遺忘，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "然後死去……！",
