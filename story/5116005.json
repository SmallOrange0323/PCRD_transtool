    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下的照顧",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "反而會成為阻礙。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是，",
    "voice": "vo_adv_5116005_099",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在這個狀況下",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "照顧主人，",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
