[
  {
    "type": "background",
    "bg_id": "501370"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "度過了一夜，就在天空亮起之時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n栞他們抵達了某處瀑潭。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "循著途中發現的河川是正確答案呢……",
    "voice": "vo_adv_5116005_000",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "主人",
    "words": "汪！",
    "voice": null,
    "unit_id": 1812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵，",
    "voice": "vo_adv_5116005_001",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "也謝謝主人了。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "要是有注意到我留下來的標記，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那可可蘿他們應該也……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "嘎嚕！",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊，",
    "voice": "vo_adv_5116005_002",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "栞小姐，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "幸好您沒事……！",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可可蘿，",
    "voice": "vo_adv_5116005_003",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "還有喵特！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "方才，",
    "voice": "vo_adv_5116005_004",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下發現了栞小姐留下的標記，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n於是就追蹤標記，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "才抵達了這邊。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "咕嚕咕嚕咕嚕……♪",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊哈哈，",
    "voice": "vo_adv_5116005_005",
    "unit_id": 125413
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "喵特，",
    "voice": null,
    "unit_id": 125413
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好癢喔……♪",
    "voice": null,
    "unit_id": 125413
  },
  {
    "type": "dialogue",
    "name": "主人",
    "words": "汪汪！",
    "voice": null,
    "unit_id": 1812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "喔喔，",
    "voice": "vo_adv_5116005_006",
    "unit_id": 125313
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好乖好乖……♪",
    "voice": null,
    "unit_id": 125313
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125313
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下一直都好想見您，",
    "voice": null,
    "unit_id": 125313
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人。",
    "voice": null,
    "unit_id": 125313
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "話說回來，栞小姐，",
    "voice": "vo_adv_5116005_007",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n人類的主人在哪裡呢？",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "由於昨天分頭行動，",
    "voice": "vo_adv_5116005_008",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下很擔心主人，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "昨晚都睡不太著覺。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "幸虧有喵特在，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "才稍微安心一點。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "咦……",
    "voice": "vo_adv_5116005_009",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n他沒有和可可蘿在一起嗎？",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": "vo_adv_5116005_010",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拜託主人",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n去追栞小姐了。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……這麼說來，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "難不成主人",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "現在是獨自一人……？",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "有什麼東西",
    "voice": "vo_adv_5116005_011",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "從那邊的草叢過來了！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "…………",
    "voice": "vo_adv_5116005_012",
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那是……",
    "voice": "vo_adv_5116005_013",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "昨天的",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "大猿……？",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請小心，",
    "voice": "vo_adv_5116005_014",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "栞小姐……！",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "唔唔…………",
    "voice": "vo_adv_5116005_015",
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……",
    "voice": "vo_adv_5116005_016",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "沒有",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "攻擊過來？",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，",
    "voice": "vo_adv_5116005_017",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人！？",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為什麼您會和那隻魔物一起……",
    "voice": "vo_adv_5116005_018",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不對，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "比起那個，您有受傷嗎！？",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "……嗚吼，",
    "voice": "vo_adv_5116005_019",
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "嗚吼吼。",
    "voice": null,
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": "vo_adv_5116005_020",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您能聽懂牠說什麼嗎？",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……該怎麼辦才好？",
    "voice": "vo_adv_5116005_021",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "栞小姐。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人跟著那隻魔物走了。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……我們跟過去看看吧。",
    "voice": "vo_adv_5116005_022",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n或許能夠掌握那隻魔物大鬧的原因。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "只不過，",
    "voice": "vo_adv_5116005_023",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "請不要放鬆警戒。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n做好能夠隨時撤退的準備，要是判斷有危險，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n就帶著{0}撤走。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "background",
    "bg_id": "501850"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這裡……",
    "voice": "vo_adv_5116005_024",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是果樹林？",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n有好多的果實呢……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n密林裡竟然有這樣的地方……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "嗚吼。",
    "voice": "vo_adv_5116005_025",
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這是大猿先生採的果實嗎？",
    "voice": "vo_adv_5116005_026",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗅嗅……",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎是沒什麼毒性的種類。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是要給我們的？",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "嗚吼……？",
    "voice": "vo_adv_5116005_027",
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "牠溫馴到令人難以相信之前",
    "voice": "vo_adv_5116005_028",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n曾那樣大鬧呢。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n而且感覺牠是在歡迎我們……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是啊，",
    "voice": "vo_adv_5116005_029",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "牠用非常水汪汪的眼睛看著我們。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n簡直就像汪汪主人一樣──",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "主人",
    "words": "汪汪！",
    "voice": null,
    "unit_id": 1812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊、",
    "voice": "vo_adv_5116005_030",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請不要一直舔在下。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這樣子",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "壞壞喔。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這麼說來，肚子餓了呢……",
    "voice": "vo_adv_5116005_031",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為緊急糧食都吃完了，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "天亮後就什麼都沒……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "嘎嚕嚕…………",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看來似乎沒有像昨天那樣的危險，",
    "voice": "vo_adv_5116005_032",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n我們就心懷感謝地接受款待吧。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "大猿先生，",
    "voice": "vo_adv_5116005_033",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝您。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "嗚吼吼，",
    "voice": "vo_adv_5116005_034",
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "嗚吼嗚吼，",
    "voice": null,
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "嗚吼吼！",
    "voice": null,
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那、",
    "voice": "vo_adv_5116005_035",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那個，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "大猿，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我很高興你把水果分給我，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n但這個量有點太多了……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哦哦……",
    "voice": "vo_adv_5116005_036",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "堆成跟我們身高相當的小山了呢。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下就心懷感激地享用了。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊嗯。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "話說回來，主人，",
    "voice": "vo_adv_5116005_037",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "幸好您平安無事。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下還以為您跟栞小姐在一起，",
    "voice": "vo_adv_5116005_038",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以得知您是獨自一人時，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感覺背脊都發涼了。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "被大猿先生……？",
    "voice": "vo_adv_5116005_039",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n原來如此，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以才沒有被其他的魔物襲擊吧。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這隻大猿先生",
    "voice": "vo_adv_5116005_040",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎是這個魔物保護區中的老大……",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n也就是所謂的「霸主」。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "「霸主」……",
    "voice": "vo_adv_5116005_041",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗎？",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_5116005_042",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "若是根據在此處調查的",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n遊俠的報告書……",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原本",
    "voice": "vo_adv_5116005_043",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這位大猿先生以魔物而言，似乎是相當少見的",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "性格友好且穩重。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "聽說牠也曾被目擊，",
    "voice": "vo_adv_5116005_044",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在魔物之間有紛爭時，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n會親自來調解的舉動……",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "牠大多棲息在有許多果樹的密林，",
    "voice": "vo_adv_5116005_045",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n甘甜的果實似乎是牠最愛的食物……",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哎呀？",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這麼說來，大猿",
    "voice": "vo_adv_5116005_046",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n一口都沒吃呢？",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這麼一說，",
    "voice": "vo_adv_5116005_047",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "牠都只是一直為我們採摘而已。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您的肚子不餓嗎？",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "嗚吼……",
    "voice": "vo_adv_5116005_048",
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "嗚吼吼……",
    "voice": null,
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您現在口水也都從嘴巴流出來了，",
    "voice": "vo_adv_5116005_049",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以在下想您一定是很餓的……",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "唔，",
    "voice": "vo_adv_5116005_050",
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "唔唔唔唔……",
    "voice": null,
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然牠拚命想別開視線……",
    "voice": "vo_adv_5116005_051",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n好像在忍耐什麼似的……？",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那個，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你不介意的話，要一起吃嗎？",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "主人",
    "words": "唔嗚……？",
    "voice": null,
    "unit_id": 1812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哎呀，",
    "voice": "vo_adv_5116005_052",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "汪汪主人把水果……",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n交給大猿先生了呢。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "唔，",
    "voice": "vo_adv_5116005_053",
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "嗚吼…………",
    "voice": null,
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "主人",
    "words": "唔嗚…………？？？",
    "voice": null,
    "unit_id": 1812
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "嗚吼…………",
    "voice": "vo_adv_5116005_054",
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "唔、",
    "voice": "vo_adv_5116005_055",
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "唔唔唔唔……！",
    "voice": null,
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這……",
    "voice": "vo_adv_5116005_056",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "大猿先生",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "全身的葉子都豎起來了……！",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "唔、",
    "voice": "vo_adv_5116005_057",
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "唔、",
    "voice": null,
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "唔……",
    "voice": null,
    "unit_id": 17411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "──咕喔喔喔喔喔！",
    "voice": "vo_adv_5116005_058",
    "unit_id": 17412
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這副模樣",
    "voice": "vo_adv_5116005_059",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是那時候的……！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "為什麼會突然……",
    "voice": "vo_adv_5116005_060",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "原因是什麼？",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為吃了那個水果嗎？　",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但是，",
    "voice": "vo_adv_5116005_061",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們也吃了同一種水果，並沒有問題。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "原因究竟是什麼……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "──咕喔喔喔喔喔！",
    "voice": "vo_adv_5116005_062",
    "unit_id": 17412
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "唔",
    "voice": "vo_adv_5116005_063",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "栞小姐，",
    "voice": "vo_adv_5116005_064",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們現在先撤退吧。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n如果是跟之前一樣，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那牠應該是無法溝通的狀態……！",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可可蘿……",
    "voice": "vo_adv_5116005_065",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我知道了。",
    "voice": "vo_adv_5116005_066",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我用煙霧來擾亂牠，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n就趁那個空檔撤退吧。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我要用",
    "voice": "vo_adv_5116005_067",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "煙霧彈了！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "──咕喔喔喔喔喔！？",
    "voice": "vo_adv_5116005_068",
    "unit_id": 17412
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "大家，",
    "voice": "vo_adv_5116005_069",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "趁現在！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "──咕喔喔喔喔喔！",
    "voice": "vo_adv_5116005_070",
    "unit_id": 17412
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": "vo_adv_5116005_071",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請快來這邊！",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "唔唔唔唔…………",
    "voice": "vo_adv_5116005_072",
    "unit_id": 17412
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "總算是逃掉了呢。",
    "voice": "vo_adv_5116005_073",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n為什麼會突然",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "發生那種事……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個白色的碎片……",
    "voice": "vo_adv_5116005_074",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "石頭嗎？",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "原來如此……",
    "voice": "vo_adv_5116005_075",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是這麼一回事嗎。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "或許",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這會成為突破口也說不定。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "栞小姐？",
    "voice": "vo_adv_5116005_076",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不過，",
    "voice": "vo_adv_5116005_077",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們先回集訓所吧。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們的體力也都耗盡了……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "而且我也有各種事想要確認。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是，回到集訓所的一行人──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "{0}撿回來的碎片，",
    "voice": "vo_adv_5116005_078",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n那似乎是大猿",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "「牙齒」的一部分。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我想",
    "voice": "vo_adv_5116005_079",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這恐怕是在牠用力咬的時候碎掉的，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但必須注意的",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是那個斷面──",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "──這個",
    "voice": "vo_adv_5116005_080",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "被蛀牙侵蝕的部分。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這也就是說，",
    "voice": "vo_adv_5116005_081",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "得出的結論是，",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n大猿先生受不了蛀牙的疼痛，所以才會失控暴衝。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "要是打倒那隻大猿，",
    "voice": "vo_adv_5116005_082",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我想問題確實就會解決。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "作為遊俠，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們一直以來所學的──",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "──並不是隨便除掉對方，",
    "voice": "vo_adv_5116005_083",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n而是把包含了人類與魔物的大自然……",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那樣的共生",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "當作目標。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以",
    "voice": "vo_adv_5116005_084",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們想過了。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要是牠有蛀牙，",
