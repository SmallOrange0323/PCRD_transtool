    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是不是治好就好了呢？",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "still",
    "still_id": "511600501"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "像大猿一樣，",
    "voice": "vo_adv_5116005_085",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "與我們人類相近的猿類魔物，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n牙齒的數量基本上都是一致的。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以，",
    "voice": "vo_adv_5116005_086",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我就想，是不是可以",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n請{0}協助進行治療前的模擬",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呢？",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為要是治好了蛀牙，",
    "voice": "vo_adv_5116005_087",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "讓牠不再因疼痛而發狂……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "事情就會以最和平的方式解決了。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，",
    "voice": "vo_adv_5116005_088",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可可蘿，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "請幫我拿那邊的紗布，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n以防萬一要用到。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "511600502"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好的，",
