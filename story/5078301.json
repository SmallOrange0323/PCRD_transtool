  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "老師這下也跟著充滿幹勁了♪",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n呵呵呵……",
