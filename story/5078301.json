  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "這股黑暗力量……",
    "voice": null,
    "unit_id": 15312
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n你們大概連碰都碰不到我吧！",
    "voice": null,
    "unit_id": 15312
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n有這麼強大的力量，",
