[
  {
    "type": "background",
    "bg_id": "502114"
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "罪狀是打架造成破壞公物，",
    "voice": "vo_adv_5205065_000",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "以及爭吵噪音打擾到了鄰居～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n有什麼話想說的嗎～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "兩位？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "紡希與華音",
    "words": "「都是華音的錯！」\\n「都是紡希的錯！」",
    "voice": "vo_adv_5205065_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "距離兩人吵架已經過了一段時間",
    "voice": "vo_adv_5205065_002",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "卻還是在氣頭上嗎～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "騎士閣下先生，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "該怎麼辦呢～？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我才不要，",
    "voice": "vo_adv_5205065_003",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那樣子太丟臉了。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "你到底在說什麼。",
    "voice": "vo_adv_5205065_004",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "胡鬧也該有個限度吧？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希與華音",
    "words": "……喵。",
    "voice": "vo_adv_5205065_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "為什麼我要受到這種對待……",
    "voice": "vo_adv_5205065_006",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "有錯的明明是華音喵。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "在妳肯接受懲罰的那一刻起，",
    "voice": "vo_adv_5205065_007",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n不就代表紡希妳自己也承認有錯喵？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "華音不也一樣喵！",
    "voice": "vo_adv_5205065_008",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n而且說起來",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就算我有錯，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n也是華音妳錯比較大喵！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "啥～～～～！？",
    "voice": "vo_adv_5205065_009",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "這樣的話比起本小姐，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n紡希妳還要錯更大更大喵！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那華音妳就是錯更大更大更～大喵！",
    "voice": "vo_adv_5205065_010",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希與華音",
    "words": "呼喵────！！！",
    "voice": "vo_adv_5205065_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接著，她們又像小孩子般地吵了起來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一直到兩人精疲力盡為止。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "………………那麼，",
    "voice": "vo_adv_5205065_012",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "雖然百般不願意，就由我先來吧。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我認同妳那坦率的內心跟死纏爛打的毅力。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……畢竟我們也曾經共鬥過。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "所以姑且。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "勉為其難地。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哼……",
    "voice": "vo_adv_5205065_013",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "本小姐也認同妳",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "是個能託付背後的人。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "而且也不愧是個偶像，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "身上感受不到庶民氣場，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n也很有毅力。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "大概。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "可能吧。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是啊……",
    "voice": "vo_adv_5205065_014",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但是華音，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "希望妳放聲大笑時能再多看一下場合……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "看一下場合……？",
    "voice": "vo_adv_5205065_015",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "不對吧",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "紡希，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "何時、想在哪裡放聲大笑",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "都是本小姐的自由！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "等等，",
    "voice": "vo_adv_5205065_016",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳就是這種部分不行啦！？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n旁若無人的言行舉止總是",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "造成別人的困擾！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哦～",
    "voice": "vo_adv_5205065_017",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呵呵♪",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "紡希妳動不動就馬上生氣找本小姐架吵這點，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "不也一樣會造成困擾嗎～～～～？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "所──",
    "voice": "vo_adv_5205065_018",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "以──",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "說──！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "啥～～～～？？？？",
    "voice": "vo_adv_5205065_019",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "明明一度看起來要和好了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n卻又馬上開始吵架的華音與紡希。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n到最後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "兩人還是持續吵架吵到了精疲力盡為止。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那有什麼問題！",
    "voice": "vo_adv_5205065_020",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "決勝布幕拉起！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n看誰饒舌比較行！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "反正還是我會贏！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "看樣子，",
    "voice": "vo_adv_5205065_021",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "比賽已經開始了呢。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "那我也來！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "妳那歌詞，無力軟爛！",
    "voice": "vo_adv_5205065_022",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我聽不見，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "毫無波瀾！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "再來一段熱度上翻！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "還是妳已疲憊不堪？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "──笑妳不敢來嗆看看，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "即興饒舌可不簡單！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "服裝品味超怪！",
    "voice": "vo_adv_5205065_023",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "就說這不是本小姐的時尚品味啦──！！",
    "voice": "vo_adv_5205065_024",
    "unit_id": 134912
  },
  {
    "type": "background",
    "bg_id": "502115"
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "遜咖大小姐！",
    "voice": "vo_adv_5205065_025",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "悽慘地上貼！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "旁若無人就是妳的態度！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "時尚品味已經音訊全無──！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "傲嬌還裝！",
    "voice": "vo_adv_5205065_026",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "刻薄偶像！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "嘴巴狂妄就該拉鍊拉上！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "態度囂張等著吃我一掌──！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "不只沒結束",
    "voice": "vo_adv_5205065_027",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "還反而越吵越激烈呢～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "用靈魂進行饒舌對決的兩位，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "我其實並不討厭哦～♪",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "結果，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這場饒舌戰鬥就在沒有評審也沒有判定的情況下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一直持續吵到兩人精疲力盡為止。",
    "voice": null,
    "unit_id": null
  }
]
