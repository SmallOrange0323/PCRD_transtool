[
  {
    "type": "dialogue",
    "name": "{0}",
    "words": "──喝啊啊啊！",
    "voice": "vo_adv_5085203_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……！",
    "voice": "vo_adv_5085203_001",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "另一個你",
    "voice": "vo_adv_5085203_002",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "正在消失……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "成功了吧！？",
    "voice": "vo_adv_5085203_003",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是啊，",
    "voice": "vo_adv_5085203_004",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n少年，",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你已經用「你的力量」超越了。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "來吧，",
    "voice": "vo_adv_5085203_005",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "接下來就開個盛大的派對之類的",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "狂歡到隔天吧！",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我會給大家吃特製的可麗餅喲！",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……雖然",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我正想這麼說。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "整個空間開始產生扭曲了。",
    "voice": "vo_adv_5085203_006",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n比剛才還巨大的力量正在改變它的形狀。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "看來，",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "還沒有結束。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗚哇～",
    "voice": "vo_adv_5085203_007",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "早知道就別說什麼",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "「成功了吧！？」",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n真是空歡喜一場。",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……無所謂。",
    "voice": "vo_adv_5085203_008",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n不論有什麼樣的戰鬥等著我，",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我都會迎面而戰！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "很好。",
    "voice": "vo_adv_5085203_009",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那麼，大家",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "可以稍微湊過來一點嗎？",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我來讓空間的扭曲穩定下來。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n……這可是大姐姐的職責",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "喲！",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "前進吧。",
    "voice": "vo_adv_5085203_010",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n讓你，",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還有我們一起！",
    "voice": null,
    "unit_id": 121011
  }
]
