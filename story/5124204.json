  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請各位小心。",
    "voice": "vo_adv_5124204_002",
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這裡瀰漫著對人有害的瘴氣。",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n如果要淨化整座度假村，",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n看來還有必要繼續進行除靈。",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "嘖，",
    "voice": "vo_adv_5124204_003",
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "居然給我搞出這麼麻煩的狀況！",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n快點完成除靈，",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "讓海邊回復成\\n充滿泳裝美女的健全面貌吧！",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "唔哼哼！",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸也是那個讓健全的海邊",
    "voice": "vo_adv_5124204_004",
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n變得不健全的人吧……？",
    "voice": null,
    "unit_id": 127111
  }
