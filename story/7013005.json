[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "美冬就這樣氣勢洶洶地打倒了許多魔物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n其中有大半的魔物因為害怕美冬而逃走，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而迎戰美冬的最後一隻魔物也——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這是最後一隻了！",
    "voice": "vo_adv_7013005_000",
    "unit_id": 104811
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "——嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呼。",
    "voice": "vo_adv_7013005_001",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "比我原先預想的",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "還多花了些時間呢。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "在我看來這些魔物是轉眼間就被收拾乾淨了……",
    "voice": "vo_adv_7013005_002",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這種程度還搆不上",
    "voice": "vo_adv_7013005_003",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我的高效率戰鬥水準呢。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "看來雖然我以為已經充分地休息過了，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但身體還殘留著一絲疲倦的樣子。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "話說回來，",
    "voice": "vo_adv_7013005_004",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們已經爬得這麼高了",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "怎麼會一點線索也沒有……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯？　",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這是什麼？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "怎麼有個奇怪的石頭。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n難道是從逃跑的魔物身上遺落的嗎。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這個石頭的確很奇怪。",
    "voice": "vo_adv_7013005_005",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然看起來不像是寶石之類的東西，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但搞不好",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這就是你記憶的線索之類的……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哇哇！？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n怎麼",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "突然間有道光！？　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這道光是怎麼回事！？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我",
    "voice": "vo_adv_7013005_006",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我也不知道！！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n這是怎麼回事？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你、",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你等一下！　",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你想想辦法嘛～～！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "欸、",
    "voice": "vo_adv_7013005_007",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我們還是回去吧。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n外行人做的紅豆麵包",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "怎麼可能賣得出去嘛。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "而且，",
    "voice": "vo_adv_7013005_008",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "為什麼我得做這種事啊。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "在義賣市集裡",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "賣自己的手工麵包這種事，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "比去學校上學",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "的難度還要高耶。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不是、",
    "voice": "vo_adv_7013005_009",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你要我怎麼放心？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我在說",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我不想出現在人群面前欸。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你的意思是說",
    "voice": "vo_adv_7013005_010",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我們跟客人的往來只限於今天，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n所以比上學的難度還要低是嗎？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不對吧、",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這件事的麻煩程度",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "可是一點都沒有改變喔？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "如果你說除了做麵包以外",
    "voice": "vo_adv_7013005_011",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "其他雜事工作你都會負責的話，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n那我倒是無所謂。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我就假裝",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "在那邊晃一下，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "等等就自己回去囉。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊、",
    "voice": "vo_adv_7013005_012",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你啊！",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我等了半天你都沒來，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "所以我就來找你了！",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦？　",
    "voice": "vo_adv_7013005_013",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "她、",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "她是誰？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哎呀？　",
    "voice": "vo_adv_7013005_014",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "難不成",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "妳就是",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "鈴？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "是、",
    "voice": "vo_adv_7013005_015",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "是啊……",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我是鈴",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "妳怎麼會",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "知道我？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "因為我聽說有個女孩會製作好吃的紅豆麵包。",
    "voice": "vo_adv_7013005_016",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n所以我就跟他提議說",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "要不要",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "試著在市集裡賣賣看。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊、",
    "voice": "vo_adv_7013005_017",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "抱歉！",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我還沒自我介紹呢。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我叫大神美冬。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n因為打工那邊的人拜託我來幫忙，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "所以由我負責這次市集的營運委員會。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n請多指教。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "請多多、",
    "voice": "vo_adv_7013005_018",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "指教。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那個，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然這傢伙",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "跟妳說很好吃，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n說到底",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "也只是外行人做出來的麵包而已喔？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這次參加市集的人全都是外行人，所以請放心吧。",
    "voice": "vo_adv_7013005_019",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不過，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "說得也是，如果賣的是外行人做得難吃的麵包",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那可就行不通了。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我可以",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "試吃一個看看嗎？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "謝謝。",
    "voice": "vo_adv_7013005_020",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊、",
    "voice": "vo_adv_7013005_021",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "等一下、",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你們不要擅自進行下去啦！",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "外表確實看起來很好吃呢。",
    "voice": "vo_adv_7013005_022",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那我就",
    "voice": null,
    "unit_id": 104831
