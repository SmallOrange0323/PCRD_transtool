  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "鈴鈴噹和虎虎一樣，",
    "voice": "vo_adv_1005003_061",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n都是為了守護世界和平而戰！",
