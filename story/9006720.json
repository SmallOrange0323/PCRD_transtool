[
  {
    "type": "dialogue",
    "name": "大家",
    "words": "「乖乖受死吧！」「在地獄後悔吧。」",
    "voice": "vo_adv_9006720_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "\\n「殺了你。」「就在這裡做個了結吧────！」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "索爾龍",
    "words": "「「「──嘰喔喔喔喔喔！！！」」」",
    "voice": null,
    "unit_id": 20411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這、",
    "voice": "vo_adv_9006720_001",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這下如何！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "真令人驚訝。",
    "voice": "vo_adv_9006720_002",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n面對一隻被　[rub:資源]飼料[/rub]　餵養得如此龐大的",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n索爾龍，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "居然能寸步不讓。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……幻境龍后！",
    "voice": "vo_adv_9006720_003",
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n無論妳有多麼強大，",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們也絕對不會輸！",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以──",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我",
    "voice": "vo_adv_9006720_004",
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "只問一次。",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n……妳願意和我們一起",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "吃頓飯嗎……？",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "那是什麼意思？",
    "voice": "vo_adv_9006720_005",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n妳是想在這裡",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "握手言和嗎？",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……是的。",
    "voice": "vo_adv_9006720_006",
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "即使戰鬥到現在，",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我也感受不到妳身上有任何惡意。",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "比起互相傷害……",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "圍繞著餐桌、",
    "voice": "vo_adv_9006720_007",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "加深友誼，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "將怨恨化為烏有。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "真是個美好的故事。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "但那僅限於",
    "voice": "vo_adv_9006720_008",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "地球人之間。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "對於連進食都感到恐懼的我來說，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "那是無法選擇的未來。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "理所應當。",
    "voice": "vo_adv_9006720_009",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "水火不容，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "終究難以相融。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "既是生來註定為敵，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "那便不共戴天。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可、",
    "voice": "vo_adv_9006720_010",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可是。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n如果霸瞳皇帝的推測無誤，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n一旦在LoA的戰鬥中敗北，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您就會……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "沒錯。",
    "voice": "vo_adv_9006720_011",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n換句話說，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我只要不輸給你們就行了。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "說起來──",
    "voice": "vo_adv_9006720_012",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "索爾龍",
    "words": "「「「──嘎喔喔喔喔喔！！！」」」",
    "voice": null,
    "unit_id": 20411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我的愛龍，",
    "voice": "vo_adv_9006720_013",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "可還沒受到什麼像樣的傷害呢。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "啊……！",
    "voice": "vo_adv_9006720_014",
    "unit_id": 133113
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133113
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "居然連被斬斷的頭顱，",
    "voice": null,
    "unit_id": 133113
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "都能在瞬間再生……！",
    "voice": null,
    "unit_id": 133113
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "貪吃佩可公主。",
    "voice": "vo_adv_9006720_015",
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "寬容固然是種美德，",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但如今已是我們背水一戰的時刻。",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "若心生迷惘，",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "便無法守護該守護之物。",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔……",
    "voice": "vo_adv_9006720_016",
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "來吧，",
    "voice": "vo_adv_9006720_017",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "索爾龍。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n展現你的本領。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "請讓他們見識，你身為原本理應實裝的最終Boss，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "那份應有的驕傲吧。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "索爾龍",
    "words": "「「「──嘎喔喔喔喔喔！！！」」」",
    "voice": null,
    "unit_id": 20411
  }
]
