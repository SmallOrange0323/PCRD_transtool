  {
    "type": "dialogue",
    "name": "優妮",
    "words": "誒……",
    "voice": "vo_adv_9500060_000",
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n咦、",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "咦、",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "咦？",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "咦？",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "為……",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "為什麼！？",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n你、",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你在說什麼？",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊？",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "咦？",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我？",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "咦咦──！",
    "voice": "vo_adv_9500060_001",
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "搞不懂那是怎樣！",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "太難懂了，",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "好恐怖！",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n在候選人多到滿出來的情況下，",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "有可能特地選擇我嗎？",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我才不信？",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "咦？",
    "voice": "vo_adv_9500060_002",
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "因為，等等？",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這實際上不就是",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "他在向我告白──",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "──不不不，不對，",
    "voice": "vo_adv_9500060_003",
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "怎麼可能嘛！",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這也太跳躍了！",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我的想法太噁心了啦，",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我……",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不妙不妙，",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "要被發現我沒異性緣了。",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n提升一下免疫力吧。",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "別小看我。",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "學姐我可沒那麼好搞定喔？",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那、",
    "voice": "vo_adv_9500060_004",
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那個……",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "呃……",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "順帶一提，",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那個…………",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你為什麼選了我？",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不知為何？",
    "voice": "vo_adv_9500060_005",
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n是這樣啊，",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哦──",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不知為何──",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "──啊，不，",
    "voice": "vo_adv_9500060_006",
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不是！",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "很好！",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "很好、",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "很好！",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我完全感謝！",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n不如說這很有你的風格，",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "確實觸動到我了……",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "吧？",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "呃，",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嘿嘿。",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "對吧──？",
    "voice": "vo_adv_9500060_007",
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是啊，",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "總覺得，",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "該怎麼說呢……",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "太過稀有的福利直接把我擊穿了，",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "害我腦袋都當機了呢。",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n最近偶爾會這樣，",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這就像冒出老家口音一樣，所以別在意。",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "咦──",
    "voice": "vo_adv_9500060_008",
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "為什麼！",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n不用為那部分道歉啦。",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "因為你這樣說而感到開心的我，",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不就像笨蛋一樣了嗎……",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯……",
    "voice": "vo_adv_9500060_009",
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我知道了，",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我想接受那個──",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "想接受",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那份心意。",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊啊，不對，",
    "voice": "vo_adv_9500060_010",
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "訂正一下……",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我就接受吧。",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "被你選擇了的話，",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那真是不枉我做一次學姐了。",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "既然如此，",
    "voice": "vo_adv_9500060_011",
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我也要對你說。",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n讓我們兩人共同編織",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "克服這場危機的力量吧。",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我們一定辦得到──",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我就相信可靠的同志所選擇的",
    "voice": null,
    "unit_id": 111041
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "答案吧。",
    "voice": null,
    "unit_id": 111041
  }
]
