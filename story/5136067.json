  {
    "type": "dialogue",
    "name": "旁白",
    "words": "蘭德索爾近郊──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n日和跟埃拉接受了公會管理協會的委託，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正在與強大的魔物對峙著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "唔喵喵喵喵",
    "voice": "vo_adv_5136067_000",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "喵──！！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "做得好，",
    "voice": "vo_adv_5136067_001",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "日和！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這樣就完成委託了呢！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不僅能幫助他人，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "還能獲得飯錢♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "真是好處多多啊！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "來～",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "跟姐姐",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "擊掌！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "擊掌！",
    "voice": "vo_adv_5136067_002",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "聽說魔物很強，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "所以我原本還有點擔心，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n能順利打倒真是太好了～♪",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "魔物的確是很強哦？",
    "voice": "vo_adv_5136067_003",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "日和的動作比它更俐落呢！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "甚至感覺其實不需要我的幫助耶？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嘿嘿，",
    "voice": "vo_adv_5136067_004",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這都要歸功於妳啊！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "老實說，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我有試著模仿妳的動作！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈哈！",
    "voice": "vo_adv_5136067_005",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "難怪我覺得動作很俐落啊～！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n真不愧是日和呢！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "看來我才一下子",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "就被妳給追上──",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唔喔喔喔喔喔！！",
    "voice": "vo_adv_5136067_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "奇怪？",
    "voice": "vo_adv_5136067_007",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n這個聲音是……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在這裡嗎────！！",
    "voice": "vo_adv_5136067_008",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "諾維姆！",
    "voice": "vo_adv_5136067_009",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n果然是妳！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊～",
    "voice": "vo_adv_5136067_010",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "諾維姆！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嘿～",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "還真巧呢！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "沒想到連在這裡都能見到妳啊～",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳知道我的名字嗎？",
    "voice": "vo_adv_5136067_011",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n沒想到居然連沒見過的人都知道我……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "看",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "來我也變有名了呢！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真不愧是天下第一大壞蛋！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哈──哈哈！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "哦，",
    "voice": "vo_adv_5136067_012",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "大壞蛋！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……不過",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "事實上，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我們不是沒見過面啦～",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n因為我認識另一邊的諾維姆嘛？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "另一邊的……？",
    "voice": "vo_adv_5136067_013",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n這是什麼意思？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "話說回來，妳……",
    "voice": "vo_adv_5136067_014",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n有股奇怪的氣息呢。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "感覺好像……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "以前有在哪裡見過……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "諾維姆，",
    "voice": "vo_adv_5136067_015",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我跟妳介紹一下！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "她是埃拉！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n來自與這邊不同的另一個世界！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳說……",
    "voice": "vo_adv_5136067_016",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n另一個世界！？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "原來如此……",
    "voice": "vo_adv_5136067_017",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳說的另一個世界，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是這麼回事啊。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我是沒有聽說過……",
    "voice": "vo_adv_5136067_018",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但如果是阿斯特朗，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "感覺就有可能？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n不過……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈！",
    "voice": "vo_adv_5136067_019",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n也是，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "很驚人吧？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這種時候證據比理論還要更好懂！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n──出來吧，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "天樓霸斷劍！！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "still",
    "still_id": "513600202"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊啊！？",
    "voice": "vo_adv_5136067_020",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n果然是這樣啊！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我就覺得有股很像是天樓霸斷劍的氣息！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "原來如此！",
    "voice": "vo_adv_5136067_021",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n所以妳才跑到我們這裡來了啊。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這是",
    "voice": "vo_adv_5136067_022",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "另一個世界的諾維姆借我的喔！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "來，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "妳摸摸看確認一下吧♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔唔唔……",
    "voice": "vo_adv_5136067_023",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n雖然有點不一樣，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但的確是天樓霸斷劍呢……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣擺在一起看，",
    "voice": "vo_adv_5136067_024",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真的是很像呢……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "居然會如此地相像，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "感覺好不可思議啊。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊，",
    "voice": "vo_adv_5136067_025",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "對了！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "諾維姆，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "妳要不要稍微揮揮看？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "妳不是對天樓霸斷劍的二刀流",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "很感興趣嗎？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "二刀流！？",
    "voice": "vo_adv_5136067_026",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這也太有夢想了吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那麼，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我就借用一下……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嘿呀啊啊啊啊啊！！！",
    "voice": "vo_adv_5136067_027",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n天樓霸斷劍，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "二刀流！！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "喔喔～！",
    "voice": "vo_adv_5136067_028",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好帥！！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈哈哈！",
    "voice": "vo_adv_5136067_029",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n嗯嗯，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "感覺不錯！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "既然如此……",
    "voice": "vo_adv_5136067_030",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n諾維姆，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "妳要不要用用看？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n之後也一直拿著它吧。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳、",
    "voice": "vo_adv_5136067_031",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳在說什麼啊？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這把天樓霸斷劍，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n不是屬於埃拉世界的諾維姆嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯……",
    "voice": "vo_adv_5136067_032",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不了，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我不需要！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "外觀確實很像，",
    "voice": "vo_adv_5136067_033",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但感覺不太對！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "因為這把天樓霸斷劍",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不是我的。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "事情就是這樣！",
    "voice": "vo_adv_5136067_034",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n妳就把它",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還給另一個世界的我吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊……",
    "voice": "vo_adv_5136067_035",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n果然是這樣呢。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "因為每次「重置」的時候都會回到我手上，",
    "voice": "vo_adv_5136067_036",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n所以想說乾脆就這樣給妳……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過看來就算是「真品」，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "對「本人」來說還是不一樣啊。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "埃拉，妳這樣不行啦！",
    "voice": "vo_adv_5136067_037",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n妳自己借的東西，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就要自己拿去還啊！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n對吧？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "說的沒錯！",
    "voice": "vo_adv_5136067_038",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不物歸原主，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可是會變成很壞的大壞蛋呢！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "唉呀──",
    "voice": "vo_adv_5136067_039",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我要是變成壞蛋可就困擾了呢～！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n因為會很困擾，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "所以我不會再說第二次了！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n啊哈哈哈哈！",
    "voice": null,
    "unit_id": 135512
  }
]
