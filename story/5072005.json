    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "紡希……！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "still",
    "still_id": "507200501"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝妳們……！",
    "voice": "vo_adv_5072005_108",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "唔哇！？",
    "voice": "vo_adv_5072005_109",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n真是夠了～",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "小望，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不要突然抱住我啦……！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳的衝勁向來就很猛了……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呵呵，",
    "voice": "vo_adv_5072005_110",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "既然妳那麼有活力，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n看來再做一次排練也沒問題呢。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦，",
    "voice": "vo_adv_5072005_111",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可以嗎！？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "反正",
    "voice": "vo_adv_5072005_112",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "妳也不會就這樣安分地好好休息吧？",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿嘿……",
    "voice": "vo_adv_5072005_113",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那麼，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們快走吧，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌、",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "紡希！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為了呈現出最棒的演唱會，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們可要全力以赴喔♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "是！",
    "voice": "vo_adv_5072005_114",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "慈樂之音的三人在得知各人的心聲後，更是加深了彼此之間的羈絆。",
    "voice": null,
    "unit_id": null
  },
  {
