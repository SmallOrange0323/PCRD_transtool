    "type": "dialogue",
    "name": "凱留",
    "words": "真是的，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這種事我可沒聽說唷。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒想到一打倒他，空間本身就會崩塌。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "好危險啊……",
    "voice": "vo_adv_5013007_001",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n如果不是逃得夠快，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n我們可能會因為裂縫關閉而被困住。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這裡是……",
    "voice": "vo_adv_5013007_002",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "山頂吧？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "好漂亮～！",
    "voice": "vo_adv_5013007_003",
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "　花瓣輕飄飄地飛舞著！",
