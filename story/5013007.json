  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呃，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我有不好的預感……",
