[
  {
    "type": "background",
    "bg_id": "500354"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在育幼院忙物產展，在牧場忙舞台劇。\\n當美咲開始過慣這種忙碌生活的某一天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "謝謝您的惠顧──！",
    "voice": "vo_adv_1214002_000",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呼～",
    "voice": "vo_adv_1214002_001",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "今天這樣就結束了呢。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n也來了不少的客人，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "感覺算不錯吧？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "果然",
    "voice": "vo_adv_1214002_002",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是我的魅力吸引了客人吧♪",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這對優雅又成熟的淑女來說，是理所當然的呀。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "像是前陣子，",
    "voice": "vo_adv_1214002_003",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "經常來我們這裡光顧的婆婆，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n還給了我好吃的糖果",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "要給我吃呢。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "居然能收到粉絲給的禮物，",
    "voice": "vo_adv_1214002_004",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "簡直就像是真正的女演員呢♪",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "唉……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "人長得太美",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "也真是個罪呢～♪",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "對了，",
    "voice": "vo_adv_1214002_005",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "為了讓你也能收到禮物，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我來教你各種事情吧！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "開心吧？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "首先是",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "要學會露出能吸引人的魅力笑容～",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "有事？",
    "voice": "vo_adv_1214002_006",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n……是真陽小姐拜託你的事情？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "必須靠我們的工作……",
    "voice": "vo_adv_1214002_007",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "既然是這樣，你就早點說啊。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "好了，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我們快點走吧？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "background",
    "bg_id": "500997"
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "啊，",
    "voice": "vo_adv_1214002_008",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "看到人了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "今天",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "謝謝你們兩位特地前來。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "\\n麻煩你們",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "巡邏溫泉了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……巡邏？",
    "voice": "vo_adv_1214002_009",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……所以說，",
    "voice": "vo_adv_1214002_010",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你們明明有放好熱水，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n但溫泉卻總是莫名其妙就沒水了？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "沒有錯，",
    "voice": "vo_adv_1214002_011",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "我們都有把栓子給栓好，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "送熱水的管線",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "也沒有任何破損的地方。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "而且，",
    "voice": "vo_adv_1214002_012",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "這是我親眼看到的。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "晚上",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "有未知的龐大物體，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "\\n在溫泉的陰影處動來動去……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "從那之後，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "我就一直在意到",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "\\n連工作都無法專心，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "因為查不出原因，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "所以溫泉也只好停業。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "真陽小姐也有來幫忙調查，",
    "voice": "vo_adv_1214002_013",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "但畢竟她有其他工作，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "\\n沒辦法一直顧著我們這裡，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "所以你們願意來幫忙，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "讓人放心多了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "原來如此……",
    "voice": "vo_adv_1214002_014",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我知道了！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "謝謝你們！",
    "voice": "vo_adv_1214002_015",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "\\n那麼就拜託你們了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "\\n我也會轉告真陽小姐，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "說你們有來這裡",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "牧場人員",
    "words": "幫忙了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "好～！",
    "voice": "vo_adv_1214002_016",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我要努力當個",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "最時尚",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "又華麗的保鑣！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……說是這麼說，",
    "voice": "vo_adv_1214002_017",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過看守還真閒呢。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "因為只是呆呆站在入口而已呀。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "目前",
    "voice": "vo_adv_1214002_018",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "熱水好像放得很順利。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n看起來沒什麼問題呢。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳好，",
    "voice": "vo_adv_1214002_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我是來泡溫泉的……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呃……",
    "voice": "vo_adv_1214002_020",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "溫泉目前正在停業中……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "啊，",
    "voice": "vo_adv_1214002_021",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是這樣啊？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我經常來這裡的溫泉，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "還真可惜呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n泡過溫泉後，整個身子會溫暖起來，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "能讓做粗活累積的疲勞都一掃而空。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "而且妳想想，",
    "voice": "vo_adv_1214002_022",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "剛泡完澡喝的牛奶，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "可是最棒的不是嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這裡有預定會重新營業嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這是……",
    "voice": "vo_adv_1214002_023",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "當然的了！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "絕對會重新營業的！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "因為我",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "一定會逮到犯人的！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "犯人……？",
    "voice": "vo_adv_1214002_024",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊，",
    "voice": "vo_adv_1214002_025",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呃……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "沒什麼！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這裡很快就會重新營業了，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "能否請您再稍候一段時間？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "聽到這話讓人放心多了，",
    "voice": "vo_adv_1214002_026",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那麼我會期待這裡重新營業的……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n今天就買個起司回去好了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這裡的起司也是堪稱一絕呢，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "而且偶爾上演的舞台劇也很好看。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "謝謝您的惠顧，",
    "voice": "vo_adv_1214002_027",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "請您要再來喔。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……這座牧場",
    "voice": "vo_adv_1214002_028",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "果然很受歡迎呢，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n大家都很喜歡這裡。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "有好吃的麵包、",
    "voice": "vo_adv_1214002_029",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "起司",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "和善良的人們。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "和時尚又華麗不同意義，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n這裡是另一種美好的地方呢。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "所以……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦？",
    "voice": "vo_adv_1214002_030",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊────！？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n熱水、",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "熱水消失了！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n這表示犯人趁我們剛才在說話時下手了！？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "怎麼會這樣……",
    "voice": "vo_adv_1214002_031",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就這一瞬間？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我也沒感覺到使用過魔法的氣息……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "現在可不是在這裡看守的時候了。",
    "voice": "vo_adv_1214002_032",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我們去搜尋犯人吧，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不能只是在原地等待！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我找這裡，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你找那裡。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我是不清楚犯人有什麼企圖，",
    "voice": "vo_adv_1214002_033",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n但不能讓他擅自奪走溫泉的熱水！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "background",
    "bg_id": "500998"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "雖然是這麼說，",
    "voice": "vo_adv_1214002_034",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "但只有我一個人會覺得很不安呢……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "話又說回來，",
    "voice": "vo_adv_1214002_035",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那個熱水小偷到底是怎麼回事？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "如果想泡溫泉，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "當場進去泡就行了啊……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呀！？",
    "voice": "vo_adv_1214002_036",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n剛、",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "剛才有聽到了什麼聲音。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是、",
    "voice": "vo_adv_1214002_037",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是從後面傳來的吧。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "欸，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你去仔細看一下那裡……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我忘了他不在這裡。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "────",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這、",
    "voice": "vo_adv_1214002_038",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這巨大的魔物是怎麼回事！？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n感覺軟軟",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "又水水的……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n原來如此……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是這傢伙把溫泉的熱水",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "全部都喝掉的吧。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "────",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呀啊啊！",
    "voice": "vo_adv_1214002_039",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這傢伙",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "該不會打算也把我吞進去！？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我、",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我、",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我、",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我絕對不要",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這麼遜地犧牲掉……！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "但是",
    "voice": "vo_adv_1214002_040",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這麼巨大的魔物，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "只靠我一個人實在無法對付！　",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "討厭～！",
    "voice": "vo_adv_1214002_041",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "別過來～！！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "唔唔～",
    "voice": "vo_adv_1214002_042",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "攻擊感覺根本對牠完全無效啊！！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n怎麼辦、",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "怎麼辦！？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "討厭，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
