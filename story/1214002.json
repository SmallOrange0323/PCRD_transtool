  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "還有……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這裡的客人，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我不會逃走的。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "因為我",
    "voice": "vo_adv_1214002_046",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "希望讓大家露出笑容！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這可是身為",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "成熟淑女的義務！　",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……你以為我會喊救命嗎？",
    "voice": "vo_adv_1214002_047",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n真遺憾！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你給我納命來吧！！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是你……！",
    "voice": "vo_adv_1214002_048",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "謝謝！！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不對，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你很慢耶！！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過",
    "voice": "vo_adv_1214002_049",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "幫大忙了！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n好，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我要上囉！",
