    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "身為淑女無論是什麼時候，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "都不會輕言放棄！　",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "為了依靠我的",
    "voice": "vo_adv_1214002_045",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
