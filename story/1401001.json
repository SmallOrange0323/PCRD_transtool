    "words": "布武機在煩惱許久後終於說出「拜託你了」，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n和{0}之間的攝影師契約，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n持續了整個夏天。",
    "voice": null,
