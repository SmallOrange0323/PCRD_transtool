    "words": "雜碎哥哥，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "要感謝我喔～？ｗ",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n能被我當作跑腿的，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "是超級人生勝利組吧♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "……啊？",
    "voice": "vo_adv_1401001_071",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n「跪坐等著",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "哥哥下剋上好好教育布武機的發展ｗ」",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "是什麼意思！？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我才不會讓哥哥下剋上呢！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "說到底，",
    "voice": "vo_adv_1401001_072",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "雜碎哥哥不可能贏得了我嘛！？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n教育超雜碎哥哥",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n明明是我要做的事！？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "話說都怪哥哥，",
    "voice": "vo_adv_1401001_073",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n我的「超級天才美少女的主人大人♡路線」",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n被誤會了啦～！？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我是要「教育」雜碎哥哥的人，",
    "voice": "vo_adv_1401001_074",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n才不是「被教育」那方呢～！？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n粉絲們",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "真是不懂我的雜碎！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "啊～",
    "voice": "vo_adv_1401001_075",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "真令人火大！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n雜碎哥哥，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "關掉直播！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "重來！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "從這步開始嗎！？",
    "voice": "vo_adv_1401001_076",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "啊……！？",
    "voice": "vo_adv_1401001_077",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "「馬上就被教育了ｗ」",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "「布武機，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "被哥哥克制了ｗ」",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n「真的要下剋上了！？」──！？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "區區雜碎哥哥，",
    "voice": "vo_adv_1401001_078",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "竟然高高在上的……！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "你們這些傢伙也",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "給我記住了～！！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "結果──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
