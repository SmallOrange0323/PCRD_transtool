  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生、",
    "voice": "vo_adv_6100103_000",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "如果下次要去旅行，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n您打算去哪裡呢？",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那就去吧，",
    "voice": "vo_adv_6100103_001",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也可以現在立刻出發♪",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "現在這個地方，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "只要有人家跟王子先生在，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就也是真步真步王國喔♪",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "跟童話世界一樣，",
    "voice": "vo_adv_6100103_002",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好令人憧憬哪。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那王子先生，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "必須開始",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "練習游泳才行呢♪",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "請您好好努力喔♪",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不管是每天的生活，",
    "voice": "vo_adv_6100103_003",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還是出門旅行的時候。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "與",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生的冒險隨時",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "都在持續當中呢。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n一旦這麼想，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就覺得平穩的每一天",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也令人心跳加速哪♪",
    "voice": null,
    "unit_id": 123111
  }
]
