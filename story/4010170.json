  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯，",
    "voice": "vo_adv_4010170_000",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "早安……",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不對，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是午安？",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "對不起喔～",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "因為昨天畫圖忙到很晚，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我對時間的感覺有點錯亂了。",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "所以",
    "voice": "vo_adv_4010170_001",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "今天找我有什麼事呢？",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "因為你很少主動聯絡我，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嚇了我一跳～",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "生日？",
    "voice": "vo_adv_4010170_002",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "啊～",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "已經到了這個時期啦～",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也有禮物嗎？",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我好高興～",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "長大之後，",
    "voice": "vo_adv_4010170_003",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就會很容易忘記這種活動呢～",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n畢竟也沒有其他會幫我慶祝的人，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "要是沒有你，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我就要度過",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "史上最寂寞的生日了～",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "明明以前",
    "voice": "vo_adv_4010170_004",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "會每天倒數期待生日的說……",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "如果願望能實現的話，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n真想像那時候一樣",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "用閃閃亮亮的心情",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "過生日呢～～～～",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "咦～",
    "voice": "vo_adv_4010170_005",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你這樣說沒關係嗎？",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n要是用那個表情說這種話，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我會變得比平常更任性喔？",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯……",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那麼，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我有個請求。",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "今天在這之後",
    "voice": "vo_adv_4010170_006",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "要一～",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "直",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "跟我在一起……♪",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "讓我仔細地",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "好好享受",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你溫暖的溫柔吧。",
    "voice": null,
    "unit_id": 106731
  }
]
