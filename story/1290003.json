    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "稍等我一下喔。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "\\n我想想看……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "那個……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "啊啊，",
    "voice": "vo_adv_1290003_061",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "我想起來了！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "有段話是這麼說的──",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "「紅玫瑰和黑玫瑰，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "都同樣是玫瑰。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "而愛",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "也同樣是愛。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "\\n只要有為彼此著想的心，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "玫瑰就必會盛開。」",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "──這是祖父告訴我的。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "所以……",
    "voice": "vo_adv_1290003_062",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "花苞會不會綻放，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "得要看大姐姐的心吧。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "不知道有沒有幫助到妳♪",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……看我的心……",
    "voice": "vo_adv_1290003_063",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……真是不錯的建議呢。",
    "voice": "vo_adv_1290003_064",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "呵呵呵，",
    "voice": "vo_adv_1290003_065",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "那真是太好了──",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "哎呀？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "剛剛，好像看到入口有人影……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "那是……！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女的祖父",
    "words": "我美麗的孫女啊。",
    "voice": "vo_adv_1290003_066",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女的祖父",
    "words": "\\n我來迎接妳了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "爺爺！",
