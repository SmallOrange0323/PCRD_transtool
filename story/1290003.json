    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "\\n因為我，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "也和爺爺一樣",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "早熟的少女",
    "words": "在擔任愛的使者呀♪",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女的祖父",
    "words": "呵呵呵，",
    "voice": "vo_adv_1290003_071",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女的祖父",
    "words": "那還真是做了件很美好的事呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女的祖父",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女的祖父",
    "words": "就先去買個玫瑰吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女的祖父",
    "words": "\\n為了妳的行動，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女的祖父",
