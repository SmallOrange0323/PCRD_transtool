    "name": "厄莉絲",
    "words": "想要和我一起共度時間。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n也想創造出更多的回憶。",
