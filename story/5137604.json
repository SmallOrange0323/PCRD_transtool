[
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "暇を持てあましたノウェムとオクトーは、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nたまたま鉢合わせたダイゴに話しかける。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "なあなあ、",
    "voice": "vo_adv_5111604_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "タンゴって",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "なんでそんなにケンカしたがるんだ？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "そりゃ俺より強いやつがいるのが気に入らないから……",
    "voice": "vo_adv_5111604_001",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "って待て。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "なんだそのタンゴってのは。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "そんな理由でケンカふっかけてるの？",
    "voice": "vo_adv_5111604_002",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "はー、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ダンゴってば単純だねえ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "単純で悪いか……",
    "voice": "vo_adv_5111604_003",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "っ",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "て待てやコラ！　",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "誰がダンゴだよ！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "はー、",
    "voice": "vo_adv_5111604_004",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "タンボは単純でいいよなあ……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nオマエもちょっとは見習ったらどうだ、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オクトー",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "えー、",
    "voice": "vo_adv_5111604_005",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ボクにはちょっと無理かなあ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "タンポみたいに考えなしには動けないよ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "だからなんだよさっきから！",
    "voice": "vo_adv_5111604_006",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "\\n俺はダイゴだ！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "お？　",
    "voice": "vo_adv_5111604_007",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "悪い悪い。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "でもさあ、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "もし強いヤツらを全部倒しちゃったら",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "テンポはどうすんだ？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n戦うのやめるのか？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "それってむなしくない？",
    "voice": "vo_adv_5111604_008",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "戦いだけが人生じゃないよ、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "サンポ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "オ～",
    "voice": "vo_adv_5111604_009",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "マ～",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "エ～",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "ら～",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "\\nわざとやってるだろ！？",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "\\nいい加減にしろよコラ！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "あはは、",
    "voice": "vo_adv_5111604_010",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "バレたか。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "いやー、",
    "voice": "vo_adv_5111604_011",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "どこまで気付かないか",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "試したかったんだけどねえ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "最初から気付いてるんだよ！",
    "voice": "vo_adv_5111604_012",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "もしかしてお前ら、",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "俺にケンカ売ってんのか？",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そうカッカすんなって。",
    "voice": "vo_adv_5111604_013",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n頭に血が上りすぎだぞ、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ディアゴ。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "俺はディアゴじゃねえ！",
    "voice": "vo_adv_5111604_014",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "\\nいい度胸だ……",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "ケンカ売ってんなら買ってやるよ！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "まあまあ、",
    "voice": "vo_adv_5111604_015",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "これは訓練みたいなもんだって。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "平常心を保つ訓練。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ね、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "タイコ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "俺はタイコじゃねえ！",
    "voice": "vo_adv_5111604_016",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "\\nもう我慢できねえ！　",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "覚悟しろテメェら！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "挑発に弱いのが",
    "voice": "vo_adv_5111604_017",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オマエの弱点なんだよなあ。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "そんなにカッカしやすいと",
    "voice": "vo_adv_5111604_018",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "足をすくわれるよ？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nダイゴ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "うるせー！　",
    "voice": "vo_adv_5111604_019",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "俺はダイゴじゃねえ！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "……あ？",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ダイゴじゃないってさ。",
    "voice": "vo_adv_5111604_020",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "じ",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ゃあもしかして",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ダイコンか？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ほら、",
    "voice": "vo_adv_5111604_021",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "足をすくわれた。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "だからもうちょっと冷静に……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ダイゴ",
    "words": "うがあああああああ！",
    "voice": "vo_adv_5111604_022",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "うわっ！　",
    "voice": "vo_adv_5111604_023",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "キレた！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "めっちゃくちゃ暴れてるぞ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "逃げろ逃げろ～！",
    "voice": "vo_adv_5111604_024",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "笑いながら走って逃げだすノウェムとオクトーであった。",
    "voice": null,
    "unit_id": null
  }
]
