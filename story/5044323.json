[
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這招怎樣啊──！",
    "voice": "vo_adv_5044323_000",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "唔……",
    "voice": "vo_adv_5044323_001",
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "唔唔唔……",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哦哦，",
    "voice": "vo_adv_5044323_002",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "總算是安靜下來了嗎！？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯～",
    "voice": "vo_adv_5044323_003",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "很遺憾，好像還沒有喔～",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n他正在凝聚很不得了的力量……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是比之前都還更驚人的力量～",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "算了！",
    "voice": "vo_adv_5044323_004",
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "\\n不懂本大爺魅力的女孩子，",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "本大爺不需要！",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "居然說",
    "voice": "vo_adv_5044323_005",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不需要……？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你把人當成物品看待的態度真是不知節制呢。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "礙眼。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "太礙眼了，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你這種行為……！",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……咱們這邊也在凝聚很不得了的力量喵～",
    "voice": "vo_adv_5044323_006",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "唔、",
    "voice": "vo_adv_5044323_007",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗯……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不禁令人寒毛直立……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "本大爺說不需要就是不需要啦～！",
    "voice": "vo_adv_5044323_008",
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "\\n本大爺要讓妳們後悔",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "沒有加入本大爺的後宮！！",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "本大爺不會再手下留情了！！",
    "voice": "vo_adv_5044323_009",
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "\\n本大爺要使出真本事",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "讓這裡所有人",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "都沉進銀河之中～！！",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "正合我意。",
    "voice": "vo_adv_5044323_010",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我就用這把刀，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "斬斷你那扭曲的性格吧！",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n讓你知道什麼叫作",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一敗塗地、片甲不留！",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這、",
    "voice": "vo_adv_5044323_011",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這不是能夠保留實力的氣氛呢……！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是啊。",
    "voice": "vo_adv_5044323_012",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我也解放",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "所有的力量吧……！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "走，我們上！",
    "voice": "vo_adv_5044323_013",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "杏奈、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "七七香、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥！！",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n使出我們的全力，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "狠狠教訓那傢伙吧！！",
    "voice": null,
    "unit_id": 113111
  }
