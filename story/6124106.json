  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "接客というのは、",
    "voice": "vo_adv_6114106_000",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "軍人の職務に負けず劣らず過酷なものだな。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "常に笑顔を浮かべていると、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "だんだん頬が引きつってしまうし、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n立ちっぱなしでは足も痛む……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "むむむ、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "どうしたものか。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "猫を……",
    "voice": "vo_adv_6114106_001",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "吸う？　",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "貴公、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "なにを言っているのだ。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n猫は液体だから？　",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ま、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ますます意味が分からんぞ！？",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n後ほどタマキにも聞いてみるか……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "噓だったら承知しないぞ、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "貴公！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "き、",
    "voice": "vo_adv_6114106_002",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "貴公がか？　",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "そのような技能があったとは初耳だが……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "──お、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "おおっ？　",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "これは、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "なかなか……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ん～、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "心地がいいな。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "手から伝わる体温が、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ほどよく眠気を誘って……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ぐぅ……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "そ、",
    "voice": "vo_adv_6114106_003",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "そうか……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "私がこれほど疲労しているのだ。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nほかの者たちはさらに消耗しているに違いないものな。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "互いを労り、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "気遣う……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "大切なことだ。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "貴公もつらいときは言うのだぞ！",
    "voice": null,
    "unit_id": 125212
  }
]
