  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦！？",
    "voice": "vo_adv_9500017_000",
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "騙、",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "騙人的吧……！",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n這個，",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "也就是說……",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是那個意思，對吧！？",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "哇哇，",
    "voice": "vo_adv_9500017_001",
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "怎麼辦～",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "臉頰開始發燙了！",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "心跳個不停，",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嘿嘿、",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嘿嘿……♪",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那個啊……",
    "voice": "vo_adv_9500017_002",
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "很久之前，",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "在你睡著的時候，",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我也曾",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "偷～偷地……",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "試圖傳達我的心意。",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不過，",
    "voice": "vo_adv_9500017_003",
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我果然還是",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "希望你能好好明白我的心意……",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "所以我想再來一次，",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這次我要坦率地傳達給你。",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你啊，",
    "voice": "vo_adv_9500017_004",
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就算我不小心使用了超能力，",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n也總是能找到我……",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n為了不讓我",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "輕飄飄～地飄走，",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "而牽住我的手。",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你非常溫柔，",
    "voice": "vo_adv_9500017_005",
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "又很有趣。",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n認真、",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "帥氣，",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "還很親切……",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這樣的{0}，",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我──",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "全世界最～喜歡你了，",
    "voice": "vo_adv_9500017_006",
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n比任何人都還要",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "喜歡你！",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊、",
    "voice": "vo_adv_9500017_007",
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "說出來了……♪",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n謝謝你",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "願意聽我說☆",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "原來你也有",
    "voice": "vo_adv_9500017_008",
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "一樣的心情啊……",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嘿嘿♪",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "今後",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "也要一直在一起喔。",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n只要兩個人在一起，",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就沒有什麼可怕的了！",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……所以，",
    "voice": "vo_adv_9500017_009",
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這次一定也沒問題！",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我們手牽手一起回家吧。",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "和最喜歡的小栞一起！",
    "voice": "vo_adv_9500017_010",
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "回到最喜歡的大家身邊！",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n和最最最～",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "最喜歡的",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你一起",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "喔♪",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "為了世界和平，",
    "voice": null,
    "unit_id": 101241
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我會努力的～！",
    "voice": null,
    "unit_id": 101241
  }
