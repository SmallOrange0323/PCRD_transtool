  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……",
    "voice": "vo_adv_1114006_000",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……啊。",
    "voice": "vo_adv_1114006_001",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……",
    "voice": "vo_adv_1114006_002",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n……大哥哥早就知道了嗎？",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……",
    "voice": "vo_adv_1114006_003",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "露娜，聽到了唷。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n那個老婆婆，",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "殺了露娜的爸爸和媽媽。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "她說了吧……",
    "voice": "vo_adv_1114006_004",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "我聽到了唷。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……為什麼？",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……這是真的嗎？",
    "voice": "vo_adv_1114006_005",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……",
    "voice": "vo_adv_1114006_006",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "…………",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "老婆婆",
    "voice": "vo_adv_1114006_007",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "是不好的人嗎？",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "但是，",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "她的三明治很好吃……",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……露娜，",
    "voice": "vo_adv_1114006_008",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "搞不清楚了。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "露娜低著頭垂下臉來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}叫了她，她也不回話。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "覺得露娜和老婆婆直接當面談比較好的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n離開露娜身邊前往尋找老婆婆。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500172"
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……",
    "voice": "vo_adv_1114006_009",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n……你怎麼了，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "怎麼這個表情。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……啊，",
    "voice": "vo_adv_1114006_010",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "難不成",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那個孩子發生了什麼……！？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……是啊。",
    "voice": "vo_adv_1114006_011",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n你說得對。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "就這樣一直逃避，",
    "voice": "vo_adv_1114006_012",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "什麼都不會改變的。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n我自己也知道。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……但即使知道，",
    "voice": "vo_adv_1114006_013",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "也沒能做到。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "之前都一直這樣。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我能做的事，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "就是烤麵包而已。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……我一個人的話，",
    "voice": "vo_adv_1114006_014",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "就會",
