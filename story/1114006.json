  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "來到森林深處的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n找到了籠罩悲傷氣氛的露娜。",
    "voice": null,
