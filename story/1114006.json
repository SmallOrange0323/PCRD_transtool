  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "老婆婆……！？",
    "voice": "vo_adv_1114006_025",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "老婆婆跑到魔物前，保護了露娜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}用劍斬了魔物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500532"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――嘎喔喔喔喔喔！",
