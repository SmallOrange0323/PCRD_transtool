  {
    "type": "background",
    "bg_id": "500532"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "到達露娜洋房附近的{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n等待著{0}的，竟是魔物的咆哮聲。",
