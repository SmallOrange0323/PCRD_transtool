[
  {
    "type": "dialogue",
    "name": "深月",
    "words": "溫泉之神",
    "voice": "vo_adv_5108203_000",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "罪惡與汙穢逐漸祛除了……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "太好了，",
    "voice": "vo_adv_5108203_001",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "祂好像滿足了呢。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "深月、",
    "voice": "vo_adv_5108203_002",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "美里，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "沒時間這麼悠閒了。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n尾牙得馬上繼續才行，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "因為客人在等了啊～♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯，",
    "voice": "vo_adv_5108203_003",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "加緊腳步吧。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我們正要去收拾",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "散亂的會場對吧。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……現場肯定相當凌亂，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我們先做好覺悟吧。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "服務業真的很辛苦呢。",
    "voice": "vo_adv_5108203_004",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n連喘口氣的時間都沒有……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "好了好了，深月。",
    "voice": "vo_adv_5108203_005",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我等一下會幫妳擦背的，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "好嗎？☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯呵呵。",
    "voice": "vo_adv_5108203_006",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我就負責按摩。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還真是周到耶。",
    "voice": "vo_adv_5108203_007",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……既然如此，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我就稍微再加把勁吧。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那麼，",
    "voice": "vo_adv_5108203_008",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就往尾牙會場",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "出發囉～！",
    "voice": null,
    "unit_id": 124511
  }
]
