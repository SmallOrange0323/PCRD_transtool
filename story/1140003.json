[
  {
    "type": "background",
    "bg_id": "501132"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "人多熱鬧的萬聖節樂園大街，\\n怜與{0}兩人也在其中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "聚集了相當多的人潮呢……",
    "voice": "vo_adv_1140003_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n這裡的遊行",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "有這麼有名嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "據說",
    "voice": "vo_adv_1140003_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "是找來了有名的劇團和樂隊喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n聽說在表演上花了非常多心力，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "很值得一看的樣子！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這還真是厲害呢……",
    "voice": "vo_adv_1140003_002",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n逛攤販的時候，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也被那人潮給震驚到了……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但不愧是重點活動，",
    "voice": "vo_adv_1140003_003",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "很受注目呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "幸好有趁早占位子，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "在這裡應該能看得很清楚。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "話又說回來……",
    "voice": "vo_adv_1140003_004",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n今天讓你破費買了很多東西給我，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真的沒關係嗎？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……嗯，",
    "voice": "vo_adv_1140003_005",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我知道了，所以快把錢包收起來。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n已經晚上了，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要是弄丟可不好。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好像差不多要開始了，",
    "voice": "vo_adv_1140003_006",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n有人出來了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "萬聖節快樂！",
    "voice": "vo_adv_1140003_007",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n萬聖節樂園的各位～！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "大家好～！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n現在開始",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "有特別遊行要來囉！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "來，",
    "voice": "vo_adv_1140003_008",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "讓我們盛大地拍手歡迎",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n萬聖節的夥伴們吧！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "媽媽",
    "voice": "vo_adv_1140003_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "妳看～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "有好大的南瓜馬車！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n閃閃發光的！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "呵呵，",
    "voice": "vo_adv_1140003_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "對啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "非常漂亮呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "妳看那邊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "有魔女喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "真的耶～！",
    "voice": "vo_adv_1140003_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "好厲害～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "得感謝告訴我們",
    "voice": "vo_adv_1140003_012",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n有遊行的攤販老闆才行呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要是再晚一點來，",
    "voice": "vo_adv_1140003_013",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我們就只能在更後面的地方看了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，",
    "voice": "vo_adv_1140003_014",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還真是沒想到會聚集這麼多遊客。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n觀眾現在看起來也還持續再增加的樣子，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊，不，",
    "voice": "vo_adv_1140003_015",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒什麼。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我只是在想事情，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你別在意。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……感覺",
    "voice": "vo_adv_1140003_016",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "肩膀就要碰在一起了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "被人群推擠，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "和他的距離變得越來越接近了……！　",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然平時不在意這種事情，",
    "voice": "vo_adv_1140003_017",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但像這樣站在身旁，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就讓人意識到他也是男生……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "身高和我明明和我差沒多少，",
    "voice": "vo_adv_1140003_018",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但卻能清楚知道他身體意外地結實。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊，",
    "voice": "vo_adv_1140003_019",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我在盯著人家在看什麼啊！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這再怎麼說也太沒禮貌了，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對他會很失禮吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是我太過在意了嗎？",
    "voice": "vo_adv_1140003_020",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n他看起來倒是和平時一樣……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "話又說回來，",
    "voice": "vo_adv_1140003_021",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這也太近了……！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不行，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "得稍微拉開距離讓自己冷靜下來才行……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個，",
    "voice": "vo_adv_1140003_022",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你稍微往那邊靠一點──",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "…………！",
    "voice": "vo_adv_1140003_023",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "抱、",
    "voice": "vo_adv_1140003_024",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我手碰到你了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我在",
    "voice": "vo_adv_1140003_025",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "緊張些什麼啊……！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n只要表現得和平時一樣就行了啊。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "冷靜，",
    "voice": "vo_adv_1140003_026",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "靜下心來，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "整頓呼吸……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，",
    "voice": "vo_adv_1140003_027",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們距離明明貼得那麼近，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n他卻還能那麼自然的樣子，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那態度不也很奇怪嗎？　",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也",
    "voice": "vo_adv_1140003_028",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "像這樣稍微做了點打扮，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n他至少表現出有點緊張等等，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "類似這類的反應也好啊……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……！？",
    "voice": "vo_adv_1140003_029",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你突然說",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "什麼……！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……你是說遊行的",
    "voice": "vo_adv_1140003_030",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個馬車？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊、",
    "voice": "vo_adv_1140003_031",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n是在說那個啊……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嚇了我一跳。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "都怪你說什麼奇怪的話，",
    "voice": "vo_adv_1140003_032",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這不是害我誤會了嗎……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……不，",
    "voice": "vo_adv_1140003_033",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒什麼，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你別在意。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你完全不需要在意。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過……",
    "voice": "vo_adv_1140003_034",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無論男女老少大家都帶著笑容呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n……嗯，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是美好的景色。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "接下來就是期盼已久的活動！",
    "voice": "vo_adv_1140003_035",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n由特地遠道而來的",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n劇團成員們",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "所演出的表演秀！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "讓你分分秒秒都",
    "voice": "vo_adv_1140003_036",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "目不轉睛！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n讓我們帶領大家",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "前往緊張興奮",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "又充滿刺激的世界！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "遊行也開始要進入重頭戲了吧。",
    "voice": "vo_adv_1140003_037",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "喂，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你看。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就像那邊──",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我說你，",
    "voice": "vo_adv_1140003_038",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還好嗎！？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_1140003_039",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個男人……",
    "voice": "vo_adv_1140003_040",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "…………",
    "voice": "vo_adv_1140003_041",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你",
    "voice": "vo_adv_1140003_042",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有沒有受傷？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……看來好像沒事，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "太好了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "氣氛都被打壞了呢。",
    "voice": "vo_adv_1140003_043",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n……難得的好心情都沒了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，",
    "voice": "vo_adv_1140003_044",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要是心情就這麼消沉下去就太浪費了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這可是難得的機會，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不好好享受就太可惜了對吧？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好，",
    "voice": "vo_adv_1140003_045",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就去買個飲料來轉換心情吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你有什麼想喝的？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我請你。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這點錢能不能讓我來出？",
    "voice": "vo_adv_1140003_046",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你買了很多東西給我，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n希望至少能讓我回點禮。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "所以說，",
    "voice": "vo_adv_1140003_047",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "把錢包收起來吧……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……怎麼了？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你",
    "voice": "vo_adv_1140003_048",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "把錢包弄丟了！？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你錢包到剛才都還有在身上吧？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n……總之，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "先找找看有沒有掉在附近吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……很遺憾，",
    "voice": "vo_adv_1140003_049",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這附近都沒找到。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果弄丟的話，",
    "voice": "vo_adv_1140003_050",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "應該是在這附近才對。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們也沒有從看過錢包的地方",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "移動過。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要說其他可能的話……",
    "voice": "vo_adv_1140003_051",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_1140003_052",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這麼說來，那個男人……",
    "voice": "vo_adv_1140003_053",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n似乎都沒有在看遊行……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們這個位置",
    "voice": "vo_adv_1140003_054",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要觀看遊行，\\n算是相當好的觀眾席。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n要找比這裡更好的地方，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "以時段來說太晚了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……而且對方在撞到你之後，",
    "voice": "vo_adv_1140003_055",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n還匆匆忙忙地走掉，這也很令人在意。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個時候雖然沒有太過留意，",
    "voice": "vo_adv_1140003_056",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但說不定……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也並不是說有什麼證據……",
    "voice": "vo_adv_1140003_057",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但以狀況而言，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我認為嫌疑很大。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "去找找看那個變裝男吧，",
    "voice": "vo_adv_1140003_058",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n對方應該也還記得我們的樣子。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謹慎地找人，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "避免有個萬一讓對方逃走。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……找到了！",
    "voice": "vo_adv_1140003_059",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就是那個男人！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_1140003_060",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "唔哇！",
    "voice": "vo_adv_1140003_061",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "哦哦……！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "那傢伙",
    "voice": "vo_adv_1140003_062",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "是怎樣啊……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……先是故意撞人，",
    "voice": "vo_adv_1140003_063",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n再趁對方注意鬆懈時下手行竊是嗎，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是老套的手法。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是，在這人潮下……",
    "voice": "vo_adv_1140003_064",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n只要躲起來的話，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一下子就\\n找不到犯人是誰了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "居然趁著慶典混亂時做壞事，",
    "voice": "vo_adv_1140003_065",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我絕不放過他。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……難得的好氣氛都破壞了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "去抓住那個男人吧，",
    "voice": "vo_adv_1140003_066",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你也",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "放慢動作跟在我後面。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………！",
    "voice": "vo_adv_1140003_067",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n那些傢伙是……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "被他注意到了……！",
    "voice": "vo_adv_1140003_068",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "站住，那邊的男人！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "把偷走的錢包……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "嘖……！",
    "voice": "vo_adv_1140003_069",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……我跟你說，",
    "voice": "vo_adv_1140003_070",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n別看我這樣，我可是有盡量讓自己冷靜下來。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "畢竟我也不想",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "讓開心的慶典白費掉。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不管是對方撞到你，",
    "voice": "vo_adv_1140003_071",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還是壞了難得的好氣氛，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我也都為了低調地解決事情",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而拼命在壓抑自己。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是……",
    "voice": "vo_adv_1140003_072",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我忍耐也到極限了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n腦中明明還很冷靜，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但身體就是現在也感覺快要憤怒失控了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不用擔心，",
    "voice": "vo_adv_1140003_073",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我向你保證一定會拿回你的錢包。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……我絕對不會讓他逃走，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一定要讓他償還這個罪。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "嘿嘿嘿，",
    "voice": "vo_adv_1140003_074",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "就算被發現我偷東西，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n但只要能逃得過就沒問題了。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "外行的一般人，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "怎麼可能追得上老子。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "參加慶典人都會變得很大手筆真不錯，",
    "voice": "vo_adv_1140003_075",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n身上都會帶著一大筆錢。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "……不過，",
    "voice": "vo_adv_1140003_076",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "臉被認出來倒是失誤了啊。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n在狀況平靜下來前，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "先暫時低調點吧──",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你別想逃！",
    "voice": "vo_adv_1140003_077",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "居然追上來了……！？",
    "voice": "vo_adv_1140003_078",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n可惡，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "真是些麻煩的傢伙……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "唔……",
    "voice": "vo_adv_1140003_079",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個男人",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "很熟悉萬聖節樂園的路嗎？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n似乎越來越往人煙稀少的地方前進了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "若對方是職業扒手，",
    "voice": "vo_adv_1140003_080",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要是完全跟丟",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就會這樣被他逃走然後不了了之吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "趁現在還能追到他的蹤影，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "必須想辦法逮住他。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……我有想到一個戰術。",
    "voice": "vo_adv_1140003_081",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n雖然不好意思，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但我想借用你的力量。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "呼……",
    "voice": "vo_adv_1140003_082",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "呼……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n像這樣到處逃竄，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "應該把他們給甩掉了吧……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "可惡，",
    "voice": "vo_adv_1140003_083",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "今天的獵物還真纏人……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "……",
    "voice": "vo_adv_1140003_084",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "但是，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "距離還夠遠。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n只要繼續這樣逃竄",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "就沒任何問題了。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "慶典的會場",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "根本就像我家的院子。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "只要在這複雜的小路裡跟他們拉開差距，",
    "voice": "vo_adv_1140003_085",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n之後再躲進森林裡的話，就能和他們說再見啦。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "不，慢著，",
    "voice": "vo_adv_1140003_086",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "我只看到那個小哥。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n應該有個和他在一起的女人，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "到底、",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "跑哪去……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "──我說過不會讓你逃走了吧。",
    "voice": "vo_adv_1140003_087",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "什麼……！",
    "voice": "vo_adv_1140003_088",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n是什麼時候……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "喝啊啊啊！",
    "voice": "vo_adv_1140003_089",
    "unit_id": 114011
  },
  {
    "type": "background",
    "bg_id": "501132"
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "唔唔……！",
    "voice": "vo_adv_1140003_090",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n可惡……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "怎麼會",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "這麼快……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……看來計畫很順利呢。",
    "voice": "vo_adv_1140003_091",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n正因為是這種視野差的小路，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "才能瞞過對方繞到前方並出其不意。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒想到一起逛會場的經驗，",
    "voice": "vo_adv_1140003_092",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n會以這種形式派上用場……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也謝謝你幫我強化。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呼……",
    "voice": "vo_adv_1140003_093",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然讓你幫我強化了，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但以這種打扮全力奔跑",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還是有點累人呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "會嗎？",
    "voice": "vo_adv_1140003_094",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我就當成讚美坦率地接受吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n謝謝，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "都是多虧有你的協助。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個我該高興嗎……？",
    "voice": "vo_adv_1140003_095",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不對，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你是在稱讚我吧，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看你的表情就知道了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "幸好有讓你陪我鍛鍊，",
    "voice": "vo_adv_1140003_096",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n事先讓身體習慣這服裝和裝備。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，",
    "voice": "vo_adv_1140003_097",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我雖然還有很多抱怨",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n想對這個昏過去的男人說……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……但沒想到會這麼輕易就結束，",
    "voice": "vo_adv_1140003_098",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n都讓人有點沒勁了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "比起自己竟然先擔心別人，",
    "voice": "vo_adv_1140003_099",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這該說很有你的風格嗎……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……是啊，",
    "voice": "vo_adv_1140003_100",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他們一定正在為錢包不見感到擔心，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n快點還回去讓他們放心吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "感謝你們",
    "voice": "vo_adv_1140003_101",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "協助逮捕犯人！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n──喂，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "給我走好！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個男人",
    "voice": "vo_adv_1140003_102",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "似乎是經常在慶典時出沒的\\n惡名昭彰的扒手。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "再深入調查應該還會查到更多罪證，",
    "voice": "vo_adv_1140003_103",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但那個騎士團的人會去做吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不管怎麼說……",
    "voice": "vo_adv_1140003_104",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你的錢包能拿回來真是太好了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不用客氣。",
    "voice": "vo_adv_1140003_105",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然事件",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也像這樣順利解決了……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但這時間遊行應該也結束了吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然也不是說沒有那種想法……",
    "voice": "vo_adv_1140003_106",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但若重要的時間被人打擾，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不管是誰心情都不會好吧？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊……",
    "voice": "vo_adv_1140003_107",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒有，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不是。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那不是指",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "戀愛方面的意思。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不對，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也不是說完全沒有……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呃、",
    "voice": "vo_adv_1140003_108",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不對，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我想說的，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不是那種事情……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……那個，",
    "voice": "vo_adv_1140003_109",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我今天玩得很開心，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是真的。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "和你一起逛會場，",
    "voice": "vo_adv_1140003_110",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n體驗到了不少無論是",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有趣還是不有趣的事物。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果你沒有邀請我，",
    "voice": "vo_adv_1140003_111",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我今天",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就沒辦法體驗到這麼開心的感覺了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n所以……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "當這樣的心情卻不解風情的傢伙打擾時，",
    "voice": "vo_adv_1140003_112",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "讓我比平時還有點……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不對，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是相當地……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "感到憤怒。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "本來希望今天",
    "voice": "vo_adv_1140003_113",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "能開開心心地劃下句點……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但還真是令人覺得有點可惜呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……是啊。",
    "voice": "vo_adv_1140003_114",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說的也是，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你說得沒錯。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n萬聖節還沒有結束啊。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我的視野變得相當狹隘啊。",
    "voice": "vo_adv_1140003_115",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看來我的修行也還遠遠不夠呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……我們說好囉。",
    "voice": "vo_adv_1140003_116",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你要是毀約，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "到時候……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就像今天一樣，",
    "voice": "vo_adv_1140003_117",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "再讓你請客吧？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……我說笑的。",
    "voice": null,
    "unit_id": 114011
  },
  {
