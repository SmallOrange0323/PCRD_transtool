[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "流夏因為擊退妖刀的消息傳開，一躍成為鎮上的名人，\\n不論走到哪裡都會有人向她搭話，流夏對此開始感到疲倦。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唉……",
    "voice": "vo_adv_1056007_000",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "啊～！",
    "voice": "vo_adv_1056007_001",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "是流夏耶～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "喂，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "表演一下咻啪啪啪揮刀的樣子嘛！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "笨～蛋。",
    "voice": "vo_adv_1056007_002",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那可不是表演給人看的東西。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "下次再說吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "那個，流夏，",
    "voice": "vo_adv_1056007_003",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "之前提過的那件事情，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "真的沒辦法嗎？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那種事情請你找別人吧。",
    "voice": "vo_adv_1056007_004",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也可以介紹認識的人給你。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過我現在正要去釣魚呢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "啊～流夏！",
    "voice": "vo_adv_1056007_005",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我終於找到妳了！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "關於妳跟我兒子的相親啊……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呃，我之前就說過不行啦……！",
    "voice": "vo_adv_1056007_006",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咦，小哥！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你怎麼這麼晚來！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "來來，走吧走吧！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……真抱歉，",
    "voice": "vo_adv_1056007_007",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "讓你陪我演戲。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "感覺我也",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "很久沒見到你了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "之前的擊退殺人魔……",
    "voice": "vo_adv_1056007_008",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是擊退妖刀那件事好像被傳了出去。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如你所見，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我一躍成為鎮上的知名人物。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "結果最近連不認識的人，",
    "voice": "vo_adv_1056007_009",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也都會來找我搭話。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "剛剛跟我說話的人，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也是連名字都不知道……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我沒事。",
    "voice": "vo_adv_1056007_010",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過，謝謝你。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我不想再讓你擔心了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說起來，",
    "voice": "vo_adv_1056007_011",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "為何只有我一個人被這樣吹捧呢？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "挺身而出的你，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "才應該是大家讚揚的對象啊。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "挑戰者",
    "words": "打擾了～！",
    "voice": "vo_adv_1056007_012",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "挑戰者",
    "words": "您就是擊退殺人魔的流夏吧！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "挑戰者",
    "words": "\\n請務必和我單挑一場……！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我才不要！",
    "voice": "vo_adv_1056007_013",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要逃囉小哥！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "挑戰者",
    "words": "等、",
    "voice": "vo_adv_1056007_014",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "挑戰者",
    "words": "等等我──！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "挑戰者",
    "words": "我好不容易才找到您的──！？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是夠了！",
    "voice": "vo_adv_1056007_015",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "最近都是那種傢伙真受不了！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……延續剛剛的話題。",
    "voice": "vo_adv_1056007_016",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "因為我出名了，最近想藉著打倒我，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n來提升自己名氣的傢伙越來越多了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "明明我啊，",
    "voice": "vo_adv_1056007_017",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就只想悠悠哉哉地度日……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果是有煩惱的人來商量也就算了。",
    "voice": "vo_adv_1056007_018",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可是像這樣無謂的打鬥和紛爭到底有什麼意義呢？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真那麼想讓人見識自己的實力，",
    "voice": "vo_adv_1056007_019",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "去討伐魔物不就好了嗎。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你說是不是？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "太好了……",
    "voice": "vo_adv_1056007_020",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真高興你了解。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "除了幫助他人以外，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是別叫我跟人戰鬥啊……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "謝啦。",
    "voice": "vo_adv_1056007_021",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "其實我自己也很明白，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但忍不住就會去想這件事……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我也想早早跟這個煩惱",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "道別啊。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "多虧了現在這個情況，",
    "voice": "vo_adv_1056007_022",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就算像這樣手上拿著釣具出門，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n也沒辦法悠哉釣魚……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "而且連午睡都辦不到。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過，跟你聊了以後，",
    "voice": "vo_adv_1056007_023",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "感覺稍微輕鬆了一點。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n總覺得一直受到你的幫忙。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "最近公會的人也都很忙，",
    "voice": "vo_adv_1056007_024",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n沒有人有空聽我抱怨。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "對了，",
    "voice": "vo_adv_1056007_025",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "難得有機會，如果你不介意，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要不要讓我請你吃個飯？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n再聽我說點話吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼……",
    "voice": "vo_adv_1056007_026",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "終於可以放輕鬆了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我想要偶爾像這樣啊，",
    "voice": "vo_adv_1056007_027",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n和你一起悠悠哉哉的度過。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說起來，",
    "voice": "vo_adv_1056007_028",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我還沒有吃過",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這裡的鮮魚套餐呢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n幫你點一樣的好不好？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不好意思～",
    "voice": "vo_adv_1056007_029",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我要點餐……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳就是流夏？",
    "voice": "vo_adv_1056007_030",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……我就是，",
    "voice": "vo_adv_1056007_031",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳呢？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不必多說了！",
    "voice": "vo_adv_1056007_032",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我要打倒妳，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "替哥哥報仇！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "報仇這話聽起來可是不太平靜呢。",
    "voice": "vo_adv_1056007_033",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "在受傷之前，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "乖乖回家比較好喔。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "給我住口！",
    "voice": "vo_adv_1056007_034",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我哥哥被你們抓起來了！",
