  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "家裡已經沒半個人了，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比也什麼都沒想起來。",
    "voice": null,
    "unit_id": 122311
  },
