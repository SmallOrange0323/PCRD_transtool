    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "反正妾身城裡有很多空房間。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妳儘管用吧。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦？",
    "voice": "vo_adv_1223007_063",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比可以住在這裡嗎……？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對於身懷霸者之力，",
    "voice": "vo_adv_1223007_064",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n卻不具備相應自覺與要領的幼稚之人，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身身為王無法置之不理。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "況且說不準又會有伯爵之類的人盯上妳，",
    "voice": "vo_adv_1223007_065",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "目前還是",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "留妳在身邊監視比較妥當。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "唔…………",
    "voice": "vo_adv_1223007_066",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還有……",
    "voice": "vo_adv_1223007_067",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "先不論打掃，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身非常中意妳煮的湯。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n……這理由，妳有異議嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "伊莉亞……",
    "voice": "vo_adv_1223007_068",
    "unit_id": 122311
  },
