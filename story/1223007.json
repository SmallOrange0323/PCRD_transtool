    "name": "班比",
    "words": "對了，",
    "voice": "vo_adv_1223007_069",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "接下來不是要吃晚餐了嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
