    "words": "也正因為如此，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我才更要",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "在此阻止妳才行。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "七七香",
