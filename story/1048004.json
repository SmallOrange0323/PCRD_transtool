  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那麼，今天也要訓練喔！",
    "voice": "vo_adv_1048004_000",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "試試接我一擊吧！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不錯嘛！ 刀刃的交會之處火花四散呢！",
    "voice": "vo_adv_1048004_001",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……咦？ 不是火花？",
    "voice": "vo_adv_1048004_002",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n這道光完全沒有消失啊。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "而且變得越來越大……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呀啊啊啊啊啊！",
    "voice": "vo_adv_1048004_003",
    "unit_id": 104811
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呼、",
    "voice": "vo_adv_1048004_004",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呼……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "還、還有追來嗎……？",
    "voice": "vo_adv_1048004_005",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……！ 你、你！",
    "voice": "vo_adv_1048004_006",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": " 安、安靜一下！",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我要封住你的嘴喔！",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊，對了，用這個背擋住的話！",
    "voice": "vo_adv_1048004_007",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你！ 讓我躲在你的背後一下吧！",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……！ ",
    "voice": "vo_adv_1048004_008",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "來了！",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "喔喔喔喔喔――！ 美冬，",
    "voice": "vo_adv_1048004_009",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "妳在哪裡―――！",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "說不定在那裡喔！ 去找吧――！",
    "voice": "vo_adv_1048004_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n嗚喔喔喔喔喔喔喔――――！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……呼，似乎總算是避開她們了呢。",
    "voice": "vo_adv_1048004_011",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦，你問我剛剛成群的女孩子是怎麼了嗎？",
    "voice": "vo_adv_1048004_012",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那個啊……我在打工的地方呼籲改善女性的工作環境，",
    "voice": "vo_adv_1048004_013",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n為了提高工資而努力後，不知不覺間，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就像那樣開始受到女孩子們仰慕…",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "…",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "明天在打工的地方有個舞會……",
    "voice": "vo_adv_1048004_014",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "結果想要我當舞伴的邀請蜂擁而至，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n變成那個樣子了呢……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦……？ 我、我才沒和男孩子……說過話呢。",
    "voice": "vo_adv_1048004_015",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n除了你以外……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那個，等等，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n不要用那種同情的眼神看我啊！？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊，那些孩子們回來了！",
    "voice": "vo_adv_1048004_016",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n這次……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "進到那邊的小巷避開她們吧！",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你也一起進來！",
    "voice": "vo_adv_1048004_017",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……雖然順勢進來了……",
    "voice": "vo_adv_1048004_018",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但是這條小巷好窄啊……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這、這也是不得已的事，",
    "voice": "vo_adv_1048004_019",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我就這麼順勢拉你進來了！",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊，你的頭還露在外面！",
    "voice": "vo_adv_1048004_020",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "如、如果不再靠近一點是藏不住的喔！",
    "voice": "vo_adv_1048004_021",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "還、還有露出一點嗎？",
    "voice": "vo_adv_1048004_022",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "要更有效率地躲起來，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就要把這隻手臂像這樣，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "繞過頭……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "等、等一下，總覺得身體好熱啊！？",
    "voice": "vo_adv_1048004_023",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但、但是還不夠有效率呢。",
    "voice": "vo_adv_1048004_024",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "要更有效率地躲起來，只要把你的頭，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "伸、伸到我的大腿之間的話……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我、我知道了。",
    "voice": "vo_adv_1048004_025",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n你、",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你就這樣低下頭，在、在我的……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "大腿",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n之間……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "果、果然還是不行――――",
    "voice": "vo_adv_1048004_026",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "！",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "美冬用力把{0}的頭推回原處的瞬間，\\n兩人從小巷裡被拋了出去。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呀啊！ ",
    "voice": "vo_adv_1048004_027",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好痛……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那個，這裡是……？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "啊，在那裡！ ",
    "voice": "vo_adv_1048004_028",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "美冬――――！",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "和我一起跳舞――――！",
    "voice": "vo_adv_1048004_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "被、被發現了！ ",
    "voice": "vo_adv_1048004_030",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你，要逃跑了喔！",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗚嗚……我真是的，竟然會做出沒效率的行為……",
    "voice": "vo_adv_1048004_031",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真是失策啊…",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "…",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如何呢？ 這是我給你的禮物！ 你做了個好『夢』嗎？",
    "voice": "vo_adv_1048004_032",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "剛剛的情景，是我依照你和美冬的『記憶碎片』",
    "voice": "vo_adv_1048004_033",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n創造出來的『夢』唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話雖如此，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你還真是佔了不少好處呢。算了，沒關係。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果你收集到更多的『記憶碎片』，",
    "voice": "vo_adv_1048004_034",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我就會再讓你做『夢』的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你和許多女孩在一起的『夢』做得越多……",
    "voice": "vo_adv_1048004_035",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就可以藉此還原世界的真實面貌。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要加油喔♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次見囉～♪",
    "voice": "vo_adv_1048004_036",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦……剛剛的是夢……？",
    "voice": "vo_adv_1048004_037",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你也做了一樣的夢嗎？",
    "voice": "vo_adv_1048004_038",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也有這樣不可思議的事情呢……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不管怎麼說，我做了沒有效率的事情……",
    "voice": "vo_adv_1048004_039",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不、不過都是因為你想要",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n把頭伸到那種地方……再怎麼說那也太……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊！ 已經這麼晚了！ 我必須要去打工了！",
    "voice": "vo_adv_1048004_040",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那麼，再見喔！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "美冬不知為何害羞地離開了……",
    "voice": null,
    "unit_id": null
  }
]
