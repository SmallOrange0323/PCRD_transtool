[
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "求求妳！",
    "voice": "vo_adv_5061321_000",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "聽我說一下話吧！",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "難纏的傢伙。",
    "voice": "vo_adv_5061321_001",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "妾身已經不想再陪妳玩了。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n妳就跟牠們玩玩吧！",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呿、",
    "voice": "vo_adv_5061321_002",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "她還有手下啊？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n而且這數量",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "很棘手呢。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "熱鬧點是很好啦，",
    "voice": "vo_adv_5061321_003",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "可是看不到公主殿下的蹤影了。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這樣一來，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就不能跟她談話了呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果是這樣，那就全都把牠們擊倒吧！",
    "voice": "vo_adv_5061321_004",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n這麼一來，公主殿下也非得現身不可。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳就給我等著吧！",
    "voice": null,
    "unit_id": 115811
  }
]
