    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "就叫「姐姐",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "與老師",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "與被虐狂",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "與可愛的你的愛之巢穴」",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "好了♪",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "你要選這個……？",
    "voice": "vo_adv_6078104_003",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "真的嗎……？",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "確實",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "這是能令人感受到強大威力的名稱……",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n但連我們也被拖下水當作是被虐狂……",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "我會有點困擾……",
    "voice": null,
    "unit_id": 101812
  }
