    "name": "黑暗伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "靜流說",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "想叫「姐姐與弟弟的愛之巢穴」，",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n空花則說",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "「高深莫測被虐狂之館」比較好。",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "你覺得呢？",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "果然叫這個最好對吧！",
    "voice": "vo_adv_6078104_001",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "我就知道你會這麼說♪",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "那麼，",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "要馬上和老師",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "來上一堂",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "祕密課程嗎？",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "……",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "首先從數學開始喔♪",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "真是的，",
    "voice": "vo_adv_6078104_002",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "{0}很喜歡姐姐是吧？",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "但是，",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "這個名稱沒包含和我和空花，有點令人在意呢。",
