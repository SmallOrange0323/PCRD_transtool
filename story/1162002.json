[
  {
    "type": "background",
    "bg_id": "500743"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}參加滾大球比賽，\\n完美展現出了平均水準的活躍。\\n之後，他為了和好朋友社的成員會合而獨自徘徊在校園內。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "招攬客人的學生",
    "words": "各位好孩子們～！",
    "voice": "vo_adv_1162002_000",
    "unit_id": 2913
  },
  {
    "type": "dialogue",
    "name": "招攬客人的學生",
    "words": "\\n這裡是開心的射擊遊戲攤位喲～！",
    "voice": null,
    "unit_id": 2913
  },
  {
    "type": "dialogue",
    "name": "招攬客人的學生",
    "words": "哎呀，",
    "voice": "vo_adv_1162002_001",
    "unit_id": 2913
  },
  {
    "type": "dialogue",
    "name": "招攬客人的學生",
    "words": "那邊的大朋友們，",
    "voice": null,
    "unit_id": 2913
  },
  {
    "type": "dialogue",
    "name": "招攬客人的學生",
    "words": "要不要也來試試啊？",
    "voice": null,
    "unit_id": 2913
  },
  {
    "type": "dialogue",
    "name": "招攬客人的學生",
    "words": "\\n只要用弓箭",
    "voice": null,
    "unit_id": 2913
  },
  {
    "type": "dialogue",
    "name": "招攬客人的學生",
    "words": "射中目標，",
    "voice": null,
    "unit_id": 2913
  },
  {
    "type": "dialogue",
    "name": "招攬客人的學生",
    "words": "就會送您該獎品喔。",
    "voice": null,
    "unit_id": 2913
  },
  {
    "type": "dialogue",
    "name": "招攬客人的學生",
    "words": "是呀，",
    "voice": "vo_adv_1162002_002",
    "unit_id": 2913
  },
  {
    "type": "dialogue",
    "name": "招攬客人的學生",
    "words": "當然很好玩。",
    "voice": null,
    "unit_id": 2913
  },
  {
    "type": "dialogue",
    "name": "招攬客人的學生",
    "words": "\\n來吧來吧，",
    "voice": null,
    "unit_id": 2913
  },
  {
    "type": "dialogue",
    "name": "招攬客人的學生",
    "words": "請進請進，",
    "voice": null,
    "unit_id": 2913
  },
  {
    "type": "dialogue",
    "name": "招攬客人的學生",
    "words": "\\n這裡有一位客人喔～！",
    "voice": null,
    "unit_id": 2913
  },
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "很好～",
    "voice": "vo_adv_1162002_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我要瞄準那個人偶……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嘿！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊啊～",
    "voice": "vo_adv_1162002_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "歪掉了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "下一個",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "換姊姊來試試嘛。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "哈……",
    "voice": "vo_adv_1162002_005",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好是好啦，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但要是姊姊來挑戰，\\n就會因為太過簡單而稱不上是遊戲呀……",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嘿！",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "射歪了～！",
    "voice": "vo_adv_1162002_006",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n哈哈……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "好廢！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "好廢！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不行，",
    "voice": "vo_adv_1162002_007",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不算不算。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "剛才的不算數。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這根弦",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "狀況太差了。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n去叫一下店員來，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我要問這裡的商品是怎麼管理的。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "姊姊",
    "voice": "vo_adv_1162002_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "妳太幼稚了啦。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n惡劣的奧客，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "會被人看出成長環境不好喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": "vo_adv_1162002_009",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "誰怕誰啊，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我的出生成長環境可沒甚麼好藏的。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n那只不過是一條居民的混混指數偏高又大而化之的街道而已。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呀！",
    "voice": "vo_adv_1162002_010",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嚇我一跳……",
    "voice": "vo_adv_1162002_011",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "什麼嘛，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "原來是你……",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "啊，",
    "voice": "vo_adv_1162002_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "是姊姊常常帶回家的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "騎士大哥哥！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "等等，",
    "voice": "vo_adv_1162002_013",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "弟弟啊，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你剛才說了什麼？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你給我好好上國語課喔。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "姊姊可還沒嫁人，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好好注意你那種會引人誤會的說法。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "真是的！",
    "voice": "vo_adv_1162002_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "大哥哥，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "你這樣不行喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n我們家姊姊",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "只要有人突然從後面搭話，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n就會嚇到發出像是萌角色一樣的聲音。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "這樣可是名譽損毀。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不用說這些了啦。",
    "voice": "vo_adv_1162002_015",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好了，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好孩子首先應該要好好打招呼。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "你好！",
    "voice": "vo_adv_1162002_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n欸欸，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "大哥哥要不要也一起玩～？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不用啦，",
    "voice": "vo_adv_1162002_017",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不用啦。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這個大哥哥長得一臉很閒，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但其實意外地挺忙的。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "應該說……",
    "voice": "vo_adv_1162002_018",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真是抱歉呀，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這種時候我卻待在這種地方悠哉地玩。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你問有什麼好抱歉的，",
    "voice": "vo_adv_1162002_019",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "沒啦，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就是……",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n明明大家都在關心社團存亡，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "很認真地在努力。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n卻只有我在做",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "顧小孩這種",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "悠哉的事。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "……真好笑。",
    "voice": "vo_adv_1162002_020",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n那兩個人剛才也對我說了一樣的話。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "也是啦，",
    "voice": "vo_adv_1162002_021",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n畢竟我平常也很少有空陪這些孩子玩，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n至少在這種時候，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我想表現得像個姊姊。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "喔，",
    "voice": "vo_adv_1162002_022",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "比較小的弟弟們都在觀眾席，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n他們和我母親一起在休息。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "然後這孩子則是說",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "他想看看遊樂設施類的展覽。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "欸欸，",
    "voice": "vo_adv_1162002_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "大哥哥～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n好嘛好嘛，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "來跟我們一起玩～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "別扯他別扯他。",
    "voice": "vo_adv_1162002_024",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你看，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "大哥哥的奇怪斗篷",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "都整個往右歪了。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你也是，",
    "voice": "vo_adv_1162002_025",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不用在意我們，快走吧。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我直到下次出場前還有一點時間，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "所以還不──",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "真的嗎！？",
    "voice": "vo_adv_1162002_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n太棒了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "可以跟大哥哥玩～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "唉──真是的……",
    "voice": "vo_adv_1162002_027",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你可以不用",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那麼顧慮我們啦……",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "總覺得……",
    "voice": "vo_adv_1162002_028",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我家的孩子們",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "已經完全黏上你了。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你明明只有",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "來我家一兩次而已。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "咦？",
    "voice": "vo_adv_1162002_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "姊姊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "妳把他帶回家很多次了吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "弟弟。",
    "voice": "vo_adv_1162002_030",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我說啊。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "所以就說了。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n不要輕易地說什麼「帶回家」好嗎。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話說",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你是從哪裡學來這種話的。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "這個嗎，",
    "voice": "vo_adv_1162002_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "是切嚕大姐姐說的！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "……那傢伙該禁止入境了。",
    "voice": "vo_adv_1162002_032",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n她對小孩子的教育有不良影響。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "我跟你說，",
    "voice": "vo_adv_1162002_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "大哥哥！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n聽說外面有遊樂園喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n我們趕快過去吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "快點快點！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "所以說了，",
    "voice": "vo_adv_1162002_034",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "別拉他的奇怪斗篷啦。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n大哥哥整個人看起來都變得不對稱了。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯……？",
    "voice": "vo_adv_1162002_035",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "看起來有點像是暗黑騎士，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好像也不錯……？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "background",
    "bg_id": "501280"
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "哇，",
    "voice": "vo_adv_1162002_036",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "好厲害喔～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "是遊樂園～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "哦哦……",
    "voice": "vo_adv_1162002_037",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n真可愛，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真的就像是迷你遊樂園一樣。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦？",
    "voice": "vo_adv_1162002_038",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你不知道遊樂園嗎？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "在那裡可以搭乘魔法控制的高速貨車，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "從很高的地方一口氣掉下來，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n還可以搭著長翅膀的馬型魔像，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "漂浮在天上──",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "沒錯。",
    "voice": "vo_adv_1162002_039",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "遊樂園就是聚集了很多那種有趣設施的地方，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n而這裡算是它的簡易版，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "還是該說是人力版？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "大概就是這種感覺吧。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話雖如此，",
    "voice": "vo_adv_1162002_040",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這裡的規模也只有原型的十分之一而已。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這樣也不錯吧，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這對小孩子來說尺寸剛剛好。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "以學生手工重現的結果來說，已經算是很努力了。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": "vo_adv_1162002_041",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不是，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我就說了這是給小孩子玩的了。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你別搭啦，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "年紀都這麼大了──",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "──啊啊不對，",
    "voice": "vo_adv_1162002_042",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不是這樣的吧。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你不是想玩，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "而是願意陪我家的孩子玩，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是這樣對吧。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯……",
    "voice": "vo_adv_1162002_043",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "謝啦。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你以後",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "應該會成為一個好父親吧。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然我也不太清楚啦。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真是太好了呢，",
    "voice": "vo_adv_1162002_044",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "大哥哥說願意和你一起搭喔。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你想搭哪個設施？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "唔唔……",
    "voice": "vo_adv_1162002_045",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "怎麼了，",
    "voice": "vo_adv_1162002_046",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你在猶豫嗎？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "嗯……",
    "voice": "vo_adv_1162002_047",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n雖然很想搭……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "但感覺有一點可怕。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你聽到了嗎？",
    "voice": "vo_adv_1162002_048",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n他說會怕這種像是公園的遊樂器材一樣的手工遊樂設施欸。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然說話口氣很大，畢竟還是小孩子嘛。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我家弟弟，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "很可愛對吧？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你看看，",
    "voice": "vo_adv_1162002_049",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "大哥哥難得看起來很可靠喔。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這傢伙會看起來可靠，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "可是超稀有的事喔？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n好啦，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你就跟他一起去搭吧～？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "嗯……",
    "voice": "vo_adv_1162002_050",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n那不然這樣好了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "我在旁邊看著！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n姊姊妳和他去搭！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": "vo_adv_1162002_051",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，太詭異了。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "為什麼啊，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那樣不就沒有意義了嗎？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你說的話，就跟「我肚子餓了所以姊姊妳去吃吧」",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是一樣意思欸。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "這是試毒啊。",
    "voice": "vo_adv_1162002_052",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n姊姊你們去試搭",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "看會不會死掉。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": "vo_adv_1162002_053",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你這傢伙說什麼鬼話啊。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你要是以為什麼話都用小孩子天真的語氣說出口就會被原諒，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n那可大錯特錯了喔？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "啊～",
    "voice": "vo_adv_1162002_054",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "姊姊妳會怕對吧～？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "與其說是害怕，",
    "voice": "vo_adv_1162002_055",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我是覺得很丟臉啦。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我不是說了，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這是給小孩子搭的嗎？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不對，",
    "voice": "vo_adv_1162002_056",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我不是這個意思啦。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你不用現在重複之前的可靠台詞。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "……奇怪？",
    "voice": "vo_adv_1162002_057",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n話說這個男的難道……",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n不是為了顧小孩，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "只是單純自己想玩？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "然後啊，",
    "voice": "vo_adv_1162002_058",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "就是啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "我想想……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "我想搭那個！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "你們去搭那個！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "哪個？",
    "voice": "vo_adv_1162002_059",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "那個！",
    "voice": "vo_adv_1162002_060",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "那個唰──地用水滑下來的！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "擔任工作人員的學生",
    "words": "這邊的設施是",
    "voice": "vo_adv_1162002_061",
    "unit_id": 3112
  },
  {
    "type": "dialogue",
    "name": "擔任工作人員的學生",
    "words": "迷你滑水道喲～！",
    "voice": null,
    "unit_id": 3112
  },
  {
    "type": "dialogue",
    "name": "擔任工作人員的學生",
    "words": "\\n可以搭著迷你小船",
    "voice": null,
    "unit_id": 3112
  },
  {
    "type": "dialogue",
    "name": "擔任工作人員的學生",
    "words": "享受從迷你水道滑下去的感覺喔～！",
    "voice": null,
    "unit_id": 3112
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "哦～",
    "voice": "vo_adv_1162002_062",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "滑水道和人工水池呀。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n原來如此，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "居然還建造了這麼費工的東西……",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，船好小！",
    "voice": "vo_adv_1162002_063",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n不行這擠不進去吧。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n兩個大人搭那艘船，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "很明顯會超載呀。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "姊姊你們不是大人吧！",
    "voice": "vo_adv_1162002_064",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n你們正處於既不是小孩也不是大人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "這種不穩定的年紀不是嗎！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你真的都是從哪裡",
    "voice": "vo_adv_1162002_065",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "學來那些話的啊？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是粉紅女嗎？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "又是那個粉紅女嗎？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "不是，",
    "voice": "vo_adv_1162002_066",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "這是看起來很優妮的姐姐說的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "別說了快去搭吧！",
    "voice": "vo_adv_1162002_067",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n姊姊和大哥哥，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "你們兩個人去搭～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就算你這麼說……",
    "voice": "vo_adv_1162002_068",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我說啊，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n{0}你應該也",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不想要兩個人搭那個吧？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": "vo_adv_1162002_069",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不對等等，",
    "voice": "vo_adv_1162002_070",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你在說什麼啊？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n等一下，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你冷靜思考看看，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n兩個大人",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "怎麼一起搭那艘兒童尺寸的船──",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "太棒了～！",
    "voice": "vo_adv_1162002_071",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "\\n大哥哥說OK欸！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "很好，姊姊也確定要搭了～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "哈～～～！？",
    "voice": "vo_adv_1162002_072",
    "unit_id": 116211
  },
  {
    "type": "still",
    "still_id": "116200201"
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "…………",
    "voice": "vo_adv_1162002_073",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "……真的假的。",
    "voice": "vo_adv_1162002_074",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這樣會不會很不妙啊，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就各方面而言。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "擔任工作人員的學生",
    "words": "來吧，",
    "voice": "vo_adv_1162002_075",
    "unit_id": 3112
  },
  {
    "type": "dialogue",
    "name": "擔任工作人員的學生",
    "words": "兩位大朋友，",
    "voice": null,
    "unit_id": 3112
  },
  {
    "type": "dialogue",
    "name": "擔任工作人員的學生",
    "words": "\\n請你們抓好囉～！",
    "voice": null,
    "unit_id": 3112
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "等等……！",
    "voice": "vo_adv_1162002_076",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "喂店員，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不要推我。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我不是都說了",
    "voice": "vo_adv_1162002_077",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我還沒嫁人嗎。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這樣子",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "畫面看起來好像會很不妙欸……",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n喂，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真的沒問題嗎……？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "姊姊，",
    "voice": "vo_adv_1162002_078",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依的弟弟",
    "words": "妳怎麼突然變安靜了啊～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "少囉嗦。",
    "voice": "vo_adv_1162002_079",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n要是在這個狀態下還吵吵鬧鬧的，那不就只是單純的情侶放閃嗎。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "笨……",
    "voice": "vo_adv_1162002_080",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "白癡喔，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不要搖啦！",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話說，",
    "voice": "vo_adv_1162002_081",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你為什麼可以",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那麼保持平時的態度啊？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我覺得你這樣也是有點問題喔。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，",
    "voice": "vo_adv_1162002_082",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "算了……",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你覺得沒問題的話，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那倒是",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "無所謂啦……",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "擔任工作人員的學生",
    "words": "唔，",
    "voice": "vo_adv_1162002_083",
    "unit_id": 3112
  },
  {
    "type": "dialogue",
    "name": "擔任工作人員的學生",
    "words": "是愛情喜劇的氣氛……！",
    "voice": null,
    "unit_id": 3112
  },
  {
    "type": "dialogue",
    "name": "擔任工作人員的學生",
    "words": "好了快結束吧咚──！",
    "voice": "vo_adv_1162002_084",
    "unit_id": 3112
  },
  {
    "type": "dialogue",
