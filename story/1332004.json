    "name": "莫妮卡",
    "words": "畢竟我不能拒絕來自市民的好意吧……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "background",
    "bg_id": "510101"
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唉……",
    "voice": "vo_adv_1332004_046",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "還真是不順利呢。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不對，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這都是因為我天真地想要就近解決，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "所導致的結果。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "很好，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "從現在開始",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "到山中閉關──",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這是烤地瓜……！",
    "voice": "vo_adv_1332004_047",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你居然阻礙我的決心，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "到底有何居心！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "寒、",
    "voice": "vo_adv_1332004_048",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "寒假……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖、",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然是這樣沒錯，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我同時也是個軍人……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "真是的！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n把那個給我！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "still",
    "still_id": "133200401"
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "咕，",
    "voice": "vo_adv_1332004_049",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好、",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好好吃……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n未經多餘加工的地瓜",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "本身帶有的甜味",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "與恰到好處的熱度，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n沁入寒冷的身體裡！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過",
    "voice": "vo_adv_1332004_050",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "今天的烤地瓜",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "似乎還多了另一種美味。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n要形容的話，沒錯，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就是罪惡的味道。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然身為一個軍人",
    "voice": "vo_adv_1332004_051",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我感到非常遺憾，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但這份美味",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不論是誰都無法否定。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "still",
    "still_id": "133200402"
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就如閣下所說，",
    "voice": "vo_adv_1332004_052",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "休息也是",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "軍人的任務。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n這或許是上天的安排，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "要我現在先養精蓄銳，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "為下次的作戰做準備。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "無論平日再怎麼節制",
    "voice": "vo_adv_1332004_053",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "與鍛鍊，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n要是心靈和身體沒有餘裕，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就無法期待能有完美的工作表現。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "133200403"
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我自己一個人的話",
    "voice": "vo_adv_1332004_054",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "或許會因為太過固執而失敗。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "有閣下你在真是太好了。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "呼，",
    "voice": "vo_adv_1332004_055",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "謝謝招待。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "多虧了閣下讓我心中的迷惘也煙消雲散了，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n就從現在開始",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "盡全力享受假期吧。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "呼，",
    "voice": "vo_adv_1332004_056",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "即使太陽下山了",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "還是有很多能玩的。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n就算是遊戲我也不會手下留情的。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "來，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "走吧──！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好啦，",
    "voice": "vo_adv_1332004_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "新年快樂新年快樂～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "看來你的寒假過得很愉快真是太好了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為莫妮卡本身有著認真的軍人性格，",
    "voice": "vo_adv_1332004_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以有時候會太過逞強呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "跟你這樣悠閒的人待在一起",
    "voice": "vo_adv_1332004_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n剛好是最佳平衡。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然說是軍人，",
    "voice": "vo_adv_1332004_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但也是正值青春年華的女孩子，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n應該要好好享受這年紀女孩該有的樂趣才對，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "絕對沒錯。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我能肯定，",
    "voice": "vo_adv_1332004_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這樣的回憶會讓她變強。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話就說到這裡。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "回去好好享受寒假吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n再見囉～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯……",
    "voice": "vo_adv_1332004_062",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "呼啊……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "咦，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "難道我睡著了？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "居然會在白天的大街上睡著，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "難道我鬆懈過頭了嗎……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "因為",
    "voice": "vo_adv_1332004_063",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我連在夢裡",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "都在享受假期啊。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下也做了同樣的夢？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "還真是稀奇呢。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過話說回來，",
    "voice": "vo_adv_1332004_064",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "明明我期望的是那傢伙能有和平的新年，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n結果",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "卻連在夢裡都把他捲入了麻煩的事件裡……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "果然",
    "voice": "vo_adv_1332004_065",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我的能力可能還不夠……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下……",
    "voice": "vo_adv_1332004_066",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是啊，",
    "voice": "vo_adv_1332004_067",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這傢伙",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "根本不需要我去操心，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n是個即使面對困難",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
