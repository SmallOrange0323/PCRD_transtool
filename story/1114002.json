[
  {
    "type": "background",
    "bg_id": "500172"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "很在意露娜的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n再度造訪位於蘭德索爾之外的那座森林。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……你怎麼又來了呀？",
    "voice": "vo_adv_1114002_000",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不是叫你不要來了嗎……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……",
    "voice": "vo_adv_1114002_001",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……唉。",
    "voice": "vo_adv_1114002_002",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不，",
    "voice": "vo_adv_1114002_003",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n是我自己不好。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "年紀越大，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "個性就變得越乖僻真是不好呢……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "其實……",
    "voice": "vo_adv_1114002_004",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我很想請你聽我說說話。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n有關那個孩子……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "與我的事情。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……不好意思，",
    "voice": "vo_adv_1114002_005",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "可以聽我說一個很長的故事嗎？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……謝謝你呢。",
    "voice": "vo_adv_1114002_006",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不是愉快的故事喔。",
    "voice": "vo_adv_1114002_007",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不但如此，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "這還是一個無奈的故事。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……我啊，",
    "voice": "vo_adv_1114002_008",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "算是將那孩子的父母",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "給殺死了呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "是多久以前的事呢。",
    "voice": "vo_adv_1114002_009",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那個孩子，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "與她的父母",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "搬到了這座森林內。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "在森林深處，",
    "voice": "vo_adv_1114002_010",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "建造了一棟漂亮的洋房呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "就開始有些傳聞說",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "他們是哪裡的貴族呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "他們都是好人唷。",
    "voice": "vo_adv_1114002_011",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "和我們見面時，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "常常會幫忙各種事情呢……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……但是。",
    "voice": "vo_adv_1114002_012",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n某個夜晚，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "魔物突然暴走。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n襲擊了這棟洋房。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我呢……",
    "voice": "vo_adv_1114002_013",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n剛好，人正在附近……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "眼睜睜地看著一切發生。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n藏身樹叢內，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "全身不斷顫抖著。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……我的全身發軟",
    "voice": "vo_adv_1114002_014",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "無法站起來。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n如果那時能跑去呼救就好了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "是那樣就好了……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "等我能移動身體時……",
    "voice": "vo_adv_1114002_015",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n已經太遲了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "只有那個孩子，",
    "voice": "vo_adv_1114002_016",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "奇蹟地獲救……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "但是她的父母已經回天乏術。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n從那天開始，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那個孩子就剩下自己獨自一人。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……真是太丟人了。",
    "voice": "vo_adv_1114002_017",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "沒想過年紀變大，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "自己會變得那麼沒出息。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……我很卑鄙呢。",
    "voice": "vo_adv_1114002_018",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我一定是一直等著，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "會這樣對我說的人。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "因此……",
    "voice": "vo_adv_1114002_019",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n我不覺得自己沒錯。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "非常深切覺得，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我有錯呢……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那個孩子",
    "voice": "vo_adv_1114002_020",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "好像很喜歡你呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那個孩子，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "就拜託你了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}看著老婆婆離去的背影，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n決定前往森林深處的洋房一探究竟。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500532"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "前進一段時間後，周遭的景色徹底改變了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n簡直就像墓地一樣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "無數墓碑的彼端，靜靜佇立著一幢洋房。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}敲了敲洋房的門。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "111400201"
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……是誰？",
    "voice": "vo_adv_1114002_021",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……唔。",
    "voice": "vo_adv_1114002_022",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "你來做什麼……！",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n這裡是",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "露娜的家喔！",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……",
    "voice": "vo_adv_1114002_023",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n露娜，",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "討厭說謊的人。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "明明說過會跟我當朋友……",
    "voice": "vo_adv_1114002_024",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n……但是大家都逃走了，",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "討厭。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "別說奇怪的話。",
    "voice": "vo_adv_1114002_025",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……那是為了要跟你當朋友呀。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n要一直一直，",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "當永遠的朋友呀。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "你不知道嗎？",
    "voice": "vo_adv_1114002_026",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n死掉之後",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "就可以一直在一起唷。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "爸爸和媽媽和我說過。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……",
    "voice": "vo_adv_1114002_027",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n……你回去吧。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……你騙人。",
    "voice": "vo_adv_1114002_028",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "為什麼大家，",
    "voice": "vo_adv_1114002_029",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "都要騙露娜呢？",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n露娜，",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "只是想和大家一起玩而已……",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "still",
