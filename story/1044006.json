[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在城鎮裡一個人走著的伊莉亞，被衛兵抓住了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "剛才說過了，妾身不是迷路的小孩啦！",
    "voice": "vo_adv_1044006_000",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "嗯嗯，是啊。妳不是迷路的小孩呢。",
    "voice": "vo_adv_1044006_001",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n……那麼，妳家在哪裡呢？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n能告訴我妳的名字嗎？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就說不是了啊！",
    "voice": "vo_adv_1044006_002",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n別把妾身當成小孩！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "是啊。",
    "voice": "vo_adv_1044006_003",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n這位小小姐是個很出色的大人呢。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n那麼，妳爸爸跟媽媽在哪裡呢？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔～！你完全沒聽進去嘛！",
    "voice": "vo_adv_1044006_004",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "別把妾身當作罪犯！是迷路的小孩啦！",
    "voice": "vo_adv_1044006_005",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n……不對，妾身也不是迷路的小孩！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不准連你也把妾身當作迷路的小孩！",
    "voice": "vo_adv_1044006_006",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n是這傢伙自己亂說的啦！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "――還以為是誰呢，這不是妾身的眷屬嗎！",
    "voice": "vo_adv_1044006_007",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你也快幫妾身說句話！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n說妾身實際上是個有著姣好身材的成熟女性！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "啊，你是她的哥哥嗎？",
    "voice": "vo_adv_1044006_008",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n可不能讓妹妹離開你的視線喔。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n那麼，我先告辭了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喂，別想逃！",
    "voice": "vo_adv_1044006_009",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……可惡，一直到最後都搞錯狀況，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n還一副大功告成的樣子……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不可原諒！絕對不可原諒！",
    "voice": "vo_adv_1044006_010",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n什麼啊，那傢伙！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n居然把妾身當成小孩！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "誰、誰是你妹妹啊！",
    "voice": "vo_adv_1044006_011",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "誰是哥哥啊！",
    "voice": "vo_adv_1044006_012",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n別開這種玩笑話啦！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身是你的主人！",
    "voice": "vo_adv_1044006_013",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n而你是妾身的眷屬！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n才不是什麼兄妹！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "而、而且……要是兄妹的話，會有很多困擾吧？",
    "voice": "vo_adv_1044006_014",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n像那個、還是這個，甚至是……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不說清楚你聽不懂？",
    "voice": "vo_adv_1044006_015",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔……那、那個，是眷屬的話就應該懂吧！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n總之，要是跟你是兄妹的話，會有很多不便的地方！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒錯……是兄妹的話會很困擾的。",
    "voice": "vo_adv_1044006_016",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "若是看起來像兄妹，就沒辦法達成妾身的野心！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "既然如此，妾身無論如何都要取回原本的力量，",
    "voice": "vo_adv_1044006_017",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n並且恢復成那副充滿魅力的大人模樣！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你也要來幫忙！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯？想知道妾身的野心嗎？",
    "voice": "vo_adv_1044006_018",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯……那當然是征服世界，但在那之前，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n要先與你――",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊，妾身在說什麼！",
    "voice": "vo_adv_1044006_019",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你別探問奇怪的事啊！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "不僅是外表，\\n她離能夠表現出大人般的沉穩態度的那一天，\\n似乎還要等上許久。",
    "voice": null,
    "unit_id": null
  }
]
