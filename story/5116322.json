  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不如我們",
    "voice": "vo_adv_5116322_003",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一口氣攻過去，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在牠做好準備之前，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
