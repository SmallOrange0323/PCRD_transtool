    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "大猿如果以牠龐大的軀體暴衝起來，",
    "voice": "vo_adv_5116322_002",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我們會很難應付牠。",
