    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "咦……！？",
    "voice": "vo_adv_9081156_006",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n一、",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "一起打、",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "該不會是指……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
