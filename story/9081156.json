  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "情況暫且穩定了，我就問問，",
