    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "即使是魔物，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "也該對強者抱持著敬意！",
