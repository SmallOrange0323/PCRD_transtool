    "voice": "vo_adv_1052008_046",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（呵呵呵，人家還準備了便當哦♪）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪莉瑪，莉瑪……",
    "voice": "vo_adv_1052008_047",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（當然，人家是沒辦法做料理的……）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪，莉瑪莉瑪。",
    "voice": "vo_adv_1052008_048",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（只不過是把蘋果燙過一下而已。）",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪莉瑪，莉瑪♪",
    "voice": "vo_adv_1052008_049",
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n（不知道合不合你的胃口，",
    "voice": null,
    "unit_id": 105231
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n不介意的話就吃吧♪）",
    "voice": null,
    "unit_id": 105231
  },
  {
