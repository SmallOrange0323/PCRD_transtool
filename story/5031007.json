[
  {
    "type": "background",
    "bg_id": "500552"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "競速賽結束以後過了一段時間，參賽者們聚集到神殿",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n準備進行頒獎典禮。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "胡桃也",
    "voice": "vo_adv_5031007_000",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "很努力呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "來不及幫妳加油。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "沒關係。",
    "voice": "vo_adv_5031007_001",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我只是想說如果咲戀媽媽",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "能看到轉播就好了。",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n對、",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "對了，鈴莓姐，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那個……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "恭喜妳",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "得到第一名。",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "謝謝！　",
    "voice": "vo_adv_5031007_002",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不過，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我還是冒冒失失的，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n給大家添了麻煩呢。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳還在說那個呀？",
    "voice": "vo_adv_5031007_003",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "話先說在前頭，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我也是有很多缺點的，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n所以沒辦法",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "在意每個細節唷？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大、",
    "voice": "vo_adv_5031007_004",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐的缺點",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不是缺點！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就是那句話。",
    "voice": "vo_adv_5031007_005",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對我來說，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓的缺點也不是缺點唷。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n一直以來，妳知道",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我被妳救了多少次嗎……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那、",
    "voice": "vo_adv_5031007_006",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我繼續冒冒失失的比較好嗎？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯，",
    "voice": "vo_adv_5031007_007",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我不是說那樣比較好唷？　",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還是要努力改進才行。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "可是，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "包括冒失和努力在內，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那些全部都是鈴莓妳的一部分，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我希望那樣的鈴莓",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "能陪在我身邊。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "僅此而已。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大、",
    "voice": "vo_adv_5031007_008",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐～",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我、",
    "voice": "vo_adv_5031007_009",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我也會加油的……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咲戀媽媽。",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "當然，",
    "voice": "vo_adv_5031007_010",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我也最喜歡",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "原來的胡桃了唷？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "所以，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "大家一起加油吧。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "接下來",
    "voice": "vo_adv_5031007_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "要進行頒獎典禮！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n請各位選手",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "到頒獎台周圍集合！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "那麼，",
    "voice": "vo_adv_5031007_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "我們請",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "成功取得福氣公會稱號的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "【美食殿堂】的各位",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n來選擇豪華獎勵！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呃、",
    "voice": "vo_adv_5031007_013",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呃……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我要這個，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "精靈樹的――",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓，",
    "voice": "vo_adv_5031007_014",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "稍等一下。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦？　",
    "voice": "vo_adv_5031007_015",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大、",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……嗯，",
    "voice": "vo_adv_5031007_016",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這個如何？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "「公會小屋家事套組」……",
    "voice": "vo_adv_5031007_017",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這個是",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "非常高級的",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n掃除套組？　",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不、",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不可以！　",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "至少要選更吉祥一點的",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n東西吧！　",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "本來就是",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我給談生意的對象添了麻煩――",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那件事啊，",
    "voice": "vo_adv_5031007_018",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "因為妳參加了競速賽，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "所以談得很順利唷。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……咦？",
    "voice": "vo_adv_5031007_019",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對方說妳之前的冒失行為，",
    "voice": "vo_adv_5031007_020",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "反而讓他感覺很安心呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n是鈴莓的冒失",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "讓生意談成的。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "而且，",
    "voice": "vo_adv_5031007_021",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "說到吉祥，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓妳努力的模樣，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n就已經把好運帶給我",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還有育幼院的大家了呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "欸，",
    "voice": "vo_adv_5031007_022",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "欸嘿嘿。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "既、",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "既然大小姐這麼說……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "說我帶來好運好像有點太――",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "喂！　",
    "voice": "vo_adv_5031007_023",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "就是她！　",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "「山神大人的巫女」！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "聽說如果能得到她的加持，",
    "voice": "vo_adv_5031007_024",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "今年一整年的運氣",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "就會提升哦！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "這是怎麼一回事！　",
    "voice": "vo_adv_5031007_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "為了得到鈴莓選手的保佑，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n觀眾們都擠了上來！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n對此",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "神殿的祭司也苦笑……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "不對，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "是很歡迎大家這樣做的樣子！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦、",
    "voice": "vo_adv_5031007_026",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦咦咦咦咦！　",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我才沒有那種力量啦！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "保佑！　",
    "voice": "vo_adv_5031007_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "保佑！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "保佑！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哇哇哇哇哇哇哇",
    "voice": "vo_adv_5031007_028",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嘿噗！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "still",
    "still_id": "503100701"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "跑了好久，肚子都餓扁了～",
    "voice": "vo_adv_5031007_029",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對了，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "為了慶祝獲勝，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家一起辦慶功宴吧！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "既、",
    "voice": "vo_adv_5031007_030",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "既然這樣，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要不要就用我拿到的這個",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n高級餐廳全餐免費餐券？　",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "偶爾也想吃不是用魔物做的料理――",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇――！　",
    "voice": "vo_adv_5031007_031",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這家",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不是賣高級魔物料理的餐廳嗎！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "原來妳那麼想吃魔物料理呀！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "still",
    "still_id": "503100702"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……蛤？　",
    "voice": "vo_adv_5031007_032",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "高級、",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "魔物……？　",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別開玩笑了！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "偶爾也想跟你們一起吃些好東西啊……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留，",
    "voice": "vo_adv_5031007_033",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "難道妳為了我們……？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "欸嘿嘿，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "只要是跟小凱留還有大家一起吃飯，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n全～部的食物看起來都像大餐唷？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對了，",
    "voice": "vo_adv_5031007_034",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳在競速賽中也說過那種話呢。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等等，不對！　",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我不要吃魔物啦――――！！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵，",
    "voice": "vo_adv_5031007_035",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好了好了，凱留小姐。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n反正這也是高級餐點嘛。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "問題不在那裡啦，可蘿仔……",
    "voice": "vo_adv_5031007_036",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇哇，",
    "voice": "vo_adv_5031007_037",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一回過神來，已經過12點了呢。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "竟然在育幼院外",
    "voice": "vo_adv_5031007_038",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "迎接了新年，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "感覺有點新鮮呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗚嗚，",
    "voice": "vo_adv_5031007_039",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "竟然在新年到來的同時跌倒了……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真不吉利呢。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_5031007_040",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒有這種事啦？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們可以一起慶祝耶！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "讓我們今年也一起",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "吃很～多美味的食物吧！",
    "voice": null,
    "unit_id": 111811
  },
