[
  {
    "type": "background",
    "bg_id": "500371"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}被花凜叫了出來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n再次造訪了公會管理協會。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您好。",
    "voice": "vo_adv_1257004_000",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "謝謝您",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "在百忙之中撥冗赴約。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我的冒險者實習已經結束了，",
    "voice": "vo_adv_1257004_001",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n所以想跟您報告一下。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "啊，",
    "voice": "vo_adv_1257004_002",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請不要誤會。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "絕對不是負面意義。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "應該說是",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "完成目的後，順利畢業吧。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "多虧跟您一起冒險，",
    "voice": "vo_adv_1257004_003",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我學到了不少東西。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我會將這份經驗",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "好好運用在今後的業務上。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不，",
    "voice": "vo_adv_1257004_004",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "沒有那回……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不如說，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "對我而言，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "面對冒險總是勇往直前的您，看起來才閃閃發光喔。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "倒不如說，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您真的在發光？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "啊……！",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}受到佳凜邀約，來到了鬧區。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "您好。",
    "voice": "vo_adv_1257004_005",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "時間正好。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "真不愧是您。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我今天是",
    "voice": "vo_adv_1257004_006",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "希望能和您吃頓美食，聊聊天，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n才會找您出來……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "沒什麼好隱瞞的，",
    "voice": "vo_adv_1257004_007",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "坦白回答的話……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "是的，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "您說的對。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我隸屬的人才發掘公司",
    "voice": "vo_adv_1257004_008",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n也曾挖角過年紀比您小的人士。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "您還是學生，不必顧慮太多啦。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我明白您的各種擔憂，",
    "voice": "vo_adv_1257004_009",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "不過今天就一起吃頓飯吧！",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "其實，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我已經預約了這附近的知名餐廳。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "這家店要是錯過這次，就不曉得何時才預約得到。",
    "voice": "vo_adv_1257004_010",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "所以！",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "您務必要來！",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我們走吧！",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}被佳凜的氣勢壓倒，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n決定跟著她一起走。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "就是這家店……",
    "voice": "vo_adv_1257004_011",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n看板沒有拿出來，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "也沒有半個客人。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "現在是營業時間，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我應該也完成預約了……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "這是……",
    "voice": "vo_adv_1257004_012",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "有公告呢。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n「本日，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "由於主廚突然生病，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "臨時停業」……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n咦咦！？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我從之前",
    "voice": "vo_adv_1257004_013",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "就對這家店很感興趣，已經搜尋過了……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n全部的美食評論網站，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "評價都超過四星喔。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我配合預約好的套餐，",
    "voice": "vo_adv_1257004_014",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "甚至計算卡路里到個位數，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n晨跑的距離也",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "配合卡路里作了調整……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "突然生病也沒辦法。",
    "voice": "vo_adv_1257004_015",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "希望對方能早日康復吧。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "說的也是。",
    "voice": "vo_adv_1257004_016",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我來搜尋看看附近的店家吧。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "「目前所在地、",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "午餐、",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "高評價」……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "對了，您知道嗎？",
    "voice": "vo_adv_1257004_017",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n可以從搜尋引擎，避開以促銷為目的的情報……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "呀啊！",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "哇！",
    "voice": "vo_adv_1257004_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "啊啊！",
    "voice": "vo_adv_1257004_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "對不起！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n真是的！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "我說過不要在這種人多的地方奔跑吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n請問，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "您有沒有受傷？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "沒事，",
    "voice": "vo_adv_1257004_020",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我沒有受傷……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "不好了！",
    "voice": "vo_adv_1257004_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "手機摔到黑屏了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n過來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "好好跟大姐姐道歉！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "對不起……",
    "voice": "vo_adv_1257004_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "真的非常抱歉。",
    "voice": "vo_adv_1257004_023",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n我會賠償您的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "請給我您的聯絡方式……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "不用了不用了，",
    "voice": "vo_adv_1257004_024",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "不要緊的。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n我想說可能會發生這種事，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "已經有投保了。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "您不必支付",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我的維修與更換的費用。",
    "voice": null,
    "unit_id": 118531
  },
  {
