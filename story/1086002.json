[
  {
    "type": "background",
    "bg_id": "500120"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "自從目擊到外表與自己相同的『闇影』，\\n與父母感情很好地走在路上之後幾天……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "綾音變得鬱悶不樂，\\n讓【咲戀育幼院】的大家都很擔心。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "{0}，能占用點時間嗎？",
    "voice": "vo_adv_1086002_000",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n打擾了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯？　",
    "voice": "vo_adv_1086002_001",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你在做什麼啊，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "怎麼坐在地上……？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "難道是肚子痛？　",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還好嗎？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊，",
    "voice": "vo_adv_1086002_002",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你是在做聖誕節用的裝飾啊。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n剪下色紙，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "再將色紙圈起來……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "謝謝你幫我們這麼多忙，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "總是受你幫忙了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯？　",
    "voice": "vo_adv_1086002_003",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你說「如果當乖孩子就能收到禮物」？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那是聽誰說的啊……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過，放心吧。",
    "voice": "vo_adv_1086002_004",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你的禮物",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我也有好好準備了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "比起那個。",
    "voice": "vo_adv_1086002_005",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "等你這個作業完成後，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n可以麻煩你",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "和綾音一起去買東西嗎？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "畢竟是年尾了，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有很多東西必須事先買起來才行。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "綾音",
    "voice": "vo_adv_1086002_006",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然不願把詳細的事情告訴我，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n但她一直悶悶不樂地",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "把自己關在房間裡對吧？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "她那樣子會生病的，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你帶她去呼吸外面的空氣吧。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我剛好得參加",
    "voice": "vo_adv_1086002_007",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "【公主騎士】",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n年末最後的集會，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沒辦法照顧綾音……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "所以想拜託你，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "抱歉",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "造成你的麻煩。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是嗎？　",
    "voice": "vo_adv_1086002_008",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那就太好了……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我覺得綾音她",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也許會對你敞開心房，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "她如果有什麼煩惱，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就聽她說說吧。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "只要和人吐過苦水後，",
    "voice": "vo_adv_1086002_009",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "她應該一下子就輕鬆起來了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "麻煩你囉，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "哥哥♪",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……",
    "voice": "vo_adv_1086002_010",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "哇，哦哦？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "still",
    "still_id": "108600201"
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥～！",
    "voice": "vo_adv_1086002_011",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "你看你看",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "鏘～☆",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "很可愛對吧？",
    "voice": "vo_adv_1086002_012",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這是咲戀媽媽給我的洋裝，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n說是和大家一起辦派對穿的衣服！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "對吧～♪",
    "voice": "vo_adv_1086002_013",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n再多誇獎我！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "來，你看！　",
    "voice": "vo_adv_1086002_014",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不是只有我，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n連噗吉都變得很有聖誕節的氣氛囉！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "也誇獎噗吉吧！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咦咦？　",
    "voice": "vo_adv_1086002_015",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "沒、沒問題的，哥哥！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "應該也會有哥哥的份啦！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯。",
    "voice": "vo_adv_1086002_016",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "所有人的份，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓會在晚上縫製好的，放心吧。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n雖然到店裡去買也不錯，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但還是我們自己做比較省錢啊。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊～",
    "voice": "vo_adv_1086002_017",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咲戀媽媽真是的……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就聖誕節奢侈一下如何？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯～",
    "voice": "vo_adv_1086002_018",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "年末總是很花錢啊……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "算了，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "先不提這個。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳穿得很好看喔，",
    "voice": "vo_adv_1086002_019",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "綾音。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這樣子一看，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "完全是個成熟的淑女了呢♪",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯！",
    "voice": "vo_adv_1086002_020",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n謝謝妳，咲戀媽媽，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "最～喜歡妳了♪",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500120"
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊哈哈……",
    "voice": "vo_adv_1086002_021",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n沒想到",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "心情突然就變好了呢，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "說不定沒有必要把綾音託給{0}照顧呢？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『哈哈。",
    "voice": "vo_adv_1086002_022",
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n她只是在逞強，",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "因為不想讓其他人擔心。』",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "吶吶，",
    "voice": "vo_adv_1086002_023",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "接下來要去買東西對吧？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "走吧走吧！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我想去讓大家看看，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我這身可愛的洋裝！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯。",
    "voice": "vo_adv_1086002_024",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "玩得開心點。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "只是，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要注意別太晚回來。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我知道啦，咲戀媽媽！",
    "voice": "vo_adv_1086002_025",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不是小孩子啦！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "走吧，哥哥！",
    "voice": "vo_adv_1086002_026",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "今天也是我獨占哥哥～☆",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾個小時後。\\n{0}和綾音一起\\n大致買完了受託的物品。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好～",
    "voice": "vo_adv_1086002_027",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "該買的都買到了吧？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "一下子就結束了！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我以前",
    "voice": "vo_adv_1086002_028",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "從沒自己去買過東西，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n所以不是很懂，要花很多時間……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "但現在已經成為購物專家了呢，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯哼嗯哼♪",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『這沒什麼好得意的就是了。",
    "voice": "vo_adv_1086002_029",
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n……不過，",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "綾音看起來很開心，真是太好了。』",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯。",
    "voice": "vo_adv_1086002_030",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "對不起，哥哥，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "還有噗吉……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "讓你們擔心了。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我已經沒事了，",
    "voice": "vo_adv_1086002_031",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "請你們放心。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n有哥哥和咲戀媽媽，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n還有大家對我這麼溫柔，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我已經完全恢復精神了。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『真的嗎～？",
    "voice": "vo_adv_1086002_032",
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n妳不需要強顏歡笑喔，",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "綾音。』",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『……嗯嗯？』",
    "voice": "vo_adv_1086002_033",
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "我說，小姑娘。",
    "voice": "vo_adv_1086002_034",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n妳一直站在店門前，我會很困擾呢……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n妳有什麼想買的東西嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "…………",
    "voice": "vo_adv_1086002_035",
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊，",
    "voice": "vo_adv_1086002_036",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "又是那個『闇影』！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "她在做什麼？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "為什麼會在那種地方……？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『嗯嗯～？",
    "voice": "vo_adv_1086002_037",
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n看樣子，",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "她只是在盯著店裡面看呢？』",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "稍、",
    "voice": "vo_adv_1086002_038",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "稍微靠近看看吧。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "雖然不清楚那個『闇影』是什麼，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n但是她外表和我一樣，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "讓人在意……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "……",
    "voice": "vo_adv_1086002_039",
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "啊，",
    "voice": "vo_adv_1086002_040",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "喂！　",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "妳在做什麼！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "妳",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "剛才打算擅自拿走商品吧？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "要乖乖付錢啊！",
    "voice": "vo_adv_1086002_041",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n你是哪裡的小孩？　",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "父親母親呢？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "父親、",
    "voice": "vo_adv_1086002_042",
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "母親……？",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "\\n爸爸和、媽媽？",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_1086002_043",
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "因為我總是都收到他們送的禮物，",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "\\n所以今年的聖誕節",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "我要送爸爸媽媽禮物！",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "\\n我要對他們說一直以來很謝謝你們，",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "我最喜歡你們了♪",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "嗯嗯。",
    "voice": "vo_adv_1086002_044",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "我覺得那是很棒的事情，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "但叔叔也是做生意的，所以要請妳乖乖付錢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n妳的錢呢？　",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "沒有帶嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "我",
    "voice": "vo_adv_1086002_045",
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "最喜歡爸爸和媽媽了！",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "嗯嗯～？　",
    "voice": "vo_adv_1086002_046",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "總覺得樣子很奇怪呢……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "啊，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "那眼睛的顏色！　",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "該不會！？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……",
    "voice": "vo_adv_1086002_047",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那個，叔叔！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "對不起，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這孩子是我的妹妹！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n錢我會幫她付，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "請你放她一馬！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『喂、喂？",
    "voice": "vo_adv_1086002_048",
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n這是怎麼回事？",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "突然怎麼了……",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "綾音？』",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "總、總覺得不能丟下她不管……",
    "voice": "vo_adv_1086002_049",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "給你，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這是錢！　",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這樣夠嗎？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "咦？　",
    "voice": "vo_adv_1086002_050",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "嗯，是夠了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "我說妳，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "不能接近她！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n這傢伙，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "大概就是最近謠傳的叫做『闇影』的傢伙吧……？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不、不是不是！",
    "voice": "vo_adv_1086002_051",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "她才不是那種魔物！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那我已經付錢了，",
    "voice": "vo_adv_1086002_052",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "商品我拿走囉？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "掰掰！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "啊，",
    "voice": "vo_adv_1086002_053",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "嗯……？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "多謝惠顧……？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "走吧，",
    "voice": "vo_adv_1086002_054",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "妹妹！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n哥哥也跟上來，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n總之先逃去沒有人的地方吧！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "妹妹？　",
    "voice": "vo_adv_1086002_055",
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "我是個獨生女，",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "\\n因為想要妹妹，",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "所以我曾經跟爸爸媽媽拜託過！",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "就當做是",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "聖誕節",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "的禮物！",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "結果爸爸媽媽，",
    "voice": "vo_adv_1086002_056",
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "都露出一臉為難的表情！",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "啊哈哈哈哈……☆",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "別笑了，",
    "voice": "vo_adv_1086002_057",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "快來這裡！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真是的，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這個『闇影』是怎麼回事～？",
