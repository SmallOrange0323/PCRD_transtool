  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "交流祭の雑踏の中で、モニカとメドゥーサは奇妙な声を耳にした。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "ぎゃ……",
    "voice": "vo_adv_5160604_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "ぷ……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "ぎゃぷ……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ん？　",
    "voice": "vo_adv_5160604_001",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "なにこの変な声……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "魔物？",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "これはもしや……",
    "voice": "vo_adv_5160604_002",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "急ぐぞメドゥーサ！",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "え、",
    "voice": "vo_adv_5160604_003",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ちょ、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "もうなんなのー！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "ベス",
    "words": "ぎゃぷぎゃぷぎゃぷぷー！",
    "voice": "vo_adv_5160604_004",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "妖魔人１",
    "words": "けけけ！　",
    "voice": "vo_adv_5160604_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人１",
    "words": "この辺りじゃ見ねえ魔物だ、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人１",
    "words": "\\n物好きな金持ちに高く売れそうだぜ。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人２",
    "words": "いや、",
    "voice": "vo_adv_5160604_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人２",
    "words": "それよりも食っちまおうぜ。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人２",
    "words": "\\n丸々太ってて食べがいがあんぞ。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "やっぱりベスちゃんか！　",
    "voice": "vo_adv_5160604_007",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "貴様ら、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "その子から手を離せ！",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "妖魔人１",
    "words": "あぁん？　",
    "voice": "vo_adv_5160604_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人１",
    "words": "なんだこのガキャボエぇー！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人２",
    "words": "ひっ！　",
    "voice": "vo_adv_5160604_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人２",
    "words": "い、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人２",
    "words": "一撃で……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人２",
    "words": "こ、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人２",
    "words": "来いデブトカゲ！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "逃がさないわよ！　",
    "voice": "vo_adv_5160604_010",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "メドゥシアナ！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "妖魔人２",
    "words": "ひ、",
    "voice": "vo_adv_5160604_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人２",
    "words": "ぎゃあああー！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ふぅ、",
    "voice": "vo_adv_5160604_012",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "危なかったわね。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "アンタ大丈夫？　",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ケガとかしてな──",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "ベス",
    "words": "ぎゃぷぎゃぷ！",
    "voice": "vo_adv_5160604_013",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "なに、",
    "voice": "vo_adv_5160604_014",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "この子……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "マヌケっぽいけど愛嬌のある顔にもちもちボディ！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nか、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "かわいいじゃないの……",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "いたー！　",
    "voice": "vo_adv_5160604_015",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "ベスちゃーん！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ベス",
    "words": "ぎゃうぴぃ！",
    "voice": "vo_adv_5160604_016",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "よかったー！　",
    "voice": "vo_adv_5160604_017",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "ひとりにしちゃってごめんね……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "危なくさらわれそうになっていたんだ。",
    "voice": "vo_adv_5160604_018",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n祭りで人出も多い、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "より気を付けた方がいいな。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "あ、",
    "voice": "vo_adv_5160604_019",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "モニカ！　",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "そっか、",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "モニカが助けてくれたんだね。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "\\nそっちの子はモニカのおともだち？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "\\nベスちゃんを助けてくれてありが、",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "と……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ど、",
    "voice": "vo_adv_5160604_020",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "どうかしたの？",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "アンタのおともだちのヘビ、",
    "voice": "vo_adv_5160604_021",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "すっごくカッコいいのね！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "\\n強そうで迫力のあるお顔が素敵だね！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ふ、",
    "voice": "vo_adv_5160604_022",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ふーん、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "なかなか見る目あるわね、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "アンタ。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nそう、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "メドゥシアナはとても強いのよ！　",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "すごく頑丈でブレスも吐けるし",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nおまけに何倍にも大きくなれるんだから！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "すごーい！　",
    "voice": "vo_adv_5160604_023",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "でもベスちゃんも負けてないよ？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "\\nベスちゃんはフルーツが大好きで火を吐けるし、",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "\\nそれにそれにすっごくかわいいの！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "分かるわ。",
    "voice": "vo_adv_5160604_024",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "そのピンクのもちもちボディ、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "とてもキュートよ。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nねえ、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "その子撫でてもいいかしら。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "もちろん！　",
    "voice": "vo_adv_5160604_025",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "ヴァンピィちゃんもアンタのヘビさん、",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "触ってもいい？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ええ、",
    "voice": "vo_adv_5160604_026",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "いいわよ。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "あ、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "そういえば自己紹介がまだだったわね。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nアタシはメドゥーサ、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ジオ・ゲヘナの貴族、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ゴルゴーン三姉妹の末妹よ。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "そうなんだ！　",
    "voice": "vo_adv_5160604_027",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "ヴァンピィちゃんも吸血鬼の真祖？　",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "っていうみたい。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ふーん、",
    "voice": "vo_adv_5160604_028",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "なんだか家柄もいいみたいね。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "気に入ったわ。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nヴァンピィ、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "この後一緒に遊ばない？",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nモニカに甘いものでも食べさせてもらおう！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "賛成！　",
    "voice": "vo_adv_5160604_029",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "楽しくなってきたね、",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ヴァンピィ",
    "words": "ベスちゃん♪",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "ベス",
    "words": "ぎゃぷう！",
    "voice": "vo_adv_5160604_030",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "いやはや、",
    "voice": "vo_adv_5160604_031",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ジオ・ゲヘナの大貴族と吸血鬼の真祖の揃い踏みか。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n世界がひっくり返りそうなとんでもない光景だが……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nまあ、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "この二人なら大丈夫か。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "和気あいあいとするメドゥーサとヴァンピィをよそに、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n一人苦笑いのモニカだった。",
    "voice": null,
    "unit_id": null
  }
]
