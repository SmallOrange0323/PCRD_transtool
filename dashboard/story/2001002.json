[
  {
    "type": "background",
    "bg_id": "500320"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下開動了。",
    "voice": "vo_adv_2001002_000",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還請",
    "voice": "vo_adv_2001002_001",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "慢用唷～♪",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_2001002_002",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真是抱歉呀，還得讓你們在移動中吃飯。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "在準備馬車的這件事上，耗費太多的時間……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n弄到最後，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不得不匆匆忙忙的上路了。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "貌似這陣子，",
    "voice": "vo_adv_2001002_003",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "附近有一點不太安穩呢。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n所以決定在短期間內，往附近城鎮避難的人也有不少，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "導致連台馬車也難求的狀況。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真是不行呢～",
    "voice": "vo_adv_2001002_004",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "安排的不夠周全……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "明明大小姐就常常叮嚀著我說，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n『先做好萬全準備，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "再開始行動。』了呢。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯……",
    "voice": "vo_adv_2001002_005",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "畢竟是要搬家嘛，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有輛馬車是必須的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人與在下也並沒有其他的預定，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就算得多花上一點時間，也不會有什麼困擾。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊哈哈。",
    "voice": "vo_adv_2001002_006",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "多給妳們添麻煩的這事兒，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "在這次工作結束前，都會包吃包住來補償給妳們的。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "所以請放心，多吃一點吧～♪",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請用請用，",
    "voice": "vo_adv_2001002_007",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不用客氣唷。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是我特地早起做的，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還有三明治唷♪",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有勞您了。",
    "voice": "vo_adv_2001002_008",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n真是抱歉，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沾了主公大人的光。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人與在下，",
    "voice": "vo_adv_2001002_009",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所持有的盧幣所剩已不多……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n可說是得餐風宿雨，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也不為過的情況。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗯嗯。",
    "voice": "vo_adv_2001002_010",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "才會像那樣找工作做對吧？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這樣不行唷～{0}。",
    "voice": "vo_adv_2001002_011",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n你可是人家的哥哥呢，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不再振作一點可不行。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "讓妹妹能夠好好地溫飽，",
    "voice": "vo_adv_2001002_012",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n可是做哥哥的義務喔？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不是，",
    "voice": "vo_adv_2001002_013",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以說，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並不是主公大人的妹妹。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……",
    "voice": "vo_adv_2001002_014",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呣，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔呣？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個三明治，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好像有股獨特的味道呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊，",
    "voice": "vo_adv_2001002_015",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "對不起！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我雖然是個女僕，但其實不太擅長料理呀，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "難不成不合妳們的胃口嗎？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒有這回事。",
    "voice": "vo_adv_2001002_016",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "應該是在下，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還不太習慣這地方的調味方式而已。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嚼嚼♪",
    "voice": "vo_adv_2001002_017",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "他也正津津有味地吃著呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "如、",
    "voice": "vo_adv_2001002_018",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "如果真的不好吃，不用勉強自己吃下去唷？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "只是距離目的地的宅邸，還有約半天以上的行程。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n如果可以的話，還是填飽一點肚子會比較好呢。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊，",
    "voice": "vo_adv_2001002_019",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這麼說來！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "有一個能讓料理，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "變得更好吃的小咒語唷～♪",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "先像這樣兩手，",
    "voice": "vo_adv_2001002_020",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "比出愛心的形狀……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n嘿呀，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "變得更好吃吧☆",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……",
    "voice": "vo_adv_2001002_021",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那是，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "什麼特殊的魔法嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒有唷，",
    "voice": "vo_adv_2001002_022",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就只是個小咒語。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然大概是心理作用，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但應該會稍微變好吃一點的唷♪",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哈……",
    "voice": "vo_adv_2001002_023",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就只是心理作用而已嗎……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "still",
    "still_id": "200100201"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哦呀，",
    "voice": "vo_adv_2001002_024",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下吃到一半的三明治，竟失去了蹤影。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n主公大人，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是您把它吃掉了嗎？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "{0}。\\n還有很多三明治，",
    "voice": "vo_adv_2001002_025",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n怎麼可以搶走別人的呢。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦？",
    "voice": "vo_adv_2001002_026",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不是{0}吃掉的嗎？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那這麼說來，",
    "voice": "vo_adv_2001002_027",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "難不成是我的小咒語有類似破壞光線的威力。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n竟能把三明治，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "轟到化成灰去了？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嚼嚼，",
    "voice": "vo_adv_2001002_028",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嚼嚼嚼。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……嗯？",
    "voice": "vo_adv_2001002_029",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哦呀？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "有個女孩子喔？",
    "voice": "vo_adv_2001002_030",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n看起來在伸手",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "偷拿走三明治的樣子呢……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個～……？",
    "voice": "vo_adv_2001002_031",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n您好～，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請問您是哪位呢？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "background",
    "bg_id": "500320"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呣咕！？",
    "voice": "vo_adv_2001002_032",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n咳咳，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "咳咳咳！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "發生什麼事了嗎？",
    "voice": "vo_adv_2001002_033",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n空箱裡……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "難不成，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有偷渡客嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "與其說偷渡客，",
    "voice": "vo_adv_2001002_034",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還是該說是坐霸王車呢……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n嗯～，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真讓人困擾呢？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "該怎麼辦呢……",
    "voice": "vo_adv_2001002_035",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "在租借馬車時所簽的契約上，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n有寫到不能承載超過一開始申請的人數呢。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這樣，還得再多繳一份額外的費用呀。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但，",
    "voice": "vo_adv_2001002_036",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "看起來又還只是個小朋友。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n就這樣把她扔出車外，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好像也挺可憐的。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……那個呀，",
    "voice": "vo_adv_2001002_037",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "小妹妹？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n你躲在那裡面，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是想要做什麼呢？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "人、",
    "voice": "vo_adv_2001002_038",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "人家才不小啦！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "人家，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "才一點都不小喔！？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "怎麼看都很小隻呢……",
    "voice": "vo_adv_2001002_039",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個呀，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "坐霸王車是不對的唷。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我們不會對妳做什麼的，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "可以把妳的情形告訴我們嗎？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "妳應該是離家出走的吧。",
    "voice": "vo_adv_2001002_040",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "年紀看起來跟小綾音差不多小……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n像妳這樣的小孩子也不可能是一個人出來旅行嘛。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗯～",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "該怎麼辦才好呢？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "所、",
    "voice": "vo_adv_2001002_041",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "所以我說！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n別一直說人家小呀～！？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯嗯？\\n啊！",
    "voice": "vo_adv_2001002_042",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳這傢伙！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我可認得妳喔！　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "之前在哪裡有見上過一面！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗯？",
    "voice": "vo_adv_2001002_043",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "妳說和鈴莓嗎？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呃……",
    "voice": "vo_adv_2001002_044",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n但妳不是【咲戀育幼院】的孩子吧？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "應該不是吧？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n那個啊，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "妳是不是把我和誰搞混了呢？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "對對對，",
    "voice": "vo_adv_2001002_045",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "鈴莓！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n就是那個名字！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n狹路相逢，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "看來也是天注……！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂！",
    "voice": "vo_adv_2001002_046",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n妳這傢伙，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "記得我嗎？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦？",
    "voice": "vo_adv_2001002_047",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呃～……？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊哇哇，",
    "voice": "vo_adv_2001002_048",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請不要那樣搖人家啊！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n可不能在車上這麼亂晃呀，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不小心馬車可是會翻的唷！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯嗯？",
    "voice": "vo_adv_2001002_049",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂喂喂？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "沒搞錯吧，",
    "voice": "vo_adv_2001002_050",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是你！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n在叫你啦，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你在這鬼地方幹什麼呀？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不論在哪都完全找不著你的蹤跡，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可讓人多操心呀～！？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯？",
    "voice": "vo_adv_2001002_051",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n難不成妳也和主公大人",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "認識嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下的主公大人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不知道為什麼總是到處和女孩子有所相識呢……？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "閃邊，",
    "voice": "vo_adv_2001002_052",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我不認識妳！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n礙事啦！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "比起這個，",
    "voice": "vo_adv_2001002_053",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "重要的是你啊！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n這些日子以來，你在哪裡做了些什麼事啊！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我找你可找很久了呀～公主騎士……！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "【公主騎士】？",
    "voice": "vo_adv_2001002_054",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "妳",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是【公主騎士】的相關人士嗎？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我也是所屬於",
    "voice": "vo_adv_2001002_055",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "【公主騎士】旗下的公會，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n【咲戀育幼院】的人就是了……？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "該不會",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是和這有什麼關係，所以在哪裡見過面嗎？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "movie",
    "movie_id": "200100201"
  }
]
