[
  {
    "type": "background",
    "bg_id": "501280"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在聖學祭落幕，本應結束收拾工作的操場，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n學生們再次聚集了起來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可麗餅店的學生",
    "words": "琪愛兒～",
    "voice": "vo_adv_1163004_000",
    "unit_id": 3112
  },
  {
    "type": "dialogue",
    "name": "可麗餅店的學生",
    "words": "吃的差不多都搬完了喔～！",
    "voice": null,
    "unit_id": 3112
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好的～",
    "voice": "vo_adv_1163004_001",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "謝謝妳～！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "唉呀，",
    "voice": "vo_adv_1163004_002",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "多虧有大家幫忙，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n後夜祭應該會比預計的還要熱鬧呢。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好，",
    "voice": "vo_adv_1163004_003",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "雖然優妮＆克蘿依那兩位還沒到，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "但大家都專程跑來了，讓她們等也不太好意思。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我們就先開始──",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "──咦？",
    "voice": "vo_adv_1163004_004",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n喂，學長，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "請不要這樣，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這陣光是怎麼回事？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦？",
    "voice": "vo_adv_1163004_005",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦咦？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "等一下等一下！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "越來越亮了……！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這個，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "總覺得好像有印象──",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "background",
    "bg_id": "510050"
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "學長，",
    "voice": "vo_adv_1163004_006",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好慢。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不是，",
    "voice": "vo_adv_1163004_007",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "也太慢了吧？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n我說，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這樣算遲到了吧？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不是那個問題啦！",
    "voice": "vo_adv_1163004_008",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n琪愛兒已經等了三十分鐘了喔！",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n你當女高中生寶貴的星期天",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是什麼了？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗯？",
    "voice": "vo_adv_1163004_009",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "想反駁嗎？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n想說是我自己早到三十分鐘嗎？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n就提早醒來了嘛，我有什麼辦法。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你問為什麼……",
    "voice": "vo_adv_1163004_010",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這個嘛，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "沒什麼，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "沒有特別的理由。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n就只是不知怎麼地提早醒了過來而已。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦……",
    "voice": "vo_adv_1163004_011",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "對喔。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "總之，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "做什麼都行，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我們就先去看個電影吧？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗯，",
    "voice": "vo_adv_1163004_012",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "對呀？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n所謂的「有事」就是要打發時間。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": "vo_adv_1163004_013",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "有什麼問題嗎？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n昨天",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "打電話給你的時候，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "學長不也說有空？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不如說，",
    "voice": "vo_adv_1163004_014",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是琪愛兒願意陪學長打發時間。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n你可以好好感謝我喔。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "要請我些什麼嗎？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊，",
    "voice": "vo_adv_1163004_015",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "沒有啦，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我騙你的，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "請把錢包收起來啦。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "謝謝學長陪琪愛兒打發時間，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n真的",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "很謝謝你。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那",
    "voice": "vo_adv_1163004_016",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "要看什麼？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這個月檔期還滿不錯的呢，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n正好有很多電影上映。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這個啊？",
    "voice": "vo_adv_1163004_017",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是路上買的雜誌。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "因為看到上面有望學──",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我喜歡的偶像。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊，",
    "voice": "vo_adv_1163004_018",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "姑且問一下，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n就算{0}學長在怎麼跟不上時代，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n好歹也知道望望吧？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "超級偶像櫻井望。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "哈哈哈哈。",
    "voice": "vo_adv_1163004_019",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "唉～",
    "voice": "vo_adv_1163004_020",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "罐頭笑聲乾掉了。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n真的有呢，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "講這種上古世紀玩笑的人……",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "學長，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這點你要改進一下喔？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好吧，",
    "voice": "vo_adv_1163004_021",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不過",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我放心了。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n看來你至少知道望學姐……",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我是說至少知道望望。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊？",
    "voice": "vo_adv_1163004_022",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你那什麼意思？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n是想跟我風間琪愛兒",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "尬誰比較愛望望嗎？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "哼……",
    "voice": "vo_adv_1163004_023",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n看來有必要教育你一番。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好喔，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我就給你點切嚕瞧瞧。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊～",
    "voice": "vo_adv_1163004_024",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "唉唷～",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "該怎麼辦才好呢～",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n本來是不太想給別人看的說～",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這個呀，",
    "voice": "vo_adv_1163004_025",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "本來有經過同意可以發到SNS，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n但最後還是覺得捨不得所以沒上傳的說──",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n唔～",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "該怎麼辦呢～",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": "vo_adv_1163004_026",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "學長想看嗎？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n真的這麼想看嗎？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "一臉就是很想看的樣子呢，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "唉唷，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "真拿你沒辦法！",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "still",
    "still_id": "116300401"
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "鏘鏘，",
    "voice": "vo_adv_1163004_027",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "請看！",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是青春。",
    "voice": "vo_adv_1163004_028",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這是在我們學校文化祭那時候拍的，",
    "voice": "vo_adv_1163004_029",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "青春的一頁。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是琪愛兒想帶進棺材的照片排行榜第一名。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "當然了。",
    "voice": "vo_adv_1163004_030",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n她就是家喻戶曉的超級偶像櫻井望，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "怕了吧。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "當然了。",
    "voice": "vo_adv_1163004_031",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n她是超級美少女風間琪愛兒。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好了，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "可以了學長，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這種笑話就算了。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "先不開玩笑了，",
    "voice": "vo_adv_1163004_032",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你不覺得這張照片拍得很好嗎？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "望望的可愛當然是包含在裡面，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "但除此之外，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n我覺得還有拍出青春洋溢的感覺。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "對吧？",
    "voice": "vo_adv_1163004_033",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n欸嘿嘿，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "其實我超想把這張照片秀給別人看的。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "可是，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "又不想隨隨便便分享給不熟的人。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "對琪愛兒來說，",
    "voice": "vo_adv_1163004_034",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n這不只是一張一群興奮的年輕人，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n圍著偶像嬉嬉鬧鬧的照片而已。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "呃～",
    "voice": "vo_adv_1163004_035",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "該怎麼說呢……",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "每次辦文化祭啊，",
    "voice": "vo_adv_1163004_036",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不是都會有",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那種人嗎？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n像是覺得「哇～這麼拚喔～",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "也太積極了吧？」",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "的人。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "或是覺得「隨便弄弄就好了啦～」",
    "voice": "vo_adv_1163004_037",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "的人，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "還有「想辦的自己去辦嘛～」",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這種。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "要這樣比喻的話，",
    "voice": "vo_adv_1163004_038",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n琪愛兒一直都想當「很拚很積極」的人。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "因為，",
    "voice": "vo_adv_1163004_039",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "高中的文化祭，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "一輩子只有三次耶。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n不盡情參與不就太浪費了嗎？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "所以，",
    "voice": "vo_adv_1163004_040",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n琪愛兒就辦了望學──",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "望望的演唱會。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "先是申請志願籌備表演。",
    "voice": "vo_adv_1163004_041",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "雖然沒有經驗，但從這裡就開始一路衝衝衝。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "還寫了像企劃書？",
    "voice": "vo_adv_1163004_042",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "之類的東西，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "去跟望望的事務所洽談。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n經紀人姐姐人很好，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "還教了我很多東西。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "然後因為學校的照明設備跟音響",
    "voice": "vo_adv_1163004_043",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "實在是太破了。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "所以還去打工租比較好的器材，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "也認識了展演廳的姐姐，她還給了一些建議。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "一個人這樣忙著忙著，",
    "voice": "vo_adv_1163004_044",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n不知不覺美衣子跟其他班級的同學也來幫忙了。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "在文化祭前一天，",
    "voice": "vo_adv_1163004_045",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "還申請了在學校過夜。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n不過說是過夜，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "但其實根本沒時間睡。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不過，",
    "voice": "vo_adv_1163004_046",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "喊著",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "「不好，天亮了──」，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n然後大家一起吃著泡麵，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嘗起來真的是超級美味的──",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "──不對，",
    "voice": "vo_adv_1163004_047",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這是騙人的。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n大概是經過回憶美化吧。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n其實氣氛並沒有那麼感人。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "實際上，",
    "voice": "vo_adv_1163004_048",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "大家因為趕工跟沒睡覺變的很煩躁，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n還吵了起來吼來吼去的，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "也沒在管年級大小了。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就只有隔壁班的真步",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "到最後都一樣老神在在。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "可是當演唱會正式開始，",
    "voice": "vo_adv_1163004_049",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "現場觀眾都「哇～」地嗨起來。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "明明琪愛兒，",
    "voice": "vo_adv_1163004_050",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是想看望望演唱會才寫企劃的，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "卻忙著這樣",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那樣地",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "和照明設備搏鬥，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "根本沒有空看演唱會，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "等回過神來都已經結束了。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不過等望望下場，",
    "voice": "vo_adv_1163004_051",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "布幕全部降下來的那瞬間，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "大家都默默地握拳，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "擺出了勝利姿勢。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "然後，",
    "voice": "vo_adv_1163004_052",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "演唱會結束之後，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "美衣子她們就嘩地衝到望望身邊，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嚷嚷著「一張就好！",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "拜託一張就好！",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "請跟我們拍張紀念照！」",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "像這樣",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "厚著臉皮拜託望望。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "當然，",
    "voice": "vo_adv_1163004_053",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "琪愛兒可是制止過了喔。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n有跟她們講過",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不要這樣了喔。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n你想，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "像這樣拜託超級偶像，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "怎麼好意思嘛。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不過，",
    "voice": "vo_adv_1163004_054",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "沒想到",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "望望聽了，",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n竟然很隨和地答應說",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "「咦～拍幾張都可以啊～」",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "耶！",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "全都「耶～耶～」地嗨翻了。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這就是這張照片的由來，",
    "voice": "vo_adv_1163004_055",
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n也就是",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "所謂的青春的一頁。",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n很棒吧？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "有沒有覺得閃閃動人？",
    "voice": null,
    "unit_id": 110932
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "切嚕～☆",
    "voice": "vo_adv_1163004_056",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了孩子！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛剛看到的切嚕，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就像是切嚕一樣。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n等你醒來就會切嚕地忘記了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以切嚕哩啵叭嗶，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "切嚕啵叭叭。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯～",
    "voice": "vo_adv_1163004_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不錯不錯，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "琪愛兒總是盡全力揮灑青春。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我真該向她學學",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那股青春活力呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "青春這個季節",
    "voice": "vo_adv_1163004_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "有多麼短暫、有多麼寶貴，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n有著明確人生規劃的她，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "相當清楚這一點呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以她才會在有限的時間裡，",
    "voice": "vo_adv_1163004_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n盡全力地盡情享受青春，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那個",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "「切嚕～」",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "大概就是這樣蹦出來的吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然你現在也過得不容易，",
    "voice": "vo_adv_1163004_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不對，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "正是因為如此──",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "──你更應該學學琪愛兒，盡全力歌頌青春，",
    "voice": "vo_adv_1163004_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n好好累積切嚕才行喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "下次見了，",
    "voice": "vo_adv_1163004_062",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "切嚕～☆",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "501280"
  },
  {
    "type": "dialogue",
    "name": "琪愛兒的朋友1",
    "words": "啊，",
    "voice": "vo_adv_1163004_063",
    "unit_id": 3012
  },
  {
    "type": "dialogue",
    "name": "琪愛兒的朋友1",
    "words": "找到琪愛兒了！",
    "voice": null,
    "unit_id": 3012
  },
  {
    "type": "dialogue",
    "name": "琪愛兒的朋友1",
    "words": "\\n居然在這種地方打瞌睡！",
    "voice": null,
    "unit_id": 3012
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "唔唔……",
    "voice": "vo_adv_1163004_064",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "真步不要……",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n不要再咕嚕靈波了……",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒的朋友2",
    "words": "這孩子，",
    "voice": "vo_adv_1163004_065",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "琪愛兒的朋友2",
    "words": "是在做什麼夢啊？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "琪愛兒的朋友2",
    "words": "\\n喂，琪愛兒，起床了──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "琪愛兒的朋友2",
    "words": "不是要辦後夜祭嗎──？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "琪愛兒的朋友3",
    "words": "大家都在等囉──",
    "voice": "vo_adv_1163004_066",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗯嗯……",
    "voice": "vo_adv_1163004_067",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不會吧，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我睡著了！？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊啊學長也是！",
    "voice": "vo_adv_1163004_068",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "請快點起來！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n然後幫忙把優妮＆克蘿依那兩位找來！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "拜託了，",
    "voice": "vo_adv_1163004_069",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那這邊琪愛兒就先開場囉！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好～",
    "voice": "vo_adv_1163004_070",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "讓大家久等了！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n從現在起，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "後夜祭（不是晚上版）正式開始！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "簡單來說，",
    "voice": "vo_adv_1163004_071",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "其實就是單純的吃吃喝喝吵吵鬧鬧！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "想做什麼都可以！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n大家一起悠哉地延續聖學祭的歡樂吧！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那麼，",
    "voice": "vo_adv_1163004_072",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "接下來就用這句話，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "來代替開場的乾杯。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n準備好了嗎？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n大家要一起喊喔？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "預備──！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "切嚕～！！",
    "voice": "vo_adv_1163004_073",
    "unit_id": 116311
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我想要，",
    "voice": "vo_adv_1163004_074",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "繼續創造回憶。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我想要，做一本收集了許多閃耀青春，",
    "voice": "vo_adv_1163004_075",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n令人覺得",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "光彩奪目的相簿。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "所以，",
    "voice": "vo_adv_1163004_076",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我今天也一樣全力衝刺。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n最重要的，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是興致、氣勢和切嚕～",
