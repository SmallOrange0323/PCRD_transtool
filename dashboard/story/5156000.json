    "voice": "vo_adv_5156000_013",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "雖然姊姊可能不想回憶起來……",
    "voice": "vo_adv_5156000_014",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n但我們在",
