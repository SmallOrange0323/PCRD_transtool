    "voice": "vo_adv_5156000_001",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n雜碎哥哥",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "連自己插吸管都不會嗎～？",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n什麼主人，",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "根本是雜碎主人嘛～♪",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "話說，",
    "voice": "vo_adv_5156000_002",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "仗著自己是客人～",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n就想讓人家叫你主人～？",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不只是雜碎，",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "還是變態可疑人士～w",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "布、",
    "voice": "vo_adv_5156000_003",
    "unit_id": 130112
  },
  {
