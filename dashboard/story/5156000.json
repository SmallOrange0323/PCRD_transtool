    "words": "……呵呵。",
    "voice": "vo_adv_5156000_004",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n其實還蠻有趣的呢……",
    "voice": null,
    "unit_id": 130112
