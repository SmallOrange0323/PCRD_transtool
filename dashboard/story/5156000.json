    "type": "dialogue",
    "name": "若菜",
    "words": "……不過，",
    "voice": "vo_adv_5156000_016",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "在那場戰鬥的最後一刻──",
