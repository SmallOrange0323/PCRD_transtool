    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "啊哈～ｗ",
    "voice": "vo_adv_5156000_009",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n超級謾罵蛋包飯～ｗｗ",
