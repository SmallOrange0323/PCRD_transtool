    "type": "dialogue",
    "name": "若菜",
    "words": "獲得酌情處理的機會。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "所以才放我們出獄，",
    "voice": "vo_adv_5156000_018",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n讓我們像這樣在「女僕咖啡廳」進行社會勞動服務，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n藉此來贖罪的不是嗎。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "這是賦予給我們的，",
    "voice": "vo_adv_5156000_019",
    "unit_id": 130112
  },
