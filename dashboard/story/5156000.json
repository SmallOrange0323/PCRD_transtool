    "name": "若菜",
    "words": "這種",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "「女僕咖啡廳」。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "──呃，",
    "voice": "vo_adv_5156000_005",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "姊、",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "姊姊！？",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n不可以！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "不能在蛋包飯上寫那種話啦～～！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "什麼？",
    "voice": "vo_adv_5156000_006",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "吃下去後不都一樣。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "再說，",
    "voice": "vo_adv_5156000_007",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這麼無聊的店到底哪裡有趣了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "客人們也一定覺得不夠刺激吧？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這可是與世界為敵的倭大人我親筆書寫。",
