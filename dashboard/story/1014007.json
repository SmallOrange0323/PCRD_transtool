[
  {
    "type": "background",
    "bg_id": "500340"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還順利嗎，",
    "voice": "vo_adv_1014007_000",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真是抱歉呢。",
    "voice": "vo_adv_1014007_001",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n讓你得如此頻繁地來負責看照小霧……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這是我們首次",
    "voice": "vo_adv_1014007_002",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "成功捕捉「闇影」，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n所以各式各樣的研究所和魔法師都深感興趣。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不僅得處理向王宮報告用的書面資料，",
    "voice": "vo_adv_1014007_003",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還得應付那些只會出張嘴的傢伙",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "簡直忙不過來。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "時時互探底線，",
    "voice": "vo_adv_1014007_004",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n偶爾甚至還得勾心鬥角，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真折騰死人了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "累死了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "小霧",
    "words": "「名偵探小姐！」",
    "voice": "vo_adv_1014007_005",
    "unit_id": 101421
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "哇哇……",
    "voice": "vo_adv_1014007_006",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "哎唷，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "突然就撲了上來會讓人很困擾喔。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你和我",
    "voice": "vo_adv_1014007_007",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "幾乎含有著相同的質量呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也就是說體重完全一樣。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "若妳毫不保留地朝著這飛撲了過來，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我可接不住呀。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "小霧",
    "words": "「是個困難的問題呢？」",
    "voice": "vo_adv_1014007_008",
    "unit_id": 101421
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是呢。",
    "voice": "vo_adv_1014007_009",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "果然對話感覺是有成立的。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這可是你的功勞唷，",
    "voice": "vo_adv_1014007_010",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n自從與你接觸以來，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n小霧的情況開始有了明確的變化。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "很明顯地開始有自我，",
    "voice": "vo_adv_1014007_011",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也開始萌生自主的行為。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖讓人深感興趣，",
    "voice": "vo_adv_1014007_012",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但依舊不明白道理。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "儘管有試著推理，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但也不知道是不是正確答案。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "「闇影」的",
    "voice": "vo_adv_1014007_013",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "相關研究一直停滯不前，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n全部都要自己摸索。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "小霧",
    "words": "「是個困難的事件呢？」",
    "voice": "vo_adv_1014007_014",
    "unit_id": 101421
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是呀。",
    "voice": "vo_adv_1014007_015",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唔～呣、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n被和自己同張臉同個聲音給搭上話，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還真難習慣呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "完全沒有互動時也備感困擾，",
    "voice": "vo_adv_1014007_016",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但與自己對等的存在",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也讓人有點難受。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "對於缺乏自信的我來說，",
    "voice": "vo_adv_1014007_017",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n要一直對著鏡子這種行為",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還真是痛苦。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那全都是裝出來的。",
    "voice": "vo_adv_1014007_018",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我不管何時都覺得不安，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n總會被困惑或自卑感",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "給動搖。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "再怎麼說我也還是個正值青春期、",
    "voice": "vo_adv_1014007_019",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "才十幾歲的少女呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "從獨自進行偵探活動的時期開始，",
    "voice": "vo_adv_1014007_020",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n為了不被瞧不起總是",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "虛張聲勢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "「名偵探」不過就是個虛名，",
    "voice": "vo_adv_1014007_021",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n是為了保護脆弱又容易受傷的自己，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所建立起來的形象。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但是她、",
    "voice": "vo_adv_1014007_022",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "小霧卻……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "像是把深藏在那虛飾之下，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "宛如是我最原始的樣貌給徹底表現出來了呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "總覺得",
    "voice": "vo_adv_1014007_023",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就像是自己心裡最自卑的那面，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n被赤裸裸的給完全揭露出來的感覺呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這可不是在討論喜好喔，",
    "voice": "vo_adv_1014007_024",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n助手先生。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "話說回來。",
    "voice": "vo_adv_1014007_025",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "若被問到喜歡或討厭，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "毫無疑問是喜歡呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n不管是誰，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "必定都是愛自己的。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我們總是",
    "voice": "vo_adv_1014007_026",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "會對與自己相像之事物，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "或是有很多共通點的事物感到親切。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n這可是人類的本能，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也是必要的機制。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "若無法喜歡自己的話，",
    "voice": "vo_adv_1014007_027",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n那就會連呼吸都做不到唷。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "總而言之。",
    "voice": "vo_adv_1014007_028",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n小霧的絕大部分，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n都和我一樣。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "她",
    "voice": "vo_adv_1014007_029",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就是我呀。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在自己心中",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n所構築的自己",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "總會經過美化。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那其實只是由名為自我肯定的形式所裝飾、",
    "voice": "vo_adv_1014007_030",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n裝扮出來的假象。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過。",
    "voice": "vo_adv_1014007_031",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n小霧卻是",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "從我本身之外，被建構出來的",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "「我自己」呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就像是從被錄下來那自己的聲音中",
    "voice": "vo_adv_1014007_032",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "察覺到異樣感一樣，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "光只是看到些微的差異，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就讓人無法忍受。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唉，",
    "voice": "vo_adv_1014007_033",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "原來我是這麼……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n軟弱又悲哀的",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "女孩子啊。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "小霧",
    "words": "「名偵探小姐？」",
    "voice": "vo_adv_1014007_034",
    "unit_id": 101421
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "為什麼妳會這樣稱呼我呢……",
    "voice": "vo_adv_1014007_035",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唔～",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "光待在這個地方，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就感覺腦子會出問題。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "可是",
    "voice": "vo_adv_1014007_036",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不管是誰，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n都無法將自己捨去。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我會好好的照顧",
    "voice": "vo_adv_1014007_037",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n並且保護你唷……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "小霧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "小霧",
    "words": "「非常謝謝妳♪」",
    "voice": "vo_adv_1014007_038",
    "unit_id": 101421
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯。",
    "voice": "vo_adv_1014007_039",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……只要稍微被溫柔對待、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n或是受到肯定，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就會輕易的感受到親近感呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這一點，",
    "voice": "vo_adv_1014007_040",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也和我完全一樣。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯？",
    "voice": "vo_adv_1014007_041",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n怎麼了助手先生？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n你那副樣子好像是有什麼話想說呢？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呵呵。",
    "voice": "vo_adv_1014007_042",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "小霧和我，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "行為舉止並不相似？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n那是",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "因為我總是偽裝著自己呢……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "自幼便憧憬嚮往的，",
    "voice": "vo_adv_1014007_043",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n扮成自己理想中的",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "「名偵探」的角色。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "當然，",
    "voice": "vo_adv_1014007_044",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那也是「我」。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n而像小霧這樣，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "虛無縹緲又柔弱脆弱的我",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也一樣是我。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "兩邊都是我，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所以都無法割捨。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呵呵。",
    "voice": "vo_adv_1014007_045",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "怎麼感覺，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好像變成在討論哲學了呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "小霧",
    "words": "「我……」",
    "voice": "vo_adv_1014007_046",
    "unit_id": 101421
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯？",
    "voice": "vo_adv_1014007_047",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n小霧，怎麼了？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "小霧",
    "words": "「我有辦法，",
    "voice": "vo_adv_1014007_048",
    "unit_id": 101421
  },
  {
    "type": "dialogue",
    "name": "小霧",
    "words": "成為名偵探嗎？」",
    "voice": null,
    "unit_id": 101421
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "當然可以。",
    "voice": "vo_adv_1014007_049",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n給予迷失、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "困惑的人們一絲救贖之光，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n妳一定能夠成為那種",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "充滿知性又帥氣的「名偵探」。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那可是我自幼便憧憬著，",
    "voice": "vo_adv_1014007_050",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就像故事中的主角一樣……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "使人景仰的存在呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在妳眼前的我，就是最好的證明。",
    "voice": "vo_adv_1014007_051",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "若怎麼樣妳都無法接受，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n那就算要費上再多的唇舌，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我也一定會親口說服妳的。",
    "voice": null,
    "unit_id": 101411
  }
]
