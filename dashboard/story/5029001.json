  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "克莉絲、伊莉亞和望就這樣成為了候補聖誕老人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n3人為了把禮物分送給蘭德索爾的人們，開始動身準備。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "那麼，",
    "voice": "vo_adv_5029001_000",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "各位候補聖誕老人。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n妳們就和牠們一起行動吧。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "馴鹿們",
    "words": "噗喔喔喔喔。\\n（這幾個人就是新的候補聖誕老人？）",
    "voice": "vo_adv_5029001_001",
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "馴鹿先生！",
    "voice": "vo_adv_5029001_002",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "紅色的披風和帽子，",
    "voice": "vo_adv_5029001_003",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那打扮完全符合聖誕老人搭檔的形象呢。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而且，",
    "voice": "vo_adv_5029001_004",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "體格也相當健壯。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "看起來很耐操呢……♪",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "對吧對吧。",
    "voice": "vo_adv_5029001_005",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "牠們可是",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "被聖誕老人選中的",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "馴鹿中的馴鹿，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n甚至可說是菁英馴鹿呢。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不就跟字面上的意思一樣嗎……",
    "voice": "vo_adv_5029001_006",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "請多指教囉！　",
    "voice": "vo_adv_5029001_007",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "馴鹿先生！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿們",
    "words": "噗喔喔喔！　噗喔！\\n（請多指教！　主人！）",
    "voice": "vo_adv_5029001_008",
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "妳們可以出發了。",
    "voice": "vo_adv_5029001_009",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "老夫會在遠處看著妳們的。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n最後會由老夫來判斷",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "是誰帶給大家最多快樂。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "加油吧～",
    "voice": "vo_adv_5029001_010",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "候補聖誕老人們！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "哼哼～",
    "voice": "vo_adv_5029001_011",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "今天是聖誕節喲～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子一直很乖，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "所以一定可以從聖誕老人那裡",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n收到一～大堆禮物喲～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "大份的～♪",
    "voice": "vo_adv_5029001_012",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "堆得像山一樣高的～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "跟水桶一樣大的～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那不是宮子嗎？",
    "voice": "vo_adv_5029001_013",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "來得正好。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "果然大家都",
    "voice": "vo_adv_5029001_014",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n很期待收到聖誕老人的禮物吧。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要好好的回應他們的願望才行！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "好，",
    "voice": "vo_adv_5029001_015",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那就來暖身一下。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n先送個禮物給她吧。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂！小子。",
    "voice": "vo_adv_5029001_016",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你人面這麼廣，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "肯定也認識她吧？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "告訴我那個女孩她可能想要的東西是什麼吧。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "答得真快。",
    "voice": "vo_adv_5029001_017",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "看來你很有信心嘛。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這個簡單♪",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯，",
    "voice": "vo_adv_5029001_018",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身早知道了。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n她每天都在講。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "講到有時候做夢都會夢到她在講這個。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊！？",
    "voice": "vo_adv_5029001_019",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n她、",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "她這麼喜歡布丁啊……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那孩子……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "宮子喜歡的東西",
    "voice": "vo_adv_5029001_020",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身清楚得很！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "跟妾身來吧！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "{0}！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊！",
    "voice": "vo_adv_5029001_021",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "被伊莉亞搶先了……！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個，{0}，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你願不願意跟著我一起去呢！？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯。",
    "voice": "vo_adv_5029001_022",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那麼",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "得先把布丁弄到手才行！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "以宮子的個性，",
    "voice": "vo_adv_5029001_023",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "一兩個肯定是不夠的。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "到底該準備多少才好呢……",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯？　",
    "voice": "vo_adv_5029001_024",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "剛剛那首歌？",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你是說宮子剛剛在唱的那個？",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯～",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "歌詞好像是……",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "說什麼要大份的，",
    "voice": "vo_adv_5029001_025",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "要像山一樣高的，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還有……",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n好像還講了什麼水桶……？",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "！　",
    "voice": "vo_adv_5029001_026",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "水桶啊……！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n只要準備一整個水桶的布丁就可以了吧！？",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真不愧是吾之眷屬。",
    "voice": "vo_adv_5029001_027",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n謝謝你精準的建議",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身要好好地獎勵你！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "過來過來，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "讓妾身摸摸你的頭！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵。",
    "voice": "vo_adv_5029001_028",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "能像這樣摸摸你的頭，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n也挺不錯的。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過，",
    "voice": "vo_adv_5029001_029",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不用像平常一樣牽手，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n或擁抱啊",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……還是有點寂寞呢。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "！　",
    "voice": "vo_adv_5029001_030",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身在說些什麼啊！？",
    "voice": null,
    "unit_id": 111711
