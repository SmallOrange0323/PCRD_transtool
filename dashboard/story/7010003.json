  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "咦咦～！",
    "voice": "vo_adv_7010003_000",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n原來是我的年紀比較大嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀。",
    "voice": "vo_adv_7010003_001",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "似乎是這樣呢～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "美里老師這麼沉熟穩重，",
    "voice": "vo_adv_7010003_002",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n還以為肯定比我年長呢……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "結果我才是姊姊，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "真是嚇了一跳。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不過，",
    "voice": "vo_adv_7010003_003",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "雖然年紀比較輕",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但仍是位稱職的老師，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我得向美里老師看齊呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "{0}你還不累嗎？",
    "voice": "vo_adv_7010003_004",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n在這裡稍作休——",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呀啊！？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好～痛，",
    "voice": "vo_adv_7010003_005",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不小心摔倒了～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "{0}，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "對不起喔～！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "兩位",
    "voice": "vo_adv_7010003_006",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒事嗎！？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "啊，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "伊緒老師！　",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "膝蓋流血了……！",
