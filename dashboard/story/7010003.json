    "voice": "vo_adv_7010003_018",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不顧自己的傷勢",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
