    "name": "伊緒",
    "words": "\\n雖然心裡這麼想，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但還是覺得自己很丟臉呢～",
