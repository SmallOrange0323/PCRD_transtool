  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我等如此漫長的戰鬥，",
    "voice": "vo_adv_5008411_000",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "今天也將是最後一日了嗎……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "還不夠，",
    "voice": "vo_adv_5008411_001",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "還不能就此結束唷！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n為了能夠取回溪谷洞窟真正的和平，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "直到最後的最後一刻都得戰鬥下去呀！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這還真是說了一番好話了呢，",
    "voice": "vo_adv_5008411_002",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "七七香。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就如同七七香所說的呢。",
    "voice": "vo_adv_5008411_003",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "邪惡必須徹底的斬草除根才行……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "未來永劫，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "直到那會對您失禮的愚蠢之徒不再出現於世為止……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看起來大家都挺有幹勁的呢。",
    "voice": "vo_adv_5008411_004",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "既然最後了就再大鬧一番吧！",
    "voice": null,
    "unit_id": 105611
  }
]
