[
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "12月25日、ついに迎えたクリスマス当日。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nまだ人出も少ない早朝、クレジッタは一人最後の見回りに来ていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……ついにこの日が来ましたわね。",
    "voice": "vo_adv_5132169_000",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クレジッタさーん！　",
    "voice": "vo_adv_5132169_001",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "おはようございまーす！",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "へ、",
    "voice": "vo_adv_5132169_002",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下！　",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "おはようございます！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ですが、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "まだパーティーにはだいぶ早いですが……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "えへへ、",
    "voice": "vo_adv_5132169_003",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "実は",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "昨日色々ありまして……",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "なので",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "眠れずに",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "そのままここに来ちゃいました。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "あ、",
    "voice": "vo_adv_5132169_004",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}くんもちゃんと無事ですよ。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "パーティーには絶対に間に合うと思います。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "その色々がなんだか怖いですが、",
    "voice": "vo_adv_5132169_005",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "今は聞かないでおきますわ。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あの、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "つかぬことをお聞きしますが、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "本日のクリスマス、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "不安はありませんか？",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不安、",
    "voice": "vo_adv_5132169_006",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ですか……",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "確かに、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "今日",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "りっちゃんを止められなかったら",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nどうしよう、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "と",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "思わなくもないです。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "でも、",
    "voice": "vo_adv_5132169_007",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クレジッタさんをはじめ",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "みなさんが、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "わたしの理想のクリスマスを全部叶えてくれたじゃないですか！",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "おいしい料理をいっぱい作って、",
    "voice": "vo_adv_5132169_008",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "楽しいイベントを企画して、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "カルミナのお二人も特別に参加してくれますし、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nサレンさんも子どもたちをいっぱい連れてきてくれます。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "考えただけで",
    "voice": "vo_adv_5132169_009",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "楽しみが爆発して、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n不安なんか全部どこかに行っちゃいました☆",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "なるほど……",
    "voice": "vo_adv_5132169_010",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "委細承知いたしました。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "それではわたくしも、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "全力で楽しませていただきますわ！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "といっても……",
    "voice": "vo_adv_5132169_011",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あまり、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "クリスマスの楽しみ方には明るくないのです。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "いつもは商売に明け暮れていましたし。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "先日、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "少年には少し教えてもらいましたけれど。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "それは",
    "voice": "vo_adv_5132169_012",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ちょっと意外ですね。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クレジッタさんみたいに",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大人な女性は",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n素敵なクリスマスの過ごし方をご存じなのかと思ってました。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "かくいうわたしも、",
    "voice": "vo_adv_5132169_013",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一応王家の人間ですから、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nみなさんの言うクリスマスの過ごし方は",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "よく知らなくて。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "なので、",
    "voice": "vo_adv_5132169_014",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "みなさんのお話を聞くたびに、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n楽しそうで、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "うらやましくて、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "あこがれてたんです。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "だからきっと、",
    "voice": "vo_adv_5132169_015",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "これがわたしにとって",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "最初にして最高の\\nクリスマスになります。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "初心者同士、",
    "voice": "vo_adv_5132169_016",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一緒に楽しみましょうね、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クレジッタさん☆",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "は、",
    "voice": "vo_adv_5132169_017",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "はい！　",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "もちろんです！　",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "このクレジッタ・キャッシュ、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n全身全霊で楽しませていただきますわ！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "うれしいのは分かりますが、",
    "voice": "vo_adv_5132169_018",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "早朝からあまりテンションを上げると",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n周りの迷惑になるのでお控えください。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ふん、",
    "voice": "vo_adv_5132169_019",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そういう貴女も楽しみで寝れなかったクチですわよね？",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "楽しみなのは否定しませんが、",
    "voice": "vo_adv_5132169_020",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "ワーカホリック気味の上司に",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n早朝から付き合うのですから",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "感謝してください。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "はいはい、",
    "voice": "vo_adv_5132169_021",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ありがとうございますわ。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "あはは☆",
    "voice": "vo_adv_5132169_022",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "立ち話もなんですから、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "どこかで朝ごはんを食べて、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n一緒に会場を回りましょう！",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "いいですね。",
    "voice": "vo_adv_5132169_023",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "ごちそうさまです、",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "クレジッタさま。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……貴女、",
    "voice": "vo_adv_5132169_024",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わたくしを財布だと思ってません？",
    "voice": null,
    "unit_id": 128011
  }
]
