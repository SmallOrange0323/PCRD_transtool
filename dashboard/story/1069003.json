[
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與【憤怒‧軍團】多次接觸後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n有一天，{0}帶著凱留，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n前去拜訪霸瞳皇帝。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "106900201"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……真是好久不見啊。",
    "voice": "vo_adv_1069003_000",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我差點都要開始以為你不會再來煩我了呢。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……陛下。",
    "voice": "vo_adv_1069003_001",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "之前的事很感謝您。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不嫌棄的話，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "請吃我做的飯糰。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "之前的事？",
    "voice": "vo_adv_1069003_002",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "什麼事？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "真是厚臉皮的誤會啊。",
    "voice": "vo_adv_1069003_003",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我做的一切都是為了我自己。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n若你們因此而想報答我，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那大可不必，太噁心了。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我、",
    "voice": "vo_adv_1069003_004",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我明白了……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……",
    "voice": "vo_adv_1069003_005",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳是有目的才來的吧？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n有話快說，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "別在那邊拖拖拉拉的。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個……",
    "voice": "vo_adv_1069003_006",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "其實是因為，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n現在有一群難纏的傢伙",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "一直在找我們麻煩。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我知道",
    "voice": "vo_adv_1069003_007",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳為何而來。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "但妳要說的不是這個吧……？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n用妳那愚鈍的腦袋想清楚了再說話。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "抱歉……",
    "voice": "vo_adv_1069003_008",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我其實是想來見陛下一面，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n把話好好說清楚。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n畢竟當時我們根本完全無法靜下心說話。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "唉，",
    "voice": "vo_adv_1069003_009",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳果然很愚笨呢，凱留……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n明明不用開口就已經夠令我作嘔了，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n妳還是想要一派天真地繼續折磨我是吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "光是看到背叛者帶著幸福的氛圍出現在我眼前，",
    "voice": "vo_adv_1069003_010",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n就讓我的內心，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n甚至全身都痛得像是",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "要被撕裂了一樣。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "連這麼簡單的事都不懂，",
    "voice": "vo_adv_1069003_011",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我再跟妳多說什麼都是無益。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你也一樣……",
    "voice": "vo_adv_1069003_012",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我已經對你無話可說，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也不想聽你說任何話。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "快快給我制裁吧。",
    "voice": "vo_adv_1069003_013",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不是透過律法，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n而是透過那攪亂我命運的，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你的雙手。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "若你下不了手，",
    "voice": "vo_adv_1069003_014",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "凱留，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "由妳來也行。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n膽敢背叛我，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這點程度的決心應該是有的吧？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "陛下……？",
    "voice": "vo_adv_1069003_015",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "您這是什麼意思……？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我怎麼可能殺死陛下！",
    "voice": "vo_adv_1069003_016",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這就是",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "陛下您負責任的方式嗎……！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "嗯……",
    "voice": "vo_adv_1069003_017",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "怎麼？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "難不成妳覺得",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我是刻意選了一個輕鬆的方式解脫？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呃、",
    "voice": "vo_adv_1069003_018",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這個……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……",
    "voice": "vo_adv_1069003_019",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "確實是啊。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這是最簡潔",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "又輕鬆的解脫方式。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我只是選擇讓遊戲結束而已。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "之後",
    "voice": "vo_adv_1069003_020",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就輪到你們拚命悲慘掙扎給我看了。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我會在地獄裡",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "悠悠哉哉地欣賞這場好戲。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "好了……",
    "voice": "vo_adv_1069003_021",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "隨便誰都好，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n讓我",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "一死了之吧……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不……",
    "voice": "vo_adv_1069003_022",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不可以！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "請您活下去，陛下！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我們並不是為此",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才來見您的！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……",
    "voice": "vo_adv_1069003_023",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你們怎麼會有如此荒誕的想法？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n……是想用二虎競食之計，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "讓我跟那些傢伙互相殘殺嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才不是那樣！",
    "voice": "vo_adv_1069003_024",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只是……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我們只是不希望陛下",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在此殞命。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n因為陛下您……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……那是很久以前的事了，",
    "voice": "vo_adv_1069003_025",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我甚至已經無法清楚回想起來。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……不過你們說得對。",
    "voice": "vo_adv_1069003_026",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我確實",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "曾經是其中的一員。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n但那又如何？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我可是害慘許許多多人的大罪人啊。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這我明白。",
    "voice": "vo_adv_1069003_027",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然不及陛下的程度，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n但我也背負著許多罪。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": "vo_adv_1069003_028",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也正因為有陛下等人所創造的這個世界存在，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我才有幸遇見這傢伙和其他夥伴。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不過就是願望的產物順勢引發的後果，",
    "voice": "vo_adv_1069003_029",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n真虧你們能說得如此意義非凡啊……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "太厚顏無恥了。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "您要怎麼想都無所謂。",
    "voice": "vo_adv_1069003_030",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我只想",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "以我自己的方式報答您，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n期望有朝一日，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我能成為一個有能力",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "拯救陛下的人。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……妳現在變得傲慢極了。",
    "voice": "vo_adv_1069003_031",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n而他則是一向都很傲慢。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這不是傲慢……",
    "voice": "vo_adv_1069003_032",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我還是",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很需要陛下。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "直到現在，",
    "voice": "vo_adv_1069003_033",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我的心裡還是存在著那個，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n想要繼續崇拜陛下的我。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……這就是所謂的傲慢。",
    "voice": "vo_adv_1069003_034",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳不知道嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "讓一心求死的罪人",
    "voice": "vo_adv_1069003_035",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "繼續活下去，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n是最最難堪的懲罰。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這次你們又要",
    "voice": "vo_adv_1069003_036",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "阻撓我的願望了是嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "讓你對我產生罪惡感，",
    "voice": "vo_adv_1069003_037",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "本身就是種屈辱。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "請您活下去，",
    "voice": "vo_adv_1069003_038",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "陛下。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如果對陛下而言，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這是最沉重、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "最痛苦的懲罰，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼您更該這麼做。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "即便是像我這樣罪大惡極的人……",
    "voice": "vo_adv_1069003_039",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "多麼崇高的思想啊。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "莫非你認為放我一條生路，",
    "voice": "vo_adv_1069003_040",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我就會甘願助你們一臂之力嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n若真是如此，你實在天真到令我哭笑不得啊。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "要是現在不殺我，",
    "voice": "vo_adv_1069003_041",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "讓我苟活下去……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n而我將來又再次成為你們的心腹大患，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那要怎麼辦呢？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這可不會只有一次喔。",
    "voice": "vo_adv_1069003_042",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我會一而再、",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "再而三的捲土重來……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "屆時，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你會選擇怎麼樣的未來？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──{0}一時語塞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n腦海中浮現出不久後的將來或許會成真的戰場光景。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "啊哈哈哈哈哈！",
    "voice": "vo_adv_1069003_043",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "很好……！",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n你我就是該如此廝殺！",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你似乎誤以為我會一直乖乖順服於你，",
    "voice": "vo_adv_1069003_044",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n要打破你那種妄想簡直易如反掌！",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這次",
    "voice": "vo_adv_1069003_045",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "終於可以真正做個了斷！",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n你和我，",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "注定有一方要在此殞命……！",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "賭上彼此的願望",
    "voice": "vo_adv_1069003_046",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "與這個世界的未來，",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "全力一戰吧！",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這才是",
    "voice": "vo_adv_1069003_047",
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我所期望的終局……！",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我乃至高無上之神，",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "有本事就來殺我吧！",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "公主騎士！",
    "voice": null,
    "unit_id": 106912
  },
  {
    "type": "still",
    "still_id": "106900201"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "快點，",
    "voice": "vo_adv_1069003_048",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "給我個答案。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你會……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……",
    "voice": "vo_adv_1069003_049",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你選擇",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那樣的未來。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……那麼，",
    "voice": "vo_adv_1069003_050",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我會繼續反抗下去，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n直到你願意殺了我。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我、",
    "voice": "vo_adv_1069003_051",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也是！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如果那就是陛下的願望！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你們",
    "voice": "vo_adv_1069003_052",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "都不先徵得其他夥伴的同意，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n就這樣擅作主張可以嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊！",
    "voice": "vo_adv_1069003_053",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呃，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們之後會設法說服大家的！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很抱歉！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "具體的答覆，我們下次一定──",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "──一定要給出",
    "voice": "vo_adv_1069003_054",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我所期望的答案。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n在那之前，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我這條命就暫且保留。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "陛下……",
    "voice": "vo_adv_1069003_055",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "一定會的！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "太好了！",
    "voice": "vo_adv_1069003_056",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n陛下願意活下來！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我不認為我是那個意思……",
    "voice": "vo_adv_1069003_057",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "真是個蠢孩子。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……雖然不想承認，",
    "voice": "vo_adv_1069003_058",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "但我心底，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n確實還存在著一絲絲鬥志",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "和想要活下去的慾望……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "今後我會靜觀你們的",
    "voice": "vo_adv_1069003_059",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "一舉一動。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "除了我之外，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你們不許輸給任何人。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "聽清楚了嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "陛下。",
    "voice": "vo_adv_1069003_060",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "請您",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "照看著我們。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我們會贏的。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那就先告辭了……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "等一下。",
    "voice": "vo_adv_1069003_061",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？",
    "voice": "vo_adv_1069003_062",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "把你手上那東西",
    "voice": "vo_adv_1069003_063",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "留下。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我要吃點東西養精蓄銳。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "！",
    "voice": "vo_adv_1069003_064",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n……好的。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我會再給您送來……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "送很多很多。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n今天真的很謝謝您，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "陛下……！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……如果這點程度的未來就能滿足，",
    "voice": "vo_adv_1069003_065",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我倒不如死了痛快……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不過有再戰的可能性，",
    "voice": "vo_adv_1069003_066",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "讓這條路線顯得像樣了點……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "啊嗯……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "鹹死了。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這什麼東西……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "有夠難吃。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……如果要跟一向百折不撓的少年再戰，",
    "voice": "vo_adv_1069003_067",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n你起碼得吃些他們供奉的餐點啊。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "明明就忙得不可開交，",
    "voice": "vo_adv_1069003_068",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n虧妳還能特地跑來找我講廢話……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你才是，",
    "voice": "vo_adv_1069003_069",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "簡直像個處處刁難嫂嫂的小姑，好意思說我？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n講話老是那麼尖酸刻薄可不討喜喔？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我本就沒有想要討人喜歡。",
    "voice": "vo_adv_1069003_070",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "騙誰啊……",
    "voice": "vo_adv_1069003_071",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真那。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "如果你還想以神的姿態備受愛戴，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我覺得只要偶爾",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "對人類這種程度的存在，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n稍微展現一些奇蹟",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就行了。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……別跟我說妳沒聽過",
    "voice": "vo_adv_1069003_072",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "「對佛講經」這句話。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊～好好好，抱歉囉。",
    "voice": "vo_adv_1069003_073",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……總之，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "哪天你心血來潮",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就跟我們一起去拯救世界吧。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n這位大神。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "哼……",
    "voice": "vo_adv_1069003_074",
    "unit_id": 106911
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在這之後又過了一段時間──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n重獲自由並恢復力量的霸瞳皇帝，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n遇上了蹂躪阿斯特朗的巨神。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500135"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……那個大塊頭",
    "voice": "vo_adv_1069003_075",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "真礙眼。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "把別人費心佈置的基礎建設和環境搞得七零八落，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n實在令人火大……",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "而且……",
    "voice": "vo_adv_1069003_076",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我還沒有",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "使出全力來對抗啊──！",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "霸瞳皇帝像是要迎向{0}為他帶來",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n的結局一般，對巨神發動試探性攻擊。",
    "voice": null,
    "unit_id": null
  }
]
