[
  {
    "type": "background",
    "bg_id": "500523"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──阿斯特賴亞大陸西部，墨提斯大瀑布上方的空中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………",
    "voice": "vo_adv_5137063_000",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "地形與我的世界不同。",
    "voice": "vo_adv_5137063_001",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n看來應該是成功潛入了。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……這裡便是",
    "voice": "vo_adv_5137063_002",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "作為一切基礎的",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "阿斯特賴亞大陸嗎。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……",
    "voice": "vo_adv_5137063_003",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "又來了嗎。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "紅霧精靈",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 10712
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……！",
    "voice": "vo_adv_5137063_004",
    "unit_id": 135614
  },
  {
    "type": "background",
    "bg_id": "500523"
  },
  {
    "type": "dialogue",
    "name": "紅霧精靈",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 10712
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "真是纏人的追兵。",
    "voice": "vo_adv_5137063_005",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……那麼。",
    "voice": "vo_adv_5137063_006",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n接下來該怎麼做呢。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "既然防護措施出現了破綻，",
    "voice": "vo_adv_5137063_007",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n就代表這個世界發生了與米奈娃相關的「某種事」。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n這點是肯定的。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "至於那「某種事」……",
    "voice": "vo_adv_5137063_008",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n是否為抵達「重置點之後的未來」的關鍵呢。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……首先得收集情報才行呢。",
    "voice": "vo_adv_5137063_009",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "按常規做法，是要去向人打聽──",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……不……",
    "voice": "vo_adv_5137063_010",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n這種事我辦不到……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我一點也不和藹可親……",
    "voice": "vo_adv_5137063_011",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n就算去搭話，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "肯定也不會有人想理睬…………",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n更何況，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "要向初次見面的人搭話，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我根本辦不到…………",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "唉……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……嗯？",
    "voice": "vo_adv_5137063_012",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "那是……",
    "voice": "vo_adv_5137063_013",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "火柱？",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "好驚人的威力……！",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……該不會！",
    "voice": "vo_adv_5137063_014",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "當初在入侵這個世界時，",
    "voice": "vo_adv_5137063_015",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "就一直有種奇妙的感受。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "不斷地嘗試失敗後，",
    "voice": "vo_adv_5137063_016",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "總算在防護措施上找到一個細微的破綻。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "就如同是用小湯匙將監獄牆壁給挖穿一般……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n我花費時間將縫隙鑿得更大、",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "不斷往前挖，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "並阻止其被修復。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "然後，",
    "voice": "vo_adv_5137063_017",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "當前方總算出現光芒的瞬間──",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n視野便感覺一口氣變得開闊。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "沒錯，",
    "voice": "vo_adv_5137063_018",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "舉例來說……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n「就像原本相鄰的兩個小縫隙連接了起來，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "因而形成一個大洞」。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "若真是如此，",
    "voice": "vo_adv_5137063_019",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "應該就會有。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "在我這個怜的「複製品」所在世界的隔壁。",
    "voice": "vo_adv_5137063_020",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n應該有著和我一樣，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "不斷地挖出縫隙前進的存在。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "background",
    "bg_id": "500145"
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………！",
    "voice": "vo_adv_5137063_021",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "很好～！",
    "voice": "vo_adv_5137063_022",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n魔物討伐完畢！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "好像烤得有一～點太焦了……",
    "voice": "vo_adv_5137063_023",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "應該沒問題吧？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……奇怪？",
    "voice": "vo_adv_5137063_024",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………",
    "voice": "vo_adv_5137063_025",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "那個～",
    "voice": "vo_adv_5137063_026",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n妳也是來討伐魔物的嗎？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……看起來應該不是呢。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……嗯。",
    "voice": "vo_adv_5137063_027",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "妳……",
    "voice": "vo_adv_5137063_028",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "看得出來嗎？",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "…………",
    "voice": "vo_adv_5137063_029",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "原來是這樣呀。",
    "voice": "vo_adv_5137063_030",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "嗯、",
    "voice": "vo_adv_5137063_031",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "嗯？",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "抱抱～♪",
    "voice": "vo_adv_5137063_032",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "唔！？",
    "voice": "vo_adv_5137063_033",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "為、",
    "voice": "vo_adv_5137063_034",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "為什麼要抱住我……？",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n比起那個，",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我現在",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "該怎麼辦……！？　",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "…………",
    "voice": "vo_adv_5137063_035",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我呀，",
    "voice": "vo_adv_5137063_036",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "叫做埃拉唷。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "埃拉……",
    "voice": "vo_adv_5137063_037",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這是個……",
    "voice": "vo_adv_5137063_038",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "好名字。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我是這麼認為的。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈，",
    "voice": "vo_adv_5137063_039",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……吶，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "告訴我妳的名字吧。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "叫妳「怜」的話……",
    "voice": "vo_adv_5137063_040",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "也不對吧？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……！",
    "voice": "vo_adv_5137063_041",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……志那都。",
    "voice": "vo_adv_5137063_042",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n就這樣",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "稱呼我吧。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "志那都……",
    "voice": "vo_adv_5137063_043",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "是個很棒的名字呢。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "初次見面，",
    "voice": "vo_adv_5137063_044",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "志那都。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n今後也多指教囉。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "初次見面，",
    "voice": "vo_adv_5137063_045",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "埃拉。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n我也要……",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "請妳多多指教。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……感覺真奇妙。",
    "voice": "vo_adv_5137063_046",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "明明是「第一次見面」，",
    "voice": "vo_adv_5137063_047",
    "unit_id": 135613
  },
  {
