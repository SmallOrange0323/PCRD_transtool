[
  {
    "type": "dialogue",
    "name": "華音",
    "words": "喔～",
    "voice": "vo_adv_5160302_000",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呵呵呵！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "可以不要因為贏過一次，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n就得意忘形起來嗎！？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "因為這隻大蛇，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "還留有兩次變身啊！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "變身？",
    "voice": "vo_adv_5160302_001",
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那種魔物",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也能做到那種事情嗎？",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "不知道呢，",
    "voice": "vo_adv_5160302_002",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "因為牠是蛇所以應該會脫皮，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "但是我沒聽說過會變身呢。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那麼，",
    "voice": "vo_adv_5160302_003",
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那是在虛張聲勢嗎？",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然她看起來不像是有那種頭腦的人……",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不管怎麼說，",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那隻大蛇很強這點一樣沒有變。",
    "voice": null,
    "unit_id": 133211
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是啊，",
    "voice": "vo_adv_5160302_004",
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "牠給人的感覺很明顯",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "跟剛剛為止的不一樣。",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我們也要",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "繃緊神經才行！",
    "voice": null,
    "unit_id": 133511
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我求之不得啊！",
    "voice": "vo_adv_5160302_005",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我就讓你們看看我真正的力量吧！",
    "voice": null,
    "unit_id": 133611
  }
]
