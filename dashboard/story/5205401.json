    "words": "呼、",
    "voice": "vo_adv_5205401_000",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呼……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "總算是結束了……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "比起這個，華音！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n妳在戰鬥中，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "好幾次想連我一起攻擊對吧！？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哎～",
    "voice": "vo_adv_5205401_001",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呀是這樣嗎？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "難道不是妳被本小姐的華麗攻擊給迷住，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n像隻被花蜜吸引",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "的蝴蝶般主動撞上來的嗎？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "哪有可能發生那種事啊！",
    "voice": "vo_adv_5205401_002",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n看來雖然敵人被打倒了，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但戰鬥似乎還沒有結束呢……！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哼，",
    "voice": "vo_adv_5205401_003",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "想開打嗎？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "本小姐可是一點都不介意哦！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "畢竟妳剛剛用絲線把本小姐綁起來丟向敵人的帳還沒跟妳算呢！？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希與華音",
    "words": "妳這傢伙～～～！",
    "voice": "vo_adv_5205401_004",
    "unit_id": null
  }
]
