    "unit_id": 139212
  },
  {
    "type": "dialogue",
    "name": "美穗",
    "words": "能做出一輛很棒的戰車的。",
    "voice": null,
    "unit_id": 139212
  },
  {
    "type": "dialogue",
    "name": "真穗",
    "words": "我在旅途中有看到，",
