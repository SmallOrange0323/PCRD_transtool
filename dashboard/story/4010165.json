  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "──你是……",
    "voice": "vo_adv_4010165_000",
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "\\n今天也有",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "清掃環境的工作嗎。",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "\\n",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "姑且說一聲──",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "──不是工作，",
    "voice": "vo_adv_4010165_001",
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "是有事",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "找我？",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "\\n",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "我不太理解……",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "你",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "只是",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "工讀生對吧，",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "\\n找只見過幾次面的",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "患者，",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "有什麼事──",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "……………………",
    "voice": "vo_adv_4010165_002",
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "──不好意思。",
    "voice": "vo_adv_4010165_003",
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "\\n",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "實在是──",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "遠遠超出我的預料外。",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "\\n而且……",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "我被嚇到了。",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "嚇得不輕。",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "──因為，",
    "voice": "vo_adv_4010165_004",
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "那是患者的",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "個人情報",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "對吧。",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "\\n你竟然會知道──",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "太奇怪了。",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "\\n隱私權、",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "還有法規上的問題──",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "唉──",
    "voice": "vo_adv_4010165_005",
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "嗯，",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "算了。",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "\\n",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "你是個",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "脫離常識的人這點，",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "\\n我已經",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "十分──",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "清楚了。",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "──反正，",
    "voice": "vo_adv_4010165_006",
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "那個你所謂的",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "慶祝……",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "\\n就算我說不需要，",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "你也會",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "勉強推給我吧。",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "………………",
    "voice": "vo_adv_4010165_007",
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "\\n──",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "那麼──",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "──請再，",
    "voice": "vo_adv_4010165_008",
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "說給我聽。",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "\\n你所體驗的──",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "在遊戲中的，",
    "voice": null,
    "unit_id": 129631
  },
  {
    "type": "dialogue",
    "name": "牡丹",
    "words": "冒險故事。",
    "voice": null,
    "unit_id": 129631
  }
]
