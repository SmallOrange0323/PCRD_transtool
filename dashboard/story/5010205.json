    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nまたオマエなの！？　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "しつこいやつなの！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "シノブ",
    "words": "なにやら、先ほどまでとは雰囲気が違いますね……",
    "voice": "vo_adv_5007205_001",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "シノブ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "シノブ",
    "words": "もしかして",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "シノブ",
    "words": "お菓子を取り入れ、",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "シノブ",
    "words": "より強い力を手にしたのでは……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "どうでもいいの！　",
    "voice": "vo_adv_5007205_002",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "どんなに強くなろうが、",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nミヤコが食べ尽くしてやるの～！",
    "voice": null,
    "unit_id": 108211
  }
