  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下心想也許能夠派上用場，",
    "voice": "vo_adv_6056203_000",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n因此研讀了有關金槍鮪的生態紀錄……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還真是深奧又耐人尋味。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵，",
    "voice": "vo_adv_6056203_001",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這裡",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有一本關於金槍鮪生態的書，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n讓在下和主人一起用功學習吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "金槍鮪的軀體，",
    "voice": "vo_adv_6056203_002",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎是由肌肉",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "與特殊的魔力器官所組成的，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n加上牠們",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有利於游泳的外型──",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呃，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……看來",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "聽著聽著就睡著了呢，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵♪",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊不是的，",
    "voice": "vo_adv_6056203_003",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那內容是關於生態，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並沒有提到調理方法……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您是不是",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "肚子餓了呢，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請稍等一下，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這就去準備些食物。",
    "voice": null,
    "unit_id": 105913
  }
]
