  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這些傢伙是……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我、",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我們？",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哦？",
    "voice": "vo_adv_5066322_001",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "可以和自己戰鬥的意思嗎？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還不賴嘛……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "讓人熱血沸騰了起來！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "等一下嘉夜夜！",
    "voice": "vo_adv_5066322_002",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n如果這是過去的我們的話就糟糕了！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "沒事的，",
    "voice": "vo_adv_5066322_003",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這只是如同妳們的複製品一般的東西，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n就算毫無顧忌的打倒它們",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "應該也沒關係唷。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "確實看起來好像跟我們有點不同……",
    "voice": "vo_adv_5066322_004",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "什麼嘛，",
    "voice": "vo_adv_5066322_005",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不是跟自己打嗎……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "算了！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "總之擊潰就對了！",
    "voice": null,
    "unit_id": 116611
  }
]
