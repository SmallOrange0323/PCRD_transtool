[
  {
    "type": "background",
    "bg_id": "500242"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]海邊的洞窟裡出現惡靈是嗎……？",
    "voice": "vo_adv_6124102_000",
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]它們喜歡黑暗和水，",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]這完全就是幽靈會出沒的地方。",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]你對這種地方，",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]不害怕嗎？",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]呵呵呵……",
    "voice": "vo_adv_6124102_001",
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]果然很可靠呢。",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]那麼，",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]我的背後",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]就交給你了。",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]我們一起前進吧！",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]這也不能怪你，",
    "voice": "vo_adv_6124102_002",
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]畢竟不怕的人也沒有多少呢。",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]請你",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]跟在我的身後。",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]為了避免走散，",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]要不要也牽著手？",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]",
    "voice": "vo_adv_6124102_003",
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]對容易被附身的你而言，",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]靠近這裡是很危險的。",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]不過，",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]既然你喜歡的話那也沒辦法……",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]以後要前往這種地方時，",
    "voice": null,
    "unit_id": 127112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]記得也帶著我一起去喔？",
    "voice": null,
    "unit_id": 127112
  }
]
