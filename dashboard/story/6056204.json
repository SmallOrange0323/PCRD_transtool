  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的漁夫們",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那精湛的廚藝，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是太精采了。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看來在下",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "今後也得精益求精，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n做出能夠滿足大家的料理。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的，",
    "voice": "vo_adv_6056204_001",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這是只有在大間",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "才吃得到的道地美味。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n大間的漁村",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "以及這風味沒有消失，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真的是太好了。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "等明年這個時候，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們也用大間的魚",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來慶祝新年吧。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵……",
    "voice": "vo_adv_6056204_002",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝您。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "晚點在下",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "會向漁夫們請教料理方法，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n還請主公大人拭目以待。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拜、",
    "voice": "vo_adv_6056204_003",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拜師嗎？",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯……",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的確，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要是這樣能為主公大人們帶來喜悅……",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咦？",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只是開個玩笑而已？",
    "voice": null,
    "unit_id": 111911
  }
