[
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}順道散步，\\n來到了森林入口。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊啊～！",
    "voice": "vo_adv_1018001_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n誰、誰來救救我呀～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "101800101"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "有誰來幫我了嗎！？",
    "voice": "vo_adv_1018001_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n……太、太好了～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那個～ 其、其實……",
    "voice": "vo_adv_1018001_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我被植物的藤蔓給纏住了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "如果可以自己拔出來就好了，",
    "voice": "vo_adv_1018001_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n但是手夠不到～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚嗚……拜、拜託了！",
    "voice": "vo_adv_1018001_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n趕快幫我鬆開來～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哇～！謝謝。",
    "voice": "vo_adv_1018001_005",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "要溫柔一點唷？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "欸？植物想要吃我？",
    "voice": "vo_adv_1018001_006",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這種事情……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊ーーー！",
    "voice": "vo_adv_1018001_007",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嘴、嘴巴打開了！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n快、快救救我ーーー",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呼……得救了～",
    "voice": "vo_adv_1018001_008",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "終、終於可以動了……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "本來打算自己想辦法的，",
    "voice": "vo_adv_1018001_009",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "但只要動一下藤蔓就到處勒得越來越緊，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n動彈不得。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "要是你沒有來，",
    "voice": "vo_adv_1018001_010",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我恐怕會一直被纏住……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我叫做伊緒。",
    "voice": "vo_adv_1018001_011",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你叫什麼名字？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哼～",
    "voice": "vo_adv_1018001_012",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "謝謝你幫了大忙！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這一帶還會出現魔物，",
    "voice": "vo_adv_1018001_013",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n你真是我的救命恩人！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸？好柔軟……你說我的胸部！？",
    "voice": "vo_adv_1018001_014",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊！抱、抱歉。我竟然突然抱住你。",
    "voice": "vo_adv_1018001_015",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "很痛苦嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "總、總之！",
    "voice": "vo_adv_1018001_016",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n真的謝謝你",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我會小心不要再被魔物襲擊了。",
    "voice": "vo_adv_1018001_017",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不能再添麻煩了。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那麼，再會。\\n我先走了！",
    "voice": "vo_adv_1018001_018",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "再見～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──呱歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊！？",
    "voice": "vo_adv_1018001_019",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n這裡也有植物的魔物！？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "still",
    "still_id": "101800101"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "來、來人啊～！",
    "voice": "vo_adv_1018001_020",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n喂，救救我啊～！！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊～！我明明才說不要再靠別人幫忙了～！",
    "voice": "vo_adv_1018001_021",
    "unit_id": 101811
  }
]
