    "words": "可是同時……",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "自己內心好像",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "也被剝奪了……",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
