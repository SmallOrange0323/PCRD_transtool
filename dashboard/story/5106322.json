  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這是什麼感覺……",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好可怕。",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n好像會上癮啊，",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好恐怖喔，",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊！",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "茜里，振作一點！",
    "voice": "vo_adv_5106322_003",
    "unit_id": 124111
