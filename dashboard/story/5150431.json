[
  {
    "type": "background",
    "bg_id": "501683"
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "はぁ……",
    "voice": "vo_adv_5142431_000",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "魔物のやつ、",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "しぶといな～……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\nあたしとエリコが力を合わせてるってのに、",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "こんなに時間かかるなんて。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "毎日戦い詰めで体が痛いぜ……",
    "voice": "vo_adv_5142431_001",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "ちくしょ～！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "ええ……",
    "voice": "vo_adv_5142431_002",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "私も耐えられません。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "このおかたにまで無茶をさせているという事実にっ！",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "あぁ……",
    "voice": "vo_adv_5142431_003",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "早く帰りたい……！",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n早くあたたかいご飯を用意して差し上げたい……！",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "早くお風呂に入れて差し上げたい……！",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "早く、",
    "voice": "vo_adv_5142431_004",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "早く……！",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\nこのおかたを外敵のいない",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "私と",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "ず～っと二人きりになれる空間に",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n閉じ込めて差し上げたいっ！！",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "り、",
    "voice": "vo_adv_5142431_005",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "理由はともかく、",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "帰りたいのは同意だ。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "それもこれも",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "全部魔物の討伐が終わんねえせいだよ！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "ちくしょ～！　",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "魔物のやつ～っ！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "おのれ魔物……！",
    "voice": "vo_adv_5142431_006",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\nこのおかたを独り占めできないのは",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n全部あのケダモノのせいですわっ！",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "うおおおっ！　",
    "voice": "vo_adv_5142431_007",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "何かイライラしてきた！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n今ならあいつをボッコボコにぶっ飛ばせる気がするぜ！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "奇遇ですね、",
    "voice": "vo_adv_5142431_008",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "私もです。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "今日が奴の……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "最期の日となるでしょう。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "だなっ！　",
    "voice": "vo_adv_5142431_009",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "へへっ……！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n絶対にあいつを倒そうぜ、",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "エリコっ！！",
    "voice": null,
    "unit_id": 129811
  }
]
