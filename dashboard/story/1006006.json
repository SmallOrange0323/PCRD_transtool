[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}與茜里約好一起去購物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥真早呢？",
    "voice": "vo_adv_1006006_000",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "等很久了嗎？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "才剛到……？",
    "voice": "vo_adv_1006006_001",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那就好。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那麼我們去買東西吧。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "你問我這次要買什麼嗎？",
    "voice": "vo_adv_1006006_002",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n嗯～",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "到我們到了就知道喔。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "商店在這邊喔。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嘿嘿～",
    "voice": "vo_adv_1006006_003",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里第一次跟哥哥做這樣的事呢。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "總覺得不停地心跳加速。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "啊，看到那家店了。",
    "voice": "vo_adv_1006006_004",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n在這邊。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "是喔，這是內衣店喔。",
    "voice": "vo_adv_1006006_005",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "前不久茜里最喜歡的內褲破了，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n所以想說要去買新的～。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "難得要買新內褲，",
    "voice": "vo_adv_1006006_006",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n就想說要買哥哥喜歡的類型。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "請多多提供意見喔。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "欸？這裡確實專賣女用內衣褲……",
    "voice": "vo_adv_1006006_007",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "但是跟我一起的話，哥哥也可以進去喔。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好啦好啦，茜里也想聽聽哥哥的意見，",
    "voice": "vo_adv_1006006_008",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "就不用太在意啦。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哇！有很多種呢～",
    "voice": "vo_adv_1006006_009",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這件透明透明的內褲，",
    "voice": "vo_adv_1006006_010",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n哥哥不覺得很可愛嗎？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "還是",
    "voice": "vo_adv_1006006_011",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這件很像繩子的內褲，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n才符合哥哥的喜好呢～？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥，哪件內褲好呢？",
    "voice": "vo_adv_1006006_012",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "兩種都太暴露……？",
    "voice": "vo_adv_1006006_013",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "才沒這種事。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "因為這是茜里的幸運內褲嘛～",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "難得能聽聽哥哥的喜好，",
    "voice": "vo_adv_1006006_014",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里要買一條最厲害的幸運內褲喔。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那麼，哥哥！",
    "voice": "vo_adv_1006006_015",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n這件透明內褲跟繩子內褲，你喜歡哪件呢？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "要讓茜里穿這件透明內褲，",
    "voice": "vo_adv_1006006_016",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n哥哥這色狼～",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "能體會這種若隱若現的美，",
    "voice": "vo_adv_1006006_017",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥還真是老饕呢……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嘻嘻，開玩笑的啦。",
    "voice": "vo_adv_1006006_018",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "因為是哥哥幫茜里選的，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n我馬上就來試穿囉。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "如果不看一下穿起來的樣子，",
    "voice": "vo_adv_1006006_019",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n也不知道怎麼樣。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "等我換好之後，哥哥再給點意見喔。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "女顧客１",
    "words": "呀——！",
    "voice": "vo_adv_1006006_020",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客１",
    "words": "為什麼會有男人在這店裡！？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客１",
    "words": "\\n該不會是變態！？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客２",
    "words": "這是女人的敵人啊！",
    "voice": "vo_adv_1006006_021",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女顧客２",
    "words": "\\n來人啊！快去聯絡【哞哞自衛隊】——！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥，茜里試穿好了喔～",
    "voice": "vo_adv_1006006_022",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "果然只有哥哥幫我挑的最適合…",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "…",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "咦、咦？哥哥……？",
    "voice": "vo_adv_1006006_023",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥跑去哪裡了呢～？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}的身影已不見蹤跡，\\n購物也就此中斷了。",
    "voice": null,
    "unit_id": null
  }
]
