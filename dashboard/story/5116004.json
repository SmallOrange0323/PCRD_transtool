[
  {
    "type": "background",
    "bg_id": "501852"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在遠離集訓所的密林──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n由獵人公會管轄的魔物保護區發生了異變。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "究竟發生了什麼事……",
    "voice": "vo_adv_5116004_000",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "這種事",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "在過去的資料中可沒有啊……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呼……",
    "voice": "vo_adv_5116004_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呼……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "什……",
    "voice": "vo_adv_5116004_002",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "你……！？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唔喔喔喔──！！",
    "voice": "vo_adv_5116004_003",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501692"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾乎在同一時間──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n於天亮前集合的栞等人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正在接受關於調查異變的說明。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "你們要前往的",
    "voice": "vo_adv_5116004_004",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "是被指定為魔物保護區的密林。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "我希望你們與負責這附近地區的遊俠會合，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n並取得調查報告。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "雖然我希望你們盡量不要勉強，",
    "voice": "vo_adv_5116004_005",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "但我現在也只能說……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n要配合當地的狀況",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "進行靈活的應對啊。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "一路小心。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "background",
    "bg_id": "501850"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "──以上",
    "voice": "vo_adv_5116004_006",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就是這次的作戰概要。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "首先",
    "voice": "vo_adv_5116004_007",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "去找目標的遊俠吧。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "途中",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "有確認到營地，所以",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "應該是在這附近才對──",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唔喔喔喔──！！",
    "voice": "vo_adv_5116004_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唔唔唔唔唔…………！",
    "voice": "vo_adv_5116004_009",
    "unit_id": 17412
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "請小心！",
    "voice": "vo_adv_5116004_010",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "距離不遠了……！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那隻魔物……",
    "voice": "vo_adv_5116004_011",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "嘎嚕嚕……",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "兩位，",
    "voice": "vo_adv_5116004_012",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "請你們看一下。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n那隻魔物經過的痕跡……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的確，",
    "voice": "vo_adv_5116004_013",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "地面被翻起，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "樹木都被撞倒……",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看來",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "牠似乎對自己的力量相當有自信。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "呼……",
    "voice": "vo_adv_5116004_014",
    "unit_id": 17412
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "呼……",
    "voice": null,
    "unit_id": 17412
  },
  {
    "type": "dialogue",
    "name": "主人",
    "words": "唔嗚……",
    "voice": null,
    "unit_id": 1812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人",
    "voice": "vo_adv_5116004_015",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還有汪汪主公大人，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請不要離開在下的身邊。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那邊的草叢！",
    "voice": "vo_adv_5116004_016",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "有什麼東西！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "是誰！？",
    "voice": "vo_adv_5116004_017",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "……啊，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "那身裝扮……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "你們是遊俠嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的，",
    "voice": "vo_adv_5116004_018",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們是候補生。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我們是前來密林進行調查的。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "請問",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "究竟發生了什麼──",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "…………！！",
    "voice": "vo_adv_5116004_019",
    "unit_id": 17412
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "等一下再說！",
    "voice": "vo_adv_5116004_020",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "那傢伙要來了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "\\n快逃！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "──咕喔喔喔喔喔！",
    "voice": "vo_adv_5116004_021",
    "unit_id": 17412
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "栞小姐！",
    "voice": "vo_adv_5116004_022",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "唔……",
    "voice": "vo_adv_5116004_023",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我、",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我不要緊！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可是……！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "呼……",
    "voice": "vo_adv_5116004_024",
    "unit_id": 17412
  },
  {
    "type": "dialogue",
    "name": "森林大猿",
    "words": "呼……",
    "voice": null,
    "unit_id": 17412
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "停留在這裡很危險。",
    "voice": "vo_adv_5116004_025",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n快點離開這個地方吧。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "遊俠先生，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你也是！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "……不，",
    "voice": "vo_adv_5116004_026",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "你們就先走吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "遊俠",
    "words": "\\n我之後再追上去……！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……他的腳受傷了……",
    "voice": "vo_adv_5116004_027",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以才會無法逃離，躲在草叢裡吧……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "有負傷者，",
    "voice": "vo_adv_5116004_028",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "眼前還有亢奮的大型魔物。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "而且，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "牠對我們抱有敵意……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就算一邊保護這個人一邊撤退，",
    "voice": "vo_adv_5116004_029",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "還是會被追上並展開戰鬥……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "變成那樣的話，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就無法保障大家的安全。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "如果跟可可蘿他們合作，",
    "voice": "vo_adv_5116004_030",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "或許能夠打倒牠。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n為了保護我們自身安全，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就把這隻危險的魔物──",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "────但是，",
    "voice": "vo_adv_5116004_031",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那樣就……",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "栞小姐，",
    "voice": "vo_adv_5116004_032",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您沒事吧！？",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "大家",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "快走吧！",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……我來吸引這隻魔物的注意。",
    "voice": "vo_adv_5116004_033",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n可可蘿你們",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "趁那個空檔，把這個人送到安全的地方！",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "喵特，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就請你幫忙運送了。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下明白了！",
    "voice": "vo_adv_5116004_034",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "麻煩你們了喔。",
    "voice": "vo_adv_5116004_035",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
