    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "叫什麼名字來著？",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "她叫露易絲瑪莉！",
    "voice": "vo_adv_3022003_027",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽碰巧在書店遇到她的！",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "不過她馬上就往裡面粉紅色布簾的方向走過去了，",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n所以彩羽沒有好好跟她說到話！",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……那孩子是不是才16歲……？",
    "voice": "vo_adv_3022003_028",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "算了，不重要。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "然後呢？",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "妳說露易絲瑪莉怎麼樣了？",
