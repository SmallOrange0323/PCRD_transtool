[
  {
    "type": "background",
    "bg_id": "502540"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這是距離【阿爾克絲鍊金堂】創立大約一年前的事──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一名少女垂頭喪氣地走著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "…………",
    "voice": "vo_adv_3022003_000",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……唉～",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "爺爺是大笨蛋，",
    "voice": "vo_adv_3022003_001",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "大白癡。",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽最討厭爺爺……",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "騙人的，",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "最喜歡了。",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……可是好討厭。",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "但是又最喜歡……",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽搞不懂啦。",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "唔唔……",
    "voice": "vo_adv_3022003_002",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "可惡……",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n……嗚嗚。",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "彩羽～",
    "voice": "vo_adv_3022003_003",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……哦？",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "怎麼了？",
    "voice": "vo_adv_3022003_004",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "總是充滿活力的妳竟然擺著一張苦瓜臉。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n明天是不是要下雪了啊？",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "苑姑姑……！",
    "voice": "vo_adv_3022003_005",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嗚……",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嗚",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……！！",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嗚哇啊啊啊啊啊啊～～～！！",
    "voice": "vo_adv_3022003_006",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "哎呀，",
    "voice": "vo_adv_3022003_007",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "哭得這麼慘啊。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……來，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我給妳摸摸頭，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "過來這邊。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n來吧，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "好乖好乖。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……唔。",
    "voice": "vo_adv_3022003_008",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "對不起，",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "小苑。",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n妳的衣服上",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "都是彩羽的鼻涕了……",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……哦，",
    "voice": "vo_adv_3022003_009",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "這件衣服我嫌麻煩一直沒洗，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n現在有藉口可以洗了，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "這鼻涕來得正好。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……所以，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "發生什麼事了？",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嗯……",
    "voice": "vo_adv_3022003_010",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "就是啊。",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n爺爺他啊，",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "真的很過分……",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……嗯嗯嗯，",
    "voice": "vo_adv_3022003_011",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "妳想認真跟爺爺來場劍術對決，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n可是他卻沒有認真跟妳對打。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "他的說法是因為妳還小。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不是，",
    "voice": "vo_adv_3022003_012",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "這是理所當然的吧。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "咦！？",
    "voice": "vo_adv_3022003_013",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "小苑妳也認同爺爺嗎！？",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "對喔，",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "畢竟爺爺是小苑的爸爸嘛……！",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n比起三等親的姪女，",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "妳更重視一等親的爸爸……！",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "竟然搬出這麼刁鑽的理論。",
    "voice": "vo_adv_3022003_014",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "就說跟那個沒關係啦。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是說，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我對妳到底有多麼疼愛……",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "可不容妳小看喔。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "爸爸他……",
    "voice": "vo_adv_3022003_015",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "彩羽妳的爺爺",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是石動流劍術的開山始祖。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "雖然我不太清楚，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "但他好像有什麼劍聖的稱號不是嗎？",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n門下徒弟也是多到數不清。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽也是他的徒弟啊。",
    "voice": "vo_adv_3022003_016",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嗯，",
    "voice": "vo_adv_3022003_017",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "妳雖然是個孩子，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "卻是最厲害的呢。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n爺爺他",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "一直都很以妳為傲喔。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "總之，",
    "voice": "vo_adv_3022003_018",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不用那麼急。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "妳今年就滿10歲了不是嗎？",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n很快就是大人了，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "再忍忍吧。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "等不下去了啦。",
    "voice": "vo_adv_3022003_019",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽現在就想打……",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "因為……",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "…",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "…總之，",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽現在就想跟爺爺對打啦……！",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "如果因為不是大人就不跟彩羽打的話……",
    "voice": "vo_adv_3022003_020",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "那彩羽現在就想變成大人！",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "哇啊～",
    "voice": "vo_adv_3022003_021",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "太奢侈了。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我勸妳還是不要比較好。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n孩提時期的光陰，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "可是這個世界上最珍貴的寶物喔！",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n是每一個大人不管再怎麼渴望，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "都絕對得不到的寶物。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……那麼，",
    "voice": "vo_adv_3022003_022",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n小苑妳也想要變成小孩嗎？",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嗯～？",
    "voice": "vo_adv_3022003_023",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "這個嘛，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "算是吧。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……呃，",
    "voice": "vo_adv_3022003_024",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "喂！？",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "妳突然拉著我要去哪啊……！？",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嘿嘿……",
    "voice": "vo_adv_3022003_025",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽想到了一個好點子！",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "小苑，問妳喔！",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "妳知道住在高地房子裡的那個",
