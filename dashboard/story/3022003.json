    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "鹿姐姐嗎！？",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "鹿……",
    "voice": "vo_adv_3022003_026",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "哦，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是那個少女鍊金術師對吧。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n她是瑪莉絲黛菈小姐的孫女……",
