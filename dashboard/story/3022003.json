    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "呵、呵、呵！",
    "voice": "vo_adv_3022003_029",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "我們請她用鍊金術幫忙製作吧！",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n做出可以實現彩羽和小苑夢想的藥！",
