[
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "唔唔唔唔唔……",
    "voice": "vo_adv_5068321_000",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "我不要！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "我絕對不要！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n我",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "想跟小孩子玩～！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請停止吧……",
    "voice": "vo_adv_5068321_001",
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那樣只會害孩子們傷心難過……！",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n拜託了，",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請聽我們說話吧……！",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "聽妳在胡說八道！",
    "voice": "vo_adv_5068321_002",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "我可是最棒的玩具喔！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n孩子們也",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "超愛我的！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "無敵好朋友號",
    "words": "……看來",
    "voice": "vo_adv_5068321_003",
    "unit_id": 7311
  },
  {
    "type": "dialogue",
    "name": "無敵好朋友號",
    "words": "必須要助妳們一臂之力了。",
    "voice": null,
    "unit_id": 7311
  },
  {
    "type": "dialogue",
    "name": "無敵好朋友號",
    "words": "\\n就讓它見識一下我們的友情吧！",
    "voice": null,
    "unit_id": 7311
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "無敵好朋友號……！",
    "voice": "vo_adv_5068321_004",
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你願意跟我們一起戰鬥對吧……！",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就大家一起同心協力",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "加油吧！",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "哼……！",
    "voice": "vo_adv_5068321_005",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "才100隻合體的玩具是能做什麼？",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n我的身體可是有1000隻！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "這一聽就知道",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "誰比較優秀吧！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那可不好說。",
    "voice": "vo_adv_5068321_006",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "數量是比不上你，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但友情足以彌補那一點！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "玩具王，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們會讓你親身體驗到那點！",
    "voice": null,
    "unit_id": 116911
  }
]
