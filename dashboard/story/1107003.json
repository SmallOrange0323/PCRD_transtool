  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "明明不同年級，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "可以在同個教室一起上課，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n感覺很不可思議呢……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "我們這裡的共同授課，",
    "voice": "vo_adv_1107003_003",
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "是採用小組學習的方式。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "首先，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "先請在座的各位",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "分好組別吧。",
