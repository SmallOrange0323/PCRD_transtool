    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "平時我總是待在精靈之森，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n有點興趣呢……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，",
    "voice": "vo_adv_1107003_002",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "在那邊的是{0}……！",
