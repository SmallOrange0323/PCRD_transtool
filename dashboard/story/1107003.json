  {
    "type": "dialogue",
    "name": "碧",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那我只好使出邊緣人絕招了！",
