[
  {
    "type": "background",
    "bg_id": "500651"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "來到了大江戶町的{0}和\\n【純白之翼 蘭德索爾分部】的成員們。\\n他們還在繼續逛著各式各樣的店家。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "內餡微甜，",
    "voice": "vo_adv_5015002_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "連外皮都好好吃……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "原來這就是鯛魚燒啊！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "世界上竟然有如此美味的食物……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我要向製作出這麼棒食物的",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "東國",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "敬禮！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "啊、",
    "voice": "vo_adv_5015002_001",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "大江戶町的鯛魚燒也",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "很美味！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n感覺得到",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "甜味的深奧呢。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……等一下，",
    "voice": "vo_adv_5015002_002",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "步未。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n「大江戶町的鯛魚燒也很美味」",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妳剛剛是這樣說的吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "難道說鯛魚燒",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "在蘭德索爾也吃得到嗎！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "啊，",
    "voice": "vo_adv_5015002_003",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "莫妮卡不知道啊。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n蘭德索爾的廣場上",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "有鯛魚燒的攤販，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那裡的鯛魚燒",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "也很美味喔。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "…………必須",
    "voice": "vo_adv_5015002_004",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "每週去買10次才行。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "妳、",
    "voice": "vo_adv_5015002_005",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "妳一天打算去幾次啊！？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我回來了。",
    "voice": "vo_adv_5015002_006",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呼，",
    "voice": "vo_adv_5015002_007",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "總算和大家會合了。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嗚嗚……",
    "voice": "vo_adv_5015002_008",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這個和服，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n雖然很美麗，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "可是有點難行動……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妳們剛才",
    "voice": "vo_adv_5015002_009",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "去哪裡了……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n看到雪那一大袋東西我就懂了。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "從綁頭髮的飾品，",
    "voice": "vo_adv_5015002_010",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n到梳子之類的小東西，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "所有的隨身用品都換成美麗的東西……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這些是",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為了讓我的美更上一層樓的",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "必要經費♪",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哎呀，",
    "voice": "vo_adv_5015002_011",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過還真的是買太多了呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "所以說……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "拿著♪",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雪、",
    "voice": "vo_adv_5015002_012",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雪！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n妳竟然讓前輩拿行李……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "他本來",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "就已經拿著大家的行李了耶！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那麼，",
    "voice": "vo_adv_5015002_013",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你幫我拿行李，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我就讓你",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "盯著看10秒吧♪",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你很懂嘛♪",
    "voice": "vo_adv_5015002_014",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "來，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "把美麗的我",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "深深印在你的腦海吧！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那樣盯著看沒關係嗎？",
    "voice": "vo_adv_5015002_015",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我那耀眼的美貌，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n說不定會讓你頭暈眼花喔♪",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "空花和妮諾",
    "voice": "vo_adv_5015002_016",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n好像沒有買很多東西呢。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空、",
    "voice": "vo_adv_5015002_017",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花感興趣的……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那個、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不是大馬路上賣的東西……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "可是妮諾不在的話，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "會變得更多呢。",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦，",
    "voice": "vo_adv_5015002_018",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是指什麼啊？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那個……",
    "voice": "vo_adv_5015002_019",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "走在鎮上時，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n會有各種商人來推銷商品……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "食物或小東西，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "甚至還有人來推銷武器。",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "連武器都有？",
    "voice": "vo_adv_5015002_020",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n暫且不論是激戰區或是冒險者多的城市，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但我可沒聽說過連武器相關的店",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "都會出來攬客啊。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "如果不是妮諾",
    "voice": "vo_adv_5015002_021",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "當時詳細說明了商品，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "告訴空花那個用不上，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是不必要的東西的話，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "我應該會因為稀奇，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就聽從推銷買下來了……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妮諾做得好。",
    "voice": "vo_adv_5015002_022",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妮諾保護了空花，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "躲過了惡劣的強行推銷。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n作為獎勵，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就送妳我剛買的",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這個鯛魚燒吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "莫妮卡，",
    "voice": "vo_adv_5015002_023",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n謝謝妳……",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妳從剛才就沒什麼精神，",
    "voice": "vo_adv_5015002_024",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是怎麼了嗎？妮諾……",
