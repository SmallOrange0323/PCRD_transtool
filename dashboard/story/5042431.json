[
  {
    "type": "background",
    "bg_id": "500016"
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "這場戰役，",
    "voice": "vo_adv_5042431_000",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "終於快結束了呢……",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "……我要先向你們",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "道個謝。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n你們明明只是被我牽扯進來的，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "謝謝你們還願意",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "和我一起戰鬥。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……愛麗絲，",
    "voice": "vo_adv_5042431_001",
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不需要道謝啦。",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我才想向妳說謝謝呢。",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我獲得了許多經驗……",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "現在",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "成長了很多！",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對啊對啊。",
    "voice": "vo_adv_5042431_002",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是我們自己決定要戰鬥的。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n而且……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "雖然發生了很多事，但還是滿有趣的啊♪",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我、",
    "voice": "vo_adv_5042431_003",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我也是，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雖然一開始突然跑來陌生的地方時我很害怕，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但能跟璃乃妳們聊天……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "和妳們",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "感情變好，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我真的很開心……！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是的，",
    "voice": "vo_adv_5042431_004",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "直到最後妳們還是悠悠哉哉的。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我一點都不覺得有趣，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "反而吃盡苦頭了啦。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我不想再忍受這種遭遇了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……雖然嘴上這麼說，",
    "voice": "vo_adv_5042431_005",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但祈梨其實",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n很享受當女王的生活啦～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不、",
    "voice": "vo_adv_5042431_006",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不要多嘴好嗎！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……不過",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "確實是不錯",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啦。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "妳們……",
    "voice": "vo_adv_5042431_007",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "那就借我使喚妳們到最後吧！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "走囉，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "去和黑之王一決勝負！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好！",
    "voice": "vo_adv_5042431_008",
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我們去完美地拯救世界，",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "迎接快樂的結局吧！",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "喔～！",
    "voice": "vo_adv_5042431_009",
    "unit_id": null
  }
]
