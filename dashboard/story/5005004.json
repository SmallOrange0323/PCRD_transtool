    "type": "dialogue",
    "name": "秋乃",
    "words": "啊，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這裡是！？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "還真是冷清的島呢……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "大概，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這裡就是目的地了。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n突然覺得很想睡的時候，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "沒想到就抵達了呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我說，秋乃，",
    "voice": "vo_adv_5005004_058",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這座島是怎麼回事，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "貓多到有點誇張了吧？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真的呢。",
    "voice": "vo_adv_5005004_059",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "好像在用錢",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "做買賣的樣子呢……！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "貓",
    "words": "喵──",
    "voice": "vo_adv_5005004_060",
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哎呀，",
    "voice": "vo_adv_5005004_061",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "怎麼了呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n用這個錢幣",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "想要交換什麼呢？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這個是",
    "voice": "vo_adv_5005004_062",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我身上的寶石……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼這樣好了，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "換那邊的20枚錢幣如何？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "貓",
    "words": "喵──！",
    "voice": "vo_adv_5005004_063",
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好、",
    "voice": "vo_adv_5005004_064",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好厲害啊～秋乃……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n妳一直都帶著寶石在身上嗎？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要說寶石，",
    "voice": "vo_adv_5005004_065",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "只算帶在身上的，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n平常大約是200克拉左右。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "如果打算要變成一流的商人，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就得在各地都能做生意才行！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我好像……有點感受到",
    "voice": "vo_adv_5005004_066",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n上天對人生的不公了呢～",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼，",
    "voice": "vo_adv_5005004_067",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就用這個氣勢",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "來搜索這個島吧！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n然後……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "珠希和美冬！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "請等等我們！",
    "voice": null,
    "unit_id": 103211
  }
]
