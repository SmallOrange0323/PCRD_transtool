  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼……！",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n再一下，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "應該快了……！",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這邊也、",
    "voice": "vo_adv_5059323_001",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n差不多到極限了啊……！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "戰鬥就快結束了……！",
    "voice": "vo_adv_5059323_002",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "接下來，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就看能不能超越極限",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "了呢……！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下……",
    "voice": "vo_adv_5059323_003",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "必須獲勝……！",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請等一下！",
    "voice": "vo_adv_5059323_004",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……妳可不能獨自前去唷。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "！？",
    "voice": "vo_adv_5059323_005",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "正如貪吃佩可所說呢。",
    "voice": "vo_adv_5059323_006",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們是大家一起在戰鬥的，對吧？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……啊……",
    "voice": "vo_adv_5059323_007",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請相信我們。",
    "voice": "vo_adv_5059323_008",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請依靠……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可靠的夥伴。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是啊……",
    "voice": "vo_adv_5059323_009",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一個人感到焦慮……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n所以……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "忽略了身邊。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "明明大家",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都這麼關心",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下的。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "像這樣並肩作戰，",
    "voice": "vo_adv_5059323_010",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "心裡就會冷靜下來。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "力量從體內……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "開始湧現而出。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝，",
    "voice": "vo_adv_5059323_011",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n貪吃佩可小姐、",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐、",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下已經……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒問題了。",
