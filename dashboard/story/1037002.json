    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然我明明是為了想跟強敵搏命戰鬥，",
    "voice": "vo_adv_1037002_050",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n才進到【王宮騎士團】的說。",
