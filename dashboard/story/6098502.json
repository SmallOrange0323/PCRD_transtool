[
  {
    "type": "background",
    "bg_id": "501162"
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "……環境そのものの均衡を崩す魔物。",
    "voice": "vo_adv_6056502_000",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "初期に創られた物が",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "様々な要因で変質を遂げた結果ゆえでしょうね。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n何にせよ、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "データをとっておく価値はあります。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "ええ、",
    "voice": "vo_adv_6056502_001",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "頼みます。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "データ収集を行う分には",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "観察のみで事足りますが、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n周囲への悪影響が気にかかります。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n対処は貴方たちに任せます。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "……私の信頼を裏切らないように。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "気持ちは受け取りましょう。",
    "voice": "vo_adv_6056502_002",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "ですが、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "貴方には貴方のやるべきことがあるはずです。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "裏方はこちらに任せ、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "貴方は魔物退治に集中するように。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "いいですね？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "たまには表舞台で貴方たちと行動するのも一興ではありますが。",
    "voice": "vo_adv_6056502_003",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "今はその時ではありません。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n私は私の為すべきことを為しますので、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "貴方もそのようにしなさい。",
    "voice": null,
    "unit_id": 107011
  }
]
