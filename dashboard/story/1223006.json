[
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}受伊莉亞的蝙蝠呼叫，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n造訪了古城。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "{0}。\\n等你很久囉。",
    "voice": "vo_adv_1223006_000",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀噗呀……！",
    "voice": "vo_adv_1223006_001",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚咿……！",
    "voice": null,
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就是這點！",
    "voice": "vo_adv_1223006_002",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身就是想談這件事！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "首先是事情的來龍去脈……",
    "voice": "vo_adv_1223006_003",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "把班比從故鄉擄走的「伯爵」，",
    "voice": "vo_adv_1223006_004",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身已經得知他的所在地了。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是棟叫做「受詛咒之館」，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "本身有些問題的宅邸。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身也順便調查了他本人……",
    "voice": "vo_adv_1223006_005",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "據說伯爵出了名地討厭人族，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對魔族非比尋常地崇拜。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不僅接觸可疑的魔法、",
    "voice": "vo_adv_1223006_006",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n身邊帶著魔物，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "甚至──",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還投入所有的私人財產，",
    "voice": "vo_adv_1223006_007",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "挖掘調查遺跡。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "而那些也都是",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "過去魔族的據點。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如果",
    "voice": "vo_adv_1223006_008",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "他是從那裡將班比…………",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還不能確定真是如此。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "總之妾身",
    "voice": "vo_adv_1223006_009",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "想說先只告訴你，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n才在這裡等你的……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒想到班比卻先向妾身的蝙蝠們問出來了。",
    "voice": "vo_adv_1223006_010",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "然後……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比",
    "voice": "vo_adv_1223006_011",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "要去和伯爵談談！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n晚餐前就會回來了！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "幫班比跟僕從說一聲唷！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……就是這樣。",
    "voice": "vo_adv_1223006_012",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身還沒能來得及阻止，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "她就跑出門了……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚……",
    "voice": "vo_adv_1223006_013",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀噗呀嗚……",
    "voice": null,
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "貝斯。",
    "voice": "vo_adv_1223006_014",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是啊。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n連你們也被丟下，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "或許會不禁悲嘆……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但那女孩可能是努力考慮過，",
    "voice": "vo_adv_1223006_015",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "才故意不帶你們去的哦。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "因為對班比來說，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你們是特別的啊。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚──！",
    "voice": "vo_adv_1223006_016",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯，",
    "voice": "vo_adv_1223006_017",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就知道你會這麼說。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒辦法。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "都在一條船上了，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身也助你們一臂之力吧。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "既然決定了，",
    "voice": "vo_adv_1223006_018",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身就使出很久沒用的轉移魔法吧。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……但是，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "因為轉移三位會有困難，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只能讓兩名前往。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……所以。",
    "voice": "vo_adv_1223006_019",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "{0}……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "來、",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "來這裡……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "background",
    "bg_id": "501240"
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "伯爵──！",
    "voice": "vo_adv_1223006_020",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n現在馬上出來見班比！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "在那裡的",
    "voice": "vo_adv_1223006_021",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "該不會是……",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你就是伯爵？",
    "voice": "vo_adv_1223006_022",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比有話",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "要跟你說！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比已經知道了，",
    "voice": "vo_adv_1223006_023",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n是你綁架了班比！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "雖然不知道你為什麼這麼做，",
    "voice": "vo_adv_1223006_024",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n但因為你做了壞事，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "所以要先跟班比道歉！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "…",
    "voice": "vo_adv_1223006_025",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "…唔！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……幹嘛？",
    "voice": "vo_adv_1223006_026",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n一直盯著班比看。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "…………請、",
    "voice": "vo_adv_1223006_027",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "請？",
    "voice": "vo_adv_1223006_028",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "請",
    "voice": "vo_adv_1223006_029",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "收我為僕從吧！！！！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦咦咦！？",
    "voice": "vo_adv_1223006_030",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n為什麼突然……？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "我",
    "voice": "vo_adv_1223006_031",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "很崇拜崇高的古老魔族！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "若能遇見適合的主人，",
    "voice": "vo_adv_1223006_032",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "\\n",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "我想捨棄汙穢的人族身軀，",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "以僕從的身分重獲新生……",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "\\n",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "這是我一直以來的願望！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "然後我",
    "voice": "vo_adv_1223006_033",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "終於遇見了！！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "我在據說是吸血鬼生活過的城堡遺址中……",
    "voice": "vo_adv_1223006_034",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "\\n",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "發現了耀眼的透明箱子裡，",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "與龍一同沉睡的妳！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦？",
    "voice": "vo_adv_1223006_035",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "「遺址」……？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "而後我",
    "voice": "vo_adv_1223006_036",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "為了迎接妳，",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "\\n準備了這棟宅邸！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "接著就只要等待妳的到來，",
    "voice": "vo_adv_1223006_037",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "\\n",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "明明滿心期待的……",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "當我聽到妳從馬車裡消失時，",
    "voice": "vo_adv_1223006_038",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "我陷入絕望。",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "\\n",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "但妳卻甦醒了，",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "並且來到我面前！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "這一定就是……",
    "voice": "vo_adv_1223006_039",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "命運！！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你、",
    "voice": "vo_adv_1223006_040",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你等一下！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n「遺址」",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是已經沒有了的意思對吧？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比的家",
    "voice": "vo_adv_1223006_041",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "已經沒有任何人在了嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n沒有任何人",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "在等著班比了嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "很遺憾，是的……",
    "voice": "vo_adv_1223006_042",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "怎麼會…………",
    "voice": "vo_adv_1223006_043",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "但是，",
    "voice": "vo_adv_1223006_044",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "沒什麼好擔心的！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "我！",
    "voice": "vo_adv_1223006_045",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "\\n會作為僕從侍奉妳的！！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "之後請放寬心，",
    "voice": "vo_adv_1223006_046",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "把這棟宅邸當作自己的新家！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "\\n",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "來吧，",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "我的公主殿下。",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "妳若願意，請將手──",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚咿！",
    "voice": "vo_adv_1223006_047",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚呀嗚──！？",
    "voice": null,
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從？",
    "voice": "vo_adv_1223006_048",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n還有",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯也……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你們倆！",
    "voice": "vo_adv_1223006_049",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "怎麼會在這裡！？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚呀嗚、",
    "voice": "vo_adv_1223006_050",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀噗呀！",
    "voice": null,
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀呀噗──！",
    "voice": null,
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "伊莉亞抱住僕從後",
    "voice": "vo_adv_1223006_051",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "變大了，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n然後用魔法送你們來……？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯──？",
    "voice": "vo_adv_1223006_052",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "雖然不太懂……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "但班比說過",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "要你們看家了吧？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "…………啊。",
    "voice": "vo_adv_1223006_053",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……",
    "voice": "vo_adv_1223006_054",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "對喔。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "約好了",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "要一起找的。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n那麼",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是班比",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "要說對不起呢！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "對貝斯也是。",
    "voice": "vo_adv_1223006_055",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n自己一個走掉，對不起唷？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚──！",
    "voice": "vo_adv_1223006_056",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "跟你們說唷。",
    "voice": "vo_adv_1223006_057",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比知道班比家",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "的情況了。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n詳細的狀況",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "回伊莉亞家再跟你們說。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "伯爵！",
    "voice": "vo_adv_1223006_058",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比已經有僕從了，",
    "voice": "vo_adv_1223006_059",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n就在這裡！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "所以，",
    "voice": "vo_adv_1223006_060",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比不能收你當僕從！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "！？",
    "voice": "vo_adv_1223006_061",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "為為為、",
    "voice": "vo_adv_1223006_062",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "為什麼呢！？",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "\\n為什麼會",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "選那種寒酸的男人呢！？",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "我的話，",
    "voice": "vo_adv_1223006_063",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "既有地位也有財富！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "\\n還有操縱魔物的力量！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "此外，",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "更有對妳的忠誠之心！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "為什麼不是選我，",
    "voice": "vo_adv_1223006_064",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "而是選那個男人呢！？",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯…………",
    "voice": "vo_adv_1223006_065",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比想想……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "伯爵",
    "voice": "vo_adv_1223006_066",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "在班比倒下時，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "會幫助班比嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n如果說想要血時拜託你，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你會分給班比嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "這是當然的！",
    "voice": "vo_adv_1223006_067",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那如果班比",
    "voice": "vo_adv_1223006_068",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是人族呢？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "即使是你討厭的人族，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你也會幫助班比嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "咦！？",
    "voice": "vo_adv_1223006_069",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "\\n",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "這個……",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "這……",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "如果是僕從，",
    "voice": "vo_adv_1223006_070",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n無論是「什麼樣的班比」，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "他都一定會幫助班比的唷。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不分喜歡或討厭，",
    "voice": "vo_adv_1223006_071",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "無論對誰，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "都會一樣地",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "對待大家。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比就是中意他這點♪",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "大概就是因為這樣？",
    "voice": "vo_adv_1223006_072",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "雖然不喜歡血……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "卻覺得僕從的血",
    "voice": "vo_adv_1223006_073",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "似乎很美味呢。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就連現在，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "也似乎比之前更美味了。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比問過伊莉亞",
    "voice": "vo_adv_1223006_074",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "「為什麼會這樣」，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n她說這是類似本能的反應。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你們也是，",
    "voice": "vo_adv_1223006_075",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "對中意的人就會想全部佔為己有，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n也想獻上自己的全部對吧？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比也是唷，",
    "voice": "vo_adv_1223006_076",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "會想要僕從的血，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n而且要把班比的血",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "分給他也不要緊。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比想交到很多朋友，",
    "voice": "vo_adv_1223006_077",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "但想收為僕從的",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就只有這孩子而已！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "所以，",
    "voice": "vo_adv_1223006_078",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "抱歉唷！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n你去找其他人",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "當你的主人吧！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比要說的就這些！",
    "voice": "vo_adv_1223006_079",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你們兩個，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "一起回伊莉亞家吧！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "不行！！",
    "voice": "vo_adv_1223006_080",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "只要在這裡住過一次，",
    "voice": "vo_adv_1223006_081",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "\\n妳一定也會改變心意的！！",
    "voice": null,
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀噗──！？",
    "voice": "vo_adv_1223006_082",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哼──",
    "voice": "vo_adv_1223006_083",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n既然你打算這麼做……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從！",
    "voice": "vo_adv_1223006_084",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那班比",
    "voice": "vo_adv_1223006_085",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "也要隨心所欲了唷♪",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "伯爵",
    "words": "──嗚哇啊啊啊啊啊！？",
    "voice": "vo_adv_1223006_086",
    "unit_id": 2513
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那天，據接到通報趕來的士兵們所述，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他們在一片凌亂的宅邸中，發現了與魔物一同顫抖著的伯爵，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但卻未能從他口中得知真相。",
    "voice": null,
    "unit_id": null
  }
]
