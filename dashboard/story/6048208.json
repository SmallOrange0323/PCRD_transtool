  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "拉菲的弓箭",
    "voice": "vo_adv_6048208_000",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "變得那麼大……",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "街上也陷入恐慌了……",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "怎、",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "怎麼辦啊，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "哥哥……",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "說的也是呢，",
    "voice": "vo_adv_6048208_001",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "那可是能實現願望的天使弓箭啊，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n其實它並不想要做出這種事吧。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "好！",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "茜里會努力",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "讓它舒暢一些的！",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "嗯！",
    "voice": "vo_adv_6048208_002",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "只要有哥哥和姊姊在，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n一定會有辦法的呢！",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "讓大家見識",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "雙胞胎天使的力量！",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "嗯，",
    "voice": "vo_adv_6048208_003",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "雖然我很害怕，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "但那把弓箭一定也很害怕。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n只憑自己，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "它大概已經無能為力了吧。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "哪怕是為了拉菲，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "也非得要",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "將它變回原樣不可呢！",
    "voice": null,
    "unit_id": 113812
  }
]
