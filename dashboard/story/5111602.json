  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "準備執行任務的諾維姆和尾狗刀，在出發前去找了跳躍王。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "教授，",
    "voice": "vo_adv_5111602_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "借我一下",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "那個！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n你的跳躍之力！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "拜託了──",
    "voice": "vo_adv_5111602_001",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "唉……",
    "voice": "vo_adv_5111602_002",
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "好吧，",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "既然是為了任務，那也沒辦法……",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "唉～",
    "voice": "vo_adv_5111602_003",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "阿斯特朗沒有這個，很不方便呢～",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "會覺得阿斯特朗不方便的，",
    "voice": "vo_adv_5111602_004",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n我想只有諾維姆而已，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "真的。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "我答應借給你們。",
    "voice": "vo_adv_5111602_005",
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "不許你們拿來亂用。",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "嗯！",
    "voice": "vo_adv_5111602_006",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我知道！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n再見！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "……嗯。",
    "voice": "vo_adv_5111602_007",
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "\\n",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "跳躍王",
    "words": "我警告過了喔。",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嗯～",
    "voice": "vo_adv_5111602_008",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "這真的很方便呢～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不過，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我沒辦法使用就是了。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "嘿嘿～！",
    "voice": "vo_adv_5111602_009",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "有我在很不錯吧！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "……哦，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "發現目標，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "搭檔，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我們上！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "OK，",
    "voice": "vo_adv_5111602_010",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "準備上工～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "──好！",
    "voice": "vo_adv_5111602_011",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "這次也很輕鬆呢！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "嗯，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "話說回來……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "應該差不多了吧？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "的確。",
    "voice": "vo_adv_5111602_012",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n那就麻煩妳了，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "諾維姆。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "好！",
    "voice": "vo_adv_5111602_013",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "包在我身上！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嗯，",
    "voice": "vo_adv_5111602_014",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "時間剛好。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n也還沒開始排隊。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "嘿嘿，",
    "voice": "vo_adv_5111602_015",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "剛出爐的菠蘿麵包很受歡迎，居然這麼簡單就買到了！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n真是太棒了！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n好～",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "那來找個景色優美的地方再開動吧！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "哦，",
    "voice": "vo_adv_5111602_016",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "好主意。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "那就麻煩妳了。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "要跳囉！",
    "voice": "vo_adv_5111602_017",
    "unit_id": 106114
  },
  {
    "type": "background",
    "bg_id": "500540"
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我說諾維姆，",
    "voice": "vo_adv_5111602_018",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "這地方景色確實不錯……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n但妳不覺得太冷了嗎？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "為",
    "voice": "vo_adv_5111602_019",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "什麼啊──！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我怎麼可能會想來這種地方……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "嗯？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "有紙條……？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "「這是你們亂用的懲罰，",
    "voice": "vo_adv_5111602_020",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "在那裡好好反省一下。」",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "唉呀～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "被發現我們拿跳躍之力來買東西了……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "教、",
    "voice": "vo_adv_5111602_021",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "教授───！！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "諾維姆的吶喊，傳遍了寒冷的雪山……",
    "voice": null,
    "unit_id": null
  }
]
