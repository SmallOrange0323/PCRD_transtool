    "voice": "vo_adv_1007011_008",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n比遲到的宮子還晚到這種事人家絕不原諒的！",
    "voice": null,
    "unit_id": 100731
  },
