  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好棒喔……",
    "voice": "vo_adv_6061103_000",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這就是貴族的宅邸！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n書中的世界就在我的眼前！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我、",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我該怎麼辦……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "現在又變得更緊張了……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這、",
    "voice": "vo_adv_6061103_001",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我現在的",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "打扮就是千金小姐……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "為了不讓漂亮禮服蒙羞，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我要抬頭挺胸地向前進！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "討厭，",
    "voice": "vo_adv_6061103_002",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "{0}也覺得緊張嗎？",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "兩個人一起緊張",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就沒有什麼好怕的了。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "果然還是有伴比較好。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真是的，",
    "voice": "vo_adv_6061103_003",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "都已經不是小孩子了……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但是，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我明白這種心情。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n像這麼大的宅邸，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "自然會讓人想去四處探險。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "託你的福，比起緊張，我內心更是充滿了期待。",
    "voice": null,
    "unit_id": 115812
  }
]
