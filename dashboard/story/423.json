  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不！",
    "voice": "vo_adv_0000423_002",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "　我可是老師唷！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我得保護我可愛的學生們才行！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "挺不賴的覺悟嘛。",
    "voice": "vo_adv_0000423_003",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但若要一同戰鬥，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "可別鬆懈啦！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好的！",
    "voice": "vo_adv_0000423_004",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n老師會加油的唷♪",
    "voice": null,
    "unit_id": 101811
  }
