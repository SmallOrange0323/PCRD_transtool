    "voice": "vo_adv_9045156_018",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "可以暖和身體",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "真是幫了大忙。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "魔物爆炸的衝擊",
    "voice": "vo_adv_9045156_019",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "使得溫泉噴湧而出，真令人吃驚呢。",
