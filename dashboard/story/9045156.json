    "type": "dialogue",
    "name": "凱留",
    "words": "我剛才只是說，以白癡佩可而言還挺機靈的而已啦……！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "比起這件事，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "身體也暖夠了，",
    "voice": null,
    "unit_id": 106012
  },
  {
