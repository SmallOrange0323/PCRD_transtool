    "words": "無論我如何拒絕──",
    "voice": "vo_adv_1354001_061",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n他還是會說著我不太懂的話，",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "並露出笑容吧。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n我腦中閃過了這樣的想法──",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "實際上，",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "也的確如此。",
