    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n騎士閣下，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "可是如此？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──唉。",
