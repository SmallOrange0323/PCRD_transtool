    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "是皇女的命令。",
