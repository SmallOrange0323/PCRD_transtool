    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我不要。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──是說。",
    "voice": "vo_adv_1354001_011",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n即使您跟我說──要慰勞他，",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n我也不曉得──",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "該做些什麼。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "毋須煩惱。",
    "voice": "vo_adv_1354001_012",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "即便詢問本人，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
