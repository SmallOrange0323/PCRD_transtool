    "name": "祭司",
    "words": "我",
    "voice": "vo_adv_1121002_032",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "也認為他說得沒錯喔。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n因為，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "神明並沒有命令妳必須要這麼做。",
