    "type": "dialogue",
    "name": "女子",
    "words": "是這樣嗎？　",
    "voice": "vo_adv_1121002_030",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "可是，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "平常的鈴莓姐姐",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n在工作時的樣子，感覺更快樂呢。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦……",
    "voice": "vo_adv_1121002_031",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這樣嗎？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但是，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我平常總是冒冒失失的，",
