    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n著地！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "哇，",
    "voice": "vo_adv_5146003_030",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "嚇了一跳。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n克蘿茜小姐，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "妳剛才是在天上飛嗎？",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "是的！",
    "voice": "vo_adv_5146003_031",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "因為波波爺爺似乎把眼鏡弄丟了，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n所以我就飛在空中來找！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "要找東西的話，",
    "voice": "vo_adv_5146003_032",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n從空中最能看清楚了！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "原來如此，",
    "voice": "vo_adv_5146003_033",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "就像小鳥一樣尋找呢！",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n……",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "從高處……",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n從空中……",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "庫露露？",
    "voice": "vo_adv_5146003_034",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "妳怎麼了嗎？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "沒事，",
    "voice": "vo_adv_5146003_035",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "只是在想體型不一樣的兩人，",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "是不是連看到的世界也不一樣呢。",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "不過差距",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "應該沒有到從天空俯瞰這種程度就是了……",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "對不起……",
    "voice": "vo_adv_5146003_036",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "我現在遇到了點難題，",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "但是想不出好點子……",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "到底該怎麼做──",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "才、好、呢～～～～～～～！？",
    "voice": "vo_adv_5146003_037",
    "unit_id": 130912
  },
  {
    "type": "background",
    "bg_id": "502041"
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "噫欸欸欸欸～～！？",
    "voice": "vo_adv_5146003_038",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n克、",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "克克、",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "克蘿茜小姐把我給抱了起來！！？",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "請妳抓緊一點唷！",
    "voice": "vo_adv_5146003_039",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n因為由我來抱住妳的話，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "反而會很危險！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "比起這個妳看，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
