  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "是天、",
    "voice": "vo_adv_5146003_040",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "天天……",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "天空！！",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嘿嘿，",
