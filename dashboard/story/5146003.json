    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "總是抬頭仰望的天空，",
    "voice": "vo_adv_5146003_044",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "就展現在我眼前……",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n明明總是看著，",
