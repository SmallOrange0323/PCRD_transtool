    "voice": "vo_adv_5146003_046",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n剛剛的話，",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "感覺能成為很好的靈、",
