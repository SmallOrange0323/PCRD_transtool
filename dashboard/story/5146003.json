    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n來，深呼吸～♪",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "冷靜下來了嗎！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "……是是、",
    "voice": "vo_adv_5146003_042",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "是的！",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "嘿嘿……",
    "voice": "vo_adv_5146003_043",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "嘿嘿嘿！",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n景色好漂亮～！",
