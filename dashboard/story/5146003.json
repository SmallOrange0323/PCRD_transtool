  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "透過庫露露的努力，以及真步與{0}的協助，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n「大夢想樂園」正一步步逐漸改善。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "嘿嘿～♪",
    "voice": "vo_adv_5146003_000",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n客人的笑容，",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "越來越多了呢～♪",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是呀～",
    "voice": "vo_adv_5146003_001",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n到處",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "都能聽到",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "愉快的歡笑聲呢～♪",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "話說",
    "voice": "vo_adv_5146003_002",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "來到吉歐‧提格尼亞後",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家才發現。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n這裡的人們，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "明明有著各式各樣的種族，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但大家都溫和地",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "友好相處哪。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "雖然並不是說",
    "voice": "vo_adv_5146003_003",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "在咱們的世界裡就關係惡劣，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但不久之前，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "才剛因為種族的事情",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "而有過爭吵……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所以",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這個世界如此地祥和，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "讓人家有點羨慕哪。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "確實",
    "voice": "vo_adv_5146003_004",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "就像妳說的。",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "因為這裡的人們都不喜歡爭吵，",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "所以很少發生爭執──",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你、",
    "voice": "vo_adv_5146003_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你這隻",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "小狗！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你你……",
    "voice": "vo_adv_5146003_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你說什麼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你這、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "大塊頭！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哼哼！！",
    "voice": "vo_adv_5146003_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "很溫和地在吵架……",
    "voice": "vo_adv_5146003_008",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "哈哇哇……",
    "voice": "vo_adv_5146003_009",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "這在吉歐‧提格尼亞可是很嚴重的吵架～！",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "得趕快阻止他們才行～！",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "死黨1、死黨2",
    "words": "再……",
    "voice": "vo_adv_5146003_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "死黨1、死黨2",
    "words": "再來一次，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "死黨1、死黨2",
    "words": "哼！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "五體投地～～～！！",
    "voice": "vo_adv_5146003_011",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n看在這顆寶石的分上，",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "請別吵架了～～！！",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "死黨1、死黨2",
    "words": "咦咦，",
    "voice": "vo_adv_5146003_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "死黨1、死黨2",
    "words": "下跪道歉！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "突然之間很抱歉哪。",
    "voice": "vo_adv_5146003_013",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好了庫露露小姐，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "把寶石收起來，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "抬起頭吧？",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……你們兩位，",
    "voice": "vo_adv_5146003_014",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "到底是怎麼了？",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "看樣子似乎是在吵架……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "遊樂園",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "應該是開心玩耍的地方，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不是嗎？",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "死黨1",
    "words": "……",
    "voice": "vo_adv_5146003_015",
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "死黨1",
    "words": "哼。",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "死黨1",
    "words": "\\n一點也不好玩。",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "死黨2",
    "words": "……",
    "voice": "vo_adv_5146003_016",
    "unit_id": 9211
  },
  {
    "type": "dialogue",
    "name": "死黨2",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 9211
  },
  {
    "type": "dialogue",
    "name": "死黨2",
    "words": "因為這個遊樂園。",
    "voice": null,
    "unit_id": 9211
  },
  {
    "type": "dialogue",
    "name": "死黨2",
    "words": "\\n根本沒有能讓我們兩個一起玩的遊樂設施。",
    "voice": null,
    "unit_id": 9211
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "咦……？",
    "voice": "vo_adv_5146003_017",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n這是",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "什麼意思？",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "死黨1",
    "words": "我們兩個，",
    "voice": "vo_adv_5146003_018",
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "死黨1",
    "words": "沒辦法玩同一個東西。",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "死黨2",
    "words": "……就是這麼回事。",
    "voice": "vo_adv_5146003_019",
    "unit_id": 9211
  },
  {
    "type": "dialogue",
    "name": "死黨2",
    "words": "\\n我能搭乘的遊樂設施",
    "voice": null,
    "unit_id": 9211
  },
  {
    "type": "dialogue",
    "name": "死黨2",
    "words": "對這傢伙來說太小了，",
    "voice": null,
    "unit_id": 9211
  },
  {
    "type": "dialogue",
    "name": "死黨2",
    "words": "\\n反過來說這傢伙能搭的，",
    "voice": null,
    "unit_id": 9211
  },
  {
    "type": "dialogue",
    "name": "死黨2",
    "words": "對我來說又太大了。",
    "voice": null,
    "unit_id": 9211
  },
  {
    "type": "dialogue",
    "name": "死黨2",
    "words": "因為這樣，",
    "voice": "vo_adv_5146003_020",
    "unit_id": 9211
  },
  {
    "type": "dialogue",
    "name": "死黨2",
    "words": "才會變得有點煩躁。",
    "voice": null,
    "unit_id": 9211
  },
  {
    "type": "dialogue",
    "name": "死黨2",
    "words": "\\n虧我原本還這麼地期待……",
    "voice": null,
    "unit_id": 9211
  },
  {
    "type": "dialogue",
    "name": "死黨2",
    "words": "\\n算了，",
    "voice": null,
    "unit_id": 9211
  },
  {
    "type": "dialogue",
    "name": "死黨2",
    "words": "回家吧。",
    "voice": null,
    "unit_id": 9211
  },
  {
    "type": "dialogue",
    "name": "死黨1",
    "words": "我會比你還早回家。",
    "voice": "vo_adv_5146003_021",
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "死黨1、死黨2",
    "words": "……哼！！",
    "voice": "vo_adv_5146003_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "哈哇哇～～！？",
    "voice": "vo_adv_5146003_023",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n因為「大夢想樂園」的關係，",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n讓兩人的友情出現裂痕～～！？",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "嗯～",
    "voice": "vo_adv_5146003_024",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這個是",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "只有在吉歐‧提格尼亞才會出現的問題哪……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就算是體型不一樣的朋友，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也能一起享受的遊樂設施。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這到底",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "該怎麼做才好呢……？",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "體型不一樣的朋友，",
    "voice": "vo_adv_5146003_025",
    "unit_id": 130912
  },
  {
