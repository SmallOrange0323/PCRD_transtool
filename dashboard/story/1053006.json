  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "莫妮卡與{0}正準備去訓練時──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "咦！",
    "voice": "vo_adv_1053006_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "居然有魔物！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n跑到城鎮裡來了嗎！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "而且數量還不少啊……",
    "voice": "vo_adv_1053006_001",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "必須得趕緊擊退──",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "嗚哇啊啊啊啊！",
    "voice": "vo_adv_1053006_002",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n爸爸──媽媽──！！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "等等！",
    "voice": "vo_adv_1053006_003",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "\\n你要對我的小孩做什麼！？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "小孩被魔物給抓走了呀！？",
    "voice": "vo_adv_1053006_004",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "為什麼會這樣呢……？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "在我的眼皮底下，",
    "voice": "vo_adv_1053006_005",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "居然發生這樣的事情，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "實在太難堪了……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "必須得想辦法！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "background",
    "bg_id": "500132"
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "等著吧。",
    "voice": "vo_adv_1053006_006",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我一定會……！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "{0}！？",
    "voice": "vo_adv_1053006_007",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你怎麼會",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "在這裡……？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是嗎……",
    "voice": "vo_adv_1053006_008",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n因為猜想到我會做什麼啊。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下猜的沒錯，",
    "voice": "vo_adv_1053006_009",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我的確打算要去魔物那裡，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n把孩子們帶回來。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我當然知道這很危險。",
    "voice": "vo_adv_1053006_010",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n但是",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我的朋友好像也被抓了。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我不能置之不顧！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "向其他公會求助嗎……？",
    "voice": "vo_adv_1053006_011",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這我當然也知道。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但是呢，",
    "voice": "vo_adv_1053006_012",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "如果要對付數量這麼多的魔物，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n相信其他公會",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "也不會輕率地答應吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "應該需要多個公會聯手……",
    "voice": "vo_adv_1053006_013",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n但我沒有辦法等待公會之間完成協調了。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就在我們等待的時候，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "孩子們正在受苦著呀！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不管閣下說什麼，",
    "voice": "vo_adv_1053006_014",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我都要去！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你、",
    "voice": "vo_adv_1053006_015",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你胡說什麼？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n當然不可以！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這對閣下來說太危險了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯？",
    "voice": "vo_adv_1053006_016",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不僅僅只有閣下一起去……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我都說了，",
    "voice": "vo_adv_1053006_017",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "阻止我是沒用的！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我一個人也可以……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……嗯？",
    "voice": "vo_adv_1053006_018",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n你是說……暫時先回去嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下，",
    "voice": "vo_adv_1053006_019",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "似乎有什麼妙計是嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n說來聽聽吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "background",
    "bg_id": "500012"
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "我們正因孩子們被抓走而焦頭爛額的時候，",
    "voice": "vo_adv_1053006_020",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "\\n突然叫我們出來……是要幹什麼呀？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "喂，那孩子好像有話要說喔？",
    "voice": "vo_adv_1053006_021",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "各位，",
    "voice": "vo_adv_1053006_022",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "請聽我說！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我現在要去救孩子們！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "需要大家的幫忙！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "如果交給公會處理，",
    "voice": "vo_adv_1053006_023",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n不知道會要",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "等到什麼時候……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "在這期間裡如果孩子們有個三長兩短就不好了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "如果我們同心協力，",
    "voice": "vo_adv_1053006_024",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "一定會成功的！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "一起去救孩子們吧！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "……對、",
    "voice": "vo_adv_1053006_025",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "對呀。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "她說的沒錯！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "好。",
    "voice": "vo_adv_1053006_026",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "就這麼辦！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "\\n我們要自己",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "去把我們的孩子救回來！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "各位……",
    "voice": "vo_adv_1053006_027",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "謝謝了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們走！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n開始進軍！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "居民們",
    "words": "喔喔喔喔喔！！",
    "voice": "vo_adv_1053006_028",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500172"
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "喂──！",
    "voice": "vo_adv_1053006_029",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "\\n孩子們在這邊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "沒事吧！？",
    "voice": "vo_adv_1053006_030",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "我們馬上",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "會打倒魔物救你們出來喔！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "爸爸！不是那樣的！聽我說！",
    "voice": "vo_adv_1053006_031",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在拼命地訴說著什麼的孩子們背後，\\n有著一個大洞，而從洞裡面傳出了悲痛的叫聲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "居民們靠近一看，原來是魔物的小孩掉到洞中，\\n正在發出悲切的叫聲。\\n看牠那樣子，不像是有敵意。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500172"
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "喂、",
    "voice": "vo_adv_1053006_032",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "喂，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "是誰在這種地方挖洞的啊……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "那、",
    "voice": "vo_adv_1053006_033",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
