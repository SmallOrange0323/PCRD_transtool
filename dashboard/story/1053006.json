    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "姐姐，",
    "voice": "vo_adv_1053006_038",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "謝謝妳聽了我們的話，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "救出了魔物的小孩！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯、",
    "voice": "vo_adv_1053006_039",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這樣被不斷地感謝，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "真是有點不好意思呢。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "{0}，閣下也辛苦了。",
    "voice": "vo_adv_1053006_040",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "事情得以圓滿解決也都是閣下的功勞啊。",
    "voice": "vo_adv_1053006_041",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "拜託城鎮的人來幫忙，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這是我想不到的做法。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我一個人的話……可能會想都沒想就直接殺進魔物巢穴吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "每次都讓閣下幫助我。",
    "voice": "vo_adv_1053006_042",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n真的謝謝你。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "如果往後……閣下可以繼續在我的身邊，",
    "voice": "vo_adv_1053006_043",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n出言幫助我的話……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我會很開心的。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "看著微笑的莫妮卡，{0}也溫柔地笑了。",
