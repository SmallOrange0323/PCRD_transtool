  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "喂，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "先把牠拉上來看看吧！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接著莫妮卡和居民們戰戰兢兢地把魔物的孩子拉上來後，\\n魔物們也不再靠近，回到了森林的深處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500172"
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "這樣就沒事了……",
    "voice": "vo_adv_1053006_034",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我想……",
    "voice": "vo_adv_1053006_035",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n那些魔物們，不是來襲擊城鎮的，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "而是為了來傳達這件事情的啊……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "哎呀──",
    "voice": "vo_adv_1053006_036",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "幸好事情圓滿落幕了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "謝謝！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "多虧了妳提議讓大家一起來救助孩子們！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒、",
    "voice": "vo_adv_1053006_037",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒有……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我其實",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒做什麼……",
