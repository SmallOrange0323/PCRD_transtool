  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……",
    "voice": "vo_adv_2208001_000",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……主、",
    "voice": "vo_adv_2208001_001",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "人……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……您",
    "voice": "vo_adv_2208001_002",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "作夢了嗎？",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……在下",
    "voice": "vo_adv_2208001_003",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也是。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下……",
    "voice": "vo_adv_2208001_004",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "肯定",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "作的也是同樣的夢。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n夢見了已經不在世上的",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常珍貴的",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "家人……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "或許……",
    "voice": "vo_adv_2208001_005",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n是因為我們從涅妃‧涅羅小姐那裡",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n聽說了那件事",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "才會夢見的……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也說不定。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "502170"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "那就舉辦吧──",
    "voice": "vo_adv_2208001_006",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n四個世界聯合召開的",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「公主會議」。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "四個",
    "voice": "vo_adv_2208001_007",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "世界？",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呃。",
    "voice": "vo_adv_2208001_008",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n四個世界是指──",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "此處",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "「吉歐‧格黑納」和……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們來自的",
    "voice": "vo_adv_2208001_009",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「阿斯特朗」。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還有萊拉耶爾殿下所治理的",
    "voice": "vo_adv_2208001_010",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「吉歐‧提格尼亞」……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "以及──",
    "voice": "vo_adv_2208001_011",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "第四世界。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "其名為，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「吉歐‧尼布爾黑爾」。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "吉歐‧尼布爾黑爾……",
    "voice": "vo_adv_2208001_012",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "以往和那片土地",
    "voice": "vo_adv_2208001_013",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "交集甚少。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家也只是",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "略有耳聞……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "據說，在吉歐‧尼布爾黑爾",
    "voice": "vo_adv_2208001_014",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "那片土地上，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n也有像奴家和貪吃佩可公主一樣君臨世界的公主。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正如",
    "voice": "vo_adv_2208001_015",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家方才所說。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n此次事件",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "跨越了世界和世界的",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "界線。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家已派遣使節前去拜訪",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "吉歐‧尼布爾黑爾的公主。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "使節……",
    "voice": "vo_adv_2208001_016",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這麼說起來，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "最近確實沒看見涅婭小姐呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這陣子也沒怎麼聽見",
    "voice": "vo_adv_2208001_017",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n卡里莎那個臭矮子吵吵嚷嚷的聲音呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就像很久以前",
    "voice": "vo_adv_2208001_018",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "涅婭小姐獨自一人來到蘭德索爾一樣。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這次",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是把兩人派遣到",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n吉歐‧尼布爾黑爾",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的世界嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "別看她那樣，",
    "voice": "vo_adv_2208001_019",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "各方面都多才多藝呢。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n區區小場面不會讓她慌了手腳，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n作為前往陌生土地的探子，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "是再適合不過的人選了。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……作為使節，",
    "voice": "vo_adv_2208001_020",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n若是能再多學習一些",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "禮儀規矩的話，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家就沒什麼好挑剔的了。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "唔。",
    "voice": "vo_adv_2208001_021",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n聽起來是個連涅妃‧涅羅小姐",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "都沒去過的地方……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那個叫做吉歐‧尼布爾黑爾的地方",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "究竟會是什麼樣的呢？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "根據傳聞，",
    "voice": "vo_adv_2208001_022",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n吉歐‧格黑納",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "是個截然不同且令人敬畏的地獄……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "一個被死亡的寂靜",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "籠罩的世界，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "宛如冥府。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……宛如、",
    "voice": "vo_adv_2208001_023",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "冥府……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "still",
    "still_id": "220800102"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……至今為止，",
    "voice": "vo_adv_2208001_024",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在吉歐‧格黑納的探索中，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有很多有趣的發現。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "像是和蘭德索爾不同的精靈樣貌，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n以及連接不同時空的裝置",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "等等……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "遺憾的是，",
    "voice": "vo_adv_2208001_025",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "目前還沒有找到",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n任何有關",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "消失的人的線索，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n或是類似情況的資訊……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……消失的現象",
    "voice": "vo_adv_2208001_026",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然很接近現實世界中的死亡……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n但",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如果",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "《阿斯特朗傳奇》的背後",
    "voice": null,
