  {
    "type": "dialogue",
    "name": "美里",
    "words": "這份工作",
    "voice": "vo_adv_5108411_000",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "馬上就要結束了呢。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "因為已經做習慣了，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "感覺有點寂寞呢……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "說來說去，",
    "voice": "vo_adv_5108411_001",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們也挺合拍的。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……這工作還不賴呢。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "好了好了，",
    "voice": "vo_adv_5108411_002",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳們兩位，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n不能讓客人看到這種表情喔。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們還在營業中呢。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……說得對。",
    "voice": "vo_adv_5108411_003",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "小老闆娘。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "為了讓客人保持愉快，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我們也必須保持笑容才行。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "讓我們為此旅館奉獻到最後吧。",
    "voice": "vo_adv_5108411_004",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "希望下次",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們來的時候",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也能受到這樣的款待。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……呵呵。",
    "voice": "vo_adv_5108411_005",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "寂寞",
    "voice": "vo_adv_5108411_006",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這種話",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "太不像我了，所以我是不會說的。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n因為這個世界肯定",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還有很多開心的事情啊。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……不過，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "疲憊時",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "再來這裡或許也不錯呢，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "對吧？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "美里",
