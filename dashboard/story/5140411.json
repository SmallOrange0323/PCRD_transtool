[
  {
    "type": "background",
    "bg_id": "502224"
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "美衣子～！",
    "voice": "vo_adv_5140411_000",
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "球跑到妳那邊去了～！",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "克蘿依。",
    "voice": "vo_adv_5140411_001",
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "什麼事？",
    "voice": "vo_adv_5140411_002",
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "琪愛兒發育得真好啊。",
    "voice": "vo_adv_5140411_003",
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_5140411_004",
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是這樣呢。",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我要什麼時候才會變成那樣呢？",
    "voice": "vo_adv_5140411_005",
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦……",
    "voice": "vo_adv_5140411_006",
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n不，我哪知道……",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過妳想變成那樣嗎？",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我現在也在思考這件事。",
    "voice": "vo_adv_5140411_007",
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "外表上的差異，",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "每個人都各不相同，沒有優劣之分。",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我對這個尚在發展中的狀態，",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "也感到相當地滿足和喜愛。",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，也對呢。",
    "voice": "vo_adv_5140411_008",
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "要是發育了就沒辦法混進小小甜心中，",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n跟她們一起玩辦家家酒了呢。",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那樣很困擾呢。",
    "voice": "vo_adv_5140411_009",
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不，",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我是不會困擾，",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但美美她們一定會非常惋惜吧。",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "會惋惜嗎……",
    "voice": "vo_adv_5140411_010",
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "應該沒有影響吧……",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "妳們兩位，",
    "voice": "vo_adv_5140411_011",
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "怎麼都一臉沉重的樣子？",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "特別講座今天就要結束了，",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "可不是感到悲傷的時候！",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "打起精神撐到最後吧！",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "目標是",
    "voice": "vo_adv_5140411_012",
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "獎學金！",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "切嚕地上吧！",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒、優妮",
    "words": "喔喔～！",
    "voice": "vo_adv_5140411_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "等～等～等～\\n等一下，",
    "voice": "vo_adv_5140411_014",
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個啊，",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我現在突然注意到了。",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n獎學金的事情，",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這次一丁點都沒有提到吧？",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦？",
    "voice": "vo_adv_5140411_015",
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "唔嗯……",
    "voice": "vo_adv_5140411_016",
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "雖然很令人不悅，",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n但修女一直以來都會分別使用糖果和鞭子來隨意驅使我們，",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不過終於連糖果都捨不得給了……",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "真是不景氣的時代。",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那麼，",
    "voice": "vo_adv_5140411_017",
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這次就不是公會活動了啊……",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦？",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "既然這樣，",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那這次是什麼活動？",
    "voice": null,
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "誰知道……",
    "voice": "vo_adv_5140411_018",
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "慈善活動？",
    "voice": null,
    "unit_id": 129411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "慈善活動啊……",
    "voice": "vo_adv_5140411_019",
    "unit_id": 129511
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "唔嗯，",
    "voice": "vo_adv_5140411_020",
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就算擺脫了地獄的詛咒，",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n到頭來我們的命運還是會將我們導向正人君子呢。",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這也是因為我們與生俱來的善良本性吧。",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "沒辦法了，",
    "voice": "vo_adv_5140411_021",
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "上吧，同志。",
    "voice": null,
    "unit_id": 129311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n作為善人開始這最後一天吧。",
    "voice": null,
    "unit_id": 129311
  }
]
