  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "呼～",
    "voice": "vo_adv_5035101_000",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這次的委託還真不簡單呀～",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "但報酬的金額也相對地多，",
    "voice": "vo_adv_5035101_001",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "委託不都是這樣嗎？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "比起這事，卯月，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "剛剛委託人",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "是不是給了妳什麼東西？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "啊，",
    "voice": "vo_adv_5035101_002",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是的。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是這個……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "對方說如果有興趣的話就請我們去看看吧。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "哦哦──！",
    "voice": "vo_adv_5035101_003",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這個",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "不是【慈樂之音】的演唱會門票嗎！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n這是很難拿到的呢！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……那是什麼？",
    "voice": "vo_adv_5035101_004",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "咦！？",
    "voice": "vo_adv_5035101_005",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "澀凜凜小姐，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "難道妳不知道嗎！？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n島村村呢！？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我也",
    "voice": "vo_adv_5035101_006",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "不是很清楚。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n這是什麼的門票呀？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "是現在超人氣偶像團體的活動門票唷！",
    "voice": "vo_adv_5035101_007",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n能看她們",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "又唱又跳的……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "總之是很厲害的東西啦！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "……雖然我也沒看過就是了……！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜、卯月",
    "words": "……「偶像」？",
    "voice": "vo_adv_5035101_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "……「偶像」",
    "voice": "vo_adv_5035101_009",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "……是",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "什麼呢？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "明明是不知道的名詞……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "但又好像很熟悉……？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "好～！",
    "voice": "vo_adv_5035101_010",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n既然這麼難得，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那我們就一起去看吧！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "咦，",
    "voice": "vo_adv_5035101_011",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "不用啦，我沒差。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n反正我沒什麼興趣。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "咦——！",
    "voice": "vo_adv_5035101_012",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n這可是超稀有的門票喔，澀凜凜！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "就算妳這麼說——",
    "voice": "vo_adv_5035101_013",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "未央！",
    "voice": "vo_adv_5035101_014",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n我……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "很想去看看，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "所謂的「偶像」！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "雖然我不知道為什麼，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "但就是感覺不去看不行……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "真不愧是島村村──♪",
    "voice": "vo_adv_5035101_015",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "妳看妳看～",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "澀凜凜，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "一個人留下來看家可是會很寂寞的唷──？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "一起去一定會很有趣的嘛──",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "哎……",
    "voice": "vo_adv_5035101_016",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "真拿妳沒辦法。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "只有妳們兩個的話，總覺得讓人有點擔心，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我會跟著去啦。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜、卯月、未央",
    "words": "下一回，",
    "voice": "vo_adv_5035101_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜、卯月、未央",
    "words": "『星光公主",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜、卯月、未央",
    "words": "　Re:M@STER！』",
