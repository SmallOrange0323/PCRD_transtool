[
  {
    "type": "background",
    "bg_id": "510370"
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "子どもたちと店番をしたり訓練をしたり……",
    "voice": "vo_adv_6106102_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "有意義ではあるのだが、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n一ギルドの長としては、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "少しくらい尊敬の念というものを感じたいのだ。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "……貴公はどう接するのが適切だと思う？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "同じ目線で……",
    "voice": "vo_adv_6106102_001",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "確かに、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "見習いとはいえ栄えある",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n我がギルドの一員なのだから、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "対等に接することが望ましいな。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "……まさかと思うが私が子どもっぽいからではないよな、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "貴公？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "うむ。",
    "voice": "vo_adv_6106102_002",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "やはり年長者として、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "模範的に振る舞わなくてはな。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n年長者のこの私が、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "時に優しく、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "時に厳しく導いてやらなくては。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ふふ、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "年長者か……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "実に甘美な響きだ。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "気に入ったぞ！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "へっ！？　",
    "voice": "vo_adv_6106102_003",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "お、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "お母さんの気持ち……？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "いやしかし、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "それでは貴公がお父さんということになるのでは……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "あっ、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "やっ、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "なんでもない！　",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "まあその、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "努力はしてみよう……",
    "voice": null,
    "unit_id": 105311
  }
]
