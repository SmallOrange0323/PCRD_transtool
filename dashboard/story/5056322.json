[
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": "vo_adv_5056322_000",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "牠好像稍微畏縮了！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一鼓作氣地進攻吧！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等等，",
    "voice": "vo_adv_5056322_001",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "冷靜一點啦！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說是畏縮了，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可是牠好像還在躁動……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n萬一太著急而掉下船，我們可是承受不住的。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_5056322_002",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一旦掉入海中，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那裡完全就是牠的地盤了，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們毫無勝算可言。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請特別留意。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "說得也是……",
    "voice": "vo_adv_5056322_003",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "為了大間的未來，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們不能輸。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n一定要獲勝！",
    "voice": null,
    "unit_id": 111811
  }
]
