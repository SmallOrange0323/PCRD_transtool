[
  {
    "type": "background",
    "bg_id": "500390"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}接到忍的請求，希望他能協助完成某個委託，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n因此來到了約定的見面地點。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": "vo_adv_1220001_000",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你好。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我正在等你呢。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "唔，",
    "voice": "vo_adv_1220001_001",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "你就是騎士大人……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "應該沒有錯吧。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "失禮了。",
    "voice": "vo_adv_1220001_002",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "我們正長期追查某批海盜的下落。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n為了將他們逮捕，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "希望能借助忍大人",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "以及",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "騎士大人的力量。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "畢竟我們所追跡的敵人……",
    "voice": "vo_adv_1220001_003",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n可是",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "一艘",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "幽靈船呢。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "發現行蹤後，",
    "voice": "vo_adv_1220001_004",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "其又會很快地在不知不覺間消失。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n過往我們曾有",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "多次能成功將其逮捕的機會。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "然而，",
    "voice": "vo_adv_1220001_005",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "往往稍不注意，他們就會突然無影無蹤……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n無論是幽靈船，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "還是抓到的海盜們，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "全部都不留痕跡地徹底消失了。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因此這次才決定要來找我。",
    "voice": "vo_adv_1220001_006",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n希望我能幫忙",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "逮捕住幽靈船。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "然後，占卜結果顯示，",
    "voice": "vo_adv_1220001_007",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n這次的委託",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "找你來幫忙會比較好。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "哼！",
    "voice": "vo_adv_1220001_008",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "像這種正經八百騎士團的委託，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n老實講我打死也不想接。",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "更何況還有小伙子在，更不想接了！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "如果這是",
    "voice": "vo_adv_1220001_009",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "在豪華郵輪裡被漂亮姐姐們給包圍的歡樂假期，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n那我就百分百贊成了。",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "……但忍她卻",
    "voice": "vo_adv_1220001_010",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "無論如何都想接下這個委託，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n怎麼講也講不聽。",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "那麼，",
    "voice": "vo_adv_1220001_011",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "騎士大人。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "請容我再次進行確認，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n您願意接下這個委託，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "沒錯吧？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "感謝您的協助。",
    "voice": "vo_adv_1220001_012",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "還請兩位登上",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "我們的船吧。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n船就停靠在附近的港口。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "background",
    "bg_id": "500840"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……占卜結果出來了。",
    "voice": "vo_adv_1220001_013",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n只要照這樣往北北西方向航行，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n應該就能找到目標船隻。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "只不過，",
    "voice": "vo_adv_1220001_014",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "目前能感應到的存在仍很模糊，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n因此目標離我們應有相當遠的距離。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "了解。",
    "voice": "vo_adv_1220001_015",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n……喂，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "傳令下去。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n照目前方向航行，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "並警戒周圍狀況，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "維持現在船速前進！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團團員們",
    "words": "遵命！！！",
    "voice": "vo_adv_1220001_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "沒錯沒錯！",
    "voice": "vo_adv_1220001_017",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "小子們，努力幹活啊！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸，",
    "voice": "vo_adv_1220001_018",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你也真是的。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣很失禮呀。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "哈哈哈，",
    "voice": "vo_adv_1220001_019",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "您的父親真是開朗風趣呢。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "那麼，",
    "voice": "vo_adv_1220001_020",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "我們稍後也將會輪班看哨。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n兩位不如就稍作休息吧。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n儘管本船稱不上寬敞舒適，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "但仍有為兩位準備好房間。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "感謝你",
    "voice": "vo_adv_1220001_021",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "設想地如此周到。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}，\\n我們就順著對方的好意，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "去休息一下吧。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "background",
    "bg_id": "500952"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呼啊……",
    "voice": "vo_adv_1220001_022",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我為了這次委託，準備到天亮，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "有些睡眠不足。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "既然有可能進入長期奮戰，",
    "voice": "vo_adv_1220001_023",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n或許還是稍微補眠會比較好呢。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你要不要也一起來睡呢？",
    "voice": "vo_adv_1220001_024",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n這床",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "十分鬆軟，躺起來很舒服喔。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那、",
    "voice": "vo_adv_1220001_025",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個……",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}？",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "小伙子，給我慢著！",
    "voice": "vo_adv_1220001_026",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n你怎麼",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "就這樣準備跟忍睡同一張床！？",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n喂，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "不要露出一副困惑的表情！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個，",
    "voice": "vo_adv_1220001_027",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我剛才的意思是……",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我們一起睡上下床舖，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "上層的空床",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "給你睡這樣……",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但若你不介意……",
    "voice": "vo_adv_1220001_028",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "一起睡在",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "同一張床上也是可以的……",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗚。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
