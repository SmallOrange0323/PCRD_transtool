  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "尤其是",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "到常去的酒館把錢花光，感覺真的很棒。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "但是，",
    "voice": "vo_adv_1220001_064",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "大概是從我們的船被叫做幽靈船的那時候開始吧……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "\\n等到我們察覺，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "就已經無法登上陸地了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "\\n只要一靠近港口，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "就會像受詛咒般，有暴風雨或大浪來攪局。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "之前",
    "voice": "vo_adv_1220001_065",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "我們被這群軍隊抓住時，也是同樣的狀況。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "\\n原本還以為終於可以踏上陸地，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "\\n從這惱人的詛咒中解放了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "只不過，",
    "voice": "vo_adv_1220001_066",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "等我再次張開眼睛，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "卻發現自己正躺在這甲板上睡。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "我們在不知不覺中，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "又回到了這裡。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "這樣的生活也不曉得持續了幾年，",
    "voice": "vo_adv_1220001_067",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "\\n我老早就已經懶得算了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "或許是搜刮來的寶物裡有東西被詛咒了，",
    "voice": "vo_adv_1220001_068",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "實際的原因我不知道。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "\\n但",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "我們的旅途",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "一直都無法走到終點。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "即使我們早已想結束這趟旅途了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以，",
    "voice": "vo_adv_1220001_069",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "他們才會找我過來。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "啊……？",
    "voice": "vo_adv_1220001_070",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我是來替在場各位的……",
    "voice": "vo_adv_1220001_071",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "漫長旅程劃下休止符的。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "background",
    "bg_id": "500842"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝你，",
    "voice": "vo_adv_1220001_072",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n勞煩你幫忙準備儀式了。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我接到的委託內容是，",
    "voice": "vo_adv_1220001_073",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "搜索幽靈船。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "以及──",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "讓徘徊在世的幽靈們",
    "voice": "vo_adv_1220001_074",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "獲得解脫。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "是的，",
    "voice": "vo_adv_1220001_075",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "十分感謝",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "忍大人以及騎士大人的協助。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n這樣一來，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "我們也終於……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "可以從這工作中解放了。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然原本以為能靠談話和平地解決，",
    "voice": "vo_adv_1220001_076",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但最後受情勢所迫，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不得不戰鬥。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過這似乎反而符合了",
    "voice": "vo_adv_1220001_077",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "海盜們勝者為王的規矩呢。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就結果而言，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也成功讓他們老實地聽話了。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "在水盆裡倒入聖水，",
    "voice": "vo_adv_1220001_078",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "並點燃淨身之火……",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n星星",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也來到了正確的位置。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣就一切準備就緒了。",
    "voice": "vo_adv_1220001_079",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n{0}，請",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "替我強化。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "引導萬物的繁星啊，",
    "voice": "vo_adv_1220001_080",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "胸懷靜謐安詳的生命之母，大海啊。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n請赦免徬徨之徒的罪，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "賜予他們的靈魂",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "安寧吧──",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "這是……",
    "voice": "vo_adv_1220001_081",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "海盜們開始發光，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "並緩緩往天上飛去……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "啊啊，",
    "voice": "vo_adv_1220001_082",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "感覺一直在胸中的",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "那顆大石頭終於消失了……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我已經將侵蝕著各位以及幽靈船的穢物加以淨化。",
    "voice": "vo_adv_1220001_083",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "如此一來，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你們應該不會再被這艘船所束縛了。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "我們的旅途……",
    "voice": "vo_adv_1220001_084",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "終於來到終點了嗎。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "能夠葬身在海上，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "以海盜而言也算是理想的結果了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "小姑娘，",
    "voice": "vo_adv_1220001_085",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "剛才抱歉啦。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "然後，謝謝妳。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "我連手下們的份也一起向妳致謝。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "若可以真想好好給個回禮，",
    "voice": "vo_adv_1220001_086",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "但似乎也沒剩什麼時間讓我那樣做了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幽靈船的船長",
    "words": "……永別了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "background",
    "bg_id": "500842"
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "他們",
    "voice": "vo_adv_1220001_087",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "離開了呢。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n不過……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "如此一來，我們也算是一了夙願。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "那麼，",
    "voice": "vo_adv_1220001_088",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "接下來也麻煩您了。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n您拜託我們準備的東西，則在船的後方。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我明白了。",
    "voice": "vo_adv_1220001_089",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "得趁星辰的位置尚未改變前，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n好好將大家送走才行。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "噢，",
    "voice": "vo_adv_1220001_090",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "對了。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n還未向您說明關於我們的事呢。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "該怎麼說……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "被幽靈船所束縛住的，",
    "voice": "vo_adv_1220001_091",
    "unit_id": 714
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "並不只有他們。",
    "voice": null,
    "unit_id": 714
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n隨著長期追捕那些海盜，",
    "voice": null,
    "unit_id": 714
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n我們也跟著被詛咒給束縛住，",
    "voice": null,
    "unit_id": 714
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "因而無法成佛。",
    "voice": null,
    "unit_id": 714
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "不過現在……",
    "voice": "vo_adv_1220001_092",
    "unit_id": 714
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "我們也總算是可以完成工作了。",
    "voice": null,
    "unit_id": 714
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n這次真的十分感謝",
    "voice": null,
    "unit_id": 714
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "忍大人",
    "voice": null,
    "unit_id": 714
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "以及騎士大人的幫助。",
    "voice": null,
    "unit_id": 714
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "哎呀，",
    "voice": "vo_adv_1220001_093",
    "unit_id": 714
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "現在可沒時間繼續聊下去呢。",
    "voice": null,
    "unit_id": 714
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n我們也差不多該離開了。",
    "voice": null,
    "unit_id": 714
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "\\n──兩位也",
    "voice": null,
    "unit_id": 714
  },
  {
    "type": "dialogue",
    "name": "騎士團員",
    "words": "還請多多保重。",
    "voice": null,
    "unit_id": 714
  },
  {
    "type": "background",
    "bg_id": "500845"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "成功解開幽靈船詛咒的{0}等人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n隨後坐上事先準備好的小船，朝陸地前進──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501182"
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "聽好了，",
    "voice": "vo_adv_1220001_094",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "小伙子。",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "你現在是特別獲得忍同意，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n才有幸坐上她事先準備的船。",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n可要奮力揮灑汗水，不眠不休地拚命划船啊！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "若要這樣說，爸爸不也是一樣嗎。",
    "voice": "vo_adv_1220001_095",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n別光只是對{0}做些不合理的要求呀。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過，",
    "voice": "vo_adv_1220001_096",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "確實感覺分攤一下工作會比較好呢。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n感覺霧也變得相當濃了……",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我會以占卜來領路，",
    "voice": "vo_adv_1220001_097",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "可以麻煩你照著我指示的方向前進嗎？",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "若你累了，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我可以接手划船的工作。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "喂，",
    "voice": "vo_adv_1220001_098",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "你不會真的讓她這樣做的對吧，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "小伙子。",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n讓柔弱少女負責拿船槳，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n自己在一邊涼快，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這種事老天可不會──",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸，",
    "voice": "vo_adv_1220001_099",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你真是的。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "划船這點小事，",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也是辦得到的好嗎。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}，請把船槳給我一下。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "啊啊啊啊！",
    "voice": "vo_adv_1220001_100",
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "妳不用划船啦！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "那可是這傢伙的工作！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n喂，",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "小伙子你明白吧！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "絕對不能把船槳給她！",
    "voice": null,
    "unit_id": 2413
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真是的，",
    "voice": "vo_adv_1220001_101",
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸你就是太過溺愛小孩了。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "可以別理會爸爸說的話沒關係。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也會幫忙的。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請把船槳",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "給我。",
    "voice": null,
    "unit_id": 122012
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "看著和平時一樣囉嗦的骷髏老爸，和難得反抗他的忍。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}不曉得該聽哪邊的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n只能苦惱萬分地默默拿著船槳。",
    "voice": null,
    "unit_id": null
  }
]
