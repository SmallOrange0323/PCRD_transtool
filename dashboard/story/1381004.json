    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "也就是說",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "這已經跨越扮演夫妻的界線，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n要正式",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "說是夫妻",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "也沒問題吧？",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "畢竟你",
    "voice": "vo_adv_1381004_039",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "都親吻我了。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "……",
    "voice": "vo_adv_1381004_040",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "呵呵呵……♪",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n對不起，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "開玩笑的♪",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "不過，",
    "voice": "vo_adv_1381004_041",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "也不用這麼驚慌吧？",
