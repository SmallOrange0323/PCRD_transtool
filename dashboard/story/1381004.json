    "words": "{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了確認烏爾姆的狀態",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n以及是否還有蜜蜂魔物殘留，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到了吉歐‧提格尼亞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "謝謝你來",
    "voice": "vo_adv_1381004_000",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "確認狀況。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "雖然沒有說出口，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但烏爾姆一定也很高興的。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "話說回來……",
    "voice": "vo_adv_1381004_001",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是不是還沒有",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n讓你品嚐過",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "「至高的彩虹塔」？",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那麼",
    "voice": "vo_adv_1381004_002",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這下正好。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "材料都足夠，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我馬上就來製作。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "請務必品嚐看看。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "怎麼可以。",
    "voice": "vo_adv_1381004_003",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我是希望",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "可以慰勞你……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不──",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我們",
    "voice": "vo_adv_1381004_004",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就一起製作吧。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n騎士……♪",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呼……",
    "voice": "vo_adv_1381004_005",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "再來就只要等它烤好",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "了呢。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n謝謝你",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "幫忙我。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還有……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "甜點進獻儀式",
    "voice": "vo_adv_1381004_006",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "以及烏爾姆的事，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "都受你幫助了。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n請讓我再次向你道謝。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士，",
    "voice": "vo_adv_1381004_007",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "非常謝謝你。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士你",
    "voice": "vo_adv_1381004_008",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "在我痛苦的時候，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "一直陪在我身邊。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n多虧了你，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "讓我能夠鼓起勇氣。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "真的",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "很令人安心……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "非常地可靠。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "…………",
    "voice": "vo_adv_1381004_009",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……我果然，",
    "voice": "vo_adv_1381004_010",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n本質上",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "並不適合當公主吧。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "每當",
    "voice": "vo_adv_1381004_011",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "要做出決斷時，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "內心總是會感到迷惘……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "而且……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "明明是代表國家的公主，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n憑我一己之力能做到的事情",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "卻是如此有限。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……但是。",
    "voice": "vo_adv_1381004_012",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n只要有騎士在我身邊，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我就會覺得自己什麼都做得到，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "感覺非常安心。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "每當發生了什麼，",
    "voice": "vo_adv_1381004_013",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你都會馬上趕來。",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不過，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不只是發生事件的時候，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n如果平時",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你也能一直支持我的話……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……？",
    "voice": "vo_adv_1381004_014",
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n又是",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這道光嗎……",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "雖然要抵抗很容易，",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但現在就接受它吧──",
    "voice": null,
    "unit_id": 138111
  },
  {
    "type": "background",
    "bg_id": "510092"
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "呼……",
    "voice": "vo_adv_1381004_015",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "我吃飽了。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "怎麼了嗎，",
    "voice": "vo_adv_1381004_016",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "親愛的？",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "我們現在",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "把火鍋吃完了，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n當然要說「我吃飽了」",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "對吧？",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "真是的，",
    "voice": "vo_adv_1381004_017",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "請不要那麼緊張，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n再放輕鬆一點。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "現在這裡",
    "voice": "vo_adv_1381004_018",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "只有我們兩人。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n是屬於夫妻兩人",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "的時光……",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "對吧？",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "好，",
    "voice": "vo_adv_1381004_019",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "做得很好♪",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "既然吃完晚餐了，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "再來就是洗澡……",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "雖然也不錯，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "但現在就先吃飯後甜點吧。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "正因為這樣。",
    "voice": "vo_adv_1381004_020",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n此刻",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "更要認真投入扮演夫妻這件事才行。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "那麼接下來",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "要洗澡……",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "在這之前。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "先吃飯後甜點吧。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "話雖如此，",
    "voice": "vo_adv_1381004_021",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "甜點要從現在開始製作就是了。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "請稍等一下喔，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "親愛的♪",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "still",
    "still_id": "138100401"
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "呵呵。",
    "voice": "vo_adv_1381004_022",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n雖然沒能準備好甜點，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "但其實",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "在買火鍋材料時，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n我偷偷地",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "也買了起司蛋糕的材料。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "嗯，",
    "voice": "vo_adv_1381004_023",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "當然可以。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "……不如說，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "要是你不一直待在我身邊，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "我搞不好會失敗。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "製作過程中，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "也請一直陪在我身邊。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "謝謝你。",
    "voice": "vo_adv_1381004_024",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "那麼，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "取出材料",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "跟準備器具的工作，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n就麻煩你了。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "聽起來不錯呢，",
    "voice": "vo_adv_1381004_025",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n一定會很適合。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n濃郁和清爽滋味的和諧，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "感覺會在嘴裡擴散開來。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "……呵呵。",
    "voice": "vo_adv_1381004_026",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "啊，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "對不起，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "突然笑出來。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "我覺得很奇怪。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "明明有你在身邊會很令人安心，",
    "voice": "vo_adv_1381004_027",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n但越是靠近……",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "也越令人",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "心跳加速。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n就算我弄錯",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "起司蛋糕的製作步驟，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "把它烤焦了，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "也要原諒我喔。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "哎呀……♪",
    "voice": "vo_adv_1381004_028",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "我的老公",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "果然",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "很可靠呢。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "不過，",
    "voice": "vo_adv_1381004_029",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "還是希望可以讓你吃到美味的蛋糕。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n我會小心不要失敗的。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "啊……",
    "voice": "vo_adv_1381004_030",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "呀啊！？",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "still",
    "still_id": "138100402"
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "……",
    "voice": "vo_adv_1381004_031",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "對不起。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "話才剛說完，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "馬上就失手了♪",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "那麼……",
    "voice": "vo_adv_1381004_032",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "因為我現在",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "兩手都是滿的，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n就請你幫我擦掉吧。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "不行。",
    "voice": "vo_adv_1381004_033",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "我說",
    "voice": "vo_adv_1381004_034",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "不行。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "我們可是夫妻喔？",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "應該有更像夫妻",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "的擦取方式吧？",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "誰知道呢？",
    "voice": "vo_adv_1381004_035",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "我可不知道",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "你打算要做什麼。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "呵呵……♪",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "只不過，",
    "voice": "vo_adv_1381004_036",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "我想想……",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "如果是你的話，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "不管對我做什麼，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "我都會接受。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n就先讓你知道",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "這一點吧♪",
    "voice": null,
    "unit_id": 126533
  },
