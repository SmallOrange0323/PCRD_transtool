  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "……啊。",
    "voice": "vo_adv_1381004_037",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "呵呵……",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "親愛的♪",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "被舔了臉頰，",
    "voice": "vo_adv_1381004_038",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "幾乎等於是被親吻了吧。",
