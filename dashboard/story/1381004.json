    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "雖說是下意識的反應，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "但也因為這樣",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "而讓人受傷。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "至少也說一句",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "能和我成為夫妻很高興之類的嘛……",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "對不起。",
    "voice": "vo_adv_1381004_042",
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n我有點太壞心眼了呢。",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "你的反應太可愛了，",
    "voice": null,
    "unit_id": 126533
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "就忍不住捉弄……♪",
    "voice": null,
    "unit_id": 126533
  },
  {
