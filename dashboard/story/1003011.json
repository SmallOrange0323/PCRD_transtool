[
  {
    "type": "background",
    "bg_id": "500320"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "——與怜一同參加視察之旅的{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n視察完第一個村莊，乘坐馬車前往下個村莊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……好。",
    "voice": "vo_adv_1003011_000",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "報告應該這樣做就行了吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然想趁勢前往下個村莊……",
    "voice": "vo_adv_1003011_001",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但你會不會覺得無聊？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝。",
    "voice": "vo_adv_1003011_002",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n雖然我很開心……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但那個",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "總覺得有點不好意思。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且",
    "voice": "vo_adv_1003011_003",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "光是報告的份量就滿多的了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "剩下的就留到下個村莊時再做吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼，",
    "voice": "vo_adv_1003011_004",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就簡單的吃點東西休息一下吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n在剛剛的村裡",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "買了點三明治，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要不要一起……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這道光是！　",
    "voice": "vo_adv_1003011_005",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "都已經離開蘭德索爾了竟然又出現了…！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "意識",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "又……！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "——你好啊。",
    "voice": "vo_adv_1003011_006",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n沒想到假日還能在這裡遇到你，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真巧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你是來買東西的？　",
    "voice": "vo_adv_1003011_007",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對啊。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n硬要說的話",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是來『散心』",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "的吧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……今天被父親擺了一道。",
    "voice": "vo_adv_1003011_008",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n他硬拖我出來參加飯局，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n原來是要我參加政治人物和他們兒子的聚會。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "所以我就騙他們說我有事，",
    "voice": "vo_adv_1003011_009",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "提早跑出來了。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……要我乖乖待在那種地方，",
    "voice": "vo_adv_1003011_010",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n乾脆讓我死了算了。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且",
    "voice": "vo_adv_1003011_011",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "總是希望我什麼事都順著他的想法走，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我對父親的那種做法早就厭煩了。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……對了。",
    "voice": "vo_adv_1003011_012",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你現在有空嗎？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "難得都遇到了，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一起去哪裡走走吧？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝。",
    "voice": "vo_adv_1003011_013",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好像把你捲入了什麼事件一樣，抱歉啊。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我、",
    "voice": "vo_adv_1003011_014",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我沒想到你竟然會那麼開心。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我好像能懂你的心情。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一想到能和你一起出去走走，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "心情就很雀躍。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼",
    "voice": "vo_adv_1003011_015",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們去遠一點的地方吧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我一直想再和你一起去看海。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "可以吧？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "still",
    "still_id": "100301101"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "——沉靜的大海……",
    "voice": "vo_adv_1003011_016",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n終於能兩人一起來看海了呢。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還吹著舒服的風……",
    "voice": "vo_adv_1003011_017",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n要是",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有帶釣具來就好……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊！？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……討厭。",
    "voice": "vo_adv_1003011_018",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我以為是很舒適的風，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但好像有點強。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我的髮型",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有沒有變得怪怪的？",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是嗎。",
    "voice": "vo_adv_1003011_019",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那就好。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n在你面前",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我不想露出不體面的樣子。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……什麼！？",
    "voice": "vo_adv_1003011_020",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n真、",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是的，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "別捉弄人啦。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看。",
    "voice": "vo_adv_1003011_021",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "海多麼的寬廣",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "多自由……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……『希望孩子別被嘲笑為世襲議員』。",
    "voice": "vo_adv_1003011_022",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我至今，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是在父親的這個教育方針下栽培長大的。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無論是讀書、",
    "voice": "vo_adv_1003011_023",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "學校、",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "交友狀況……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "甚至是我的想法，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n幾乎沒有一樣是我自己選擇的。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n簡直就像飼養在魚缸裡的魚一樣。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但現在不同了。",
    "voice": "vo_adv_1003011_024",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是我自己選擇投入的世界",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n在阿斯特朗遇到的同伴",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "改變了我。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這段羈絆",
    "voice": "vo_adv_1003011_025",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "比什麼事物都更讓我想珍惜。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "身邊有好夥伴。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "光是這點",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就讓我湧現想依照自己意願活下去的勇氣。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "即使一步一步慢慢來也沒關係。",
    "voice": "vo_adv_1003011_026",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一點一點的抗爭……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "總有一天一定",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n能像這片大海一般",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "生活在自由的世界中……！",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……不過嘛",
    "voice": "vo_adv_1003011_027",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "若我是淡水魚的話，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n出海可是會死掉的。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是",
    "voice": "vo_adv_1003011_028",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "即便如此我也不在乎。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n因為那不是父母幫我舖好的路，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而是我自己選擇的結果……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊……",
    "voice": "vo_adv_1003011_029",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "並不是在說真的會死，請放心。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n只是在說我的決心。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是",
    "voice": "vo_adv_1003011_030",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "即便真的遇到可能死亡的情形，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n只要你像今天這樣陪在我身邊，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那我一定",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無論發生了什麼事都能活下去的……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且",
    "voice": "vo_adv_1003011_031",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我並不是想把你捲入事件。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "只是",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "只要你在身邊，我就覺得能夠堅強……",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "still",
    "still_id": "100301102"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……謝謝。",
    "voice": "vo_adv_1003011_032",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n雖然我也一直都沒打算客氣過，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但這樣真的很開心。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對呢……",
    "voice": "vo_adv_1003011_033",
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要是哪天被父親逐出家門，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那乾脆就跑去你家打擾吧。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊，",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我會幫忙分擔家事的，別擔心啊。",
