  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "開玩笑的啦。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就算是我",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "行動力也沒那麼強。",
    "voice": null,
    "unit_id": 100332
  },
  {
    "type": "dialogue",
