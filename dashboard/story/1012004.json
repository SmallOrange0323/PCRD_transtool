[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}被初音叫來，\\n一起來買東西。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "買了好多東西～",
    "voice": "vo_adv_1012004_000",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "謝謝你的幫忙喔！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，對了對了！",
    "voice": "vo_adv_1012004_001",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "結帳的時候，我拿到了――",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "哇！ 這、這道光是什麼！？",
    "voice": "vo_adv_1012004_002",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好刺眼……！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗚……總覺得突然變得好想睡……",
    "voice": "vo_adv_1012004_003",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n明明還沒使用……超能力……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕呼嚕……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "510280"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你決定要買什麼了嗎？",
    "voice": "vo_adv_1012004_004",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我還在猶豫……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊！",
    "voice": "vo_adv_1012004_005",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n發現好東西了！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就買這個――吧！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦……",
    "voice": "vo_adv_1012004_006",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦！？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你、你、你怎麼了！？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "抓住我的手……！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？ 你、你只是想拿一樣的商品……？",
    "voice": "vo_adv_1012004_007",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這、這樣啊，原來你也喜歡這個呢！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是，怎麼辦？",
    "voice": "vo_adv_1012004_008",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n這好像是最後一個了喔？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好――！",
    "voice": "vo_adv_1012004_009",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n既然這樣的話，就用猜拳決勝負吧！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "東西就給猜贏的人喔！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼，要開始囉――。",
    "voice": "vo_adv_1012004_010",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "剪――刀，",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "石――頭……剪刀！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊！ 我、我輸了……！？",
    "voice": "vo_adv_1012004_011",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n虧我那麼想要――！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……但是，也沒辦法呢。",
    "voice": "vo_adv_1012004_012",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n說要用猜拳決定的人是我……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你買沒關係喔。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦，什麼？",
    "voice": "vo_adv_1012004_013",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你以為我會使用超能力？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n……為了猜贏？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呵呵呵，被你小看的話，我會很困擾喔。",
    "voice": "vo_adv_1012004_014",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我是不會為了私欲而使用超能力的――！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n閃亮亮☆",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "歡迎光臨――！",
    "voice": "vo_adv_1012004_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n憑購物收據，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n皆可抽――獎！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你看你看！ 有抽獎！",
    "voice": "vo_adv_1012004_016",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "剛剛我們有買東西，所以應該可以抽獎喔。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "去看看吧――！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "您好，歡迎光臨！",
    "voice": "vo_adv_1012004_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n我看看……這個金額可以抽2次喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "頭獎是雙人旅遊套票！",
    "voice": "vo_adv_1012004_018",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n旅行啊。好像很有趣呢～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你要一次就抽中喔！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "――是白色的呢。",
    "voice": "vo_adv_1012004_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n送您安慰獎的面紙。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊……",
    "voice": "vo_adv_1012004_020",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒有中……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是，還有一次對吧。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？ 可以讓我轉嗎？",
    "voice": "vo_adv_1012004_021",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好――，我會努力的――☆",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "若是頭獎，就能和你去旅行啊～！",
    "voice": "vo_adv_1012004_022",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好棒～！ 好棒～！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊！ ",
    "voice": "vo_adv_1012004_023",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但、但我不會用超能力的！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯！ 不用，不用……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不用超能力……不用超能力……",
    "voice": "vo_adv_1012004_024",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "只用一點點……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒、沒沒、沒那回事喔！？",
    "voice": "vo_adv_1012004_025",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼――，呼――……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不、不行！",
    "voice": "vo_adv_1012004_026",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "果然還是不行啊！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是……雙人旅遊套票……",
    "voice": "vo_adv_1012004_027",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n嗚，好想要啊～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嘿噫！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "顏色是……白色！",
    "voice": "vo_adv_1012004_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n送您安慰獎的面紙。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呃！",
    "voice": "vo_adv_1012004_029",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗚……沒有中～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "background",
    "bg_id": "510330"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "抽獎結果真是遺憾呢――。",
    "voice": "vo_adv_1012004_030",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我想如果使用超能力的話，就能抽中了……",
    "voice": "vo_adv_1012004_031",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但果然不能那樣耍詐對吧？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n別管那個了，我們繼續買東西――",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊！ 有了！",
    "voice": "vo_adv_1012004_032",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我一直在找這個托特包――。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你看你看～！ 很可愛吧♪",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？ 你也一直在找這個？",
    "voice": "vo_adv_1012004_033",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是，怎麼辦？ 這好像也是最後一個……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒辦法了！",
    "voice": "vo_adv_1012004_034",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好――！ 再次以猜拳決勝負吧！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "剪――刀，石――頭……布！",
    "voice": "vo_adv_1012004_035",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊……你出剪刀！？",
    "voice": "vo_adv_1012004_036",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "既、既然這樣的話！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n……嘿噫！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "顆顆顆……！",
    "voice": "vo_adv_1012004_037",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "太好了――！",
    "voice": "vo_adv_1012004_038",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你出的拳變成石頭了喔！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n也就是說我贏了――！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……咦？ 我使用了超能力，所以算犯規？",
    "voice": "vo_adv_1012004_039",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "被、被發現了？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n欸嘿嘿～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "對不――起，無――論如何我都想要！",
    "voice": "vo_adv_1012004_040",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n原諒我――！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "因為妹妹小栞曾說想要這個，",
    "voice": "vo_adv_1012004_041",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我想送給她……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但、但是不能耍詐呢。",
    "voice": "vo_adv_1012004_042",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯，我知道了！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n這個包包就讓給你――",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？ 算我贏沒關係嗎！？",
    "voice": "vo_adv_1012004_043",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "哇――！ 謝謝――！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，辛苦了♪",
    "voice": "vo_adv_1012004_044",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛剛看見的，是如同夢境一般的情景唷。",
    "voice": "vo_adv_1012004_045",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我想你醒來以後很快就會忘記的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以沒關係，現在不用太在意哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話說，初音意外地靠得住呢～",
    "voice": "vo_adv_1012004_046",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她也有非常傻呼呼的地方，",
    "voice": "vo_adv_1012004_047",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n比如不在意場所就睡，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以我以為她也會一個勁地使用超能力……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但是不為了自己而使用這點，",
    "voice": "vo_adv_1012004_048",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n可不是件容易做到的事喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n因為人通常都會臣服於誘惑嘛。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但是那孩子很固執，",
    "voice": "vo_adv_1012004_049",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n只會為別人而使用超能力呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這一點也許跟你很像呢。",
    "voice": "vo_adv_1012004_050",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n該說是比起自己，會忍不住以他人為優先嗎。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "為了不讓初音太過勉強自己，",
    "voice": "vo_adv_1012004_051",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n請你要好好支持她喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要確實喔～！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼～，睡得好飽――。",
    "voice": "vo_adv_1012004_052",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我又睡在路上了……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是，我今天沒有使用超能力啊――？？？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？ 你也睡著了？",
    "voice": "vo_adv_1012004_053",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n是喔――，為什麼呢？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，但是因為做了個有趣的夢，很棒呢。",
    "voice": "vo_adv_1012004_054",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我夢到我和你在買東西！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "對對，抽獎……呃，",
    "voice": "vo_adv_1012004_055",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "為什麼你會知道！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……原來你也做了一樣的夢――。",
    "voice": "vo_adv_1012004_056",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真是不可思議呢。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不過，既然要做一樣的夢，如果是更棒的夢就好了呢～！",
    "voice": "vo_adv_1012004_057",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "例如確實中了獎之類的……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊！ 話說回來，剛剛買東西的時候，",
    "voice": "vo_adv_1012004_058",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我拿到抽獎券了！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "因為在夢裡沒有抽中，所以這次一定要抽中好東西喔――！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我、我當然不會使用超能力喔！",
    "voice": "vo_adv_1012004_059",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n只用一點點……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "即使初音決定不為了自己使用超能力，\\n每次卻都好像快要臣服於誘惑一般。",
    "voice": null,
    "unit_id": null
  }
]
