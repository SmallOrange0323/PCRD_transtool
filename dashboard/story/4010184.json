  },
  {
    "type": "background",
    "bg_id": "510200"
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "唔……",
    "voice": "vo_adv_4010184_000",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這個氣息……！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "是誰！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "吉格魯特……！",
    "voice": "vo_adv_4010184_001",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n難道說",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "把我叫來此處的這封信，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "是你！？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你找我這個疾風之冥姬，",
    "voice": "vo_adv_4010184_002",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n安妮羅潔‧馮‧修特帕魯",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "到底有什麼事！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "看到「冥風戰記」的訊息表單上",
    "voice": "vo_adv_4010184_003",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "寫著日期與「我在此處等候」的留言，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n所以我才來的，沒想到來這一看，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "真的是吉格魯特！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "因為實在是太過可疑，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我還猶豫過要不要來呢……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "確、",
    "voice": "vo_adv_4010184_004",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "確實……！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "今天這天正是",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我的──",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "……",
    "voice": "vo_adv_4010184_005",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "生日。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "謝、",
    "voice": "vo_adv_4010184_006",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "謝謝你……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "不對！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "感謝你！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你果然是",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我永遠的盟友！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你所獻上的贈物，",
    "voice": "vo_adv_4010184_007",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "就讓我在此解除封印吧！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n哇",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "裝訂得好漂亮的筆記本……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "咳咳。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "嗯嗯，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這是仍未點綴過的，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "白紙之書物。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "是嗎……",
    "voice": "vo_adv_4010184_008",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "吉格魯特。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n你的意思是要把我們「熾炎戰鬼煉獄血盟暗黑團」的",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "嶄新故事，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n刻劃在此本白紙之書物上，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "是這樣沒錯吧？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "呵、呵、呵……",
    "voice": "vo_adv_4010184_009",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "那",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "好啊！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n我與你從今以後所經歷的故事，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "就來好好紀錄上去吧！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "……只屬於我們兩人的，",
    "voice": "vo_adv_4010184_010",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "故事。",
    "voice": null,
    "unit_id": 100931
  }
]
