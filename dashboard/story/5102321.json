[
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "各位，",
    "voice": "vo_adv_5102321_000",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "你們來了啊。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "那麼……",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "雖然這場秀也可以就這樣直接開始，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "不過，我想要來點更有意思的演出。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "你們配合點吧！",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這是……！？",
    "voice": "vo_adv_5102321_001",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n不僅劍在燃燒，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "舞台也被火焰包圍了……！？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "呵呵呵……",
    "voice": "vo_adv_5102321_002",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "因為觀眾們果然",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "會對盛大的表演反應熱烈啊。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "怎麼樣，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "你們喜歡嗎？",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "給我等一下，",
    "voice": "vo_adv_5102321_003",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "直播主不能自己搞炎上吧！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……呃，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "現在好像不是吐槽的時候。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這些火焰",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "可能會很棘手喔……！？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "如果隨便靠近輝美閣下的話，",
    "voice": "vo_adv_5102321_004",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "說不定會被火灼傷的！！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "像這種狀況，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "從後面用魔法之類的攻擊……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呃，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "智閣下！？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我打頭陣！",
    "voice": "vo_adv_5102321_005",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n七七香你們掩護我！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……看來我也阻止不了妳吧。",
    "voice": "vo_adv_5102321_006",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "知道了！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳就盡情攻擊！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我會用魔法掩護妳的！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……我不會魔法，",
    "voice": "vo_adv_5102321_007",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我就先在後面替你們助陣吧。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "智，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "七七香，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "加油～",
    "voice": null,
    "unit_id": 123511
  }
]
