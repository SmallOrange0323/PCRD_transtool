    "type": "dialogue",
    "name": "望",
    "words": "呼、",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呼……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呼～",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "終於找到了……{0}！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "太好了……",
    "voice": "vo_adv_1116003_059",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "到處找來找去",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "都找不到你，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n還想說會不會已經見不到你了呢，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一直很不安呢……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是",
    "voice": "vo_adv_1116003_060",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果是在這裡，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n如果是在我們兩人一起努力活動過的這棵樹下，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n應該就能見到了吧，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我是這麼想的。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真的嗎？　",
    "voice": "vo_adv_1116003_061",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "總、",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "總覺得好像心靈相通了一樣，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n有一點害羞呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不是{0}你的錯喔。",
    "voice": "vo_adv_1116003_062",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "而且",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你看起來也是到處跑來跑去對吧？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "流著汗，",
    "voice": "vo_adv_1116003_063",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "衣服也亂糟糟的。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……謝謝你呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過",
    "voice": "vo_adv_1116003_064",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "在街上到處尋找之後才在樹下重逢甚麼的，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n是不是太剛好了啊？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "老天爺也會做這種老套的事情呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只是，",
    "voice": "vo_adv_1116003_065",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我不討厭這種老套呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n命中註定的浪漫發展，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n正好符合聖誕節啊！　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "望偷偷地獨自",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n心滿意足的笑了。",
    "voice": null,
    "unit_id": null
  },
