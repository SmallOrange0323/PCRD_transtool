[
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "望跟{0}兩人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在聖誕節熱鬧的\\n蘭德索爾街道上散步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你看你看，",
    "voice": "vo_adv_1116003_000",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是玩具店！　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "看到這麼多玩具排在一起，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n就算長大了，還是覺得興奮呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": "vo_adv_1116003_001",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那邊在賣蛋糕呢！　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好像很好吃！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就算只有一次也好，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "想要試試一個人吃掉整個蛋糕呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過絕對會被阻止吧。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "欸、",
    "voice": "vo_adv_1116003_002",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是、",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是這樣嗎？　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "欸嘿嘿……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗚――",
    "voice": "vo_adv_1116003_003",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是不是有點興奮過頭了啊？　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是沒辦法啊。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n因為這可是跟{0}的約會啊。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n不可能冷靜的啊。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是，",
    "voice": "vo_adv_1116003_004",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可以的話想要浪漫地度過，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "得稍微自重一點呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "深呼吸",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "深呼吸。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "總而言之，",
    "voice": "vo_adv_1116003_005",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要不要去喝些熱的東西呢？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你看，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那邊有很多店家呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": "vo_adv_1116003_006",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那邊有咖啡店呢？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "還有很多好像很美味的店呢，讓人眼花撩亂呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊！　",
    "voice": "vo_adv_1116003_007",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你看你看，那個好厲害呢！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好像是有名的甜點店在辦活動呢。",
    "voice": "vo_adv_1116003_008",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n是不是在用表演",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "推銷商品啊。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為是最適合銷售甜點的日子嘛。",
    "voice": "vo_adv_1116003_009",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n好像很有趣呢，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "稍微去看看吧。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": "vo_adv_1116003_010",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個人是一起工作過好幾次的主辦人呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這個舞台是不是也是她策畫的呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要不要去打個招呼呢？",
    "voice": "vo_adv_1116003_011",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "說不定可以拿到甜點呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那家店的甜點很好吃呢♪",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳好！　",
    "voice": "vo_adv_1116003_012",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "久疏問候，好久不見！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "咦？　",
    "voice": "vo_adv_1116003_013",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "小、",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "小望小姐？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "怎麼了，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "為什麼在這裡呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "偶然看到妳所以過來打個招呼……",
    "voice": "vo_adv_1116003_014",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳沒事嗎？　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "臉色看起來不太好呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "嗯，",
    "voice": "vo_adv_1116003_015",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "我沒事……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "不對，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "完全不是沒事呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "那個，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "接下來妳可以上台表演嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……咦？",
    "voice": "vo_adv_1116003_016",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "其實",
    "voice": "vo_adv_1116003_017",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "本來預定今天要在舞台上表演的偶像，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "\\n剛剛說突然生病，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "沒有辦法上台了。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "就算想要找替代的人，",
    "voice": "vo_adv_1116003_018",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "但大家也都正在忙，找不到人……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "活動企劃人員",
    "words": "我知道這是很無理的要求，但是可以拜託妳嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就、",
    "voice": "vo_adv_1116003_019",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就算妳突然這麼說……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "應該",
    "voice": "vo_adv_1116003_020",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有很多粉絲是為了那位偶像而來的吧。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果知道她不能來",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一定會很難過吧？　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "【慈樂之音】是",
    "voice": "vo_adv_1116003_021",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "『為了大家而歌舞而戰的公會』，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這種狀況什麼事都不做的話……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n有能幫忙的事情的話我也想要幫忙。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但是，",
    "voice": "vo_adv_1116003_022",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就算是我很信賴的主辦人，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我也不能沒經過製作人擅自地接下工作。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "而且，",
    "voice": "vo_adv_1116003_023",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這樣的話對花寶貴的時間來陪伴我的",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n{0}也會很抱歉。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……雖然覺得很抱歉，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但這次還是讓我拒絕吧。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？　",
    "voice": "vo_adv_1116003_024",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒、",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒有喔？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這麼突然地被拜託上台，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也不能隨便答應嘛。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "！　",
    "voice": "vo_adv_1116003_025",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……唉，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你的這種地方，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真的很狡猾呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "總會讓人踏上坦率正直的路呢。",
    "voice": "vo_adv_1116003_026",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我這麼煩惱反而像是笨蛋呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
