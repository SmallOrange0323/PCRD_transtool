  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……我不會回頭的。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我是絕對不會回頭的！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我、",
    "voice": "vo_adv_6050204_002",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我我可沒有說自己害怕喔？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果你覺得害怕，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還是一起行動比較好吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "既然難得，就這麼做吧！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "的確也可以這樣想呢。",
    "voice": "vo_adv_6050204_003",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無論怎麼說也得要分辨出來誰是鬼怪才能擊敗啊。",
