  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯！",
    "voice": "vo_adv_5082101_001",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這說不定是藉由特別的年菜，",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "取回妾身真正力量的機會呢。",
