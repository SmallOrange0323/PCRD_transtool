  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "畢竟年菜",
    "voice": "vo_adv_5082101_002",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原本就是東國的文化啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不嫌棄的話，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "讓我來為妳們帶路吧。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不只是【美食殿堂】的大家，",
    "voice": "vo_adv_5082101_003",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "連妳們兩位也一起同行，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n讓人感到特別安心呢。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈～哈哈哈！",
    "voice": "vo_adv_5082101_004",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "儘管仰賴妾身吧！",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "出外靠旅伴，",
    "voice": "vo_adv_5082101_005",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "處世靠人情，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒錯吧。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也讓我們",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "助妳一臂之力吧。",
    "voice": null,
    "unit_id": 120811
  },
