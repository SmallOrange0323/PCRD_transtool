  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}由於反逆獸的計謀而陷入絕境。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然而就在此時，新的希望瀟灑地出現了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "久等囉，",
    "voice": "vo_adv_5078004_000",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "靜、",
    "voice": "vo_adv_5078004_001",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "靜流！？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐感應器有反應所以我全力趕來一看，",
    "voice": "vo_adv_5078004_002",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n果然是弟弟碰上了危機呢……！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "姐姐感應器？",
    "voice": "vo_adv_5078004_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "嘖、",
    "voice": "vo_adv_5078004_004",
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "怎麼又來了個攪局的……！",
    "voice": null,
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不必向我道謝啦。",
    "voice": "vo_adv_5078004_005",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐我身為姐姐，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n只是盡到自己該盡的責任而已。",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "因為弟弟就在這裡，",
    "voice": "vo_adv_5078004_006",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "大概是這樣吧♪",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "話說回來弟弟",
    "voice": "vo_adv_5078004_007",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你還好嗎？",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "怎麼感覺冒出一股黑色的氣息……",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那讓你很難受嗎？",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "放心吧，",
    "voice": "vo_adv_5078004_008",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐現在就為你治療！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……抱緊～！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "緊、",
    "voice": "vo_adv_5078004_009",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "緊緊抱住了……？",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "真熱情的擁抱……！",
    "voice": "vo_adv_5078004_010",
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "不、",
    "voice": "vo_adv_5078004_011",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "不行啦靜流！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n一旦這麼做，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "黑暗力量",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "會對妳……！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "這都是為了弟弟嘛。",
    "voice": "vo_adv_5078004_012",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n不管是黑暗力量還是別的什麼，",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "姐姐都會照單全收。",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "糾纏著他的黑暗力量消失……",
    "voice": "vo_adv_5078004_013",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "換成靜流",
    "voice": "vo_adv_5078004_014",
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "染上黑色了……！？",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "嘰嘰嘰！",
    "voice": "vo_adv_5078004_015",
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "真是傻瓜！",
    "voice": null,
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n居然會自己接受黑暗力量！",
    "voice": null,
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "這麼一來我就有三名僕從──",
    "voice": "vo_adv_5078004_016",
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "嘎啊啊！？",
    "voice": "vo_adv_5078004_017",
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "……",
    "voice": "vo_adv_5078004_018",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "你竟敢讓我的弟弟受苦？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "竟敢這麼對我的弟弟。",
    "voice": "vo_adv_5078004_019",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "只屬於我的弟弟。",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "世上比任何事都還要重要的弟弟。",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "好、",
    "voice": "vo_adv_5078004_020",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "好誇張的氣勢……",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "胸口揪成了一團……",
    "voice": "vo_adv_5078004_021",
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n這感覺，",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "是恐怖～",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "……畢竟靜流她，",
    "voice": "vo_adv_5078004_022",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n無論是慾望或是其他方面",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "原本就一心只想著騎士大人嘛。",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "弟弟請稍等我一下。",
    "voice": "vo_adv_5078004_023",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n讓我可愛的弟弟吃苦的壞孩子，",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "我會親自解決的。",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "就由我這個──",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "──黑暗姐姐！",
    "voice": "vo_adv_5078004_024",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "妳！",
    "voice": "vo_adv_5078004_025",
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n為什麼黑暗力量對妳沒有用！",
    "voice": null,
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "那是因為，",
    "voice": "vo_adv_5078004_026",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "愛啊。",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "全員",
    "words": "愛……？",
    "voice": "vo_adv_5078004_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "沒錯。",
    "voice": "vo_adv_5078004_028",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n在姐姐與弟弟之間的",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "強烈～",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "的",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "愛！",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "這是怎麼回事呢，",
    "voice": "vo_adv_5078004_029",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "明明說的話那麼感人，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "但靜流的黑暗力量卻越來越高漲了……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "這麼說來，",
    "voice": "vo_adv_5078004_030",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "之前靜流受到黑暗力量影響時，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n並沒有出現像伊緒及空花那樣的",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "特殊能力……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n但果然",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "她應該也擁有著……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "很厲害的力量吧……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "欸嘿嘿♪",
    "voice": "vo_adv_5078004_031",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n只要有愛，",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "我就無所不能！",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "就連這種事也……！",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "出來吧！",
    "voice": "vo_adv_5078004_032",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n姐姐與弟弟的",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "愛情結晶！",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "──迷你弟弟！",
    "voice": "vo_adv_5078004_033",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "迷你弟弟",
    "words": "！",
    "voice": "vo_adv_5078004_034",
    "unit_id": 7811
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "真、",
    "voice": "vo_adv_5078004_035",
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "真可愛……！",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "我也想要，",
    "voice": "vo_adv_5078004_036",
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "空花，",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "也想要一個迷你虐待狂先生！",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "嘰嘰嘰嘰嘰！",
    "voice": "vo_adv_5078004_037",
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "那小不點是什麼啊！",
    "voice": null,
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n",
    "voice": null,
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "就憑那種玩意！",
    "voice": null,
    "unit_id": 15311
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "迷你弟弟",
    "words": "？",
    "voice": "vo_adv_5078004_038",
    "unit_id": 7811
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "咦？",
    "voice": "vo_adv_5078004_039",
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "呵呵♪",
    "voice": "vo_adv_5078004_040",
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n它可是姐姐和弟弟的愛情結晶哦？",
    "voice": null,
    "unit_id": 120017
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120017
  },
  {
