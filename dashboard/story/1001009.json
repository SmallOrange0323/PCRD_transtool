  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哇哇哇！　",
    "voice": "vo_adv_1001009_003",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對、",
