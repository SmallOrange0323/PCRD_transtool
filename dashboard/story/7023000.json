  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在入口仰望著露娜之塔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這裡就是露娜之塔啊……",
    "voice": "vo_adv_7023000_000",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "比我想的還大呢。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這裡有找回騎士先生記憶的提示吧。",
