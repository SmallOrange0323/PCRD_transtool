    "words": "だから、",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "家族来てたから？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n合流してわちゃわちゃベントー食べたりとか、",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "そんな。",
    "voice": null,
    "unit_id": 116211
