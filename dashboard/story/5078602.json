    "voice": "vo_adv_5064602_006",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "本当に普通だったのだろうか。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "あー、",
    "voice": "vo_adv_5064602_007",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "そーだ、",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "思い出した。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\nそーいや、",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "なんか{0}も一緒だったかも。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "え、",
    "voice": "vo_adv_5064602_008",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "和やかな一家団欒の日常に、",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\nそんな突発ゲストが飛び入り参加したこと忘れます？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "それを普通と呼ぶのか……",
    "voice": "vo_adv_5064602_009",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "大概だぞクロエ君……",
    "voice": null,
    "unit_id": 116411
  }
