  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ミィコさんたちと、",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "わちゃわちゃランチしましたけど。",
