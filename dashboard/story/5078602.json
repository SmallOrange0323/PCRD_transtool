    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ロゼッタの膝を枕にわちゃわちゃ仮眠していたな。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "で、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "クロエ君は誰とわちゃわちゃしていたのだね？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "うちは、",
    "voice": "vo_adv_5064602_004",
    "unit_id": 116211
