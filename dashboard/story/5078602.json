    "type": "dialogue",
    "name": "チエル",
    "words": "普通っていうわり、",
    "voice": "vo_adv_5064602_005",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "随分と言い淀みましたね。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "ユニ",
