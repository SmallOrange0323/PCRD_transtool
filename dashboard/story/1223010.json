    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "而且……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "而且那個人，",
    "voice": "vo_adv_1223010_097",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "和班比有點像嘛。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n失去歸宿的部分，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "還有……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n受到重要的人",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "幫助的部分。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "所以，",
    "voice": "vo_adv_1223010_098",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "總覺得沒辦法丟下她不管……",
