[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "班比經歷人生第一次的勞動，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "獲得了酬勞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "現在卻為這筆錢的用處傷透腦筋。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯～",
    "voice": "vo_adv_1223010_000",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這筆錢要用來做什麼呢……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比已經買了水果給貝斯，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "但是還剩下好多。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從，",
    "voice": "vo_adv_1223010_001",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你想要錢對不對？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那班比的錢，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "全都給你！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真是的～",
    "voice": "vo_adv_1223010_002",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "明明不必跟班比客氣的。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n伊莉亞",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "也跟班比說不需要「房租」……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "錢要怎麼使用，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好困難哦。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊，",
    "voice": "vo_adv_1223010_003",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "對了！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比的家！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n雖然那裡已經",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "變成了「遺址」，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n不過那裡還是",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比的家呢。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "所以班比來把那裡整理乾淨，",
    "voice": "vo_adv_1223010_004",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "變成別墅如何？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚！",
    "voice": "vo_adv_1223010_005",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "對吧～！",
    "voice": "vo_adv_1223010_006",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "順利蓋好的話，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就招待伊莉亞來玩吧。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "她一定會嚇一跳的。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比有一陣子沒去了，",
    "voice": "vo_adv_1223010_007",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "先去看看班比的家吧！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "background",
    "bg_id": "500530"
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這是怎麼回事～！？",
    "voice": "vo_adv_1223010_008",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比的家",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "到處都是垃圾！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀噗……",
    "voice": "vo_adv_1223010_009",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是誰做了這麼過分的事！",
    "voice": "vo_adv_1223010_010",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比現在非常生氣耶！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂喂，",
    "voice": "vo_adv_1223010_011",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "有隻可愛的老鼠不小心闖進來了啊？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真可憐啊，",
    "voice": "vo_adv_1223010_012",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "要回不了家囉？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "因為這裡，",
    "voice": "vo_adv_1223010_013",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是可怕的龍穴啊！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哇哈哈哈哈哈！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……你們幾個，",
    "voice": "vo_adv_1223010_014",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是誰？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "喂喂，",
    "voice": "vo_adv_1223010_015",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "她好像什麼都不知道就闖進來了。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "雷龍",
    "words": "那麼我來告訴妳吧！",
    "voice": "vo_adv_1223010_016",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "雷龍",
    "words": "我們是",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "雷龍",
    "words": "會讓哭泣的小孩哭得更大聲的恐怖化身！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "人稱大盜賊",
    "voice": "vo_adv_1223010_017",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "「魔龍兄弟」，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "指的就是我們！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "該不會……",
    "voice": "vo_adv_1223010_018",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n這些垃圾，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是你們丟的？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "……",
    "voice": "vo_adv_1223010_019",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "這些小鬼是怎麼回事，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "居然完全不怕我們。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "是",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "啊沒錯！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "這裡是我們的地盤，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "我們愛怎麼丟，就怎麼丟！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "才不是呢，",
    "voice": "vo_adv_1223010_020",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這裡是班比的家。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n壞孩子現在馬上離開啦。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "喔～喔～",
    "voice": "vo_adv_1223010_021",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "妳很勇敢嘛。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "喂，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "小兄弟你也勸勸她啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "\\n如果太過調皮搗蛋，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "會吃苦頭喔？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "唉，",
    "voice": "vo_adv_1223010_022",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "怎麼一個個都是笨小鬼啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "沒辦法了，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "講不聽的小孩",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "就用這個懲罰你們！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "出、",
    "voice": "vo_adv_1223010_023",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "出現了！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "超龍大哥的斬鐵岩斧！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "\\n看到它的人沒有人能活著回去！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿。",
    "voice": "vo_adv_1223010_024",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "啊哼！",
    "voice": "vo_adv_1223010_025",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "雷龍",
    "words": "等等，",
    "voice": "vo_adv_1223010_026",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "雷龍",
    "words": "超龍大哥一招就倒地了！？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "雷龍",
    "words": "不過大哥是我們兄弟之中最弱的！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "雷龍",
    "words": "\\n聯合技才是我們的真本事！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "雷龍",
    "words": "要上了，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "雷龍",
    "words": "炎龍！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "好啊雷龍！",
    "voice": "vo_adv_1223010_027",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "接招吧！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "「雙龍連擊」！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿，",
    "voice": "vo_adv_1223010_028",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "呀嗯！",
    "voice": "vo_adv_1223010_029",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "雷龍",
    "words": "嗚嗯！",
    "voice": "vo_adv_1223010_030",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "好痛！",
    "voice": "vo_adv_1223010_031",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "好痛啊──！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "欸，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "被削掉了嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "超龍",
    "words": "\\n我臉頰的肉肉被削掉了嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "別、",
    "voice": "vo_adv_1223010_032",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "別擔心，大哥，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "炎龍",
    "words": "你胖嘟嘟的臉頰肉肉還在！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "雷龍",
    "words": "馬上用冰涼的水水幫你冰敷哦！",
    "voice": "vo_adv_1223010_033",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真是的～",
    "voice": "vo_adv_1223010_034",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "太誇張了啦。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n與其說是龍，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你們幾個",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "更像蠑螈吧。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "話說回來，",
    "voice": "vo_adv_1223010_035",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "現在你們知道這裡是班比的家了嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n知道的話",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就快點回去自己的家！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "魔龍兄弟",
    "words": "是、",
    "voice": "vo_adv_1223010_036",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔龍兄弟",
    "words": "是的────！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔龍兄弟",
    "words": "對不起──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊，",
    "voice": "vo_adv_1223010_037",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "打掃乾淨再回……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "走掉了。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真～是一群讓人困擾的叔叔。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "唉。",
    "voice": "vo_adv_1223010_038",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "今天先打掃完就回去吧。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是幾天後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "班比他們再次造訪城堡的遺址。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀噗……",
    "voice": "vo_adv_1223010_039",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀噗！",
    "voice": null,
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯，",
    "voice": "vo_adv_1223010_040",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "叔叔不在，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "地上也沒有垃圾，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "看起來已經沒問題了呢～",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "輕鬆配送極致恐怖體驗！",
    "voice": "vo_adv_1223010_041",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "小特爾的",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "怪奇外送！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "今天要帶大家看的是",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "這裡！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "大家知道這是什麼地方嗎？",
    "voice": "vo_adv_1223010_042",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "\\n這次我來到",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "可怕到沒有人敢靠近的最恐怖景點，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "「吸血城跡」！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "據說這裡",
    "voice": "vo_adv_1223010_043",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "曾有著傳說吸血鬼的城堡，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "是血跡斑斑的土地！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "被吸血鬼親手葬送的犧牲者在這裡陰魂不散，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "這麼危險的地方！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "哎呀～",
    "voice": "vo_adv_1223010_044",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "這裡真的很不妙耶？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "告訴你們啊，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "這裡陰氣超重的。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "\\n我從剛才就一直起雞皮疙瘩……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "就連現在也是，",
    "voice": "vo_adv_1223010_045",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "血腥味乘著不冷不熱的風竄進鼻腔，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "\\n怨靈們的叫聲在耳邊──",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "等等，那邊的人！",
    "voice": "vo_adv_1223010_046",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "唔哇啊！",
    "voice": "vo_adv_1223010_047",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "嚇、",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "嚇我一跳……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "幹嘛突然大叫啊！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "我正在拍影片耶，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "要是魔法相機摔在地上妳要怎麼賠我！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比不懂什麼影片啦！",
    "voice": "vo_adv_1223010_048",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n聽好囉？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這裡是班比的家！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不要隨便進來！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "家？",
    "voice": "vo_adv_1223010_049",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "這塊空地？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "哈？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "妳是吸血鬼還是什麼？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "對啊！",
    "voice": "vo_adv_1223010_050",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比是",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "最強的吸血鬼！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "唉……",
    "voice": "vo_adv_1223010_051",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "居然被腦袋有問題的小鬼纏上，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "我真倒楣。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "乾脆拍她好了……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "不對，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "這種小鬼沒有流量吧。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "唔──！",
    "voice": "vo_adv_1223010_052",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n你這個人",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "很沒禮貌耶！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n總之",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不要在班比的家",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "做奇怪的事！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "誰理妳啊。",
    "voice": "vo_adv_1223010_053",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "我跟妳說，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "還沒有直播主拍過這裡的影片，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "我是第一個。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "\\n這是賺流量和訂閱人數的絕佳機會，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "我怎麼可能放過。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "是說，",
    "voice": "vo_adv_1223010_054",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "你是她的監護人吧？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "\\n別放任她亂來，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "好好看著──",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀噗──！",
    "voice": "vo_adv_1223010_055",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀噗呀噗呀噗……",
    "voice": null,
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "嗚哇！",
    "voice": "vo_adv_1223010_056",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "怎麼會有這麼大隻的蜥蜴！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "啊，喂，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "不要咬器材！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "知不知道這要多少錢啊！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "噫噫噫──！",
    "voice": "vo_adv_1223010_057",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "器材被口水弄得黏答答的──！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "\\n混帳，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "我受不了了──！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "這傢伙最好被詛咒啦，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小特爾",
    "words": "笨蛋笨蛋──！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯，",
    "voice": "vo_adv_1223010_058",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "謝謝～",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "希望這樣就不會有人再來了……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是又過了幾天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "生氣～！",
    "voice": "vo_adv_1223010_059",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這次變成有好多魔物在這裡～！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚嗚……",
    "voice": "vo_adv_1223010_060",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真是──討厭！",
    "voice": "vo_adv_1223010_061",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "為什麼大家都要擅自闖進班比的家啦！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "過了幾天後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚……",
    "voice": "vo_adv_1223010_062",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚。",
    "voice": null,
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "唉，",
    "voice": "vo_adv_1223010_063",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "太好了。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n這樣終於可以準備來建別墅……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀噗？",
    "voice": "vo_adv_1223010_064",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……吶～",
    "voice": "vo_adv_1223010_065",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "有人在那裡對吧？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "都看穿了哦！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……被發現了嗎？",
    "voice": "vo_adv_1223010_066",
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不愧是真祖大人。",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不好意思，",
    "voice": "vo_adv_1223010_067",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我們擅自使用這裡……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你們也是盜賊",
    "voice": "vo_adv_1223010_068",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "或是來拍影片的人嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……奇怪，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "可是",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比有說",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比是",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真祖嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呵呵，",
    "voice": "vo_adv_1223010_069",
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "只要是同胞，",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我想任何人都會察覺到喔。",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n因為吸血鬼十分罕見，",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "其中",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真祖大人的魔力更是不同凡響啊。",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "是的，",
    "voice": "vo_adv_1223010_070",
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "我是吸血鬼，",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "和他一起",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "漫無目的地在各地漂泊，",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "\\n最後流浪到真祖大人的土地。",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "她原先在我的家鄉和我一起靜靜地生活，",
    "voice": "vo_adv_1223010_071",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n從未攻擊過人類，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "和居民們也相處得很好。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "可是，",
    "voice": "vo_adv_1223010_072",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "當她被發現是吸血鬼後，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "村民就把她趕出了村莊……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "怎麼這樣？",
    "voice": "vo_adv_1223010_073",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好過分～！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "沒辦法。",
    "voice": "vo_adv_1223010_074",
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "吸血鬼自古",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "便是人們畏懼的對象。",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "他為了我拋棄家鄉，",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "選擇與我攜手前行。",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "跟著所愛的人走是理所當然啊。",
    "voice": "vo_adv_1223010_075",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "即使世界各地都沒有我們的歸宿，我也會這麼做。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚……",
    "voice": "vo_adv_1223010_076",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "就在此時，",
    "voice": "vo_adv_1223010_077",
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "我們聽說了真祖大人城堡遺址一事。",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "\\n我們心想",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "若是這裡，",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "\\n一般人類不會靠近，",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "正適合隱居。",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "沒有這回事喔？",
    "voice": "vo_adv_1223010_078",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這裡有奇怪的叔叔",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "還有魔物，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "很多人闖進來呢。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "是的，",
    "voice": "vo_adv_1223010_079",
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "實際上",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "像是出於好奇過來的人類，",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "\\n或是被真祖大人的魔力吸引而來的魔物，",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "我們",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "都遇到過好幾次。",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "先不提魔物，",
    "voice": "vo_adv_1223010_080",
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "我很驚訝",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "有不少人",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "會特地來到",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "傳聞中可怕駭人",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "的地方……",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不過，",
    "voice": "vo_adv_1223010_081",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "也因為是這種地方，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "只要確實嚇嚇他們，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "很容易就能趕走，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "弱小的魔物",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "也不是她的對手呢。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "但是，",
    "voice": "vo_adv_1223010_082",
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "如今統治這片土地的真祖大人歸來，",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "\\n我們就無法繼續待在這裡了。",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "擅自占用真祖大人土地之過，",
    "voice": "vo_adv_1223010_083",
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "我會以此身贖罪。",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "等、",
    "voice": "vo_adv_1223010_084",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "等一下。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "要問罪的話針對我這個人類就行了吧？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "她和妳同樣是吸血鬼，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "拜託妳",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "饒她一命！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯──",
    "voice": "vo_adv_1223010_085",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "其實你們不必道歉，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "也不必離開哦？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "咦？",
    "voice": "vo_adv_1223010_086",
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "可、",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "可是……",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "因為你們",
    "voice": "vo_adv_1223010_087",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "沒有亂丟垃圾，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n也幫班比趕走了",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "奇怪的叔叔們對吧？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "而且班比，",
    "voice": "vo_adv_1223010_088",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n現在住在伊莉亞那裡嘛～",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n如果你們想待在這裡",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "也可以喔。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "這、",
    "voice": "vo_adv_1223010_089",
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "這多麼讓人惶恐……",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "可是……",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不愧是僕從！",
    "voice": "vo_adv_1223010_090",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那麼～",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你們可以待在這裡，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n交換條件是",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "要照顧好班比的家，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "拜託你們囉！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這件事就當成是租金了！",
    "voice": "vo_adv_1223010_091",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "……真祖大人寬宏大量，",
    "voice": "vo_adv_1223010_092",
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "實在感激不盡。",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "我們就聽大人的，",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "會擔負管理這片土地的職責。",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "我們一定",
    "voice": "vo_adv_1223010_093",
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "不辜負真祖大人的期待──",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯～",
    "voice": "vo_adv_1223010_094",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那個",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "「真祖大人」的叫法",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "有點討厭。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "有班比",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這個名字，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n叫班比的名字吧。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "……我明白了。",
    "voice": "vo_adv_1223010_095",
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "那麼",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "班比大人，",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "\\n今後",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "女吸血鬼",
    "words": "還請您多加關照了。",
    "voice": null,
    "unit_id": 51412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哼哼～",
    "voice": "vo_adv_1223010_096",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "做這點小事是當然的啦。",
