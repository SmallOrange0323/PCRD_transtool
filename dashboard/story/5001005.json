[
  {
    "type": "background",
    "bg_id": "500330"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一行人為了追擊從圖鑑裡冒出來的魔物，\\n來到了伊麗莎白牧場附近的村子裡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……呼嚕……呼嚕……",
    "voice": "vo_adv_5001005_000",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對不起哦{0}。",
    "voice": "vo_adv_5001005_001",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n讓你背著姊姊……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我想魔物逃往的地方，恐怕就是在這一帶了……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好奇怪……每戶家的門窗都是關上的，感覺不到人的氣息。",
    "voice": "vo_adv_5001005_002",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n明明村子平時都是那麼熱鬧的……難道，魔物把村民們都……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "喂、喂，是誰在那裡嗎？",
    "voice": "vo_adv_5001005_003",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "有聲音？從家裡傳來的？",
    "voice": "vo_adv_5001005_004",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那個，我們不是什麼可疑的人，能向你詢問一點事情嗎？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哦哦……",
    "voice": "vo_adv_5001005_005",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "記得妳是，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "在【伊莉莎白牧場】的……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的……",
    "voice": "vo_adv_5001005_006",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "請問到底發生什麼事了？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這裡現在莫名的安靜，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "其他人呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "村裡的大伙們都在家裡躲起來了……，",
    "voice": "vo_adv_5001005_007",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n這裡明明有驅除魔物的結界在，居然會有魔物出現……真是麻煩大了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "魔物無法被有效驅除……恐怕就是圖鑑裡的魔物了。",
    "voice": "vo_adv_5001005_008",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "況且它們又是異常的存在……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "沒錯……導致村民極度不安的主要原因，",
    "voice": "vo_adv_5001005_009",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n就是我……我必須負起責任才行。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "當然……是我不小心解除的封印……",
    "voice": "vo_adv_5001005_010",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "自己鬧出來的事情必須由自己來收拾才行。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "{0}，拜託你了，",
    "voice": "vo_adv_5001005_011",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "再幫幫我們。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你們還是趕緊逃跑比較好吧……不知道那些怪物什麼時候又會回來了……",
    "voice": "vo_adv_5001005_012",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "請你快回家避難吧。",
    "voice": "vo_adv_5001005_013",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "魔物就由我們來想辦法應付了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不、不會吧……你、你們還是別太亂來吧？",
    "voice": "vo_adv_5001005_014",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……到底是為什麼……魔物就在這裡，但也未免太安靜了……",
    "voice": "vo_adv_5001005_015",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "一點氣息和聲音都沒有……",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就連我的……獸人族感官也察覺不出氣息……",
    "voice": "vo_adv_5001005_016",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "要是現在被偷襲的話，",
    "voice": "vo_adv_5001005_017",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "肯定會被幹掉的……",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "得想個辦法，",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "至少也要保護好姊姊和{0}才行。",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "會從哪裡過來呢？　",
    "voice": "vo_adv_5001005_018",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "會從哪裡……",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕……",
    "voice": "vo_adv_5001005_019",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊！",
    "voice": "vo_adv_5001005_020",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n小栞，上面！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "上面！？呃！",
    "voice": "vo_adv_5001005_021",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "──咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是因為躲在屋頂上所以隱藏掉氣息了嗎……",
    "voice": "vo_adv_5001005_022",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "要是姊姊沒提醒我的話，現在可就……",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "耶嘿嘿ー、",
    "voice": "vo_adv_5001005_023",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "因為是小栞的危機呀！　",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "當然會醒來！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊，謝謝妳了。",
    "voice": "vo_adv_5001005_024",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "先把書籤綁在箭矢上……我要上了！",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "──咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好、",
    "voice": "vo_adv_5001005_025",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好快！　",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這樣我沒辦法好好瞄準！",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊、{0}！　",
    "voice": "vo_adv_5001005_026",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "快躲到建築物的陰影處去！",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n待在這裡我們都會被幹掉的！",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊！小栞！",
    "voice": "vo_adv_5001005_027",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "魔物……還在屋頂上面嗎？",
    "voice": "vo_adv_5001005_028",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "(那隻魔物，會透過與我的視線和身體來判讀我的動作……",
    "voice": "vo_adv_5001005_029",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "再加上這個壓迫感……一旦鬆懈下來馬上就會沒命的――！)",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這樣啊……所以它能夠判讀小栞的動作……",
    "voice": "vo_adv_5001005_030",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯，我知道小栞想的是什麼了。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那一隻魔物大概是眼睛和耳朵都很敏銳呢！",
    "voice": "vo_adv_5001005_031",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "該怎麼辦！這樣下去小栞可能會被擊倒的！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是那個魔物對魔法免疫啊……",
    "voice": "vo_adv_5001005_032",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯嗯……這樣啊！真不愧是你！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n這個作戰可以救到小栞！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好！在你背上睡了一覺，",
    "voice": "vo_adv_5001005_033",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n精神也飽滿了！該加油了！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呵呵呵！剛才你看到了吧？",
    "voice": "vo_adv_5001005_034",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我和小栞是不需要言語溝通的！閃亮亮☆",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那我們就上了喔？初音的全力！",
    "voice": "vo_adv_5001005_035",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "（這樣下去持續消耗集中力，",
    "voice": "vo_adv_5001005_036",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n只會變得疲勞而中了它的計……該怎麼做才好――）",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞！把眼睛閉上！",
    "voice": "vo_adv_5001005_037",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊……啊！",
    "voice": "vo_adv_5001005_038",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "──咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "（是姊姊的魔法！原來如此，這樣就能將魔物的耳目給封住了！）",
    "voice": "vo_adv_5001005_039",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "（雖然攻擊無效，但這樣它就無法判讀小栞的動作了！",
    "voice": "vo_adv_5001005_040",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞！魔物要衝過來了哦！）",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "──咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這是姊姊為我創造出來的大好時機，絕不能浪費掉……！",
    "voice": "vo_adv_5001005_041",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "──嘰哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "太好了──！封印成功了！",
    "voice": "vo_adv_5001005_042",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "唔……這都是姊姊的功勞……",
    "voice": "vo_adv_5001005_043",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我感覺能聽見姊姊的聲音……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "欸嘿嘿，我們的羈絆是最強的！",
    "voice": "vo_adv_5001005_044",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "儘管如此還真是一隻厲害的魔物呢。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我來看看圖鑑裡寫了些什麼……",
    "voice": "vo_adv_5001005_045",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "欸……擁有優秀的視覺、聽覺和嗅覺……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "鼻子也很靈呢……還、還真是有驚無險呢！啊哈哈哈……！",
    "voice": "vo_adv_5001005_046",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這樣一來只剩下最後一隻魔物……就是姊姊看到的席茲而已了……",
    "voice": "vo_adv_5001005_047",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "到了最後我們也不能大意――",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "席茲",
    "words": "──咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 10111
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊！　",
    "voice": "vo_adv_5001005_048",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "席茲！　",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那眼神……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "它的目標是圖鑑……！",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞、{0}，",
    "voice": "vo_adv_5001005_049",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒事吧！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯。",
    "voice": "vo_adv_5001005_050",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "{0}也沒事……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不過，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這樣戰鬥下去的話會波及到村子的……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我們把席茲引誘到村外的地方再戰吧！",
    "voice": "vo_adv_5001005_051",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "走了哦，兩位！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "席茲怒吼著逼近三人。\\n為了讓村子的傷害能夠降到最低，\\n{0}一行人離開了村子。",
    "voice": null,
    "unit_id": null
  }
