    "words": "喝啊啊──！！",
    "voice": "vo_adv_5204322_000",
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……唔！？",
    "voice": "vo_adv_5204322_001",
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n奇怪，",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "沒有用啊！？",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "等等，",
    "voice": "vo_adv_5204322_002",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n針筒的液體",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是不是變了……！？",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "那、",
    "voice": "vo_adv_5204322_003",
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "那個是",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "「雙刃之劍的祕藥」……！",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "哇──",
    "voice": "vo_adv_5204322_004",
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "好帥的名字！",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽也想喝──！",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不，",
    "voice": "vo_adv_5204322_005",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "給我住手。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n光從名字來看就很不妙吧……！",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "正是如此啊。",
    "voice": "vo_adv_5204322_006",
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n那是變得越強大，",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "就也越傷害自身的",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "高風險祕藥……！",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "原來如此，",
    "voice": "vo_adv_5204322_007",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "換言之，",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "接下來就是",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "耐力比賽了。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n……",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "也就是說",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "輪到我出場了啊，",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "真麻煩。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "不，",
    "voice": "vo_adv_5204322_008",
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "苑是我們之中最弱的吧……！",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "退到後面來啦！",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嗯，",
    "voice": "vo_adv_5204322_009",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我的防禦確實跟紙一樣弱，",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "但忍耐力我可是不會輸的喔。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……跟像妳們這樣的脫韁野馬兩人的生活，",
    "voice": "vo_adv_5204322_010",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n能夠忍受的也就只有我了吧？",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……苑。",
    "voice": "vo_adv_5204322_011",
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "啊哈哈哈，",
    "voice": "vo_adv_5204322_012",
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "露易被說是脫韁野馬～♪",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "彩羽也是啦！",
    "voice": "vo_adv_5204322_013",
    "unit_id": 132311
  }
]
