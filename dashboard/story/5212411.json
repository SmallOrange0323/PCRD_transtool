  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "過了今天，東國旅行就結束了呢。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "居然已經到最後一天……",
    "voice": "vo_adv_5212411_001",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "難得做好的和服，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "還想再多穿一下啊……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那身和服是",
    "voice": "vo_adv_5212411_002",
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "璃乃自己做的嗎？",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這麼精緻，",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "做起來應該很費工吧？",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那當然！",
    "voice": "vo_adv_5212411_003",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "能夠有機會像這樣展示給大家看真是太好了。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……而且也讓哥哥看過了……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嘿嘿。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那麼，",
    "voice": "vo_adv_5212411_004",
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "可以說是",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒有什麼遺憾了，",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "對嗎？",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……這個走向，",
    "voice": "vo_adv_5212411_005",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "難道是想說有關工作的事？",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "答對了！",
    "voice": "vo_adv_5212411_006",
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n下個任務，",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "差不多可以拜託妳們了嗎？",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦，",
    "voice": "vo_adv_5212411_007",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "已經有任務了！？",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "太快了吧！？",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "果然福利待遇總是會伴隨著勞動啊……",
    "voice": "vo_adv_5212411_008",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "唉。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "好嘛好嘛。",
    "voice": "vo_adv_5212411_009",
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這次少年也會一起來幫忙喔。",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那樣的話情況就不同了！",
    "voice": "vo_adv_5212411_010",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "有弟弟在的話，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我就能多努力一下哦♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n得讓弟弟充～分見識到",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐帥氣的英姿♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我也是，",
    "voice": "vo_adv_5212411_011",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥也一起的話，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "非常歡迎！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n不管是怎樣的任務我都會努力完成的！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "呵呵，",
    "voice": "vo_adv_5212411_012",
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳們兩個還真現實啊……",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不過這倒挺符合妳們的風格的。",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "所以說，少年。",
    "voice": "vo_adv_5212411_013",
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n有個工作想拜託你啊。",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n來自公會【拉比林斯】的委託……",
    "voice": null,
    "unit_id": 106818
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你願意接下嗎？",
    "voice": null,
    "unit_id": 106818
  }
