[
  {
    "type": "background",
    "bg_id": "500341"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "【王宮騎士團】的諸位！\\n我現在很無聊，",
    "voice": "vo_adv_1071001_000",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "說點有趣的事來聽吧！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "能讓我感到愉悅的人我就褒獎他！",
    "voice": "vo_adv_1071001_001",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但若讓我感到無趣就得懲罰！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "砍飛腦袋噴出血柱的話，",
    "voice": "vo_adv_1071001_002",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "正好可以保養雙眼呢！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈哈哈哈……☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "……又開始了，",
    "voice": "vo_adv_1071001_003",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "副團長又開始任性了。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "……那個人明明也不年輕了，",
    "voice": "vo_adv_1071001_004",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "\\n為什麼每隔一段時間就會像個講不聽的孩子啊？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯嗯～？　",
    "voice": "vo_adv_1071001_005",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你們說什麼？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我聽得不是很清楚啊～？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n一板一眼的【王宮騎士團】，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n也難得知道什麼笑話嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "既然如此，那就大聲說出來聽聽！",
    "voice": "vo_adv_1071001_006",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n快點說，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我可沒什麼耐性！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "不……",
    "voice": "vo_adv_1071001_007",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "\\n什、",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "什麼事都沒有，副團長。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "明明離她挺遠的，為什麼還聽得到？",
    "voice": "vo_adv_1071001_008",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "耳朵真是太靈了……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "\\n上帝保佑上帝保佑，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "\\n那位大人如果在附近的話，就注意別太多嘴吧。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哎呀。",
    "voice": "vo_adv_1071001_009",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你們幾個，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "為什麼聚集在那種地方？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n難道有什麼有趣的東西嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n讓我看看，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼～嗯……？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "哇！",
    "voice": "vo_adv_1071001_010",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "請注意腳下！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "\\n這裡是祕密結社【拉比林斯】那群傢伙的基地，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "\\n所以地面並沒有怎麼整修過！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "嗯！",
    "voice": "vo_adv_1071001_011",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "\\n萬一，副團長跌倒傷到您寶貴的肌膚就不好了！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "……呃唔！？",
    "voice": "vo_adv_1071001_012",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "\\n請、請問為何要踢我，副團長？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我不喜歡顯而易見的客套話。",
    "voice": "vo_adv_1071001_013",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "再說，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "難道你們認為我會踢到地板跌倒嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "到底該怎麼辦才好啊……",
    "voice": "vo_adv_1071001_014",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "\\n太、",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "太難應付了。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "唔唔。",
    "voice": "vo_adv_1071001_015",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "\\n不愧是在【王宮騎士團】裡也出了名的問題人物。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼嗯……",
    "voice": "vo_adv_1071001_016",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "什～麼嘛，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這裡也空蕩蕩的什麼都沒有啊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真無趣。",
    "voice": "vo_adv_1071001_017",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "本想說能打發時間就好了，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n才接下那什麼【拉比林斯】的掃蕩作戰……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但那群傢伙，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "似乎很擅長躲躲藏藏的呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "到處留下假的、",
    "voice": "vo_adv_1071001_018",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n空蕩蕩的基地，也不知道成員到底躲到哪去了",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這樣的基地，",
    "voice": "vo_adv_1071001_019",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就算只建一座應該也需要龐大的資金與勞力才對。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但居然會用完就丟……",
    "voice": "vo_adv_1071001_020",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "到底是何方神聖？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "身分不明反而更有趣呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……哎呀？",
    "voice": "vo_adv_1071001_021",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "怎麼，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "似乎有人被綁起來丟在地上呢？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "唉……",
    "voice": "vo_adv_1071001_022",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "這傢伙，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "\\n不曉得為何在這座【拉比林斯】的基地附近徘迴。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "在這種深山裡……",
    "voice": "vo_adv_1071001_023",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "而且問他話也說不出什麼重點，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "\\n因此我們猜想他可能是【拉比林斯】的同夥，\\n就逮捕他並且綁起來了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喔～喔～",
    "voice": "vo_adv_1071001_024",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n做得很好，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只要審問這傢伙，就能好好打發時間了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂，我說你……",
    "voice": "vo_adv_1071001_025",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還有意識嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "稍微和我聊聊天吧♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "呵呵～",
    "voice": "vo_adv_1071001_026",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "意外挺老實的嘛……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "在這種狀況下，還能不膽怯地直視我的眼睛做出回覆，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n看來你挺有膽量的啊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……嗯。",
    "voice": "vo_adv_1071001_027",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n什～麼嘛，死了啊，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真無趣。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂。",
    "voice": "vo_adv_1071001_028",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "部下們，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "把這傢伙丟到山谷下。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "對野獸來說是不錯的飼料吧，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這就是愛護動物的精神♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……哦，出聲了啊。",
    "voice": "vo_adv_1071001_029",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你的生殺大權現在掌握在我手裡，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n最好別壞了我的心情，乖乖聽話比較好唷？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "總之。",
    "voice": "vo_adv_1071001_030",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我說你，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是哪來的什麼人？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n在這種深山裡做什麼？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……嗯？",
    "voice": "vo_adv_1071001_031",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "慢著，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我見過你這張臉。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你……",
    "voice": "vo_adv_1071001_032",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "該不會……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n是叫做{0}吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不曉得為何「陛下」對你很執著呢，",
    "voice": "vo_adv_1071001_033",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n在不久前，還到處打探收集你的情報喔。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "越來越感興趣了。",
    "voice": "vo_adv_1071001_034",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "對他人絲毫不抱有任何興趣的「陛下」，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n竟然會指定要到處追查你……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你到底是什麼人？",
    "voice": "vo_adv_1071001_035",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n在回答之前，我可不會放你回去。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "讓我們來好～好聊聊吧，{0}♪",
