  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "只要不會多耗費你的時間的話，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我想請你幫我帶幾本無論如何我都想要買到的書。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "當然，我會付書錢給你的。",
    "voice": "vo_adv_1038005_036",
