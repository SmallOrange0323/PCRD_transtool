  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是出於同情嗎？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你覺得我是一個可憐的女孩嗎……？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……你好像不是這麼想的。",
    "voice": "vo_adv_1038005_033",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我看你的眼神就知道了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你真的是一個",
    "voice": "vo_adv_1038005_034",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n平常就很溫柔的人呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對不起，我懷疑你了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那麼我就接受你的好意……",
    "voice": "vo_adv_1038005_035",
