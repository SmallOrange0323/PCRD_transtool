[
  {
    "type": "background",
    "bg_id": "500404"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位～。",
    "voice": "vo_adv_4003006_000",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n因為時間的關係我們就依照這份在遺跡中得到的食譜，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n製作些簡單的料理吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然材料方面不算充足，",
    "voice": "vo_adv_4003006_001",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n不可能完全依照食譜啦。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "在這個遺跡，好像也沒什麼生物呢。",
    "voice": "vo_adv_4003006_002",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n雖說會出些『闇影』就是了～……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯，但只要能吃到好吃的東西我就沒有怨言了",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呵呵，我這次也沒意見囉！",
    "voice": "vo_adv_4003006_003",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為我發現了『斷崖遺跡』裡面有搬不完的金銀財寶呢！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就算遇到生死關頭，只要有你們相陪就好了。",
    "voice": "vo_adv_4003006_004",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n只要賣掉得到的寶物還可以成為小富婆呢，可以買之前一直想要的書跟小玩意之類的東西♪",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯但是遺跡都是受國家管理的，如果要把寶物全部據為己有的話，會有些法律的問題。",
    "voice": "vo_adv_4003006_005",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不過只是稍微拿走一些的話應該是不要緊的。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊哈哈。",
    "voice": "vo_adv_4003006_006",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "參考的食譜，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n是用古代文字寫的，所以解讀上要花點時間。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_4003006_007",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這次也沒遇到什麼問題就調理好了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n味道究竟如何呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "很好吃呦！",
    "voice": "vo_adv_4003006_008",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n但肚子餓的時候什麼都好吃就是了！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔嗯。",
    "voice": "vo_adv_4003006_009",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳隨時隨地都是這句『什麼都好吃』嘛？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對！",
    "voice": "vo_adv_4003006_010",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n只要大家在一起，就是隨時隨地『什麼都好吃』的～☆",
    "voice": null,
    "unit_id": 105812
  }
]
