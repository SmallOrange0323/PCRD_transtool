    "voice": null,
    "unit_id": 191713
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "──啊啊！！",
    "voice": "vo_adv_2114007_010",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "果、",
    "voice": "vo_adv_2114007_011",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "果然……",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "很強……！",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n沒錯，",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我知道的……",
    "voice": null,
    "unit_id": 106416
  },
