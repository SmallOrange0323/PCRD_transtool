    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "嘎啊！",
    "voice": "vo_adv_2114007_009",
    "unit_id": 191713
  },
  {
    "type": "dialogue",
    "name": "贊恩",
