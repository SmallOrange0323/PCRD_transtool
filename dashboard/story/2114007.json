    "type": "dialogue",
    "name": "雪菲",
    "words": "嗯……？",
    "voice": "vo_adv_2114007_013",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……就算說",
    "voice": "vo_adv_2114007_014",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我的力量有所提升了，",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n但是這也太奇怪了……",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "之前──",
    "voice": "vo_adv_2114007_015",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "和哥哥在【憤怒‧軍團】據點的島嶼戰鬥時，",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n【美食殿堂】和【破曉之星】的大家",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "都變成了公主型態，",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n才勉勉強強地打倒他……",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……我",
    "voice": "vo_adv_2114007_016",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "有變得那麼強嗎？",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不對，",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n再怎麼說，",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "也不可能變得那麼強。",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這樣的話……",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……是現在的哥哥",
    "voice": "vo_adv_2114007_017",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不像之前",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那麼強嗎？",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n雖然我怎麼想都覺得",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "他不可能會放水……",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "唔啊！！",
    "voice": "vo_adv_2114007_018",
    "unit_id": 191713
  },
  {
    "type": "still",
    "still_id": "211400701"
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "唔！",
    "voice": "vo_adv_2114007_019",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "果然",
    "voice": "vo_adv_2114007_020",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "可以避開。",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n如果專注於防守的話……",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……原來是這樣啊！",
    "voice": "vo_adv_2114007_021",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "因為被彌勒操控……",
    "voice": "vo_adv_2114007_022",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "被奪去了理智，",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n所以哥哥使不出",
    "voice": null,
    "unit_id": 106416
  },
  {
