  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這個",
    "voice": "vo_adv_2114007_005",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "是叫龍人族的覺醒",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n是因為是一覺醒就直接應用在實戰上，",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "所以……",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我會",
    "voice": "vo_adv_2114007_006",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "被力量牽著走……！",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n自己的身體",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就像是不受控制的野馬一樣……！　",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "吼喔喔喔喔喔！！！",
