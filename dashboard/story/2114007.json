  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "唔！",
    "voice": "vo_adv_2114007_008",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "「冰之壁」！！",
    "voice": null,
    "unit_id": 106416
  },
