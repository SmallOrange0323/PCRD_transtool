    "type": "dialogue",
    "name": "雪菲",
    "words": "就用寒氣",
    "voice": "vo_adv_2114007_025",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "減少他的體力！",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n削弱他之後，",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "再把他冰凍起來……！",
    "voice": null,
    "unit_id": 106416
