[
  {
    "type": "background",
    "bg_id": "500033"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "今天在蘭德索爾全境內，盛大舉行著豐年祭。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n【美食殿堂】一行人逛著豐年祭的攤販、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n充分享受著她們的公會活動：吃遍美食。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "在慶祝豐收的祭典裡吃遍美食。",
    "voice": "vo_adv_4007101_000",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是最適合我們的公會活動了！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你不管有沒有舉行祭典，",
    "voice": "vo_adv_4007101_001",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不是隨時都在吃東西嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家都在感謝著食物，",
    "voice": "vo_adv_4007101_002",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是這種團結的感覺很不錯嘛。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "感謝今年的收成，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "祈求明年的豐收。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n真的是很棒的祭典。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真希望每天都舉辦☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": "vo_adv_4007101_003",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您的嘴角黏到飯了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下幫您拿下來哦……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊呣。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這邊還是平常的老樣子……",
    "voice": "vo_adv_4007101_004",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n有點分寸好不好，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留你雖然說這種話，",
    "voice": "vo_adv_4007101_005",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "自己不是也買了各種東西嗎～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n又是棉花糖又是可麗餅。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "然後還有蘋果糖。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "祭典的必備名產",
    "voice": "vo_adv_4007101_006",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一項不差地蒐集齊全了呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很，",
    "voice": "vo_adv_4007101_007",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很囉唆耶。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有什麼關係。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "反正看起來都很好吃嘛。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒錯，",
    "voice": "vo_adv_4007101_008",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "看起來好吃的東西最難抗拒了！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼？",
    "voice": "vo_adv_4007101_009",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　這個聲音。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好吵哦。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是器材故障了嗎？",
    "voice": "vo_adv_4007101_010",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感覺好像是從空中傳來的聲音……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哇！？",
    "voice": "vo_adv_4007101_011",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小可蘿！　",
    "voice": "vo_adv_4007101_012",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "您沒事吧！？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "風，",
    "voice": "vo_adv_4007101_013",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "風太強了",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "根本站不起來……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人",
    "voice": "vo_adv_4007101_014",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝您。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還要麻煩您出手相助，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真對不起。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "【美食殿堂】的各位！",
    "voice": "vo_adv_4007101_015",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n來得正好！",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "花凜小姐，",
    "voice": "vo_adv_4007101_016",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "阿囉哈～☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼慌張的樣子，怎麼了嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳會這麼慌張，就表示",
    "voice": "vo_adv_4007101_017",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有麻煩的事要委託我們對吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說來聽聽。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們會聽的，所以趕快說吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "剛才那陣奇怪的聲音和陣風，",
    "voice": "vo_adv_4007101_018",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n已經確認在蘭德索爾各地",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "頻繁地發生……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n也開始連絡不上",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "前去調查的公會們。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "雖然公會管理協會已經展開行動，",
    "voice": "vo_adv_4007101_019",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n但事件的範圍太廣了",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "，人手實在不夠……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "希望【美食殿堂】的各位",
    "voice": "vo_adv_4007101_020",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "能去調查",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n失去連絡的那些公會。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "因為這次委託具有危險性，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "付給你們的報酬也會比平常多些。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉……",
    "voice": "vo_adv_4007101_021",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那就沒辦法了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們接受。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "今天是難得的豐年祭耶。",
    "voice": "vo_adv_4007101_022",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n竟然有人無法享受，實在看不下去！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "background",
    "bg_id": "500333"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這到底是",
    "voice": "vo_adv_4007101_023",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼啊…………",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "建築物都東倒西歪，",
    "voice": "vo_adv_4007101_024",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "居民們也都不見蹤影。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n根本人去樓空……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不只建築物，",
    "voice": "vo_adv_4007101_025",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "連農田也",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "到處被翻成奇怪的模樣。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "又是那陣聲音！？　",
    "voice": "vo_adv_4007101_026",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真的很難聽！！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "說不定又會吹起狂風了！",
    "voice": "vo_adv_4007101_027",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家緊緊聚在一起吧。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "（緊緊抱住～～～）。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哇！？　",
    "voice": "vo_adv_4007101_028",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不要突然抱過來啦！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵，",
    "voice": "vo_adv_4007101_029",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這樣子好溫暖哦。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請您再靠近一點。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……唔！",
    "voice": "vo_adv_4007101_030",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n比剛才更強的風呢。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n幸好我們緊緊抱在一起了！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐，",
    "voice": "vo_adv_4007101_031",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真謝謝您。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n多虧這樣才沒有被吹倒。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯？　",
    "voice": "vo_adv_4007101_032",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
