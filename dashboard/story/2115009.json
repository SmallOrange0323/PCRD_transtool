    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………",
    "voice": "vo_adv_2115009_023",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "要是能早點……",
    "voice": "vo_adv_2115009_024",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這麼做就好了。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……唉。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "確實……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "實在是，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "太不自由了……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "草野優衣──",
    "voice": "vo_adv_2115009_025",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不能殺了妳，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "實在可恨。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但雖然不能殺了妳，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n卻可以折磨妳。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "background",
    "bg_id": "500780"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "──唔",
    "voice": "vo_adv_2115009_026",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "！？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……草野優衣，",
    "voice": "vo_adv_2115009_027",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n就算迷宮女王干涉我，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我也在那瞬間就會探知到",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "並殺害她。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n已經，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "沒有人能保護妳了……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……唔……",
    "voice": "vo_adv_2115009_028",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……？",
    "voice": "vo_adv_2115009_029",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n有人，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "還活著……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "為了不波及到騎士先生，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我似乎下手太輕了呢。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……既然如此，",
    "voice": "vo_adv_2115009_030",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n就這樣，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "給予最後一擊……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……騎士先生？",
    "voice": "vo_adv_2115009_031",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不要阻撓我。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你只要，",
    "voice": "vo_adv_2115009_032",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "再等我一下。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我現在，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就讓其他女人消失，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n將草野優衣，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "永遠幽禁起來……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……？沒事的。",
    "voice": "vo_adv_2115009_033",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n她們至今為止，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "也消失過好幾次。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "像是被霸瞳皇帝打敗、",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "或是被百地希留耶背叛……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "有各式各樣的原因。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這樣也只是，",
    "voice": "vo_adv_2115009_034",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "多消失一次而已。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n所以……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……騎士先生。",
    "voice": "vo_adv_2115009_035",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n拜託你。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n安靜點……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我……",
    "voice": "vo_adv_2115009_036",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "終於，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
