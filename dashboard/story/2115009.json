    "voice": "vo_adv_2115009_006",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "要過去囉。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n騎士先生。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "background",
    "bg_id": "500780"
  },
  {
    "type": "dialogue",
    "name": "嘉夜、祈梨",
    "words": "老大～！！",
    "voice": "vo_adv_2115009_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好快……！",
    "voice": "vo_adv_2115009_008",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n已經看不見嘉夜小姐",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "與祈梨小姐的身影了。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "因為她們倆",
    "voice": "vo_adv_2115009_009",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒受什麼傷呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而且……",
    "voice": "vo_adv_2115009_010",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在剛才巨大的衝擊之後，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n帆稀小姐那強大的魔力，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就這麼消失了。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "莫非……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "帆稀小姐，",
    "voice": "vo_adv_2115009_011",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可能輸掉了……？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一時間難以想像，",
    "voice": "vo_adv_2115009_012",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但對手那麼強……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……帆稀小姐……",
    "voice": "vo_adv_2115009_013",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們也",
    "voice": "vo_adv_2115009_014",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "過度使用力量了。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n要是就這樣去和厄莉絲戰鬥……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……老實說會很辛苦吧。",
    "voice": "vo_adv_2115009_015",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "先回去",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "拉比林斯達那裡一趟……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………",
    "voice": "vo_adv_2115009_016",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "厄莉絲！？",
    "voice": "vo_adv_2115009_017",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是空間跳躍嗎……！",
    "voice": "vo_adv_2115009_018",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "糟了！",
    "voice": "vo_adv_2115009_019",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們大家快逃──",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "──去死吧。",
    "voice": "vo_adv_2115009_020",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "呀啊啊啊",
    "voice": "vo_adv_2115009_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "！！！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500780"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怜、",
    "voice": "vo_adv_2115009_022",
