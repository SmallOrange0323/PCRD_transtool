  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "背負了七冠們的力量，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n這點……",
