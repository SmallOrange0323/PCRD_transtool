  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}正和亞里莎一起",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n朝著森林深處前進。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……呼。",
    "voice": "vo_adv_1063010_000",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "結束了「力量測驗」的亞里莎，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看起來似乎有點沮喪。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "為、",
    "voice": "vo_adv_1063010_001",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "為什麼要這樣問我？",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我有哪裡怪怪的嗎？",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n衣服？",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "頭髮？",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "味道……？",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……",
    "voice": "vo_adv_1063010_002",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "果然",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "會被看出來啊。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我面對{0}的時候",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "不知為何總是撒不了謊。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我有點在意",
    "voice": "vo_adv_1063010_003",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "剛才她說的話，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "一直在煩惱。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "森林的使者小姐",
    "voice": "vo_adv_1063010_004",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "不是大方地誇獎了我嗎？",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n像是弓箭",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "還有魔法……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "但是她卻說了……",
    "voice": "vo_adv_1063010_005",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我沒辦法",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "通過第二項測驗。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n說了，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "很可惜……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "哈哈……",
    "voice": "vo_adv_1063010_006",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "{0}，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "你真溫柔。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……不過，",
    "voice": "vo_adv_1063010_007",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "其實啊。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我心底",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "隱約知道原因。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我好像",
    "voice": "vo_adv_1063010_008",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "沒和你說過呢。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n我和蘿莎麗亞的關係。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "蘿莎麗亞她啊，",
    "voice": "vo_adv_1063010_009",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "就像我的姐姐一樣。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n不管是弓箭、",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "狩獵、",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "還是爬樹……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "全部",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "都是蘿莎麗亞教我的。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "蘿莎麗亞她很溫柔，",
    "voice": "vo_adv_1063010_010",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "總是會誇獎我。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n她還會自豪地",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "對森林裡的大家說，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我們將來會一起當上森林守衛。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "她是……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我的憧憬。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "但是……",
    "voice": "vo_adv_1063010_011",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n這樣的蘿莎麗亞，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "曾經罵過我唯一一次。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "嗯。",
    "voice": "vo_adv_1063010_012",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n那應該是發生在蘿莎麗亞離開森林的",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "不久之前吧。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "那時",
    "voice": "vo_adv_1063010_013",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "有壞魔物來到森林裡。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "當時在看守的我",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "打算用弓箭趕走魔物。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "但是，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我果然還是",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "會害怕實戰……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我無法完全相信",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我會射中。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "不久後，",
    "voice": "vo_adv_1063010_014",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "蘿莎麗亞來了。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "她從遠方打倒了",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "逃到森林外的魔物。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "那時，",
    "voice": "vo_adv_1063010_015",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "她對我說了。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n「亞里莎太天真了」。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "「妳還",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "沒有辦法完全相信」……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……蘿莎麗亞那時",
    "voice": "vo_adv_1063010_016",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "對我說完這些後，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "人就消失了。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "一定是因為",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我那時沒有完全相信蘿莎麗亞。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "所以她才……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……咦？",
    "voice": "vo_adv_1063010_017",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "太、",
    "voice": "vo_adv_1063010_018",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "太甜真……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n不是在說好不好吃啦！？",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "你、",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "你為什麼要把臉靠近我～！？　",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "臉、",
    "voice": "vo_adv_1063010_019",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "臉和臉",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "一口氣靠得好近……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "這樣簡直像是……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "簡直像是……！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n呀啊啊！？　",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "真、",
    "voice": "vo_adv_1063010_020",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "真是的！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "不要奇怪的話啦！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我是說太天真，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "不是太甜～！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "也、",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "也不要聞我味道啦！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "快離開我──！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
