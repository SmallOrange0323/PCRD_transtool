  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "慈樂之音巡演中的某個夏日，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}在望休假時和她一起行動。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯～～～～！",
    "voice": "vo_adv_1172001_000",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "天氣真棒♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "說到夏天，果然就是南方的島嶼呢！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "今天可以休息一整天，",
    "voice": "vo_adv_1172001_001",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就來盡情地享受吧♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "然後……",
    "voice": "vo_adv_1172001_002",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}跟我一起來是很好，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但你為什麼拿出了筆記本呢？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "貼身採訪？",
    "voice": "vo_adv_1172001_003",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這是怎麼回事──？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "──原來如此啊。",
    "voice": "vo_adv_1172001_004",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "把巡演中的休息時間都在做些什麼記錄下來，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "等巡演結束後就拿來刊登在預計出版的雜誌上……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是這樣啊。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n製作人",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "想得真周到呢。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過，",
    "voice": "vo_adv_1172001_005",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "讓你來採訪，我可能會覺得有點不好意思。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "該說這會",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "讓人搞不太懂",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這要算是在工作，\\n還是要當成是私人行程嗎……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不，",
    "voice": "vo_adv_1172001_006",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我並不是討厭……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我大概是覺得",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有點害羞吧。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿嘿♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那我們",
    "voice": "vo_adv_1172001_007",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "走吧。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "background",
    "bg_id": "500700"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哇……！",
    "voice": "vo_adv_1172001_008",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "街上的景色和蘭德索爾完全不同呢。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "到處都有",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "許多小小的船。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你看，",
    "voice": "vo_adv_1172001_009",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "各種地方都有放動物的擺設！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是用來驅魔的嗎……？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "小小的，真可愛～～♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我啊，",
    "voice": "vo_adv_1172001_010",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "很喜歡像這樣，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "在巡演地點的城鎮裡四處逛。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為我打氣的各位粉絲",
    "voice": "vo_adv_1172001_011",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "居住在什麼樣的地方，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "還有",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "他們都會吃什麼樣的東西……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "之類的。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "在了解這些事情之後啊，",
    "voice": "vo_adv_1172001_012",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我就能更加貼近地感受到大家的存在。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呼……",
    "voice": "vo_adv_1172001_013",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我流了不少汗呢。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "在演唱會上搞不好也能用這股熱氣來炒熱氣氛！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "奇怪？",
    "voice": "vo_adv_1172001_014",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這是什麼啊？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有股好香的味道……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n嗅嗅……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是從那家店傳出來的嗎？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也渴了，",
    "voice": "vo_adv_1172001_015",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就去休息一下吧。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "邊逛邊吃也是遊覽各地的樂趣之一呢。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "background",
    "bg_id": "500690"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不好意思～",
    "voice": "vo_adv_1172001_016",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "喂……",
    "voice": "vo_adv_1172001_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "那是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "望望對吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "我聽說她為了巡迴演唱會而來到這座城鎮，",
    "voice": "vo_adv_1172001_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n但沒想到居然能在這種地方遇見她……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊哈哈……",
    "voice": "vo_adv_1172001_019",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "完全引來別人的注目了呢……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": "vo_adv_1172001_020",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對了！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不好意思～！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n在我們用餐的時候，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n可以拍攝",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "餐點的照片嗎？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "…………",
    "voice": "vo_adv_1172001_021",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個……？",
    "voice": "vo_adv_1172001_022",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "…………啊，",
    "voice": "vo_adv_1172001_023",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "好。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不管要坐哪裡",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "都可以。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n拍照也……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "沒問題。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝你～！",
    "voice": "vo_adv_1172001_024",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們也取得拍攝的許可了，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這樣就萬無一失了吧。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我看看……",
    "voice": "vo_adv_1172001_025",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這應該是能把照片拍得最好看的座位吧。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n{0}",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要點什麼？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我的話……",
    "voice": "vo_adv_1172001_026",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就點冰淇淋汽水吧。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "充滿夏天的感覺，很棒吧！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那麼，",
    "voice": "vo_adv_1172001_027",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "在等待的時候，要來訪談嗎？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "禁止問太過火的內容喔。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……所以說啊，",
    "voice": "vo_adv_1172001_028",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "在這次的演唱會中，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我也受到了紡希和千歌的許～",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "多幫助。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我真的一直都很感謝她們。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊！",
    "voice": "vo_adv_1172001_029",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也想問問你，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "在之前的演唱會上，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你對誰的表現最有印象？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦，",
    "voice": "vo_adv_1172001_030",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我！？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘻嘻，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我在這次的演唱會上也會像太陽一樣閃閃發光的，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就拜託你為我打氣囉！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不管是你，",
    "voice": "vo_adv_1172001_031",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "還是大家，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我都會讓你們對我更加入迷的，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以要一直看著我喔！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……嗚，",
    "voice": "vo_adv_1172001_032",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然用若無其事的表情勉強掩飾過去了，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n這樣啊，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "原、",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "原來是我啊……！　",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "怎麼辦……",
    "voice": "vo_adv_1172001_033",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "心跳得好快……！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我的臉",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有沒有變紅啊！？　",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌啊～",
    "voice": "vo_adv_1172001_034",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為她的聲音很有延展性，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n獨唱時會讓人聽得如癡如醉呢。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "以我的角度來看，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也會覺得贏不了她啊。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌啊……",
    "voice": "vo_adv_1172001_035",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "唔唔唔，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是個難纏的對手啊。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也該以氣質系美少女的路線為目標嗎？　",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過",
    "voice": "vo_adv_1172001_036",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就算我模仿千歌，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也不可能贏過本人……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是可是，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果能成為你的第一名，我一定會那麼做……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯～",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哦……",
    "voice": "vo_adv_1172001_037",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "居然點明了紡希，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你挺有眼光的嘛。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "紡希啊……",
    "voice": "vo_adv_1172001_038",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我懂。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就是說啊。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為看到她專心致志地努力的模樣，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就連我都會想為她打氣啊。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n然後",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "她還對別人很體貼，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "又比其他人",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "更加溫柔……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有點不太坦率，",
    "voice": "vo_adv_1172001_039",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這一點也是她的魅力所在呢。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為紡希是這樣的人，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我想會對她印象深刻也是理所當然的，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但我果然",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也想成為你的第一名……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……你問我",
    "voice": "vo_adv_1172001_040",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒、",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒有！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒什麼。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "什麼都沒有！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "…………那個。",
    "voice": "vo_adv_1172001_041",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗚哇！？",
    "voice": "vo_adv_1172001_042",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嚇、",
    "voice": "vo_adv_1172001_043",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嚇我一跳……！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對不起，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "太吵了嗎？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "……這是妳點的冰淇淋汽水。",
    "voice": "vo_adv_1172001_044",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n還有……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這是",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我們店裡的招牌菜。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "奇、",
    "voice": "vo_adv_1172001_045",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "奇怪……？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我們好像沒有點這個……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "……是招待。",
    "voice": "vo_adv_1172001_046",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n因為我是，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "那個……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "慈樂之音的，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "望望的忠實粉絲。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這是",
    "voice": "vo_adv_1172001_047",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這個地區的在地料理……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "對中暑很有效。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n這次的演唱會……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "一定也會變得很熱，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "希望妳不會輸給暑氣。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n所以說，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "那個……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "妳不介意的話，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "就吃吃看吧。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哇，",
    "voice": "vo_adv_1172001_048",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯～",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好香的味道！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "看起來好好吃……！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗚嗚～～！",
    "voice": "vo_adv_1172001_049",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "看起來真的好好吃喔……！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n這是",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "在蘭德索爾吃不到的菜吧，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一定是這樣。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……可是，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "該怎麼辦？　",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我",
    "voice": "vo_adv_1172001_050",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為了夏日演唱會，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "努力讓自己瘦下來了啊……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我一直在用跳舞跑步健身，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也有仔細控管飲食……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "因為這是……",
    "voice": "vo_adv_1172001_051",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我們的招牌菜。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n你也",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "一起吃吃看吧。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗚嗚，",
    "voice": "vo_adv_1172001_052",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "甜甜鹹鹹的香味好誘人……",
    "voice": null,
    "unit_id": 117211
