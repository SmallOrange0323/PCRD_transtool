  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "久等了～！",
    "voice": "vo_adv_4010241_000",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "抱歉～",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "明明是我指定的時間，我自己卻遲到了……！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n因為工作……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不對，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我不應該找理由推託的。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "遲到的部分",
    "voice": "vo_adv_4010241_001",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我總有一天一定會還給你的！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "再加上之前無數次讓你等的時間……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我大概得給你",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "整整一天的時間才行啊！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "言歸正題，",
    "voice": "vo_adv_4010241_002",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "關於",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "今天的事。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你知道……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我為什麼找你出來嗎？",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "太好了，",
    "voice": "vo_adv_4010241_003",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就知道你記得我的生日！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "特地把你叫出來",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "幫我慶祝生日。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我是擔心{0}搞不好會有所顧慮",
    "voice": "vo_adv_4010241_004",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n而難以開口約我──",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我乾脆就主動約他了……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿嘿。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哇，",
    "voice": "vo_adv_4010241_005",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝你～！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你怎麼好像很心虛的樣子？",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……♪",
    "voice": "vo_adv_4010241_006",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我確實是偶像「櫻井望」沒錯，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但也不必特別去考慮",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "什麼樣的禮物才配得上我啦。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……這是你送我的東西。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "光是這點",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就價值非凡了。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯～",
    "voice": "vo_adv_4010241_007",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你還是覺得過意不去嗎？",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就這麼想要討我的歡心啊？",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……啊，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那不然，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我可以拜託你一件事嗎？",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我有點想要……",
    "voice": "vo_adv_4010241_008",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你身上",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "帶著的東西。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你、",
    "voice": "vo_adv_4010241_009",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你千萬不要誤會喔！？",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我可不是想說",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "「真希望身邊一直都有你的味道～」",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "之類的喔！？",
    "voice": null,
    "unit_id": 102931
  }
]
