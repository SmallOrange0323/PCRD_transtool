    "name": "雷姆",
    "words": "{0}先生，\\n灑出來的水，雷姆會擦乾淨的！",
    "voice": "vo_adv_1097003_053",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n麻煩將放在那裡的垃圾袋拿到外面去！",
