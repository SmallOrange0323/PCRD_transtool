    "voice": "vo_adv_1097003_020",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳是第一次見到的客人呀。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我是這個牧場的主人，真陽啦。",
    "voice": "vo_adv_1097003_021",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "謝謝妳特地把東西送過來呀～♪",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "妳真是太客氣了。",
    "voice": "vo_adv_1097003_022",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "我叫做雷姆。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "現在正受到{0}先生",
    "voice": "vo_adv_1097003_023",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n和【美食殿堂】各位的照顧。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "請多多指教。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "受到{0}照顧……？",
    "voice": "vo_adv_1097003_024",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我看起來倒覺得在照顧人的是雷姆耶？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳把他背了過來，",
    "voice": "vo_adv_1097003_025",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "還用扇子幫他搧風，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "感覺照顧得",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "無微不至啊。",
    "voice": null,
    "unit_id": 103311
  },
