    "name": "雷姆",
    "words": "是位於山上的牧場，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n他在路上擦傷了膝蓋。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這樣啊這樣啊～",
    "voice": "vo_adv_1097003_027",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "得要小心才行啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "如果你們不是在只有我一個人的時候來就好了啊～",
