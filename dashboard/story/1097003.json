    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "啊啊，",
    "voice": "vo_adv_1097003_034",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "怎麼這樣，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n請別用那種小狗般的眼神看著雷姆……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n這樣會有點……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "稍微有點、",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "多少有點",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "罪惡感的。",
    "voice": null,
    "unit_id": 109711
  },
