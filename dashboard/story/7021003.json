[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "三個人不斷地與阻擋在前的魔物們戰鬥，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n持續朝著露娜之塔的上方前進。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呼。",
    "voice": "vo_adv_7021003_000",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "在打倒數量可觀的魔物後，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n戰鬥總算告一個段落了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我是還撐得住……",
    "voice": "vo_adv_7021003_001",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n趁現在先休息一下也好。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n深月小姐也這麼認為嗎？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "因為我有點累了，若能稍作休息那就太好了。",
    "voice": "vo_adv_7021003_002",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖說在那之後，她就沒有再做出可疑的舉動，",
    "voice": "vo_adv_7021003_003",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n但總覺得不太對勁……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這對有在鍛鍊身體的小智來說，",
    "voice": "vo_adv_7021003_004",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "或許是多管閒事，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n就讓我為妳泡杯可以消除疲勞的特調香草茶吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "怎會是多管閒事呢。",
    "voice": "vo_adv_7021003_005",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我會滿懷感激地享用的。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗯，",
    "voice": "vo_adv_7021003_006",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "看來是我想太多了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n真正的壞人是不可能會和{0}成為朋友的。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我馬上去做準備，",
    "voice": "vo_adv_7021003_007",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "請妳稍待片刻。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好了，",
    "voice": "vo_adv_7021003_008",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "請用吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這茶的香氣真的很不一樣呢。",
    "voice": "vo_adv_7021003_009",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "因為我用了好幾種藥草去調製。",
    "voice": "vo_adv_7021003_010",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過，我想應該不至於會太難喝。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那麼……",
    "voice": "vo_adv_7021003_011",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我就享用囉。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咕嚕。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_7021003_012",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "的確，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "喝起來的口感很高雅，與香氣截然不同。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵，",
    "voice": "vo_adv_7021003_013",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳真的喝下去了呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦！？",
    "voice": "vo_adv_7021003_014",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "難、",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "難不成妳下了毒！？",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "沒錯，",
    "voice": "vo_adv_7021003_015",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這是利用好幾種毒草去調製的",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "特調香草茶。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n好啦，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳應該開始感到體內的力量慢慢地流失殆盡了吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "唔，",
    "voice": "vo_adv_7021003_016",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我太大意了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳果然……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "當然沒這回事，",
    "voice": "vo_adv_7021003_017",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我是故意嚇妳的。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我並沒有下毒。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過這香草茶的確有放鬆的效果。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這、",
    "voice": "vo_adv_7021003_018",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這是怎麼一回事？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "因為",
    "voice": "vo_adv_7021003_019",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "小智",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "從剛剛就一直",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n對我抱著戒心啊。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不只對魔物，",
    "voice": "vo_adv_7021003_020",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要是對我也絲毫不敢鬆懈的話，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n妳是撐不了多久的喔。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_7021003_021",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳注意到了呢。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那當然。",
    "voice": "vo_adv_7021003_022",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我的經驗可不是累積假的喔。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "對不起，我胡亂懷疑了妳。",
    "voice": "vo_adv_7021003_023",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳不用道歉。",
    "voice": "vo_adv_7021003_024",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這是",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "小智的工作啊。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "況且，",
    "voice": "vo_adv_7021003_025",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我說這茶是用了好幾種毒草去調製，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "並不是謊言喔。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦！？",
    "voice": "vo_adv_7021003_026",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "只要高溫煎炒過，毒性就會揮發掉。",
    "voice": "vo_adv_7021003_027",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "因為我想讓",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你親身體驗一下，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我在塔外曾說過的「是毒是藥皆有用」",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這句話。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "…………",
    "voice": "vo_adv_7021003_028",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "啊，",
    "voice": "vo_adv_7021003_029",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳臉上的表情還是充滿了不信任感。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "既然如此，這杯茶借給我一下吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咕嚕、",
    "voice": "vo_adv_7021003_030",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咕嚕……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳看，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這樣多少可以相信我了吧？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我……",
    "voice": "vo_adv_7021003_031",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "沒關係。",
    "voice": "vo_adv_7021003_032",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳能稍微相信我就行了。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n因為我們",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "現在是",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n一起找尋{0}的記憶線索的夥伴。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_7021003_033",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是的。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "話說回來，",
    "voice": "vo_adv_7021003_034",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "{0}。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n看你一臉也想喝的樣子。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我想也是。",
    "voice": "vo_adv_7021003_035",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我和小智都喝了茶，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "卻只有你\\n被排除在外。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那麼，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "請用。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n就用這個杯子喝吧……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你害羞了嗎？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……呵呵。",
    "voice": "vo_adv_7021003_036",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我一點也不介意，你就喝吧。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你看，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我剛剛喝的地方",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是這裡喔。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "而我是",
    "voice": "vo_adv_7021003_037",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "從這裡喝的。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好啦，",
