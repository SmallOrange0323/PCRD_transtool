    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "追加一球。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "看招……！",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}就像這樣帶著萊拉耶爾，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n導覽各個回憶之地。",
    "voice": null,
