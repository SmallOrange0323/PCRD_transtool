  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在愛被破壞的騷動逐漸平息後的平安夜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了去視察終於到來的正常聖誕節，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n萊拉耶爾與{0}一起前往鎮上觀光。",
