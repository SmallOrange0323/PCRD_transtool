  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "雪真的很冷呢……",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n兩隻手",
