[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}發現了很認真地，\\n凝視著某個東西的依里。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "盯……",
    "voice": "vo_adv_1022008_000",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸？你問我在做什麼？",
    "voice": "vo_adv_1022008_001",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你看，這間店家呀，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n有在賣很可愛的玩偶呢……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊，好刺眼啊……",
    "voice": "vo_adv_1022008_002",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n什、什麼！？怎麼回事！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這個光跟那時候的一樣！？",
    "voice": "vo_adv_1022008_003",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊、啊啊啊啊！！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "background",
    "bg_id": "510280"
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗯……",
    "voice": "vo_adv_1022008_004",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這個玩偶好可愛喔……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哇！？原、原來是你啊……",
    "voice": "vo_adv_1022008_005",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不要突然叫我啦！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n嚇了一跳呢！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸？你問我在做什麼？",
    "voice": "vo_adv_1022008_006",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n沒、沒什麼啊！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我才不是想要那個玩偶……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "只是……你看，擁有這種玩偶的話，",
    "voice": "vo_adv_1022008_007",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n感覺好像比較像個女生……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "什、什麼呀，那個眼神！",
    "voice": "vo_adv_1022008_008",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我像個女生一樣不行嗎！？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哼，沒差！",
    "voice": "vo_adv_1022008_009",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n反正你一定也覺得我，",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n一點都不可愛吧！？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "反正在我的房間裡，",
    "voice": "vo_adv_1022008_010",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n都是滿滿的遊戲攻略本！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "有意見嗎！？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那又怎樣！",
    "voice": "vo_adv_1022008_011",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n和你的房間做比較，",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n一點都沒安慰到我！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是、是吧！",
    "voice": "vo_adv_1022008_012",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n只要有遊戲攻略本，其他都不需要――",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "呃，現在是在說像不像女生的問題！",
    "voice": "vo_adv_1022008_013",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n和攻略本好不好沒有關係吧！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸？想要的話，就去買？",
    "voice": "vo_adv_1022008_014",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "所、所以我根本沒有說過想要啊……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "而且……這個熊寶寶，",
    "voice": "vo_adv_1022008_015",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n價格很貴呢……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n實在買不下去……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "蛤？",
    "voice": "vo_adv_1022008_016",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你叫我等一下……？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n欸，什麼？你要去哪裡呀！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊啊，真是的……走掉了……",
    "voice": "vo_adv_1022008_017",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "到底怎麼回事？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n居然叫我在這裡等……真是太硬來了。",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "可、可是……",
    "voice": "vo_adv_1022008_018",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n那傢伙的強勢，總是幫到我的忙，",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n有時候我還是得好好道謝才行……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗚嗚……還是覺得很害臊啊。",
    "voice": "vo_adv_1022008_019",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n要直接說的話，有點……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這樣的話――",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哇！？已、已經回來了？",
    "voice": "vo_adv_1022008_020",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n速度好快啊？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你去做什麼了？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "still",
    "still_id": "102200801"
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸！？",
    "voice": "vo_adv_1022008_021",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n玩、玩偶！？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "要給我……？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "怎麼會有這個？",
    "voice": "vo_adv_1022008_022",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……從遊戲中心抓娃娃抓來的！？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嘿、嘿……很厲害嘛。",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……剛剛我也說了，",
    "voice": "vo_adv_1022008_023",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我才不是想要玩偶……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但、但是，既然你給我，我就收下吧！",
    "voice": "vo_adv_1022008_024",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n謝……謝……",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "桑葚很軟Q！",
    "voice": "vo_adv_1022008_025",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "聽、聽不懂嗎？",
    "voice": "vo_adv_1022008_026",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n桑葚很Q……桑Q",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n就是Thank you啦！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "什、什麼！？",
    "voice": "vo_adv_1022008_027",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你想說這笑話很無聊嗎！？",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "為什麼說得一點感情都沒有！",
    "voice": "vo_adv_1022008_028",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n你絕對不是那樣想的吧！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "難、難得我對你說出了謝謝……",
    "voice": "vo_adv_1022008_029",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我不理你了！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊、但是……那個，欸……",
    "voice": "vo_adv_1022008_030",
    "unit_id": 102232
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n總之我會好好珍惜這個玩偶的！",
    "voice": null,
    "unit_id": 102232
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊～好有趣喔。",
    "voice": "vo_adv_1022008_031",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n依里真沒有說笑話的天分呢～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "上次也說過了，",
    "voice": "vo_adv_1022008_032",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這是按照你和依里的記憶所製作的「夢」唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n請期待下次的「夢」呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次見囉～ ♪",
    "voice": "vo_adv_1022008_033",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "玩偶……好可愛……",
    "voice": "vo_adv_1022008_034",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗯嗯？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n這裡是哪裡……？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "該、該不會我又和你一起，",
    "voice": "vo_adv_1022008_035",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n傻傻地發呆了吧……？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們在街上做什麼啊？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊嗯，對喔。玩偶嗎……",
    "voice": "vo_adv_1022008_036",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦？你也做了一樣的夢？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸？你要買玩偶給我……？",
    "voice": "vo_adv_1022008_037",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我剛說了呀！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我不想要玩偶啦！",
