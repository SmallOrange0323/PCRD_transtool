[
  {
    "type": "background",
    "bg_id": "502063"
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "今天就要離開薩拉薩利亞了。",
    "voice": "vo_adv_5128431_000",
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沒想到最後",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "會變成一趟充滿意外的驚奇之旅呢。",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是啊，",
    "voice": "vo_adv_5128431_001",
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "希望下次來這裡時",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們可以悠哉地度過呢。",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我可不想再經歷",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這種打打殺殺的激鬥了。",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳說的沒錯。",
    "voice": "vo_adv_5128431_002",
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這次旅行",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "受到流夏和你很多的幫助呢，",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n真的是",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "很謝謝你們。",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過，",
    "voice": "vo_adv_5128431_003",
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果有幫上忙就好了。",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "俗話不是說只要結果好，",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一切都好嗎。",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沒錯，",
    "voice": "vo_adv_5128431_004",
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這句話說的太好了。",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "所以，",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "為了給旅途「劃下完美的句點」，",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我想",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "拜託你們一件事……",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "拜託你們！",
    "voice": "vo_adv_5128431_005",
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "能不能陪我一起採購",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要給孩子們的伴手禮？",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n他們要求要禮物，",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但我完全忘記這件事了……",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "馬車出發的時間就快到了啊……",
    "voice": "vo_adv_5128431_006",
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的，",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這趟旅行直到最後一刻",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也不得閒呢。",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好吧，",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們要先去哪裡？",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "搬行李的人",
    "voice": "vo_adv_5128431_007",
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "當然是多多益善，",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "為了給這趟旅行「劃下完美的句點」，",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你肯定",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "願意來幫忙的吧？",
    "voice": null,
    "unit_id": 127611
  }
]
