[
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這個異常程度，",
    "voice": "vo_adv_5092301_000",
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "還有強度……",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不愧是守護財寶的守護者。",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "作為對手來說無可挑剔！",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "面對這樣的強敵，妳還能說出這種話，",
    "voice": "vo_adv_5092301_001",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真是讓我無比安心。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那麼杏奈，",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "接下來就拜託妳了。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "咦？",
    "voice": "vo_adv_5092301_002",
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "啊，",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "雖然我一個人也沒問題，",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不過要我獨占功勞，",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "總、",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "總覺得不太好……",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我是開玩笑的。",
    "voice": "vo_adv_5092301_003",
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就算是杏奈",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "要單挑這種強敵也是很難的吧。",
    "voice": null,
    "unit_id": 122011
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳們兩個真有閒情逸致啊。",
    "voice": "vo_adv_5092301_004",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n財寶就在眼前了，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "集中精神，小心應戰！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵，",
    "voice": "vo_adv_5092301_005",
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳們這麼關心我，",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那我可不能辜負這份心意。",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "很好，",
    "voice": null,
    "unit_id": 121911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "跟著我上！",
    "voice": null,
    "unit_id": 121911
  }
]
