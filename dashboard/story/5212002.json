    "type": "dialogue",
    "name": "靜流",
    "words": "所以才會是年菜啊♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "still",
    "still_id": "521200202"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "可是，",
    "voice": "vo_adv_5212002_014",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "姐姐……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n只是這樣的話，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "也沒辦法解決對吧？",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要是不努力想想",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "怎麼樣才能離開的話。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "still",
    "still_id": "521200203"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯，",
    "voice": "vo_adv_5212002_015",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "而且被捲入的人",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "比想像中還要多的樣子。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n……這下子，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "可能要有點要加油的心理準備才行。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "still",
    "still_id": "521200204"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咿～！",
    "voice": "vo_adv_5212002_016",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "果然是這樣嗎！？",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n明明都靠著哥哥的手作年菜逃避現實了～～！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "background",
