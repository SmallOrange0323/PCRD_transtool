    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真不愧是姐姐，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "居然想到這麼遠！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我也來幫──",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "謝謝，",
    "voice": "vo_adv_5212002_078",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "而且，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "只要想到這也是弟弟留下的遺留物，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n忍不住就會想把全部都收集起來呢。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……姐姐，",
    "voice": "vo_adv_5212002_079",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這不是在撿骨啦。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n本人",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "也還在這裡耶。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥也快住手！",
    "voice": "vo_adv_5212002_080",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n太不吉利了……！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "璃乃等人吵吵鬧鬧地加入幫忙的行列。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一行人就這樣收集了印記的碎片後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一同邁步朝向下一個傳送門。",
    "voice": null,
    "unit_id": null
  }
]
