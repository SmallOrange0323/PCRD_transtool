  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好幸福♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這溫和的味道……",
    "voice": "vo_adv_5212002_003",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n真是，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟煮的飯實在太棒了♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n姐姐",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "要給你三顆星！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "姐姐",
    "voice": "vo_adv_5212002_004",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "對哥哥做的東西，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n全部都給三顆星嘛。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那麼那麼，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我要給四顆星！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗚嗚，",
    "voice": "vo_adv_5212002_005",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "連心裡都覺得溫暖又滿足～♪",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "再來一碗！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那是因為",
    "voice": "vo_adv_5212002_006",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們在找哥哥你──",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "說是這麼說。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n但是仔細想想，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這裡是黎明界對吧？",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n大家卻能像這樣悠閒地聚在一起。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……不知道為什麼，",
    "voice": "vo_adv_5212002_007",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "冷靜下來之後開始覺得有點奇怪了。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "情報店的女性",
    "words": "是啊，",
    "voice": "vo_adv_5212002_008",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "情報店的女性",
    "words": "我們也是。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "情報店的女性",
    "words": "\\n工作途中",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "情報店的女性",
    "words": "突然被奇怪發光的洞穴吸進去……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "情報店的女性",
    "words": "回過神來就在這裡了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "情報店的女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "情報店的女性",
    "words": "周圍也都是",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "情報店的女性",
    "words": "發生相同狀況",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "情報店的女性",
    "words": "的人。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "我是提著出門採買的東西，",
    "voice": "vo_adv_5212002_009",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "走在回家路上時遇到。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "\\n年末年初本來",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "打算和",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "手下們",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "一起同歡的，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "\\n真是倒大楣……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "那邊的",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "學者老師也是吧？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打扮體面的男性",
    "words": "啊啊……",
    "voice": "vo_adv_5212002_010",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "打扮體面的男性",
    "words": "真是倒楣。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "打扮體面的男性",
    "words": "\\n既不知道怎麼回去，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "打扮體面的男性",
    "words": "也可能會出現魔物。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "打扮體面的男性",
    "words": "\\n所以大家才會像這樣，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "打扮體面的男性",
    "words": "群聚在一起保身。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "原來如此……",
    "voice": "vo_adv_5212002_011",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以大家才同心協力，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n先確保了食物和水啊。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "是啊，",
    "voice": "vo_adv_5212002_012",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "也剛好有出門採買的食材。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "\\n這種時候，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "就該吃些好吃的東西",
