    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "打起精神，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "對吧？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "\\n雖然離過年",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魁梧的男子",
    "words": "可能還有點早啦！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "原來如此，",
    "voice": "vo_adv_5212002_013",
    "unit_id": 136511
  },
