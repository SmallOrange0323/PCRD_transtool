    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "再說妳是從哪聽來的？　",
