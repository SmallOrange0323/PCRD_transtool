  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "如果受到那個聲音引誘，進了宅邸就會……",
