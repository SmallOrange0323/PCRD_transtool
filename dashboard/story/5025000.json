  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "來玩嘛……",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "據說是因為那群小孩子",
    "voice": "vo_adv_5025000_010",
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "想要朋友……",
