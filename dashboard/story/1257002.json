    "name": "花凜",
    "words": "……對了！",
    "voice": "vo_adv_1257002_041",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我為了這種時候，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "已經做好準備！",
