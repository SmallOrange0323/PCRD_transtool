  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "怪鳥！？",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n是為了保護雛鳥而回來嗎？",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這個情況該怎麼辦……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "500440"
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呀啊！",
    "voice": "vo_adv_1257002_037",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "謝、",
    "voice": "vo_adv_1257002_038",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "謝謝您保護我。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "對不起，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我的身體沒有立刻反應過來。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "要是沒有您的保護，我不曉得會變成怎樣……",
    "voice": "vo_adv_1257002_039",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n這就是",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "做為冒險者的經驗差距吧。",
