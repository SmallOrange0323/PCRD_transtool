[
  {
    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾天後，{0}被花凜叫了出來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正在陪她採購。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我看看，",
    "voice": "vo_adv_1257002_000",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "擲岩猴的尾椎骨加",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "狗頭人的乳牙……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "啊，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就是這個吧。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "紫痺菇",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這間店似乎沒有販售呢。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "雖然也可以用近緣種代替，",
    "voice": "vo_adv_1257002_001",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這裡還是照書中記載……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "唉，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "只能到別間店找找了。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "啊，",
    "voice": "vo_adv_1257002_002",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "非常抱歉。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "一不小心太忘我了……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "首先，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我必須解釋來到這裡的目的。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我",
    "voice": "vo_adv_1257002_003",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "從至今的經驗察覺到一件事。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我認為為了提供冒險者更好的支援，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n必須要了解冒險者的想法",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "因此，",
    "voice": "vo_adv_1257002_004",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我向公會管理協會的高層提議的事項，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就是",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "「冒險者實習」。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "所謂「冒險者實習」，",
    "voice": "vo_adv_1257002_005",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "簡單說的話……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "公會管理協會的支援成員實際接下委託，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n以冒險者的身分進行活動，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "從中學習。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "沒錯，",
    "voice": "vo_adv_1257002_006",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "要了解冒險者的想法，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n最好是自己",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "實際試著成為一名冒險者。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這次，",
    "voice": "vo_adv_1257002_007",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我的提議通過了。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我成了",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "第一號實習生。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "因此，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我希望您這位老練的冒險者，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "務必要陪同我進行冒險……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您願意幫忙嗎？",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "謝謝您！",
    "voice": "vo_adv_1257002_008",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我就知道您會這麼說。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "所以，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們現在才會像這樣進行採購。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵，",
    "voice": "vo_adv_1257002_009",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您很好奇我買了什麼嗎？",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "前陣子得到的鍊金術秘傳書上有記載藥品，我打算調製看看。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您不覺得親自從準備開始著手，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就像是一名冒險者嗎？",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "所以，",
    "voice": "vo_adv_1257002_010",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "要在這間店買的是",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這個、",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這個和……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "再來，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "還有這個！",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "好的，",
    "voice": "vo_adv_1257002_011",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "收據……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "嗯，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "收件人就用公會管理協會。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "因為是出自經費，沒問題的。",
    "voice": "vo_adv_1257002_012",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "而且，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我有很多想調製看看的藥品……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "嘿",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "咻……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "啊……",
    "voice": "vo_adv_1257002_013",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您要幫我拿東西嗎？",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "謝謝您。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我就承蒙您的好意。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那麼，",
    "voice": "vo_adv_1257002_014",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您願意繼續陪我逛幾間店嗎？",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我還有素材沒有買。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "來，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是這邊！",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "background",
    "bg_id": "501583"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後，兩人持續採購到深夜，提著大包小包的東西，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n抵達郊外的民宅。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "裡面有點亂，請進。",
    "voice": "vo_adv_1257002_015",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "啊，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這裡並不是",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我家喔。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這是公會管理協會所擁有的房子，",
    "voice": "vo_adv_1257002_016",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我這次借來當成鍊金術實驗室使用。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這裡和四周的民宅有段距離，",
    "voice": "vo_adv_1257002_017",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n如果是這裡，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "調製出現一些失敗，應該也不會造成問題。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那麼，",
    "voice": "vo_adv_1257002_018",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "事不宜遲……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "開始調製！",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "首先，從這個藥水開始。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "將準備好的素材……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "嗯嗯……",
    "voice": "vo_adv_1257002_019",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "上頭說",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就這樣持續加熱。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "原來如此原來如此……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我現在製作的是恢復用的藥水。",
    "voice": "vo_adv_1257002_020",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "來，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請看！",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n這是前所未見的反應！",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "散發出不祥的氛圍？",
    "voice": "vo_adv_1257002_021",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "沒有這回事啦。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這是遵照霍拉弗基的秘傳書進行調製。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "來，",
    "voice": "vo_adv_1257002_022",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請看。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "寫在這裡的序言。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "「化不可能為可能，這就是鍊金術」──",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這句話太棒了！",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "雖然聞起來的氣味的確很不可思議……",
    "voice": "vo_adv_1257002_023",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不過效果肯定很好。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "可以期待它具有無比強大的效果！",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "最後一道程序是就這樣持續熬煮……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "完成了。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "background",
    "bg_id": "501583"
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請看，",
    "voice": "vo_adv_1257002_024",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這個鮮豔的顏色。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n和市面販售的藥水截然不同。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "效果應該也很值得期待吧？",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "啊，",
    "voice": "vo_adv_1257002_025",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "都已經這個時間了……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "對不起，讓您陪我到這麼晚。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "畢竟",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "重頭戲是明天的冒險。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "要是陷入危機，",
    "voice": "vo_adv_1257002_026",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我會用這瓶藥水進行恢復。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "嗯",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "做好萬全準備了。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}看見花凜的笑容，在難以放心的情況下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n悄悄地回家。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500440"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "到了隔天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人走在山脈上，眺望雲海。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "好壯觀的景色……",
    "voice": "vo_adv_1257002_027",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這股魄力",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "光用報告書是無法傳達的。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "空氣也乾淨",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "新鮮。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是的。",
    "voice": "vo_adv_1257002_028",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我不能像上次那樣給您添麻煩，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我有好好睡覺與休息喔。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "雖說是實習，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不過既然接下委託，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就要認真以對。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這次的委託是",
    "voice": "vo_adv_1257002_029",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "取得棲息於山頂的怪鳥羽毛。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "雖然正面對抗的話，牠會是個危險的對手……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不過請放心。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我已經依據過去的報告書，",
    "voice": "vo_adv_1257002_030",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "事先做好對策。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們肯定沒問題的。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "好了，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們繼續保持警戒，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "朝山頂前進吧。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "正如花凜所言，兩人沒有感覺到任何危險，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n平安無事地抵達山頂。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "根據資料……",
    "voice": "vo_adv_1257002_031",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "有了！",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n那就是怪鳥的鳥巢。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "如我所料，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不見怪鳥的身影。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是的。",
    "voice": "vo_adv_1257002_032",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "和事前調查的一樣。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "有目擊情報指出……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n牠每天到了這個時段都會在山麓狩獵。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "只要仔細閱讀報告書，",
    "voice": "vo_adv_1257002_033",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n就會知道這些小事情。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就趁現在取得羽毛……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
