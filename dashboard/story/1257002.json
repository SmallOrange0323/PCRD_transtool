    "voice": "vo_adv_1257002_034",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n怎麼可能……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是怪鳥的雛鳥",
    "voice": "vo_adv_1257002_035",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "嗎……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這實在是預料之外……",
