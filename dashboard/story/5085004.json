    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你沒有必要自己一個人急著變強！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "佩可，",
    "voice": "vo_adv_5085004_071",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳是要妨礙我嗎？",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對。",
    "voice": "vo_adv_5085004_072",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我要盡全力",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妨礙你。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "當重要的人就要做出錯誤選擇的時候，",
    "voice": "vo_adv_5085004_073",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n能夠從旁提醒他：",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「這麼做真的好嗎」。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這才是──",
    "voice": "vo_adv_5085004_074",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所謂的夥伴。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "欸嘿嘿……☆",
    "voice": "vo_adv_5085004_075",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是嗎。",
    "voice": "vo_adv_5085004_076",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可是，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "如果妳要妨礙我實現願望──",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──我會打倒妳。",
    "voice": "vo_adv_5085004_077",
    "unit_id": 15811
  },
  {
    "type": "background",
    "bg_id": "510200"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔！？",
    "voice": "vo_adv_5085004_078",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好快──！？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這就是，",
    "voice": "vo_adv_5085004_079",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我的力量啊。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "background",
    "bg_id": "510200"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不對！",
    "voice": "vo_adv_5085004_080",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "或許你確實是他的力量沒錯！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但你並不是",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "現在的他所需要的東西！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "要是在緊要關頭，",
    "voice": "vo_adv_5085004_081",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "力量不夠怎麼辦？",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "background",
    "bg_id": "510200"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……唔！",
    "voice": "vo_adv_5085004_082",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n喝……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚……！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我已經受夠了。",
    "voice": "vo_adv_5085004_083",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不論是看到身邊的人受傷，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "還是看到自己對此一籌莫展。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……對吧？",
    "voice": "vo_adv_5085004_084",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯。",
    "voice": "vo_adv_5085004_085",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那就是",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我的真心話。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不。",
    "voice": "vo_adv_5085004_086",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你是騙不過我的。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真心話也好，謊言也罷，",
    "voice": "vo_adv_5085004_087",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎樣都無所謂！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你……",
    "voice": "vo_adv_5085004_088",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n忘記了一件很重要的事！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "？",
    "voice": "vo_adv_5085004_089",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我……！",
    "voice": "vo_adv_5085004_090",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我根本！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不希望你這麼做！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這跟佩可，",
    "voice": "vo_adv_5085004_091",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "有什麼關係？",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "當然有關係！",
    "voice": "vo_adv_5085004_092",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為我！",
    "voice": "vo_adv_5085004_093",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "──是跟你同桌吃飯的",
    "voice": "vo_adv_5085004_094",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "家人啊！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "！",
    "voice": "vo_adv_5085004_095",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你會因為看到我們受傷",
    "voice": "vo_adv_5085004_096",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而感到心痛，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我覺得非常開心！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你如果因此而覺得自己很沒用，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那就大錯特錯了！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一直以來，",
    "voice": "vo_adv_5085004_097",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你都是跟我們並肩作戰的不是嗎！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "即使不完美，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你依然無數次從險境之中解救了我們！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們一直",
    "voice": "vo_adv_5085004_098",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "都是被你捨命守護的對象……！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "能夠做出如此英勇行為的人，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我不會說他是弱者……！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}已經相當強大了！！",
    "voice": "vo_adv_5085004_099",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n但那種強大",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是無法用單純的力量來計測的！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果你",
    "voice": "vo_adv_5085004_100",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "得到了這股強大的力量，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n接下來會怎麼樣呢？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……你一定",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "會想要單打獨鬥對吧？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "為了保護我們而使用",
    "voice": "vo_adv_5085004_101",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "會反噬自己的力量來戰鬥。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……你忍心",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "讓我們看著你那麼做嗎！？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}。\\n就像平時一樣。",
    "voice": "vo_adv_5085004_102",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "──請把",
    "voice": "vo_adv_5085004_103",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你的力量借給我。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你害怕使用力量嗎？",
    "voice": "vo_adv_5085004_104",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還是說",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你怕那股力量會傷害到我？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你沒有必要害怕自己的力量。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你的力量，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "並不是像他這樣",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "純粹用來耀武揚威的東西。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你擁有的是與他人心意相通的力量。",
    "voice": "vo_adv_5085004_105",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是與牽起羈絆之人，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "攜手奮戰的力量。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n──我認為，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那才是你真正的力量！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請不要把這股與他人締結羈絆的溫柔力量，",
    "voice": "vo_adv_5085004_106",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n當成是",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對你自己的束縛。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果",
    "voice": "vo_adv_5085004_107",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你現在",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒辦法相信自己──",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那就請你相信我。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果這麼做還是會害怕，",
    "voice": "vo_adv_5085004_108",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n那你就想想那些",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "至今為止一起到處旅行的夥伴，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "和那些曾經一同歡笑的朋友。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那些回憶肯定",
    "voice": "vo_adv_5085004_109",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "會成為你的心靈支柱。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請你閉上眼，",
    "voice": "vo_adv_5085004_110",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "試著凝神細聽。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你肯定聽得到才對。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那些可靠又令人安心的，",
    "voice": "vo_adv_5085004_111",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n重要的人們，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "她們溫柔的聲音……！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──來！",
    "voice": "vo_adv_5085004_112",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──過來！",
    "voice": "vo_adv_5085004_113",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──緊給我醒來，",
    "voice": "vo_adv_5085004_114",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你這個貪睡蟲──────！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510200"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……雖然跟我原本預想的溫柔聲音",
    "voice": "vo_adv_5085004_115",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有一點點的落差，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但你聽到了對吧♪",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_5085004_116",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……唔",
    "voice": "vo_adv_5085004_117",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不行。",
    "voice": "vo_adv_5085004_118",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n妳無法駕馭。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "現在的我的力量，",
    "voice": "vo_adv_5085004_119",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "已經不是佩可一個人",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "足以承受的了。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……或許",
    "voice": "vo_adv_5085004_120",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是吧。",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "肯定不行的。",
    "voice": "vo_adv_5085004_121",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不管是我一個人，",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還是你一個人。",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "為此──",
    "voice": "vo_adv_5085004_122",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "貪吃佩可朝眼前舉起劍。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與此同時，在另一邊則是──",
    "voice": null,
    "unit_id": null
  }
]
