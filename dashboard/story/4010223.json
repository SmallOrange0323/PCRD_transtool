    "voice": "vo_adv_4010223_001",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "充滿陽光般的壓力感覺比平常還強……！",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
