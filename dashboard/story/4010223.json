    "name": "碧卡拉",
    "words": "咦？",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "在對面的是……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n幸運鼠跟、",
