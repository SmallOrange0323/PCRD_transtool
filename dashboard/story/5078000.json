    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "明明就感覺到了反逆獸的氣息，",
