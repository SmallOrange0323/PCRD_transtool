  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "怎～麼啦？{0}。",
    "voice": "vo_adv_1052500_000",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n突然把我叫出來。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n找我有什麼事嗎？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哇～！",
    "voice": "vo_adv_1052500_001",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這麼多都是要給人家的？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你說這是我的生日禮物？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我好開心唷！",
    "voice": "vo_adv_1052500_002",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你也一起吃吧？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n這樣一定",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "會是更棒的生日！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我很樂意♪",
    "voice": "vo_adv_1052500_003",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我們要玩什麼呢？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n咦？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "{0}已經想好了？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n一整天的行程都排好了？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "為什麼……",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "難、",
    "voice": "vo_adv_1052500_004",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "難道是因為",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "今天是人家生日？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你替人家想了很多？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "討厭！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "光這點就已經是最棒的禮物了啦！",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "該道謝的是我啦。",
    "voice": "vo_adv_1052500_005",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n總是受到你的幫助，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "讓我度過很多快樂的時光。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你怎麼會突然說起這個呀？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "因為今天是人家的生日，",
    "voice": "vo_adv_1052500_006",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "所以想再次鄭重地表達謝意……？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "討厭，",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "明明你不用刻意這麼做也沒關係的。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "因為總是能感受到",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你溫暖的心意。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "沒想到今天能變成那麼美妙的一天！",
    "voice": "vo_adv_1052500_007",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
