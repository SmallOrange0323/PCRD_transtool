[
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "欸，",
    "voice": "vo_adv_5126302_000",
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "如果是人家誤會那很抱歉……",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n不過阿爾杰什寶",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是不是變得比剛才更有精神了啊～！？",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔……",
    "voice": "vo_adv_5126302_001",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "起床運動已經做完了是吧？",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "挺有趣的嘛！",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "真是個囂張的小姑娘。",
    "voice": "vo_adv_5126302_002",
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "\\n然而妳的魔力，",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "根本遠遠不及安布羅斯……！",
    "voice": null,
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……哼，",
    "voice": "vo_adv_5126302_003",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可以不要擅自拿我來比較嗎？",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那種800年前的偉人，",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我哪知道是誰啊！",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而且，不管我",
    "voice": "vo_adv_5126302_004",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "究竟比不比得上那個偉人，",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n都跟你沒關係。",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "阿爾杰什",
    "words": "……妳想說什麼？",
    "voice": "vo_adv_5126302_005",
    "unit_id": 17711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我的意思是，無論如何",
    "voice": "vo_adv_5126302_006",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你都會被我打倒！！",
    "voice": null,
    "unit_id": 127211
  }
]
