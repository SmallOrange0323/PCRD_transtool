    "name": "佳凜",
    "words": "啊，",
    "voice": "vo_adv_1185004_057",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n所以您才會把見到什麼人的資訊告訴她們啊。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "畢竟{0}的人脈",
    "voice": "vo_adv_1185004_058",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "也和我們不相上下呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "\\n小姑娘也是他的熟人對吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "不，",
    "voice": "vo_adv_1185004_059",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我是……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "哎呀！",
    "voice": "vo_adv_1185004_060",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "看你身邊的女孩子",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "總是一個換過一個，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "\\n你的花言巧語終於也達到這種程度了！",
    "voice": null,
    "unit_id": null
  },
