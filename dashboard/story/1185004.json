    "type": "dialogue",
    "name": "大媽2",
    "words": "哎，",
    "voice": "vo_adv_1185004_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "沒關係啦。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "\\n話說回來妳聽說了嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "二丁目的鈴木太太……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "看來她們發現",
    "voice": "vo_adv_1185004_035",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "山田太太了呢。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "還是一樣聊著八卦",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "根本沒有撿垃圾就是了。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "從他與老爺爺的對話聽起來，",
    "voice": "vo_adv_1185004_036",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n還以為他在一來一往間讓人提起了某種幹勁，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "看來是我想太多了呢……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "啊，",
    "voice": "vo_adv_1185004_037",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "沒事。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "沒什麼。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n我們繼續撿垃圾吧。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "嗯……",
    "voice": "vo_adv_1185004_038",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "看來這次是白費工夫了。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "哎，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "這也沒辦法。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "哦～哦，歡迎回來！",
    "voice": "vo_adv_1185004_039",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "\\n今天也託了{0}的福，收集到了大量垃圾。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "畢竟在那之後也一步一腳印地認真撿著垃圾嘛。",
    "voice": "vo_adv_1185004_040",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n當然會很大量啦。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "咦？",
    "voice": "vo_adv_1185004_041",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "那是……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "啊！",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "呵呵呵，",
    "voice": "vo_adv_1185004_042",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "這份量你覺得如何。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n我可還不會輸給年輕人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "雖然這垃圾量很可觀……",
    "voice": "vo_adv_1185004_043",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "不過有那麼多垃圾可撿嗎？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "嗯？",
    "voice": "vo_adv_1185004_044",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "不是，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "這是從認識的爺爺奶奶家裡回收來的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n再怎麼說都不能輸給年輕人啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "不、",
    "voice": "vo_adv_1185004_045",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "不是，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "這樣一來不就算不上市內清潔活動了……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "啊哈哈！",
    "voice": "vo_adv_1185004_046",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "無妨無妨。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "\\n長輩精神飽滿是再好也不過的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "這、",
    "voice": "vo_adv_1185004_047",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "再加上",
    "voice": "vo_adv_1185004_048",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "這對捨不得丟東西的長輩來說，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "\\n剛好是次不錯的斷捨離。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "\\n換成我們挨家挨戶造訪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "可沒辦法這麼順利。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "原、",
    "voice": "vo_adv_1185004_049",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "原來如此……？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "對地區活性化有所助益，",
    "voice": "vo_adv_1185004_050",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "是這個意思沒錯吧？　",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "我們也不差哦！",
    "voice": "vo_adv_1185004_051",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "看清楚了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "哇，",
    "voice": "vo_adv_1185004_052",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "這量真的很誇張……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "不過",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "這是為什麼？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "啊哈哈，",
    "voice": "vo_adv_1185004_053",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "妳以為我們只是在閒聊嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "\\n是啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "旁人總是這麼認為的呢──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "活用IT撿垃圾，",
    "voice": "vo_adv_1185004_054",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "沒那麼誇張啦。",
    "voice": "vo_adv_1185004_055",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "\\n只是鄰居交流罷了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "有人就算無法完整參與清潔活動，",
    "voice": "vo_adv_1185004_056",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "\\n還是願意稍微幫個忙。",
    "voice": null,
    "unit_id": null
  },
  {
