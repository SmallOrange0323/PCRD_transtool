[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在街上走著的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n偶然遇見了花凜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "啊，是{0}。\\n你來得正好。",
    "voice": "vo_adv_1185004_000",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是啊。",
    "voice": "vo_adv_1185004_001",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "要說拜託",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "應該也算是種拜託吧？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "啊──你誤會了你誤會了！",
    "voice": "vo_adv_1185004_002",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不是前陣子提到的那種事。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "確實",
    "voice": "vo_adv_1185004_003",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "有好幾個案件想請你幫忙，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n可是情報收集方面差了一些，還不夠完整。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那部分感覺還差了幾分火侯。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "明明說過要請您吃頓好吃的但卻還沒做到，",
    "voice": "vo_adv_1185004_004",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我想起的是這件事。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "所以說呢，",
    "voice": "vo_adv_1185004_005",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "現在和我一起去吃午飯吧。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我從職場同事那裡打聽到了推薦的店家。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "嗯，",
    "voice": "vo_adv_1185004_006",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請好好期待吧……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "咦，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "怪了？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n怎麼有奇怪的光芒…",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "怎，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這怎麼回事？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "那麼",
    "voice": "vo_adv_1185004_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "今天也來進行",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "市內清潔活動吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "\\n{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "一直以來真是感謝你。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "\\n像你這樣的年輕人願意參加",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "我感到很高興。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "到剛剛分配",
    "voice": "vo_adv_1185004_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "給各位的區域撿拾垃圾，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "\\n等時間一到",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "再回這裡集合，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "拜託大家了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "好～的。",
    "voice": "vo_adv_1185004_009",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就在{0}默默地撿拾掉在地上的垃圾之際──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "你好。",
    "voice": "vo_adv_1185004_010",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "在假日撿垃圾，還真是個奇妙的年輕人呢。",
    "voice": "vo_adv_1185004_011",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "如果不嫌棄的話，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "願意讓我幫你忙嗎？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "哎哎。",
    "voice": "vo_adv_1185004_012",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "俗話說有緣千里來相會不是嗎。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "馬上就看到了空罐。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "要是沒有亂丟垃圾的人，",
    "voice": "vo_adv_1185004_013",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n或許也就不用做這種麻煩的事了，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n世事總是不從人意呢。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "不過街道變乾淨的話",
    "voice": "vo_adv_1185004_014",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "也會讓想亂丟垃圾的人多上幾分猶豫吧。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "讓我們一路撿個乾淨吧。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "您家的",
    "voice": "vo_adv_1185004_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "孩子真的很上進呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "才沒那種事。",
    "voice": "vo_adv_1185004_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "那孩子假日整天都在睡覺，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "\\n根本不願意幫忙做家事。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "那些人",
    "voice": "vo_adv_1185004_017",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "也和您一樣是出來撿垃圾的",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "對吧？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "怎麼從剛剛就一直聊個不停……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "啊，",
    "voice": "vo_adv_1185004_018",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "可是",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "叮嚀她們的話會不會惹人嫌……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "嗯，",
    "voice": "vo_adv_1185004_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "什麼事？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "咦？",
    "voice": "vo_adv_1185004_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "你指的是三丁目的山田太太嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "\\n哎呀，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "最近都沒有她的消息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽2",
    "words": "\\n真想久違地和她見個面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "她還在那邊嗎？",
    "voice": "vo_adv_1185004_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "我們快過去看看！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "……走掉了。",
    "voice": "vo_adv_1185004_022",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "那個，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "結果撿垃圾的人，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n只剩下您了的說……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "說什麼不要緊……",
    "voice": "vo_adv_1185004_023",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n你的意思是在那聊天，不如趕快離開還比較好一點是嗎？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "啊，",
    "voice": "vo_adv_1185004_024",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "好、",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "好的！",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "……走掉了。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "嗯？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "只是個濫好人？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n真是搞不懂的孩子呢。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "哦，",
    "voice": "vo_adv_1185004_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "是{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n哎呀，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "不愧是年輕人，撿了不少呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n我完全不行呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "就是說啊。",
    "voice": "vo_adv_1185004_026",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n老爺爺就慢慢地以自己的步調……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "哈哈哈，",
    "voice": "vo_adv_1185004_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "雖然很感謝你的好意，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n但我也還不會認輸。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "哈哈哈，",
    "voice": "vo_adv_1185004_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "年輕人口氣還真大。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "\\n哎，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "老頭子也有老頭子的智慧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "……啊，",
    "voice": "vo_adv_1185004_029",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "難不成。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "嗯？",
    "voice": "vo_adv_1185004_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "小姑娘。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老爺爺",
    "words": "妳說的難不成指的是什麼？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "沒事沒事，",
    "voice": "vo_adv_1185004_031",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "沒什麼。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n請別放在心上。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "background",
    "bg_id": "510124"
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "那個，山田太太，",
    "voice": "vo_adv_1185004_032",
