  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "忘了報上名號真是非常抱歉。",
    "voice": "vo_adv_1185004_067",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n其實我",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "做的是這種工作……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "不僅限於日本，",
    "voice": "vo_adv_1185004_068",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "也會在世界各地四處尋找有趣人才，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n我的名字叫觀崎佳凜。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我從某個情報來源",
    "voice": "vo_adv_1185004_069",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "聽說了您的傳聞，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "因此前來挖角。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "不嫌棄的話",
    "voice": "vo_adv_1185004_070",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "要不要和我一起共事看看呢？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "在敝公司服務的人才之中，",
    "voice": "vo_adv_1185004_071",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "就連小學生或國中生都有，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n因此不會有任何問題的。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "哎呀哎呀。",
    "voice": "vo_adv_1185004_072",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "我聽說了許多關於你的傳聞。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "總之",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "先讓我對事業內容做個介紹吧。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "讓您的人脈",
    "voice": "vo_adv_1185004_073",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "以及打動他人的魅力",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "發揮得淋漓盡致吧！",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "人脈這點先不提……",
    "voice": "vo_adv_1185004_074",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "打動他人的魅力？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "應該說是",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "擅長被使喚，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我覺得這樣比較貼切的說……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "哎，不過確實一旦見到你，",
    "voice": "vo_adv_1185004_075",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就會神奇地冒出一股",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "得努力才行的心情就是了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "呃，",
    "voice": "vo_adv_1185004_076",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "先不提這個！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也遇見了花凜對吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n而且好像還被她挖角了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "儘管不清楚花凜到底都做些什麼工作，",
    "voice": "vo_adv_1185004_077",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但我想她不會叫你做壞事才對，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n試著幫她工作應該也蠻有趣的吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然可能不是什麼輕鬆的工作，",
    "voice": "vo_adv_1185004_078",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但凡事都講究經驗，經驗很重要的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那麼就改天見啦♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "嗯、",
    "voice": "vo_adv_1185004_079",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "嗯嗯……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "咦，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "怪了？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "站著睡著了嗎？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "疲勞管理應該萬無一失才對……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "而且感覺",
    "voice": "vo_adv_1185004_080",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我好像做了什麼奇怪的夢……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "咦？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n您也做了夢……？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n被我挖角的夢？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我也做了一樣的夢呢。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不可思議的事情果然存在呢。",
    "voice": "vo_adv_1185004_081",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n更何況……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "挖角早就完成了對吧？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "所以說……",
    "voice": "vo_adv_1185004_082",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "為了明朗快樂的蘭德索爾，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請你和我一起工作吧？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "為此",
    "voice": "vo_adv_1185004_083",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "得先填飽肚子才行。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們員工福利",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "也是很完善的！",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一邊跟在步伐輕快的花凜身後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}一邊任憑思緒想像著明朗快樂的未來。",
    "voice": null,
    "unit_id": null
  }
]
