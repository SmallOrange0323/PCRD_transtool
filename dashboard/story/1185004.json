    "words": "一、",
    "voice": "vo_adv_1185004_061",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "一個換過一個？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "唉……",
    "voice": "vo_adv_1185004_062",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "真是人不可貌相呢。",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "哎，",
    "voice": "vo_adv_1185004_063",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "{0}身邊不管帶著什麼女孩，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大媽1",
    "words": "\\n都不會讓人感到驚訝就是了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "就是說啊。",
    "voice": "vo_adv_1185004_064",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "畢竟全都是些願意幫忙撿拾垃圾的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "城內自治會會長",
    "words": "好孩子呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "擁有不可思議魅力的少年……",
    "voice": "vo_adv_1185004_065",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "\\n和我事前打聽到的",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "情報相符，",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "應該是這樣吧？",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "啊，",
    "voice": "vo_adv_1185004_066",
    "unit_id": 118531
  },
  {
    "type": "dialogue",
    "name": "佳凜",
    "words": "那個……",
    "voice": null,
    "unit_id": 118531
  },
  {
    "type": "still",
