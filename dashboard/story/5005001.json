[
  {
    "type": "background",
    "bg_id": "500281"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}、珠希和美冬\\n在不知何時被沖上岸的海灘分頭探尋著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "如何，",
    "voice": "vo_adv_5005001_000",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "珠希？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那個方向有沒有人在？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沒想到竟然",
    "voice": "vo_adv_5005001_001",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "有很多隻貓咪呢喵～！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "大隻的、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "小隻的、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n條紋的、混色的和花斑的小貓們……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n拼命地向我撒嬌示好呢喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "好可愛喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣啊，",
    "voice": "vo_adv_5005001_002",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "有很多隻貓咪真是太好了……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不對，",
    "voice": "vo_adv_5005001_003",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "才不好！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "現在可不是和貓咪玩耍的時候吧！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我、",
    "voice": "vo_adv_5005001_004",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我～也有好好調查過有沒有人在喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n但是在調查的範圍裡",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "到處都沒有看見人影喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣嗎，",
    "voice": "vo_adv_5005001_005",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我這裡也是類似的結果呢。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "都是小狗之類的小動物，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "感受不到有人在的跡象……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "{0}呢……？",
    "voice": "vo_adv_5005001_006",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "看你愁眉苦臉的樣子",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "應該也是一樣的結果呢……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "唉……",
    "voice": "vo_adv_5005001_007",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "話說肚子好像開始餓起來了喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "確實。",
    "voice": "vo_adv_5005001_008",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "雖然不曉得正確的時間，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但應該也差不多到晚餐時間了吧。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "因為連船本身都不見了，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "釣到的魚也沒了……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n今天的晚餐，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "該怎麼辦才好呢……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊……",
    "voice": "vo_adv_5005001_009",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我剛剛看到在那邊的海裡有大魚的影子！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "{0}、",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "珠希，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n同心協力來捉魚吧！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "{0}踩進海裡，",
    "voice": "vo_adv_5005001_010",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "把魚往我這個方向趕。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n然後我會用槍把魚打上來，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n最後由珠希捕捉！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我知道了喵！",
    "voice": "vo_adv_5005001_011",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n來吧，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "把魚趕到美冬的方向喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對，{0}，做得不錯呢！",
    "voice": "vo_adv_5005001_012",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n就是這個氣勢哦！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "{0}不用試圖去抓也沒關係啦！",
    "voice": "vo_adv_5005001_013",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n趕過來我這邊就好！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "來了！",
    "voice": "vo_adv_5005001_014",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "珠希，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我要把魚打上來，抓好囉！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "看招────！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "交給我喵────！",
    "voice": "vo_adv_5005001_015",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n捕──────捉！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "抓到了喵──────────！",
    "voice": "vo_adv_5005001_016",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "太好了呢！",
    "voice": "vo_adv_5005001_017",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "　馬上烤來吃吧！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我來用樹枝摩擦生火！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "各式各樣的打工經驗可不只是擺著好看喔！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "喝啊────！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "background",
    "bg_id": "500282"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呼……",
    "voice": "vo_adv_5005001_018",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "好好吃喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "肚子吃得好飽喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呵呵，",
    "voice": "vo_adv_5005001_019",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n也許生存能力還滿強的嘛！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊，",
    "voice": "vo_adv_5005001_020",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "剛好這裡",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "有像是睡袋一樣蓬鬆的草喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "今晚就在這待到天亮喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也是，",
    "voice": "vo_adv_5005001_021",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "今天耗費了不少體力……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n暫且就先休息吧。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "晚安啦……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "background",
    "bg_id": "500280"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "早上了喵────！",
    "voice": "vo_adv_5005001_022",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這個草，",
    "voice": "vo_adv_5005001_023",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好像比想像中還舒適呢！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "接下來……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "只要找到逃出這個小島",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "所需的東西，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n就太完美了……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對了，",
    "voice": "vo_adv_5005001_024",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "昨天還留有一些沒調查的區域……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "要說原因的話，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n因為有幾隻魔物在附近徘徊",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "所以效率不太好呢。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那麼，",
    "voice": "vo_adv_5005001_025",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "順便當作提神，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "大家一起去擊退喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯，",
    "voice": "vo_adv_5005001_026",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就這麼做吧！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n大家，往這裡，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "跟我來！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "果然……",
    "voice": "vo_adv_5005001_027",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那裡有魔物們在呢。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n趕緊把它們趕跑吧！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕歐歐歐歐歐！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵哈，",
    "voice": "vo_adv_5005001_028",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這樣是嚇不倒我的喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嘿、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嘿、",
    "voice": null,
    "unit_id": 107911
  },
