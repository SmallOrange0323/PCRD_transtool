    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "坦白說，",
    "voice": "vo_adv_5116001_038",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下還分辨不出來",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n到底哪個是哪個。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不，",
    "voice": "vo_adv_5116001_039",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我只是碰巧知道剛才的問題……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "何況，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我是來這裡學習自己不懂的事情。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "……所以，",
    "voice": "vo_adv_5116001_040",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n這個陷阱的種類與各自的效果──",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "background",
    "bg_id": "501680"
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "哈哈哈，",
    "voice": "vo_adv_5116001_041",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "你們在上午耗了不少腦力吧？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n現在開始是活動身體的時間。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "下午是要到原野進行實踐課程，",
    "voice": "vo_adv_5116001_042",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "學習各種技術，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n以及訓練遊俠動物等等。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "光聽課是學不會的。",
    "voice": "vo_adv_5116001_043",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "總之，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "就是要反覆實踐。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "魔物的幻影",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "集訓學生3",
    "words": "唔哇！？",
    "voice": "vo_adv_5116001_044",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "集訓學生3",
    "words": "魔、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "集訓學生3",
    "words": "魔物！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "哈哈哈，",
    "voice": "vo_adv_5116001_045",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "你們不必那麼慌張。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "那是用幻影魔法製作的冒牌貨。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "今天就用這個魔法，",
    "voice": "vo_adv_5116001_046",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "來學習魔物的種類和身體特徵，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "以及生態。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "啊，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "特別是弱點與要害。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "雖然這些知識常被認為只能用在狩獵與討伐上──",
    "voice": "vo_adv_5116001_047",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "不過其實，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "也有助於保護魔物。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "要治療人類，",
    "voice": "vo_adv_5116001_048",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "也必須了解身體構造吧？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "兩者是一樣的。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "知道要害與弱點，",
    "voice": "vo_adv_5116001_049",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "就能預測對方的行動。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n也可以在受傷或生病時，來應對處理。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "是否有危險、",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "讓對方安分下來的方法──",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "要知道的事情多得很。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "雖然也有人認為要順其自然，",
    "voice": "vo_adv_5116001_050",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "不過作為遊俠，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "有時也會治療魔物的疾病和傷勢。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "好，",
    "voice": "vo_adv_5116001_051",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "那麼首先，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "從森林常見的魔物開始──",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "最後將繃帶綁好……",
    "voice": "vo_adv_5116001_052",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這樣如何呢？",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "魔物的幻影",
    "words": "咕喔喔喔喔喔♪",
