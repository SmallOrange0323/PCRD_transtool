    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "沒事的沒事的。",
    "voice": "vo_adv_5116001_060",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
