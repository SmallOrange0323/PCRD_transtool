    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "那麼，",
