    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "喔，",
    "voice": "vo_adv_5116001_053",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "妳包紮得相當好。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n看來似乎很熟練呢。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在主公大人失去記憶的時候，",
    "voice": "vo_adv_5116001_054",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下常常處理跌倒擦傷的傷口。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這點事情",
