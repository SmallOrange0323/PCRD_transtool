    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下已經習慣了。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "魔物的幻影",
    "words": "嘎喔喔喔喔喔……？",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": "vo_adv_5116001_055",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個，",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您的繃帶用得稍微有點多……",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不對，",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不如說這個綁法",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看上去似乎有些藝術感……？",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "的確，",
    "voice": "vo_adv_5116001_056",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然這不是想綁就模仿得來的包紮方法……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但應急處置不需要藝術感吧……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "使用醫療用具可不能浪費。",
