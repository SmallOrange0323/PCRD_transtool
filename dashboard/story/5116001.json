[
  {
    "type": "background",
    "bg_id": "500080"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "遊俠集訓第一天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "早安。",
    "voice": "vo_adv_5116001_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n馬上就要開始上課了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": "vo_adv_5116001_001",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "早安。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n昨晚睡得好嗎？",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "集訓所有提供租制服租借，",
    "voice": "vo_adv_5116001_002",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們就換了衣服。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我是以使用弓箭為主，",
    "voice": "vo_adv_5116001_003",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n所以選擇了這件符合我需求的服裝。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": "vo_adv_5116001_004",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "經常使用藥草等東西，",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n所以選擇這件身上能多帶一些東西的服裝。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "聽說",
    "voice": "vo_adv_5116001_005",
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "遊俠有不同的類型，",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n所以有各式各樣的制服。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這是個深奧的世界，",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "甚至會讓人不禁陷入迷惘。",
    "voice": null,
    "unit_id": 125312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不過，",
    "voice": "vo_adv_5116001_006",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "像這樣穿上制服，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n有種集訓終於要開始的感覺，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "會讓人鼓起幹勁。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "……嗯，",
    "voice": "vo_adv_5116001_007",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "看來大家都到齊了。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "我現在要說明集訓課程。",
    "voice": "vo_adv_5116001_008",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "在場的人都是來考取遊俠資格的，",
    "voice": "vo_adv_5116001_009",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n不過在這之前，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "我先從何謂遊俠開始說明吧。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "一般而言，",
    "voice": "vo_adv_5116001_010",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "靠狩獵維持生計的人，稱為獵人。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n他們的目的是狩獵，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "必要時，也會負責討伐魔物，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n防止牠們危害到人類。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "相對的，",
    "voice": "vo_adv_5116001_011",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "遊俠",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "是以保護自然環境與居住於該處的動植物生態系──",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n包含魔物在內的",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "所有環境為目的來進行活動。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "他們會逮捕非法的盜獵者",
    "voice": "vo_adv_5116001_012",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "並為了守護動物和魔物進行保護活動，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n要是判斷有必要的話，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "有時也會討伐危險的魔物。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "不過",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "這是最後的手段。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "在自然與人類間，",
    "voice": "vo_adv_5116001_013",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "為了不偏向任何一方，設法取得平衡。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n因此，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "需要有能夠應對任何場面的能力。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "──這就是遊俠。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "所以，",
    "voice": "vo_adv_5116001_014",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "第一天就像這樣態度鬆懈的傢伙──",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "集訓學生1",
    "words": "嗯啊",
    "voice": "vo_adv_5116001_015",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "集訓學生1",
    "words": "！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "集訓學生2",
    "words": "喂、",
    "voice": "vo_adv_5116001_016",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "集訓學生2",
    "words": "喂……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "集訓學生2",
    "words": "打中人的粉筆碎成粉末了耶。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "集訓學生2",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "集訓學生2",
    "words": "多麼驚人的威力……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "集訓學生2",
    "words": "呃啊",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "集訓學生2",
    "words": "啊！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "廢話連篇的你也一樣，",
    "voice": "vo_adv_5116001_017",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "上完課後追加訓練。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n我會徹底改正你們劣根性。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "集訓學生2",
    "words": "眼睛，",
    "voice": "vo_adv_5116001_018",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "集訓學生2",
    "words": "我的眼睛！！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "聽好了，",
    "voice": "vo_adv_5116001_019",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "這個集訓會保障你們的食衣住，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n是為了",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "要讓你們專注於學習上。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "在場的人",
    "voice": "vo_adv_5116001_020",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "都必須要",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n迅速地",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "盡快成為能派上用場的人才。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "我們可不是為了讓你們吃閒飯，",
    "voice": "vo_adv_5116001_021",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n才像這樣把人聚集起來。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "那麼，",
    "voice": "vo_adv_5116001_022",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "從已經聽懂的人開始，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "過來領取教科書。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "你們在這個時間將要學習狩獵的相關法令、",
    "voice": "vo_adv_5116001_023",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n魔物與鳥獸的生態系和判別方法，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "以及如何操作狩獵用具。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "教科書都拿到了嗎？",
    "voice": "vo_adv_5116001_024",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "──那邊最前排的學生。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是、",
    "voice": "vo_adv_5116001_025",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是指我……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗎？",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "這",
    "voice": "vo_adv_5116001_026",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "邊放著的所有陷阱中，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n請妳試著以目前蘭德索爾允許使用的",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n和未允許使用的來分類吧。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "啊，",
    "voice": "vo_adv_5116001_027",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "在教科書第──",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，",
    "voice": "vo_adv_5116001_028",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "沒關係……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我分類好了。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這是",
    "voice": "vo_adv_5116001_029",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "分成利用繩索來捕捉獵物的套索陷阱類，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n以及能關住獵物的陷阱籠",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "和圍欄陷阱類……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對吧？",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "另外，",
    "voice": "vo_adv_5116001_030",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "沒有安全裝置的陷阱應該是不能使用的，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我先把它們分到這邊了……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "嗯……",
    "voice": "vo_adv_5116001_031",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "答對了。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "妳將作為陷阱題所準備的用具",
    "voice": "vo_adv_5116001_032",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "也正確分類出來了呢。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "妳曾經",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "有用陷阱狩獵的經驗嗎？",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不，",
    "voice": "vo_adv_5116001_033",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "與其說是狩獵，應該說是牧場守衛……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "吧。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "以前剛好製作過幾次這樣的陷阱。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "好了，",
    "voice": "vo_adv_5116001_034",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "妳回座吧。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "總之，",
    "voice": "vo_adv_5116001_035",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "雖然簡單來說都是陷阱，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "\\n但是也有現在不允許使用的用具。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "首先，",
    "voice": "vo_adv_5116001_036",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "精靈族教官",
    "words": "我要你們把這些知識牢牢地記在腦裡。",
