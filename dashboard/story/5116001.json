  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "……嗯，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "從頭再試一次吧！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "好，",
    "voice": "vo_adv_5116001_058",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "獸人教官",
    "words": "接下來是觀察實際出現於原野的魔物。",
