[
  {
    "type": "background",
    "bg_id": "510360"
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "競合店からも視察が来るとはな。",
    "voice": "vo_adv_6106104_000",
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "そういった手合いへの対処も、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "考えておくに越したことはないな。",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nなにか妙案はないものか……",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "貴公も意見を聞かせてくれないか。",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "そうか、",
    "voice": "vo_adv_6106104_001",
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "来る者に疑いのまなざしを向けて……",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "視線で殺す、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "と。",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nきっと後ろ暗い思いのある輩は逃げ出すに違いないな！",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "って、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "それでは普通のお客も入ってくれないではないか！",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "仲良く……？　",
    "voice": "vo_adv_6106104_002",
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "そうか、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "二重スパイというやつだな！",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nいかにも軍人らしい対処法だ、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "実にカッコいいではないか！",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "それらしき人物を見たら、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "積極的に声をかけてみるとしよう。",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ほう、",
    "voice": "vo_adv_6106104_003",
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "むしろ堂々とこちらから出向いてやろうというわけか。",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "それなら競合店の偵察もできるし、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "甘味も思うさま堪能できて",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n一石二鳥……",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "あっ、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "いや、",
    "voice": null,
    "unit_id": 105312
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "今のは聞かなかったことに……",
    "voice": null,
    "unit_id": 105312
  }
]
