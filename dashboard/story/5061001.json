    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我感到非常榮幸！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "那麼莉瑪小姐，",
    "voice": "vo_adv_5061001_056",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "我來帶您去宅邸吧。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n請跟我來。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "background",
    "bg_id": "501240"
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哇啊！",
    "voice": "vo_adv_5061001_057",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不只從外面看很壯觀，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n裡面也非常豪華呢！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真的",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就像是在做夢一樣。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "光是能夠來到這裡，我就已經滿足了。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "莉瑪小姐是第一次來到貴族的宅邸呀。",
    "voice": "vo_adv_5061001_058",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是的。",
    "voice": "vo_adv_5061001_059",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊，果然",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "像我這樣的人，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "並不適合",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "參加舞會嗎？",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "不，",
    "voice": "vo_adv_5061001_060",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "請不用在意您的出身。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "羅伊德大人",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "對於身世方面也並沒有特別要求。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "太好了。",
    "voice": "vo_adv_5061001_061",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我還想說要是參加舞會前，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n就直接",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "被判喪失資格的話，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那該怎麼辦才好呢。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "哎呀，",
    "voice": "vo_adv_5061001_062",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "您來得正好呢。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n羅伊德大人，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "有參加者來訪了。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "嗯，",
    "voice": "vo_adv_5061001_063",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "初次見面，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "我是這間宅邸的主人，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "羅伊德。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "\\n謝謝妳",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "特地來參加這次舞會。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不、",
    "voice": "vo_adv_5061001_064",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不會，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我才是呢，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "竟然能受邀來到如此壯觀的宅邸，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n真的非常感謝您。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "該怎麼說呢，",
    "voice": "vo_adv_5061001_065",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "雖然很有氣質，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也完全沒有居高臨下的討厭感覺，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但是",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "總覺得他看起來並不開心……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "明明他是這次舞會的主辦人，",
    "voice": "vo_adv_5061001_066",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "為什麼會這樣呢？　",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "那麼",
    "voice": "vo_adv_5061001_067",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "我就先告辭了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "\\n瑪莎，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "之後的事就麻煩妳了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "一切都交給我吧。",
    "voice": "vo_adv_5061001_068",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "那麼莉瑪小姐，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "雖然我們邀請您",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "來到了這裡，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n但是很遺憾，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "我們無法馬上讓您參加舞會。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？",
    "voice": "vo_adv_5061001_069",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那、",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那是什麼意思？",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "想要參加舞會的話，",
    "voice": "vo_adv_5061001_070",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n必須具有與之相符的禮節與教養。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "從現在開始的幾天內，",
    "voice": "vo_adv_5061001_071",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "我們要請您接受各式各樣的課程，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n並將所學的事情牢記在心。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "或許您會認為我們太自作主張，",
    "voice": "vo_adv_5061001_072",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "但是",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "這可是必要的過程。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n當然您也可以拒絕接受課程。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "即使無法參加舞會，",
    "voice": "vo_adv_5061001_073",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "我們仍會竭盡全力招待您的。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n請問您意下如何呢？",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "莉瑪小姐。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "原來如此，",
    "voice": "vo_adv_5061001_074",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "原本還覺得一切太過順利了，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "原來是這麼一回事啊。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我的答案早就決定好了。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我",
    "voice": "vo_adv_5061001_075",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "決定要接受課程！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "我了解了。",
    "voice": "vo_adv_5061001_076",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "那麼請容我重新招呼您──",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "歡迎您",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "來到社交界的入口。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我一直以來嚮往的",
    "voice": "vo_adv_5061001_077",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "輝煌世界，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我完全沒想過在未來的某一天，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "竟然有機會能來到其中。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "為了回報連禮服都幫我準備好的似似花，",
    "voice": "vo_adv_5061001_078",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我絕對要",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好好把握這個機會！　",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "面對著憧憬的世界，莉瑪立下了堅定的決心。",
    "voice": null,
    "unit_id": null
  }
]
