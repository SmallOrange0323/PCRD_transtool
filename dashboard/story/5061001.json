[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "莉瑪在鎮上突然受邀參加舞會，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n由於這邀約實在太出乎預料，她不禁感到驚慌失措。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那、",
    "voice": "vo_adv_5061001_000",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那個，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "您真的要邀請我這種人去參加",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "舞、",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "舞會嗎……？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真、",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真的可以嗎？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我可會當真的哦？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "那當然，",
    "voice": "vo_adv_5061001_001",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "主人就是在尋找像您這樣的女性。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "\\n請您務必要來參加。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "騙人騙人！",
    "voice": "vo_adv_5061001_002",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這種事真的有可能會發生嗎！？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n簡直就像是故事中的女主角一樣！　",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "實在太過湊巧了，簡直讓我懷疑這是不是一場夢，但是……",
    "voice": "vo_adv_5061001_003",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就算是夢又怎樣！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這種機會",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "絕不會再有第二次了！　",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那、",
    "voice": "vo_adv_5061001_004",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那個……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果不嫌棄我的話，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "請務必讓我參加舞會！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "哦哦，",
    "voice": "vo_adv_5061001_005",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "能聽到您這麼說，我真是太感激了。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "我的主人肯定也會很高興的。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "那麼這張邀請函，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "還請您收下了。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "非、",
    "voice": "vo_adv_5061001_006",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "非常感謝！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "對了，",
    "voice": "vo_adv_5061001_007",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "有一件事必須先告訴您。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "舞會是社交場合，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "\\n請您前來參加時，務必穿著與其相襯的服裝。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "您指的是……",
    "voice": "vo_adv_5061001_008",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "像這種禮服，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "正是如此。",
    "voice": "vo_adv_5061001_009",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "那麼",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "僕人",
    "words": "就恭候您的大駕光臨了。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "該、",
    "voice": "vo_adv_5061001_010",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "該怎麼辦啊──！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "明明是個難得的機會，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "卻碰上這種問題！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "神明實在是太壞心眼了……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果是故事裡的話，這時候就會出現魔法師婆婆，",
    "voice": "vo_adv_5061001_011",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n為我準備好禮服與玻璃鞋了……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不可能會那麼順利的吧。",
    "voice": "vo_adv_5061001_012",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n果然",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "只能放棄了嗎……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "──我找妳很久囉，",
    "voice": "vo_adv_5061001_013",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "莉瑪。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n妳似乎很喜歡",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "用人類的樣貌逛街呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "魔、",
    "voice": "vo_adv_5061001_014",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "魔法師婆婆！？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳真的來幫我了嗎？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……妳說誰是婆婆了？",
    "voice": "vo_adv_5061001_015",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "對不起！",
    "voice": "vo_adv_5061001_016",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但是妳聽我說，似似花！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "其實──",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "原來如此，",
    "voice": "vo_adv_5061001_017",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是這麼一回事呀。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "既然是在那種狀況下，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "會將我看成來幫忙的魔法師，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n也是理所當然的呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯，",
    "voice": "vo_adv_5061001_018",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "所以說呢，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呃……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳不用說我也能明白，",
    "voice": "vo_adv_5061001_019",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「希望妳能幫我準備禮服」，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳想這麼說對吧？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真不愧是似似花，",
    "voice": "vo_adv_5061001_020",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "完全看穿了我的想法。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "所以",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我想跟妳商量一下……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "辦得到哦。",
    "voice": "vo_adv_5061001_021",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "變出禮服這種小事，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "簡直是輕而易舉。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真、",
    "voice": "vo_adv_5061001_022",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真的嗎！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那麼……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但是",
    "voice": "vo_adv_5061001_023",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就算辦得到，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我也還沒答應要幫妳。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n既然要我幫忙的話，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就必須給我與其同等的報酬。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "說、",
    "voice": "vo_adv_5061001_024",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "說得也是呢，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我真是的，竟然完全只想到自己……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這也是為了禮服，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "還有為了舞會，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不管什麼事我都做！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳的這種個性，",
    "voice": "vo_adv_5061001_025",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我非常中意哦。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n雖然說是報酬，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但也沒什麼大不了的，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n只是要請妳用身體來回報而已。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "用、",
    "voice": "vo_adv_5061001_026",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "用身體……？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳要對我做什麼嗎？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那個……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "可、",
    "voice": null,
    "unit_id": 105214
  },
