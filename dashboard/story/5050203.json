  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "總算擊敗他了。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "解決之後就覺得獲勝得很輕鬆呢！",
    "voice": "vo_adv_5050203_001",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "兩位，",
    "voice": "vo_adv_5050203_002",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "到最後都不能疏忽大意喔。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "鬼魂教父似乎還能再戰呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哇啊！？",
    "voice": "vo_adv_5050203_003",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "真的耶！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我們可是不會輸的喔！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "說得沒錯，",
