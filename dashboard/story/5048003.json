[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "音樂節與線下聚的舉辦日當天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n茜里前往線下聚的聚會店家，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n依里則是獨自前往與{0}等人相約的會合地點。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "嗚嗚……",
    "voice": "vo_adv_5048003_000",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "第一次參加音樂節實在好緊張……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "雖然超級名模的事應該是開玩笑的，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n不過光是想到要跟陌生人一起參加，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我就快要昏倒了。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "movie",
    "movie_id": "504800301"
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，",
    "voice": "vo_adv_5048003_001",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才你終於來啦！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈嚕哈嚕～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你這次找了這麼可愛的正妹來，",
    "voice": "vo_adv_5048003_002",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "遲到小事一件啦。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n不過來的竟然是天使太意外了，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好好笑喔～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是說這衣服也太讚吧？",
    "voice": "vo_adv_5048003_003",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "誇張可愛又誇張精緻耶！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "欸欸欸，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這是哪間店買的啊？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家也好想穿穿看喔！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "呃、",
    "voice": "vo_adv_5048003_004",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "嗯……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "這、",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "這是朋友送的……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "算是、",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "手工做的",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "吧……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的嗎！",
    "voice": "vo_adv_5048003_005",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "茜里妳認識那麼狂的朋友？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好厲害喔～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "欸～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "讓雪雪來穿應該也不錯看吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真是無意義的問題。",
    "voice": "vo_adv_5048003_006",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "像我這麼美麗的人",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "穿什麼都是絕配。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就算是路邊的舊報紙跟破手套，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n一讓我穿上都會化為禮服。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "倒是話說",
    "voice": "vo_adv_5048003_007",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳從剛才就像個老朋友一樣和我們聊，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n但我們是初次見面吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "算了，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "看來這應該也是",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "拜我的美貌所賜吧。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊哈哈！",
    "voice": "vo_adv_5048003_008",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雪雪妳這人真有趣耶！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "笑死～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才扮天使是要笑死誰啦～♪",
    "voice": "vo_adv_5048003_009",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n不過也說不定跟你意外速配喔！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "好、",
    "voice": "vo_adv_5048003_010",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "好厲害……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "明明才剛認識就這麼主動積極。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n這就是現充，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "這就是所謂的超級名模……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "不對，",
    "voice": "vo_adv_5048003_011",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "這一定是",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "源自鈴奈自己的人品吧。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "畢竟她不只可愛，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "個性也是既陽光又隨和。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "本來",
    "voice": "vo_adv_5048003_012",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "她應該會跟茜里很投緣，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n由我當替身真是可惜了……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "倒是真沒想到",
    "voice": "vo_adv_5048003_013",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "那傢伙竟然真的認識這麼厲害的人，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n關係還這麼親密。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "在場這麼普通的就只有我了……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "欸～茜里！",
    "voice": "vo_adv_5048003_014",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "茜里妳",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "有什麼想看的歌手嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "啊，",
    "voice": "vo_adv_5048003_015",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我、",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我的話……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "鈴、",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "鈴奈妳想看誰",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我就看誰吧。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "天啊！",
    "voice": "vo_adv_5048003_016",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "茜里妳超體貼的耶！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "OK～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那總之我們就去會場吧！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "still",
    "still_id": "504800301"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "耶──！",
    "voice": "vo_adv_5048003_017",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "太讚了──！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "耶、",
    "voice": "vo_adv_5048003_018",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "耶……！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "因為第一次參加什麼都不懂，",
    "voice": "vo_adv_5048003_019",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n只好先跟著周遭的人一起喊……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "但、",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "但是人實在好多……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "又好熱……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我能撐到最後嗎？　",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "鈴奈她",
    "voice": "vo_adv_5048003_020",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "看起來早就習以為常了。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "至於雪……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊……",
    "voice": "vo_adv_5048003_021",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "事實證明即使在這人潮洶湧的環境下，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我的美麗",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "依然絲毫不受動搖！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "咦咦～！",
    "voice": "vo_adv_5048003_022",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "她是哪時跑得那麼遠的！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n某方面來說她也跟鈴奈一樣不簡單啊。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "雖然是個怪人。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "音、",
    "voice": "vo_adv_5048003_023",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "音樂節還真是學問不小……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n我這樣，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "真的有融入大家嗎……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "那、",
    "voice": "vo_adv_5048003_024",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "那個，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "像我這樣會不會很突兀啊？",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "說、",
    "voice": "vo_adv_5048003_025",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "說得一副好像你很懂的樣子……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "不過",
    "voice": "vo_adv_5048003_026",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "仔細一瞧，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "有人在最前排搖頭",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "或者是跳舞，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n但也有人在後排專注地聽歌。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我懂了，",
    "voice": "vo_adv_5048003_027",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "演唱會並沒有硬性規定要怎麼做。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n只要照自己的方式去享受就行了。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "嗯，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "這樣一想，心態也輕鬆多了。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "喂，",
    "voice": "vo_adv_5048003_028",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "你太大聲了啦！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "喔，",
    "voice": "vo_adv_5048003_029",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才你也挺融入的嘛！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "啊，",
    "voice": "vo_adv_5048003_030",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "原來像那樣就行了嗎。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "只要跟著那傢伙一起喊，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我應該也辦得到！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "still",
    "still_id": "504800302"
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "耶、",
    "voice": "vo_adv_5048003_031",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "耶──！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊哈哈♪",
    "voice": "vo_adv_5048003_032",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "看來茜里也",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "跟著high起來了！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "504800303"
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "嗯，這下子",
    "voice": "vo_adv_5048003_033",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "感覺有趣多了。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n就這樣保持下去，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "讓自己徹底化身為茜里吧！　",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "background",
    "bg_id": "500580"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "呼～",
    "voice": "vo_adv_5048003_034",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "太精采了～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n茜里一high起來把氣氛也跟著炒熱了！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "是、",
    "voice": "vo_adv_5048003_035",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "嘻嘻……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼接下來……",
    "voice": "vo_adv_5048003_036",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "距離想聽的歌手開唱",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還有一點點時間。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們先去吃飯吧！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n畢竟參加音樂節，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "去攤販吃好吃的",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "也是樂趣之一嘛！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "哇，",
    "voice": "vo_adv_5048003_037",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "真的耶。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "好多看起來不錯的美食攤位。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "那披薩好像很好吃。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "啊，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "那裡還有賣口袋餅呢！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n不過又好想到那個精品攤逛逛！　",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "茜里～",
    "voice": "vo_adv_5048003_038",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這裡這裡！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "鏘鏘～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "音樂節最有名的總匯咖哩！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家請妳吃吧。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n讓我們大吃特吃，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "吃飽再大玩特玩！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "嗚哇，",
    "voice": "vo_adv_5048003_039",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "雖然看起來很好吃，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "但這份量也太……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "可是",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "鈴奈的一片好意總不能拒絕。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "謝、",
    "voice": "vo_adv_5048003_040",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "謝謝妳……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "那麼我開動了。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "呼～",
    "voice": "vo_adv_5048003_041",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "吃得好飽呢！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "接下來",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "要到那邊的小舞台逛逛嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n一起去發掘以後有可能竄紅的歌手！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "好、",
    "voice": "vo_adv_5048003_042",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "好的，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "聽起來好像不錯……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "嗚嗚，",
    "voice": "vo_adv_5048003_043",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "陌生的活動、",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "新認識的人、",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "適應不良的氛圍、",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "超大盤的飯。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "活動雖然好玩",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "但也好累人啊……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "真希望能休息一下。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "可是",
    "voice": "vo_adv_5048003_044",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "大家看起來玩得正開心，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "要是現在嚷著要休息，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n搞不好會影響大家的興致……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "呃，",
    "voice": "vo_adv_5048003_045",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "咦？",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "你幹嘛……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我是說，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "哥哥怎麼會這樣問呢？",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n茜里一點都不累，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "等等，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "喂，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "你、",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "你要把我帶去哪裡？",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才？",
    "voice": "vo_adv_5048003_046",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "茜里你們要上哪兒去啊？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "呼，",
    "voice": "vo_adv_5048003_047",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "遠離人潮總算是自在多了……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "也終於有時間能歇口氣。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，",
    "voice": "vo_adv_5048003_048",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "原來你們在這裡！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "茜里",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "妳還好吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是不是",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "害妳太累了？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是的話對不起呀。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "老是不懂得察言觀色……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "鈴奈……",
    "voice": "vo_adv_5048003_049",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "啊啊，",
    "voice": "vo_adv_5048003_050",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "結果還是害她操心了。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "現在就算硬撐，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "也該裝個樣子給她看看。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……嗯？",
    "voice": "vo_adv_5048003_051",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼了{0}。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n為何盯著我看呢？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "借鏡子？",
    "voice": "vo_adv_5048003_052",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真拿你沒辦法。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n好吧，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過可別弄壞了喔。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "怎、",
    "voice": "vo_adv_5048003_053",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "怎麼了，{0}？",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n為什麼要讓我照鏡子？",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "意思是要我整理儀容嗎？",
    "voice": "vo_adv_5048003_054",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "唉，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "好啦，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我照就是了。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "……",
    "voice": "vo_adv_5048003_055",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "什麼嘛，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "明明就沒什麼問題……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "啊。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "在鏡子裡的",
    "voice": "vo_adv_5048003_056",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "是茜里的臉啊。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n對了，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "現在的我……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "外表可是茜里的模樣。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "結果我卻畏畏縮縮，",
    "voice": "vo_adv_5048003_057",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "對他人的反應患得患失……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我明明，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "是想把茜里的優點呈現給大家看……！　",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "快點想想……",
    "voice": "vo_adv_5048003_058",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "像這種時候，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "換成茜里會怎麼做？",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我比誰都還要認真看著茜里，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "肯定會明白的。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "茜里她",
    "voice": "vo_adv_5048003_059",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "有著恰到好處的",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "坦率與不造作，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "對誰都一樣有親和力。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我最喜歡這樣的茜里，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "也一直嚮往她的個性。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "像這種時候，",
    "voice": "vo_adv_5048003_060",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "茜里應該不會勉強自己。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我也該像茜里一樣",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "大大方方地把話說出來。　",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "若是在平常我也許辦不到，",
    "voice": "vo_adv_5048003_061",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "但憑目前茜里的模樣應該沒問題！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n所以……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我也要效法茜里的那份率真，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "和大家一起享受活動！　",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "茜里？",
    "voice": "vo_adv_5048003_062",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "抱歉害妳擔心了，鈴奈。",
    "voice": "vo_adv_5048003_063",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n茜里我啊，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "今天實在太興奮了，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "一個不小心",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "有點high過頭。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n在下一場演唱會開唱前，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "真想先喝點什麼冷飲呢。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "原來是這樣！",
    "voice": "vo_adv_5048003_064",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還想說",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "茜里妳是不是",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n為了什麼原因討厭人家，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "害人家超擔心的～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不過這樣的話當然OK！",
    "voice": "vo_adv_5048003_065",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n茜里妳有什麼要求，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不必客氣儘管開口！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "哇～",
    "voice": "vo_adv_5048003_066",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "謝謝妳！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "那麼，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "既然都來參加音樂節，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n我想去看看那些精品。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "雪妳也一起來吧！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真拿妳們沒辦法。",
    "voice": "vo_adv_5048003_067",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不曉得那些精品",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有沒有哪件是配得上我的呢？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "欸，{0}。",
    "voice": "vo_adv_5048003_068",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n我這裡已經不要緊了，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "你去茜里那頭關心一下她吧。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "茜里雖然比我可靠，",
    "voice": "vo_adv_5048003_069",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "但說不定心裡也覺得很不安。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "而且",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我已經深切體悟到",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "扮演別人是多困難的事情。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "嗯……",
    "voice": "vo_adv_5048003_070",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "還有，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "就是……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "今天",
    "voice": "vo_adv_5048003_071",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "幫了我這麼多，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "真的很謝謝你喔，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "哥哥♪",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "為、",
    "voice": "vo_adv_5048003_072",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "為什麼要驚訝成那樣啦！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我只是覺得",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "茜里應該會這樣說，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n所以才試著模仿一次！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "那麼時候差不多了，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我該回鈴奈她們那裡去了！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我辦到了……",
    "voice": "vo_adv_5048003_073",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "成功地",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "向他道謝了……！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n雖然是透過茜里的身體，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "但這次總算說出口了！　",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "總有一天一定要親口告訴他──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n下定決心的依里，踏出了屬於自己的一小步。",
    "voice": null,
    "unit_id": null
  }
]
