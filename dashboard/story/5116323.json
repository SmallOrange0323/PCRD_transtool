    "words": "不過，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們也不會退縮的。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "無論是人還是魔物……",
