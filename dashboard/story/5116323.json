    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這時候若不好好運用我們在集訓期間所學到的一切，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n要等到何時",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "才用呢？",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "況且大猿先生牠",
    "voice": "vo_adv_5116323_003",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也不是因為想作亂才會這樣的。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "牠",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一定能夠明白我們的苦心。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是啊……",
    "voice": "vo_adv_5116323_004",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
