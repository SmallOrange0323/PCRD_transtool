  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我已經下定決心，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
