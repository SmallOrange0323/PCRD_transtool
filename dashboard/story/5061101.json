  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n偶爾以人類的模樣到鎮上也挺不錯的呢～",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "再怎麼說我也是個正值青春的女孩子，",
    "voice": "vo_adv_5061101_001",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "有時候也會想感受一下鎮上的刺激呀。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哇！",
    "voice": "vo_adv_5061101_002",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那間店的櫥窗裡，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n展示著好漂亮的禮服哦！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊啊，",
    "voice": "vo_adv_5061101_003",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就算只有一次也好，真想穿著漂亮的禮服，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n參加在豪華宅邸裡",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "舉辦的舞會呢！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就算真正的樣貌是毛茸茸的野獸，",
    "voice": "vo_adv_5061101_004",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "果然作為少女還是會有所憧憬呢！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過",
    "voice": "vo_adv_5061101_005",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果是變成了人類的我，或許……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那怎麼可能呢，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不可能有那麼好的事──",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那邊那位美麗的小姐，",
    "voice": "vo_adv_5061101_006",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "您想不想參加舞會呢？",
    "voice": null,
    "unit_id": 2512
  },
  {
