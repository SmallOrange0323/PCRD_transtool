    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這樣子就能",
    "voice": "vo_adv_1117002_055",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "稍微報復剛剛受到的對待了呢。",
