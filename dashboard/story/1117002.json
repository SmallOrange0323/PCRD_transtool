  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖、",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然有從茜里那邊聽說了，",
