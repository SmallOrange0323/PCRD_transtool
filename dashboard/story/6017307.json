[
  {
    "type": "background",
    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你想知道愛蜜莉雅大人的事？",
    "voice": "vo_adv_6017307_000",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你有興趣我是沒意見，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "但我沒有什麼可說明的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n她是",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "很重要的客人。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "以拉姆的立場，",
    "voice": "vo_adv_6017307_001",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "我能說的不多。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆反而想問你是怎麼看她的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "根據回答再決定要不要殺……",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "沒什麼，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "我說笑的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雖然不知道和這個世界的精靈族是不是一樣。",
    "voice": "vo_adv_6017307_002",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不過外表看起來是沒有什麼不同。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n你是不是因為失去記憶，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "對什麼都很好奇啊。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "的確。",
    "voice": "vo_adv_6017307_003",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "她很美。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "我認識一個男人",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "嘴上掛著這句話，學不乖拼命想接近她，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "希望你不會像他那樣不知天高地厚。",
    "voice": null,
    "unit_id": 109811
  }
]
