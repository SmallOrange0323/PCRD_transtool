  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "キミに相談したいことがあるにゃ！",
    "voice": "vo_adv_6106202_000",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "お店に来てくれる猫たちのために、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "猫専用のメニューを",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n考えようと思うのにゃ！　",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "どんなのがいいかにゃ？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "それは名案にゃ！　",
    "voice": "vo_adv_6106202_001",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "牛のお乳はお腹を壊しちゃう子もいるからにゃ。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nおっきな猫も子猫も、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "安心して飲めるメニューだにゃ！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "早速、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "【牧場（エリザベスパーク）】に仕入れに行くにゃ～！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "にゃっ！？　",
    "voice": "vo_adv_6106202_002",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "なんて独創的なメニューなんだにゃ！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "それなら、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "ろうそくみたいに小魚をケーキに並べて差して……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "むふふ、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "猫まっしぐらの大人気メニューになるに違いないのにゃ～！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "爪とぎし放題のプランにゃ！？　",
    "voice": "vo_adv_6106202_003",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "それはみんな大喜びするにゃ！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n早速メニューに書いて……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "って、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "お店がボロボロになっちゃうにゃ～！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nキミ、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "この話はなかったことに……",
    "voice": null,
    "unit_id": 107911
  }
]
