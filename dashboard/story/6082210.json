    "words": "か。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "あの子たちはどれくらい成長してくるかな。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
