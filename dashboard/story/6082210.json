    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "確かにあの子たちには会いたいけど……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\nお化けの世界に行くのは、",
    "voice": null,
