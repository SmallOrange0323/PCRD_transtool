    "type": "dialogue",
    "name": "レイ",
    "words": "確かに",
    "voice": "vo_adv_6050210_002",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "元気じゃないあの子たちなんて想像できない。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "でも",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "他のお化けにいじめられていたりしないかな……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "いや、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "今のあの子たちなら",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "きっと大丈夫だよね。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "レイ",
