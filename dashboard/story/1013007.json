  {
    "type": "dialogue",
    "name": "旁白",
    "words": "帶著憂心的表情，七七香一個人站在火山上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……",
    "voice": "vo_adv_1013007_000",
    "unit_id": 101311
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯……",
    "voice": "vo_adv_1013007_001",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "自從上次的事件之後，就提不太起勁啊。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯？",
    "voice": "vo_adv_1013007_002",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喔，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這不是限定商品嗎？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……嗯……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "算了，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "下次再來。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "喂～小姐！",
    "voice": "vo_adv_1013007_003",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "妳、",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "妳來得正好呢！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦？",
    "voice": "vo_adv_1013007_004",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "叔叔是之前那時候的商人嘛？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "辛苦了辛苦了──",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "事、",
    "voice": "vo_adv_1013007_005",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "事情不妙呀！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n之前妳捉拿的那群魔法師逃獄了……！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "而、",
    "voice": "vo_adv_1013007_006",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "而且，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "竟然又來偷襲我們，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n還奪走了魔導書！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦──！？",
    "voice": "vo_adv_1013007_007",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那兩人嗎！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這樣說……",
    "voice": "vo_adv_1013007_008",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對叔叔們不太好意思，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n但這可是為{0}報仇的好機會……？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我、",
    "voice": "vo_adv_1013007_009",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我會幫你拿回魔導書，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "叔叔們就在這裡等著！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "啊、",
    "voice": "vo_adv_1013007_010",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "喂！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "小姐！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "background",
    "bg_id": "500220"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "循著強力魔力的痕跡，",
    "voice": "vo_adv_1013007_011",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "追到了這裡，但……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唉……",
    "voice": "vo_adv_1013007_012",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "為什麼到了這個節骨眼，\\n還會想到{0}呢──！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但是，",
    "voice": "vo_adv_1013007_013",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "如果再害他受傷就更煩惱了……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n不帶他來是正確的吧……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "氣死人了，遇到了倒楣事啊。",
    "voice": "vo_adv_1013007_014",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "嗯不過，",
    "voice": "vo_adv_1013007_015",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "雖然繞了遠路但也達到目的了，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "\\n也算不錯了啦。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "真的在……",
    "voice": "vo_adv_1013007_016",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "在這裡應該不會有什麼東西搗亂，",
    "voice": "vo_adv_1013007_017",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "就來試試魔導書的力量吧。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "啊啊，",
    "voice": "vo_adv_1013007_018",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "要開始囉。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "怎麼可能讓你得逞呢！",
    "voice": "vo_adv_1013007_019",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "什！？",
    "voice": "vo_adv_1013007_020",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "書……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哼哼──！",
    "voice": "vo_adv_1013007_021",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "成功搶回",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "魔導書！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "妳這傢伙！",
    "voice": "vo_adv_1013007_022",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "又來搗亂！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "\\n因為妳我們可是吃了牢飯呢！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嘻嘻──",
    "voice": "vo_adv_1013007_023",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那是不是正適合你們嘛♪",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我會馬上再送你們回去的！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "我會讓妳為妳的多管閒事",
    "voice": "vo_adv_1013007_024",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "感到後悔的……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "\\n覺悟吧魔法少女！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "太好了太好了──！",
    "voice": "vo_adv_1013007_025",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "壞蛋的感覺完全不馬虎！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但是！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "現在的我",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "擁有這本魔導書！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "商人叔叔們，",
    "voice": "vo_adv_1013007_026",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這超稀有魔法借我一用！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n就用這魔法一決勝負吧！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喝啊啊啊啊！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……嗯？",
    "voice": "vo_adv_1013007_027",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "失敗了嘛。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "再一次！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喝啊啊啊啊啊！",
    "voice": "vo_adv_1013007_028",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "慢慢慢著，",
    "voice": "vo_adv_1013007_029",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "為什麼使不出來呢！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我不懂！我不懂！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "……哈哈，",
    "voice": "vo_adv_1013007_030",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "啊哈哈哈！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "真是太可惜了呢！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "\\n那個魔法啊，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "若不是兩個人一起詠唱就使不出來呢！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "而且是一種需要擁有「互信關係」的兩人詠唱的特殊咒語……",
    "voice": "vo_adv_1013007_031",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "\\n這就是這本魔導書被當成貴重物品的理由！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你說……",
    "voice": "vo_adv_1013007_032",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "什麼！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "雖然很震驚，",
    "voice": "vo_adv_1013007_033",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但我可是魔法少女七七香，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n沒有這本魔導書也是超可愛又超強！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒問題！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "妳這女人還真敢講……",
    "voice": "vo_adv_1013007_034",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "喔啦！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "background",
    "bg_id": "500220"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦！哇……",
    "voice": "vo_adv_1013007_035",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你們的魔法果然很強呢……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但爺可是不會輸的喔？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "輪到",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我的回合了！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "魔法師1",
    "words": "還早得很！",
    "voice": "vo_adv_1013007_036",
    "unit_id": 811
  },
  {
    "type": "background",
    "bg_id": "500220"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喂！",
    "voice": "vo_adv_1013007_037",
    "unit_id": 101311
  },
  {
