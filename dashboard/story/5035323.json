[
  {
    "type": "dialogue",
    "name": "凜",
    "words": "那隻魔物，",
    "voice": "vo_adv_5035323_000",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "到底想要鬧多久才會滿意呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "總是打不倒呢。",
    "voice": "vo_adv_5035323_001",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "牠還真難纏～！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我們也都累得快精疲力盡了呢……",
    "voice": "vo_adv_5035323_002",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "可是，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "牠應該也一樣才對！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "說得沒錯。",
    "voice": "vo_adv_5035323_003",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "能感覺到牠好像已經在垂死掙扎了。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n再堅持一下應該就能解決！",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "是嗎！",
    "voice": "vo_adv_5035323_004",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那麼我們",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "就再擠出最後的力量，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n用盡全力地上吧──！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "好的！　",
    "voice": "vo_adv_5035323_005",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "讓我們盡全力去挑戰牠吧！",
    "voice": null,
    "unit_id": 112411
  }
]
