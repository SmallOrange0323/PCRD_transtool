    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "喂～！",
    "voice": "vo_adv_1008009_048",
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "雪～！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "騙人的吧！",
    "voice": "vo_adv_1008009_049",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "竟然會模仿……",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我受夠了啦～！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "唉……",
    "voice": "vo_adv_1008009_050",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就算我們想盡各種辦法試著應對，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n也會被魔物們一一擊破。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n到底該怎麼做才好呀……",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你也是，雖然心態積極是很好，",
    "voice": "vo_adv_1008009_051",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n但也至少幫忙提出一個具體的對策嘛。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "奇怪，",
    "voice": "vo_adv_1008009_052",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真的耶。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我為什麼可以明白你的感受……",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是嗎，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "原來是這麼一回事呀！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "感到開心吧，{0}！",
    "voice": "vo_adv_1008009_053",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我發現",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可以確實分辨",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你和魔物的關鍵方法了！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這樣一來肯定不會有問題了。",
    "voice": "vo_adv_1008009_054",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "來，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "讓我們展開反擊吧！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哎呀，",
    "voice": "vo_adv_1008009_055",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "話才剛說來，就冒出一大堆魔物了呢。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "background",
    "bg_id": "500414"
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": "vo_adv_1008009_056",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "無論來幾隻都一樣，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "對我是不管用的唷。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "喂～！",
    "voice": "vo_adv_1008009_057",
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "雪～！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "很遺憾……",
    "voice": "vo_adv_1008009_058",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我已經全看穿了！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "background",
    "bg_id": "500414"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "成功了呢♪",
    "voice": "vo_adv_1008009_059",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "想要騙過我，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可沒那麼容易的唷。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵♪",
    "voice": "vo_adv_1008009_060",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這點小事，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只要用我美麗的心眼去看，輕而易舉就能解決。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你自己有沒有發現？",
    "voice": "vo_adv_1008009_061",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你即使身處艱難的情況，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n也會隨時保持抬頭挺胸，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "望向前方。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n這一點，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就算你變成魔物也仍未改變。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "更何況，",
    "voice": "vo_adv_1008009_062",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你這個人整體散發出一種和煦的氣息，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n再來就是笑起來時眼角會往下垂、",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "跟小狗一樣微微歪頭的舉動等等……",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n其實許多動作都還挺好辨認的。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就算外表改變了，",
    "voice": "vo_adv_1008009_063",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這種行為舉止的細節是不會變的。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這正是",
    "voice": "vo_adv_1008009_064",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你與魔物的關鍵差別。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n畢竟若只是當場有樣學樣，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可無法連這種小細節都重現呢。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "明白這點後，就只需要仔～細觀察囉。",
    "voice": "vo_adv_1008009_065",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如何，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "很簡單吧♪",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……咦，",
    "voice": "vo_adv_1008009_066",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你看起來好像很開心，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n是發生了什麼好事嗎？",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這不是當然的嗎。",
    "voice": "vo_adv_1008009_067",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你是和我相處時間最多的人，",
    "voice": "vo_adv_1008009_068",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "除了我自己以外，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n你是",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "最常映照在我眼裡的存在。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你可要好好地",
    "voice": "vo_adv_1008009_069",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "打從心底感到光榮哪。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哇呀！",
    "voice": "vo_adv_1008009_070",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "討厭，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這次又是發生什麼……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n恢復了……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我們",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "變回人類的模樣了！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "太好了……",
    "voice": "vo_adv_1008009_071",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我原本還一直都很忐忑不安，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n想說該不會要永遠維持魔物的樣貌吧……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怪了……",
    "voice": "vo_adv_1008009_072",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "總覺得前面那邊",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是不是有個像出口的東西呀？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n空中還浮現出了文字……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "「通過測驗」？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哇～！",
    "voice": "vo_adv_1008009_073",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "通過測驗了耶！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "太棒了！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……不過，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "到頭來這測驗，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是在測試我們什麼呀？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "算了，",
    "voice": "vo_adv_1008009_074",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "多想也無益。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "反正只要成功通過就好了對吧！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那麼，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "在繼續出發前──",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "再讓我",
    "voice": "vo_adv_1008009_075",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好好享受一下恢復成原本模樣的自己！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可愛的我，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "美麗的我，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我好想見你呀！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然變成魔物時的樣子也很有魅力，",
    "voice": "vo_adv_1008009_076",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但果然",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還是這模樣最棒了呢！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵呵呵♪",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "從雪的眼眸中被趕出去的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n默默地望向了遠方心想：",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看來，得繼續在這裡待上一段時間啊……",
    "voice": null,
    "unit_id": null
  }
]
