[
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在蘭德索爾的一個下午，{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n被雪叫到餐廳見面。只不過──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊……",
    "voice": "vo_adv_1008009_000",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真、",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真是太驚人了……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n沒想到呀，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真沒想到",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我就連映照在湯匙上的臉都如此美麗……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "即便扭曲、",
    "voice": "vo_adv_1008009_001",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "甚至倒過來，都能夠這麼地美，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這恐怕是跨世紀的大發現吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "學會一定不會放過這資訊的！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊，",
    "voice": "vo_adv_1008009_002",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "抱歉抱歉，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你能稍微安靜一下嗎？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我現在",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "正見證著奇蹟的一瞬間……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我想想喔，",
    "voice": "vo_adv_1008009_003",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你就再等個五小時左右吧。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真是的，",
    "voice": "vo_adv_1008009_004",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "什麼事……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "等等，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這不是",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "鏡子嗎！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯～",
    "voice": "vo_adv_1008009_005",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然處於特異狀態的我很美，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n但",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "映照在一般鏡子裡的我果然才是究極的美呀！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "對了，",
    "voice": "vo_adv_1008009_006",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "乾脆輪流看",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "湯匙和鏡中倒影來進行比對如何呢？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "肯定",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "能見識到有如萬花筒般的幻想美麗世界──",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊！",
    "voice": "vo_adv_1008009_007",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我不見了！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你為什麼要做如此過分的事呀……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……對耶，",
    "voice": "vo_adv_1008009_008",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我是有事才會找你來的。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n由於有了意想不到的發現，讓我有些忘乎所以，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "對不起唷。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "其實是呀，",
    "voice": "vo_adv_1008009_009",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我希望",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你能陪我去一個地方。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那是一座有著「美之聖域」稱呼的神殿……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你",
    "voice": "vo_adv_1008009_010",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "應該知道愛梅斯神吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "聽說她",
    "voice": "vo_adv_1008009_011",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也有著美之女神的另一面，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只要前往那座神殿，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就能獲得美的祝福喔！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "已經是美麗化身的我不需要祝福吧──",
    "voice": "vo_adv_1008009_012",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你看起來似乎是想這麼說呢？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過呢，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如果現在外表已經十分完美的我，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n有機會",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "升級到神一般的美貌，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就還是很有過去一試的價值對吧！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只不過有一個問題，",
    "voice": "vo_adv_1008009_013",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就是那座神殿",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "似乎在很遙遠的邊境之地。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "像我這般柔弱可人的存在，",
    "voice": "vo_adv_1008009_014",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要獨自前往那種地方，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n會令人不禁",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "在各方面都感到憂心吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因此，想麻煩你",
    "voice": "vo_adv_1008009_015",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "以貼身護衛和負責拿行李的身分，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "陪同我一起去旅行。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "當然，",
    "voice": "vo_adv_1008009_016",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我不會讓你做白工的。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我就賜予你有幸第一個見識",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "變得更加美麗的我",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "的權利吧♪",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "和我來趟雙人旅行，",
    "voice": "vo_adv_1008009_017",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "再加上這至高的獎勵，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "根本沒有理由拒絕對吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "事情就是這樣，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "明天就要出發了，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "多指教囉♪",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "background",
    "bg_id": "500403"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}就在雪的強硬態度下半推半就地一起同行了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "自蘭德索爾出發後，便陪著雪四處繞道，走走停停了好幾天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n最後兩人終於抵達了目的地「美之聖域」的入口。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哦～",
    "voice": "vo_adv_1008009_018",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這裡就是「美之聖域」嗎。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "確實不愧對那宏偉氣派的名字，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有著相當不得了的氛圍呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這下似乎也能期待祝福的效果呢！",
    "voice": "vo_adv_1008009_019",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那麼，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就立刻過去吧──",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "background",
    "bg_id": "500414"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……咦？",
    "voice": "vo_adv_1008009_020",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦咦咦咦～！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼回事，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "發生什麼事了！？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n剛才為止的神聖氛圍怎麼不見了？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n看上去就挺陰森的呀……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這種地方",
    "voice": "vo_adv_1008009_021",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真的是「美之聖域」嗎……？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n你怎麼看，{0}……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "什麼？",
    "voice": "vo_adv_1008009_022",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你在說什麼奇怪的話──",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗚哇啊啊！",
    "voice": "vo_adv_1008009_023",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "魔物……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "等等，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "該不會是{0}吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這也代表……",
    "voice": "vo_adv_1008009_024",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊、",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊……",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我也變成魔物了～！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這、",
    "voice": "vo_adv_1008009_025",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這是怎麼一回事……",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為什麼會變成這種狀況？",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n儘管變成魔物的我十之八九也很可愛，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n但即使如此也太過分啦！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這、",
    "voice": "vo_adv_1008009_026",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這麼說也有道理，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "想要",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "獲得女神的祝福，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n就必須先通過一兩個測驗，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這種事確實也不足為奇呢。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過，",
    "voice": "vo_adv_1008009_027",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就算是測驗，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "讓人變成魔物果然還是太過分了。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有點想去向愛梅斯神抗議呀。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "總而言之，",
    "voice": "vo_adv_1008009_028",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "來找找出口吧。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "畢竟入口都消失了，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n也得找出變回原樣的方法才行呢。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "唉……",
    "voice": "vo_adv_1008009_029",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "無論走到哪，都是同一片景色，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我已經受夠了～！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n不僅把人變成魔物，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還丟在這種陰森的地方不管，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n真的是太過分啦！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我說呀，",
    "voice": "vo_adv_1008009_030",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "稍微休息一下吧？",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "畢竟毫無頭緒地到處跑也只是徒增疲勞而已。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n疲勞可是對肌膚不好的呀……",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "話雖如此，",
    "voice": "vo_adv_1008009_031",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但都變成魔物了，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "肌膚什麼的應該也已無所……",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯？",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "總覺得這紅色雙眼……",
    "voice": "vo_adv_1008009_032",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "似乎有如紅寶石般漂亮呢？",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n還有頭上的角",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "所勾勒的弧線也符合黃金比例，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n指爪的形狀",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也散發著特別深沉的性感魅力。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "甚至連此身軀也有著看起來很美味的粉桃色，",
    "voice": "vo_adv_1008009_033",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "觸感可謂滑順柔軟，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n讓人忍不住想摸上一整天！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "仔細一想，",
    "voice": "vo_adv_1008009_034",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我就連映照在湯匙上的臉龐都那麼美麗，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n就算變成魔物當然也還是十分迷人呀！！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗚哇！",
    "voice": "vo_adv_1008009_035",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "出現真正的魔物了！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n討厭，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不要靠過來啦！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "background",
    "bg_id": "500414"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊，",
    "voice": "vo_adv_1008009_036",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "對不起喔。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不小心弄錯了……",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呼……",
    "voice": "vo_adv_1008009_037",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "總算是都趕跑了……",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n剛才把你和魔物弄混，真是對不起。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過",
    "voice": "vo_adv_1008009_038",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "先讓我辯解一下喔。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然由於我超級無敵可愛，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n因此一眼就能辨認出和魔物有所不同，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但畢竟你的可愛度只是還行，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n所以我才分辨不出你和魔物的差別嘛。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "原來如此，",
    "voice": "vo_adv_1008009_039",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "確實是個好主意。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就這麼做吧。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊，",
    "voice": "vo_adv_1008009_040",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "話才剛說完，就有魔物出現了。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n你快點",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "試著出聲喊我吧！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不行，",
    "voice": "vo_adv_1008009_041",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "魔物的咆哮聲太大，完全聽不見。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n想個別的方法吧。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "又出現了！",
    "voice": "vo_adv_1008009_042",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我想想喔……",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不然這次就擺個什麼特定動作吧。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯嗯，",
    "voice": "vo_adv_1008009_043",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這樣就很簡單易懂呢。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "該來打倒真正的魔物們──",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哇～！",
    "voice": "vo_adv_1008009_044",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不要突然跑出一大群啦！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n數量多成這樣，根本沒辦法看清動作了呀～！",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呼、",
    "voice": "vo_adv_1008009_045",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呼……",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "總算逃出來了……",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "既然如此，",
    "voice": "vo_adv_1008009_046",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就一邊大聲呼喚，",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "一邊不停擺出動作吧。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n都做到這地步了，應該很容易就能認出來吧。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "很好，",
    "voice": "vo_adv_1008009_047",
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這次似乎只有一隻魔物。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n這樣肯定不會有問題了。",
    "voice": null,
    "unit_id": 1615
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "立刻來試試看吧！",
