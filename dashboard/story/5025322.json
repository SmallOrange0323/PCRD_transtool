  {
    "type": "dialogue",
    "name": "禊",
    "words": "怎麼了，",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我突然沒有力氣了……",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "禊！",
    "voice": "vo_adv_5025322_001",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "　離遠點！",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n靠近的話力氣好像會被吸走！",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "是這樣嗎！？",
    "voice": "vo_adv_5025322_002",
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊、",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好險啊～！",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "它好像變得比剛才更強了！",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不只是幽靈們，",
    "voice": "vo_adv_5025322_003",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "竟然連我們的力量都想奪走！",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "竟然不想離開花",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "到了那種程度……！",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不過，",
    "voice": "vo_adv_5025322_004",
    "unit_id": 111311
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "花要跟我們回去！",
    "voice": null,
    "unit_id": 111311
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n我們才",
    "voice": null,
    "unit_id": 111311
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不會輸呢！",
    "voice": null,
    "unit_id": 111311
  }
