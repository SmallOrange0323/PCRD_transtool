[
  {
    "type": "background",
    "bg_id": "500651"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]{0}和吉塔接下了給騎空團的委託，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]運送貨物來大江戶。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n兩人送完貨後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]便在鎮上悠閒地逛著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]畢竟都難得來到大江戶了。",
    "voice": "vo_adv_5118066_000",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]我們稍微觀光一下再回去吧。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]搞不好",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]還可以在這裡挖到什麼珍品喔。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]溫泉嗎……",
    "voice": "vo_adv_5118066_001",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]聽起來也不錯呢！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n工作正好也都結束了，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]要不要乾脆就去泡泡溫泉呀？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "[FFFFFFFF]泡溫泉一事，",
    "voice": "vo_adv_5118066_002",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "[FFFFFFFF]請暫且稍候是也！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "[FFFFFFFF]\\n喝！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]著地！",
    "voice": "vo_adv_5118066_003",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]我乃將軍之忠臣，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]妮諾！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n白晝下正大光明來參上！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]從、",
    "voice": "vo_adv_5118066_004",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]從屋頂上跳了下來……？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n該不會，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]這女孩也是你認識的人？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]豈止認識，",
    "voice": "vo_adv_5118066_005",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]我乃家臣是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]並且為",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]最重要的家臣是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]家……",
    "voice": "vo_adv_5118066_006",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]什麼！？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]{0}對吃驚的吉塔",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n仔細地說明了自己與妮諾的關係──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]原、",
    "voice": "vo_adv_5118066_007",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]原來如此……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]雖然剛才嚇了一跳，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]但我明白了。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]請多指教唷，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]妮諾！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]我才要請妳多多指教，",
    "voice": "vo_adv_5118066_008",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]吉塔！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n今後還請多多關照是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]喔喔～！",
    "voice": "vo_adv_5118066_009",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]好的，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]小的樂意奉……",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]不對！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n真是太大意了……",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]我有話想和兩位談談是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]之後",
    "voice": "vo_adv_5118066_010",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]在大江戶",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]將會舉辦祭典。",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]我正在幫忙進行該祭典的籌備是也。",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]然後，",
    "voice": "vo_adv_5118066_011",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]今天原本要拍攝",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]宣傳海報的照片……",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]但",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]未料，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]模特兒卻感冒了是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]真糟糕！",
    "voice": "vo_adv_5118066_012",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n那麼，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]現在對方沒辦法進行拍攝嗎？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]是的……",
    "voice": "vo_adv_5118066_013",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]再加上，以目前的行程安排，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]拍攝也無法再延期了。",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n因此我才會四處奔波，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n尋找願意在這個危機狀況下出手相助的武士……",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]就在此時，",
    "voice": "vo_adv_5118066_014",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]正巧遇見我的將軍是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n還有",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]吉塔，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]妳！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]我、",
    "voice": "vo_adv_5118066_015",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]我嗎？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]吉塔的身材",
    "voice": "vo_adv_5118066_016",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]和模特兒幾乎一模一樣是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]相信服裝也一定會非常合身！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]今日在此相遇也是緣分，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]還請妳務必要幫助我是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]原來是這麼一回事呀。",
    "voice": "vo_adv_5118066_017",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]好，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]交給我吧！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]感激不盡是也！",
    "voice": "vo_adv_5118066_018",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]那麼，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]首先──",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]請讓我見識一下吉塔的靈魂吧！",
    "voice": "vo_adv_5118066_019",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]竟然不是先換服裝嗎！？",
    "voice": "vo_adv_5118066_020",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]祭典的靈魂……",
    "voice": "vo_adv_5118066_021",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]那便是，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]充滿熱情的呼喊聲！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n聲音沒辦法拍進照片裡吧……",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]可別這麼說喔？",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n即使聽不見聲音，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]也是可以傳達心意的是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]這麼說確實有道理……",
    "voice": "vo_adv_5118066_022",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]應該？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]也就是所謂的有感情的作品才能打動人心吧。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]嗯，",
    "voice": "vo_adv_5118066_023",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]我明白了！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n既然要幫，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]就要幫到底！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]就是這個志氣是也！",
    "voice": "vo_adv_5118066_024",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "[FFFFFFFF]那麼，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
