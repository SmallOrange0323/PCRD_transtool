  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在拉菲和艾米的帶領下，{0}、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n依里、茜里及純走在充滿聖誕氛圍的蘭德索爾街道上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哦，",
    "voice": "vo_adv_5106610_000",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人、依里小姐、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "茜里小姐，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還有純小姐……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n大家聚在一起是怎麼了嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊，",
    "voice": "vo_adv_5106610_001",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "可可蘿。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哈囉～！",
    "voice": "vo_adv_5106610_002",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯。",
    "voice": "vo_adv_5106610_003",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我們現在在幫這幾位天使的忙。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我們在街上四處轉轉，",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "幫助實現大家的願望。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人",
    "voice": "vo_adv_5106610_004",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也在幫忙嗎。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是了不起。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "對主人的溫柔",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感到十分自豪。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "艾米，",
    "voice": "vo_adv_5106610_005",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "妳有感覺到嗎……",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "有……",
    "voice": "vo_adv_5106610_006",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "我感受到一股很強烈的願望的能量……",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是可可蘿散發出來的嗎？",
    "voice": "vo_adv_5106610_007",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n那麼強烈的願望",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "會是什麼呢？",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好令人好奇呀～♪",
    "voice": "vo_adv_5106610_008",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n哥哥，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "你說是吧！",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果妳有什麼願望的話，就說出來吧。",
    "voice": "vo_adv_5106610_009",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這幾位天使會幫妳實現願望的。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原來",
    "voice": "vo_adv_5106610_010",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "兩位都是",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "優秀的天使呀。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "區區在下的願望……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好了，好了♪",
    "voice": "vo_adv_5106610_011",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "妳就說說看嘛！",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是呀。",
    "voice": "vo_adv_5106610_012",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n這些孩子",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "來這裡就是為了實現別人的願望的。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n妳就當作是幫個忙吧。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這樣呀。",
    "voice": "vo_adv_5106610_013",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那在下就接受這份好意了……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下的願望是，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "希望主人和",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位所有人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n都過著健康快樂的日子。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "太、",
    "voice": "vo_adv_5106610_014",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "太厲害了……",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "這是發自內心的強烈願望啊。",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "那麼，",
    "voice": "vo_adv_5106610_015",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "這個願望就由我……",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "咦，",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不知道從哪裡突然傳來了鐘聲？",
    "voice": "vo_adv_5106610_016",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "妳們看！",
    "voice": "vo_adv_5106610_017",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "天空照下來了一道光！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哇，",
    "voice": "vo_adv_5106610_018",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "彩虹出現了！",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "艾米，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這是怎麼回事呀？",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "在動用天使的力量之前，願望就實現了，",
    "voice": "vo_adv_5106610_019",
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "居然有這種事……",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n什麼？",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "甚至還有天界傳來的訊息？",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "\\n",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "唔，",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "「神會保佑妳的美好願望」……",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "艾米",
    "words": "訊息是這麼說的。",
    "voice": null,
    "unit_id": 8912
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "這是",
    "voice": "vo_adv_5106610_020",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "什麼啊……",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n感覺受到特定的神",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "賜予了特別偏愛的眷顧……",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "希望",
    "voice": "vo_adv_5106610_021",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下的願望可以實現……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "她純潔的願望傳至天界，{0}一行人\\n又再次盡到天使的職責。",
    "voice": null,
    "unit_id": null
  }
