  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "牠的力量又增強了……",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "再這樣下去……",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……確實，",
    "voice": "vo_adv_5042302_001",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這下是有點不妙呢〜",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n侵蝕所造成的時間壓力也越來越緊迫了。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "光憑我們的力量……",
    "voice": "vo_adv_5042302_002",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這就是極限了嗎……？",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……沒、",
    "voice": "vo_adv_5042302_003",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "沒這回事的！！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "步、",
    "voice": "vo_adv_5042302_004",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "步未？",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我、",
    "voice": "vo_adv_5042302_005",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我啊！！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "比別人還要膽小很多，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "跟大家不一樣，一點都不堅強！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但是，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這樣的我卻沒有逃走，而是留在這裡……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這都是因為",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n有你們陪著我……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是你們",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "給了我希望！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "連、",
    "voice": "vo_adv_5042302_006",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "連連、",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "連我這種人，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "都會想要盡可能努力了！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "所以……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "所以……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "比我還要強了很多的你們應該更……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "呀啊！？",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n為、",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "為為、",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "為什麼要抱住我啊日和～！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "步未，",
    "voice": "vo_adv_5042302_007",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳真的好厲害……！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我……",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "能遇見步未妳，真是太好了！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是的……",
    "voice": "vo_adv_5042302_008",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "連看起來",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n比我還要脆弱很多的妳都說到這個地步了……",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那我也不努力不行了啊！",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "呵呵。",
    "voice": "vo_adv_5042302_009",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "璃乃，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "妳身為救世主，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "不能夠輸給她吧？",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是啊！",
    "voice": "vo_adv_5042302_010",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我會將大家的希望……",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "以及勇氣合而為一，",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "擊倒黑之王的！！",
    "voice": null,
    "unit_id": 112911
  }
