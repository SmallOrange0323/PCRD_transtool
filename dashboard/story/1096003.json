    "voice": "vo_adv_1096003_017",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "寄出箭文的人嗎？",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "刺客1",
    "words": "嗯，",
    "voice": "vo_adv_1096003_018",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "刺客1",
    "words": "是喔！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "刺客2",
    "words": "你們很準時的過來，實在幫了大忙！",
    "voice": "vo_adv_1096003_019",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "刺客2",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "刺客2",
    "words": "今天",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "刺客2",
    "words": "找你們是為了――",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "看我的！",
    "voice": "vo_adv_1096003_020",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n什麼都不用說，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我都已經知道了是也。",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "所謂忍者，",
    "voice": "vo_adv_1096003_021",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "就是把心藏於刀下之人是也。",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不需要多餘的對話了！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "刺客1",
    "words": "哦？　",
    "voice": "vo_adv_1096003_022",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "刺客1",
    "words": "突然就要開始了嗎！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "刺客1",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "刺客1",
    "words": "能達成共識太好了！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "刺客2",
    "words": "那麼，",
    "voice": "vo_adv_1096003_023",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "刺客2",
    "words": "就立刻來較量一下吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "刺客2",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "刺客2",
    "words": "小心不要受傷了喔！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這是我們要說的話！",
    "voice": "vo_adv_1096003_024",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "刺客1",
    "words": "那麼，",
    "voice": "vo_adv_1096003_025",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "刺客1",
    "words": "就讓我見識一下你們的身手吧！",
    "voice": null,
    "unit_id": 811
  },
  {
