    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "就接受",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這份挑戰狀吧！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "background",
    "bg_id": "500580"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "妮諾和{0}\\n就到了箭文上寫的地方，等待著寄件人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "就是這裡沒錯是也。",
    "voice": "vo_adv_1096003_015",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "奪得天下的重要比賽，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "絕對不能大意的一戰是也。",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "刺客1",
