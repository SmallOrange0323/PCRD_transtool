[
  {
    "type": "background",
    "bg_id": "505032"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在鎮上的人逐漸聚集而來之後，\\n萬聖節舞會終於開始了――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦？　",
    "voice": "vo_adv_1081003_000",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們也想好好地跟大家一起跳舞，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "說得也是呢。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是的。",
    "voice": "vo_adv_1081003_001",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "幽靈們說舞會感覺很好玩，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "很羨慕大家……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "聽他們這麼說感覺有點落寞呢。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然說也是可以像剛剛那樣，",
    "voice": "vo_adv_1081003_002",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "讓他們附身到我身上跳舞，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但一次也只能讓一個人跳到舞。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "實在很想幫幫大家，",
    "voice": "vo_adv_1081003_003",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n但是該怎麼做才好呢……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦？　",
    "voice": "vo_adv_1081003_004",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "能讓幽靈們可以放心跳舞的地方",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗎？",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們就去那邊吧。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "background",
    "bg_id": "500264"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這個靈異地點，即使在靈能力者當中也沒有多少人知道。",
    "voice": "vo_adv_1081003_005",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "如果要和幽靈們跳舞的話，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這裡是最適合的地方。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍，妳想得太週到了！　",
    "voice": "vo_adv_1081003_006",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "如果是這裡的話，不但沒人，",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n也超適合當作舞會會場！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "嗯……",
    "voice": "vo_adv_1081003_007",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "不過，",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "既然有這機會，就要找來很多幽靈，",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n辦個盛大的舞會。",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那是……",
    "voice": "vo_adv_1081003_008",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗯，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "說的也是。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "那麼",
    "voice": "vo_adv_1081003_009",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "『這裡是舞會會場』得這麼去宣傳一下才行呢。",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n用幽靈們也能瞭解的方法。",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "宣傳？　",
    "voice": "vo_adv_1081003_010",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗯，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣的話……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們來做南瓜燈籠吧。",
    "voice": "vo_adv_1081003_011",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n那是象徵萬聖節的應景道具。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "而且，",
    "voice": "vo_adv_1081003_012",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個還有可以吸引善良靈魂，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "驅除惡靈的效果。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我想這樣大家也會比較放心。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝你。",
    "voice": "vo_adv_1081003_013",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那麼，我們就去附近的農場吧。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n還是得先準備南瓜才行呢。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "拿到了很多因為外觀破損",
    "voice": "vo_adv_1081003_014",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以沒辦法拿去賣的南瓜耶。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然我是第一次做南瓜燈籠，",
    "voice": "vo_adv_1081003_015",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n但還是會努力加油的。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗯……嘿咻。",
    "voice": "vo_adv_1081003_016",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這邊要像",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "吧……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嘿。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "如何呢？　",
    "voice": "vo_adv_1081003_017",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "先完成了第一個。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵，",
    "voice": "vo_adv_1081003_018",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我就把這當作是在誇獎我吧。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "想說做得誇張一點，",
    "voice": "vo_adv_1081003_019",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n比較適合拿來驅除惡靈。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以刻意這麼做的。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "比我還漂亮？　",
    "voice": "vo_adv_1081003_020",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "怎麼可能會……",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "喔，嗯。",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n真不愧是忍，",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "真的是很棒的南瓜燈籠呢。",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "是說小伙子啊，",
    "voice": "vo_adv_1081003_021",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "你覺得我適合用「漂亮」兩個字來形容的嗎！？",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n嗚哇，",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "好噁心！　",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "別過來這邊！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵……",
    "voice": "vo_adv_1081003_022",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "感覺你好像很開心。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "太好了呢。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因為算是很習慣雕刻了。",
    "voice": "vo_adv_1081003_023",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "畢竟常會接到製作詛咒雕像的工作。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過還請放心。",
    "voice": "vo_adv_1081003_024",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "在做這個的時候沒有加上詛咒唷。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……啊，",
    "voice": "vo_adv_1081003_025",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不會，",
    "voice": "vo_adv_1081003_026",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "仔細想想，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我好像從來沒有用這種心情來進行雕刻呢。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "像今天這樣，",
    "voice": "vo_adv_1081003_027",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "想讓幽靈們開心一下……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "為了其他人的幸福拿起雕刻刀，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我想都是過去從未有過的經驗。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我……",
    "voice": "vo_adv_1081003_028",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "想要讓更多幽靈，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "都聚集到這裡來。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "然後，",
    "voice": "vo_adv_1081003_029",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "如果大家都能玩得開心，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那就好了……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "來，",
    "voice": "vo_adv_1081003_030",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們繼續動手吧。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "得多做一些南瓜燈籠才行。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呼……",
    "voice": "vo_adv_1081003_031",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "總算及時完成",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "準備了呢。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那麼，",
    "voice": "vo_adv_1081003_032",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "要來點亮南瓜燈籠囉――",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "各位",
    "voice": "vo_adv_1081003_033",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "晚安。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "今天歡迎大家來參加萬聖節舞會，",
    "voice": "vo_adv_1081003_034",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n希望大家都能玩得愉快。",
    "voice": null,
    "unit_id": 108111
  },
  {
