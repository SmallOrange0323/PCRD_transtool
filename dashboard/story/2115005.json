  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "為了打贏肯定是最強的、",
    "voice": "vo_adv_2115005_091",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "誰都無法戰勝的厄莉絲大人。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n為了從正面攻略",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不可能攻略的超高難度。",
