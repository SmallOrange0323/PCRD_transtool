    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不只如此……",
    "voice": null,
    "unit_id": 129012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "妳還，",
    "voice": null,
    "unit_id": 129012
  },
  {
    "type": "dialogue",
