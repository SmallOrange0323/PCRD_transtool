[
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "依里、茜里與忍這三位魔族少女，\\n一同來到了某個洞窟的深處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "依里、茜里。",
    "voice": "vo_adv_3014001_000",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n占卜出來的地方就是這裡。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "原、原來被封印在這裡……",
    "voice": "vo_adv_3014001_001",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "太古時率領魔族企圖征服世界的",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n『傳說的吸血鬼』！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗚哇～",
    "voice": "vo_adv_3014001_002",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里緊張得心臟怦怦跳～",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那麼我要解開封印了。",
    "voice": "vo_adv_3014001_003",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "…………嘿",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯、",
    "voice": "vo_adv_3014001_004",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯～～？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是誰～？什麼事啊～？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子好～想～睡～喔～！！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……這孩子是『傳說的吸血鬼』？",
    "voice": "vo_adv_3014001_005",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "『吸血鬼』～？",
    "voice": "vo_adv_3014001_006",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子是幽靈唷～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……真不好意思。",
    "voice": "vo_adv_3014001_007",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "看來我們搞錯了。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "忍忍忍、忍……這已經是搞錯第幾次了……",
    "voice": "vo_adv_3014001_008",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "搞錯人？因為這樣把宮子叫醒？",
    "voice": "vo_adv_3014001_009",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好過分～！難得宮子悠閒地在睡覺～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "幽靈……還是第一次看到……但好像跟想像中不一樣。",
    "voice": "vo_adv_3014001_010",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "完全不恐怖……還很吵……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n好像還有點麻煩……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "妨礙宮子睡覺可是罪孽深重的！",
    "voice": "vo_adv_3014001_011",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n噗噗噗噗～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "現在是「因為不小心醒了，可是還有點想睡，",
    "voice": "vo_adv_3014001_012",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "心想『來睡個回籠覺～♪』的時候，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "卻越來越清醒……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "在宮子告訴自己",
    "voice": "vo_adv_3014001_013",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "『不能清醒～』『再睡下去～』的時候，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "卻漸漸地越來越清醒，完全睡不著」的狀態！　",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子的憤怒，妳們打算如何賠償啊！？",
    "voice": "vo_adv_3014001_014",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "宮子真抱歉……",
    "voice": "vo_adv_3014001_015",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里用自己的身體來補償……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "欸……一起睡就可以嗎？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那樣才不是賠償！",
    "voice": "vo_adv_3014001_016",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這只能靠請宮子吃布丁來解決了～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "布、布丁？",
    "voice": "vo_adv_3014001_017",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "真是個怪胎幽靈……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那個，忍，麻煩請她吃布丁。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不。我只是受妳們雇用而已。",
    "voice": "vo_adv_3014001_018",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "應該還是由兩位來請才是。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不管是誰都可以啦！不對，是每個人都要請宮子吃！",
    "voice": "vo_adv_3014001_019",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "3個人所以總共3個布丁～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "話說回來，到底把宮子搞錯當成誰了～？",
    "voice": "vo_adv_3014001_020",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "欸。",
    "voice": "vo_adv_3014001_021",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "很久很久以前，企圖征服世界而被封印的『傳說的吸血鬼』。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "在遙遠的太古，",
    "voice": "vo_adv_3014001_022",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "率領著魔族，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n和人類、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "精靈族",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "以及獸人這3個種族作戰，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n是魔族之王。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "雖然在與眾神的最終戰爭『吠陀經』中落敗，",
    "voice": "vo_adv_3014001_023",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n但據說至今身體仍封印在某個地方，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n等候再次甦醒的時刻到來……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這是住在蘭德索爾的人們……",
    "voice": "vo_adv_3014001_024",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n特別在魔族當中非常有名的傳說喔。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "宮子也是魔族的話，應該有聽過吧？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "『傳說的吸血鬼』？",
    "voice": "vo_adv_3014001_025",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯～～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n宮子不大記得死前的事情了～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "真的存在著那樣的傢伙嗎～？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗯、嗯～可能不存在……畢竟只是傳說而已……",
    "voice": "vo_adv_3014001_026",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "一定存在～！絕對！",
    "voice": "vo_adv_3014001_027",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸，她是茜里。",
    "voice": "vo_adv_3014001_028",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我、我、我是依里。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我、我們是雙胞胎。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "其實是茜里說要找到吸血鬼的。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "欸嘿嘿～『傳說的吸血鬼』呀，",
    "voice": "vo_adv_3014001_029",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "可以用魔力做到很多事情呢！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "然後茜里啊，有『祕密的願望』",
    "voice": "vo_adv_3014001_030",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n想拜託吸血鬼幫忙實現。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗯！",
    "voice": "vo_adv_3014001_031",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里想成為世界第一可愛！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那不是祕密嗎！？",
    "voice": "vo_adv_3014001_032",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "啊！不小心說出來了～",
    "voice": "vo_adv_3014001_033",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里都沒有跟任何人說過耶～",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好丟臉～",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "原來是為了這種理由啊……",
    "voice": "vo_adv_3014001_034",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "（我、我也有『祕密的願望』",
    "voice": "vo_adv_3014001_035",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n想拜託吸血鬼幫忙實現……）",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過，據說一般吸血鬼具有讓人傾倒……",
    "voice": "vo_adv_3014001_036",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n『魅惑』的能力。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "說不定可以讓茜里變美呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "真的嗎～！？",
