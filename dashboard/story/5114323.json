[
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵，",
    "voice": "vo_adv_5114323_000",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵嗚～！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我感覺到了很驚人的力量喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我尾巴的毛都蓬起來了喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那傢伙到底",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "會強到什麼程度啊喵！？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就算我們都一起上，",
    "voice": "vo_adv_5114323_001",
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "用一般的方法可能也行不通……",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵喵……",
    "voice": "vo_adv_5114323_002",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "牠到底要使壞到什麼地步啊喵……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "要是因為這種事情而膽怯，就太不像我們了喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們不會輸的喵～！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒錯！",
    "voice": "vo_adv_5114323_003",
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "還有迄今為止培養出來的待客技巧！",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n來個絕地大反攻吧！",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯，",
    "voice": "vo_adv_5114323_004",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那麼就像平時一樣喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒錯，",
    "voice": "vo_adv_5114323_005",
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "用心款待的時間到了！",
    "voice": null,
    "unit_id": 125211
  }
]
