    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "雖然不知道怎麼回事，",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "但露被稱讚了！",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "\\n",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "好耶～！！",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，露在蘭德索爾裡交到了許多朋友。",
