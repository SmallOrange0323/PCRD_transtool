    "voice": "vo_adv_1093003_089",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "無論跟誰都能馬上成為朋友，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n這就是露的優點呢。",
