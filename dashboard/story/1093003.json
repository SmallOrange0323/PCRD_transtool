  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這個給妳。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "唔嗯？",
    "voice": "vo_adv_1093003_082",
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "\\n這個是……",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "看起來很好吃的糖果！",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "因為道別時妳給了我好吃的點心。",
    "voice": "vo_adv_1093003_083",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這是回禮。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "哇！　",
    "voice": "vo_adv_1093003_084",
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "太感謝了！",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "嗚呼呼！",
    "voice": "vo_adv_1093003_085",
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "\\n真是幸運！　",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "意外地得到糖果了！",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "哎呀呀，",
    "voice": "vo_adv_1093003_086",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "小露。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "我們又見面了！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "\\n你好。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "哦哦！　",
    "voice": "vo_adv_1093003_087",
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "是昨天指路的大姊姊！",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "\\n",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "你也好～！",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "……好厲害。",
    "voice": "vo_adv_1093003_088",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "露",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "才過一天而已，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n就已經和蘭德索爾的許多人",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "成為朋友了……？",
