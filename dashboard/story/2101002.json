  },
  {
    "type": "background",
    "bg_id": "510370"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真是的……",
    "voice": "vo_adv_2101002_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你這人就是這樣，只會對小孩子才會感到興奮嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n真是令人困擾的變態呀。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
