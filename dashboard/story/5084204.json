  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…………",
    "voice": "vo_adv_5084204_003",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我說你們兩個！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n也說點什麼吧！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐……",
    "voice": "vo_adv_5084204_004",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就算您這麼說……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "別做這種勉強人的要求啦，凱留。",
    "voice": "vo_adv_5084204_005",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這附近魔物的氣息可是變得相當濃厚耶？",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n緊張都來不及了。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔，",
    "voice": "vo_adv_5084204_006",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可那傢伙在時，老是會說一些毫無緊張感的對話，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n結果現在沒人說話，反而令人感到不自在了……！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "記得這種時候，",
    "voice": "vo_adv_5084204_007",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可都會說……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對了！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "今天打倒的魔物，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "該怎麼吃比較好呢！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦……",
    "voice": "vo_adv_5084204_008",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "妳要吃那個",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "岩石的魔物！？",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐還真是調皮呢。",
    "voice": "vo_adv_5084204_009",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "意見這麼多是怎樣啦～～～～～～！",
    "voice": "vo_adv_5084204_010",
    "unit_id": 106011
  }
]
