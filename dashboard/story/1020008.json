  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "唔～嗯",
    "voice": "vo_adv_1020008_040",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……咦……？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美剛才在做什麼啊？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊～是哥哥！",
    "voice": "vo_adv_1020008_041",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……對啦！美美是和哥哥一起去買東西啊。",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美好像睡著了……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "但是、但是呢！",
    "voice": "vo_adv_1020008_042",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美做了一個非常開心的夢呦～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n夢到和很多兔子先生一起玩喔！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……咦！",
    "voice": "vo_adv_1020008_043",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n哥哥也做了一樣的夢嗎？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇～♪美美好開心喔～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊，還有呢，就是剛才提到的話題，",
    "voice": "vo_adv_1020008_044",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "下次在學校……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "對了！",
    "voice": "vo_adv_1020008_045",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美只要像在夢裡一樣，借助兔子先生之力就可以了～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "欸嘿嘿～因為～美美最喜歡兔子先生了，",
    "voice": "vo_adv_1020008_046",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "所以美美覺得自己好像也能蹦蹦地！跳得很高了～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "好～的！美美會加油的～！",
    "voice": "vo_adv_1020008_047",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嚕啦啦、嚕啦啦～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
