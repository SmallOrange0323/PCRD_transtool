  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗚嗚……",
    "voice": "vo_adv_1020008_000",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊，哥哥！",
    "voice": "vo_adv_1020008_001",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "那個呀，美美呢……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n下次在學校有個體育測驗……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦！？",
    "voice": "vo_adv_1020008_002",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n咦？這道光是之前的……？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥、哥哥，你在哪裡！？",
    "voice": "vo_adv_1020008_003",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n別丟下美美……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "呀啊啊！？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "background",
    "bg_id": "510330"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咻……",
    "voice": "vo_adv_1020008_004",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美明天該怎麼辦……嗚嗚。",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……啊，哥哥。",
    "voice": "vo_adv_1020008_005",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗯，美美呢，",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n沒什麼精神說……",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "那個呢，明天，",
    "voice": "vo_adv_1020008_006",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美在學校有跳箱測驗……",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "因為美美不太擅長運動，",
    "voice": "vo_adv_1020008_007",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n想說如果失敗的話該怎麼辦……",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "是這樣嗎～",
    "voice": "vo_adv_1020008_008",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "雖然哥哥都這麼說了，",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美是很想相信自己啦……",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "可是美美跳箱時總是跳不過去……",
    "voice": "vo_adv_1020008_009",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n所以果然還是沒有信心。",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗚……美美明天怎麼辦～",
    "voice": "vo_adv_1020008_010",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n……嗚嗚。",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦！？",
    "voice": "vo_adv_1020008_011",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n哥哥你怎麼了？",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "想和美美去一個地方……？",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……嗯！",
    "voice": "vo_adv_1020008_012",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美也要去～",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "background",
    "bg_id": "510140"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇！是動物園～♪",
    "voice": "vo_adv_1020008_013",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "有好～多兔子先生！",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "毛茸茸的～！",
    "voice": "vo_adv_1020008_014",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "可以盡情地和兔子先生們玩耍，",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美好幸福～♪",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥，你常來這裡嗎？",
    "voice": "vo_adv_1020008_015",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "小動物們很可愛對吧！",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "兔子先生的毛好蓬鬆～♪",
    "voice": "vo_adv_1020008_016",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "呀，好癢呦～",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n欸嘿嘿～♪",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "吶，哥哥要不要也來",
    "voice": "vo_adv_1020008_017",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n抱一下兔子先生呢？",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥～給你！",
    "voice": "vo_adv_1020008_018",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "毛茸茸的很舒服呦♪",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊～！",
    "voice": "vo_adv_1020008_019",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n兔、",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "兔子先生咬了",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n哥哥的手指嗎！？",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "欸～！",
    "voice": "vo_adv_1020008_020",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n兔子先生不可以做出讓哥哥覺得疼痛的事情喔～",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇哇！？",
    "voice": "vo_adv_1020008_021",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n兔子先生逃走了……",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "牠居然可以跳的那麼高啊～",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥，",
    "voice": "vo_adv_1020008_022",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n你別生兔子先生的氣喔？",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "牠只是被嚇到了而已。",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "你看你看，哥哥，",
    "voice": "vo_adv_1020008_023",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "你來餵這邊的兔子先生喝牛奶吧～",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不、",
    "voice": "vo_adv_1020008_024",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不要緊的～",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "牠已經不會咬哥哥了～",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗯！",
    "voice": "vo_adv_1020008_025",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "因為兔子先生很可愛，",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n所以絕對會很好玩的～",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "對吧？",
    "voice": "vo_adv_1020008_026",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n試著餵牠們喝牛奶吧～",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇！牠們喝得很盡興呢～♪",
    "voice": "vo_adv_1020008_027",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "真的非常可愛呢～",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "毛茸茸，蓬鬆的兔子先生～♪",
    "voice": "vo_adv_1020008_028",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n盡情地喝牛奶，快快長～大♪",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "欸嘿嘿～",
    "voice": "vo_adv_1020008_029",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n哥哥今天帶美美來動物園，",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "謝謝你～♪",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美，非常～非常的開心呦♪",
    "voice": "vo_adv_1020008_030",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……唔，可是，",
    "voice": "vo_adv_1020008_031",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n明天的跳箱測驗怎麼辦……嗚嗚。",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……咦？",
    "voice": "vo_adv_1020008_032",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n用兔子先生之力？",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "原來如此！美美就像剛才的兔子先生那樣，",
    "voice": "vo_adv_1020008_033",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "蹦蹦～地跳起來就可以了吧！",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美知道了！",
    "voice": "vo_adv_1020008_034",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美會用兔子先生之力加油的♪",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "謝謝哥哥～",
    "voice": "vo_adv_1020008_035",
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n託哥哥的福，",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美開始期待跳箱測驗了～",
    "voice": null,
    "unit_id": 102032
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "兔子先生之力啊～",
    "voice": "vo_adv_1020008_036",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "美美說的話真可愛～！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "美美雖然是個愛哭鬼，",
    "voice": "vo_adv_1020008_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不過她是一個拼命積極又努力的孩子，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以你也要給我好好地替她加油喔！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不只是在「那邊」的世界的夢裡，",
    "voice": "vo_adv_1020008_038",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n在「這邊」的世界也一樣呦♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次見囉～ ♪",
    "voice": "vo_adv_1020008_039",
