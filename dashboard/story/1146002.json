  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊──",
    "voice": "vo_adv_1146002_059",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "真是的！",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
