  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "想挽回也來不及了呢……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "總是逞強也沒什麼用呢。",
