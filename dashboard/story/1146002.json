    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但挺不可思議的呢。",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n被你這麼一說，好像就真的打起精神來了。",
