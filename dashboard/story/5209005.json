[
  {
    "type": "background",
    "bg_id": "502420"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雪野和璐璐伊前往巨鯨城。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}留在了久遠冰河，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在他面前是欲言又止的剎鬼靈體。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "到此為止了……",
    "voice": "vo_adv_5209005_000",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……沒時間了。",
    "voice": "vo_adv_5209005_001",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "替我跟雪野打聲招呼。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "受你關照了。",
    "voice": "vo_adv_5209005_002",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "有很多事情要謝謝你。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "唔……",
    "voice": "vo_adv_5209005_003",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "這樣耍不了帥啊。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n我都已經準備好消失了。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "不穩定的週期愈來愈短了。",
    "voice": "vo_adv_5209005_004",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n頂多只能再撐幾小時。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我欣賞你的毅力。",
    "voice": "vo_adv_5209005_005",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但是，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "那份力量也不是無限的吧。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "重點是沒有復活的線索。",
    "voice": "vo_adv_5209005_006",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "都準備好布丁了，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "卻連身體也被搶走……",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……對了，",
    "voice": "vo_adv_5209005_007",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "布丁。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n為什麼我沒有注意到──",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "background",
    "bg_id": "502460"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗚唔……",
    "voice": "vo_adv_5209005_008",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n好不舒服……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐……",
    "voice": "vo_adv_5209005_009",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也是嗎。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n彷彿是身體",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在拒絕食物一般……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n十分抗拒的感覺……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "──真是對不起呢？",
    "voice": "vo_adv_5209005_010",
    "unit_id": 195212
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "該說是內臟變得衰弱嗎……",
    "voice": null,
    "unit_id": 195212
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n因為黑暗精靈族祕傳的咒術，",
    "voice": null,
    "unit_id": 195212
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "讓生命力減弱了。",
    "voice": null,
    "unit_id": 195212
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 195212
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "更加接近死亡，",
    "voice": null,
    "unit_id": 195212
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "這樣說可能比較貼切吧。",
    "voice": null,
    "unit_id": 195212
  },
  {
    "type": "background",
    "bg_id": "502420"
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "──身體因為咒術而接近死亡的話，",
    "voice": "vo_adv_5209005_011",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "會接受不了食物。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但是，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "宮子卻用我的身體吃下了布丁。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "還吃得津津有味。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "也就是說，",
    "voice": "vo_adv_5209005_012",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "被宮子附身的身體，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "還沒有死。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "黎薩公用的應該不是對身體，",
    "voice": "vo_adv_5209005_013",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n而是對靈魂產生作用的詛咒。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "本來，",
    "voice": "vo_adv_5209005_014",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "作為目標的公主是殭屍。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "即使普通地殺掉，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "也死不了。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "因為本來就已經死了。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "所以，",
    "voice": "vo_adv_5209005_015",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "才會使用對靈魂產生作用的咒術。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "而不是平時所用的咒災之箭。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n這樣的話，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就能解釋為什麼宮子吃布丁吃得津津有味了。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……既然我",
    "voice": "vo_adv_5209005_016",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "現在像這樣存在。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n黎薩公那傢伙，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "可能也不是真的要置公主於死地。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "應該是打算",
    "voice": "vo_adv_5209005_017",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "讓她處於假死狀態吧。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但是因為宮子的關係，",
    "voice": "vo_adv_5209005_018",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n我被彈出體外，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就醒過來了。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……",
    "voice": "vo_adv_5209005_019",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "這下欠了宮子一個人情呢。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "雖然",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "那傢伙應該只是想吃布丁而已吧。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "她說不能順利離開身體，",
    "voice": "vo_adv_5209005_020",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "搞不好是真的。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "沒有靈魂的身體",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "可能正好適合她呢。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……至於吃了布丁是不是就能離開身體倒是很可疑。",
    "voice": "vo_adv_5209005_021",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "不過，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就當作是魔法之類的吧。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "沒錯。",
    "voice": "vo_adv_5209005_022",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "只要能回到身體裡，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就可以活過來……",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "可以活過來嗎……",
    "voice": "vo_adv_5209005_023",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "…………",
    "voice": "vo_adv_5209005_024",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……",
    "voice": "vo_adv_5209005_025",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "看在你陪我走到這裡的分上，才跟你說。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我果然──",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "不想死啊。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "和你們",
    "voice": "vo_adv_5209005_026",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "在吉歐‧尼布爾黑爾東奔西跑後。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n我開始搞不清楚自己的優先順序了。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我曾經覺得如何死去",
    "voice": "vo_adv_5209005_027",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "才是人的價值所在。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "沒有人能夠逃過死亡，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但至少可以選擇怎麼死。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "所謂的",
    "voice": "vo_adv_5209005_028",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "勇氣還有覺悟。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n我一直相信，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "那些才是有價值的。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "所以，",
    "voice": "vo_adv_5209005_029",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "那時候我的身體也立刻動了起來。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "因為一直以來，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我都是懷著那樣的想法而活。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "會這麼做是很自然的。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但是我看到的跑馬燈，",
    "voice": "vo_adv_5209005_030",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "和那些價值什麼的沒有關係。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "都是和雪野一起玩之類的",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "瑣碎小事。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "還有就是……",
    "voice": "vo_adv_5209005_031",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我的妹妹。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "是個跟雪野很像，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "溫柔又可愛的傢伙。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "為什麼死的不是我，",
    "voice": "vo_adv_5209005_032",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "而是妹妹。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我心裡一直這麼想著。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "自從妹妹死了之後，",
    "voice": "vo_adv_5209005_033",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我似乎就放棄了自己的生命。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "而我也對此有所自覺。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "…………",
    "voice": "vo_adv_5209005_034",
    "unit_id": 135915
  },
  {
    "type": "still",
    "still_id": "520900202"
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "…………但是，",
    "voice": "vo_adv_5209005_035",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "看到雪野和你很高興地表演。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n看到你們笑著的樣子，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "觸動了我的心。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "still",
    "still_id": "520900403"
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "同時，",
    "voice": "vo_adv_5209005_036",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "體認到自己已經不會再有這樣的時間。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "也不能和雪野一起把埋起來的時間膠囊挖出來。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "background",
    "bg_id": "502420"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我察覺到自己的寂寞。",
    "voice": "vo_adv_5209005_037",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "覺得不想死……",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "拜託了。",
    "voice": "vo_adv_5209005_038",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n請你",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "再幫我一次吧……",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "呼……",
    "voice": "vo_adv_5209005_039",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我竟然說了這樣的話。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n騎士公，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "感激不盡。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "剛才說的話",
    "voice": "vo_adv_5209005_040",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "要保密。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我可是相信你才說的。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "background",
    "bg_id": "502430"
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "穿過這裡之後就是巨鯨城了……",
    "voice": "vo_adv_5209005_041",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但是入口",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "有那些無頭們在。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "用騎士公的力量，",
    "voice": "vo_adv_5209005_042",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "讓他們看到我也是一種辦法。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "不過",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "不知道有誰和伯爵是一伙的。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n如果選錯人",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就完了。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "哼",
    "voice": "vo_adv_5209005_043",
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "～嗯……",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "不、",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "不行。",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "\\n這個蓋子太緊了，",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "打不開啊。",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "啊，",
    "voice": "vo_adv_5209005_044",
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "好像有人被關在章魚壺裡。",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "\\n",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "……你可以幫忙嗎？",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "啊，",
    "voice": "vo_adv_5209005_045",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "難道素",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "騎士先生嗎！？",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "請救救偶～！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "啊，",
    "voice": "vo_adv_5209005_046",
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "你頭腦真好！",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "\\n可能是我的腦子開始腐爛了，",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "所以才會想不到。",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "不過，",
    "voice": "vo_adv_5209005_047",
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "這刀子破破爛爛的……",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "\\n",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "啊，",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "我想起來了。",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "之前我撿到了一把好刀子。",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "嗯……？",
    "voice": "vo_adv_5209005_048",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n為什麼你會有那個……",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "要上了。",
    "voice": "vo_adv_5209005_049",
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "\\n喝啊……！",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "嗚啾……！？",
    "voice": "vo_adv_5209005_050",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n謝謝，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "得救了……！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "璐璐伊，",
    "voice": "vo_adv_5209005_051",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "發生什麼事了？",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n妳不是和雪野一起的嗎。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "到、",
    "voice": "vo_adv_5209005_052",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "到中途還在一起的。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶原本",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "正躲起來觀望會議的情況──",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "background",
    "bg_id": "502460"
  },
  {
    "type": "dialogue",
    "name": "宮子（剎鬼）",
    "words": "布丁在哪裡來的──！",
    "voice": "vo_adv_5209005_053",
    "unit_id": 135916
  },
  {
    "type": "dialogue",
    "name": "宮子（剎鬼）",
    "words": "\\n",
    "voice": null,
    "unit_id": 135916
  },
  {
    "type": "dialogue",
    "name": "宮子（剎鬼）",
    "words": "嗚咕咕",
    "voice": null,
    "unit_id": 135916
  },
  {
    "type": "dialogue",
    "name": "宮子（剎鬼）",
    "words": "咕──！？",
    "voice": null,
    "unit_id": 135916
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "給我乖乖閉上嘴。",
    "voice": "vo_adv_5209005_054",
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "\\n",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "…",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "…那麼各位，",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "事情原委就如我向大家說明的那樣。",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "\\n感謝各位",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "回應緊急召集。",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "那麼",
    "voice": "vo_adv_5209005_055",
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "就趕緊開始會議吧。",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "\\n",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "透過多數決來決定",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "剎鬼的最後處置。",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "黃泉的餐桌成員１",
    "words": "這些",
    "voice": "vo_adv_5209005_056",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黃泉的餐桌成員１",
    "words": "就是今天的全部成員嗎……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黃泉的餐桌成員１",
    "words": "\\n薇歐莉特公主竟然也不在，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黃泉的餐桌成員１",
    "words": "主流派的缺席真是顯眼呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "請、",
    "voice": "vo_adv_5209005_057",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "請",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "等一下……",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "鬼族族長也不在……",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "聽說他正負責指揮討伐",
