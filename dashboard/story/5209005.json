    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "咦咦……！？",
    "voice": "vo_adv_5209005_061",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "黃泉的餐桌成員２",
    "words": "剎鬼被惡靈附身了，",
    "voice": "vo_adv_5209005_062",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黃泉的餐桌成員２",
    "words": "不處理掉的話會造成混亂。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黃泉的餐桌成員２",
    "words": "\\n應該用脊柱大廳的靈炎之壁",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黃泉的餐桌成員２",
    "words": "將其燒成灰。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黃泉的餐桌成員２",
    "words": "\\n至於公主候補，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黃泉的餐桌成員２",
    "words": "要重新提名人選才合理。",
