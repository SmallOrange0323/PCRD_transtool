    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "黃泉的餐桌成員１",
    "words": "唔，",
    "voice": "vo_adv_5209005_082",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黃泉的餐桌成員１",
    "words": "為什麼烏賊女會在這裡？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黃泉的餐桌成員１",
    "words": "\\n妳這傢伙在黃泉的餐桌並沒有席位吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "嗚啾……！？",
    "voice": "vo_adv_5209005_083",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "璐璐伊，",
    "voice": "vo_adv_5209005_084",
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "原來妳躲在那裡啊。",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "\\n",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "反正都是要躲，",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "\\n就把妳關在",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "妳最喜歡的章魚壺裡吧。",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "background",
    "bg_id": "502430"
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "──在那之後，",
    "voice": "vo_adv_5209005_085",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶就不知道了……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "雪野姐接她，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "沒有問題吧……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "這樣啊……",
    "voice": "vo_adv_5209005_086",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "說起來，",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "妳還有帶著剩下的布丁嗎？",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "啊，",
    "voice": "vo_adv_5209005_087",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "素的……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n雖然",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "幾乎都塌掉了……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "妳拿著這個",
    "voice": "vo_adv_5209005_088",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "在這裡等。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我去看看雪野的情況。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "那些傢伙",
    "voice": "vo_adv_5209005_089",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "看不到現在的我。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n可以直接進去。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "大家從剛才開始，",
    "voice": "vo_adv_5209005_090",
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "都在跟誰說話啊……？",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "\\n在這裡的，",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "應該只有三個人吧？",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "\\n",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "是因為我的眼珠也開始腐爛了，",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "舔刀子氏",
    "words": "所以才看不到嗎……？　",
    "voice": null,
    "unit_id": 816
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "好。",
    "voice": "vo_adv_5209005_091",
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n我去去",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就回。",
    "voice": null,
    "unit_id": 135915
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "巨鯨城正在進行黃泉的餐桌會議。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}他們在後面",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "目送剎鬼潛入巨鯨城。",
    "voice": null,
    "unit_id": null
  }
]
