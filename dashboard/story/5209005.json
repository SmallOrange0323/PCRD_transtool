  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "\\n",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "雪野是被異界人唆使了。",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "咦？",
    "voice": "vo_adv_5209005_069",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "各位，",
    "voice": "vo_adv_5209005_070",
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "對於之前的事件還記憶猶新吧。",
