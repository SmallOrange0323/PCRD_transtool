  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "\\n",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "當然，",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "這次的事件也一樣。",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "黃泉的餐桌成員２",
    "words": "果然，",
    "voice": "vo_adv_5209005_074",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黃泉的餐桌成員２",
    "words": "不應該再留下混亂的根源呢。",
