    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "也是在名為阿斯特朗的異世界──",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "\\n也就是那些傢伙的世界裡發生的。",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "\\n",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "要說這些事是巧合，",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "未免也太剛好了吧？",
    "voice": null,
    "unit_id": 2516
  },
  {
    "type": "dialogue",
    "name": "奧洛克伯爵",
    "words": "雖然薇歐莉特公主",
