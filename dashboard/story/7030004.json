[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}他們離開了露娜之塔，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在塔中仍有著",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "低聲交談的細微聲音。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "走了啊。",
    "voice": "vo_adv_7030004_000",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "已經看不見他們的身影了。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "…………",
    "voice": "vo_adv_7030004_001",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "很",
    "voice": "vo_adv_7030004_002",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "寂寞。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n你，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "會這麼覺得嗎。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "不會。",
    "voice": "vo_adv_7030004_003",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "……這麼說或許是騙人的，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "但畢竟本來就連萬分之一的可能性都沒有。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "能夠遇見另一個我，",
    "voice": "vo_adv_7030004_004",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "還有她。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n光是這樣就夠了。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n對於由記憶碎片構成的我來說，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "已經別無所求。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "謝謝妳，",
    "voice": "vo_adv_7030004_005",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "米奈娃。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "被收集起的、",
    "voice": "vo_adv_7030004_006",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "你的記憶碎片們。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "沒想到，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "竟能像這樣",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "復原出「你」。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "我原本，",
    "voice": "vo_adv_7030004_007",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "沒有",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "這麼做的理由和必要。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "……然而。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "一定是因為──",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "我，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "一直接觸她的願望。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "所以就產生感情了吧。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "雖說是跟塔的Bug產生共鳴，",
    "voice": "vo_adv_7030004_008",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "但就如同奇蹟一般……",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "不。",
    "voice": "vo_adv_7030004_009",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "果然──",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "還是彌補不了0.1％的缺口。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "你跟原本的他並不完全相同，",
    "voice": "vo_adv_7030004_010",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n跟現在的他既是相同，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "卻也不同。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "雖然細微到光憑資訊，",
    "voice": "vo_adv_7030004_011",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "或電子訊號都測量不出來，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n但",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "確實存在著",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "絕對性的差異。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "所以厄莉絲才選了他吧。",
    "voice": "vo_adv_7030004_012",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n她看出了",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "我終究只是他的複製品。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "既然她自己主動去尋求",
    "voice": "vo_adv_7030004_013",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "與他共度的未知未來，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n我想為她高興。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "還有，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "目送他們離開的你也是。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "製作物擁有自我，",
    "voice": "vo_adv_7030004_014",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "仿造品擁有願望，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n我認為十分值得愛惜──",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "另一個{0}。",
    "voice": "vo_adv_7030004_015",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n我想向你，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "提出一個請求。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "能請你守護這座塔嗎？",
    "voice": "vo_adv_7030004_016",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "守護對那兩人來說，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "相當於「祕密基地」的這個地方。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "我總有一天",
    "voice": "vo_adv_7030004_017",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "會離開這裡。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n因為接下來，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "我有必須要做的事。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "……嗯，",
    "voice": "vo_adv_7030004_018",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "當然可以。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n我也知道",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "米奈娃在防備的事情。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "這裡很長一段時間，",
    "voice": "vo_adv_7030004_019",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "是以連製作者都沒預料到的方式在成長的，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n所以必須有人看守才行。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n……對吧？",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "謝謝你。",
    "voice": "vo_adv_7030004_020",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n願你",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "於萬象之塔下，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "受到天象的加護。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "並且。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "願你獲得太陽與星星的祝福。",
    "voice": "vo_adv_7030004_021",
    "unit_id": 191112
  }
]
