  {
    "type": "dialogue",
    "name": "旁白",
    "words": "美咲與正在等著她的{0}。\\n就在兩人會合的那瞬間，他們被一道奇怪的光芒包圍了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "什、",
    "voice": "vo_adv_1050004_000",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "什麼，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這道光是！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呀啊啊啊！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "background",
    "bg_id": "510120"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嘿……！",
    "voice": "vo_adv_1050004_001",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n可惡……",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "為什麼",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不會動啦！",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可惡、",
    "voice": "vo_adv_1050004_002",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可惡！",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n如果我",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這樣的話呢！！",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不行……",
    "voice": "vo_adv_1050004_003",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我盪不起來……",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真的嗎？",
    "voice": "vo_adv_1050004_004",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那麼，拜託你了――",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "腳？",
    "voice": "vo_adv_1050004_005",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我試試看――",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "still",
    "still_id": "105000401"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呃、",
    "voice": "vo_adv_1050004_006",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "原來是你呀！？",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你是什麼時候來的！？",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就、",
    "voice": "vo_adv_1050004_007",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就在剛剛？",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你說的是真的嗎……？",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你在這種地方閒晃，",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是很閒嗎？",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦？",
    "voice": "vo_adv_1050004_008",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你說我才是",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "在這裡做什麼？",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呃……",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這個是、",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那個……",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "反、",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "反正我不是在玩啦！",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我可是成熟的淑女唷！",
    "voice": "vo_adv_1050004_009",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n怎麼可能會喜歡玩盪鞦韆！",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這種幼稚的東西……",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這是、",
    "voice": "vo_adv_1050004_010",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那個啦。",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呃……",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "對了！",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我是在示範給這些小孩看！",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦，",
    "voice": "vo_adv_1050004_011",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "騙人！？",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這裡是公園耶，",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "至少要有個人給我在這裡玩耍呀……！",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "總、",
    "voice": "vo_adv_1050004_012",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "總之！",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我不是像小孩子那樣在玩盪鞦韆！",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……什麼？",
    "voice": "vo_adv_1050004_013",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n換你來玩……",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你要盪鞦韆？",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "為、",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "為什麼",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你要玩啊？",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊～啊，",
    "voice": "vo_adv_1050004_014",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你還真的盪起鞦韆來了……",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "玩盪鞦韆玩得那麼興奮，",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你根本就是小孩子吧？",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦？",
    "voice": "vo_adv_1050004_015",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你說現在在大人之間很流行玩盪鞦韆！？",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你、",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你是在說謊吧！",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我可是不會被",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那種謊話矇騙過去的！",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不、",
    "voice": "vo_adv_1050004_016",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過……",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "好像有點好玩……",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……幹嘛啦？",
    "voice": "vo_adv_1050004_017",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你想要我也跟你一起玩嗎？",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我就說了，",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我才不會做那種幼稚的行為……",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可是，",
    "voice": "vo_adv_1050004_018",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "拒絕男人的邀請，",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n對一位成熟女性來說",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是不太好的吧。",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真拿你沒辦法，",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我就陪你玩吧！",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不、",
    "voice": "vo_adv_1050004_019",
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過做為條件！",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你得教我",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "盪鞦韆的方法！",
    "voice": null,
    "unit_id": 105031
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "盪鞦韆在大人之間很流行？",
    "voice": "vo_adv_1050004_020",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你喔……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "說謊也要給我適可而止啊～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯～",
    "voice": "vo_adv_1050004_021",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過因為這樣，美咲也開心地盪了鞦韆，這次就算了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這就是善意的謊言？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但是美咲居然不擅長盪鞦韆，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "還真是令人意外呢～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯？",
    "voice": "vo_adv_1050004_022",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "剛剛的情景，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是我依照你和美咲的「記憶碎片」",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n創造出來的「夢」唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果你收集到更多的「記憶碎片」，",
