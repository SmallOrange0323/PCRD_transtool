[
  {
    "type": "dialogue",
    "name": "依里",
    "words": "呼啊……",
    "voice": "vo_adv_5106308_000",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "呼啊……！",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n那傢伙……",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "好難搞……",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我們這種新手天使",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是不是打不贏啊……",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "確實……",
    "voice": "vo_adv_5106308_001",
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n仔細想想，",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我們是超超級新手的天使呢……",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好像失去信心了。",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呼……",
    "voice": "vo_adv_5106308_002",
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呼……",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳們說什麼啊？",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n讓艾米和拉菲成為更成熟的天使的人，",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不是別人，",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就是妳們吧？　",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "對自己有點信心，",
    "voice": "vo_adv_5106308_003",
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n妳們已經是名副其實的",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "厲害天使了。",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "純小姐……",
    "voice": "vo_adv_5106308_004",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "天使的任務是什麼呢？",
    "voice": "vo_adv_5106308_005",
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "天使的",
    "voice": "vo_adv_5106308_006",
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "任務……？",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那就是……",
    "voice": "vo_adv_5106308_007",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里、茜里",
    "words": "讓人們幸福……！",
    "voice": "vo_adv_5106308_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "對。",
    "voice": "vo_adv_5106308_009",
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n任務只差一步就完成了啊。",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n──來吧，",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為了蘭德索爾的人們，",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "找回幸福的聖誕節吧！",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "依里、茜里",
    "words": "……！",
    "voice": "vo_adv_5106308_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里、茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里、茜里",
    "words": "──好！",
    "voice": null,
    "unit_id": null
  }
]
