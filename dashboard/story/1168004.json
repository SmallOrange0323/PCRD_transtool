    "words": "剛、",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "剛才那是什麼夢喵！？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "每次都這樣，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真是超神奇的現象喵……！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我能夠幫助到{0}，",
    "voice": "vo_adv_1168004_061",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n這樣是很棒……",
