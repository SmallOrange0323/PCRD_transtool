    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過……",
    "voice": "vo_adv_1168004_062",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那是夢裡的事情，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n這次都是受{0}幫助喵。",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但是也因此",
    "voice": "vo_adv_1168004_063",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "讓我學會了很多事情，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n幻影貓的裝備也有所提升了喵。",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "所以我總有一天",
    "voice": "vo_adv_1168004_064",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n要讓{0}也目睹我夢中的光景，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n向你報恩喵！",
