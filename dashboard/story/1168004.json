    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}，也很感謝你這段日子的幫忙喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真不知該怎麼說……",
    "voice": "vo_adv_1168004_005",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我總是受到{0}的幫助，",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n卻都沒有給你相應的謝禮……",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這個是……",
    "voice": "vo_adv_1168004_006",
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我最後要犒賞你的鯛魚燒喵！",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我多放了點料……",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "怎麼樣喵！？",
    "voice": null,
    "unit_id": 116811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n看到這麼大一個鯛魚燒，",
