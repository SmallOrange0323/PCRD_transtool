[
  {
    "type": "background",
    "bg_id": "500180"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "遠離蘭德索爾的某個地方。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n少女隻身一人走在險峻的道路上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼……",
    "voice": "vo_adv_5058005_000",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在這附近",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "休息一下吧……！",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "已經離蘭德索爾",
    "voice": "vo_adv_5058005_001",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "很遠了呢。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好久沒自己一個人走這麼遠了。",
    "voice": "vo_adv_5058005_002",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "自從遇見主公大人之後，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下幾乎是寸步不離地",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n跟他在一起……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "上次和主公大人分隔兩地",
    "voice": "vo_adv_5058005_003",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是什麼時候的事了呢？",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就算",
    "voice": "vo_adv_5058005_004",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒有在下叫醒，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n主公大人是不是也能自己準時起床呢？",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人的睡臉實在惹人憐愛，",
    "voice": "vo_adv_5058005_005",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n讓在下每天早上都忍不住凝望起來……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "等主公大人起床",
    "voice": "vo_adv_5058005_006",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "更衣後，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下再替他擦臉……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但主公大人",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還是會一副睡眼惺忪的模樣",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……呵呵。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "──今天天氣真不錯，",
    "voice": "vo_adv_5058005_007",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n很適合洗衣服。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這時是",
    "voice": "vo_adv_5058005_008",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "大夥兒的午餐時間嗎？",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不曉得主公大人",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有沒有好好吃飯……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人能不能拿好筷子呢……",
    "voice": "vo_adv_5058005_009",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嘴邊是否吃得髒兮兮呢……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是不是有挑食呢……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "應該不要緊吧。",
    "voice": "vo_adv_5058005_010",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n畢竟有個看似粗魯，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "實則很會照顧人的凱留小姐在。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐她……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一定會代替在下",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "照料主公大人的。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "另外，",
    "voice": "vo_adv_5058005_011",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "挑食這件事",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只要有貪吃佩可小姐在就沒問題了。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n她每天",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都會為了在下等人",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "想出各種菜單。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "今後",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人也要麻煩您了。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "──日上三竿了嗎？",
    "voice": "vo_adv_5058005_012",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "得好好吃頓午餐，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "確實補充營養。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個時間",
    "voice": "vo_adv_5058005_013",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人差不多要出門打工了。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……他應該沒有迷路吧？",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "平常在下",
    "voice": "vo_adv_5058005_014",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也會隨行，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "以免主公大人迷路……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不對……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "事情不是那樣。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "近來主公大人",
    "voice": "vo_adv_5058005_015",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "愈來愈少迷途，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n不再需要",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下陪同了。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只不過是",
    "voice": "vo_adv_5058005_016",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n想盡可能",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "多陪在主公大人身邊……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而已。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "background",
    "bg_id": "500181"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "──快要天黑了……",
    "voice": "vo_adv_5058005_017",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "晚餐前",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "再多走",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一段吧。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，",
    "voice": "vo_adv_5058005_018",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "說到晚餐……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一到這個時間，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n主公大人總會",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "率先去幫忙",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐下廚。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐",
    "voice": "vo_adv_5058005_019",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "則是會",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "以試吃為由，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n親自拿起剛做好的菜餚",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "給主公大人吃。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人",
    "voice": "vo_adv_5058005_020",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "很期待試吃這件事，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n可可蘿可是一清二楚喔。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "background",
    "bg_id": "500182"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "──這個時候……",
    "voice": "vo_adv_5058005_021",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵，",
    "voice": "vo_adv_5058005_022",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這可不行。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n一想到主公大人，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下就忘了時間。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那段對在下而言",
    "voice": "vo_adv_5058005_023",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "無可取代的時光。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "充滿幸福的",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "短暫片刻。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊──",
    "voice": "vo_adv_5058005_024",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好想……",
    "voice": "vo_adv_5058005_025",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "立刻回去。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "回到那",
    "voice": "vo_adv_5058005_026",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "溫暖的住處。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "回到那",
    "voice": "vo_adv_5058005_027",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "充滿歡笑的餐桌邊。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "回到那",
    "voice": "vo_adv_5058005_028",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "溫柔的笑容面前。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過，",
    "voice": "vo_adv_5058005_029",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這些都已經是、",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "無法實現的願望了。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下，",
    "voice": "vo_adv_5058005_030",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n會把這份如同寶石般",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "璀璨的回憶深藏在心中，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不斷地誠心祈禱。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "祈禱貪吃佩可小姐……",
    "voice": "vo_adv_5058005_031",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "【美食殿堂】的各位",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "能獲得幸福。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那些日子……",
    "voice": "vo_adv_5058005_032",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那些日子實在是太美好、",
    "voice": "vo_adv_5058005_033",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "太幸福了，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下甚至無福消受……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "可可蘿頭也不回地邁步而去。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n筆直前行的她，盼望自己重視的人能得到幸福──",
    "voice": null,
    "unit_id": null
  }
]
