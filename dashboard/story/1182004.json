    "type": "dialogue",
    "name": "魅空",
    "words": "真可靠★",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n不愧是男孩子，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "的感覺呢──♪",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "而且……",
    "voice": "vo_adv_1182004_036",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n這種事情",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "似乎很令人心動呢♪",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n感覺就像間諜電影的場面不是嗎？",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "確實，",
    "voice": "vo_adv_1182004_037",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "被捉到的話。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n我又會被裝上反超能裝置，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "然後被關起來……",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "呵呵♪",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "不過怎麼說呢──",
    "voice": "vo_adv_1182004_038",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n像這樣被別人幫助，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "感覺真好──★",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "畢竟一～直以來",
    "voice": "vo_adv_1182004_039",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "都沒有會為了我挺身而出，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n幫助我的人。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "一個都沒有。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "這個嘛，",
    "voice": "vo_adv_1182004_040",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "因為我超級可愛★",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "……才怪……",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "應該說我",
    "voice": "vo_adv_1182004_041",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "是這個世界裡超乎常理的存在？",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n之類的，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "像是系統錯誤一樣的存在呢──",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "多虧如此，",
    "voice": "vo_adv_1182004_042",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "我就被綁架、被當成實驗品了。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n真希望他們可以放過我啊──",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "順帶一提，我父母也因此死掉了呢？",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "……啊哈。",
    "voice": "vo_adv_1182004_043",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n我也已經不記得他們的長相了，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "所以不用在意喔★",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "比起這個──",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "我們差不多",
    "voice": "vo_adv_1182004_044",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "要在這裡說再見了♪",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n謝謝你",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "這麼努力踩腳踏車幫我。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "咦？",
    "voice": "vo_adv_1182004_045",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "畢竟你看。",
    "voice": "vo_adv_1182004_046",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n我們腳也會累，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n也不可能永遠這樣",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "騎腳踏車逃跑對吧？",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "因為",
    "voice": "vo_adv_1182004_047",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "那些追兵的最終目標是我。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n如果陪我到最後，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n連你都會遭遇不幸喔？",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "但是？",
    "voice": "vo_adv_1182004_048",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "……哇★",
    "voice": "vo_adv_1182004_049",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "哇～★",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "在這種狀況下",
    "voice": "vo_adv_1182004_050",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "還真的說出這種話。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n不愧是你，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "的感覺呢。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "……呵呵。",
    "voice": "vo_adv_1182004_051",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "真好呢──",
