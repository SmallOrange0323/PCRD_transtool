[
  {
    "type": "background",
    "bg_id": "500341"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在與剛從昏睡狀態中清醒的可可蘿聯絡後，\\n矛依未等人開始準備同時營救貪吃佩可\\n以及襲擊王宮的兩種作戰。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這樣就沒問題了……",
    "voice": "vo_adv_1061003_000",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "傳信鴉也送回去了，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n接下來就只剩準備執行了。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "配置已經想好了。",
    "voice": "vo_adv_1061003_001",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "日期時間也已經決定好了。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n還有就是……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯……",
    "voice": "vo_adv_1061003_002",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那個……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可惡啊……",
    "voice": "vo_adv_1061003_003",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真的沒問題嗎？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我們的作戰計畫，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "贏得過真那嗎……？　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這種時候要是有尾狗刀在，",
    "voice": "vo_adv_1061003_004",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "一定能更順利的……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "如果那傢伙在的話，",
    "voice": "vo_adv_1061003_005",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n肯定會一臉嫌麻煩卻想出一個",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "聰明又狡猾的作戰計畫……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "尾狗刀……",
    "voice": "vo_adv_1061003_006",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你現在，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "究竟在哪裡，在做什麼呢……？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你就不能一臉嫌麻煩地",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "從哪裡冒出來嗎……！　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "怎麼了？",
    "voice": "vo_adv_1061003_007",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "妳看起來好像很煩惱，",
    "voice": "vo_adv_1061003_008",
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "諾維姆。",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "才、",
    "voice": "vo_adv_1061003_009",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "才沒有煩惱呢！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "作戰計畫順不順利什麼的，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我才沒有在擔心呢！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "啥？",
    "voice": "vo_adv_1061003_010",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "妳這傢伙，該不會在害怕了吧？",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "可別到這地步才說要臨陣脫逃喔？",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "才不會呢！",
    "voice": "vo_adv_1061003_011",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "有什麼煩惱的話請說出來，",
    "voice": "vo_adv_1061003_012",
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "諾維姆。",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "\\n",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "妳還得",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "領導我們才行。",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "沒錯！",
    "voice": "vo_adv_1061003_013",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "因為如果要救吾主似似花大人，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "就必須要有妳的協助！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "拉基拉基……",
    "voice": "vo_adv_1061003_014",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真軌……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "哼！",
    "voice": "vo_adv_1061003_015",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "總算變得像話一點了！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "只要露出這種表情就好了啦，妳啊。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大吾，",
    "voice": "vo_adv_1061003_016",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你……！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "到底想說什麼？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "這就讓我來說明吧！",
    "voice": "vo_adv_1061003_017",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "大吾所說的這些話，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n都是用來激勵妳的！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "啥！",
    "voice": "vo_adv_1061003_018",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "真軌你這傢伙！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n別隨便拆穿別人啦！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "激勵……",
    "voice": "vo_adv_1061003_019",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊啊！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你那是在安慰我嗎？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n那一開始這麼說就好啦──！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "很難懂欸！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "妳居然還有意見……！",
    "voice": "vo_adv_1061003_020",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "啊啊是喔！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n我不會再做第二次了！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "絕不！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n妳就沮喪一輩子吧！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "幹嘛突然生氣！",
    "voice": "vo_adv_1061003_021",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我又沒說不喜歡！？",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "是、",
    "voice": "vo_adv_1061003_022",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "那就好啦……",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "總之真軌！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "不要動喔？",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "哈哈哈哈！",
    "voice": "vo_adv_1061003_023",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "你幹嘛握起拳頭啊，大吾！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "這不是一副要把我打飛的架式嗎！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "知道就好！",
    "voice": "vo_adv_1061003_024",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "那你就乖乖給我挨揍！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊，",
    "voice": "vo_adv_1061003_025",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "又來了……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不要鬧得太誇張喔！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n還有就是別弄壞東西啊！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真是的……",
    "voice": "vo_adv_1061003_026",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那些傢伙，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "從以前感情就不好。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n在索爾之塔時兩人也針鋒相對過。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "太好了。",
    "voice": "vo_adv_1061003_027",
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "妳終於恢復笑容了。",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……我之前的表情真的那麼難看嗎？",
    "voice": "vo_adv_1061003_028",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "就我看過妳擺出的表情裡，",
    "voice": "vo_adv_1061003_029",
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "\\n我覺得那算是相當愁眉苦臉的喔。",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是嗎……",
    "voice": "vo_adv_1061003_030",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "一直到前不久，",
    "voice": "vo_adv_1061003_031",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我一直努力獨自處理所有事，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n也覺得那樣就好。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但是現在，",
    "voice": "vo_adv_1061003_032",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "必須大家一起努力。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不知為何……",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "總覺得很不安。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "不安",
    "voice": "vo_adv_1061003_033",
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "\\n",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "如果有什麼",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "是我們能做的就好了……",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "妳是笨蛋嗎？",
    "voice": "vo_adv_1061003_034",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "一個人一直亂想一點意義都沒有。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n我們一起大戰一場然後贏得勝利！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "不就是這樣而已嗎！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大吾……",
    "voice": "vo_adv_1061003_035",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "我也跟大吾有相同想法！",
    "voice": "vo_adv_1061003_036",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "若是想太多，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n會容易畫地自限！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真軌……",
    "voice": "vo_adv_1061003_037",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "沒問題的，",
    "voice": "vo_adv_1061003_038",
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "諾維姆。",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "妳已經不再孤獨。",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "\\n",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "和我們一起，",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "同心協力戰鬥吧。",
    "voice": null,
    "unit_id": 107311
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "拉基拉基……",
    "voice": "vo_adv_1061003_039",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……我真是笨蛋。",
    "voice": "vo_adv_1061003_040",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真的很笨。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大吾說的沒錯。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "所以不如就像笨蛋一樣，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大戰一場然後贏得勝利吧！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "喔！",
    "voice": "vo_adv_1061003_041",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "去大鬧一番吧！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "真是淺顯易懂的目的！",
    "voice": "vo_adv_1061003_042",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "我也會全力揮舞這劍！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……一路走到這裡，雖然發生了很多事，",
    "voice": "vo_adv_1061003_043",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n但有他們真是太好了。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "若和他們一起，",
    "voice": "vo_adv_1061003_044",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "一定沒問題的。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n尾狗刀，",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我一定會把你找回來！　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……大家，",
    "voice": "vo_adv_1061003_045",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "謝謝你們啊。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "有你們在",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真好。",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "今後也請",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "多多指教！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "……妳剛剛說了什麼嗎？",
    "voice": "vo_adv_1061003_046",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你說什麼！？",
    "voice": "vo_adv_1061003_047",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "別裝傻啦，大吾！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你一定有聽到吧！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "哈！",
    "voice": "vo_adv_1061003_048",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "還不是某人說什麼講話很難懂，\\n害我這麼丟臉！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "這是回敬妳的！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你、",
    "voice": "vo_adv_1061003_049",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你這……！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你給我記住──！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我絕對不可能會忘記的！",
    "voice": "vo_adv_1061003_050",
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n把真那打倒，將全部奪回！",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大家的記憶、",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還有搭檔！　",
    "voice": null,
    "unit_id": 106112
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "――接著在作戰當日，\\n矛依未完美的扮演了誘餌的角色。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "――想跟我戰鬥的都放馬過來！！",
    "voice": "vo_adv_1061003_051",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我要把你們全部一起打飛！！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "用這把天樓霸斷劍！！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "來吧，",
    "voice": "vo_adv_1061003_052",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "接下來換誰！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不自己來的話我要過去囉！！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "嗚、",
    "voice": "vo_adv_1061003_053",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "嗚喔喔喔喔！！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "怕了吧！？",
    "voice": "vo_adv_1061003_054",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那就是你輸了！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喔啊啊啊啊啊啊啊！！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "士兵",
    "words": "哇啊啊啊啊啊！！",
    "voice": "vo_adv_1061003_055",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哼哼！",
    "voice": "vo_adv_1061003_056",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就這點本事？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "再來啊！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "放馬過來！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我是諾維姆！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我可是世紀大壞蛋，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "諾維姆大人呢！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我這裡即使只有一個人，",
    "voice": "vo_adv_1061003_057",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也會盡力做完能做的事……！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "加油啊，各位！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "等等我啊，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "尾狗刀！　",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雖然矛依未一直孤軍奮戰，\\n但現在的她開始學會信任夥伴了。",
    "voice": null,
    "unit_id": null
  }
]
