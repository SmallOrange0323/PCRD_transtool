[
  {
    "type": "background",
    "bg_id": "502460"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天晚上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在宅第的大廳裡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n格蕾斯正一臉憂心地思考著什麼事。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "…………",
    "voice": "vo_adv_1330003_000",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "……我有聽說，",
    "voice": "vo_adv_1330003_001",
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "妳跟一個騎士少年走得很近。",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "\\n這是真的嗎格蕾斯？",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "守護薇歐莉特公主。",
    "voice": "vo_adv_1330003_002",
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "\\n如果會影響到這份職責，",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "\\n我是絕不會認可",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "這種輕浮的男女關係。",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……這不用你說我也知道。",
    "voice": "vo_adv_1330003_003",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "唔。",
    "voice": "vo_adv_1330003_004",
    "unit_id": 133012
  },
  {
    "type": "background",
    "bg_id": "502290"
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "好乖好乖。",
    "voice": "vo_adv_1330003_005",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "辛苦你了，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "布羅肯。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "布羅肯",
    "words": "嘶嘶──！",
    "voice": null,
    "unit_id": 52511
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "那麼，",
    "voice": "vo_adv_1330003_006",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "騎士氏。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "感謝你陪我到這麼遠的地方來。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "是的。",
    "voice": "vo_adv_1330003_007",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這裡就是骷髏飛龍盤據的地方──",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n牠是會狩獵誤闖沙漠之人的兇猛魔物，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n是這次要討伐的目標。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "騎士氏。",
    "voice": "vo_adv_1330003_008",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這是相當危險的對手，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你沒問題嗎？",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……是",
    "voice": "vo_adv_1330003_009",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "嗎。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……唔。",
    "voice": "vo_adv_1330003_010",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n出現了。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "…………\\n……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "胡鬧。",
    "voice": "vo_adv_1330003_011",
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n……如果是那樣，",
    "voice": null,
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "該有多好呢。",
    "voice": null,
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這也是為了，",
    "voice": "vo_adv_1330003_012",
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "要做個了斷。",
    "voice": null,
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n……騎士氏。",
    "voice": null,
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我要討伐你。",
    "voice": "vo_adv_1330003_013",
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "喝啊啊！",
    "voice": "vo_adv_1330003_014",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你果然很輕易地就被騙了呢。",
    "voice": "vo_adv_1330003_015",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n天真也該有個限度。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……來吧，",
    "voice": "vo_adv_1330003_016",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "拔出你的劍。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "就如同字面上的意思。",
    "voice": "vo_adv_1330003_017",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n我要你拔劍跟我戰鬥。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "呵呵。",
    "voice": "vo_adv_1330003_018",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這是我至今為止見過你最驚訝的表情呢。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "已經沒有遺憾了。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "來吧，",
    "voice": "vo_adv_1330003_019",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "快點拔劍。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n不然，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "可是會被我的長槍給貫穿的哦──",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "喝！",
    "voice": "vo_adv_1330003_020",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……理由。",
    "voice": "vo_adv_1330003_021",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "那麼，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "就當作是送你去陰間的伴手禮吧。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我現在最優先的事項是，",
    "voice": "vo_adv_1330003_022",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "保護菫──",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "保護薇歐莉特公主。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n身為守護騎士，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這份決心必須如長槍般銳利",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n且不能有任何動搖。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……但是……",
    "voice": "vo_adv_1330003_023",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我只要看到，",
    "voice": "vo_adv_1330003_024",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "騎士氏你那傻呼呼的表情……",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n槍尖，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "就會開始動搖。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……呼。",
    "voice": "vo_adv_1330003_025",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "話就說到這裡。",
    "voice": "vo_adv_1330003_026",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你快拔劍吧。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n不然的話──",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "喝啊……！",
    "voice": "vo_adv_1330003_027",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "快拔劍。",
    "voice": "vo_adv_1330003_028",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "快拔劍！",
    "voice": "vo_adv_1330003_029",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "喝啊啊！！",
    "voice": "vo_adv_1330003_030",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "…………",
    "voice": "vo_adv_1330003_031",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……哦。",
    "voice": "vo_adv_1330003_032",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n你的意思是我只是一臉得意地飄在空中，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "刺來刺去而已？",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "怎麼了騎士氏。",
    "voice": "vo_adv_1330003_033",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n有什麼想說的就說出來吧。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "「這幾天，",
    "voice": "vo_adv_1330003_034",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "與格蕾斯小姐相處之後明白了」？",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "喔？",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "明白了什麼？",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "…………\\n……",
    "voice": "vo_adv_1330003_035",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "呵……",
    "voice": "vo_adv_1330003_036",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "呵呵呵。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "哈哈哈！",
    "voice": "vo_adv_1330003_037",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你說我很喜歡胡鬧！",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n像我這種活在陰暗又潮濕的死者世界裡的亡靈！",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n很喜歡胡鬧！！",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "哈哈哈！！",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你答對了。",
    "voice": "vo_adv_1330003_038",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你很有眼光呢騎士氏。",
    "voice": "vo_adv_1330003_039",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n我超喜歡的。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "胡鬧。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不過，",
    "voice": "vo_adv_1330003_040",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我也逐漸開始了解你了。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n雖然一臉天真又純真無邪的樣子，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "但你其實是個會吐槽的人呢。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "可以的哦騎士氏。",
    "voice": "vo_adv_1330003_041",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n既然都到這地步了，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你想吐槽什麼都沒關係。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你說你不知道什麼是吐槽？",
    "voice": "vo_adv_1330003_042",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這個嘛，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "只要指出你覺得有點奇怪的地方就好了。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不需要有所顧慮。",
    "voice": "vo_adv_1330003_043",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n嗯嗯……",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "「那麼，有件事從之前就很在意」？",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "………………",
    "voice": "vo_adv_1330003_044",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……雖然，",
    "voice": "vo_adv_1330003_045",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "是我說什麼都可以的……",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "但這會不會太過深入了點……？",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……不過……",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我還是說吧……",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "為什麼我只有一邊打赤腳。",
    "voice": "vo_adv_1330003_046",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n這就要從一個，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "聽者傷心、",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "說者流淚的",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "悲劇故事說起……",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "才沒有這回事。",
    "voice": "vo_adv_1330003_047",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n答案就是──",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "「我在等人吐槽」。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "background",
    "bg_id": "502290"
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "啊啊……",
    "voice": "vo_adv_1330003_048",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "騎士氏。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "至今為止",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "大家都是婉轉地用看到",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "「奇怪打扮」",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "的眼神在看我而已",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n……終於出現對我說出來的人了。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不管是颳風",
    "voice": "vo_adv_1330003_049",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "還是下雨。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我都堅持著這身打扮，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "就是為了哪天能有人來吐槽我。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這樣我就能毫無遺憾地",
    "voice": "vo_adv_1330003_050",
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "成佛了。",
    "voice": null,
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "太棒了。",
    "voice": "vo_adv_1330003_051",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n看來你的吐槽才能開花了。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "那麼，",
    "voice": "vo_adv_1330003_052",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "差不多該拔劍了吧。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不。",
    "voice": "vo_adv_1330003_053",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這並不是在開玩笑。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我說真的。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "認真。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你看，",
    "voice": "vo_adv_1330003_054",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "上面。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "骷髏飛龍",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "出現了呢，",
    "voice": "vo_adv_1330003_055",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "骷髏飛龍。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "是啊。",
    "voice": "vo_adv_1330003_056",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n看起來牠收集了不少骨頭……",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n是單憑我一人有點難以對付的魔物。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "雖然都來到這了，我想你也不可能拒絕我。",
    "voice": "vo_adv_1330003_057",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "但是你願意一起戰鬥嗎？",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……！",
    "voice": "vo_adv_1330003_058",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n全身充滿了力量……",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "果然騎士氏的強化，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "能讓我想起已經忘記的心跳……",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這樣一來。",
    "voice": "vo_adv_1330003_059",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "長槍的銳利度，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "就能再提升五成。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "喝啊啊！！",
    "voice": "vo_adv_1330003_060",
    "unit_id": 133012
  },
  {
    "type": "background",
    "bg_id": "502290"
  },
  {
    "type": "dialogue",
    "name": "骷髏飛龍",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "502440"
  },
  {
    "type": "dialogue",
    "name": "殭屍１",
    "words": "哦哦……！",
    "voice": "vo_adv_1330003_061",
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "殭屍１",
    "words": "\\n格蕾斯大人她回來了！",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "殭屍２",
    "words": "好厲害，",
    "voice": "vo_adv_1330003_062",
    "unit_id": 917
  },
  {
    "type": "dialogue",
    "name": "殭屍２",
    "words": "聽說她討伐了那隻骷髏飛龍！",
    "voice": null,
    "unit_id": 917
  },
  {
    "type": "dialogue",
    "name": "殭屍２",
    "words": "\\n不愧是薇歐莉特公主的守護騎士，",
    "voice": null,
    "unit_id": 917
  },
  {
    "type": "dialogue",
    "name": "殭屍２",
    "words": "格蕾斯大人！",
    "voice": null,
    "unit_id": 917
  },
  {
    "type": "dialogue",
    "name": "殭屍群",
    "words": "噢噢噢噢噢！！",
    "voice": "vo_adv_1330003_063",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "格蕾斯，",
    "voice": "vo_adv_1330003_064",
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "妳回來了啊。",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "\\n能夠成功討伐巨大化的骷髏飛龍，",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "\\n我身為妳的祖父也感到臉上有光呢。",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不過你根本就沒有臉呢。",
    "voice": "vo_adv_1330003_065",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "……我差不多",
    "voice": "vo_adv_1330003_066",
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "要開始覺得沮喪了哦。",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "算了。",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "\\n異國的騎士閣下。",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "我也要向你道謝。",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "\\n感謝閣下為此不餘遺力。",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "格蕾斯，",
    "voice": "vo_adv_1330003_067",
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "我之前似乎妄言說妳沒有善盡職責。",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "\\n真是抱歉啊。",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "沒關係，",
    "voice": "vo_adv_1330003_068",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你能了解就好了。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……是的？",
    "voice": "vo_adv_1330003_069",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n怎麼了嗎，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "騎士氏。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你說「這幾天，",
    "voice": "vo_adv_1330003_070",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "很感謝有我陪你……？」",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不會，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我只是在接待客人而已。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "………………",
    "voice": "vo_adv_1330003_071",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "─",
    "voice": "vo_adv_1330003_072",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "─沒事。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n什麼事都沒有。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "只是有種……",
    "voice": "vo_adv_1330003_073",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n受到了強化的感覺，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "僅此而已。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "──你不懂這是什麼意思？",
    "voice": "vo_adv_1330003_074",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "嗯……",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "解說的話也很不解風情，",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "就留到下次再說吧。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "當騎士氏臨終之時，",
    "voice": "vo_adv_1330003_075",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "再拿來當作去陰間的伴手禮。",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "面帶微笑的格蕾斯如此說道，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n便溫柔地揮了揮手，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "身影朝向宅第深處消失而去──",
    "voice": null,
    "unit_id": null
  }
]
