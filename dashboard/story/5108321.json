    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "可能有點不妙～",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "溫泉之神的體內，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n好像有股非常龐大的力量……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "充滿並沸騰著。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "祂該不會是",
    "voice": "vo_adv_5108321_001",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "打算把累積下來的罪惡與汙穢吐出來吧？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真是的……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "喝太多了啦，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "明明是神明。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_5108321_002",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真叫人擔心……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "喝太多對身體來說是毒嘛。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就算是神明大人，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "像那樣一直喝，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n肯定也會對身體帶來負擔的吧……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真不愧是美里，",
    "voice": "vo_adv_5108321_003",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真敏銳呢～♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……換句話說，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "只要利用那份負擔，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我們也能有趁隙而入的機會吧。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "原來如此啊。",
    "voice": "vo_adv_5108321_004",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n意思是既然喝太多，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就要自己承擔後果的意思吧。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那麼就讓祂稍微",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "再受點教訓吧。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是啊……",
    "voice": "vo_adv_5108321_005",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "要是沒有親身體驗過，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n一定無法真正學到東西吧。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就算因此受傷，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "老師也會幫忙治療的。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那我也要再接再厲，",
    "voice": "vo_adv_5108321_006",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n好好看照客人囉～♪",
    "voice": null,
    "unit_id": 124511
  }
]
