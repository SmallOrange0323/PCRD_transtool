[
  {
    "type": "background",
    "bg_id": "500115"
  },
  {
    "type": "still",
    "still_id": "500900601"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我閱讀了許多傳說典籍，四處尋找，",
    "voice": "vo_adv_5009006_000",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n總算找到封印霧奇之地。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但是不管呼喚幾次都沒有回應，",
    "voice": "vo_adv_5009006_001",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n突然就被狂暴的霧奇攻擊了。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "然後所有記憶都被奪走了……",
    "voice": "vo_adv_5009006_002",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n結果，就變成大家看到的這副模樣。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "一開始，我的行為像野獸一樣，",
    "voice": "vo_adv_5009006_003",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n是因為我身為人類的記憶都被奪走的關係。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我完全照本能行動，餓了就吃，",
    "voice": "vo_adv_5009006_004",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n變得就像動物一樣。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "因為我對精靈之力有抵抗力，",
    "voice": "vo_adv_5009006_005",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n好不容易保護了自己的記憶，藏在內心深處……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不過卻難以浮現，",
    "voice": "vo_adv_5009006_006",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n只能看著自己持續發狂。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "background",
    "bg_id": "500115"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "在那之後……",
    "voice": "vo_adv_5009006_007",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n噗吉不知道為什麼飛到我身體裡，有了他的幫助，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n才取回了些許的記憶……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但懂事之後的記憶都被奪走，",
    "voice": "vo_adv_5009006_008",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以行為就像嬰兒一樣。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊啊，太丟臉了。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊哈哈。",
    "voice": "vo_adv_5009006_009",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒必要覺得丟臉啊，很可愛喔。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌平常總是既成熟又冷酷，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "原來小時候也是如此天真無邪呢♪",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請、請忘記吧！",
    "voice": "vo_adv_5009006_010",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊啊，霧奇，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請你現在馬上刪除大家的記憶……！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不會忘記的唷。",
    "voice": "vo_adv_5009006_011",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n和千歌的回憶，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "全部都是重要的寶物。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不對，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不管對誰來說，回憶都是非常重要的呢。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不能讓人",
    "voice": "vo_adv_5009006_012",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "隨意的操控。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n雖然想要助{0}一臂之力～的心情",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我也是可以理解。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是的……",
    "voice": "vo_adv_5009006_013",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊啊，真是的，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這一切實在是太丟臉了。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "總、總之……",
    "voice": "vo_adv_5009006_014",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要是不對霧奇做點什麼，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我就會再次被奪走記憶困在內心深處。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "然後又會再",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "給各位添麻煩了吧。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以，",
    "voice": "vo_adv_5009006_015",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請各位，打倒霧奇吧。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不對，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請把他趕得遠遠的，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "或是再封印起來也沒關係。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請你們阻止",
    "voice": "vo_adv_5009006_016",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "霧奇對我的惡意攻擊。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n是我解開了他的封印，讓他覺醒的，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "說這種話我也很過意不去。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可是我不想忘記",
    "voice": "vo_adv_5009006_017",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這一切。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對我而言，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "和各位的回憶都是重要的寶物。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不會讓人奪走的，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就算只是一絲一毫。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是……",
    "voice": "vo_adv_5009006_018",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然我也很想把折磨千歌的傢伙",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n揍飛到地平線另一端去。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但我們不知道那個霧奇在哪裡啊。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "實在是束手無策啊。",
    "voice": "vo_adv_5009006_019",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只要去之前封印霧奇的地方，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n就能見到他嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不對，",
    "voice": "vo_adv_5009006_020",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不需要特地去見他。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "霧奇牠",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就在這裡。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "牠一定是一面竊笑觀賞著我",
    "voice": "vo_adv_5009006_021",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n失去記憶，醜態畢露的模樣吧。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我感覺得出來。",
    "voice": "vo_adv_5009006_022",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我是唱喚士，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以感受得到精靈的氣息。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦咦，",
    "voice": "vo_adv_5009006_023",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "牠就在這裡嗎……？",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n在、在哪裡……？",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "　好可怕啊……！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "雖然我不清楚正確的地方，",
    "voice": "vo_adv_5009006_024",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n但霧奇是沒有實體的精靈，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "只有依附於物質上時，才能和現世有連繫。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "他現在應該是",
    "voice": "vo_adv_5009006_025",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "藏在什麼東西裡面。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n請把他找出來，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "攻擊讓他現身。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "然後，",
    "voice": "vo_adv_5009006_026",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我會拜託其他的精靈，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n請他們消滅霧奇的本尊。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不對。",
    "voice": "vo_adv_5009006_027",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "為了不讓我這麼做，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n霧奇一定是躲在安全的物體裡。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "畢竟牠的本尊暴露出來會毫無防備的，",
    "voice": "vo_adv_5009006_028",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以牠一定用了什麼物體當作屏障。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咦咦，",
    "voice": "vo_adv_5009006_029",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "所以他現在躲在某樣東西裡囉？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "應該",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不是躲在我體內吧？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "有沒有",
    "voice": "vo_adv_5009006_030",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "什麼東西和平常不太一樣的？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "被霧奇附身的話，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "說不定顏色或形狀會改變……？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯～？",
    "voice": "vo_adv_5009006_031",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　在這裡生活的小胡桃和小綾音，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n{0}應該會知道吧？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這個嘛～不確定耶？",
    "voice": "vo_adv_5009006_032",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "因為加了聖誕節裝飾後，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n整體上都和平常不太一樣了……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "呀……",
    "voice": "vo_adv_5009006_033",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n哥哥過來了，",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "你知道霧奇藏在哪裡了嗎……？",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咦？　是、是我嗎？",
    "voice": "vo_adv_5009006_034",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "雖然我今天的確是……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n和平常不太一樣，可是……？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不、不在我體內啦！",
    "voice": "vo_adv_5009006_035",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我是唱喚士，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要是體內有精靈，我會感應到的！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以，{0}……咦？　你在聽嗎？",
    "voice": "vo_adv_5009006_036",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n等一下，請不要亂摸我的身體！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊哈哈，啊哈哈哈哈……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好癢啊☆",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "喂！",
    "voice": "vo_adv_5009006_037",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　不可以啦，絕對不行！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\nYES偶像　NO摸摸……！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咦？",
    "voice": "vo_adv_5009006_038",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n哥哥，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "你為什麼用那麼可怕的表情接近我……？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "你、你在懷疑我嗎？",
    "voice": "vo_adv_5009006_039",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我、我和平常有哪裡不一樣嗎？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "　像冒牌貨……？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "呀啊，",
    "voice": "vo_adv_5009006_040",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥，請不要拉噗吉啦！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "你在做什麼，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不可以欺負噗吉……！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……啊啊，",
    "voice": "vo_adv_5009006_041",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "難道說！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "明白了！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　是噗吉！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "噗吉，",
    "voice": "vo_adv_5009006_042",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "應該說霧奇在那個槌子裡！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "因為霧奇進去了，",
    "voice": "vo_adv_5009006_043",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以噗吉的心……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "靈魂？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "之類的被彈出了槌子，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n然後碰巧進到在附近的我的體內！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "事情就是這樣子吧？",
    "voice": "vo_adv_5009006_044",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　一切都說得通了！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我們知道你在哪裡了，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "快點現身吧！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "「記憶的大精靈霧奇」……！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "霧奇",
    "words": "――吼喔喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "呀啊！？　討厭討厭討厭，槌子自己動起來了！",
    "voice": "vo_adv_5009006_045",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "霧、霧奇真的在這裡面嗎……！？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦咦，",
    "voice": "vo_adv_5009006_046",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不要啊，綾音！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n請不要靠近我，",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不要打我啊……！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不是啦不是啦，",
    "voice": "vo_adv_5009006_047",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是槌子自己動的！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗚啊啊啊啊，快逃啊胡桃～！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "background",
    "bg_id": "500115"
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥！？",
    "voice": "vo_adv_5009006_048",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥、哥哥保護了我……！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗚啊啊，對不起啊，哥哥！",
    "voice": "vo_adv_5009006_049",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "　",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "沒事吧？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n打你的不是我，是霧奇……！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "綾音，",
    "voice": "vo_adv_5009006_050",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "快放開那個槌子！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "　快逃～！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n妳那樣握著太靠近他了，",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n要是他找綾音當目標，妳會躲不掉的……！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可、可是！",
    "voice": "vo_adv_5009006_051",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我和噗吉都是在一起的？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "……千歌小姐！",
    "voice": "vo_adv_5009006_052",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "\\n抱歉，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "身體再借我一下！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "混帳！　",
    "voice": "vo_adv_5009006_053",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "我不知道你是大精靈還什麼鬼 ",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "\\n不准嚇唬我的綾音啊啊啊啊！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗚噫？",
    "voice": "vo_adv_5009006_054",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n好厲害，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "完全不像千歌，而是像猛獸一樣的動作……！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "綾音！",
    "voice": "vo_adv_5009006_055",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "　那東西不是我，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "我在這裡啊！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "\\n快放開那槌子，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "到這裡來！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好、好的！",
    "voice": "vo_adv_5009006_056",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "　噗吉！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我知道的，噗吉就在那裡！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n因為我們總是在一起，所以我知道，我感受得到！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉總是在我身邊，安慰我、守護著我！",
    "voice": "vo_adv_5009006_057",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n所以想要傷害我和我重視的家人的這根槌子，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……才不是噗吉！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "綾音！",
    "voice": "vo_adv_5009006_058",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n把那個玩偶，",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那個槌子噗吉丟到這裡來……！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好、好的？",
    "voice": "vo_adv_5009006_059",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "雖然不知道怎麼回事，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我會照胡桃說的去做的！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "因為我是姊姊，",
    "voice": "vo_adv_5009006_060",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "所以會聽你們的願望的！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n嘿咿……！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "謝謝妳……！",
    "voice": "vo_adv_5009006_061",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我就知道綾音妳總是",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "這麼想的！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n真的很高興，",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "最喜歡這樣的綾音了！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嚇唬綾音的壞蛋，",
    "voice": "vo_adv_5009006_062",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "快點離開……！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "background",
    "bg_id": "500115"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "喔喔，",
    "voice": "vo_adv_5009006_063",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "打得好！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "小胡桃用自己的槌子，\\n打飛了小綾音的槌子！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "霧奇",
    "words": "――吼喔喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "……咦！？",
    "voice": "vo_adv_5009006_064",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": "vo_adv_5009006_065",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個槌子裡面飄出了像是霧一樣的東西！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n那就是「記憶的大精靈霧奇」的真身嗎？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊啊，不好了！",
    "voice": "vo_adv_5009006_066",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n霧奇往胡桃那裡飄去了，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n她剛用盡全力打飛了槌子失去平衡……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "會躲不掉的！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦、咦咦……！？",
    "voice": "vo_adv_5009006_067",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗚……！",
    "voice": "vo_adv_5009006_068",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　不行，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然很想幫忙，可是離太遠了！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "來不及……！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……{0}！　時機正好！",
    "voice": "vo_adv_5009006_069",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不愧是男孩子，出乎意料的強壯呢！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n抱住了起身的小胡桃，並強化了我們！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是啊。總是受到你的幫忙。",
    "voice": "vo_adv_5009006_070",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n因為你總是那麼溫柔、",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "又可靠……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還這麼的令人憐愛，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "才想向你報恩的。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "事情變成這樣，",
    "voice": "vo_adv_5009006_071",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "實在非常抱歉……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "道歉等之後再說吧。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "霧奇衝破牆壁，好像往城鎮的方向去了。",
    "voice": "vo_adv_5009006_072",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我們也要快點追上去才行。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯。{0}哥哥，",
    "voice": "vo_adv_5009006_073",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "快點走吧！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "movie",
    "movie_id": "500900601"
  }
]
