[
  {
    "type": "background",
    "bg_id": "500102"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……唔、",
    "voice": "vo_adv_2005004_000",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔唔。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊嗚？　",
    "voice": "vo_adv_2005004_001",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n咦、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　\\n這裡是，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哪裡……？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這裡是王宮的",
    "voice": "vo_adv_2005004_002",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "王座聖殿？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我為什麼",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "會在這種地方？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "直到剛才為止，",
    "voice": "vo_adv_2005004_003",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我明明都還在牧場的一座山上啊……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "把蒂亞娜",
    "voice": "vo_adv_2005004_004",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "交給克莉絲提娜處理以後，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我盡全力地控制那些失控的魔物們，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "讓牠們冷靜下來。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才剛鬆一口氣，",
    "voice": "vo_adv_2005004_005",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就找到{0}了呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看起來是因為他擔心蒂亞娜……",
    "voice": "vo_adv_2005004_006",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n所以跑過來找她了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那傢伙真是的，明明那麼弱。",
    "voice": "vo_adv_2005004_007",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n竟然一個人跑到山裡，簡直就是自殺行為。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然當時我想辦法壓制了魔物，",
    "voice": "vo_adv_2005004_008",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但他那時候好像快從懸崖上掉下去嘛，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n所以一慌張，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就出手幫忙了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "畢竟陛下說過，",
    "voice": "vo_adv_2005004_009",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不可以讓{0}死掉。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我可不是因為",
    "voice": "vo_adv_2005004_010",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "重視{0}才這麼做的，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "千萬不要誤會了哦？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我這是在跟誰解釋啊……",
    "voice": "vo_adv_2005004_011",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉～",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "今天感覺做什麼都不順呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我啊，",
    "voice": "vo_adv_2005004_012",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是不是真的就跟陛下說的一樣……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n是一個很糟糕的，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "缺陷品呢？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……嗯嗯？　",
    "voice": "vo_adv_2005004_013",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "{0}！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你你你，",
    "voice": "vo_adv_2005004_014",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你幹嘛抱著我啊？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　\\n你是喜歡我是不是啊？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n喂、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "快放開啦殺了你哦！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……嗯～？　",
    "voice": "vo_adv_2005004_015",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n{0}、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "昏過去了嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只是因為睡迷糊了，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以才抱我？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呵呵。",
    "voice": "vo_adv_2005004_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我建議妳別亂動比較好唷，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n如果妳很重視他的話。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "看起來有點輕微的休克。",
    "voice": "vo_adv_2005004_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n但性命應該是無恙，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "放心吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n他只是耐不住空間轉移，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "所以失去意識罷了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咿！？",
    "voice": "vo_adv_2005004_018",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n陛、陛下……！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "still",
    "still_id": "200500401"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真討厭，這孩子真是的……",
    "voice": "vo_adv_2005004_019",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n居然還發出了『咿』的聲音。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "簡直就像是",
    "voice": "vo_adv_2005004_020",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n看到怪物一樣的反應嘛。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真讓人傷心～",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呵呵呵♪",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我是打算",
    "voice": "vo_adv_2005004_021",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n要好好地照顧妳一下的呢……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "所以別叫我『陛下』，那聽起來好有距離感，",
    "voice": "vo_adv_2005004_022",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我們是家人對吧？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "非、",
    "voice": "vo_adv_2005004_023",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "非非非、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "非常抱歉！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "尤絲蒂亞娜大人……！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "『大人』是多餘的呢。",
    "voice": "vo_adv_2005004_024",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "不過算了，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "因為今天我的心情還算不錯。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "因為，",
    "voice": "vo_adv_2005004_025",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "感覺可以一口氣解決掉那些礙眼的傢伙。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n畢竟打掃過後，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "心情都會很舒爽嘛。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500102"
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "話說回來。",
    "voice": "vo_adv_2005004_026",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n你們幾個，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n還真的在山裡遇難了呢……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "但我實在是等不及了。",
    "voice": "vo_adv_2005004_027",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n而且時間也晚了，想趕快上床睡覺，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "所以就直接把妳給叫來了♪",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "以妳為目標，",
    "voice": "vo_adv_2005004_028",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n順便連他也一併帶到這裡來了。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所、",
    "voice": "vo_adv_2005004_029",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以是用空間轉移……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n把我跟{0}，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n一起從山裡",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "瞬間移動到王宮裡來嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這種事情，",
    "voice": "vo_adv_2005004_030",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就算是用魔法也辦不到！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "不會辦不到啊。",
    "voice": "vo_adv_2005004_031",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "凱留，妳也真是的，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "妳以為我是什麼人啊？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "有一種東西叫做『傳送門』，",
    "voice": "vo_adv_2005004_032",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n但因為有些狀況所以封印起來，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "不太會讓一般人使用。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n在過去，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "這可是稀鬆平常的移動方式唷。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "我只是介入了那個『傳送門』的魔法迴路，",
    "voice": "vo_adv_2005004_033",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n稍微借用了一下而已。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "但這讓我耗費了無謂的魔力呢，",
    "voice": "vo_adv_2005004_034",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "明明想要盡量多保留一些的說。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "妳要好好地感謝我唷，",
    "voice": "vo_adv_2005004_035",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "可愛的凱留……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "要是妳還繼續留在那座山上，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n說不定會被波及到，然後就地成佛了呢。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……？　",
    "voice": "vo_adv_2005004_036",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我有點搞不太清楚狀況，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "請問您找{0}有什麼事嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我收到陛下的命令後，",
    "voice": "vo_adv_2005004_037",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就一直在觀察他……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n他只是一個沒有任何優點，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很普通的男孩子而已。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我無法理解陛下如此在意他的理由。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "所以妳是想說，",
    "voice": "vo_adv_2005004_038",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "要我放他一馬的意思嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "　\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "看來你們感情",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "培養的不錯嘛～？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "那是叫【美食殿堂】嗎？　",
    "voice": "vo_adv_2005004_039",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n妳甚至還加入了那個奇妙的公會是吧？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個……",
    "voice": "vo_adv_2005004_040",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那、那是臥底工作。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我想說如果能成為她們的夥伴，就能讓她們疏忽。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "嗯，",
    "voice": "vo_adv_2005004_041",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "那個我知道啦。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n可愛的凱留，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "我的凱留……♪",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "我跟妳說過對吧，",
    "voice": "vo_adv_2005004_042",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "妳就像是我的一部分一樣。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "所以妳的心情啊，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n我可是很簡單地就能感受到的唷。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "吶，",
    "voice": "vo_adv_2005004_043",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "妳很想要朋友嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "　\\n不對，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "不對，是想要被愛嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n我懂的～",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "因為一個人會覺得很寂寞嘛。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "……但是啊，",
    "voice": "vo_adv_2005004_044",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "凱留。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n神明啊，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "是不需要朋友的唷。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "只需要獨身一人，",
    "voice": "vo_adv_2005004_045",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "並且支配萬物。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n那就是我們的生存方式唷。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "妳明明應該就是我的一部分，",
    "voice": "vo_adv_2005004_046",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n但為什麼連這麼簡單的道理都不懂呢？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "唉～",
    "voice": "vo_adv_2005004_047",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "真是失敗啊。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "果然在這個世界裡，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n即使『預知未來』，感覺也無法信任。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "still",
    "still_id": "200500402"
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "妳可不要誤會囉",
    "voice": "vo_adv_2005004_048",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n這並不是什麼處罰，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "妳也沒有做錯什麼事情。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "雖然妳連一件我交待的事都沒達成，",
    "voice": "vo_adv_2005004_049",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n一副醜態畢露的樣子就是了。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "這並不是妳的責任。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "可愛的凱留，",
    "voice": "vo_adv_2005004_050",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "乖孩子凱留……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "是我太天真了，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n竟然把妳當成人類一樣對待。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "明明就只是個道具而已。",
    "voice": "vo_adv_2005004_051",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "因為『公主騎士』的力量太過強大，",
    "voice": "vo_adv_2005004_052",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n覺得妳的肉體可能無法承受……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n所以打算慢慢地一點一點，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "一邊給妳一邊讓妳習慣。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "但從結果看來，",
    "voice": "vo_adv_2005004_053",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n妳無法好好地控制魔物，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n沒能達成自己的使命。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "即使如此，",
    "voice": "vo_adv_2005004_054",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "累積經驗之後應該會有成長……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n還稍微期待了一下，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "妳或許還能拿出些成果來。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "但已經沒有那種時間了，",
    "voice": "vo_adv_2005004_055",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n因為我開始覺得有點麻煩。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "我不想再顧慮妳的肉體，",
    "voice": "vo_adv_2005004_056",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "要直接把『公主騎士』的力量全部給妳。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "就算妳可能因此壞掉……",
    "voice": "vo_adv_2005004_057",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "不過只要再重作一個就好了嘛。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "從錯誤中學習就是成功的秘訣唷。",
    "voice": "vo_adv_2005004_058",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "『下一個凱留』，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "尤絲蒂亞娜",
    "words": "\\n說不定會是一個更有用的孩子嘛。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500102"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "為、",
    "voice": "vo_adv_2005004_059",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
