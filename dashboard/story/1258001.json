    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "還請您",
    "voice": "vo_adv_1258001_026",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "不必顧慮我，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n隨兄長大人的意思，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "挑選想承接的委託便好。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "即便僅是站在您的身後觀察，",
    "voice": "vo_adv_1258001_027",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n對我而言，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n也是無可取代的學習機會。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後，{0}設法阻止了仍不斷",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n推薦自己承接高難度冒險委託的莉莉，",
    "voice": null,
    "unit_id": null
  },
