  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家！",
    "voice": "vo_adv_2113006_056",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你們都沒事吧！？",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒事。",
    "voice": "vo_adv_2113006_057",
    "unit_id": 180511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 180511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然嚇了一跳，",
    "voice": null,
    "unit_id": 180511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但那不像過去遇到的那麼難纏。",
    "voice": null,
    "unit_id": 180511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是，",
    "voice": "vo_adv_2113006_058",
    "unit_id": 180511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為何這個精靈會……？",
    "voice": null,
    "unit_id": 180511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下的確記得",
    "voice": null,
    "unit_id": 180511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "已經淨化了它啊……",
    "voice": null,
    "unit_id": 180511
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嗨嗨──",
    "voice": "vo_adv_2113006_059",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n尾狗刀我來囉──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呀啊啊！？",
    "voice": "vo_adv_2113006_060",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n他他他他他又來了！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你還真敢回來啊……！",
    "voice": "vo_adv_2113006_061",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這次我一定",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要把鞋尖塞到你那張",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "癡呆的臉上去……！",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嗚哇──",
    "voice": "vo_adv_2113006_062",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "好可怕哦──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "被這樣威脅，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "那我也得採取保身的手段了──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "唔……",
    "voice": "vo_adv_2113006_063",
    "unit_id": 107212
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個人不是……！？",
    "voice": "vo_adv_2113006_064",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "！？",
    "voice": "vo_adv_2113006_065",
    "unit_id": 180511
  },
