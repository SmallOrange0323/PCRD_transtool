  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "朝陽升起，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n終於到了夏日演唱會當天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯～！",
    "voice": "vo_adv_5072006_000",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n今天是個舉辦演唱會的大好日子！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯！",
    "voice": "vo_adv_5072006_001",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "多虧有你們帶回來的藥，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n以及{0}的照顧，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我已經完全康復了！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "甚至",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "比平時還來得有朝氣呢！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "太好了，",
    "voice": "vo_adv_5072006_002",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "小望。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就是說啊。",
    "voice": "vo_adv_5072006_003",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n妳能恢復活力是再好不過了。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝妳們。",
    "voice": "vo_adv_5072006_004",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n託紡希和千歌的福，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我才能站上舞台。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這段時間給妳們添的麻煩、",
    "voice": "vo_adv_5072006_005",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳們對我的擔憂，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n以及",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為我貼心設想的心意。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這些我全部都會在舞台上回報給妳們的。",
    "voice": "vo_adv_5072006_006",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也請{0}",
    "voice": "vo_adv_5072006_007",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "坐在特等席上好好欣賞我們的演出吧。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們將會展現出至今為止最為耀眼的一面！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌！",
    "voice": "vo_adv_5072006_008",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n紡希！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我們走吧！",
    "voice": "vo_adv_5072006_009",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "擄獲觀眾們的心吧！",
    "voice": "vo_adv_5072006_010",
    "unit_id": 117411
  },
  {
    "type": "background",
    "bg_id": "501360"
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "…………",
    "voice": "vo_adv_5072006_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "各位～",
    "voice": "vo_adv_5072006_012",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "讓你們久等了～♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "…………",
    "voice": "vo_adv_5072006_013",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "沐浴在夏日豔陽下，",
    "voice": "vo_adv_5072006_014",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "伴著廣闊的大海──",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "今天就請大家全心全意地",
    "voice": "vo_adv_5072006_015",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "投入我們的演唱會，好好享受一番吧！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "background",
    "bg_id": "501363"
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "慈樂之音，登台！",
    "voice": "vo_adv_5072006_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "哇──！",
    "voice": "vo_adv_5072006_017",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "507200601"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "──各位！",
    "voice": "vo_adv_5072006_018",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n玩得開心嗎──？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "慈樂之音最棒了───！",
    "voice": "vo_adv_5072006_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呵呵，",
    "voice": "vo_adv_5072006_020",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "重頭戲",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "現在才要開始喔。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "請轉向這邊──！",
    "voice": "vo_adv_5072006_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "好～的♪",
    "voice": "vo_adv_5072006_022",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n所有人我都看得見喔──♪",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "觀眾3",
    "words": "哇啊啊啊───！",
    "voice": "vo_adv_5072006_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾3",
    "words": "\\n幸虧有來參加這場演唱會～～～～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "來，",
    "voice": "vo_adv_5072006_024",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "再大聲一點！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "請盡情地喊叫吧，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可別輸給我們了！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這樣一來，",
    "voice": "vo_adv_5072006_025",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我們的歌聲，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n也會更有力地傳達給大家……！",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "相信大家都很期待",
    "voice": "vo_adv_5072006_026",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我們卯足全力的演出吧？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呵呵，",
    "voice": "vo_adv_5072006_027",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝你強而有力的聲援♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n視線可別從我身上移開喔──♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n……呵呵♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "謝謝你",
    "voice": "vo_adv_5072006_028",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "充滿熱情的聲援。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我會",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "誠心地為你歌唱。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但願你能夠聽見……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "潛藏在這首歌中的思念。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你不用喊得那麼大聲，我也聽得見啦！",
    "voice": "vo_adv_5072006_029",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……啊。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n呃、",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咳咳。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "剛才的話就當我沒說吧。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "哇──！",
    "voice": "vo_adv_5072006_030",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501363"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "──看得還開心嗎？",
    "voice": "vo_adv_5072006_031",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這是當然的。",
    "voice": "vo_adv_5072006_032",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n有我擔任製作人……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "因為慈樂之音她們",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "為了超越自己的極限，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "平時就付出了許多努力。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這次的演唱會帶來了前所未有的盛況。",
    "voice": "vo_adv_5072006_033",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n現在的",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "她們就快要觸及頂尖偶像的頂端了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "話雖如此……",
    "voice": "vo_adv_5072006_034",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這盛況之熱絡似乎",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "有點超乎我的想像。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "當然，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這是再好不過的事……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只不過，現場氣氛越是熱絡，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "想來潑冷水的傢伙也會變多。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "慈樂之音的試煉，",
    "voice": "vo_adv_5072006_035",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n或許現在才正要開始──",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好啦，",
    "voice": "vo_adv_5072006_036",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "大家一起來炒熱氣氛吧♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n下一首歌曲是──",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "！",
    "voice": "vo_adv_5072006_037",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "魔、",
    "voice": "vo_adv_5072006_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "魔物！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "而、",
    "voice": "vo_adv_5072006_039",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "而且",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "不是只有一、兩隻！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "\\n是一大群魔物！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "各位觀眾，",
    "voice": "vo_adv_5072006_040",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "請別慌張！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n我們會",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "立即處理──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾3",
    "words": "喂，",
    "voice": "vo_adv_5072006_041",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾3",
    "words": "別亂推擠啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾3",
    "words": "\\n會場人數這麼多怎麼可能動得了啊！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾4",
    "words": "這下該怎麼辦……！？",
    "voice": "vo_adv_5072006_042",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾4",
    "words": "\\n難得的演唱會就要泡湯了……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "……啊……",
    "voice": "vo_adv_5072006_043",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "啊……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "…………",
    "voice": "vo_adv_5072006_044",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那是上次",
    "voice": "vo_adv_5072006_045",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "被我趕跑的魔物的首領",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "吧……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "它是來",
    "voice": "vo_adv_5072006_046",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "討上次的債吧。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "既然如此，它的目標應該就是這個舞台了。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "魔物　",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 15111
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……這讓我想起了",
    "voice": "vo_adv_5072006_047",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我們的首場演唱會呢。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是啊。",
    "voice": "vo_adv_5072006_048",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n那個時候，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我們與觀眾們同心合力",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "擊退了魔物。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不過，這次的演唱會",
    "voice": "vo_adv_5072006_049",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "遠超乎當時的規模。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n就算要觀眾們去避難，以現場人數來看，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "只會讓大家陷入混亂吧。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……妳要怎麼做呢？",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "望。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "…………",
    "voice": "vo_adv_5072006_050",
    "unit_id": 117211
  },
  {
    "type": "still",
    "still_id": "507200102"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一旦站上舞台，",
    "voice": "vo_adv_5072006_051",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n無論遇到什麼樣的狀況，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "都要讓全部的人展露笑容。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我還記得",
    "voice": "vo_adv_5072006_052",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "當時的誓言。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "background",
    "bg_id": "501363"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們是慈樂之音。",
    "voice": "vo_adv_5072006_053",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n只要我們站在舞台上，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n該怎麼做哪還需要猶豫呢！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌！",
    "voice": "vo_adv_5072006_054",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯！",
    "voice": "vo_adv_5072006_055",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "紡希！",
    "voice": "vo_adv_5072006_056",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "好的！",
    "voice": "vo_adv_5072006_057",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們上吧！",
    "voice": "vo_adv_5072006_058",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n──誰都不許來擾亂",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "屬於我們的舞台！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "movie",
    "movie_id": "507200601"
  },
  {
    "type": "movie",
    "movie_id": "507200602"
  },
  {
    "type": "background",
    "bg_id": "501363"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哈啊、",
    "voice": "vo_adv_5072006_059",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哈啊……！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呼……",
    "voice": "vo_adv_5072006_060",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呼……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呼啊……",
    "voice": "vo_adv_5072006_061",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我已經",
    "voice": "vo_adv_5072006_062",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "把力氣都用光了……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是啊，",
    "voice": "vo_adv_5072006_063",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "用盡全身力量……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我已經",
    "voice": "vo_adv_5072006_064",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "動不了啦……！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呵呵，",
    "voice": "vo_adv_5072006_065",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "還沒有結束喔。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n會場的大家都還在等著我們。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n妳們",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "側耳仔細聽吧。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "安可！",
    "voice": "vo_adv_5072006_066",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "\\n安可！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "\\n安可！！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯，",
    "voice": "vo_adv_5072006_067",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我聽到了。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n呼喚著我們的聲音。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "雖說只有一個人",
    "voice": "vo_adv_5072006_068",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "沒跟上節奏，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n胡亂地大吼大叫的。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "紡希，",
    "voice": "vo_adv_5072006_069",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "妳聽得出來啊？",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n在這片盛大的歡呼聲中。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啥！？",
    "voice": "vo_adv_5072006_070",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n不，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那個……！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "千、",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "千歌！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳別再鬧我了啦！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "看來妳們",
    "voice": "vo_adv_5072006_071",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "都還很有活力嘛。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……還行嗎？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "是的！",
    "voice": "vo_adv_5072006_072",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那麼，",
    "voice": "vo_adv_5072006_073",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們走吧！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n回到屬於我們的舞台上！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "still",
    "still_id": "507200602"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝大家的安可！",
    "voice": "vo_adv_5072006_074",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "哇───────！",
    "voice": "vo_adv_5072006_075",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳們看，",
    "voice": "vo_adv_5072006_076",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌、",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "紡希。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n大家都展露出了笑容。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這幅光景，",
    "voice": "vo_adv_5072006_077",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "單靠我一個人是無法實現的。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n這是由千歌、紡希和我，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我們三個人合力實現的",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "最棒的一瞬間。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好啦，",
    "voice": "vo_adv_5072006_078",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就讓我們加把勁，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "超越這一瞬間吧。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "邁向",
    "voice": "vo_adv_5072006_079",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "光輝燦爛的未來──！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "慈樂之音的三人在舞台上綻放耀眼光芒。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這場夏日音樂會，在慈樂之音今後也將持續下去的活動中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n刻畫下了無可取代的歷史軌跡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  }
]
