  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "傳說的吸血鬼取回她全盛時期力量的隔天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n蘭德索爾面臨她征服世界的野心，迎來了極致的混亂──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "並沒有那回事。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如何？",
    "voice": "vo_adv_1044010_000",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你有帶那個東西過來嗎？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯。",
    "voice": "vo_adv_1044010_001",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那麼……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這刺鼻的臭味！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n的確是那可恨的大蒜料理！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是……",
    "voice": "vo_adv_1044010_002",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身必須要試試……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n吃了這道大蒜料理之後，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是不是還能保持現在的力量……！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵……",
    "voice": "vo_adv_1044010_003",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你以為妾身是誰！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n是傳說的吸血鬼……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "伊莉亞‧奧恩斯坦喔！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "大蒜什麼的",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "根本不足為懼！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "儘管來吧！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔，",
    "voice": "vo_adv_1044010_004",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不，等等。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對這種東西是需要心理準備的……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "等等！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "等……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這可不是鬧著玩的！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不是鬧著玩的啊",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊啊──！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呣咕！",
    "voice": "vo_adv_1044010_005",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔嗚嗚嗚嗚嗚……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔、",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔唔！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "咕嘟……",
    "voice": "vo_adv_1044010_006",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如、",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如何！？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哦哦……",
    "voice": "vo_adv_1044010_007",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼事也沒有！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒有變小……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "現在！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "克服了大蒜喔！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n哈～哈哈哈哈──！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身",
    "voice": "vo_adv_1044010_008",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在此！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "宣布傳說的吸血鬼",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "完全復活！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有一件必須要做的事……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就是征服世界！",
    "voice": "vo_adv_1044010_009",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯？",
    "voice": "vo_adv_1044010_010",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你怎麼露出",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那種表情？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你好像有什麼話想問妾身？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔？",
    "voice": "vo_adv_1044010_011",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你想知道具體的願景啊。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好吧！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n首先，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是宣布統御黑夜之人的復活，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n讓人民向妾身跪拜！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那之後嗎？",
    "voice": "vo_adv_1044010_012",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也對呢，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那之後是……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "偷瞧。",
    "voice": "vo_adv_1044010_013",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這傢伙",
    "voice": "vo_adv_1044010_014",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是喜歡妾身的……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對吧？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "他想問的並不是政務，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "而是和妾身之間的事吧。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "征服世界後的妾身會變得很忙，",
    "voice": "vo_adv_1044010_015",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n所以他是擔心會被置之不理吧……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n真是的，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還真愛撒嬌啊。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "而且，",
    "voice": "vo_adv_1044010_016",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這傢伙也是男人，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n應該也會堅持",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "要由他主動表達心意。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如此一來，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "先為他做好準備，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也是身為統治者的氣度啊……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身也不是不明白他會在意身分的差距……",
    "voice": "vo_adv_1044010_017",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n既然這樣，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "要想讓這傢伙如願以償，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n那在距離征服世界還有餘裕的現在，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就不能浪費這段時間……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "為此首先，",
    "voice": "vo_adv_1044010_018",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "要有浪漫的情境！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "像這傢伙這種有點遲鈍的類型，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n用氣氛來影響他是很重要的吧。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "話雖如此，",
    "voice": "vo_adv_1044010_019",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這裡可是在公會的眾目睽睽之下，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也就是說，需要的是……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "新的城堡",
    "voice": "vo_adv_1044010_020",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "吧。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不是在這裡，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "而是要準備新的據點喔！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "首先要",
    "voice": "vo_adv_1044010_021",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "進行事前調查啊……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "去吧！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
