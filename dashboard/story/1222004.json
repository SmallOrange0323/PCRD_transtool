    "words": "讓、",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "讓你覺得反感了嗎？",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "…………或、",
    "voice": "vo_adv_1222004_050",
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "或許是吧。",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "嗯……",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我似乎連情緒也整理好了。",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不小心就說出喪氣話了……",
    "voice": "vo_adv_1222004_051",
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "可是",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "只要是在他面前，",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n不曉得為什麼就會覺得",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "掩飾自己很愚蠢呢……",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "而且我也只有在他面前才能像這樣",
    "voice": "vo_adv_1222004_052",
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "展現自然的自己……",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n就算稍微跟他撒嬌──",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……",
    "voice": "vo_adv_1222004_053",
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "來來來，",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "再靠我近一點。",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我們必須繼續",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "假裝成情侶才行。",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "否則萬一同事們如果回來了，",
    "voice": "vo_adv_1222004_054",
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n就會被他們發現我是說謊了啊。",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "大家",
    "voice": "vo_adv_1222004_055",
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "似乎都真的相信",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我們是情侶喔。",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊，",
    "voice": "vo_adv_1222004_056",
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "對了……！",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n不要是假裝的……",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "要不要真的",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "和我變成情侶？",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……呵呵，",
    "voice": "vo_adv_1222004_057",
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "才怪呢。",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我開玩笑的啦，",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "開玩笑的。",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n你連麥酒都還沒辦法喝，",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這對你是不是有點太刺激了呢～",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這種話……",
    "voice": "vo_adv_1222004_058",
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "至少要等你到了能喝麥酒的年紀再說呢。",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n……你要快點追上我喔，",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我會等你的。",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……居然用公司的經費",
    "voice": "vo_adv_1222004_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "吃烤肉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "優花梨真是的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她外表看起來很認真，沒想到也有不容小覷的地方呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然優花梨的理想或許是當個",
    "voice": "vo_adv_1222004_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "認真又工作能幹的女性……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但我認為",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "最自然的她也非常有魅力。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "而且",
    "voice": "vo_adv_1222004_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就算裝得再成熟，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n也不可能有辦法一直掩飾自己……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n任誰都遲早會感到疲累的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "正因為如此……",
    "voice": "vo_adv_1222004_062",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "請你待在優花梨身邊，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n好讓她能夠保持最自然的樣子吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "拜託你囉，",
    "voice": "vo_adv_1222004_063",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為這對她來說是不可或缺的下酒菜啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那麼",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "再見囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "501590"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……唔嗯，",
    "voice": "vo_adv_1222004_064",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我在收拾的途中睡著了……？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n好像做了個不可思議的夢……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是因為太早起了嗎……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不過",
    "voice": "vo_adv_1222004_065",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "感覺暢快多了……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n就像是內心的煩躁感一掃而空，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "讓人心情舒暢的感覺。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這也是",
    "voice": "vo_adv_1222004_066",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "多虧有和你",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "一起喝「真正最棒的一杯」吧。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我開始露營的契機，",
    "voice": "vo_adv_1222004_067",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n雖然只是為了想喝麥酒……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但是像這樣純粹享受自然、",
    "voice": "vo_adv_1222004_068",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "講究料理……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "還有聊些平常不會對別人說的事情……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "如果我沒有下定決心挑戰露營，",
    "voice": "vo_adv_1222004_069",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n就絕對無法注意到",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "像這樣度過的樂趣……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "而且",
    "voice": "vo_adv_1222004_070",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "自從迷上露營後，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我工作也變得非常順利。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "前陣子",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我還因為財團的業績提升而受到誇獎呢。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我想這一定是",
    "voice": "vo_adv_1222004_071",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "平日和週末的公私分得很清楚的關係吧。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n像之前那樣忙到慌慌張張的情況也減少了……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "秋乃雖然是個有點奇特的人……",
    "voice": "vo_adv_1222004_072",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但能得到上司的稱讚，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "果然很開心呢。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊哈哈……",
    "voice": "vo_adv_1222004_073",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這些話",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "對你好像還太早了？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不過，",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "等你變成社會人士後，應該就能懂我的心情了。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "所以……",
    "voice": "vo_adv_1222004_074",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "等你年紀再大一點後……",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n到時候我們就找個時間",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "一起露營喝麥酒吧。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "大姐姐我會好好期待並等著，",
    "voice": "vo_adv_1222004_075",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n等著能和你一起品嚐大人味道的那時候到來喔♪",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "兩人之後也持續享受週末露營，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n並過著比以前還要充實的日常生活。",
    "voice": null,
    "unit_id": null
  }
]
