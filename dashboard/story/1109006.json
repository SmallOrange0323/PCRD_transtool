[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "從學院回家的路上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n琪愛兒閒來無事，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n腳自然而然地就往蘭德索爾的老地方走去。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我是可愛的琪愛兒～♪",
    "voice": "vo_adv_1109006_000",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n大家最愛的琪愛兒～♪",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我看看哦～？　",
    "voice": "vo_adv_1109006_001",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗯，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好像還沒來呢。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我也沒有特別指是誰會來就是囉。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好～",
    "voice": "vo_adv_1109006_002",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "既然剛好有空，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n就在這裡舉辦藍天欣賞會，等人來吧！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不過，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我也沒有特別在等誰來就是囉！　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "看膩",
    "voice": "vo_adv_1109006_003",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "藍天了呢……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "然後，",
    "voice": "vo_adv_1109006_004",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "怎麼還～不來……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我並沒有特別指是誰會來就是了……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是今天要送的貨很多，很辛苦嗎……",
    "voice": "vo_adv_1109006_005",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n沒辦法了，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "總之我再看一下藍天吧……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "…………都不來。",
    "voice": "vo_adv_1109006_006",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": "vo_adv_1109006_007",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "都不來耶。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n咦，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那人到底想怎樣啊。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n咦，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "太扯了吧？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "為什麼我非得這樣等他不可啊？",
    "voice": "vo_adv_1109006_008",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是說琪愛兒基本上是讓別人等我的類型耶。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，是怎樣，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "搞什麼，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "未免太扯了吧？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "………………不是，怎麼不來啊，喂！",
    "voice": "vo_adv_1109006_009",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "未免太扯了吧，未免太扯了吧！",
    "voice": "vo_adv_1109006_010",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n真的有夠莫名其妙，那個人到底在做什麼！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n該不會是腦袋撞上史萊姆的角，橫死在路邊了吧！　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "…………",
    "voice": "vo_adv_1109006_011",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": "vo_adv_1109006_012",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "該不會，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "真的發生什麼事了……？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不會吧，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "怎麼辦，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "得去找他才行！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊？！",
    "voice": "vo_adv_1109006_013",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n那個包包和{0}學長平時背的一樣！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "大概是同業的人，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "去問問看那個人吧！　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不好意思～！",
    "voice": "vo_adv_1109006_014",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n我有點事想問你～！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "伊麗莎白牧場……？",
    "voice": "vo_adv_1109006_015",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "是啊，",
    "voice": "vo_adv_1109006_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "是位於山丘上的牧場哦。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "\\n最近請他幫忙送這附近的貨，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "\\n不過他原本負責的區域是那一邊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "什麼嘛，",
    "voice": "vo_adv_1109006_017",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "原來是這樣啊。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這孩子真是讓人虛驚一場，真令人困擾呢。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n我代替他道歉，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "對不起啦。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗯～",
    "voice": "vo_adv_1109006_018",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那麼琪愛兒去散步，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "順道去一下那個牧場吧。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我不會打擾他工作哦？　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "只是稍微參觀工作而已。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "呃……",
    "voice": "vo_adv_1109006_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "妳",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "是他的家人嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不是不是。",
    "voice": "vo_adv_1109006_020",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "那是",
    "voice": "vo_adv_1109006_021",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "戀人嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦～",
    "voice": "vo_adv_1109006_022",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "怎麼可能。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n不覺得我們很不配嗎～",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "尤其是臉。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "那不然……",
    "voice": "vo_adv_1109006_023",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "妳是他的什麼人？　",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "跟蹤狂嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啥、",
    "voice": "vo_adv_1109006_024",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啥啊！？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n攔住大家都喜歡、搶著要的超級美少女，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n竟然還說我是跟、",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "跟蹤狂！？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "因為",
    "voice": "vo_adv_1109006_025",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "妳不是家人也不是戀人，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "\\n還說妳在這裡堵他……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "而且，",
    "voice": "vo_adv_1109006_026",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "等下還要特地追到山丘上不是嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "那不就是",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "一般俗稱的跟蹤——",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不是。",
    "voice": "vo_adv_1109006_027",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n我是去參觀工作。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "是嗎，",
    "voice": "vo_adv_1109006_028",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "不管怎麼想都是跟蹤——",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不是。",
    "voice": "vo_adv_1109006_029",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我是在打發時間。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是少女的心血來潮。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "background",
    "bg_id": "500151"
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "於是總算洗清我的冤罪，",
    "voice": "vo_adv_1109006_030",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n一邊來到了這個山丘上的【伊麗莎白牧場】。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "來到這裡除了參觀工作，",
    "voice": "vo_adv_1109006_031",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "沒有其他意思。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我以在蘭德索爾社會中表現活躍的獨立女性為目標，",
