    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就是碰巧有事",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "來這邊……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不對啊！",
    "voice": "vo_adv_1109006_058",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "　啊啊，真是的，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "竟然找了藉口……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "別動搖啊我，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "要切嚕地活下去。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "說笑的，",
    "voice": "vo_adv_1109006_059",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "剛才是在騙你的～",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我只是有點昏頭了～☆",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我要說實話囉？",
    "voice": "vo_adv_1109006_060",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n琪愛兒在這裡",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不是碰巧，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "其實是——",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "因為我很閒，",
    "voice": "vo_adv_1109006_061",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就來玩學長了！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "…………",
    "voice": "vo_adv_1109006_062",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊，",
    "voice": "vo_adv_1109006_063",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不好意思，",
