  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗯？　",
    "voice": "vo_adv_1109006_033",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "從那間悠靜的簡易小屋出來的人影是……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "噫，",
    "voice": "vo_adv_1109006_034",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "{0}學長！",
