    "type": "dialogue",
    "name": "靜流",
    "words": "不知道",
    "voice": "vo_adv_1365003_050",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟是否注意到了呢。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "如果弟弟",
    "voice": "vo_adv_1365003_051",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "打算回應某個人對他的喜歡，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我還能",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "像現在一樣",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "當個「姐姐」嗎……？",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我",
    "voice": "vo_adv_1365003_052",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "發誓，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "會永遠……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "讓弟弟",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "幸福！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "background",
    "bg_id": "502630"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "雖然",
    "voice": "vo_adv_1365003_053",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我說了那樣的話。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "雖然那句話，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真的是我的肺腑之言……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不過既不是真正的姐弟，",
    "voice": "vo_adv_1365003_054",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "也不是真正的新婚夫妻……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n那樣的我……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "可以說是「真正的」",
    "voice": "vo_adv_1365003_055",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗎……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我是",
    "voice": "vo_adv_1365003_056",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟的姐姐，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n所以我不曾關心這一點，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "也不曾在意，但是……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不管是弟弟的事，",
    "voice": "vo_adv_1365003_057",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還是自己的事，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n也許現在，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "正是該好好想清楚的時候了。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好好思考吧……",
    "voice": "vo_adv_1365003_058",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "畢竟，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "只要一想到",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "要是弟弟",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "回應了某個人的心意，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我就……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不知怎麼地，",
    "voice": "vo_adv_1365003_059",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "會忍不住非常心煩意亂……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊，",
    "voice": "vo_adv_1365003_060",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "歡迎回來。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我稍微",
    "voice": "vo_adv_1365003_061",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "想了點事情，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n好像不小心自言自語起來了。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "別說這個了……",
    "voice": "vo_adv_1365003_062",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我們回程不要牽手，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我想挽著你的手臂，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "太好了～♪",
    "voice": "vo_adv_1365003_063",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n那就回家吧，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "兩人挽著手臂，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "相親相愛地並肩而行。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n即使能待在東國的時間已接近尾聲，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n現在這個當下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "他們仍是「新婚夫妻」。",
    "voice": null,
    "unit_id": null
  }
]
