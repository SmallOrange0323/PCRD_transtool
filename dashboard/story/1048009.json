  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n助我一臂之力吧！！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我就知道{0}會這麼說♪",
    "voice": "vo_adv_1048009_009",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "其實我已經",
    "voice": "vo_adv_1048009_010",
    "unit_id": 104811
