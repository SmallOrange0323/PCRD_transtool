    "voice": "vo_adv_1048009_086",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "剛才那是怎麼回事……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n{0}只是把臉靠過來，",
