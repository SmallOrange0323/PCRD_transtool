    "type": "dialogue",
    "name": "凱留",
    "words": "然後，",
    "voice": "vo_adv_9002017_030",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "今後也會繼續締結羈絆吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "說得不錯，",
    "voice": "vo_adv_9002017_031",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "凱留。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "說的也是呢。",
    "voice": "vo_adv_9002017_032",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n迎接一個重要時刻，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
