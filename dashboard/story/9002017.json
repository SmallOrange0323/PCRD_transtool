    "name": "貪吃佩可",
    "words": "是的！",
    "voice": "vo_adv_9002017_033",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "滿懷著我們對迎來這一日的感謝，",
