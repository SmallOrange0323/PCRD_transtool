  {
    "type": "dialogue",
    "name": "宮子",
    "words": "──布丁會議開始。",
    "voice": "vo_adv_4010240_000",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "今天是宮子的生日喲。",
    "voice": "vo_adv_4010240_001",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "所以你買了",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好多布丁回來給人家當禮物。",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "各種不同廠牌、口味各不相同的布丁，",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "一",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "大堆。",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子覺得好開心，",
    "voice": "vo_adv_4010240_002",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n也好感謝",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "{0}。",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可是同時，",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "又察覺到一件事──",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這就跟",
    "voice": "vo_adv_4010240_003",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "平時一樣喲！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "跟你要布丁吃",
    "voice": "vo_adv_4010240_004",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "一直都是人家的日常！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這樣缺乏那種只有生日才有的特別感啦～～～～～～！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家就知道。",
    "voice": "vo_adv_4010240_005",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "所以才要召開",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "布丁會議喲。",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子想要用特別的感覺",
    "voice": "vo_adv_4010240_006",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "來吃你準備的生日布丁。",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那樣的話，",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "吃起來肯定",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "會比平時還要好吃許多才對……！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "{0}，你快想想有什麼辦法！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你來餵？",
    "voice": "vo_adv_4010240_007",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "怎麼可能因為那樣就變──",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "唔咕。",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好像",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "有點好吃。",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你再",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "多餵宮子吃幾口。",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……啊～",
    "voice": "vo_adv_4010240_008",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "呣♪",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n真好吃～！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "光是讓你餵布丁，",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "感覺……",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就有種軟綿綿的滋味～♪",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這可是大發現喲！",
    "voice": "vo_adv_4010240_009",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n搞不好你正是為了",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "餵宮子吃好吃的布丁",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n而活在這個世上的～！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "布丁會議",
    "voice": "vo_adv_4010240_010",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "大成功喲！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那就繼續餵宮子吃布丁吧♪",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "在全～部吃光光以前",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你都是屬於宮子的喲～♪",
    "voice": null,
    "unit_id": 100731
  }
]
