  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳可是我的妹妹啊！",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "知道了啦，",
    "voice": "vo_adv_5150308_005",
    "unit_id": 190912
  },
  {
