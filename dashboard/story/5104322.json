[
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "唔……",
    "voice": "vo_adv_5104322_000",
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "敵人的外層太硬了，",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n很難對它造成傷害！",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "茉莉，",
    "voice": "vo_adv_5104322_001",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我來告訴妳一件好事吧。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "所謂的戰鬥，並不是只有老實地從正面迎戰這種方式。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "讓敵人行動遲緩、",
    "voice": "vo_adv_5104322_002",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "削弱其防禦……",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "用盡所有能用的手段來戰鬥吧。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不論如何訴說自身的正義，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "一旦沒有足夠力量就什麼都辦不到。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "的確是這樣沒錯呢。",
    "voice": "vo_adv_5104322_003",
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "現在就先同心協力，",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "確實地削弱敵人的體力吧！",
    "voice": null,
    "unit_id": 123911
  }
]
