[
  {
    "type": "background",
    "bg_id": "510030"
  },
  {
    "type": "background",
    "bg_id": "510030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接到嘉夜的聯絡後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}來到了電子遊樂場。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "學長，",
    "voice": "vo_adv_9006011_000",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這邊、這邊。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哈哈……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "謝啦，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你還特地跑一趟。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你看到mimi的通知了吧？",
    "voice": "vo_adv_9006011_001",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n今天我想慶祝紀念日，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "或者說是跟你道個謝。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你還記得嗎？",
    "voice": "vo_adv_9006011_002",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我們第一次見面的時候，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我被一群小混混糾纏……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "結果",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是你救了我。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真的，",
    "voice": "vo_adv_9006011_003",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "自己人裡有個麻煩精就是這麼棘手……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "在阿斯特朗傳奇見到也是那之後的事了。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n不過能像現在這樣混在一起",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也是多虧了這傢伙。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就是這樣，",
    "voice": "vo_adv_9006011_004",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "今天我請客。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n儘管玩吧……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "鬼道──！",
    "voice": "vo_adv_9006011_005",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "你這傢伙，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "我今天一定要收拾你！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被稱為鬼道的男子",
    "words": "小嘍囉吵死了！",
    "voice": "vo_adv_9006011_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被稱為鬼道的男子",
    "words": "\\n你們這種雜兵再多湊幾個人也不會有改變的啦！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呃────！",
    "voice": "vo_adv_9006011_007",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "為為、",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "為什麼那傢伙會在這裡呀？　",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呃，",
    "voice": "vo_adv_9006011_008",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我姓鬼道呀？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這、",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這又怎麼了嗎，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "學長……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哎喲，",
    "voice": "vo_adv_9006011_009",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "只是剛好有個同姓氏的人在這裡吧～？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n你想，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "鬼道這個姓氏",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "很常見的嘛。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哈哈哈……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "先不管那個了。學長，",
    "voice": "vo_adv_9006011_010",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "試試這個遊戲吧。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我幫你投幣……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你看，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "快點！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "要開始了！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我去找其他遊戲玩哦！",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "background",
    "bg_id": "510030"
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "唔啊啊啊啊──！",
    "voice": "vo_adv_9006011_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被稱為鬼道的男子",
    "words": "搞什麼啊，",
    "voice": "vo_adv_9006011_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被稱為鬼道的男子",
    "words": "沒有嘴上說得厲害嘛。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我說啊……",
    "voice": "vo_adv_9006011_013",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n要打架可以換個地方嗎？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n真是讓人困擾。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "被稱為鬼道的男子",
    "words": "啥？",
    "voice": "vo_adv_9006011_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被稱為鬼道的男子",
    "words": "……什麼嘛，是妳呀。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被稱為鬼道的男子",
    "words": "\\n妳在這個地方做什麼啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我在什麼地方做什麼事都無所謂吧。",
    "voice": "vo_adv_9006011_015",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n話說回來，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "電子遊樂場不是用來打架的地方，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是玩遊戲的地方。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "懂不懂啊？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "被稱為鬼道的男子",
    "words": "我也是來玩遊戲的啊？",
    "voice": "vo_adv_9006011_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被稱為鬼道的男子",
    "words": "\\n是對方先找碴的，我只是陪他過兩招而已。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那種事不重要啦，",
    "voice": "vo_adv_9006011_017",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "跟我又沒有關係。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還有，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "今天爸媽都要上夜班",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "所以沒有晚餐。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n你自己在外面隨便解決吧。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "被稱為鬼道的男子",
    "words": "我知道了。",
    "voice": "vo_adv_9006011_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被稱為鬼道的男子",
    "words": "\\n那妳呢？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我跟朋友一起吃。",
    "voice": "vo_adv_9006011_019",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n要交代的事情就只有這個。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就這樣。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "被稱為鬼道的男子",
    "words": "喔，",
    "voice": "vo_adv_9006011_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被稱為鬼道的男子",
    "words": "好……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被稱為鬼道的男子",
    "words": "\\n那我也隨便解決吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唉……",
    "voice": "vo_adv_9006011_021",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真是累人……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "學長？",
    "voice": "vo_adv_9006011_022",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "算是吧。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然是個不太想碰到面的人。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那個……",
    "voice": "vo_adv_9006011_023",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "如果和我待在一起的話，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n有可能會像初次見面時那樣被麻煩的小混混糾纏……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n學長不反感嗎？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣啊……",
    "voice": "vo_adv_9006011_024",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "謝啦。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "問我謝什麼？",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唔……",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "因為你聽我說了",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不少煩惱呀。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不能因為自己人的恩恩怨怨害春咲受牽連，",
    "voice": "vo_adv_9006011_025",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n能聽我說這些事的人，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也就只有學長了。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊，",
    "voice": "vo_adv_9006011_026",
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "氣氛突然有些沉悶。",
    "voice": null,
    "unit_id": 106531
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
