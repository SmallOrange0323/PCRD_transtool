  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……{0}，",
    "voice": "vo_adv_1010011_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你不論變成怎樣都是一位王子殿下呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真美好呢……",
    "voice": "vo_adv_1010011_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n一面立著誓一面被親吻了手……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這可是所有少女的嚮往呀……♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，",
    "voice": "vo_adv_1010011_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這次就到此為止囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你就趕快回去好好陪伴真步那孩子吧，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "命運中的王子殿下♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500060"
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呣喵……",
    "voice": "vo_adv_1010011_060",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "啊，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n難不成，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "睡著了嗎……？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……王子先生也睡著了呢。",
    "voice": "vo_adv_1010011_061",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "雖然王子先生突然睡著這件事已經遇過好幾次了，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n但兩人同時還真稀奇呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "而且，",
    "voice": "vo_adv_1010011_062",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n人家竟然還夢到了，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生對人家立下了誓言的夢呢……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咦？",
    "voice": "vo_adv_1010011_063",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生也做了一樣的夢？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n還真是有這種不可思議的事情呢～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那、",
    "voice": "vo_adv_1010011_064",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那個呀，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n如果說，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家也有像夢裡頭的人家一樣的煩惱的話……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "啊……！",
    "voice": "vo_adv_1010011_065",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n您、",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您不用跪下來，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n把夢裡發生的事情重現一次也沒關係啦～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵，",
    "voice": "vo_adv_1010011_066",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不管那是不是夢，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "果然王子先生就是王子先生呢♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……那麼，",
    "voice": "vo_adv_1010011_067",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "既然收下了王子先生的包裹了，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n那人家也要重新開始打包行李了。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……人家，",
    "voice": "vo_adv_1010011_068",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也不能輸給夢裡的那個自己，得再加把勁才行呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "首先，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "要先把人家心裡真正想的事，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n還有現在想要做的事情，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好好地傳達給父親才行呢……！　",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "雖然對於到底能不能辦到還有點不安……",
    "voice": "vo_adv_1010011_069",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但一定沒問題的。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n畢竟人家，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n可是有願意立下誓言的",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生陪伴在人家身邊呢♪　",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "神奇真步魔法靈，",
    "voice": "vo_adv_1010011_070",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咕嚕咕嚕靈～……☆",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵，",
    "voice": "vo_adv_1010011_071",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這可是少女的祕密唷～♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "——真步那似乎很開心的聲音。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n直到其他的公會成員都回來了以後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n依舊在公會小屋中迴盪始終不絕於耳。",
    "voice": null,
    "unit_id": null
  }
]
