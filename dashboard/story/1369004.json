[
  {
    "type": "background",
    "bg_id": "502490"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "璐璐伊他們回到了巨鯨城。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}雖然延長了幾天的停留時間，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但就在即將結束前的某天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502460"
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "嗚啾。",
    "voice": "vo_adv_1369004_000",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "搞、",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "搞砸了……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "……唔！",
    "voice": "vo_adv_1369004_001",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "謝、",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "謝謝你……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶平常不會這麼笨手笨腳的，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "只素稍微……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "嗚啾。",
    "voice": "vo_adv_1369004_002",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "其實，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "素關於騎士先生要離開這件素……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "那個……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶、",
    "voice": "vo_adv_1369004_003",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶這個樣子，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "素不行的吧。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "以頂極的款待",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "照顧客人，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n素公主姐接交代給偶的工作。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "讓重要的客人",
    "voice": "vo_adv_1369004_004",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "可以待得舒適，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n然後活力滿滿地離開，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "這明明素最重要的。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "卻稍微",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "覺得有點寂寞了。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "真的嗎？",
    "voice": "vo_adv_1369004_005",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n偶們很快",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "就能再見面嗎？",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "有很多人都在等著騎士先生。",
    "voice": "vo_adv_1369004_006",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "雖然偶也素其中之一……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "嗚啾啾……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶希望",
    "voice": "vo_adv_1369004_007",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "能和你再多待一會。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n不想就這樣讓你回去。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "──對了！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶想到一個好主意了！　",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "好的，",
    "voice": "vo_adv_1369004_008",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "騎士先生也要多保重──",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "不素啦！！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n偶不素那個意思！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "騎士先生！",
    "voice": "vo_adv_1369004_009",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n變態！！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "那真素失禮了……",
    "voice": "vo_adv_1369004_010",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "不對啦！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶要縮的素變體，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "從「深邃庭園」回來後，",
    "voice": "vo_adv_1369004_011",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "雖然你作為「候補」進行了各種特訓……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "但只要騎士先生可以改變形體，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "肯定就沒有問題了！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n腳變多了也會很方便喔！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "只要變成相同的形體，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "還有其他優點──",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "擇日不如撞日！",
    "voice": "vo_adv_1369004_012",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n借用父親大人的力量……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "來變體吧！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "放心吧，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "在做夢期間一切都會結束的！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "……咦？",
    "voice": "vo_adv_1369004_013",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n奇怪。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n這道光芒和父親大人的",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "不太一樣……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "background",
    "bg_id": "510501"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "{0}先生、{0}先生！\\n你來見偶了呢！",
    "voice": "vo_adv_1369004_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "偶",
    "voice": "vo_adv_1369004_015",
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "叫做「深見璐璐」。",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "\\n",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "因為想見{0}先生，",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "\\n所以一直在這裡等你喔。",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "……",
    "voice": "vo_adv_1369004_016",
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "素",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "的，",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "沒錯！",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "\\n看來偶模仿得很成功，太好了！",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "\\n",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "欸嘿嘿……",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "嗚啾……",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "今天的收穫很多喔。",
    "voice": "vo_adv_1369004_017",
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "\\n",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "像素章魚、",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "鮑魚、",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "海膽、",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "蝦子，",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "\\n",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "再來就素章魚，",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "還有章魚之類的呢。",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "你喜歡哪一個呢？",
    "voice": "vo_adv_1369004_018",
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "\\n章魚……",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "素章魚嗎？",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "素章魚對吧！",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "\\n",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "好吃又可愛，",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "素海裡的人氣王喔！",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "你知道嗎？",
    "voice": "vo_adv_1369004_019",
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "\\n海裡閃閃發光，",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "既美麗",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "又有趣，",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "還很熱鬧，",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "\\n",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "真的非常棒喔。",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "海裡非常深",
    "voice": "vo_adv_1369004_020",
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "又暗，",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "而且吵雜。",
    "voice": null,
    "unit_id": 136931
  },
  {
    "type": "dialogue",
    "name": "璐璐",
    "words": "\\n一直不斷",
    "voice": null,
