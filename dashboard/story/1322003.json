    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因此，",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}跟的鍊金術師生活，",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n暫時也宣告到今天為止。",
