[
  {
    "type": "background",
    "bg_id": "501950"
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "お金を稼ぐのって気持ちがいいにゃ♪",
    "voice": "vo_adv_6114205_000",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nもっともっと工夫してたくさん稼ぐのにゃ！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "売り上げアップのためには……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "誰に相談するのがいいと思うにゃ？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "パーフェクトな人選だにゃ！　",
    "voice": "vo_adv_6114205_001",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "ミフユに頼めば",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nカフェのお仕事の効率が飛躍的にアップするはずにゃ！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "仕事量も増える気がするけど、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "キミも一緒にがんばってほしいにゃ♪",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "そうだにゃ、",
    "voice": "vo_adv_6114205_002",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "やっぱり商売のことといえば",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nアキノを頼るのがいちばんにゃ！　",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "飛空艇を借りて、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "お店のチラシを",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n撒いてもらうとかどうかにゃ？　",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "きっと大繁盛間違いなしにゃ♪",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "そういえば最近、",
    "voice": "vo_adv_6114205_003",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "コーヒーに凝ってるって言ってたのにゃ。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "案外悪くない人選かも……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "いや、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "やっぱりやめとくのにゃ。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nユカリの意見を聞いてたら、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "そのうち飲み屋になっちゃうのにゃ。",
    "voice": null,
    "unit_id": 125111
  }
]
