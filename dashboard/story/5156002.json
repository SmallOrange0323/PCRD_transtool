    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "這樣我沒動力做啦～",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "咦、",
    "voice": "vo_adv_5156002_019",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "咦咦？",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n……是這樣嗎？",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "為了加快速度，",
    "voice": "vo_adv_5156002_020",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "希望能把引擎的轉速提升到上限！",
