    "type": "dialogue",
    "name": "布武機",
    "words": "\\n……",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "呱呱？",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "根本是雜碎蛙吧？",
