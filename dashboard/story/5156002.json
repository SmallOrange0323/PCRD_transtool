  },
  {
    "type": "dialogue",
    "name": "團員們",
    "words": "是！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "哇哇，",
    "voice": "vo_adv_5156002_057",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "意想不到的展開！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "布武機，好厲害……！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n太厲害了～！",
