    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "呀哈哈，",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "三流呱呱真是笑死人了～♡",
