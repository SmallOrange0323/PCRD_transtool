    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "眾人入睡後，在格羅哥團據點的角落，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n【蠻賊三姊妹】和{0}正壓低聲音溝通著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "襲襲襲、",
    "voice": "vo_adv_5156002_083",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "襲擊",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "蘭德索爾！？",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "就說妳太大聲了笨菜姊！",
    "voice": "vo_adv_5156002_084",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n腦袋變聰明吧，",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "變聰明吧～！",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "好痛！",
    "voice": "vo_adv_5156002_085",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "好痛好痛！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "布武機！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n別把拿我的平底鍋敲我的頭這件事，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n當成妳新的嗜好～",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不要玩了把話聽完。",
    "voice": "vo_adv_5156002_086",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──聽好了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "但是那個襲擊作戰",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不會成功。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……因為襲擊那天，",
    "voice": "vo_adv_5156002_087",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我們會背叛他們。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "咦咦咦！",
    "voice": "vo_adv_5156002_088",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "偏偏要挑",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "這麼不得了的時候做出這麼不得了的事情……！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "真是的。",
    "voice": "vo_adv_5156002_089",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "妳還真是不懂事。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "小偷就是得趁火打劫啊。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "大家都忙得不可開交的時候，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "正好是我們開始行動的好機會。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "呵呵呵，",
    "voice": "vo_adv_5156002_090",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "把這裡的財寶跟零件全都拿走的話，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我們的人生……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "會有天翻地覆的變化喔。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "吞口水……",
    "voice": "vo_adv_5156002_091",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嘿♡",
    "voice": "vo_adv_5156002_092",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "好痛！",
    "voice": "vo_adv_5156002_093",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n吞口水也不行嗎！？",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是，倭一行人的叛變計畫正在持續進行著。",
