    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "不知道會怎麼樣害我超級緊張的。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "雖然我完全不懂機械的事情，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n但布武機，真的是天才呢……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "笨菜姊，",
    "voice": "vo_adv_5156002_059",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "平底鍋借我一下？",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "嗯？",
    "voice": "vo_adv_5156002_060",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "──好痛！",
    "voice": "vo_adv_5156002_061",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我明明在誇獎妳，為什麼要打我的頭～",
