    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n想在車頂",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "加上很大的12.7毫米機關槍！！",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "引擎蓋上",
    "voice": "vo_adv_5156002_021",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "也想加裝超帥的切割劍……",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "想讓它變成超帥的腳！！！！",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n這樣",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "不行嗎？",
