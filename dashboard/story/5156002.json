    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "那～那～",
    "voice": "vo_adv_5156002_054",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "給我",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "冰淇淋汽水～♡",
