    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "怎麼可能不行！？",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "大叔你啊～",
    "voice": "vo_adv_5156002_022",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n裝成一副對車子很講究的樣子～",
