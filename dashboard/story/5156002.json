    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "只要穿過那扇門，",
    "voice": "vo_adv_5156002_074",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "就能夠在被那邊發現之前，",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n一鼓作氣地發動奇襲。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……原來如此……",
    "voice": "vo_adv_5156002_075",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "是布武機做的門，",
    "voice": "vo_adv_5156002_076",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n還是貪吃公主他們忘了關掉的門呢……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "無論如何，居然能察覺那東西的真面目，",
    "voice": "vo_adv_5156002_077",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n這些傢伙倒是滿精明的。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哼哼，",
    "voice": "vo_adv_5156002_078",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "對和平的城鎮發動總攻擊，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n把所有東西都偷個精光……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那還真是，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "令人期待能夠同行呢♪",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "對吧？",
    "voice": "vo_adv_5156002_079",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "雖然沒有蠻賊貪鯊號是有點可惜……",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "但也沒關係，",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "有這台新型車輛的話，",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "就沒什麼好怕的了。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "──對蘭德索爾的襲擊，",
    "voice": "vo_adv_5156002_080",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n就在本大爺的新型車輛完成後，",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "正式出發。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "一直偷",
    "voice": "vo_adv_5156002_081",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "一直偷",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "不停地偷，",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n把蘭德索爾全都偷個精光！",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "嘎哈──！",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……是啊。",
    "voice": "vo_adv_5156002_082",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n那還真是……",
