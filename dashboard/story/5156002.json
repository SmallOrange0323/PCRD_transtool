    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "喂，你們這些傢伙快放下武器！",
