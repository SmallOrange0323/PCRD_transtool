    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "淇淋汽水～！",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n綜合果汁～！",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "……什麼？",
    "voice": "vo_adv_5156002_007",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n是在說什麼暗號嗎？",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "沒什麼，",
    "voice": "vo_adv_5156002_008",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "只是在閒聊而已。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "比起那種事，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "首領本人要負責監視可真是辛苦啊。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "什麼監視，說得這麼難聽。",
