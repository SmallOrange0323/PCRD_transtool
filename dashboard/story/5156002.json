    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "咦，",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "其實是跟風仔？",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "只是在裝內行嗎？ｗ",
