    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "還是白紙啊！？",
    "voice": "vo_adv_5156002_016",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n你這段時間都在幹嘛啊！？",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "那、",
    "voice": "vo_adv_5156002_017",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "那個，這是因為……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n布武機！",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "因為～",
    "voice": "vo_adv_5156002_018",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "大叔提出的要求，",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
