    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "我只是，",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "想看看那位布武機會怎麼樣畫設計圖而已。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哈，",
    "voice": "vo_adv_5156002_010",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "還真敢講。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n明明把拿著武器的團員，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這樣成群帶在身旁。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "團員們",
    "words": "…………",
    "voice": "vo_adv_5156002_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "嘎哈哈──",
    "voice": "vo_adv_5156002_012",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "沒什麼，",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "只是形式上做做樣子而已。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n職業病嘛，",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "疑心病蠻重的。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "那麼，",
    "voice": "vo_adv_5156002_013",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "整體框架已經差不多好了吧？",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n稍微讓我看看吧。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
