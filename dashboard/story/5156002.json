    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "在",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "呱呱叫～",
