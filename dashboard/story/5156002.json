    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "想說多敲幾下的話，",
    "voice": "vo_adv_5156002_062",
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "那顆笨腦袋不知道會不會",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "變聰明一點♡",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "還有妳太囉唆了♡",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……那麼。",
    "voice": "vo_adv_5156002_063",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n瘋狂喬啊。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這下你可以相信",
    "voice": "vo_adv_5156002_064",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我們不是冒牌貨了吧？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "是啊。",
    "voice": "vo_adv_5156002_065",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "就算叫我懷疑，",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "我也辦不到。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哈哈哈。",
    "voice": "vo_adv_5156002_066",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n既然你都相信我們了，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n那我們也會盡全力幫助你們。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "…………看起來你們那邊，",
    "voice": "vo_adv_5156002_067",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n正在進行",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "能大賺一筆的計畫，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "是吧？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "是啊，",
    "voice": "vo_adv_5156002_068",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "沒有錯。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n我們接下來計畫著要來場前所未有的遠行♪",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "偷竊地點就在",
    "voice": "vo_adv_5156002_069",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "吉歐‧格黑納之外。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "名為蘭德索爾",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "的異世界的國家。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "…………喔。",
    "voice": "vo_adv_5156002_070",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "就偵查隊所說，",
    "voice": "vo_adv_5156002_071",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "那邊既溫暖、",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "和平、",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "又豐饒。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n也因為這樣居民和上面的人都很缺乏危機意識，",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "嘎哈。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n簡直就是在說著「請來襲擊我們的」土地呢。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不過，",
    "voice": "vo_adv_5156002_072",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那是異世界吧？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n要怎麼用車子移動啊。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "關於那個，",
    "voice": "vo_adv_5156002_073",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "妳可別嚇到了。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "我們",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "偶然找到了喔。",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "\\n能夠通往那個世界的，",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "瘋狂喬",
    "words": "被稱為「門」的東西。",
