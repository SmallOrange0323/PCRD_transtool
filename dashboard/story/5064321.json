[
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯出現了緊急狀況。",
    "voice": "vo_adv_5064321_000",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "憂妮們完全復活～",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "以下省略。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "唔唔唔，",
    "voice": "vo_adv_5064321_001",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "可惡的憂妮們，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "竟然自我修復跟自我進化以下省略。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "討厭啦！",
    "voice": "vo_adv_5064321_002",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那傢伙超級煩人的耶！！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "要是不快點把事情解決，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "聖學祭就要開始收攤了！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "琪愛兒還有很多想看的展示耶，要怎麼辦啦！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 14511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "吵死了。",
    "voice": "vo_adv_5064321_003",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n現在在說很重要的事，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "給我安靜點。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "真是的，",
    "voice": "vo_adv_5064321_004",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "什麼嘎喔啊。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n用那種蚊子般的叫聲，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我們才不會害怕。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "琪愛兒，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "讓她聽聽妳",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "靈魂的咆嘯。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "唔喔喔喔──！",
    "voice": "vo_adv_5064321_005",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳這是瞧不起我們嗎？",
    "voice": "vo_adv_5064321_006",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n不對，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳被敵人瞧不起了喔。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "用給那叫什麼慈樂之音的加油聲，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "拿出真本事來。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "望──望──！",
    "voice": "vo_adv_5064321_007",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不夠凶，",
    "voice": "vo_adv_5064321_008",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "音程降兩度。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "望──望────！",
    "voice": "vo_adv_5064321_009",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "用強弱法，",
    "voice": "vo_adv_5064321_010",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "漸強。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "望唔唔唔唔",
    "voice": "vo_adv_5064321_011",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "望啊啊啊啊──！！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "克蘿依，",
    "voice": "vo_adv_5064321_012",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳也上。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "望唔唔唔唔",
    "voice": "vo_adv_5064321_013",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "望啊啊啊啊──！！",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "優妮學姐也一起吧！",
    "voice": "vo_adv_5064321_014",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "預備，來！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "好朋友社",
    "words": "望唔唔唔唔",
    "voice": "vo_adv_5064321_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "好朋友社",
    "words": "望",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "好朋友社",
    "words": "啊啊啊啊──！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "…………？",
    "voice": "vo_adv_5064321_016",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "學姐，",
    "voice": "vo_adv_5064321_017",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n路過的望望",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "用「叫我嗎？」的臉在看這邊。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "沒有叫她。",
    "voice": "vo_adv_5064321_018",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "沒有在叫妳──",
    "voice": "vo_adv_5064321_019",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": "vo_adv_5064321_020",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "發生了什麼事嗎？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n話說妳們在跟誰說話啊？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 14511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，糟糕，",
    "voice": "vo_adv_5064321_021",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "憂妮們超生氣的耶。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "琪愛兒，要上囉──",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊，",
    "voice": "vo_adv_5064321_022",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好的～！",
    "voice": null,
    "unit_id": 116311
  }
]
