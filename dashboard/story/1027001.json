    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "因為瘴氣太強而昏倒了呢。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "因自己興趣製作的毒藥",
    "voice": "vo_adv_1027001_018",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "而昏倒，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這還是第一次……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "今天真是",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "奇怪的一天呢。",
