  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當某位少女正獨自一人走在街道上時。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊……",
    "voice": "vo_adv_1027001_000",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我命中注定的人……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "您現在在哪裡做些什麼呢？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "好想早點與您相見……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嘻嘻。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "占卜師",
    "words": "那個……",
    "voice": "vo_adv_1027001_001",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "占卜師",
    "words": "那邊那位小姐……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "占卜師",
    "words": "\\n妳要占卜一下嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "占卜……？",
    "voice": "vo_adv_1027001_002",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "雖然我有興趣，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "但是我現在身上沒有錢。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "占卜師",
    "words": "不用錢的。",
    "voice": "vo_adv_1027001_003",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "占卜師",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "占卜師",
    "words": "我父親堅持說想要幫妳占卜，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "占卜師",
    "words": "請務必試看看。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你的……",
    "voice": "vo_adv_1027001_004",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "爸爸？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "就是我！",
    "voice": "vo_adv_1027001_005",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n我想要幫小姐妳占卜一下！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我看看……",
    "voice": "vo_adv_1027001_006",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "原來是這樣，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我知道了！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n小姐妳今天會遇上",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "命中注定的對象！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "命中注定的對象……！？",
    "voice": "vo_adv_1027001_007",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嘻嘻……",
    "voice": "vo_adv_1027001_008",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是這樣嗎，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "終於。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "終於……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "能夠相見了呢……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "沒錯，",
    "voice": "vo_adv_1027001_009",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "那位命中注定的對象……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "就是我了！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n可以的話，接下來跟我去喝杯茶——",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "占卜師",
    "words": "爸爸……",
    "voice": "vo_adv_1027001_010",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "占卜師",
    "words": "她已經走了唷。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}發現一位昏倒在路邊的女孩。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚…………",
    "voice": "vo_adv_1027001_011",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚、",
    "voice": "vo_adv_1027001_012",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我、",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我居然……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……哎呀，",
    "voice": "vo_adv_1027001_013",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "您是？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我剛剛是不是昏倒了……？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在那邊昏倒了……？",
    "voice": "vo_adv_1027001_014",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我嗎？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "您……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "剛才在照顧我嗎？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "謝謝您。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "為什麼",
    "voice": "vo_adv_1027001_015",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我會昏倒了呢？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這麼說來……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "把藥……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "生病？",
    "voice": "vo_adv_1027001_016",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "您以為我本身患了病，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "因為藥吃完所以昏倒了？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "要解釋也麻煩……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "您就當是這樣吧。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "雖然話是這麼說，",
    "voice": "vo_adv_1027001_017",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "但我也太大意了。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "竟然不小心",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "聞到自己製作的毒藥……",
