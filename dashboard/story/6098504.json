[
  {
    "type": "background",
    "bg_id": "501161"
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "……正月の予定ですか？",
    "voice": "vo_adv_6056504_000",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "いえ、",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "特には何も。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n季節ごとの行事に興じる暇も、",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "あまりありませんから。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "ええ、",
    "voice": "vo_adv_6056504_001",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "やることは山積みです。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\nむろん、",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "そのために貴方にも色々と動いてもらうつもりですから。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "……大いに期待していますよ。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "これからの貴方の働きに。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "諦めなさい。",
    "voice": "vo_adv_6056504_002",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "そんな子犬のような目で訴えても",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "無駄ですよ。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "はあ、",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "仕方ありませんね……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "新年のお参りくらいなら、",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n付き合ってあげても構いません……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "貴方もやるようになりましたね。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "……まったく、",
    "voice": "vo_adv_6056504_003",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "貴方という人は。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "ですが",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "私といえども、",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "時には休息が必要なのも認めましょう。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "ただし、",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "ネネカ",
    "words": "正月だからといって怠けすぎはいけませんよ？",
    "voice": null,
    "unit_id": 115011
  }
]
