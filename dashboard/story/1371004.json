  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "啊……！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n難道說，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是中暑了？",
