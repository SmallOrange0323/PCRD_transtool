  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "其實我",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好像不小心睡著了……",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "明明將軍在身邊，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n竟然如此大意，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這是身為家臣",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不該有的行為是也……",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
