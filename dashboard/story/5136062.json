[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "蘭德索爾就和平常一樣熱鬧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n怜與志那都一邊欣賞這樣的街景一邊漫步著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……確實，",
    "voice": "vo_adv_5136062_000",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "風景和我熟知的蘭德索爾十分相似。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "建築物以及居民的氛圍",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "也沒有什麼太大的不同。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那真是太好了。",
    "voice": "vo_adv_5136062_001",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n雖說是異世界，但要是熟悉環境的話，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "多少能夠放鬆吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "哎呀，怜！",
    "voice": "vo_adv_5136062_002",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "來的正好啊。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳前陣子委託的藥草，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我找到了不錯的門路哦。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真的嗎！",
    "voice": "vo_adv_5136062_003",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我想知道詳細的情況。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "志那都不好意思，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我去那邊稍微聊一下。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……放鬆，",
    "voice": "vo_adv_5136062_004",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "雖然我也很想那麼做……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "但是人…………",
    "voice": "vo_adv_5136062_005",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "好多啊……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……說老實話，",
    "voice": "vo_adv_5136062_006",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "在與其他人交流這方面，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "怜似乎做得比我好。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n像那樣與城裡的居民親切交談這種事，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "對我來說",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "實在是……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……唉……",
    "voice": "vo_adv_5136062_007",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "怜大人──！！",
    "voice": "vo_adv_5136062_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "唔！？",
    "voice": "vo_adv_5136062_009",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n什……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "什麼人？",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是我啊，",
    "voice": "vo_adv_5136062_010",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我是紡希！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "竟然能恰巧遇見怜大人，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這是多麼幸福的一天啊！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "不是，",
    "voice": "vo_adv_5136062_011",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "等一下……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "不、",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "能請妳先放開我嗎？",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怪了？",
    "voice": "vo_adv_5136062_012",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n今天的怜大人",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "氣質和以往很不一樣呢。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n而且還穿著我沒見過的衣服和裝備。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是想大膽地改變形象嗎？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "不……",
    "voice": "vo_adv_5136062_013",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "不是。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我不是怜──",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "紡希，",
    "voice": "vo_adv_5136062_014",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳在做什麼啊。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我在這裡哦。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦！？",
    "voice": "vo_adv_5136062_015",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那、",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那邊也有怜大人！？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那這個人是誰啊？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "她叫志那都，",
    "voice": "vo_adv_5136062_016",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是我的……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "遠房親戚。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n聽說她是第一次來到蘭德索爾，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "所以和紡希是初次見面呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怜大人的親戚！？",
    "voice": "vo_adv_5136062_017",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "是嗎，",
    "voice": "vo_adv_5136062_018",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "原來可以這樣蒙混過去……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "有一套啊，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "怜……！　",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "抱歉，",
    "voice": "vo_adv_5136062_019",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嚇到妳了！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "話說回來……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "哼嗯哼嗯，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "原來如此原來如此……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "怎……",
    "voice": "vo_adv_5136062_020",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n是",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "有什麼奇怪之處嗎……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……應該是有吧……",
    "voice": "vo_adv_5136062_021",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "唉……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "陷入沮喪了！？",
    "voice": "vo_adv_5136062_022",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n像翻書一樣快！　",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不，",
    "voice": "vo_adv_5136062_023",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是沒有什麼奇怪的地方……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n不過我對志那都的衣服有點好奇。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我可以摸看看嗎？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "可以吧？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "咦，",
    "voice": "vo_adv_5136062_024",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "啊……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n可、",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "可以是可以……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "不過看了也沒什麼有趣的吧？",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怎麼會，妳不必謙虛！",
    "voice": "vo_adv_5136062_025",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "在乍看大膽的設計中，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "蘊含著穩健的格調……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n讓人感到有種",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "難以親近的強韌，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n同時卻又引人注目的美麗哦。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我可以斷言……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這件衣服是好貨！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "當然不只是衣服而已。",
    "voice": "vo_adv_5136062_026",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "志那都本人是美女，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n加上身材又好，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "加乘之下使得魅力更上一層樓。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "做為新服裝的",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n設計參考，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "請允許我更仔細地好好觀察……！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "美、",
    "voice": "vo_adv_5136062_027",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "美女……？",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "身材好……？",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n這……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這是在形容我嗎？",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊───",
    "voice": "vo_adv_5136062_028",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "紡希不好意思，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "能請妳先停下來嗎。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n志那都她有點困擾呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "抱、",
    "voice": "vo_adv_5136062_029",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "抱歉！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我可不是移情別戀，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我心目中的第一名還是怜大人，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n只是志那都的美麗也不輸給妳而已哦！？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼，",
    "voice": "vo_adv_5136062_030",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們差不多該走了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "紡希也多多保重。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "好的，",
    "voice": "vo_adv_5136062_031",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怜大人！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n新衣服製作完成後我會再拿去給妳的！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怜大人的親戚啊……",
    "voice": "vo_adv_5136062_032",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過她們長得真的好像喔。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n簡直就和怜大人本人一模一樣……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嗯……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是我的錯覺吧。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……她就是紡希嗎。",
    "voice": "vo_adv_5136062_033",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "想不到",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "居然會這麼地強勢……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是妳第一次見到她嗎？",
    "voice": "vo_adv_5136062_034",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我還以為在志那都的世界裡",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也有紡希存在呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……有是有。",
    "voice": "vo_adv_5136062_035",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我沒有直接見過她。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n畢竟離開索爾之塔的機會",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "並不多。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣啊。",
    "voice": "vo_adv_5136062_036",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過就如妳所見，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "她總是那個樣子呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……我……",
    "voice": "vo_adv_5136062_037",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "其實不太擅長與人交流……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n尤其",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "是面對那種會很積極地靠過來",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "的人……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……呵呵。",
    "voice": "vo_adv_5136062_038",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……怎麼了？",
    "voice": "vo_adv_5136062_039",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n發生什麼有趣的事了嗎？",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒事，",
    "voice": "vo_adv_5136062_040",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "只是我沒想到志那都居然會那麼慌張。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看到有點令人意外的一面，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "該怎麼說呢，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "感覺滿開心的。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……是這樣嗎。",
    "voice": "vo_adv_5136062_041",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "與人相處這種事",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "果然很難懂啊……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "對於認真思索的志那都，怜面帶微笑，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n用溫暖的眼神關注著她……",
    "voice": null,
    "unit_id": null
  }
]
