    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n……就只是夢想的",
    "voice": null,
    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "泡沫……",
    "voice": null,
    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "只是哪個誰",
    "voice": null,
    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "所混和而成的……",
    "voice": null,
    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n混濁的",
    "voice": null,
    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "泡泡",
    "voice": null,
    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "而已",
