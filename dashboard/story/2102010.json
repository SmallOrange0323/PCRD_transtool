    "unit_id": 105911
  },
  {
    "type": "background",
    "bg_id": "500017"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……主人。",
    "voice": "vo_adv_2102010_034",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下是",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人的嚮導。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是守護主人，",
