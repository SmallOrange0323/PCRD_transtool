    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "在未來的路上……我還想要繼續與望和紡希一起前進。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "太好了─。我心裡超緊張的，要是你說我受夠了該怎麼辦……",
    "voice": "vo_adv_3010003_078",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……千歌妳剛剛叫我小望吧！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊，太奸詐了！",
    "voice": "vo_adv_3010003_079",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這樣的話，妳也要叫我紡希！",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咦？好、好的……",
    "voice": "vo_adv_3010003_080",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "紡希……？",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是的！",
    "voice": "vo_adv_3010003_081",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "以後叫我的時候請都不要再加稱呼囉！",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "奇怪了，紡希叫我們的時候，",
    "voice": "vo_adv_3010003_082",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "都有加上姐呀？",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "因為我的年紀比妳們小所以沒關係！",
    "voice": "vo_adv_3010003_083",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "比起這件事，妳們兩人有聽到嗎？",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n有聽到大家的聲音嗎？",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "粉絲們",
    "words": "安可！",
    "voice": "vo_adv_3010003_084",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "粉絲們",
    "words": "\\n安可！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……粉絲們正等著我們呢。",
    "voice": "vo_adv_3010003_085",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌！紡希！妳們準備好了嗎？",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "準備好了！",
    "voice": "vo_adv_3010003_086",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n讓我們唱出更多的歌吧！",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "當然準備好囉。",
    "voice": "vo_adv_3010003_087",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "讓我們把演唱會炒得更熱烈吧。",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "大家─！辛苦了─！",
    "voice": "vo_adv_3010003_088",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n這場演唱會我們打算重新來過，",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "大家跟得上嗎─？",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "粉絲們",
    "words": "嗚喔喔喔喔喔喔喔喔！！！",
    "voice": "vo_adv_3010003_089",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "粉絲們",
    "words": "！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "慈樂之音……登台！！",
    "voice": "vo_adv_3010003_090",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雖然遇到了一些麻煩，\\n但是慈樂之音的第一次演唱會以大成功作收，\\n他們的名聲也立刻傳遍了大陸──",
    "voice": null,
    "unit_id": null
  }
]
