    "name": "望",
    "words": "非常感謝大家來到我們的演唱會！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n比太陽還要耀眼的笑容！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我是大家的偶像，",
