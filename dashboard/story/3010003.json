    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……話說回來，",
    "voice": "vo_adv_3010003_008",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "結果連我也要上台表演嗎？",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "當然囉！",
    "voice": "vo_adv_3010003_009",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要是妳真的討厭的話，也可以待在後台啦……",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……妳不想讓他欣賞一下，妳穿上那套衣服跳舞的樣子嗎？",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳、妳在說什麼……！？",
    "voice": "vo_adv_3010003_010",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n……",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "既然都走到這一步了，上台就上台吧！",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "特地做好的服裝如果沒有秀出來的話，就太可惜了對吧？",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呵呵，太棒了！",
    "voice": "vo_adv_3010003_011",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……那我們就要去享受出道演唱會囉─！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n慈樂之音……",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "登台表演！",
