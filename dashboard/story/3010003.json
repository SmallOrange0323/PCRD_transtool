  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}，",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "營運的部分也麻煩你幫忙囉！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "有{0}在的話，心裡就踏實多了。",
    "voice": "vo_adv_3010003_001",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請多指教了。",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生，真的沒有問題嗎？",
    "voice": "vo_adv_3010003_002",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n如果不行的話請你直接說也沒有關係呦？",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我、我才沒有指望你幫什麼忙呢。",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我、",
    "voice": "vo_adv_3010003_003",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我才沒有擔心騎士先生呢！",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我只是不想要讓演唱會中止而已……",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "紡希超溫柔的對吧─！",
    "voice": "vo_adv_3010003_004",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然一直說不上場不上場，",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n不過還是牢牢記住舞步了！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我才沒有那個意思……！",
    "voice": "vo_adv_3010003_005",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好啦好啦，你們看！",
    "voice": "vo_adv_3010003_006",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n舞台前有好多好多客人呢！",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們要趕快開始演唱會了！",
