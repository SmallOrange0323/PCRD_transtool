  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "厄莉絲和{0}攜手合作，在塔的內部不斷前進，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n終於抵達塔的最上層……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這裡，",
    "voice": "vo_adv_7030002_000",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就是最上層……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n在這個世界中不斷拒絕所有人，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "未知的領域。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "作為隱藏程式的地點，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "應該是最合適──",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "那裡，",
    "voice": "vo_adv_7030002_001",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "有人在……？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是誰？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n現出真面目來。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………歡迎妳來，",
    "voice": "vo_adv_7030002_002",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "厄莉絲。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "又是騎士先生。",
    "voice": "vo_adv_7030002_003",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "也是塔的Bug嗎。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "或者是，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "新的幻影……？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "喲，",
    "voice": "vo_adv_7030002_004",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "「我」。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "真虧你能來到這裡啊。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "我不是其他人，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "就是你自身。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "你可能不曉得，",
    "voice": "vo_adv_7030002_005",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n我一直在等待著你的到來。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n我，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "一直很想見你……",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……跟途中見到的，",
    "voice": "vo_adv_7030002_006",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "由記憶重現的幻影不同。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n看起來比剛剛的騎士先生們，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "更像本尊。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "眼神很銳利……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "沒錯。",
    "voice": "vo_adv_7030002_007",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "而且，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "我的願望終於實現了。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "謝謝你把她帶來，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "「我」。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "很簡單。",
    "voice": "vo_adv_7030002_008",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "來，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "厄莉絲……",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "跟我一起走吧。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "咦……",
    "voice": "vo_adv_7030002_009",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "什、",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "什麼意思？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n一起，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "去哪裡……？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "我一直在等待著妳的到來。",
    "voice": "vo_adv_7030002_010",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "就只等著妳。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "所以我今後，",
    "voice": "vo_adv_7030002_011",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "會一直在厄莉絲身邊的。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n來，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "到我這裡──",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎、",
    "voice": "vo_adv_7030002_012",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生……！？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n怎麼辦，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "有兩個騎士先生，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "正在爭奪我……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不對，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "現在不是心跳加速的時候。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "可是……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "請你別來妨礙我。",
    "voice": "vo_adv_7030002_013",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n跟我在一起，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "對厄莉絲來說才是最幸福的。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n你就退出吧。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "我的話，",
    "voice": "vo_adv_7030002_014",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "能實現厄莉絲的願望。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n畢竟厄莉絲想要的一切，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "都在這座塔裡。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我、",
    "voice": "vo_adv_7030002_015",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我想要的……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "在這座塔裡……？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n這是什麼意思……？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "厄莉絲妳……",
    "voice": "vo_adv_7030002_016",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "一直都在看著對吧。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n看著為了其他人努力的",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "「我」。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "並且，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "希望在那裡的人",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "是自己……",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "我絕不會讓妳有這種寂寞的感受。",
    "voice": "vo_adv_7030002_017",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "過去對其他人做過的事，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n今後全部",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "都只對厄莉絲做……",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "我們可以一起修行、",
    "voice": "vo_adv_7030002_018",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "去冒險、",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n用餐、",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "悠哉放鬆……",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n一直在一起。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "啊啊，",
    "voice": "vo_adv_7030002_019",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "他朝我伸出了手。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n注視我的",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "溫柔笑容",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "和甜言蜜語。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……是的，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我知道。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "一直都渴望著──",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這樣的情景。",
    "voice": "vo_adv_7030002_020",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "要是連那些朝向其他女孩",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "的眼神、笑臉和日常對話，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "都可以只屬於我",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "的話。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………",
    "voice": "vo_adv_7030002_021",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n這些，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "好嗎？",
    "voice": "vo_adv_7030002_022",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "來，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "快過來這裡──",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………",
    "voice": "vo_adv_7030002_023",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "啊啊……",
    "voice": "vo_adv_7030002_024",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n這座塔是──",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這座露娜之塔，",
    "voice": "vo_adv_7030002_025",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n是跟我合為一體的米奈娃，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n利用醒過來的短暫時間所建造。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "為了向騎士先生他們展示「現實」的光景，",
    "voice": "vo_adv_7030002_026",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n然後",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "結束「禁錮」。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "在頂端等待的「他」會盯上我……",
    "voice": "vo_adv_7030002_027",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n是因為這是為了將我跟米奈娃分離開來，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "所準備的功能嗎……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "………………對不起。",
    "voice": "vo_adv_7030002_028",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不會去。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你不是真正的騎士先生。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "妳怎麼會這麼想？",
    "voice": "vo_adv_7030002_029",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n妳心裡，",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "一直期望著這些。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n明明我",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "可以為妳實現。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "因為，",
    "voice": "vo_adv_7030002_030",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "會看著我。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不是別人，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "而是我……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "他會專心注視著我。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你給我的，",
    "voice": "vo_adv_7030002_031",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就只是重複過去的回憶。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n用對其他人做的事情，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "來實現我的願望……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "如果是真正的騎士先生，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "絕對不會這樣想。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "因為我",
    "voice": "vo_adv_7030002_032",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "喜歡的騎士先生，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就是這樣的人。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "那真是",
    "voice": "vo_adv_7030002_033",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "遺憾。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "我還以為能跟妳在一起。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "既然如此，",
    "voice": "vo_adv_7030002_034",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "我不會再讓你們離開這座塔。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "騎士先生？",
    "words": "\\n得讓你們一直待在塔裡才行。",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……不論是Bug，",
    "voice": "vo_adv_7030002_035",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "還是幻影，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "要對有著騎士先生樣貌的存在出手，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "讓我感到很抱歉。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但是還請你，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "原諒我──",
    "voice": null,
    "unit_id": 129011
  }
]
