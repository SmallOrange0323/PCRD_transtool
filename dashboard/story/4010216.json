    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是不是太拐彎抹角了？　",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "生日禮物這麼奢侈的事，",
    "voice": "vo_adv_4010216_013",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我是不指望啦，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但至少",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "希望他能說聲生日快樂、",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這樣──",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
