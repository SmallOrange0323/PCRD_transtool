  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵，",
    "voice": "vo_adv_4010216_000",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好漂亮的庭園。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n空氣也很清新，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好舒服……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯，",
    "voice": "vo_adv_4010216_001",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "也不太會咳了，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "沒問題。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n畢竟你難得邀請我，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我可不能讓你看到沒精神的樣子。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……在生日，",
    "voice": "vo_adv_4010216_002",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你像這樣邀請我出門，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我、非常開心。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "以往大多是在",
    "voice": "vo_adv_4010216_003",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "病房，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "由大姐姐們為我慶祝。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那樣當然也很開心……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "卻也感受到，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "每年會不會就這樣",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "一成",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不變的不安。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "今天",
    "voice": "vo_adv_4010216_004",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "很謝謝你。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我會",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "盡情享受的……♪",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊……",
    "voice": "vo_adv_4010216_005",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好的。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n那就……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "麻煩你了。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "強而有力，",
    "voice": "vo_adv_4010216_006",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "引導著我的手掌。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "男人的護送……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我在",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "戀愛小說中",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "看過好幾次這樣的情境……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "原來是這種",
    "voice": "vo_adv_4010216_007",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "感覺啊……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是，",
    "voice": "vo_adv_4010216_008",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "謝謝你……！",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "今天",
    "voice": "vo_adv_4010216_009",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是我的生日。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "如果你願意",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "再實現我一個",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "任性的願望──",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "請你今天一整天",
    "voice": "vo_adv_4010216_010",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "都別放開我的手……♪　",
    "voice": null,
    "unit_id": 103831
  },
