    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "裝作不經意地",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n傳達生日就是今天……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在學長的學生手冊日曆裡",
    "voice": "vo_adv_4010216_012",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "悄悄畫個小紅花，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n在鞋櫃藏入暗號文，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在學長看的推理小說",
    "voice": null,
    "unit_id": 101431
  },
