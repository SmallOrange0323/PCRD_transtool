    "type": "dialogue",
    "name": "霞",
    "words": "學長！",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n呃……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "詳情是怎麼樣？",
    "voice": null,
    "unit_id": 101431
  },
