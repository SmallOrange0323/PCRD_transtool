    "voice": "vo_adv_4010216_014",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "學學、",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "學長！？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n跑到我的教室來，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是怎麼了嗎……！",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "事件……？",
