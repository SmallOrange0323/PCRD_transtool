  {
    "type": "dialogue",
    "name": "霞",
    "words": "今天是我的生日……",
    "voice": "vo_adv_4010216_011",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "學長",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "會記得嗎……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然這幾天，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我是有在與跟學長的日常對話中",
