    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "眼神是怎麼一回事！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n所以你不相信對吧！？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼",
    "voice": "vo_adv_1036009_012",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你明天也過來這裡！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我會把透過身體檢查",
