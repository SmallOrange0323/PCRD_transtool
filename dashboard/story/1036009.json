    "words": "我們去野餐呢！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊嗚……！",
    "voice": "vo_adv_1036009_019",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你有好好記得啊……",
