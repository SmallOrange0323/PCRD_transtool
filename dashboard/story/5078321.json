  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "現在要是遭受攻擊恐怕不妙……！",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "騎士大人！",
    "voice": "vo_adv_5078321_004",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n我們現在能夠做的，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "就只有替大家加油了！",
