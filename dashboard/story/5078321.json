    "name": "摩拉",
    "words": "但是我想",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "這份心意，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "一定能驅散籠罩大家的黑暗吧……！",
