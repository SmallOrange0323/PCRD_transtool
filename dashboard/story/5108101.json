  {
    "type": "dialogue",
    "name": "旁白",
    "words": "和平的日子日復一日，在某個年末時節，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n大江戶町裡一間人聲鼎沸的溫泉旅館裡──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_5108101_000",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是客人嗎？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "歡迎，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "感謝您的蒞臨。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯、嗯，",
    "voice": "vo_adv_5108101_001",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "看來您舟車勞頓累了吧。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是想先用餐呢？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "還",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "說",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "您……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵，",
    "voice": "vo_adv_5108101_002",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "果然……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是想要先那個，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "對吧？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你也很愛此道呢～♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "下回，",
    "voice": "vo_adv_5108101_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "「煙霧繚繞忘年奇譚　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "為旭日初升舉杯」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501880"
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "溫泉真的很不錯呢。",
    "voice": "vo_adv_5108101_004",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n呵呵呵，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "感覺都變年輕了……♪",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_5108101_005",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "深月妳還很年輕的呀。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "妳看，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "妳的膚質這麼好……♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "喂～",
    "voice": "vo_adv_5108101_006",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "深月、",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "美里。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "要發送姐妹淘親密話題這種福利是沒關係，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n但也要好好招攬客人喔♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "嗯，",
    "voice": "vo_adv_5108101_007",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是啊。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵，",
    "voice": "vo_adv_5108101_008",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那麼……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "預備～♪",
    "voice": "vo_adv_5108101_009",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "大江戶町歷史悠久的",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "老字號溫泉旅館",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "「陽卵旅館」──",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "敬邀您",
    "voice": "vo_adv_5108101_010",
    "unit_id": 124511
  },
  {
