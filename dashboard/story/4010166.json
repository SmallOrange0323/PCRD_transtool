  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥，",
    "voice": "vo_adv_4010166_000",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "歡迎回來。",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n一直努力工作辛苦你了～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "要先洗澡？",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "先吃飯？",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "還是",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "吃蛋糕？",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嘿嘿，",
    "voice": "vo_adv_4010166_001",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "因為今天是美美的生日，",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美就去街角的蛋糕店",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "買了蛋糕和蠟燭♪",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美一直在等",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥回來喔！",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗯♪",
    "voice": "vo_adv_4010166_002",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "插好蠟燭～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "點火……",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "預～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "備，",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "呼～～～！",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "謝謝你，",
    "voice": "vo_adv_4010166_003",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥！",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美長大一歲了，",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n是不是又離哥哥更近了呢？",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "等美美再長大一點，",
    "voice": "vo_adv_4010166_004",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "希望有一天，",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n可以跟哥哥一起吃不是扮家家酒的蛋糕！",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美想要有很大的草莓，",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "上面放著巧克力做的熊熊裝飾的那種～♪",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇，",
    "voice": "vo_adv_4010166_005",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這個大盒子難道是",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "蛋糕？",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "好厲害好厲害♪",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n還有巧克力做的兔子～！",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "謝謝你，",
    "voice": "vo_adv_4010166_006",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥！",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "那麼，",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "從哥哥回來的時候開始，",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n再來一次扮家家酒！",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "生日真開心♪",
    "voice": "vo_adv_4010166_007",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "扮家家酒也很好玩。",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美，",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "最～喜歡",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥了♪",
    "voice": null,
    "unit_id": 102031
  }
]
