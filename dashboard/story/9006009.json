  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天，{0}的mimi收到了特別的訊息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "mimi",
    "words": "今天是你開始玩阿斯特朗傳奇值得紀念的日子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510120"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "看完這則通知後的{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n帶著懷念的心情來到了公園。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "哦，少年。",
    "voice": "vo_adv_9006009_000",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n你果然到這裡來了呀。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你問我嗎？",
    "voice": "vo_adv_9006009_001",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "如你所見，我在工作呀。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "畢竟我這可是可麗餅店呢。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "開玩笑的。",
    "voice": "vo_adv_9006009_002",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "嗯，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我跟你一樣。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "突然有點想沉浸",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "在回憶裡。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你知道",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "今天是什麼日子吧？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "沒錯，",
    "voice": "vo_adv_9006009_003",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "是你第一次登入阿斯特朗傳奇的日子。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n而這裡是",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "你成為我的公主騎士的地方。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "哎呀，",
    "voice": "vo_adv_9006009_004",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不過還真懷念呢。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "感覺像是很久以前的事了。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "哦，",
    "voice": "vo_adv_9006009_005",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我給你的mimi你有好好地用呢。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "嗯嗯，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "很好很好。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "當時把那個mimi給你",
    "voice": "vo_adv_9006009_006",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "的時候，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n我都覺得自己好像有點",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "太強硬了呢。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我給你添了不少麻煩吧……",
    "voice": "vo_adv_9006009_007",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "也把你捲進了不小的麻煩事裡，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n你該不會",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "很痛恨",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我吧？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "……真的嗎？",
    "voice": "vo_adv_9006009_008",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n就沒有一點點埋怨我？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "樂在其中……",
    "voice": "vo_adv_9006009_009",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "嗎。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "哈哈哈，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "真有你的。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "作為阿斯特朗傳奇的製作人之一，",
    "voice": "vo_adv_9006009_010",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n能聽見你這麼說就是最棒的報酬了。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那以後",
    "voice": "vo_adv_9006009_011",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "也請盡情享受吧。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "說笑的啦。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "嗯？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "怎麼了，少年。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "怎麼會，",
    "voice": "vo_adv_9006009_012",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我怎麼可能那麼想呀。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "正因為是你，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我才能放心託付給你的。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我的公主騎士就是你，",
    "voice": "vo_adv_9006009_013",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "非你不可。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "希望你能相信這一點。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "好，",
    "voice": "vo_adv_9006009_014",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "接下來。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n你難得來這麼一趟，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我給你一個獎勵吧。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那麼，",
    "voice": "vo_adv_9006009_015",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我親手烤的可麗餅怎麼樣？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "別擔心啦，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我會很用心地烤的。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "還有……",
    "voice": "vo_adv_9006009_016",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "雖然今天",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "的確是紀念日，",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "但這可還不是終點哦？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n要鬆懈是不是太早了呀？",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "因為你的冒險",
    "voice": "vo_adv_9006009_017",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "還會繼續下去。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n你可要盡情享受啊。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "就是這樣，",
    "voice": "vo_adv_9006009_018",
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那就拜託你囉。",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我的",
    "voice": null,
    "unit_id": 106832
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "公主騎士♪",
    "voice": null,
    "unit_id": 106832
  }
]
