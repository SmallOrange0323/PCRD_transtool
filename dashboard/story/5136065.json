  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "日和與埃拉兩人來到了某間餐廳。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這裡就是有提供赤麥酒的店家嗎～",
    "voice": "vo_adv_5136065_000",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "哎呀──",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "能找到真是太好了！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n這都要歸功於日和幫忙打聽哦♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_5136065_001",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不用客氣！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "話說回來",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這間店的氣氛很不錯呢。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "美味的香氣從四面八方飄了過來～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就是說啊～",
    "voice": "vo_adv_5136065_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n而且啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這間店的魅力可不只是如此喔～♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗨～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我來打擾了～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "高品質，",
    "voice": "vo_adv_5136065_003",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "而且溫度控管也很完美！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這裡在蘭德索爾也是屈指可數，",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "有著美味麥酒的店家哦！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "突然出現的妳是誰啊！？",
    "voice": "vo_adv_5136065_004",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊哈哈，",
    "voice": "vo_adv_5136065_005",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "優花梨小姐……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳今天也從中午就在喝酒了啊～",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我今天啊，",
    "voice": "vo_adv_5136065_006",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "沒",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "有當班！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "沒有當班的意思～",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就是休息的日子～",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n不過呢，",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我還有暢飲美味麥酒",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這項重要的工作～",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "唔嘿嘿嘿嘿～♪",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……咦？",
    "voice": "vo_adv_5136065_007",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n難道是優花梨小姐嗎？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n【墨丘利財團】的那位？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是她沒錯哦。",
    "voice": "vo_adv_5136065_008",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n妳為什麼會這麼驚訝呀？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不是，",
    "voice": "vo_adv_5136065_009",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "因為……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n在我的世界裡，優花梨小姐",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "是個非～常",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嚴厲的人。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "她可是被人稱作「金庫守衛優花梨」、",
    "voice": "vo_adv_5136065_010",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "「厲鬼會計負責人」哦？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n任何時候都沉著冷靜！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n哪怕是一滴麥酒都不會去喝的那種人！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這就是優花梨小姐！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這、",
    "voice": "vo_adv_5136065_011",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "和這個世界的優花梨小姐完全相反呢……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "原來世界不同，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也會有這種情況啊……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "嗯唔～？",
    "voice": "vo_adv_5136065_012",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我說我說，妳們在聊啥～？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n不准丟下姐姐我卻自己打得火熱～！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊、",
    "voice": "vo_adv_5136065_013",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "抱歉抱歉！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "難得有這個機會，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "就一起喝酒吧！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n能夠透過喝麥酒與厲鬼金庫守衛暢聊，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "是個珍貴的體驗呢♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "來了，",
    "voice": "vo_adv_5136065_014",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "抱歉在幾位聊得開心的時候打擾了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n赤麥酒送來啦！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我等好久啦──！",
    "voice": "vo_adv_5136065_015",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "小姐很內行哦。",
    "voice": "vo_adv_5136065_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n這種酒在蘭德索爾",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "還沒有什麼人知道呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦！？",
    "voice": "vo_adv_5136065_017",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "赤……",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "麥、",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "酒……？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "等",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "、",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "等一下！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "之前有那種東西嗎？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這原本",
    "voice": "vo_adv_5136065_018",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是在特定地區才喝得到的麥酒。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n也就是",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "俗稱的地區麥酒。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "最近才剛流通",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "到蘭德索爾這裡。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不、",
    "voice": "vo_adv_5136065_019",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不是吧──？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我都沒有發現……",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n畢竟我來這裡時，",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "每次",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "都是點「老樣子」……！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "可是，",
    "voice": "vo_adv_5136065_020",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "既然被我知道……",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就沒有人可以阻止我！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "嘿，",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "老闆，",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我也要點一樣的酒！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "要特大杯！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "嘿嘿，",
    "voice": "vo_adv_5136065_021",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "好喔～～！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "埃拉、優花梨",
    "words": "乾杯！！",
    "voice": "vo_adv_5136065_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咕嘟咕嘟……",
    "voice": "vo_adv_5136065_023",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "噗哈～～！！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n哎呀真是的，",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這酒好喝耶！！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "酸味算是比較強，",
    "voice": "vo_adv_5136065_024",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "然而喝起來並不膩口……",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "反倒感覺很棒！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n不只是順口，",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "還有著紮實的後味……",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "能感受到",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "大地的恩惠！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "對吧對吧～！",
    "voice": "vo_adv_5136065_025",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n一開始雖然只會覺得",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "味道好像有一點獨特啊～？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "但是繼續喝下去就會讓人上癮呢～♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊──不行，",
    "voice": "vo_adv_5136065_026",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這樣連下酒菜也不能停了呢～",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n盡情點餐吧！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "日和也別客氣，",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "點妳想吃的東西吧。",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "對啊對啊！",
    "voice": "vo_adv_5136065_027",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n日和想吃什麼？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "肉類嗎？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "魚肉感覺也很美味！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "店",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "員──",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我要加點！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哇哇，",
    "voice": "vo_adv_5136065_028",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我會自己點的，先等一下啦～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對了，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳們兩位",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可別喝過頭了喔？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈哈！",
    "voice": "vo_adv_5136065_029",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n沒事沒事♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……大概吧。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這句話讓人很不安耶！",
    "voice": "vo_adv_5136065_030",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不必擔心～",
    "voice": "vo_adv_5136065_031",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n姐姐們不會有問題的！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n因為我們",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是姐姐嘛～？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "優花梨小姐，",
    "voice": "vo_adv_5136065_032",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這句話說的好！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n因為是姐姐所以沒問題的♪",
