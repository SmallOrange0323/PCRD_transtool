[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}被鈴奈叫了出來――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，秀才！ ",
    "voice": "vo_adv_1016003_000",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈嚕！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "非常準時。",
    "voice": "vo_adv_1016003_001",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n不愧是秀才！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼就走吧。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "呃？你問說要去哪裡……？",
    "voice": "vo_adv_1016003_002",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？人家沒有說明嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "今天希望你陪人家去買東西喔。",
    "voice": "vo_adv_1016003_003",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為下次有時裝秀，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家想說先來做些準備。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雖然人家自己決定也可以，",
    "voice": "vo_adv_1016003_004",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但參考別人的意見還是很重要的吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以想要秀才給點建議喔。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為人家覺得秀才很可靠！",
    "voice": "vo_adv_1016003_005",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼就朝商店出～發！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "抵達！",
    "voice": "vo_adv_1016003_006",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這間是人家常來的香水店喔～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "呃？你問為什麼是香水？",
    "voice": "vo_adv_1016003_007",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為是時裝秀，所以你以為人家要買的是衣服？",
    "voice": "vo_adv_1016003_008",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才什麼都不懂呢～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為用香水能提高興致，",
    "voice": "vo_adv_1016003_009",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n也能更加突顯出人家和人家穿的衣服。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就是這樣，麻煩你提出意見～",
    "voice": "vo_adv_1016003_010",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "什麼？對香水不熟悉……？",
    "voice": "vo_adv_1016003_011",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "沒關係，沒關係。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那方面就憑感覺囉？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這裡的香水可以試用喔。",
    "voice": "vo_adv_1016003_012",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家會先試用一點看看，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才只要說出自己的感想就可以了。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，可是香水的味道",
    "voice": "vo_adv_1016003_013",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "也有各種不同的效果喔～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這個嘛，比如說……",
    "voice": "vo_adv_1016003_014",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……有了！這個這個。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "用這種柑橘系列的香水，有使人恢復活力的效果喔～",
    "voice": "vo_adv_1016003_015",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "除此之外！聽說還有瘦身的效果呢！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n很厲害對吧～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "如何？",
    "voice": "vo_adv_1016003_016",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家有變瘦嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……不可能那麼快就能瘦下來？",
    "voice": "vo_adv_1016003_017",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，那麼這個……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "如何如何？",
    "voice": "vo_adv_1016003_018",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n聽說噴了這個香水後，就會散發出清純的感覺！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你看！你看！",
    "voice": "vo_adv_1016003_019",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家有變清純嗎！？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……沒有變得清純的感覺？",
    "voice": "vo_adv_1016003_020",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗚～是這樣子的嗎～？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，對了！",
    "voice": "vo_adv_1016003_021",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那就噴這款珍藏香水！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "如何？",
    "voice": "vo_adv_1016003_022",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n有沒有感覺人家變得不一樣了？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "怎麼會？",
    "voice": "vo_adv_1016003_023",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你不覺得人家看起來更有魅力嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，你在敷衍人家對吧？",
    "voice": "vo_adv_1016003_024",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好奇怪？",
    "voice": "vo_adv_1016003_025",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n這明明寫說是會讓男人神魂顛倒的香氣？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才太遲鈍了～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家還想說如果噴了這個香水，",
    "voice": "vo_adv_1016003_026",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n就能讓秀才對人家神魂顛倒呢……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "算了，香水的效果無所謂了。",
    "voice": "vo_adv_1016003_027",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "總之，先試試看各種香水，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才如果有喜歡的味道再告訴人家。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雖然嘗試了各種香水，",
    "voice": "vo_adv_1016003_028",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n但都還沒什麼Fu～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼，接著……來試試看這個吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯！？這個香氣是……",
    "voice": "vo_adv_1016003_029",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，你覺得這個如何？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就是說嘛！",
    "voice": "vo_adv_1016003_030",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n感覺跟人家的形象相當搭配！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才也這麼認為！？",
    "voice": "vo_adv_1016003_031",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家好像也超喜歡這個香氣～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "竟然想著同一件事情，",
    "voice": "vo_adv_1016003_032",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n我們這不是意氣超相合嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼，",
    "voice": "vo_adv_1016003_033",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "今天要買的香水，就決定是它了！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦！？",
    "voice": "vo_adv_1016003_034",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才，你臉色很難看喔？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "熏暈了！？被香水的香氣！？",
    "voice": "vo_adv_1016003_035",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這下不妙了！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n趕快到外面去！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "background",
    "bg_id": "500031"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，沒事吧？",
    "voice": "vo_adv_1016003_036",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n香水的味道，如果不習慣就會覺得不舒服呢～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "總之，不買香水了，",
    "voice": "vo_adv_1016003_037",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n要不要到那邊的咖啡廳喝杯茶？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
