    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "成為一輩子的回憶。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "既然是一輩子的回憶，",
