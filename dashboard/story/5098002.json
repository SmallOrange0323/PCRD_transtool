    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n妳們覺得好吃，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我也很開心。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n下次再來喔♪",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "好～！",
