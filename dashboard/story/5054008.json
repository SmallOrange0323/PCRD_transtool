[
  {
    "type": "background",
    "bg_id": "500876"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "望眼環視變得一團糟的派對會場後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n秋乃與咲戀大大地嘆了口氣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀、秋乃",
    "words": "……唉。",
    "voice": "vo_adv_5054008_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沒想到雪人會爆炸，",
    "voice": "vo_adv_5054008_001",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n把聖誕樹都給燒掉了……",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "魔法玫瑰全～部都被燒光了吧。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是啊，",
    "voice": "vo_adv_5054008_002",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "當然那也是顆很寶貴的聖誕樹，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n但對大家而言，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "更是共同培育愛的重要回憶……",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n也有人因此感到很沮喪呢。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就算是我這個超超有錢人，",
    "voice": "vo_adv_5054008_003",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "也沒辦法把燒成",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "焦黑的玫瑰復原，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n只有這件事……",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是任誰",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "都無可奈何呢。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過，",
    "voice": "vo_adv_5054008_004",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "並不是只有壞消息！",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n妳想想，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "已經抓到那個賈斯頓了對吧？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但不曉得為什麼",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "他會變成全身焦黑……",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "嗯。",
    "voice": "vo_adv_5054008_005",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這是美冬和珠希她們告訴我的，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n聽說是有個巨大雪人的頭從天而降，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "正巧直接命中那個大盜。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n……那恐怕",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就是我們打倒的",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那個雪人的頭吧。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嘿～",
    "voice": "vo_adv_5054008_006",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還有這麼巧的事情呢。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不如說，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這算是近似奇蹟了？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "誰叫他想偷走別人的愛，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "大概是得到天罰了吧。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "唉，",
    "voice": "vo_adv_5054008_007",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "感覺好累人。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n差不多該準備回去了吧。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……這麼說來，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那傢伙跑哪裡去了？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "噢，",
    "voice": "vo_adv_5054008_008",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "他被薔薇假面叫走了。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "唉…………",
    "voice": "vo_adv_5054008_009",
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "啊啊，",
    "voice": "vo_adv_5054008_010",
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "灰姑娘男孩。",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "不好意思，突然找你過來。",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n我想清理被燒掉的聖誕樹，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n可以請你幫忙嗎？",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "真抱歉。",
    "voice": "vo_adv_5054008_011",
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n一看到這散落一地的魔法玫瑰，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n我就怎麼也提不起勁來……",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "……其實啊，",
    "voice": "vo_adv_5054008_012",
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n我認為，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "是這些魔法玫瑰，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n保護了各位不受",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "那個雪人爆炸的波及。",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "那個時候，",
    "voice": "vo_adv_5054008_013",
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "我確實看見了。",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n有道不可思議的光芒",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "籠罩了所有人……",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "我想那道光芒，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n一定就是各位彼此思慕的心意吧。",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "灰姑娘男孩……",
    "voice": "vo_adv_5054008_014",
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "我再次感謝你",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "能夠參加今天的派對。",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n背負蘭德索爾未來的年輕人們，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "讓我看見了",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n以愛互相連結，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "以愛勇敢面對，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "共同演出了這樣的奇蹟。",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "但是，",
    "voice": "vo_adv_5054008_015",
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "對大家來說，今天的回憶",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n就像這朵因為惡意而被燃燒殆盡的玫瑰一樣。",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "我想一定會",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "變成悲傷的記憶吧。",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "希望至少",
    "voice": "vo_adv_5054008_016",
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "能將發生奇蹟的瞬間，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n化為這些玫瑰",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "曾經美麗綻放的模樣，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "留在大家的記憶裡……",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "這也已經是無法實現的夢想了呢。",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "你說可以，",
    "voice": "vo_adv_5054008_017",
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "是什麼意思呢……？",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "……嗯嗯。",
    "voice": "vo_adv_5054008_018",
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "你所說的梗概",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "真是令人感興趣。",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n凡事有萬一，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "那奇蹟或許值得",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "讓人賭一把。",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "請把你的計畫全部告訴我。",
    "voice": "vo_adv_5054008_019",
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n有任何需要，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "我會準備好的。",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "各位！",
    "voice": "vo_adv_5054008_020",
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "在回去之前，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n能請你們聽我說幾句話嗎？",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "……",
    "voice": "vo_adv_5054008_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "咦？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "薔薇假面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "他是想要做什麼？",
    "voice": "vo_adv_5054008_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "各位，",
    "voice": "vo_adv_5054008_023",
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "這裡已經",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n沒有任何特別的設施，",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "也沒有任何特別的料理。",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
    "name": "薔薇假面",
    "words": "\\n",
    "voice": null,
    "unit_id": 6211
  },
  {
    "type": "dialogue",
