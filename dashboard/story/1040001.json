[
  {
    "type": "background",
    "bg_id": "500180"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "有一天，為了躲開強大的魔物，\\n{0}在精靈之森中迷路了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在他徬徨地找尋出口時，\\n不知從何處聽到少女的說話聲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呵呵，今天玩什麼好呢……",
    "voice": "vo_adv_1040001_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這個嘛……大家平常都在玩些什麼呢……",
    "voice": "vo_adv_1040001_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我是真的想不到……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "只收集沙朗牛排的肥油之類的遊戲嗎……？",
    "voice": "vo_adv_1040001_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，反正明天也要一起玩耍喔！",
    "voice": "vo_adv_1040001_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……",
    "voice": "vo_adv_1040001_004",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哇！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "咦……？你、你是活的……",
    "voice": "vo_adv_1040001_005",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你是人類嗎……？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "咦？啊，那個嘛，我在自言自語。",
    "voice": "vo_adv_1040001_006",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我剛才是在跟……這、這個練習用的鐵皮人偶說話……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n它叫「有我在喔好朋友1號」。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呃、",
    "voice": "vo_adv_1040001_007",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，我不是和人偶聊天的怪人，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我只是一時慌張，那個嘛，我、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我不是奇怪的人，奇、奇……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "騎著白馬的天才棋士――――！！！",
    "voice": "vo_adv_1040001_008",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然後{0}追了幾十公尺，\\n終於追到了少女。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呼、呼……",
    "voice": "vo_adv_1040001_009",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哈……呼……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哈……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不、不！我才不是奇怪的人……",
    "voice": "vo_adv_1040001_010",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我只不過是在跟人偶說話……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "所以其實我們都不是奇怪的人……？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "對、",
    "voice": "vo_adv_1040001_011",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "對不起……我剛才太過慌張了……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "原來你叫作{0}啊……",
    "voice": "vo_adv_1040001_012",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我叫碧……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n是住在這個森林的",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "精靈族。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦？只是因為不知道出口在哪裡，",
    "voice": "vo_adv_1040001_013",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n所以想問我而已嗎？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "原、原來是這樣啊……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n對不起，我還跑掉了……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我知道這個森林的出口在哪裡，",
    "voice": "vo_adv_1040001_014",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我幫你帶路吧！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊……",
    "voice": "vo_adv_1040001_015",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對不起……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我果然是太厚臉皮了……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "吧……？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我們又不是朋友，還說要和你一起去什麼的，",
    "voice": "vo_adv_1040001_016",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n真是厚臉皮的厚片女孩……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "雖然我住在這個森林裡，",
    "voice": "vo_adv_1040001_017",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n可以跟動物和植物交流……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但我連一個人類的朋友也沒有……",
    "voice": "vo_adv_1040001_018",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我一直、一直、一直都想要",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "有個朋友……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "產生這種想法之後，",
    "voice": "vo_adv_1040001_019",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我好幾年都對著自己做的",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "「有我在喔好朋友1號」說話……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但是話題很快就用完了……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "欸嘿嘿……因為交到朋友呢，",
    "voice": "vo_adv_1040001_020",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n是一件很了不起的事啊……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "像我這樣的人，肯定要再花個十年的時間。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但總有一天……總有一天我想要脫離邊緣人的生活！",
    "voice": "vo_adv_1040001_021",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這就是我微小的夢想……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，已經看得到出口了……",
    "voice": "vo_adv_1040001_022",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要跟你道別有種依依不捨的感覺呢。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好了，這裡就是出口了。辛苦了！",
    "voice": "vo_adv_1040001_023",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那麼，請你保重……",
    "voice": "vo_adv_1040001_024",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "希望你在未來十年內能想起我一次……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……咦？怎……怎麼了嗎？",
    "voice": "vo_adv_1040001_025",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好主意……？",
    "voice": "vo_adv_1040001_026",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那、那是什麼意思……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "喔……",
    "voice": "vo_adv_1040001_027",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n你失去記憶了啊……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "雖然你也沒有很多朋友……",
    "voice": "vo_adv_1040001_028",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n但因為你經常都會到人多的街上走動，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n所以問我要不要一起研究交朋友的方法……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "什麼，",
    "voice": "vo_adv_1040001_029",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "欸欸欸――――！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這、",
    "voice": "vo_adv_1040001_030",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這是真的嗎！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n你真的願意陪我做這種",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n有如精靈族榮譽獎",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "一樣棒的事情嗎！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "為了和你一起認識新朋友，",
    "voice": "vo_adv_1040001_031",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n而組成新的團隊！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哇――――！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "太棒了――――！",
    "voice": "vo_adv_1040001_032",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "BB團！BB團！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我們是",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "BB團！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個！我之後每天都會在這個森林裡",
    "voice": "vo_adv_1040001_033",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n等你來找我！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你有空再來就可以了……拜託！",
    "voice": "vo_adv_1040001_034",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "BB團的未來活動！就請你多多指教了！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哇！哇！超幸福的――――！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雖然這只是隨口說出的提議，但因為碧比想像中要來得開心，\\n所以使{0}感到有點困惑……",
    "voice": null,
    "unit_id": null
  }
]
