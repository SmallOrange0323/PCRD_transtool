[
  {
    "type": "background",
    "bg_id": "502110"
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "呼呼……",
    "voice": "vo_adv_9010002_000",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "嘿、",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "嘿、",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "嘿咻～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "真是的～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "不要讓文官做體力活啦皇女殿下～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "真是丟臉呀。",
    "voice": "vo_adv_9010002_001",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n雖為文官，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "一兩三個大木桶，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n連哼著歌搬運都做不到成何體統。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──在吉歐‧格黑納，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "以涅妃‧涅羅為中心",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n眾人聚在一起挑選賀禮。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "呼～",
    "voice": "vo_adv_9010002_002",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "不管是哪個世界，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "大家都很喜歡祭典這類的東西呢～？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "雖然很開心是好事～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "但預定要帶去的伴手禮的數量可不得了啊皇女殿下～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正是、",
    "voice": "vo_adv_9010002_003",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正是。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n若為祝賀結緣周年之宴席，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "贈與眾人的賀禮，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "份量加重亦乃理所當然。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "吉歐‧格黑納自豪的硬玉軟玉、",
    "voice": "vo_adv_9010002_004",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "金藝銀藝……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n宴席不可或缺的肉類料理及魚類料理，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "飲品也得都帶上。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……不，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "思量貪吃佩可公主等人旺盛的食慾，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "似是稍顯不足──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我回來了，",
    "voice": "vo_adv_9010002_005",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "涅妃‧涅羅小姐、",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "米亞小姐。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n我和安涅默涅小姐一起",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "收集了很多回來喔！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──皇女。",
    "voice": "vo_adv_9010002_006",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n妳委託的肉──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "這些",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "夠嗎。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n巨型蜥蜴、",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "熔岩水妖和其他魔物。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "甚好、",
    "voice": "vo_adv_9010002_007",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "甚好。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n可璃亞閣下",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "亦前來相助，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "實在令人萬分感激。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "謝謝妳，",
    "voice": "vo_adv_9010002_008",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "可璃亞小姐～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "對了對了，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "妳是說想要做「咖哩」對吧？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "鍋子、菜刀、香料那些，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "都準備好囉～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "謝謝妳♪",
    "voice": "vo_adv_9010002_009",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n這樣就可以做",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "若菜小姐教我的特製咖哩了！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n我想來參加派對的各位，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "一定都會很開心的♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "啊，",
    "voice": "vo_adv_9010002_010",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對了♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n安涅默涅小姐也可以幫忙嗎？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "一起做咖哩。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──我、",
    "voice": "vo_adv_9010002_011",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "嗎。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "但是──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "料理，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我完全不懂。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "派對也",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "沒打算要參加──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那個……",
    "voice": "vo_adv_9010002_012",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "如果學會做料理了，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "也許以後派得上用場喔？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "怎麼樣♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "………………",
    "voice": "vo_adv_9010002_013",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "默涅呀，",
    "voice": "vo_adv_9010002_014",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "無須蹙眉。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n汝為近侍，若能習得料理技術，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家的餐食",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "也將增添風采。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n再加上──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "贈與蘭德索爾的賀禮堆積如山，",
    "voice": "vo_adv_9010002_015",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "搬運也是一大辛勞。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n即使米亞用不存在的雙足長途跋涉，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "人手也遠遠不足，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "這點是顯而易見的。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "這樣的話──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "對吧？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "拜託妳了安涅默涅小姐～！",
    "voice": "vo_adv_9010002_016",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n一起來吧，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "來啦、",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "來啦！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n只靠我一個人會被壓垮的～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "妳只是──",
    "voice": "vo_adv_9010002_017",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "很期待去蘭德索爾而已吧，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n皇女。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──呵呵，",
    "voice": "vo_adv_9010002_018",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "何須多言。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "自然是滿懷期待啊？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "無論是能夠見到異國的公主們，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "還是能和汝一同參加宴席。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
