  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "大家對我讚譽不絕呢♪",
    "voice": "vo_adv_5061004_055",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不枉費我那麼努力上課了。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過，",
    "voice": "vo_adv_5061004_056",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "人類樣貌的我",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "越是受到稱讚，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n就越讓我懷疑，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "原本身為野獸的我",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是不是不被需要呢……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那也是當然的嘛。",
    "voice": "vo_adv_5061004_057",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "比起",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "外表是野獸的女孩子，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n不論是誰肯定都更喜歡可愛又高雅的千金小姐吧。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是不是乾脆",
    "voice": "vo_adv_5061004_058",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "以人類的樣貌",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "繼續住在這裡好呢……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n對於",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "【伊麗莎白牧場】來說，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n這樣肯定也會比較好吧。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "畢竟身為野獸的我，",
    "voice": "vo_adv_5061004_059",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "可沒辦法讓大家這麼開心……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯──",
    "voice": "vo_adv_5061004_060",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "可是",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "莉瑪莉瑪不在還真是可惜的啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "因為那孩子",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "一直很嚮往這種閃閃發光的世界呢，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n她一定會很希望妳能教她各種事吧。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……咦？",
    "voice": "vo_adv_5061004_061",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就是說啊～",
    "voice": "vo_adv_5061004_062",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "少了那個毛茸茸的牧場，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n感覺有些寂寞呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "吶，",
    "voice": "vo_adv_5061004_063",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "在這裡的莉瑪，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是個怎麼樣的女孩呢？",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "莉瑪她",
    "voice": "vo_adv_5061004_064",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是個開朗、溫柔，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "而且比誰都更有少女心的女孩子哦。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "只不過，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為有些原因，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以沒什麼機會出現在別人面前……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但是",
    "voice": "vo_adv_5061004_065",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "莉瑪莉瑪是個非常善良的女孩的啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n一開始看到或許會有些驚訝，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但她跟莉瑪小姐絕對能成為好朋友的。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "對啊～",
    "voice": "vo_adv_5061004_066",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "莉瑪她",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "對像我這樣的懶惰鬼也很溫柔呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n在工作的時候，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還會順便撿橡子來給我哦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "因為她太溫柔了，",
    "voice": "vo_adv_5061004_067",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "害我一不小心就會依賴她呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "所以",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我雖然平常沒說出口，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但其實我非常感謝她哦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "所以",
    "voice": "vo_adv_5061004_068",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我現在正在讀莉瑪可能會喜歡的書，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我想等她回來以後，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "跟她好好聊聊呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n啊～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真希望她趕快回來～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……",
    "voice": "vo_adv_5061004_069",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "吶，莉瑪小姐，",
    "voice": "vo_adv_5061004_070",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "要是可以的話請妳再來玩吧。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我一定要把我們最棒的夥伴，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "介紹給妳認識的啦！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "still",
    "still_id": "506100402"
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……嗯，",
    "voice": "vo_adv_5061004_071",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我也很想見見她呢……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "background",
    "bg_id": "500152"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呼……",
    "voice": "vo_adv_5061004_072",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊，",
    "voice": "vo_adv_5061004_073",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "{0}……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "總覺得",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "心中很感動，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "所以睡不著覺。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不論",
    "voice": "vo_adv_5061004_074",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我的外表如何，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "大家",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "都有確實地了解我的內在，這讓我非常感動……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我",
    "voice": "vo_adv_5061004_075",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "即使是現在，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也還是希望能夠成為一個普通的人類。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n畢竟，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "被當成魔物果然還是件很討厭的事。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但是……",
    "voice": "vo_adv_5061004_076",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "同時",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我也重新認識到了，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n野獸的模樣或許",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也並沒有那麼糟呢。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "因為我明白了，",
    "voice": "vo_adv_5061004_077",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "大家",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "並不是以外表，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n而是以一位名為「莉瑪」的女孩子",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "來看待我。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "或許",
    "voice": "vo_adv_5061004_078",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "外表的美麗，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n並不是那麼重要的事呢。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呵呵，",
    "voice": "vo_adv_5061004_079",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我會相信你和大家的話，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n重新",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好好審視我自己的。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在獲得了新的發現後，莉瑪作為一位少女又有了進一步的成長。",
    "voice": null,
    "unit_id": null
  }
]
