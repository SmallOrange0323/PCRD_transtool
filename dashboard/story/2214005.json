    "voice": "vo_adv_2214005_009",
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "──「消魂之箭」。",
    "voice": "vo_adv_2214005_010",
    "unit_id": 195213
  },
  {
    "type": "background",
    "bg_id": "502430"
  },
  {
    "type": "background",
    "bg_id": "502430"
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……",
    "voice": "vo_adv_2214005_011",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……居然一聲不響地就展開攻擊。",
    "voice": "vo_adv_2214005_012",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n這問候也太隨便了吧，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "黎薩。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "哎呀，是嗎？",
    "voice": "vo_adv_2214005_013",
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "面對那種不僅氣息、連身影都消失、專門偷襲的惡靈，",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我覺得這已經是好得有些奢侈的問候了。",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "本來想說妳換了個形象──",
    "voice": "vo_adv_2214005_014",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "但嘴巴似乎還是一樣壞呢。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n那我就放心了。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……那件衣服，",
    "voice": "vo_adv_2214005_015",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n是被剎鬼濺上的血染黑的嗎？",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……哎呀？",
    "voice": "vo_adv_2214005_016",
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "格蕾斯，妳在生氣嗎？",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n雪野也就罷了，",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我都不知道",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "妳跟剎鬼的感情有這麼好。",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……是啊。",
    "voice": "vo_adv_2214005_017",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n剎鬼性格粗魯，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "對可愛的小格蕾笑話也表現得很冷淡。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我們的感情",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "完全不算好……",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "可是，",
    "voice": "vo_adv_2214005_018",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "妳搞錯重點了。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……妳讓雪野和薇歐莉特公主",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "多麼傷心難過……",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "對於惹哭那些溫柔女孩的我，",
    "voice": "vo_adv_2214005_019",
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n妳正感到生氣。",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n是這樣沒錯吧？",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "嗯，",
    "voice": "vo_adv_2214005_020",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "而且……",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不光是剎鬼，",
    "voice": "vo_adv_2214005_021",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n還有妳",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "在我們心中已經「死去」的事也是。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n懂了嗎？",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……",
    "voice": "vo_adv_2214005_022",
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "真是奇怪了。",
    "voice": "vo_adv_2214005_023",
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n比起姑且還算同事的那時，",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "現在妳的話中刺還比較少呢。",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……可是，",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "格蕾斯──",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "妳應該明白，",
    "voice": "vo_adv_2214005_024",
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我已經",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "無法回頭了吧？",
    "voice": null,
    "unit_id": 195213
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……是啊。",
    "voice": "vo_adv_2214005_025",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我明白──",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "──人笨不是死一次就能治好的，",
    "voice": "vo_adv_2214005_026",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我只明白了這一點。",
    "voice": null,
    "unit_id": 133011
  },
