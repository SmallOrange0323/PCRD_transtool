    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 19511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "……！？",
    "voice": "vo_adv_2214005_029",
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n好硬！",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "可是，",
    "voice": "vo_adv_2214005_030",
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "也不是完全沒用！",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "\\n多轟牠幾下，",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "克蘿！",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "好的！",
