  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "喔♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "……呵呵，",
    "voice": "vo_adv_2214005_002",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n總覺得",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "自己好像一直在自我介紹，不過──",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "我是阿爾莎特，",
    "voice": "vo_adv_2214005_003",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n幻境龍后的公主騎士。",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "初次見面，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "迷宮女王的公主騎士大人……♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "沒錯♡",
    "voice": "vo_adv_2214005_004",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n我跟你",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "是一樣的呢……♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "能像這樣跟你獨處，",
    "voice": "vo_adv_2214005_005",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "我非常高興♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "其實啊，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "我想縮短更多",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "更多",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "更～多",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "與你的距離，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n分享不只語言的所有一切，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "深入交流。",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "只是……",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "我的主人",
    "voice": "vo_adv_2214005_006",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "跟你的主人是敵人……",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n所以我跟你們",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "似乎也必須是敵人。",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n命運",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "真是殘酷──",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "居然要撕裂如此",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "互相吸引的兩人呢。",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "成為我「戀人」",
    "voice": "vo_adv_2214005_007",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "的孩子們，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n也正在前往其他世界──",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "呵呵……",
    "voice": "vo_adv_2214005_008",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "好了。",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n就讓公主騎士彼此──",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "來場以血洗血的戰鬥吧♡",
    "voice": null,
    "unit_id": 195611
  },
