[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}受到委託，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正要前往伊麗莎白牧場找鈴時──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊，{0}。",
    "voice": "vo_adv_1026012_000",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哎呀～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "今天天氣也很好呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "走在街上的人們",
    "voice": "vo_adv_1026012_001",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "看起來也都很幸福，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n真是太好了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯嗯。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呵呵呵，",
    "voice": "vo_adv_1026012_002",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我的計畫也馬上就要達成了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n世界看起來實在太耀眼了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊，",
    "voice": "vo_adv_1026012_003",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "對了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n你也來參與我計畫的結尾吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不不，",
    "voice": "vo_adv_1026012_004",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你不用這麼緊張啦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n只是陪我去買個衣服而已。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "因為是比較高價的衣服，",
    "voice": "vo_adv_1026012_005",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "所以我想認真挑選。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯？",
    "voice": "vo_adv_1026012_006",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你該不會以為我覺醒了愛打扮的嗜好？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哪有可能啊。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我在找的是",
    "voice": "vo_adv_1026012_007",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "極品的家居服。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n也就是",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "睡衣呦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "為了買到最棒的家居服，",
    "voice": "vo_adv_1026012_008",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我還特地存了錢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "因為絕對不想失敗，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "所以你也來陪我挑……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你想拜託我？",
    "voice": "vo_adv_1026012_009",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n好難得喔。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "什麼事？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你就說說看吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "………………",
    "voice": "vo_adv_1026012_010",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呃……",
    "voice": "vo_adv_1026012_011",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "整理一下事情的原委，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就是……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "前陣子",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "擊退魔物的事傳了出去，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n因此有人向【哞哞自衛隊】指名要委託我",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這樣。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "所以",
    "voice": "vo_adv_1026012_012",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你找我就是為了",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "傳達這件委託",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "是吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯，",
    "voice": "vo_adv_1026012_013",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這件委託",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就交給別人去做吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "大家會做的比我好吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "為什麼會突然提到媽媽啊。",
    "voice": "vo_adv_1026012_014",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "又沒有關聯。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦？",
    "voice": "vo_adv_1026012_015",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "媽媽聽到我很活躍的傳聞，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n去【哞哞自衛隊】的公會小屋打了招呼？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "她說聽到我很活躍覺得很開心……",
    "voice": "vo_adv_1026012_016",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這樣？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這個…………",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那個…………",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊～～",
    "voice": "vo_adv_1026012_017",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真是的～～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "聽到這種事不就不能拒絕了嗎！！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n知道了啦！！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我做就是了嘛，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我做！！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好，",
    "voice": "vo_adv_1026012_018",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那就趕緊去找委託人吧！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "麻煩事就是要儘速解決！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "喔～～！",
    "voice": "vo_adv_1026012_019",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n真沒想到妳會這麼快",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "就過來！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊～",
    "voice": "vo_adv_1026012_020",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n該說是時機正好、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還是時機太差的關係呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "所以，",
    "voice": "vo_adv_1026012_021",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你要委託我什麼？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "因為想趕快解決，",
    "voice": "vo_adv_1026012_022",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "沒仔細聽說明就趕來了，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但我不想處理麻煩事啊……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "希望是那種",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "能迅速解決的事情呢……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我想拜託鈴小姐",
    "voice": "vo_adv_1026012_023",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "把這一帶的魔物",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "都除掉。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……欸？",
    "voice": "vo_adv_1026012_024",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我聽錯了吧？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你能再說一遍嗎？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "所以說，",
    "voice": "vo_adv_1026012_025",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我想拜託妳",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "把這一帶的魔物都除掉。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就我一個人做？",
    "voice": "vo_adv_1026012_026",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "其實那是非常善於躲藏、",
    "voice": "vo_adv_1026012_027",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "且動作敏捷的魔物，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "很少人有辦法除掉牠們。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我一直找不到能驅除那些魔物的人，",
    "voice": "vo_adv_1026012_028",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "正覺得一籌莫展時，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "剛好聽到了關於妳的傳聞。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "隸屬於【哞哞自衛隊】，",
    "voice": "vo_adv_1026012_029",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "因其才幹，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n被派駐於【伊麗莎白牧場】，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "擁有敏銳的聽覺，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n驅使著華麗的使槍技巧，",
