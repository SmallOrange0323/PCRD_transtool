    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "正面接下那道攻擊的話可不太妙的樣子，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要是有辦法能讓對方停個一下也好……",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好像很強大……",
    "voice": "vo_adv_5082322_002",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不過，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我們可不能輸在這裡！",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這都是為了和大家一起享用年菜！",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雪菲妳說得很好！",
    "voice": "vo_adv_5082322_003",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身也該回應妳的志氣啊！",
