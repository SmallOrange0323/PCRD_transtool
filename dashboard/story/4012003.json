[
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "總覺得",
    "voice": "vo_adv_4012003_000",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n可可蘿跟小苑很像，讓人好安心～！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯……",
    "voice": "vo_adv_4012003_001",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "小個嬌小的精靈族，而且服裝是綠色的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "若以",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要素來看，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下和苑小姐的共通點或許很多。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這麼說讓在下很開心呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "耶～！",
    "voice": "vo_adv_4012003_002",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n彩羽也很開心～！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊，",
    "voice": "vo_adv_4012003_003",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "彩羽小姐！？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "別突然這樣跳……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "想充滿活力地蹦跳，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n最好先整理好服裝，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不然",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不得體。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來，",
    "voice": "vo_adv_4012003_004",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好好把腰帶束好。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "鞋帶也都鬆了呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下幫您繫上。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "看吧，",
    "voice": "vo_adv_4012003_005",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "不光是外表，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "可可蘿連這種地方都跟小苑一樣！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嘿嘿～",
    "voice": "vo_adv_4012003_006",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "最喜歡妳了～♪",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n可可蘿姑姑～♪",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "姑、",
    "voice": "vo_adv_4012003_007",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "姑姑……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗎？",
    "voice": null,
    "unit_id": 105913
  }
]
