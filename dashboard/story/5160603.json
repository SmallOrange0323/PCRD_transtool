[
  {
    "type": "background",
    "bg_id": "502170"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "その日メドゥーサ、モニカ、サレンはネフィ＝ネラに呼び出され",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n鬼岩城塞へと赴いた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "モニカ殿。",
    "voice": "vo_adv_5160603_000",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "サレン殿。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "\\n御足労誠に痛み入り申す。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "ああ序に、",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "メドゥーサ奴も喃。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ヒトのこと呼びつけておいて、",
    "voice": "vo_adv_5160603_001",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ついで扱いすんじゃないわよっ。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "アタシ、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "そんな暇じゃないんだけど。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "つまらない用事だったら許さないんだからね！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "お気になさらずに、",
    "voice": "vo_adv_5160603_002",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ネフィ＝ネラ殿。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n暇に飽かせて当てどなく祭りを見て回ってただけなので。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "な、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "メドゥーサ？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "い、",
    "voice": "vo_adv_5160603_003",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "言わなくていいでしょそんなこと！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ネフィ＝ネラのせいでしばらくランドソルで暮らすハメになったから",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "『こっち』を見納めしとこうとか、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "そんなこと思ってないんだから！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "──コロコロコロ。",
    "voice": "vo_adv_5160603_004",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "蠢動る蛇の化生の割に、",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "直な娘で在り申す。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "わっちの用向きは明快至極。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "ランドソルの賀正の慣習に則り",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "\\nお前さまらに『御年玉』なる宝を賜さんと思い侍り。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "え、",
    "voice": "vo_adv_5160603_005",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "お、",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "お年玉！？　",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "あの、",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "お気持ちはうれしいですけど、",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\nあたしたちはもう、",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "お年玉をもらうような年齢では……",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "う、",
    "voice": "vo_adv_5160603_006",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "うむ。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "こんな成りだが、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "一応大人ではあるので……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "えー、",
    "voice": "vo_adv_5160603_007",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "いいじゃない、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "もらっておきなさいよ。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "蛇の末子の言う通りであり申す。",
    "voice": "vo_adv_5160603_008",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "\\nお前さまらが一角の人物で在らせられるは先刻承知。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "\\n為れど此度は、",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "カノン奴の不始末の詫びも兼ねます也。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "此の機に報恩叶いますれば、",
    "voice": "vo_adv_5160603_009",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "わっちの面子も立つと云ふもの。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "\\n其れに古来より遠慮は無沙汰、",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "湯の辞儀は水になるとの金言在らば。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "\\nモニカ殿、",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "サレン殿。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "どうぞ御笑納下さります様、",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "お頼み申し上げ奉る。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "で、",
    "voice": "vo_adv_5160603_010",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "でも……",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "なあ……",
    "voice": "vo_adv_5160603_011",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "ありがたいけど……",
    "voice": "vo_adv_5160603_012",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "他国の要人からのお年玉なんて、",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "いいのかしら。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n一応あたし、",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "今回は公務員で来たわけだし。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n収賄で外交問題とかになったりしないかしら？　",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "一国の姫君から直々に褒美を賜ることになるとは……",
    "voice": "vo_adv_5160603_013",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n場合によっては武器を新調できるかもしれんし、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nカフェに新商品を入れられるかもしれんぞ……！？　",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "……いやいやいや。",
    "voice": "vo_adv_5160603_014",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "期待し過ぎてはいかん。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nネフィ＝ネラ殿がいかに気前が良くとも、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "所詮はお年玉。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nしばらくの間おやつが豪華になるだけでも、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "十分というものだろう。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "なに悩んでんの？　",
    "voice": "vo_adv_5160603_015",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "いらないならアタシが全部もらっちゃうわよ。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "こぉれメドゥーサや。",
    "voice": "vo_adv_5160603_016",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "欲の皮を張るで無し。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "\\n汝の取り分は此方に候。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "\\n無駄遣いをしてはならぬぞえ。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ふーん、",
    "voice": "vo_adv_5160603_017",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "なかなかキレイじゃない。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ま、",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "一個でガマンしてあげる。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "あ、",
    "voice": "vo_adv_5160603_018",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "あの、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ええと……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nネ、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ネフィ＝ネラ殿？　",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "こ、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "この金色の玉は……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "文字通り──",
    "voice": "vo_adv_5160603_019",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "御年『玉』であり申す。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "ジオ・ゲヘナの地下より",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "\\n掘り出されたる鉱石を鋳溶かし、",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "磨きに磨きを掛けた有様は正に珠玉。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "\\n職人の技巧が光る黄金の輝き、",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "ネフィ＝ネラ",
    "words": "実に美事な仕事に御座候。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "あ、",
    "voice": "vo_adv_5160603_020",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "そ、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "そうか、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "お年玉、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "か。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "なるほど……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n確かに玉というのは縁起物でもあるしー……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "ありがとうございます。",
    "voice": "vo_adv_5160603_021",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "これは……",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "きれいですね……",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n一点の曇りもないわ。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "な、",
    "voice": "vo_adv_5160603_022",
