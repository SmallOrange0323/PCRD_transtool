[
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "純想著要和{0}約見面，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n卻說不出口，日子就這樣過去了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "今天也是一成不變。",
    "voice": "vo_adv_1047010_000",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n雖然沒事就是好事，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但沒有要做的事情就會不禁胡思亂想啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……從那之後，",
    "voice": "vo_adv_1047010_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就沒法跟少年說任何話了啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "儘管知道該跟他約下次見面，",
    "voice": "vo_adv_1047010_002",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但是該怎麼開口才好……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不行不行，",
    "voice": "vo_adv_1047010_003",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "得集中精神工作才行。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "該怎麼做才好呢……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "抱歉在任務執行時打擾了，",
    "voice": "vo_adv_1047010_004",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "團長！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯？",
    "voice": "vo_adv_1047010_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "這傢伙堅持要過來道歉……",
    "voice": "vo_adv_1047010_006",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "那個……",
    "voice": "vo_adv_1047010_007",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "之前的事情真的很抱歉。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": "vo_adv_1047010_008",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是你啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n以後",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "多注意一下就好。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這麼一說，",
    "voice": "vo_adv_1047010_009",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果沒有發生那件事，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那天也許就不會遇到少年了……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我在想些什麼。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n什麼事都沒發生才是最好的啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "……團長？",
    "voice": "vo_adv_1047010_010",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "再說，",
    "voice": "vo_adv_1047010_011",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "直接向少年提出邀請，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就不會",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "像這樣陷入沉思了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "該如何開口呢……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔……",
    "voice": "vo_adv_1047010_012",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "原來我是這麼",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "優柔寡斷的人嗎……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "那個……",
    "voice": "vo_adv_1047010_013",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "差不多就行了，",
    "voice": "vo_adv_1047010_014",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "新人。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "團長很忙的。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n肯定在擔憂【王宮騎士團】的狀況，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n並正在思考之後該如何行動。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "這、",
    "voice": "vo_adv_1047010_015",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "\\n不愧是前輩，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "很清楚團長的事情呢。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "那當然。",
    "voice": "vo_adv_1047010_016",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "團長的事情就交給我。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n好了，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我們也去接任務吧。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n雖然沒辦法接下艱難的任務，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "應該還是有些什麼可以做的。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……艱難的任務、",
    "voice": "vo_adv_1047010_017",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗎。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n在這之中應該有討伐魔物的任務吧？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "咦？",
    "voice": "vo_adv_1047010_018",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我想可能會有……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣啊。",
    "voice": "vo_adv_1047010_019",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可以暫時",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "麻煩你留在這邊負責警備嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我去確認一下現在有什麼任務。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "是",
    "voice": "vo_adv_1047010_020",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我知道了！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……沒錯。",
    "voice": "vo_adv_1047010_021",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n因為有多餘的心思才會考慮這些多餘的事情。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n接下艱難的任務，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "然後重新提起幹勁吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "……不愧是團長啊。",
    "voice": "vo_adv_1047010_022",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "前、",
    "voice": "vo_adv_1047010_023",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "前輩？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "即使什麼話都沒說，",
    "voice": "vo_adv_1047010_024",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "看著她的背影就能明白了。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n團長為了補足我們的不中用，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n而決定去挑戰困難的任務……！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "原來是這麼一回事啊。",
    "voice": "vo_adv_1047010_025",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "\\n",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "果然，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "團長很厲害呢……！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我們也是，",
    "voice": "vo_adv_1047010_026",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "為了能夠稍微追上團長，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n要加油囉！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "好",
    "voice": "vo_adv_1047010_027",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "的！！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "從那之後過了幾天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}因為很在意純的情況，所以正在找她。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "今天就在這附近巡邏喔！",
    "voice": "vo_adv_1047010_028",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n因為團長正在努力著，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我們也得加油才行！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "好！",
    "voice": "vo_adv_1047010_029",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "但是，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "團長一個人沒問題吧？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "\\n討伐魔物的話，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "還是不要單獨行動比較好吧……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "團長的話沒問題的。",
    "voice": "vo_adv_1047010_030",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n我無法想像她陷入苦戰的樣子呢。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "唔，",
    "voice": "vo_adv_1047010_031",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "什麼啊，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "你哪位。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n好像在哪裡見過你……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "我記得",
    "voice": "vo_adv_1047010_032",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "這位是團長的熟人",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "沒錯喔。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "啊，",
    "voice": "vo_adv_1047010_033",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "那個和團長一起執行任務的男子啊。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n你在找團長嗎？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "團長傍晚應該會回去據點。",
    "voice": "vo_adv_1047010_034",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n她現在",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "正在對付運輸道路上出現的魔物，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n並在附近的森林進行調查。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我先說，",
    "voice": "vo_adv_1047010_035",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "不要去森林那邊喔。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n會妨礙團長的。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n在據點等她就好。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我們也有巡邏的工作，",
    "voice": "vo_adv_1047010_036",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "所以先走了……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "等等，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "喂！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "據點不是在那個方向喔？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呼……",
    "voice": "vo_adv_1047010_037",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "總之",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這附近都已經解決了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n稍微休息一下就回去蘭德索爾吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……雖然最近已經習慣討伐魔物，",
    "voice": "vo_adv_1047010_038",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但還是被魔物擊中了一下……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我得更努力精進自己才行。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好痛……",
    "voice": "vo_adv_1047010_039",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "被擊中的傷口很嚴重嗎……？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n雖然確認一下比較好，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但戴著面具很難確認吶……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n沒辦法……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呼……",
    "voice": "vo_adv_1047010_040",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "多虧穿著鎧甲，只是瘀傷而已。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不是什麼大傷口。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，",
    "voice": "vo_adv_1047010_041",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "受傷了這件事意味著……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖說人手不足，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還是應該跟別人一起來嗎……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也是啊，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果可以選的話，想和少年……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我又在",
    "voice": "vo_adv_1047010_042",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "想些什麼啊……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n可不能帶不是團員的人一起來。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這麼一說，",
    "voice": "vo_adv_1047010_043",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "最近都在忙任務的事情，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不知道其他團員們",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在做什麼呢……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "作為團長",
    "voice": "vo_adv_1047010_044",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真失職……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n得花更多心思在夥伴身上才行。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "像少年一樣好好注視周遭……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "！？",
    "voice": "vo_adv_1047010_045",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我、",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我又在想少年的事情了……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": "vo_adv_1047010_046",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不是在叫你……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n少、",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年你怎麼在這裡……？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "該不會，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "魔物的攻擊還附有幻覺效果……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真、",
    "voice": "vo_adv_1047010_047",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真人？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "擔心我而來的嗎？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然很高興，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但你不能來這個地方喔。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那個……",
    "voice": "vo_adv_1047010_048",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我還有任務，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所以差不多該走了……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "怎、",
    "voice": "vo_adv_1047010_049",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "怎麼了嗎，少年。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n怎麼抓住我的手……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……稍微休息一下比較好？",
    "voice": "vo_adv_1047010_050",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但、",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但是啊……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就算你像訓小孩一樣對我說「不行」……",
    "voice": "vo_adv_1047010_051",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……也是呢。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n少年是說出口後就會堅持下去的個性……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "知道了。",
    "voice": "vo_adv_1047010_052",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我休息一下再繼續行動。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以，你可以",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "放開我的手了嗎？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真是的……",
    "voice": "vo_adv_1047010_053",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n少年固執的一面真是沒變呢。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，",
    "voice": "vo_adv_1047010_054",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "謝謝你擔心我。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "然而我卻……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n忙著自己的事情，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真是抱歉。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "剛才我也正好在反省。",
    "voice": "vo_adv_1047010_055",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n如果我做事能更周全，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n【王宮騎士團】",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也許能更快重新振作起來。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "要是我也能像少年一樣，",
    "voice": "vo_adv_1047010_056",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好好顧慮周遭的事物……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但這件事即使努力了也無法馬上改善。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "一想到這，",
    "voice": "vo_adv_1047010_057",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就覺得我也許不適合當團長呢。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦，",
    "voice": "vo_adv_1047010_058",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但是……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這次究竟",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "又怎麼了？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "等、",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "等等。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "至少讓我戴上頭盔。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "background",
    "bg_id": "500021"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你只是想要回來蘭德索爾啊？",
    "voice": "vo_adv_1047010_059",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這樣的話一開始就先跟我說──",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "所以說，",
    "voice": "vo_adv_1047010_060",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "這塊地點是我先看好的！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "這種事誰知道啊！",
    "voice": "vo_adv_1047010_061",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n我也是早就想好要在這邊開店了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "起爭執了嗎。",
    "voice": "vo_adv_1047010_062",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒辦法，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我過去一下……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為什麼阻止我，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯？",
    "voice": "vo_adv_1047010_063",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那是……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "等一下等一下。",
    "voice": "vo_adv_1047010_064",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "在幹什麼啊，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "你們。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "這傢伙在我打算設店的地方",
    "voice": "vo_adv_1047010_065",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n擅自準備開店！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "所以說了這種事誰知道啊！",
    "voice": "vo_adv_1047010_066",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n突然跑來這裡",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "隨便攪局的是你吧！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "知道了知道了，",
    "voice": "vo_adv_1047010_067",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "先冷靜下來。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n在這個地方爭執也無濟於事啊？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "是這樣說沒錯……",
    "voice": "vo_adv_1047010_068",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "別在這種人來人往的路上起爭執。",
    "voice": "vo_adv_1047010_069",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n你們都是想要做生意的人，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n好好溝通不就行了嗎？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "……知道了。",
    "voice": "vo_adv_1047010_070",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "真拿你沒辦法……",
    "voice": "vo_adv_1047010_071",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……看來似乎不需要我出面呢。",
    "voice": "vo_adv_1047010_072",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "果然就算我不在，",
    "voice": "vo_adv_1047010_073",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n團員也有在好好工作呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n少年讓我看這些究竟是為什麼……？　",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "那個……",
    "voice": "vo_adv_1047010_074",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "像剛剛這樣對應就可以了嗎？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "\\n不嚴厲一點說的話",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "會被瞧不起吧……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "瞧不起的話，",
    "voice": "vo_adv_1047010_075",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "最後嚐到苦頭的是他們。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n而且……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "如果是團長的話不會用那麼粗暴的方式。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "團長雖然沉默寡言，",
    "voice": "vo_adv_1047010_076",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "不過看著她的背影可以學到很多。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n我們應該好好效仿，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "並努力追上她，是吧？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "……",
    "voice": "vo_adv_1047010_077",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "是",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……明明我這麼沒出息，",
    "voice": "vo_adv_1047010_078",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "卻被當成模範了啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我只是為了自己才去接任務的，",
    "voice": "vo_adv_1047010_079",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n然而在夥伴眼裡我是這樣子的人啊……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年是為了鼓勵我，",
    "voice": "vo_adv_1047010_080",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "才讓我看這些的嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……這樣啊。",
    "voice": "vo_adv_1047010_081",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "謝謝你，",
    "voice": "vo_adv_1047010_082",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n託你的福，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "讓我瞭解到團員們很信任我。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不論過程如何，",
    "voice": "vo_adv_1047010_083",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我用我的方式努力的話……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n夥伴都會看在眼裡，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "然後，也是為了他們，",
    "voice": "vo_adv_1047010_084",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我感到我需要更加精進自己。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……我察覺到的",
    "voice": "vo_adv_1047010_085",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不只是這件事。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我發現只要和鼓勵我的少年待在一起，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n心情就會平靜下來。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯。",
    "voice": "vo_adv_1047010_086",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "現在這種心情，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "肯定是因為我變得\\n像普通的女孩子一樣，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "會想和某個人待在一起，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n事到如今，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "才察覺到這種事……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……你真的教會了我許多事呢。",
    "voice": "vo_adv_1047010_087",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵。",
    "voice": "vo_adv_1047010_088",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你的表情一臉寫著",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不知道為什麼我要一直道謝呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你還記得我之前說的嗎？",
    "voice": "vo_adv_1047010_089",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我很憧憬可以做一些像普通女孩子會做的事……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "託你的福……",
    "voice": "vo_adv_1047010_090",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我覺得，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n自己或許也越來越像個普通的女孩子了",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔……",
    "voice": "vo_adv_1047010_091",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "被當面",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這麼問的話，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我會有點困擾……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這個嘛，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n下次見面的時候",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我再好好跟你說。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "不管{0}怎麼問純，\\n都被她避開問題了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "她的聲音聽起來似乎很開心。",
    "voice": null,
    "unit_id": null
  }
]
