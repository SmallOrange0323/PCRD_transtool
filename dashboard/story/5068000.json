    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要改造的話，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就需要花錢吧……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "機會難得，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我想讓它用好一點的材料……",
