    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "在這邊哦～",
    "voice": "vo_adv_1144003_023",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "咦，",
    "voice": "vo_adv_1144003_024",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "那個……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "請、",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "請不要拉著我～～！！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "各位……",
    "voice": "vo_adv_1144003_025",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "謝謝你們。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "當然！",
    "voice": "vo_adv_1144003_026",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我去確認一下烤火雞的狀況，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n布置的部分",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就麻煩你囉！",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──準備工作結束後，參加者們一一就坐。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在一片漆黑的會場中，響起了秋乃的聲音。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
