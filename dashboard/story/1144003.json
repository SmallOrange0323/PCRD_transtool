  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──秋乃的派對終於開始了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n被邀請而來的貴族抵達派對會場後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為面前出現的景象感到驚愕。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "這、",
    "voice": "vo_adv_1144003_000",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "這到底是……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "裝飾不夠了呢。",
    "voice": "vo_adv_1144003_001",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哪裡還有剩的嗎……",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "謝謝你！",
    "voice": "vo_adv_1144003_002",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "女僕",
    "words": "大小姐，",
    "voice": "vo_adv_1144003_003",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "女僕",
    "words": "料理已經準備完成了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女僕",
    "words": "\\n接下來",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女僕",
    "words": "只需要等待大小姐的特製烤火雞烤好就沒問題了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……這些量可能不太夠呢。",
    "voice": "vo_adv_1144003_004",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "再去準備多追加一些。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我這邊的",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "布置工作告一段落後，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就馬上過去確認。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "女僕",
    "words": "明白了，",
    "voice": "vo_adv_1144003_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女僕",
    "words": "大小姐。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "秋、",
    "voice": "vo_adv_1144003_006",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "秋乃大人親自準備派對會場……？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "啊，",
    "voice": "vo_adv_1144003_007",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "各位，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我已經恭候多時了！",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n在派對開始前拜託各位的事項……",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "太好了，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n各位都有",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "好好遵守呢。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "是穿著便於行動的衣服，",
    "voice": "vo_adv_1144003_008",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n和帶著自己挑選的禮物前來，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "對吧？",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "感謝您。",
    "voice": "vo_adv_1144003_009",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼各位，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "請先把各自準備的禮物",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "交給那邊的女僕。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "在這之後，",
    "voice": "vo_adv_1144003_010",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n希望各位能協助準備布置、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "料理、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "和派對活動。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "身、",
    "voice": "vo_adv_1144003_011",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "身為貴族的我，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "竟然要幫忙準備派對！？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……秋乃大人，",
    "voice": "vo_adv_1144003_012",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我有一事想詢問您。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n您應該能明白，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "像您這般身分的人，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "現在正在做的事",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n有多麼脫離常識。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "於是，",
    "voice": "vo_adv_1144003_013",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我才更要詢問您。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "──為什麼要這麼做？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這還用說嘛。",
    "voice": "vo_adv_1144003_014",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我只是",
    "voice": "vo_adv_1144003_015",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "想和大家一起享受聖誕節。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "大家在慶祝聖誕的同時，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "一起準備派對，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n共同度過最美好的時光，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就只是這樣。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "只、",
    "voice": "vo_adv_1144003_016",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "只是想享受而已…………",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……呵呵，",
    "voice": "vo_adv_1144003_017",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哈～哈哈哈哈哈！！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n真不愧是紫藤家的千金呢！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n好吧，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我也來幫忙布置會場。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "咦！？",
    "voice": "vo_adv_1144003_018",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "\\n可、",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "可是！？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那我來幫忙準備料理吧。",
    "voice": "vo_adv_1144003_019",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "雖然自從商會成立後，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我就很少進廚房了，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n但我的料理手藝可還沒有退步喔！",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "身、",
    "voice": "vo_adv_1144003_020",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "貴族",
    "words": "身為貴族的我……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "哦，",
    "voice": "vo_adv_1144003_021",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "小哥你看起來很閒嘛！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "小孩１",
