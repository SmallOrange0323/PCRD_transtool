  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "那孩子是……！？",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n我感受得到和我體內的力量相同的東西……",
    "voice": null,
    "unit_id": 101812
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "真是的～～～",
