  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "嘻嘻嘻～♪",
    "voice": "vo_adv_5078002_000",
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n不曉得為什麼，",
    "voice": null,
    "unit_id": 104512
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "感覺超亢奮的……！",
