  {
    "type": "dialogue",
    "name": "旁白",
    "words": "伊緒由於反逆獸的緣故被感染到黑暗力量。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n雖然多虧了這份力量成功趕跑了反逆獸，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但接著出現的是染上黑暗力量的空花。",
    "voice": null,
