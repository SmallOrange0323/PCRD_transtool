    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "就忘記了教訓……！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "因為我找到了新的僕人！",
    "voice": "vo_adv_5078002_005",
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n",
    "voice": null,
    "unit_id": 15311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "這傢伙是很傑出的人才喔……",
