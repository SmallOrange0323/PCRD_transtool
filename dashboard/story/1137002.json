[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這一天，茜里從一早就忙到無暇吃飯，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與{0}一起從事著天使的活動。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥，",
    "voice": "vo_adv_1137002_000",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不行……",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里撐不住了，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "已經是極限了……",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "肚子好餓，",
    "voice": "vo_adv_1137002_001",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "人家一步都走不動了啦～",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我今天也作為天使，",
    "voice": "vo_adv_1137002_002",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n從一早就一直在幫助有困擾的人，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "但我差不多想休息了。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我已經累到全身無力了，",
    "voice": "vo_adv_1137002_003",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n想吃像烏龍麵之類",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "清淡好入口的料理。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "感覺現在有多少我都吃得下去……",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呀！？",
    "voice": "vo_adv_1137002_004",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n哥哥，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "怎麼這麼強硬地對待茜里的身體……",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "討厭～！",
    "voice": "vo_adv_1137002_005",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "你要背茜里的話，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "跟人家說一聲就好了嘛。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "是因為茜里說走不動，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "你才會這麼做對吧。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "你會就這樣背著我去吃飯對吧？",
    "voice": "vo_adv_1137002_006",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "去哪裡都好，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "麻煩背我到離這裡最近的飲食店吧～！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不好意思，",
    "voice": "vo_adv_1137002_007",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "請問有兩個人的位子嗎？",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "哦，",
    "voice": "vo_adv_1137002_008",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "歡迎光臨～！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n當然有啦。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不過，",
    "voice": "vo_adv_1137002_009",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "以我們店裡來說，你們算是少見的客人呢……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n你們是知道這裡是什麼店才來的嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呃……",
    "voice": "vo_adv_1137002_010",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我們是肚子餓就隨便找家店進來了……",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "該不會我們",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "來到了一家很不得了的店嗎……？",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "男顧客１",
    "words": "啊唔啊唔啊唔！！",
    "voice": "vo_adv_1137002_011",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男顧客１",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男顧客１",
    "words": "啊──！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男顧客１",
    "words": "好吃────！！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男顧客１",
    "words": "店長，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男顧客１",
    "words": "再來一份！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男顧客１",
    "words": "麻煩要大份的！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "好喔～！",
    "voice": "vo_adv_1137002_012",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n稍等我一下，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我目前正在為小姑娘他們點餐！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "就如同妳看到的，",
    "voice": "vo_adv_1137002_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "客人都是男性，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這裡是特大份量精力滿分的料理店。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "對小姑娘你們來說，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "份量可能會有點多吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "雖然我現在，",
    "voice": "vo_adv_1137002_014",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "肚子餓得受不了……",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "男顧客２",
    "words": "嗯唔嗯唔嗯唔……",
    "voice": "vo_adv_1137002_015",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男顧客２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男顧客２",
    "words": "這裡也要再來一份！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男顧客２",
    "words": "再多來三盤炸雞塊！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "但是那麼大的炸雞塊，",
    "voice": "vo_adv_1137002_016",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "塞不進茜里的嘴裡啦～！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我想也是。",
    "voice": "vo_adv_1137002_017",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "啊……對了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我有點事想拜託你們，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好，",
    "voice": "vo_adv_1137002_018",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "什麼事？",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "如果我們做得到的話……",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "可是，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我現在肚子好餓……",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我當然",
    "voice": "vo_adv_1137002_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "會好好給你們謝禮。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "就讓你們免費吃喜歡的東西，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "吃到肚子撐飽為止！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "太好了～！",
    "voice": "vo_adv_1137002_020",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "會加油的！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那麼，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "請問是什麼事？",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "其實",
    "voice": "vo_adv_1137002_021",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我想拓展我們店的客層。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "但就像你們看到的，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "會來我們店裡的客人，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n都是些在男性之中",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "特別不修邊幅的人。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "能讓人津津有味地吃那些像山一樣多的料理，",
    "voice": "vo_adv_1137002_022",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "對廚師就是無上的幸福了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "但對身為廚師而言，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "也會想挑戰看看新類型的料理啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "因此，",
    "voice": "vo_adv_1137002_023",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我希望也能有像小姑娘那樣的",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "年輕女性客人來光臨。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "雖然想制定針對該客層的料理，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "但畢竟",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我只會做大份量的料理啊……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "真抱歉，",
    "voice": "vo_adv_1137002_024",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我知道不應該對第一次來光臨的客人，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n突然就說這種事情……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "但是，",
    "voice": "vo_adv_1137002_025",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "如果拜託小姑娘妳這件事，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "或許妳就能替我解決這個煩惱，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我很不可思議地",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "有這種感覺。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "既然是這樣，就交給我吧。",
    "voice": "vo_adv_1137002_026",
    "unit_id": 113711
