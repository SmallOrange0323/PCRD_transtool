[
  {
    "type": "background",
    "bg_id": "500285"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "精靈之森的孩子們很享受夏令營。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而{0}也一起享受著大海。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "大哥哥──！",
    "voice": "vo_adv_1227002_000",
    "unit_id": 5412
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "這邊這邊！",
    "voice": null,
    "unit_id": 5412
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n呀──♪",
    "voice": null,
    "unit_id": 5412
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "要被抓到了～♪",
    "voice": null,
    "unit_id": 5412
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "大哥哥！",
    "voice": "vo_adv_1227002_001",
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "快看！",
    "voice": null,
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n我發現了很罕見的魚！",
    "voice": null,
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "…………",
    "voice": "vo_adv_1227002_002",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "{0}。",
    "voice": "vo_adv_1227002_003",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你過來這邊一下。",
    "voice": "vo_adv_1227002_004",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請坐在那裡。",
    "voice": "vo_adv_1227002_005",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n要跪坐喔。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你還記得，",
    "voice": "vo_adv_1227002_006",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n今天是要來這裡做什麼的嗎？",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "哦，",
    "voice": "vo_adv_1227002_007",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你記得呢。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n明明記得，",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "卻還像那樣大玩特玩呢。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "才不是！",
    "voice": "vo_adv_1227002_008",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "大錯特錯！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n你果然忘了呢！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我就在想是不是那樣！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真是夠了。",
    "voice": "vo_adv_1227002_009",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "身為大人，這是怎樣？",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n還像小孩子一樣，",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "跟大家一起玩鬧。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "在這片海中，",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你看起來可是最開心的那一位喔？",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "明明是個大人，都不覺得羞恥嗎？",
    "voice": "vo_adv_1227002_010",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "會覺得吧？",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就請你",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好～好反省。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n……",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真是的。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "自由時間也差不多該結束了。",
    "voice": "vo_adv_1227002_011",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n……得展現魔法給大家看才行。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個，",
    "voice": "vo_adv_1227002_012",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呃……",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n要麻煩你……",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "幫忙了。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "為了盡量不被大家發現，",
    "voice": "vo_adv_1227002_013",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n你要從遠處使用那不可思議的力量。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "問我為什麼……",
    "voice": "vo_adv_1227002_014",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那是因為，",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "大家",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "都覺得我能使用厲害的魔法……",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n所以不就不能被他們看見",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我失敗的場面了嗎。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "總、",
    "voice": "vo_adv_1227002_015",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "總之！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n你要按照約定",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好好幫忙喔！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……雖然這樣可能很奸詐，",
    "voice": "vo_adv_1227002_016",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但我",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "可是大家的隊長。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好了──",
    "voice": "vo_adv_1227002_017",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請大家集合──！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "小組的大家都到齊了嗎？",
    "voice": "vo_adv_1227002_018",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n身體不舒服的人要舉手喔。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "沒有問題──！",
    "voice": "vo_adv_1227002_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯♪",
    "voice": "vo_adv_1227002_020",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n那麼現在起，",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "為了將要在夏令營",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "提交的學習課題，",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我想來開始進行魔法的練習了。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "終於啊！",
    "voice": "vo_adv_1227002_021",
    "unit_id": 5412
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "會是什麼樣的魔法呢……！",
    "voice": "vo_adv_1227002_022",
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個嘛，",
    "voice": "vo_adv_1227002_023",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n今天",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "要練習的魔法──",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "──是",
    "voice": "vo_adv_1227002_024",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "水上步行。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "水上步行是……",
    "voice": "vo_adv_1227002_025",
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "在水面上行走的魔法！？",
    "voice": null,
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n那種魔法",
    "voice": null,
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "就連教科書上都沒記載啊……！",
    "voice": null,
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "鏡華，",
    "voice": "vo_adv_1227002_026",
    "unit_id": 5412
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "妳能使用那種魔法嗎……！？",
    "voice": null,
    "unit_id": 5412
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是……",
    "voice": "vo_adv_1227002_027",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是的。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n這個啊，",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是原創的魔法……",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "原創！？",
    "voice": "vo_adv_1227002_028",
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n意思是妳自己創造了魔法嗎！？",
    "voice": null,
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不，",
    "voice": "vo_adv_1227002_029",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "創造的人並不是──",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "鏡華",
    "voice": "vo_adv_1227002_030",
    "unit_id": 5412
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "還真是不管什麼都辦得到呢！",
    "voice": null,
    "unit_id": 5412
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個……",
    "voice": "vo_adv_1227002_031",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "算了，",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n之後再說明也行吧……",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "前陣子，",
    "voice": "vo_adv_1227002_032",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "在我去找{0}商量之後，",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我們一起想了",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "要在夏令營使用什麼樣的魔法才好呢。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "然後，",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "{0}所想到的是──",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯～",
    "voice": "vo_adv_1227002_033",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "雖然我是很感激你的幫忙，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n但關於要教大家的魔法，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "該如何是好呢……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "攻擊魔法要是受傷了會很危險。",
    "voice": "vo_adv_1227002_034",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……感覺能在海中使用的",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "厲害魔法……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦？",
    "voice": "vo_adv_1227002_035",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……能在水中",
