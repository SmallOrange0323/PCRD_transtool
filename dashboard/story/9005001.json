    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……這不是挺好的嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
