    "words": "……",
    "voice": "vo_adv_2109001_025",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "望……？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "走吧，",
    "voice": "vo_adv_2109001_026",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌、",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "紡希。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n粉絲們正等著我們呢。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……雖然我也很～在意",
    "voice": "vo_adv_2109001_027",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "製作人去了哪裡，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但要是",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因此而耽誤了演出……",
    "voice": null,
    "unit_id": 102913
  },
