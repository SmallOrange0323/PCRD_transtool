    "words": "…………",
    "voice": "vo_adv_2109001_002",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "怎麼樣？",
    "voice": "vo_adv_2109001_003",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n千歌。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n通訊魔法",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "能聯絡上製作人嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……",
    "voice": "vo_adv_2109001_004",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "果然",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還是不行。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "製作人小姐",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可能出沒的座標我都一一嘗試過了……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "說到底，",
    "voice": "vo_adv_2109001_005",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n是她自己說今天會回來蘭德索爾的──",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "都約好",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "要來看我們的凱旋演唱會了……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……不太對勁呢。",
    "voice": "vo_adv_2109001_006",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n製作人",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "平時雖然很亂來，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但這種約定",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "卻是一定會遵守的。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那麼……",
    "voice": "vo_adv_2109001_007",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "她會不會是",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "被捲入什麼麻煩中了呢？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "被捲入",
    "voice": "vo_adv_2109001_008",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "麻煩啊……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真要說的話，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "感覺製作人才是那個",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n麻煩的製造者耶。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳說的",
    "voice": "vo_adv_2109001_009",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "或許沒錯……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但無論如何，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "聯絡不上人還是很奇怪。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "聽說最近",
    "voice": "vo_adv_2109001_010",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "蘭德索爾周邊，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n有兇惡的",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "恐怖分子在鬧事。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "會不會",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "和這件事有些關聯……？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "恐怖分子……",
    "voice": "vo_adv_2109001_011",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是那個叫【憤怒‧軍團】的公會嗎？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n街上到處都貼著他們的通緝令呢。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "恐怖分子啊……",
    "voice": "vo_adv_2109001_012",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但能把製作人擺平的對手，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我只想得到那個霸瞳皇帝……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但是，",
    "voice": "vo_adv_2109001_013",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "霸瞳皇帝在之前的戰鬥結束後，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n就被幽禁在王城裡了吧？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "嗯～",
    "voice": "vo_adv_2109001_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "啊，",
    "voice": "vo_adv_2109001_015",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "是慈樂之音──！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "哦，",
    "voice": "vo_adv_2109001_016",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "真的耶！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "好想去要簽名──！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "聽說她們正在舉辦全國巡演，",
    "voice": "vo_adv_2109001_017",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n看來是順利回來了呢……！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "…………",
    "voice": "vo_adv_2109001_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哈囉──！",
    "voice": "vo_adv_2109001_019",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n大家♪",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們稍後",
    "voice": "vo_adv_2109001_020",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
