    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n有空的話請多多捧場唷──！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "哇～！",
    "voice": "vo_adv_2109001_021",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n我一定會去的──！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "應援就交給我吧──！",
    "voice": "vo_adv_2109001_022",
