    "voice": "vo_adv_2109001_029",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "說得也是。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我也覺得",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "她一定會這麼說。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是啊。",
    "voice": "vo_adv_2109001_030",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "依製作人的個性，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "她說不定是假裝消失，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n想突然給我們一個驚喜呢！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "或許會在演唱會結束時",
    "voice": "vo_adv_2109001_031",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "突然冒出來唷？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n手裡還拿著禮物之類的♪",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呵呵，",
    "voice": "vo_adv_2109001_032",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是啊。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那麼……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們就盡情地",
    "voice": "vo_adv_2109001_033",
    "unit_id": 102913
  },
