  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在盛夏豔陽下的海邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n慈樂之音的三人正為了近日即將舉行的演唱會燃起了鬥志。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}，今天很謝謝你！",
