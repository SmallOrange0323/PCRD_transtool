    "name": "紡希",
    "words": "呃不，",
    "voice": "vo_adv_5072000_006",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "其實我剛才也是很自然地就請他幫忙了。",
