  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　那傢伙，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看起來好像已經恢復了呢！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "竟然這麼頑強！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n給我乖乖地被打敗啦！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好好啊～",
    "voice": "vo_adv_4004104_001",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果能像那樣毛髮立刻恢復成原本的樣子，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n每天的保養就很輕鬆的說～",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "現在可不是說那些悠哉話的時候！",
    "voice": "vo_adv_4004104_002",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過，",
    "voice": "vo_adv_4004104_003",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "確實地有受到損害的樣子唷！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "明明還沒有輸，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "氣勢不可以先弱掉啦！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也對。",
    "voice": "vo_adv_4004104_004",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不要氣餒，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "到最後一刻都不要拋棄蘭德索爾，戰鬥吧！",
    "voice": null,
    "unit_id": 105211
  }
]
