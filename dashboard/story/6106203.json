  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "我ながらこの格好、",
    "voice": "vo_adv_6106203_000",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "なかなかさまになってるにゃ♪",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n猫耳付きの帽子もバッチリ決まってて、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "センスが光る一着だにゃ！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "むふふ、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "キミも見惚れちゃったんじゃないかにゃ～？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "にゃっ……",
    "voice": "vo_adv_6106203_001",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "そそそ、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "そんなに率直に言われると",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nさすがのあたしも照れちゃうのにゃ……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "でも、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "ありがとにゃ。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "にゃはは、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "しばらくはこの格好のままでいようかにゃ～……♪",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "にゃはは、",
    "voice": "vo_adv_6106203_002",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "これだけ仕事してそうな見た目にゃんだから、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nこれはもう仕事をしたも同然と言っても過言ではないはずにゃ。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "というわけで、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "ちょっぴり休憩させてもらうのにゃ～♪",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "ふにゃあっ！？　",
    "voice": "vo_adv_6106203_003",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "あんなにたくさんコロコロしたのに！？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "くっ、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "背中はどうがんばっても手が届かないのにゃ……！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nキミ、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "あたしの背中コロコロしてほしいにゃあ～！",
    "voice": null,
    "unit_id": 107911
  }
]
