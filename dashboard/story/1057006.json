[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "由於委託騎空團的工作量增加，\\n吉塔與{0}過著相當忙碌的日子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呼唔……",
    "voice": "vo_adv_1057006_000",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "雖然有工作就值得感恩了，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n不過只有兩個人，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "果然是有點辛苦呢。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "也沒有辦法一直承接這種工作量呢……",
    "voice": "vo_adv_1057006_001",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "如果不是我和你的話，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n現在一定已經兩個人一起倒下了。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "──欸，",
    "voice": "vo_adv_1057006_002",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳就是吉塔嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "現在方不方便說幾句話？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "找我？",
    "voice": "vo_adv_1057006_003",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "有什麼事嗎……？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "是的，沒錯哦。",
    "voice": "vo_adv_1057006_004",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "騎空士吉塔。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n你們就是騎空團對吧？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我們有話想對你們說，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "今天一直在找你們哦。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "看起來不像是……",
    "voice": "vo_adv_1057006_005",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "來商量工作的事呢。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "沒有錯……雖然我是想這麼說，",
    "voice": "vo_adv_1057006_006",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不過某個層面上也和工作有關呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……你們兩位，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "要不要加入我們的公會？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "原來如此。",
    "voice": "vo_adv_1057006_007",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "加入公會……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……欸欸！？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "妳、",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "妳是什麼意思？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳會吃驚也是當然的。",
    "voice": "vo_adv_1057006_008",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "首先我希望妳不要誤會，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n我們不是因為你們是沒有騎空艇的騎空團，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n才可憐你們而邀請的。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "啊哈哈……",
    "voice": "vo_adv_1057006_009",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "真、",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "真直接呢。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我們的公會成員，",
    "voice": "vo_adv_1057006_010",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n人數這一陣子剛超過50人。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "5、",
    "voice": "vo_adv_1057006_011",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "50人！？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我們乘坐好幾輛馬車，",
    "voice": "vo_adv_1057006_012",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "在各地旅行承接工作。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n預計後天會離開這個城鎮。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "工作都像是討伐巨大魔物，",
    "voice": "vo_adv_1057006_013",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "或是護衛大規模商隊等等。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "全都是很辛苦的工作，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不過因此也賺得很多。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "的確都是那種工作的話，",
    "voice": "vo_adv_1057006_014",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n報酬也會相當好呢……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "所以我們的工作隨時都與危險相伴。",
    "voice": "vo_adv_1057006_015",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n正因為如此，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "選擇成員時就必須非常嚴格。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我們可沒有餘力去培養沒辦法跟上的成員。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你們最近非常活躍，",
    "voice": "vo_adv_1057006_016",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "雖然是我們這邊自作主張，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n但我們判斷你們已經達到這邊挑選成員的標準。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你們只有兩個人，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "卻做出了非常好的工作成果呢。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嘿嘿……",
    "voice": "vo_adv_1057006_017",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝誇獎。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "所以我們希望妳還有妳的夥伴，",
    "voice": "vo_adv_1057006_018",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "務必加入我們的公會。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "對我們來說能夠擴充戰力，",
    "voice": "vo_adv_1057006_019",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n而你們則能賺取更多的報酬。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我想這對彼此都有好處，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳覺得如何呢？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "唔、那個……",
    "voice": "vo_adv_1057006_020",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n太突然了，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我不知道該怎麼回覆……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不用立刻回覆我也沒關係。",
    "voice": "vo_adv_1057006_021",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n那就下次見了。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……走掉了。",
    "voice": "vo_adv_1057006_022",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "該怎麼辦……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……我今天就先回去了。",
    "voice": "vo_adv_1057006_023",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "因為他們認真地邀請了我們，",
    "voice": "vo_adv_1057006_024",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我也必須好好回覆才行。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "所以讓我稍微思考一下，",
    "voice": "vo_adv_1057006_025",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "之後要怎麼打算。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那就再見囉！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "background",
    "bg_id": "500021"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……唉……",
    "voice": "vo_adv_1057006_026",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n該怎麼辦呢……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "想不到竟然會被那麼大的公會邀請……",
    "voice": "vo_adv_1057006_027",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "如果和他們一起合作，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n一定能接到比現在更大型的工作……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "工作時也能到各種地方旅行，",
    "voice": "vo_adv_1057006_028",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n{0}也會比現在更好尋找，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n他記憶的線索吧……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "如果要實現我們的目標，",
    "voice": "vo_adv_1057006_029",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是不是解散騎空團，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "加入公會比較好……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那邊應該才是捷徑吧……",
    "voice": "vo_adv_1057006_030",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不過我",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "為什麼會這麼煩惱呢……？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "為什麼，",
    "voice": "vo_adv_1057006_031",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你會在這裡……？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……謝謝。",
    "voice": "vo_adv_1057006_032",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你一如往常是個可靠的團員呢。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "吶，你也能陪我一起煩惱嗎……",
    "voice": "vo_adv_1057006_033",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n在這之後，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們應該怎麼做才好……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──次日。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你們好。",
    "voice": "vo_adv_1057006_034",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "唉呀，",
    "voice": "vo_adv_1057006_035",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "你們好。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n看你們的樣子，應該想好答案了呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "可以讓我聽聽妳的答覆嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……是的。",
    "voice": "vo_adv_1057006_036",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我們……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……我們兩個，不會加入你們的公會。",
    "voice": "vo_adv_1057006_037",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "難得你們特地來邀請，實在非常抱歉！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這就是……",
    "voice": "vo_adv_1057006_038",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "經過種種考量之後，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們得到的答案！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "能告訴我們理由嗎？",
    "voice": "vo_adv_1057006_039",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……我果然還是想和父親一樣，",
    "voice": "vo_adv_1057006_040",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "由我們自己的騎空團，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "去進行屬於我們的冒險。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就只有這一點，",
    "voice": "vo_adv_1057006_041",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "怎樣都沒辦法放棄……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n雖然聽起來可能很像在耍任性，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不過即使如此，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這也是我的夢想……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……看來意志相當堅決呢。",
    "voice": "vo_adv_1057006_042",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "真是太可惜了，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "像你們這樣可靠的人，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n可是非常少見的呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "非常抱歉……",
    "voice": "vo_adv_1057006_043",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "喂喂，不要太介意啊！",
    "voice": "vo_adv_1057006_044",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "對到處旅行的我們來說，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這也是常有的事。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不過你們能這麼認真考慮，我很開心呢。",
    "voice": "vo_adv_1057006_045",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "謝謝你們。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我才要說謝謝，",
    "voice": "vo_adv_1057006_046",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "能收到你們的邀請真的很開心！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不能和你們兩位合作真的很可惜，",
    "voice": "vo_adv_1057006_047",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "但是既然心中有無法退讓的事物，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "就沒辦法了。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "希望妳的夢想能夠實現。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是！",
    "voice": "vo_adv_1057006_048",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "非常感謝妳！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那就再見了。",
    "voice": "vo_adv_1057006_049",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "有緣再會吧！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……離開了呢。",
    "voice": "vo_adv_1057006_050",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "對你來說，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這樣就好了嗎？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你果然還是",
    "voice": "vo_adv_1057006_051",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "和他們一起去比較……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝……！",
    "voice": "vo_adv_1057006_052",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "因為你陪在我身邊，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我才能正視自己的心做出回答。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不只是要實現我的夢想，",
    "voice": "vo_adv_1057006_053",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n也得取回你的記憶。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "實現團員的願望，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "也是團長的職責呢。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "接下來也兩個人一起繼續努力吧。",
    "voice": "vo_adv_1057006_054",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "吉塔與{0}緊緊握住對方的手，\\n發誓今後也要兩人一起努力。",
    "voice": null,
    "unit_id": null
  }
]
