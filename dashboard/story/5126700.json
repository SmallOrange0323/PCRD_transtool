  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在臨近期末考的某天放學後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}為了拿忘記的東西而走進教室時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看見正在一個人自習的凱留。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很好……",
    "voice": "vo_adv_5126700_000",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這邊的參考書已經全部記起來了。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼接下來",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就換這本題庫……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哎呀，",
    "voice": "vo_adv_5126700_001",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "{0}……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你忘了拿東西嗎？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都快要考試了還忘記帶課本回家，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n真是迷糊欸～",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯～",
    "voice": "vo_adv_5126700_002",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我要再念一下書。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……你也有",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好好在念書準備考試嗎？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……啊──",
    "voice": "vo_adv_5126700_003",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不用回答沒關係。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我看你的臉就懂了。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哎，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "至少努力不要不及格吧。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不要沮喪得那麼明顯啦……",
    "voice": "vo_adv_5126700_004",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喂，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你幹嘛露出像被遺棄的小貓一樣的眼神！？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼？",
    "voice": "vo_adv_5126700_005",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我為什麼得教你啊。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喂，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別在我回答你之前就開始拿出課本啊！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……我、",
    "voice": "vo_adv_5126700_006",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我知道了啦。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n真拿你沒辦法，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我就教你吧……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……我話說在前頭，",
    "voice": "vo_adv_5126700_007",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這可不是為了你喔！！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只不過是因為教導不會的人，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "自己也可以複習罷了……！！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這些全都是",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "為了我自己準備考試才做的！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "懂了嗎！？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……你明白就好。",
    "voice": "vo_adv_5126700_008",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "既然要教就要徹底一點……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對了……",
    "voice": "vo_adv_5126700_009",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這個，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是我今天在合作社買的鉛筆。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……因為是兩根一組在賣的，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就送給你一根吧。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "{0}！",
    "voice": "vo_adv_5126700_010",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n直到考試前就努力念書，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "把這枝鉛筆用到手握不住的程度吧！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "既然我要教你，",
    "voice": "vo_adv_5126700_011",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你就要以目標成為年級第二名的氣勢來努力！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……你說不用把第一名當目標嗎？",
    "voice": "vo_adv_5126700_012",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼哼，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為第一名會是我的！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了，",
    "voice": "vo_adv_5126700_013",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那我們開始吧！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n把課本打開！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "凱留和{0}兩人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了準備考試，就這樣開始一起念書了。",
    "voice": null,
    "unit_id": null
  }
]
