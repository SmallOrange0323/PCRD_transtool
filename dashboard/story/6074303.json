    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "陽光の力が",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "私の体を、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "この肌を蝕んでいく……！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "やはり",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "私の中に眠る闇の力とは",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "相容れない",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "ということなのか……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "シグルドよ、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "貴様は何か",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "対策をしているのか？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "なんと……！　",
    "voice": "vo_adv_6044303_001",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "閃光のシグルドであっても",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "体が蝕まれるのか！？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "……そうか、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "光の属性であっても",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "太陽と月の光に差があるように",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n向き不向きも存在しているのだな？　",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "なるほど、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "勉強になったぞ。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "む、",
    "voice": "vo_adv_6044303_002",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そうであったか。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "流石は閃光のシグルド、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "光が好きなのだな。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "見た感じでは、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そこまで日焼けしているようには見えないが……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "え？　",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "見るか、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "だと？　",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "……い、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "いやっ、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "それは……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "遠慮しておく。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "ほほう、",
    "voice": "vo_adv_6044303_003",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "既に対策済みとはやるな！　",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "……ん？　",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "村に来る前に塗った？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そんなの効果が切れているではないか！　",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "仕方のないやつだな……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "私が直々に",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "塗り直してやろう、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "さぁ",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "シュテッヒパルム",
    "words": "そこに寝転ぶがよい！",
    "voice": null,
    "unit_id": 113211
  }
]
