[
  {
    "type": "dialogue",
    "name": "ペテルギウス",
    "words": "魔女よ……",
    "voice": "vo_adv_5017211_000",
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "ペテルギウス",
    "words": "魔女よ！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "ペテルギウス",
    "words": "　魔女ヨ！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "ペテルギウス",
    "words": "　魔女ヨォォ！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "ペテルギウス",
    "words": "\\nワタシに愛を……",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "ペテルギウス",
    "words": "寵愛ヲォォ……！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "……完全に",
    "voice": "vo_adv_5017211_001",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "狂気にのまれているわね。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "ラム",
    "words": "狂うなら勝手にしろと言いたいところだけど、",
    "voice": "vo_adv_5017211_002",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "ラム",
    "words": "\\nそうも言ってられないみたい。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "はい。",
    "voice": "vo_adv_5017211_003",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "あの狂気に引きずられるかのように、",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "\\n魔女教徒が、",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "あきらかに強くなっています。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "二人とも、",
    "voice": "vo_adv_5017211_004",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "あれを見て！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "あ、",
    "voice": "vo_adv_5017211_005",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "あれは……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "ラム",
    "words": "まさか、",
    "voice": "vo_adv_5017211_006",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "ラム",
    "words": "あれがシャドウ……！",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "ペコリーヌが言っていたわ。",
    "voice": "vo_adv_5017211_007",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "\\n人の姿をした",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "特殊な魔物が居るって。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "でもまさか、",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "レムとラムの姿にそっくりなんて……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "しかも、",
    "voice": "vo_adv_5017211_008",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "魔女教徒たちと同じように、",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "\\n大罪司教に支配されているようです！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "魔物とはいえ、",
    "voice": "vo_adv_5017211_009",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "レムたちの姿をした存在を",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "\\n魔女教徒にするだなんて……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "レム",
    "words": "絶対に許しません！！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "ラム",
    "words": "……さすがにラムも、",
    "voice": "vo_adv_5017211_010",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "ラム",
    "words": "\\n冷静さを保っていられそうにないわね！",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "二人とも！",
    "voice": "vo_adv_5017211_011",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "\\n私が援護するから、",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "エミリア",
    "words": "思いっきりやっちゃっていいわよ！",
    "voice": null,
    "unit_id": 109911
  }
]
