    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「不對。",
    "voice": "vo_adv_1023004_035",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n若是不克服對蟲的恐懼心，",
