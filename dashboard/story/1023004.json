  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "上啊！",
    "voice": "vo_adv_1023004_000",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉全力揮～擊☆",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……唔唔？",
    "voice": "vo_adv_1023004_001",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n好像",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "有奇怪的手感！？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "唔哇！",
    "voice": "vo_adv_1023004_002",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "有人倒在地上！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "對對對、",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "對不起！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n該不會是",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "被噗吉全力揮擊給直接擊中了！？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「啊……",
    "voice": "vo_adv_1023004_003",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n妳闖禍了，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "綾音。」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「年紀輕輕就成了殺人犯，",
    "voice": "vo_adv_1023004_004",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "真是前途一片黯淡。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n好可憐。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我一定",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "每天都會去監獄探望你的。」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就、就算是開玩笑，也別說那種話！",
    "voice": "vo_adv_1023004_005",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉，你有時候很壞心眼耶～！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "你、你、",
    "voice": "vo_adv_1023004_006",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "你沒事吧？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "欸，咦？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n你該不會是……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "{0}哥哥？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "前陣子讓你送我回家……",
    "voice": "vo_adv_1023004_007",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n還有很多事情，都非常感謝你。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "應該說是託你的福嗎……",
    "voice": "vo_adv_1023004_008",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "胡桃感冒也完全好了，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n請放心♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "話說，",
    "voice": "vo_adv_1023004_009",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "你還好嗎……？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n被噗吉全力揮擊",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n打中了……？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "欸～",
    "voice": "vo_adv_1023004_010",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "正打算要避開，結果沒站穩跌倒了？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n真的嗎？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不是因為顧慮我，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "而隱瞞實話了吧……？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊啊，",
    "voice": "vo_adv_1023004_011",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "膝蓋那裡擦破皮了。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我有帶療傷藥，我來幫你擦藥。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "感覺真對不起，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嘿嘿。",
    "voice": "vo_adv_1023004_012",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n自從前陣子那件事之後，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我就開始向咲戀媽媽",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n請教藥草相關的知識。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這個療傷藥也是，",
    "voice": "vo_adv_1023004_013",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n雖然費了不少工夫，但這是我自己做的。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我技術還不是很好，",
    "voice": "vo_adv_1023004_014",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n可能會沒什麼效果……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "但應該至少能讓人安心",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "吧？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "痛痛、痛痛，",
    "voice": "vo_adv_1023004_015",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "飛走吧～♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "唔呀！？",
    "voice": "vo_adv_1023004_016",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n哥、哥哥你怎麼好像在發光？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n全身",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "都閃閃發亮的～！？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "background",
    "bg_id": "510200"
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗚嗚～",
    "voice": "vo_adv_1023004_017",
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n嗚哇啊……！",
    "voice": null,
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……",
    "voice": "vo_adv_1023004_018",
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "呀唔！？",
    "voice": null,
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "…………",
    "voice": "vo_adv_1023004_019",
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「嗨，{0}小子。",
    "voice": "vo_adv_1023004_020",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n有什麼事嗎？",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n綾音的話，她沒事，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "不用擔心。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「所以我就說她沒事啊。",
    "voice": "vo_adv_1023004_021",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "對吧，綾音？」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「有嗎？",
    "voice": "vo_adv_1023004_022",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n綾音她一直都是這種感覺啊。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「{0}小子才是，\\n不覺得你氛圍和平時不太一樣嗎？」",
    "voice": "vo_adv_1023004_023",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「",
    "voice": "vo_adv_1023004_024",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "應該說是變得更開朗，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n還是感覺變得比較裝熟，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n感覺莫名地有精神。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「很好很好。",
    "voice": "vo_adv_1023004_025",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n看來綾音這傢伙，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n情緒穩定不少了。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「抱歉讓你擔心了。",
    "voice": "vo_adv_1023004_026",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n放心吧，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "她並沒有跌倒受傷，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n也不是被人給欺負",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "之類的事啦。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「就是……",
    "voice": "vo_adv_1023004_027",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n剛才，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n有蜜蜂飛到綾音的身旁。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「啊啊，她並沒有被刺傷，沒事啦。",
    "voice": "vo_adv_1023004_028",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n只是嚇了一跳，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "結果害怕到哭起來。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "她沒有任何地方受傷，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "別擔心。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「以前，",
    "voice": "vo_adv_1023004_029",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n綾音曾經被蜜蜂刺傷過。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n或許就是那次經驗給她留下了陰影……」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「就只有蟲，\\n她一直都不太喜歡，",
    "voice": "vo_adv_1023004_030",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "應該說她似乎很怕蟲。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「只要有蟲接近就會陷入恐慌，",
    "voice": "vo_adv_1023004_031",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n然後失控地大鬧特鬧。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「噗吉全力揮擊啊，",
    "voice": "vo_adv_1023004_032",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "原本就是",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "為了驅趕蟲而創造出來的技能喔。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「拿著手上的包包全力亂揮，",
