    "name": "噗吉",
    "words": "「不過，",
    "voice": "vo_adv_1023004_034",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "有時會不小心打到在附近的人，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n給人造成麻煩……",
