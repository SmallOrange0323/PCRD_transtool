[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──在露娜之塔的某個樓層。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n那裡響起了壞蛋們的悲鳴。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "嘎",
    "voice": "vo_adv_7027003_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "呀──！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可惡～！",
    "voice": "vo_adv_7027003_001",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n從剛剛開始就老是被魔物追著跑耶！？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是妳戰鬥的方式太招搖了吧！？",
    "voice": "vo_adv_7027003_002",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "喊著「天樓霸斷劍」什麼的，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n同時又胡亂發出超醒目的斬擊！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那樣一來",
    "voice": "vo_adv_7027003_003",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "整個樓層的魔物",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n當然都會發現我們啊！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是喔……",
    "voice": "vo_adv_7027003_004",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那麼，我只好負起責任啦！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這裡我來想辦法！",
    "voice": "vo_adv_7027003_005",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你們先走吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不行，不可以！",
    "voice": "vo_adv_7027003_006",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "讓妳單獨行動的話，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我看事情肯定會變得更糟糕！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那種事……",
    "voice": "vo_adv_7027003_007",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也許會發生？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "畢竟我無法分辨陷阱嘛。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "看來妳能理解呢。",
    "voice": "vo_adv_7027003_008",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所有人一起走吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我們可是命運共同體呢！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "命運共同體……",
    "voice": "vo_adv_7027003_009",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這話聽起來很棒耶！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可是啊，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就算這樣逃下去，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也會很快被追上喔？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼哼！",
    "voice": "vo_adv_7027003_010",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我可是天才呢！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n想說可能會有這種情況，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "已經預先準備好了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n……用這個",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "特製煙霧彈！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "魔物們，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "看我的厲害！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "很好，",
    "voice": "vo_adv_7027003_011",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "進行得很順利！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "趁魔物找不到我們的空檔，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "快走吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔呃！？",
    "voice": "vo_adv_7027003_012",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "該、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "該怎麼說呢……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就像完美地忘記這東西的存在……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "現在才想起來之類的……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哈哈！",
    "voice": "vo_adv_7027003_013",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳還真是狡猾耶，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "祈梨！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳對我的做法",
    "voice": "vo_adv_7027003_014",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "有什麼意見嗎！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不是，正好相反！",
    "voice": "vo_adv_7027003_015",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我喜歡這種很像是壞蛋的",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "戰鬥方式！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔……",
    "voice": "vo_adv_7027003_016",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我說，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳還挺了解的嘛！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n沒錯，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我們又不是什麼正義的夥伴！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不管什麼事能做就會去做！",
    "voice": "vo_adv_7027003_017",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n當然，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是在沒有違反壞蛋美學的",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "範疇內！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "呼。",
    "voice": "vo_adv_7027003_018",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "看來是甩開了。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "祈梨，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳比我想得還厲害喔。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n不愧是未來的",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "Big Boss耶！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼哼哼……",
    "voice": "vo_adv_7027003_019",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳可以再多誇一點！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n誇我這個",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "大天才祈梨大人！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過嘛，",
    "voice": "vo_adv_7027003_020",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳也還算努力就是了？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "以妳至今的功勞來看，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要我稍微誇獎妳也行喔，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "矛依未。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "只不過！",
    "voice": "vo_adv_7027003_021",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "拜託妳，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n別再用那把誇張大的劍胡亂招搖地戰鬥了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就算妳這麼說，",
    "voice": "vo_adv_7027003_022",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但我不擅長小家子氣的戰鬥方式耶……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "而且跟{0}敵對的時候開始，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我戰鬥就是這種風格了。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……嗯嗯？",
    "voice": "vo_adv_7027003_023",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳說敵對……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n矛依未，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳曾經與小哥為敵！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "要說敵對嘛，",
    "voice": "vo_adv_7027003_024",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "該怎麼說……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "算了，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "都過去了！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "發生過很多事嘛！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那麼……",
    "voice": "vo_adv_7027003_025",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要是又發生了很多事，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n有可能又與小哥為敵嗎？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂喂喂，",
    "voice": "vo_adv_7027003_026",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我以前也說過吧？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我的對手",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "僅限壞人！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是這樣就好了……",
    "voice": "vo_adv_7027003_027",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "畢竟壞蛋的話不可信。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……妳記好囉，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "矛依未。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "萬一，",
    "voice": "vo_adv_7027003_028",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳又與小哥為敵的話……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "到那時候，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我會率先當妳的對手！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……但我明明比妳",
    "voice": "vo_adv_7027003_029",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "要強得多的說？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那……",
    "voice": "vo_adv_7027003_030",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那種事，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我才不管！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……祈梨，妳變了呢。",
    "voice": "vo_adv_7027003_031",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是朝好的方向改變喔！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦？",
    "voice": "vo_adv_7027003_032",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳說我變了……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "口氣聽起來就像是妳知道以前的我……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "抱歉抱歉，",
    "voice": "vo_adv_7027003_033",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這說法害妳混亂了吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過啊，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n居然想為了某人而跟比自己更強的傢伙而戰，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n之前的妳不會這麼想對吧？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳變成了在重要時刻能展現勇氣，",
    "voice": "vo_adv_7027003_034",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "溫柔而堅強的壞蛋呢。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我認為像妳這樣的人，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就應該成為Big Boss喔！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "喔、",
    "voice": "vo_adv_7027003_035",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "喔喔～？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n妳意外地有眼光呢！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "祈梨，加油吧。",
    "voice": "vo_adv_7027003_036",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n成為Big Boss，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是妳的夢想對吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不用妳說我也會變成Big Boss的！",
    "voice": "vo_adv_7027003_037",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "畢竟其他人可沒有像我這樣",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "具備成為Big Boss的器量！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是在露娜之塔，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n響起了未來的Big Boss（？）的揚聲高笑。",
    "voice": null,
    "unit_id": null
  }
]
