[
  {
    "type": "background",
    "bg_id": "501870"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "LIVE會場擠得水泄不通。觀眾們並不知道「直播主獵人」，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n其實就是高人氣遊戲直播主輝美本人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n只是不斷期待著LIVE趕快開始。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "嗨，",
    "voice": "vo_adv_5102006_000",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "大家好。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "讓你們久等了。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "謝謝大家",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "今天來到這裡。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "哇啊啊啊啊啊啊啊！",
    "voice": "vo_adv_5102006_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "那麼……",
    "voice": "vo_adv_5102006_002",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "首先，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "必須公布一個悲傷的消息。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n這場LIVE，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "原本預定會有當紅的人氣直播主們，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n一起站上這個舞台。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "然而，",
    "voice": "vo_adv_5102006_003",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我想已經有許多人知道了，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "因為「直播主獵人」惡劣的手段，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n他們與她們，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "都無法來到舞台上了。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "大家對我來說，既是競爭對手，",
    "voice": "vo_adv_5102006_004",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "也是",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "互相切磋的夥伴，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n無法跟他們一同舉行LIVE，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我感到非常遺憾……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "但如果在此取消LIVE，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "對他們來說應該也是一件憾事吧。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "因此，本次活動改變了計畫，",
    "voice": "vo_adv_5102006_005",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n變成由我單獨舉辦LIVE的形式",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "來進行……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "給我等一下──！",
    "voice": "vo_adv_5102006_006",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……哎呀。",
    "voice": "vo_adv_5102006_007",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "是小七七香、",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "小鈴。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n還有……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "小智。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n妳們到底",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "為什麼會跑上舞台呢？",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那種事",
    "voice": "vo_adv_5102006_008",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "還用說嗎……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳踐踏了大家「喜歡」的情感，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "必須讓妳受到應有的懲罰才行！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "那個女孩……",
    "voice": "vo_adv_5102006_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "的確是在",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "劍舞時出現的女孩吧……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "\\n再加上還有……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "\\n【暮光流星群】、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "跟橡子遊俠……！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "這到底，",
    "voice": "vo_adv_5102006_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "是怎麼回事……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……哼，",
    "voice": "vo_adv_5102006_011",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "再這樣下去會有點麻煩。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "既然這樣……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "各位！",
    "voice": "vo_adv_5102006_012",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "是不是嚇了一跳呢？",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "不用擔心。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "因為LIVE的預定有所更改，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n我會跟她們一起表演舞台劇！",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "接下來可能會有一些比較激烈的場面……",
    "voice": "vo_adv_5102006_013",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n但是全部都是",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "演技跟戲劇效果，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "所以請大家放心享受！",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "什麼啊，",
    "voice": "vo_adv_5102006_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "原來是在演戲嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "不愧是輝美殿下！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "\\n是一個天生的娛樂表演者！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……好了，",
    "voice": "vo_adv_5102006_015",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "這樣一來，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "從現在開始不論發生什麼事，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "觀眾都會覺得是在演戲。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "不管妳們想要爆料什麼，",
    "voice": "vo_adv_5102006_016",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "大家都會覺得是先設定好的……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n而我如果毫不留情地擊倒妳們，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n也會因為是「劇情設定」，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "而不是我在使用暴力。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "竟然將我們的闖入當作是表演的一環……",
    "voice": "vo_adv_5102006_017",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "必須承認妳果然不是省油的燈……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但是！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不管發生什麼事，",
    "voice": "vo_adv_5102006_018",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我們的目標都不會改變！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我們要守護大家的「喜歡」，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "在這裡打倒妳！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "呵呵呵……",
    "voice": "vo_adv_5102006_019",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "真有趣！",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n看來會變成一齣熱血沸騰的戲碼呢！",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "那妳們就",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "放馬過來吧！",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "先下手為強！",
    "voice": "vo_adv_5102006_020",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n用電腦的閃光來攻擊敵人──！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "background",
    "bg_id": "501870"
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "──哼！",
    "voice": "vo_adv_5102006_021",
    "unit_id": 16711
  },
  {
    "type": "background",
    "bg_id": "501870"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "怎……",
    "voice": "vo_adv_5102006_022",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "怎麼會！？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n她把我的魔法斬破了──！？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "也太誇張了吧！？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n可以做到這種事的，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "怎麼不是只有輕小說跟流夏姐而已啊！？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……呵呵，",
    "voice": "vo_adv_5102006_023",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "不愧是收藏家。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n剛剛的一擊，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "讓我的手腕有點發麻了呢。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我認真的一擊，",
    "voice": "vo_adv_5102006_024",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n妳可以不要只有「手腕發麻」程度而已嗎！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這可是相當棘手啊……！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "──不過，",
    "voice": "vo_adv_5102006_025",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就算再怎麼強，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n也逃不過突然的攻擊吧？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "哦！",
    "voice": "vo_adv_5102006_026",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "真危險……",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "可惡！",
    "voice": "vo_adv_5102006_027",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "被輕而易舉躲過了。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那麼，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "用這招……！",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "background",
    "bg_id": "501870"
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "哼……",
    "voice": "vo_adv_5102006_028",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "聽說妳是【暮光流星群】",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "等級的實力者……",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "但是不論力量或速度，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n都沒什麼大不了的嘛。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "妳有好好在鍛鍊嗎？",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我只是個懶懶散散悠閒打遊戲的玩家。",
    "voice": "vo_adv_5102006_029",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n才不可能認真鍛鍊吧。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "看來的確是如此。",
    "voice": "vo_adv_5102006_030",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "但是……",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "像是一開始的突襲，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n看來妳具有能夠決定勝負關鍵的才能。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我看起來，在一些情況下，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "搞不好還是可以以小搏大的類型呢。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "因此，",
    "voice": "vo_adv_5102006_031",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我不會輕敵的。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "而且瞧不起對手的話，可是會惹人厭呢。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "讓我全力斬了妳吧。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……實力相差這麼大，",
    "voice": "vo_adv_5102006_032",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "而且還不輕敵，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我毫無勝算呢。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那麼，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我還是暫時先退場吧。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "之後就",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "拜託妳了。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "喝啊啊啊！",
    "voice": "vo_adv_5102006_033",
    "unit_id": 123611
  },
  {
    "type": "background",
    "bg_id": "501870"
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……很棒的劍術。",
    "voice": "vo_adv_5102006_034",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "太厲害了。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n這就是御久間流劍術繼承人的實力嗎？",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "太棒了，",
    "voice": "vo_adv_5102006_035",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "竟然鍛鍊到這種程度。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我在妳的年紀時，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n實力完全比不上妳。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "如果妳這樣繼續鍛鍊下去的話，",
    "voice": "vo_adv_5102006_036",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "一定會成為超過我的劍士吧。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "總有一天，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我會輸給妳……",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "但，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "不會是今天！",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "background",
    "bg_id": "501870"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗚……",
    "voice": "vo_adv_5102006_037",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……！？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "力量、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "速度、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "招式的精準……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n果然",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "都在我之上……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但是……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我怎麼能認輸！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳不屑地說",
    "voice": "vo_adv_5102006_038",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "「喜歡」這種感情是很無聊的！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但我認為那是",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "非常珍貴的心情！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我已經",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不打算再隱瞞自己的「喜歡」了！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我……",
    "voice": "vo_adv_5102006_039",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "喜歡玩遊戲！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "喜歡Cosplay、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "喜歡漫畫！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "最喜歡……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "最喜歡魔法少女了！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……「喜歡」……",
    "voice": "vo_adv_5102006_040",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "嗎？",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我過去",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "也有跟妳相同的心情喔。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "但是，",
    "voice": "vo_adv_5102006_041",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我發現比那種情感更重要的東西。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "那就是",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "人們的讚美。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "不過，",
    "voice": "vo_adv_5102006_042",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "有一件事讓我困擾。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n一旦被十個人讚美了，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "下次就想被一百個人讚美。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "一旦被一百個人誇獎了，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "下次就想被一千個人誇獎。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "就算成為蘭德索爾第一的遊戲直播主，我還是覺得不夠。",
    "voice": "vo_adv_5102006_043",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我想要更多的影片觀看次數、",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "更多的按讚數……",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "只有那樣，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我的心才會獲得滿足！",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哎呀～",
    "voice": "vo_adv_5102006_044",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n完全變成了想獲得別人肯定的怪物了。",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "受歡迎也是很辛苦的呢。",
    "voice": "vo_adv_5102006_045",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "一點都不值得同情。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我才不需要妳的同情！",
    "voice": "vo_adv_5102006_046",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n我很滿意現在的自己！",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我接下來也想繼續成為",
    "voice": "vo_adv_5102006_047",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "大家理想的存在！",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "為了達成這個目的，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "就算用盡一切手段，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n我也要持續身為直播主的頂點！",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不管妳有什麼樣的理由，",
    "voice": "vo_adv_5102006_048",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n都不該踐踏他人的「喜歡」！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳知道有多少人因為妳的緣故",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "而感到難過嗎！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "因為直播主獵人的緣故，",
    "voice": "vo_adv_5102006_049",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "許多直播主、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "跟他們的粉絲們，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "都被剝奪了享受他們喜歡的遊戲直播、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "歌曲直播、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "聊天直播的權力……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這種事",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "絕不能原諒！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "而且……",
    "voice": "vo_adv_5102006_050",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n妳自己",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "也不可能認為這樣就好！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……什麼？",
    "voice": "vo_adv_5102006_051",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳",
    "voice": "vo_adv_5102006_052",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "杜撰了許多的謊話……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但一定",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "有一些部分是真的！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "想讓粉絲開心的心情……！",
    "voice": "vo_adv_5102006_053",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "對重要後輩的體貼……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我不認為這些是虛假的！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……妳說妳以前，",
    "voice": "vo_adv_5102006_054",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n喜歡遊戲跟劍舞，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n也一定不是謊言。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……妳之所以會成為直播主，",
    "voice": "vo_adv_5102006_055",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n一定不是為了做這些事吧。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n而是妳想把自身喜歡的東西跟大家分享才開始直播的！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "現在的妳，",
    "voice": "vo_adv_5102006_056",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "背叛了粉絲，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "連過去的自己都背叛了！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n妳明白嗎！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……就算如此，",
    "voice": "vo_adv_5102006_057",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "又能怎樣呢？",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "事到如今，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "已經太遲了。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我已經無法變回",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "從前的自己了。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我會繼續走在這條荊棘之道上！",
    "voice": "vo_adv_5102006_058",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n只要是妨礙我的人，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我都會全力排除掉！",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不會讓妳稱心如意的……！",
    "voice": "vo_adv_5102006_059",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "一定會在這裡阻止妳！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那麼那麼，",
    "voice": "vo_adv_5102006_060",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "第二輪對決……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "開始吧！",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "movie",
    "movie_id": "510200601"
  },
  {
    "type": "background",
    "bg_id": "501870"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是我們的……",
    "voice": "vo_adv_5102006_061",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "勝利。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……然後，",
    "voice": "vo_adv_5102006_062",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "接下來要怎麼辦？",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "也不是說打倒她，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雙手一攤就結束了吧。",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……咦，",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗚哇……",
    "voice": null,
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "唔唔",
    "voice": "vo_adv_5102006_063",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……！？",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "站、",
    "voice": "vo_adv_5102006_064",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "站起來了──！？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "還想做什麼！？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……不，",
    "voice": "vo_adv_5102006_065",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "看來她好像沒有要戰鬥的意思了。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……抱歉，",
    "voice": "vo_adv_5102006_066",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "小智。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "似乎是我錯了。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……我終於明白了。",
    "voice": "vo_adv_5102006_067",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n其實我……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "很羨慕",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "小智妳們。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "對於自己喜歡的東西，純粹而耀眼的心情……",
    "voice": "vo_adv_5102006_068",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n當我看到這麼純粹的妳們、",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "還有其他的直播主們，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "彷彿看到了過去的自己……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "所以感到非常嫉妒。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……以前，",
    "voice": "vo_adv_5102006_069",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "接觸自己喜歡事物時總會覺得很興奮。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "喜歡的遊戲、",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "喜歡的漫畫、",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "喜歡的Cosplay……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "被「喜歡」所圍繞的日子，就像是我的寶物……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "那時候真的好快樂。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "但是……",
    "voice": "vo_adv_5102006_070",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "現在又如何呢？",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n不管接觸什麼東西，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我都無法再感覺到快樂。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……我",
    "voice": "vo_adv_5102006_071",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "沒辦法貫徹自己的「喜歡」。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……輝美小姐。",
    "voice": "vo_adv_5102006_072",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……會場的各位！",
    "voice": "vo_adv_5102006_073",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "聽我說！",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n這些不是在演戲！",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "全部都是",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "事實！",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "什……",
    "voice": "vo_adv_5102006_074",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "什麼意思……！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……「直播主獵人」的真實身分，",
    "voice": "vo_adv_5102006_075",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "還有把文化祭弄得亂七八糟的人……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "都是我！",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "騙人的吧……！？",
    "voice": "vo_adv_5102006_076",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "\\n輝美殿下竟然……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "很抱歉，但這些都是事實。",
    "voice": "vo_adv_5102006_077",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我背叛了你們……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "真的非常對不起大家。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……小智，",
    "voice": "vo_adv_5102006_078",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "對不起。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "還有……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "謝謝妳。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n多虧了妳，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我才能想起重要的事。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "重要的事……",
    "voice": "vo_adv_5102006_079",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "對創作內容的熱情……",
    "voice": "vo_adv_5102006_080",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n對喜歡的事物純粹的愛，是非常棒的一件事。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "希望妳不會忘記",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "這份心情。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "不要變成像我一樣。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……一開始的時候，",
    "voice": "vo_adv_5102006_081",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我真的，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n是因為能在直播中跟大家分享喜歡的東西而感到開心。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "僅只是",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "如此罷了。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "但是當",
    "voice": "vo_adv_5102006_082",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "觀看次數、按讚數不斷成長，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n我就誤以為那是最重要的……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n……我太想要獲得他人的肯定，而迷失了。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……是我太軟弱了。",
    "voice": "vo_adv_5102006_083",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "所以才會像這樣",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "走錯了路。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我現在終於",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "察覺到這件事。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……我會彌補我的罪行。",
    "voice": "vo_adv_5102006_084",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "然後，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "等我贖罪完，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n我會再次正視",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "自己喜歡的東西。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "如果有一天能夠跟小智一起",
    "voice": "vo_adv_5102006_085",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "互相談論自己喜歡的東西，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n那就好了……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_5102006_086",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我會期待著",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那一天到來的。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "……謝謝。",
    "voice": "vo_adv_5102006_087",
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "能夠認識妳……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "認識妳們真是太好了。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "那就再見了……",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "直到再次相逢的日子，",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "再會。",
    "voice": null,
    "unit_id": 16712
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然後，輝美呼喚了【王宮騎士團】的成員，自願被捕。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n智久久凝視著這個迷失在讚美聲中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n悲哀的直播主的背影。",
    "voice": null,
    "unit_id": null
  }
]
