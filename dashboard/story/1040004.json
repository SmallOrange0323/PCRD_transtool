[
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "午安！",
    "voice": "vo_adv_1040004_000",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n今天我們BB團也要好好加油喔……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那麼，我們先做熱身運動吧。",
    "voice": "vo_adv_1040004_001",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我覺得交朋友的資本就是體力……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "一、",
    "voice": "vo_adv_1040004_002",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "二、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "三、四……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呼……為了交朋友而努力所流出的汗水，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n看起來好像閃閃發亮呢……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "汗水的確在發亮……",
    "voice": "vo_adv_1040004_003",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦？不、不對，汗水真的在發亮嗎！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "光線越來越強烈了……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呀、",
    "voice": "vo_adv_1040004_004",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呀啊啊啊啊啊啊！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "background",
    "bg_id": "510200"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在公園\\n看到碧和小鳥說話。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，午安……",
    "voice": "vo_adv_1040004_005",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這個嘛，我是在和小鳥說話。",
    "voice": "vo_adv_1040004_006",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n這是為了某天交到朋友時先做的練習……",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……請你什麼都不要說……",
    "voice": "vo_adv_1040004_007",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我知道……我這樣子做……",
    "voice": "vo_adv_1040004_008",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n很明顯是個怪人。",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是因為奇怪所以才沒有朋友嗎……",
    "voice": "vo_adv_1040004_009",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦……為什麼……？",
    "voice": "vo_adv_1040004_010",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你不覺得跟小鳥說話的我有點奇怪嗎……？",
    "voice": "vo_adv_1040004_011",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……蛤？",
    "voice": "vo_adv_1040004_012",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，呃，",
    "voice": "vo_adv_1040004_013",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n你不可以對著郵筒的投遞口說話……！",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "大家在用奇怪的眼光看你呢……！",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊啊，就算不用大叫",
    "voice": "vo_adv_1040004_014",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "「現充滾開吧」，",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n大家也會走開的……！",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我、我知道了，你比我奇怪……",
    "voice": "vo_adv_1040004_015",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但是，個性奇怪和有沒有朋友是兩回事。",
    "voice": "vo_adv_1040004_016",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我才是沒有朋友的人。這一點就算是軟弱的我，",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n也不會退讓的！",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "在沒有朋友這一點上我絕不讓步！",
    "voice": "vo_adv_1040004_017",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒、沒有朋友到哪種程度？我、我啊！",
    "voice": "vo_adv_1040004_018",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我沒有朋友到……",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n買了兩台電動遊戲機一個人玩對戰遊戲！",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "怎、怎麼樣啊……！？",
    "voice": "vo_adv_1040004_019",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這、這個……！",
    "voice": "vo_adv_1040004_020",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n這完全沒有任何策略，只不過是圖案配對遊戲吧……！",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這樣怎麼可能會有趣！",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那、那樣……！",
    "voice": "vo_adv_1040004_021",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不就會知道是誰拿到鬼牌，",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n超級浪費時間的不是嗎……！",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我、我輸了……就連沒有朋友這點，",
    "voice": "vo_adv_1040004_022",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我也贏不過你……",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n不愧是BB團的團長……",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我已經……失去自信了……",
    "voice": "vo_adv_1040004_023",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n不單是朋友，我什麼都沒有了……",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦……我還有什麼……？",
    "voice": "vo_adv_1040004_024",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我、我有我的生存之道……？",
    "voice": "vo_adv_1040004_025",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這樣的我……",
    "voice": "vo_adv_1040004_026",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n也能充滿自信地活下去……",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n帶著沒有朋友的寂寞心情",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "繼續生活嗎……！？",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "{0}……我……我，",
    "voice": "vo_adv_1040004_027",
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n非常地很高興！",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "能加入BB團真是太好了！",
    "voice": null,
    "unit_id": 104031
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "明天起，BB團也要繼續加油……！",
    "voice": "vo_adv_1040004_028",
    "unit_id": 104031
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，辛苦了～",
    "voice": "vo_adv_1040004_029",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛剛看見的，是如同夢境一般的情景唷。",
    "voice": "vo_adv_1040004_030",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我想你醒來以後很快就會忘記的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以沒關係，現在不用太在意哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話雖如此……以前的你，",
    "voice": "vo_adv_1040004_031",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n好像太激進了吧……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你仇視現充嗎……？",
    "voice": "vo_adv_1040004_032",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我覺得那樣有點太過頭了……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n像現在這樣冷靜的反應比較好呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "總之，收集更多的記憶碎片……",
    "voice": "vo_adv_1040004_033",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n去挖掘這個世界的謎底吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這樣我就會再讓你做「夢」的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次見囉～ ♪",
    "voice": "vo_adv_1040004_034",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呃，這裡是哪裡啊……？",
    "voice": "vo_adv_1040004_035",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "精靈之森……",
    "voice": "vo_adv_1040004_036",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n咦，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你也做了同樣的夢嗎？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真是不可思議呢……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但話說回來，",
    "voice": "vo_adv_1040004_037",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n你竟然這麼執著於和我競爭誰才是沒朋友的人，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n總覺得很有趣……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊……！",
    "voice": "vo_adv_1040004_038",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這個有趣是好的意思，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n請不要生氣喔……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "總之，我覺得很有趣、很開心，",
    "voice": "vo_adv_1040004_039",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我覺得和你越來越親近了！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我也覺得BB團要更努力才行！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "從那天之後，\\n碧就越來越信任{0}了……",
    "voice": null,
    "unit_id": null
  }
]
