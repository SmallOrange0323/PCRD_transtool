[
  {
    "type": "background",
    "bg_id": "500033"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]碧卡拉增加了老鼠耳朵的庫存，再次來到跳蚤市場擺攤。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n就在某一天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n她抓住人潮變少的時機，稍作短暫的休憩。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]那個……",
    "voice": "vo_adv_5118072_000",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n不好意思，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]那邊的陽光少女……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n方便打擾妳一下嗎？",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]哎呀，",
    "voice": "vo_adv_5118072_001",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]這肯定是在說我囉♪",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]那個，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]請問妳是……？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]我叫做忍。",
    "voice": "vo_adv_5118072_002",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n目前在此",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]開設一家占卜攤位……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]原來如此，",
    "voice": "vo_adv_5118072_003",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]妳是占卜師呀！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]難怪妳散發一種神祕的氛圍呢。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]尤其是這個骷髏頭裝飾，感覺──",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]世上哪有我這麼紳士的裝飾啊～！！",
    "voice": "vo_adv_5118072_004",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]骷、",
    "voice": "vo_adv_5118072_005",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]骷髏頭說話了！？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]沒錯，",
    "voice": "vo_adv_5118072_006",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]我說話啦！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]\\n有沒有嚇到啊，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]小丫頭！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]哇哈哈哈！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "冬麥斯",
    "words": "[FFFFFFFF]──！",
    "voice": null,
    "unit_id": 9711
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]嘎啊────！！",
    "voice": "vo_adv_5118072_007",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]\\n有個會動的巨大捕獸夾────？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]爸爸，",
    "voice": "vo_adv_5118072_008",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]你安靜。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]……事情就是這樣，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]這是我的父親。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]這樣是哪樣呀！？",
    "voice": "vo_adv_5118072_009",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]不、",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]不過……",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]事情背後難免會有些隱情嘛！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]那我也自我介紹吧！",
    "voice": "vo_adv_5118072_010",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n我是碧卡拉，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]來自東國的鼠神宮喔！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]來吧，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]跟我來個初次相遇的握手！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]這位爸爸就……",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]送你一個眨眼代替♪",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]妳就是那位有名的，",
    "voice": "vo_adv_5118072_011",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]鼠神宮的碧卡拉嗎……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n我有耳聞許多關於妳的事……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]也難怪我從妳身上感受到力量。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]看來出聲叫住妳是對的。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]確實，",
    "voice": "vo_adv_5118072_012",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]這傢伙潛藏著不少力量啊。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]\\n雖然，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]還比不上我啦！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]這樣一直誇，我會害羞的啦！",
    "voice": "vo_adv_5118072_013",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]所以呢，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]為什麼妳要出聲叫住我呀？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]嗯，",
    "voice": "vo_adv_5118072_014",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]其實是……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n我想邀請",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]碧卡拉務必來試試看這邊的這一個占卜道具。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]這……",
    "voice": "vo_adv_5118072_015",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]是水晶之類的嗎？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]看起來是挺奇特的道具呢。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]這是",
    "voice": "vo_adv_5118072_016",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]我最近拿到手的道具。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]只要將手靠近水晶，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]其就會放射出十道光輝……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n可以藉著那些光輝的",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]顏色和比例來占卜運勢。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]感覺是很炫目的演出方式呢！",
    "voice": "vo_adv_5118072_017",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]如果是這樣，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]我確實會想嘗試看看喔！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]我看看……",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]是不是像這樣就可以了？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]這、",
    "voice": "vo_adv_5118072_018",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]這是……！",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]竟、",
    "voice": "vo_adv_5118072_019",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]竟然……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]全都是七彩光輝──！？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]哎呀呀！",
    "voice": "vo_adv_5118072_020",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n瞧你們的反應，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]我是不是做出什麼不得了的事呢？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]七彩光輝代表運勢非常強，",
    "voice": "vo_adv_5118072_021",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]其次是金色、",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]最後才是藍色光輝……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n沒想到妳的結果",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]竟然十道全是七彩光輝……！",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]也就是說，",
    "voice": "vo_adv_5118072_022",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]我的運勢超級好對吧！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]不過，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]這也是理所當然的事喔。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n畢竟我可是──",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]Lucky！",
    "voice": "vo_adv_5118072_023",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]Cookie！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]碧奇！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n所以囉♪",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n哈哈！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "background",
    "bg_id": "500035"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]接著，當天晚上──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]時間也已經很晚了……",
    "voice": "vo_adv_5118072_024",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]今天就差不多到這裡吧，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]爸爸。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]也是！",
    "voice": "vo_adv_5118072_025",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]\\n就趕快把店收一收，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]去找身材豐滿的大姐姐一起吃飯──",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]爸爸……？",
    "voice": "vo_adv_5118072_026",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]噫～！",
    "voice": "vo_adv_5118072_027",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]忍好恐──",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]\\n嗯？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]\\n這個氣息是……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]……我也感受到了。",
    "voice": "vo_adv_5118072_028",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n是非常強烈的陰之氣息……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]會是有什麼煩惱的人嗎……？",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]今天也好累人唷……",
    "voice": "vo_adv_5118072_029",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]雖然老鼠耳朵成功賣光是很不錯啦……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]總之去買點起司就回家吧……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]那個……",
    "voice": "vo_adv_5118072_030",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n不好意思，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]那邊的……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]呃……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]黑髮少女。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n方便打擾妳一下嗎？",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]……！？",
    "voice": "vo_adv_5118072_031",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n是、",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]是在說人家嗎……？",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]是的。",
    "voice": "vo_adv_5118072_032",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n那個……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]如果不介意，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]可以讓我替妳占卜嗎？",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]若是妳有什麼煩惱，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]我相信可以幫上忙的。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]咦，",
    "voice": "vo_adv_5118072_033",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]人家沒有任何煩惱呀……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]但應該是我看起來太陰沉，讓對方這麼覺得了……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n不能讓她因此浪費時間在我身上……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]那、",
    "voice": "vo_adv_5118072_034",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]那個……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n人家可以使用",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]擺在那邊的奇特水晶進行占卜嗎……？",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]如果是這個，",
    "voice": "vo_adv_5118072_035",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]只要把手靠過去很快就可以結束了……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]妳想進行運勢占卜嗎？",
    "voice": "vo_adv_5118072_036",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]那麼……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]還請將手放過來，靠近水晶。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]好、",
    "voice": "vo_adv_5118072_037",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]好的……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]這、",
    "voice": "vo_adv_5118072_038",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]這是……！",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]竟、",
    "voice": "vo_adv_5118072_039",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]竟然全部……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]都是藍色──！？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]\\n這運勢根本弱到爆了啊！！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]爸爸！",
    "voice": "vo_adv_5118072_040",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]運、",
    "voice": "vo_adv_5118072_041",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]運勢……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]弱到爆……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]那、",
    "voice": "vo_adv_5118072_042",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]那個……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]還請不要太過沮喪。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n畢竟一個人的運勢是會變化的……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]今天只是碰巧運勢較差，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]也是有這種情況……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]呃……",
    "voice": "vo_adv_5118072_043",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]對了，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]這個水晶就送給妳吧。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]之後有機會再請妳自己進行占卜。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]真、",
    "voice": "vo_adv_5118072_044",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]真的可以嗎……？",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]是的。",
    "voice": "vo_adv_5118072_045",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]這也並非什麼高價的物品。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]\\n……我相信",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]妳的運勢一定會改變的。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]還請不要放棄。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]碧卡拉從忍手中接下水晶，道謝後便轉身離去。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n而忍則是目送著少女的背影，靜靜地祈求她能獲得幸福。",
    "voice": null,
    "unit_id": null
  }
]
