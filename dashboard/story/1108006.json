[
  {
    "type": "background",
    "bg_id": "500390"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "星期天的早晨。\\n沒有待辦行程的克蘿依，\\n在尋找單日的打工。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "『輔助派送業務，",
    "voice": "vo_adv_1108006_000",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "日薪可談，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "性別年齡不限』",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗎……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯……",
    "voice": "vo_adv_1108006_001",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n雖然搞不太清楚，不過就選這個好了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "聯絡地址是……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "所以，",
    "voice": "vo_adv_1108006_002",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n只是搬運行李或信件到牧場",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這樣簡單的工作。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "詳情妳直接詢問",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "現場的人就好了。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我知道了――。",
    "voice": "vo_adv_1108006_003",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳隸屬於F組。",
    "voice": "vo_adv_1108006_004",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n組長已經在大馬路上等著了，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "快點過去。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "另外問一下，",
    "voice": "vo_adv_1108006_005",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳有戰鬥經驗嗎？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啥？",
    "voice": "vo_adv_1108006_006",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n不，雖然不知道你為什麼這麼問，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "算有吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n因為我是在較複雜的環境長大的，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "大概還能處理。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這樣啊，",
    "voice": "vo_adv_1108006_007",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那萬一發生了什麼事應該也處理得了呢。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "其實在路途上――",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "在地圖的這附近有目擊到",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n魔物的通報呢。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，",
    "voice": "vo_adv_1108006_008",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "第一次聽說。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n原來會出現啊，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那裡。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "之前想野餐之類的",
    "voice": "vo_adv_1108006_009",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n有帶弟弟們去過，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我只記得是座悠閒寧靜的森林啊――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "就是啊。",
    "voice": "vo_adv_1108006_010",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n發出注意警告，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "也不過是幾天前的事。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "警告。",
    "voice": "vo_adv_1108006_011",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "雖然這麼說，",
    "voice": "vo_adv_1108006_012",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不過也只是一隻離群的魔物",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "在徘徊而已。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "雖然",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "騎士團好像已經立刻去討伐了，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n但目前連找都沒找到。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "反過來說，",
    "voice": "vo_adv_1108006_013",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "能碰到那傢伙的機率",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "也不大就是了。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n只要不是運氣太差，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "應該能",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "平安度過吧。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n不用想太多。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "唉，",
    "voice": "vo_adv_1108006_014",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，無所謂啦反正我也什麼都不知道……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "啊啊、",
    "voice": "vo_adv_1108006_015",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "還有。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "關於妳的組的組長――",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "――雖然也許有點粗心，",
    "voice": "vo_adv_1108006_016",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不過很認真工作，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "以做人處事來說",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是個好人。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n幫我好好",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "照顧他。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "麻煩妳啦。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": "vo_adv_1108006_017",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "　什麼意思？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n咦，不是反過來嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n怎麼反倒要我來照顧……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "帶領？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哈哈哈。",
    "voice": "vo_adv_1108006_018",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你在笑什麼。",
    "voice": "vo_adv_1108006_019",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，我不懂我不懂，完全無法理解。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n到底是什麼人物，那個組長。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_1108006_020",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "原來是這樣――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "組長是這個人啊――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話說，又來了。",
    "voice": "vo_adv_1108006_021",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n怎麼又是你啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n該說是命運嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "而且雖然稱作是「組」，",
    "voice": "vo_adv_1108006_022",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "成員卻只有一個人。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n加上我也勉強只有兩個人。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n那不就只有一直在迷路的人&店員雙人組嘛。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那當然！",
    "voice": "vo_adv_1108006_023",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "讓有迷路問題的人當配送員的話，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我們國家的郵政系統就會出問題了啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "全蘭德索爾的人都要驚呆了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，不……",
    "voice": "vo_adv_1108006_024",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "等一下……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n該不會，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你每次說迷路的時候，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "都是正在配送工作中……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，",
    "voice": "vo_adv_1108006_025",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "還是算了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不要問好了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "有可能會出現我無法解決的嚴重社會問題。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "欸――",
    "voice": "vo_adv_1108006_026",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那麼轉換一下氣氛――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我是今天來幫忙的臨時工克蘿依。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "請多指教～",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話說，",
    "voice": "vo_adv_1108006_027",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "和平常的立場相反，總覺得有點混亂……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "{0}不覺得嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好天真無邪啊。",
    "voice": "vo_adv_1108006_028",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "算了，不過……",
    "voice": "vo_adv_1108006_029",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是無所謂啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": "vo_adv_1108006_030",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "哎呀，",
    "voice": "vo_adv_1108006_031",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n剛剛突然很火大，下意識就拔出短劍了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n而且差點就要繞到背後刺穿喉嚨了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦？",
    "voice": "vo_adv_1108006_032",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "　不是指這個？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "　因為可能會遇到魔物？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n啊啊，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "擔心我的安全嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話也省略太多了吧……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "算了，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "無所謂。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那麼，",
    "voice": "vo_adv_1108006_033",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就先出發吧――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "要運送到牧場的行李就是這個吧？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嘿咻。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，",
    "voice": "vo_adv_1108006_034",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "沒關係啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我也是來工作的，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你姑且也算是個組長。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦？",
    "voice": "vo_adv_1108006_035",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這樣嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那你都說成這樣了，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就交給你了……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那傢伙是怎樣……",
    "voice": "vo_adv_1108006_036",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "工作時，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "看起來就可靠了點嘛……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "哼……",
    "voice": "vo_adv_1108006_037",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真囂張。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好，我收回之前說的話。",
    "voice": "vo_adv_1108006_038",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n完全不可靠――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這個組長，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "馬上就迷路了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，騙人吧。",
    "voice": "vo_adv_1108006_039",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "因為，我記得",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就我拿到的地圖――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "――你看，果然。",
    "voice": "vo_adv_1108006_040",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n已經相當偏離規定的路線不是嘛。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "很拼命。（笑）",
    "voice": "vo_adv_1108006_041",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，那什麼藉口，",
    "voice": "vo_adv_1108006_042",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "超無法理解。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n有聲音傳來，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "什麼的――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "少女的聲音",
    "words": "呀啊啊啊啊啊！",
    "voice": "vo_adv_1108006_043",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "――！",
    "voice": "vo_adv_1108006_044",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n有人被襲擊了！？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――吼喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "不、",
    "voice": "vo_adv_1108006_045",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "不要啊啊！",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "噫，",
    "voice": "vo_adv_1108006_046",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "不要過來――！",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那些女孩子……！",
    "voice": "vo_adv_1108006_047",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "明明發出了注意警告，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "在這種地方做什麼――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊啊，",
    "voice": "vo_adv_1108006_048",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "同年級的學生。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "當然。",
    "voice": "vo_adv_1108006_049",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我衝過去引開注意力，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n{0}趁那段時間把那些女孩子――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊！？",
    "voice": "vo_adv_1108006_050",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n等等……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這是什麼，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "身體變的超級輕……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n咦？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "　是你的魔法……？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "算了無所謂，",
    "voice": "vo_adv_1108006_051",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "等等再聊！",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這樣的話就能馬上結束……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呼！",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "噗……",
    "voice": "vo_adv_1108006_052",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n好煩啊，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "怪物。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "玩鬧過頭了唷。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "啊，",
    "voice": "vo_adv_1108006_053",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "啊啊啊……？",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "　克蘿依……？",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你看。",
    "voice": "vo_adv_1108006_054",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我的朋友，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "現在很害怕啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "可以安靜一點嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "噗呼……",
    "voice": "vo_adv_1108006_055",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "已經沒事了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n沒受傷吧？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "沒、",
    "voice": "vo_adv_1108006_056",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "沒、",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "沒事……",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "妳要顫抖到什麼時候。",
    "voice": "vo_adv_1108006_057",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就說沒事啦，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "魔物已經完全打扁囉。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n吶，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "還站得起來嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "咿咿咿！",
    "voice": "vo_adv_1108006_058",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
