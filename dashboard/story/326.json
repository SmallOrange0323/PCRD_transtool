[
  {
    "type": "dialogue",
    "name": "３人",
    "words": "「流星☆隕星！」\\n「羅剎涅槃‧《霸極》萬象無盡冥壞破──！」\\n「幻影地獄！」",
    "voice": "vo_adv_0000326_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "蜘蛛型魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 50011
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "剩下的魔物",
    "voice": "vo_adv_0000326_001",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "似乎被大家打倒了呢──！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小初音",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "差不多……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼啊……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……呼嚕呼嚕……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "哎呀～",
    "voice": "vo_adv_0000326_002",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "居然露出像小孩一樣的睡臉。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n……但是……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "嗚，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這小姑娘身材不錯呢～",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n如果她再多一點大人的色香的話──",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "居然一直盯著睡著的女孩子看……",
    "voice": "vo_adv_0000326_003",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n你想像剛剛被打倒的阿剌克涅的部下的魔物一樣，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n進入永眠嗎？",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "噫！？",
    "voice": "vo_adv_0000326_004",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n等等，忍！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "爸爸已經死了啊～！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "說到永眠──",
    "voice": "vo_adv_0000326_005",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "了！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "下個的舞台是",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "冥界吉歐‧尼布爾黑爾！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我推測那是我靈魂的故鄉！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "等待著我們的會是",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "黑暗之神或是地獄之神──",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "永恆黑暗的公主",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "跟吉格魯特他們到哪去了？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──妳是說",
    "voice": "vo_adv_0000326_006",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "薇歐莉特公主他們嗎。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n他們回去",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "原本的世界了──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "騎士一行人",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "也一起去了。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗚哇啊！？",
    "voice": "vo_adv_0000326_007",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "怎麼這樣……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我本來想讓他們帶我去的說～！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是說吉格魯特也先跑去，太狡猾了啦～！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "現在追上去的話，",
    "voice": "vo_adv_0000326_008",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "或許能馬上就跟他們會合喔。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……我也",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "對幽靈們居住的國度",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "有興趣。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "好──",
    "voice": "vo_adv_0000326_009",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "既然如此我們就立刻出發吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "潛伏於冥界的",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "永恆黑暗的居民們啊！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n你們就顫抖著地等待著",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "疾風之冥姬的凱旋吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "初音，",
    "voice": "vo_adv_0000326_010",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "要走了喔。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "初音……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "她完全沒反應呢。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n不好意思，杏奈。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我會把初音一起拖去的，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n妳可以來幫忙我嗎？",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "咦……",
    "voice": "vo_adv_0000326_011",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "喂，初音！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "下個世界在等著我們啊──！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "醒～來～啦～！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "真拿她沒辦法。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "忍！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "數到三要一起拖她喔！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n一二三──！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗚唔唔～！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕……",
    "voice": "vo_adv_0000326_012",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯嗯……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我還吃得下喔……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……",
    "voice": "vo_adv_0000326_013",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──路上",
    "voice": "vo_adv_0000326_014",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "小心。",
    "voice": null,
    "unit_id": 129612
  }
]
