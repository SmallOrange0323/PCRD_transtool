  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在【王宮騎士團】體驗到各式各樣業務的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n茉莉與{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n王宮騎士對他們的信賴越來越深，兩人也體會到彼此的成長。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "一開始被分配到失物招領管理人的職位時，",
    "voice": "vo_adv_1005011_000",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我還很擔心自己的未來呢……",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過最近，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我覺得自己",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "身為團員有了很大的進步！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "要幫上鎮上的人的忙，",
    "voice": "vo_adv_1005011_001",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不光是打敗壞蛋而已，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n也有著許多不同方式──",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這是我最近學到的。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "還有不少事情，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是我需要學習的呢。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過，",
    "voice": "vo_adv_1005011_002",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "只要按照這個步調，我馬上就能成為能獨當一面的……",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n怎麼",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "身體好像在發光？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "之前好像",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也發生過類似的事……",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "呀啊～～！？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "background",
    "bg_id": "510124"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗚嗚……",
    "voice": "vo_adv_1005011_003",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "噎嗚……！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我還是不能接受！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "應該要",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "平等對待每一個人才對吧！？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "可是，",
    "voice": "vo_adv_1005011_004",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我一直很期待",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "能到遊樂園坐碰碰車耶！？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我還先看導覽手冊",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "預習有哪些車子，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n甚至已經決定好",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "要搭哪一台了……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "結果身高居然只差一公分！！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……你說都已經是一個星期前的事情了，",
    "voice": "vo_adv_1005011_005",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "別再去糾結了？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "{0}大哥也和爸爸說同樣的話嗎！？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大家",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "都不了解我的悲傷啊～～！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "雖然",
    "voice": "vo_adv_1005011_006",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你們都說等到我長高一點再去遊樂園就好，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但是誰知道身高什麼時候才會長高呢……？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我也很想",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "快點長得跟大哥一樣高啊。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……怎麼了嗎？",
    "voice": "vo_adv_1005011_007",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "幹嘛一直盯著我看？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你說你很期待看到我",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "長大之後會變成什麼樣子？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗯──",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就是身高變高了而已，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "其他應該不會有什麼變化吧？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過，",
    "voice": "vo_adv_1005011_008",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我爸爸跟媽媽",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "在小時候跟現在，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "長相也完全不同。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n難道說，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我長大之後",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也會變得跟現在完全不同一個人嗎？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我開始",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "有點擔心起來了……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這種事情查得出來嗎？",
    "voice": "vo_adv_1005011_009",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……圖像加工軟體",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "「增齡模擬器」？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那是什麼",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "東西啊？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "只要照了某個人的照片，",
    "voice": "vo_adv_1005011_010",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "AI就會預想那個人未來的模樣，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n再把長相加工成未來模樣的軟體……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦咦！？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好厲害喔！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "感覺很有趣！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我想玩玩看～～！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊，",
    "voice": "vo_adv_1005011_011",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "可是，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "可以先",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "讓大哥試試看嗎？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n因為我也很好奇大哥未來會長什麼樣子啊♪",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "謝謝！",
    "voice": "vo_adv_1005011_012",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n那你",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "手機就先借我一下囉。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "看我這邊～～！",
    "voice": "vo_adv_1005011_013",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "來，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "笑一個！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……接著，",
    "voice": "vo_adv_1005011_014",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就是設定要老多少歲對吧。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n就隨便",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "設定個五十年後好了。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "喔喔，",
    "voice": "vo_adv_1005011_015",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "照片真的變成老爺爺了！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "長相雖然是有改變，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過還是",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "帶著原本的氛圍，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n看得出來是大哥呢。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這個軟體",
    "voice": "vo_adv_1005011_016",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "感覺非常精準呢！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "一想到要自己來試，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就開始有點緊張起來了。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "沒有啦，",
    "voice": "vo_adv_1005011_017",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我當然不會臨陣退縮！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "可是，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我也不太想看到自己變成奇怪的臉呢……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大哥",
    "voice": "vo_adv_1005011_018",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也要在旁邊一起看？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這不知道該感到安心，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "還是感到不安耶……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不管變成什麼樣子，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你都不准笑喔！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……你說",
    "voice": "vo_adv_1005011_019",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "一定會變成",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "像英雄一樣帥氣的大人？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "聽到大哥這麼說，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我好像",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也有這種預感了！！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "鼓起勇氣～～！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好，",
    "voice": "vo_adv_1005011_020",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "笑一個！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……照得還好吧？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "怎麼樣！？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "設定是……",
    "voice": "vo_adv_1005011_021",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你幫我設成10年後啊。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "的確，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這個年紀的話我也變成大人了！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n不知道變成什麼樣了呢～～？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "still",
    "still_id": "100501101"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦……？",
    "voice": "vo_adv_1005011_022",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦咦～～！？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我變成",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大人之後是這種感覺嗎！？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "跟我想像的不一樣～～！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "因為，",
    "voice": "vo_adv_1005011_023",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這個，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這個……！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "呃，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "該怎麼說呢……！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我不想被這樣講！",
    "voice": "vo_adv_1005011_024",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我是想要",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "變成像虎虎那樣",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "帥氣的大人啊！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不是這種的啊～～！！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你趕快把這張照片刪掉！",
    "voice": "vo_adv_1005011_025",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是說啊，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "要是頭髮這麼長的話，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就不能跟壞蛋戰鬥啦！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n會勾到東西",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "很危險耶！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "口紅看起來也很成熟？",
    "voice": "vo_adv_1005011_026",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我也不想聽那種感想啦！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我才",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不會化什麼妝呢！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大哥，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你絕對",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是在尋我開心！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你、",
    "voice": "vo_adv_1005011_027",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你說沒那回事……？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n你真的",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "覺得這個我很漂亮……？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "雖和料想的不同，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但也是很棒的大人……？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是、",
    "voice": "vo_adv_1005011_028",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是這樣嗎……？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "該不會只有我自己不知道，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但其實對大人們來說，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n這種感覺才是",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "「很棒的大人」",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗎……？　",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "的確，",
    "voice": "vo_adv_1005011_029",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "照片裡穿的衣服",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "真的非常漂亮。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n雖然現在的我絕對不適合這種衣服。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "該怎麼說呢……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "很多地方，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "還不太夠。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "still",
    "still_id": "100501102"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那個～～",
    "voice": "vo_adv_1005011_030",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大哥你",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "喜歡這種類型嗎？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n這種",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "穿得漂漂亮亮，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n還細心",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "化妝的女生。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦……？",
    "voice": "vo_adv_1005011_031",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不是這樣？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這張照片",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "到底是哪裡好了呢？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "因為我變成了一個",
    "voice": "vo_adv_1005011_032",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "適合燦爛笑容的大人了？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n讓你",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "有點心動？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我怎麼覺得",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你是在隨口說些好聽話，想把我唬弄過去啊？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那麼，",
    "voice": "vo_adv_1005011_033",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "要是我在成為這種大人之後，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哭了或是生氣了的話，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n馬上就會",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "變得不棒了嗎──？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……你會因為想要看到我再次",
    "voice": "vo_adv_1005011_034",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "露出笑容，而出手相助？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這個",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "回答，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "呃，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我沒有料到呢。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也就是說，",
    "voice": "vo_adv_1005011_035",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就算變成大人，你也會",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "和我並肩作戰囉……？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n一開始，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我還覺得這樣一點都不像個英雄。不過……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "如果變成大人，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大哥還是願意幫我的話，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那感覺也不錯。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "因為，",
    "voice": "vo_adv_1005011_036",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這代表大哥會一直",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "待在我身邊對吧……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n意思就是說，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "說不定……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那個，",
    "voice": "vo_adv_1005011_037",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大哥……！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n這該不會……！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我、",
    "voice": "vo_adv_1005011_038",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我才沒有害羞呢！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我就知道大哥你",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是在尋我開心！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我要刪掉這張照片！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "刪掉刪掉～～！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你問我不先給爸爸媽媽看嗎？",
    "voice": "vo_adv_1005011_039",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "當然不可能給他們看囉！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……更不可能給朋友看啦！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "父母都不能看了，那當然啊！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "拜託了，",
    "voice": "vo_adv_1005011_040",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "別再欺負我了啦～～！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n這要是被其他同學看到，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我就沒臉去學校了啦～～！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n大哥～～",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "拜託你住手～～！！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "background",
    "bg_id": "510124"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "呼，",
    "voice": "vo_adv_1005011_041",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "總算把照片給刪掉了。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……就算你露出一臉可惜的表情，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不行的東西就是不行！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "雖然我很高興聽到你稱讚我，",
    "voice": "vo_adv_1005011_042",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但那個實在是太不好意思了啦～～！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我希望把這個當成",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大哥和我之間的祕密！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "話說回來，",
    "voice": "vo_adv_1005011_043",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我將來真的",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "會變成那種模樣嗎？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "完全無法想像耶。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是不是",
    "voice": "vo_adv_1005011_044",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "成長到一半的時候，個性變了呢？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "如果個性沒有變的話，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我不覺得自己會想要",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n穿得那麼漂亮……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗯～～",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大哥怎麼想呢？",
    "voice": "vo_adv_1005011_045",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n你覺得就算過了十年，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "人的個性",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是不是也不會變？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n還是說，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "變成大人之後，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "有很多東西都會有改變呢？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……那個軟體",
    "voice": "vo_adv_1005011_046",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "只是預測我將來的外表而已？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "實際上要成為什麼樣的大人，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "都是看我自己？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "話、",
    "voice": "vo_adv_1005011_047",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "話題突然變得好艱深啊……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n虎虎也常常說一些類似的話，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n但說實話，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我都聽得不是很懂。",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗯、嗯……",
    "voice": "vo_adv_1005011_048",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n人會因為經歷不同經驗而改變，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "要成為自己理想中的模樣，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n去累積不起眼的努力是最重要的……",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "原來如此！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大哥真是厲害，",
    "voice": "vo_adv_1005011_049",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好成熟！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n你一定",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是為了成為自己理想中的模樣而天天努力，對吧！？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……為什麼你要把眼睛別開？",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "總之，",
    "voice": "vo_adv_1005011_050",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "聽了大哥的說明之後，我總算明白了！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n既然這樣，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我就要",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "以成為像虎虎一樣的英雄為目標，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n去做那些我能夠做到的事！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我想想……",
    "voice": "vo_adv_1005011_051",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "首先得要長得更高一點！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n每天",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "都要喝牛奶，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "以長得跟大哥一樣高為目標！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我一定要加油，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "才能成為帥氣的大人～～！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1005011_052",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦你了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們相處的感覺還是那麼令人暖心呢～～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "幾乎讓人覺得",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "像是真正的",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "兄妹一樣了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就跟你說的一樣，",
    "voice": "vo_adv_1005011_053",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "茉莉會有什麼樣的未來，在於她自己的手中……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "經歷各種經驗、",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "學習各種事物，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n都會關係到她未來會成長成什麼模樣。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，",
    "voice": "vo_adv_1005011_054",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在這過程中還是需要周圍的大人去支持、協助她。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n雖然你也還沒到能稱作是大人的年紀，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但畢竟還是比茉莉還要年長一些。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "今後你也繼續幫助茉莉，",
    "voice": "vo_adv_1005011_055",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "讓她能夠成為理想的大人吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……我可不是要你教她",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "化妝或打扮喔？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，",
    "voice": "vo_adv_1005011_056",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這次就到這邊為止吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們所擁有的「未來」……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
