  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過……",
    "voice": "vo_adv_5011007_003",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "和姊姊的比起來，感覺做得還不夠好……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "小可也有在旁邊看著，",
