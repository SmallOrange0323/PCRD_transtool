  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "唔唔，",
    "voice": "vo_adv_5011007_000",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就快到和哥哥約好的地點了……！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "總覺得好緊張讓人靜不下來。",
    "voice": "vo_adv_5011007_001",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這是給小可注入愛情，",
    "voice": "vo_adv_5011007_002",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "重新長出來的可可亞。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n用這個做成的「LoveDestiny」，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
