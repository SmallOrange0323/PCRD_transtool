    "type": "dialogue",
    "name": "靜流",
    "words": "分一次勝負才行呢。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我才是，",
    "voice": "vo_adv_5011007_034",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "正如我所願。",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n下次我絕對會把妳",
