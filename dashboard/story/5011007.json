    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃",
    "voice": "vo_adv_5011007_014",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "能明白姐姐的主張吧？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不是，",
    "voice": "vo_adv_5011007_015",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那個……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳們也差不多該和好了啦。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥、",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥你也說點什麼啦！",
