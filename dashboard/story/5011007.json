    "voice": "vo_adv_5011007_037",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "走掉了……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真是拿她們兩人沒辦法。",
    "voice": "vo_adv_5011007_038",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過，",
    "voice": "vo_adv_5011007_039",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "她們明明說情人節「大家」都是情敵，",
