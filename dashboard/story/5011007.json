    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……也就是說，",
    "voice": "vo_adv_5011007_008",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "比賽時靜流做的是",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "料理全餐，",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n而不是巧克力，",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "所以是我贏了。",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "裡面不是也有巧克力嗎！",
    "voice": "vo_adv_5011007_009",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n妳那樣說的話，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "使用媚藥不就是犯規嗎？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "而且還沒有效果，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "也就是失敗作吧。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "什麼，",
    "voice": "vo_adv_5011007_010",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我的調合很完美……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……妳們兩個還在爭論那種事情啊？",
    "voice": "vo_adv_5011007_011",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "璃乃這次是擔任主持人的，",
    "voice": "vo_adv_5011007_012",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "妳快點說說她。",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦咦！？　",
    "voice": "vo_adv_5011007_013",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那個……",
