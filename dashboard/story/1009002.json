[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "修特帕魯展露出無所畏懼的笑容，\\n一副沒勁兒地打算離開街道。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵呵呵……哈哈哈……！",
    "voice": "vo_adv_1009002_000",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "沒想到我的錢包竟然會變得空空如也……！",
    "voice": "vo_adv_1009002_001",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "舊書啊，真的是太可怕了……！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這樣一來今天的晚餐也沒著落了。",
    "voice": "vo_adv_1009002_002",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "即使是我，要是不吃飯的話也活不下去……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "之前獲得的獎金也全都花光了……",
    "voice": "vo_adv_1009002_003",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……沒辦法了。只好再抓通緝犯了……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但是，在餓著肚子的情況下，",
    "voice": "vo_adv_1009002_004",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n一個人去抓通緝犯也太危險了……有沒有別的辦法……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "喔喔！我還以為是誰呢，這不是吉格魯特嗎！",
    "voice": "vo_adv_1009002_005",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n你出現得正好！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "其實我缺錢……",
    "voice": "vo_adv_1009002_006",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我打算現在去抓通緝犯，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n你願意幫我個忙嗎？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "難道你也缺錢嗎？",
    "voice": "vo_adv_1009002_007",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵……看來我們命中注定是同路人呢。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n歡喜吧吉格魯特。 我們的靈魂在現世中也是相連的！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "決定了的話，我們現在就立刻去抓通緝犯吧！",
    "voice": "vo_adv_1009002_008",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n奏響出發的號角吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "background",
    "bg_id": "500200"
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，你要好好跟著我啊？",
    "voice": "vo_adv_1009002_009",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "根據他人提供的情報，在這前方就是通緝犯的藏身之處。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那麼",
    "voice": "vo_adv_1009002_010",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這次的作戰就是……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "正　面　出　擊 ！",
    "voice": "vo_adv_1009002_011",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "怎麼了？",
    "voice": "vo_adv_1009002_012",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n你覺得我修特帕魯，會使用一些卑鄙的手段嗎？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要上了喔吉格魯特！前進吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "給我出來，通緝犯！我知道你在這裡！",
    "voice": "vo_adv_1009002_013",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n如果你不乖乖出來的話，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我就用被封印在我右手的最強魔法來殲滅你！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "手下",
    "words": "怎樣了怎樣了？是來賺取獎金的嗎？",
    "voice": "vo_adv_1009002_014",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "手下",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "手下",
    "words": "記得她叫修特帕魯，不對，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "手下",
    "words": "\\n是蘭德索爾的「行走龍捲風」啊！ 這傢伙真有趣！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "哈，那傢伙要跟我們幹架嗎？",
    "voice": "vo_adv_1009002_015",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "我就當妳的對手吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你還有同夥嗎……",
    "voice": "vo_adv_1009002_016",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但那種程度的同夥不成問題。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n不管來多少人，都不會是我的對手！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "妳還真是大言不慚啊！",
    "voice": "vo_adv_1009002_017",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "\\n你們！都給我上！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "手下們",
    "words": "哦哦哦哦",
    "voice": "vo_adv_1009002_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "手下們",
    "words": "！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我接受你的挑戰！",
    "voice": "vo_adv_1009002_019",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，要戰鬥了！來吧，拿起你的劍！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就讓他看看，我們暗黑騎士的力量吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "background",
    "bg_id": "500200"
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……嗚！ 不可能！我竟然會陷入苦戰……！",
    "voice": "vo_adv_1009002_020",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "怎麼了，只有這點能耐嗎！？只會耍嘴皮子結果卻不怎樣啊！",
    "voice": "vo_adv_1009002_021",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "比我想像得還厲害……！",
    "voice": "vo_adv_1009002_022",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "既然如此，我要使出我的最強究極殲滅魔法挽回劣勢！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "魔瞳開眼！！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "覺醒吧、統率幽世的冥界之主……！",
    "voice": "vo_adv_1009002_023",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n賜予他們至高無上的毀滅吧――！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "你們！拖拖拉拉在做什麼！",
    "voice": "vo_adv_1009002_024",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "\\n快點給我收拾他們！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "手下",
    "words": "是的，大哥！",
    "voice": "vo_adv_1009002_025",
    "unit_id": 811
  },
  {
    "type": "background",
    "bg_id": "500200"
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗚……！敵人的攻擊相當激烈！",
    "voice": "vo_adv_1009002_026",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n這樣的話詠唱會……！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，難道你要去當誘餌……！？　",
    "voice": "vo_adv_1009002_027",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……我明白了。你不能死啊、吉格魯特……！",
    "voice": "vo_adv_1009002_028",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n這是團長的命令！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……祝你武運昌隆！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "怎樣了？你一個人要當我們的對手嗎？",
    "voice": "vo_adv_1009002_029",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "真有膽量啊！就來大幹一場吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "手下",
    "words": "啊，你這傢伙！不要一直動來動去啊！",
    "voice": "vo_adv_1009002_030",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "可惡！攻擊都打不中他！",
    "voice": "vo_adv_1009002_031",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "\\n閃躲的速度真快！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，你做得很好……我的詠唱結束了！",
    "voice": "vo_adv_1009002_032",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你們就仔細地品嚐蘊藏著我全部魔力的最後一擊吧！！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "那驚人的魔力是！？",
    "voice": "vo_adv_1009002_033",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "這樣沒關係嗎，妳的同伴也會受到牽連……！！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "看招吧！滅龍爆炎業昇波──！！",
    "voice": "vo_adv_1009002_034",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "通緝犯們",
    "words": "嗚哇啊啊啊啊！！",
    "voice": "vo_adv_1009002_035",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵……這就是所謂實力上的差距。",
    "voice": "vo_adv_1009002_036",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "高興吧吉格魯特，我們勝利了！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉、吉格魯特……！？",
    "voice": "vo_adv_1009002_037",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你怎麼變成這副德性！全身都燒焦了啊！！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是他們幹的吧……！",
    "voice": "vo_adv_1009002_038",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n哼……你們這群混帳通緝犯！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "在我詠唱的時候，竟然做了這麼過份的事！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是因為我的關係嗎！？我還以為你一定已經躲開了……",
    "voice": "vo_adv_1009002_039",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……萬分抱歉。下次我會小心謹慎一點……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你、你在說什麼！？",
    "voice": "vo_adv_1009002_040",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我怎麼可能會沮喪啊！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "啊……沒、沒有！",
    "voice": "vo_adv_1009002_041",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你在說什麼？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我什麼都沒改變啊！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特的傷勢看起來也不是很嚴重，",
    "voice": "vo_adv_1009002_042",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n先把通緝犯們交到街上的騎士團那吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這、這是怎麼一回事……！",
    "voice": "vo_adv_1009002_043",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n沒想到抓到通緝犯的手下竟然也能獲得獎金……！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這比我預想的多了好幾倍……！",
    "voice": "vo_adv_1009002_044",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，這份獎金就平分吧！ 你也表現得再高興一點吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……對、對了吉格魯特！",
    "voice": "vo_adv_1009002_045",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你等一下、那個……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "有空嗎？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "為了慶祝抓到通緝犯，一起吃個飯如何？",
    "voice": "vo_adv_1009002_046",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n是我請客喔。今天我的魔法不小心牽連到你，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "加上你平常的幫助，所以我想好好地慰勞你一番。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "下一次的戰鬥也拜託你了，閃光的吉格魯特！",
    "voice": "vo_adv_1009002_047",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "修特帕魯一邊拍著{0}的肩膀，\\n一邊得意洋洋地走向餐廳。",
    "voice": null,
    "unit_id": null
  }
]
