  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "——為了陪同怜前去視察，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}前往了集合地點。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而怜已經到達該處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "喂，",
    "voice": "vo_adv_1003010_000",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "在這邊！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗨。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "平安到達比什麼都重要。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵，",
    "voice": "vo_adv_1003010_001",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你這樣子看來做好了萬全準備。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "怎麼說，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "感覺你比平常還更可靠了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好，",
    "voice": "vo_adv_1003010_002",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那就先前往馬車停駐的地方吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "——怎、",
    "voice": "vo_adv_1003010_003",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "怎麼會……！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n這跟說好的不一樣！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……怎麼了？　",
    "voice": "vo_adv_1003010_004",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你也",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "很在意嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們去看看吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "因為我聽說修理屋頂不用錢，所以才拜託你的。",
    "voice": "vo_adv_1003010_005",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "就算你突然跟我提出報酬……！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "原來如此〜！　",
    "voice": "vo_adv_1003010_006",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "若是這樣的話",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "也沒辦法了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "大家！　",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "把那屋頂恢復為原本破爛的狀態吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒們",
    "words": "好～的！！",
    "voice": "vo_adv_1003010_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "啊……！",
    "voice": "vo_adv_1003010_008",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n怎麼這樣……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "好不容易可以躲開風雨……！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "該不會",
    "voice": "vo_adv_1003010_009",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那些傢伙……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就是最近出現的",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "佯裝為志工的詐騙集團。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……這樣是行不通的。",
    "voice": "vo_adv_1003010_010",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n雖然一聽就知道他們有問題",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "卻沒有契約能證明。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "恐怕",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他們只有做口頭契約。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "現在這狀況",
    "voice": "vo_adv_1003010_011",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "分不出到底是委託人不願意付修理費",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還是他遭到詐欺……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不知道到底誰是壞人。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n若無犯罪證據，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "便無法做適當的處理。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且騎士團也下令各公會",
    "voice": "vo_adv_1003010_012",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n遇到這種事時不要隨便出手。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "因為只要一個沒處理好，就可能出現冤罪。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……現在王宮的勢力漸弱，",
    "voice": "vo_adv_1003010_013",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n整個蘭德索爾上下",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "時常發生這種事。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "所以得趕快確認狀況，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "恢復應有的法律和秩序……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "因為不太記得屋頂原本的狀況啦……",
    "voice": "vo_adv_1003010_014",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "就隨便弄幾個洞出來吧！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "住、",
    "voice": "vo_adv_1003010_015",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "住手啊～！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……",
    "voice": "vo_adv_1003010_016",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……抱歉。",
    "voice": "vo_adv_1003010_017",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看來我們得延遲出發了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那種做法",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "怎麼看都有問題。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵，",
    "voice": "vo_adv_1003010_018",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這就是所謂的看透一切啊。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "上囉！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "啊啊……",
    "voice": "vo_adv_1003010_019",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "這樣下去房子會……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "嘿嘿嘿，",
    "voice": "vo_adv_1003010_020",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "如果想付錢可要趁現在喔？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……到此為止。",
    "voice": "vo_adv_1003010_021",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "蛤？　",
    "voice": "vo_adv_1003010_022",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "妳這傢伙是哪根蔥？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "只是個路過的人罷了。",
    "voice": "vo_adv_1003010_023",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "別說這個了，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "現在就給我離開那房子。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "喂喂喂……",
    "voice": "vo_adv_1003010_024",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "我有修補可是事實喔？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "\\n我也沒有強制他付錢，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "妳對我們有什麼意見嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……能夠進行修補作業的",
    "voice": "vo_adv_1003010_025",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n照理來說只有王宮所認可的公會才行。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你們有受到認可的證據來證明嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "認、",
    "voice": "vo_adv_1003010_026",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "認可……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "那種事我才沒聽過……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "沒、",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "沒事，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "啥都沒！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……你來",
    "voice": "vo_adv_1003010_027",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "強化我吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "……真沒辦法呢。",
    "voice": "vo_adv_1003010_028",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "\\n我就給妳看吧。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "認可的事是我亂說的……",
    "voice": "vo_adv_1003010_029",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看來有問題的是這方！　",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "這個……",
    "voice": "vo_adv_1003010_030",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "就是證據！！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "——哼！　",
    "voice": "vo_adv_1003010_031",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "太天真了！！",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "啊！？",
    "voice": "vo_adv_1003010_032",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "老大！？",
    "voice": "vo_adv_1003010_033",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "只是學了那狡猾把戲……",
    "voice": "vo_adv_1003010_034",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "誰是壞人",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這下可清楚了。",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "像你們這種貨色",
    "voice": "vo_adv_1003010_035",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
