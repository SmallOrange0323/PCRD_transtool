  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "ありがとうございます。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "やっぱり褒められるとうれしいものですね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "たとえそれが騎士さんだとしても。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "は？　",
    "voice": "vo_adv_6050107_001",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "なに言ってるんですか。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "別にそういう意図はないんですけど……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "って、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "ああ。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n妖艶って言いたいんでしょうか。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "そういうことにしておいてあげます。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "ええ、",
    "voice": "vo_adv_6050107_002",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "そうですとも。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "何せレイ様の凛々しさをところどころに取り入れましたからね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "え？　",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "騎士さんも着たいんですか？　",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "いや、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "さすがにこのままじゃ……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "かわいいって言っておけばいいと思ってます？",
    "voice": "vo_adv_6050107_003",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "って、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "騎士さんはそういうこと考えませんよね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "本当は",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\nかっこいいって言って欲しいところですけど……",
    "voice": null,
