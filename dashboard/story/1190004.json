[
  {
    "type": "background",
    "bg_id": "500080"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "伊緒接受了自己體內的力量之後，過了一陣子──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n月光學院一如往常地在和睦的氣氛中上課。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "──因此，",
    "voice": "vo_adv_1190004_000",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n這個問題的答案是……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "35喔。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "大家明白了嗎～？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "學生1",
    "words": "聽不懂，",
    "voice": "vo_adv_1190004_001",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "學生1",
    "words": "不過讀書還真有趣～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊哈哈，",
    "voice": "vo_adv_1190004_002",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這樣啊～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那直到妳聽懂為止，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "老師都會慢慢教導妳喔。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那麼～",
    "voice": "vo_adv_1190004_003",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "下一個問題是……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "學生1",
    "words": "欸～",
    "voice": "vo_adv_1190004_004",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "學生1",
    "words": "課已經上完了嗎？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "學生1",
    "words": "\\n好想多聽伊緒上課哦～",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵呵，",
    "voice": "vo_adv_1190004_005",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "一直唸書會累哦。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n適時轉換心情是很重要的。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好好休息過後，",
    "voice": "vo_adv_1190004_006",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "下次上課會教大家更多東西。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "麼",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "課先上到這裡。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "接下來是午休時間囉！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "學生1",
    "words": "好～",
    "voice": "vo_adv_1190004_007",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "學生1",
    "words": "那我到中庭去玩！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "學生2",
    "words": "我也要去～",
    "voice": "vo_adv_1190004_008",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "盡情地去玩吧。",
    "voice": "vo_adv_1190004_009",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n但要小心",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "別受傷了哦～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "{0}，",
    "voice": "vo_adv_1190004_010",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你午休想做什麼呢？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，",
    "voice": "vo_adv_1190004_011",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你要睡午覺嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "養足精神面對下午的課程也不錯。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哎呀……",
    "voice": "vo_adv_1190004_012",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好溫暖的光哦……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "討厭，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我也覺得愛睏了……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "background",
    "bg_id": "510090"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你好。",
    "voice": "vo_adv_1190004_013",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我是你的班導師支倉。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我突然決定來做個家庭訪問。",
    "voice": "vo_adv_1190004_014",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n可以讓我進去嗎？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "打擾了。",
    "voice": "vo_adv_1190004_015",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "{0}，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我記得你父母都出差去了，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "現在是一個人住，對嗎？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "雖然這是你父母的房子，",
    "voice": "vo_adv_1190004_016",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我還是第一次",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "來到",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "一個人生活的男生住的地方。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哇～",
    "voice": "vo_adv_1190004_017",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "看來你有在認真打掃……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哎呀？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "喂～",
    "voice": "vo_adv_1190004_018",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "內褲怎麼直接丟在地上呢？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n不可以脫了就隨手丟呀。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "要放進洗衣機去才對。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你呀……",
    "voice": "vo_adv_1190004_019",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "最近果然有點散漫呢。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "時間寶貴，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "馬上開始家庭訪問吧。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我想談談你的成績。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你最近",
    "voice": "vo_adv_1190004_020",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "成績是不是下滑了？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "之前的期中考",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "排名也掉了很多……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這讓我有點擔心，",
    "voice": "vo_adv_1190004_021",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "所以我今天才會來這裡找你。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "而且，",
    "voice": "vo_adv_1190004_022",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你一個人住也讓我不太放心。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你還只是高中生，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "家事也全都要一個人做，肯定很辛苦吧？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "飯有好好吃嗎？",
    "voice": "vo_adv_1190004_023",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n洗澡的時候",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "有沒有用浴缸好好泡澡？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "還有……",
    "voice": "vo_adv_1190004_024",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哎呀？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n你枕頭下的書是什麼呢……？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是不是",
    "voice": "vo_adv_1190004_025",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "參考書呢？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n看來你有在認真唸書。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "真了不起！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "看看……？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "～～～～！？",
    "voice": "vo_adv_1190004_026",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這、",
    "voice": "vo_adv_1190004_027",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這是黃色書刊……！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你把這種書放在",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "枕頭底下……？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這是",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "為什麼呢……？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這樣啊，",
    "voice": "vo_adv_1190004_028",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是人家借你的……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不過，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "沒想到你會看這種書……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "和你給人的印象差很多……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我不是很懂男生的事情……",
    "voice": "vo_adv_1190004_029",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n不過",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我既然是老師，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "看來有必要和你講清楚……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我平常是不太會罵學生的……",
    "voice": "vo_adv_1190004_030",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但我這次要狠下心",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好好訓話了！　",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "咳咳……",
    "voice": "vo_adv_1190004_031",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你畢竟是青春期的男孩子，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n而且又一個人住……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "可是！",
    "voice": "vo_adv_1190004_032",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這不能當作藉口！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n要看這種書是沒關係，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但你該唸的書還是要唸。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你明白嗎？",
    "voice": "vo_adv_1190004_033",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這個時期對你很重要。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n雖然你現在才二年級，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不過很快就要畢業了！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你可能還沒有決定畢業後的方向，",
    "voice": "vo_adv_1190004_034",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但最好還是盡量做好準備，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "畢業後才會有更多的選擇。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那當然啊……",
    "voice": "vo_adv_1190004_035",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你是我很寶貴的學生。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我本來沒有打算把話說得太重，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但一想到你，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "就忍不住……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "怎樣？",
    "voice": "vo_adv_1190004_036",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你能了解",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "老師的心情了嗎？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……嗯，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "看來你有在好好反省了。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那麼，",
    "voice": "vo_adv_1190004_037",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "現在就開始補習，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "為下次考試做好準備吧。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哎呀？",
    "voice": "vo_adv_1190004_038",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "怎麼一臉不情願的樣子？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你還沒有明白",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我的心情嗎……？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯，",
    "voice": "vo_adv_1190004_039",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我會加油的。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "要是你分數沒有比上次進步，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "老師可饒不了你哦。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "still",
    "still_id": "119000401"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那麼，",
    "voice": "vo_adv_1190004_040",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這個問題你會嗎？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n它有一個很簡單的解法……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你啊～",
    "voice": "vo_adv_1190004_041",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "怎麼沒辦法專心呢？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你就這麼討厭",
    "voice": "vo_adv_1190004_042",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "在假日補習嗎……？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我會一對一仔細教你，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你要認真一點啊……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "still",
    "still_id": "119000402"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "真是的！",
    "voice": "vo_adv_1190004_043",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你居然在想那種事！？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "既然你一直念念不忘那本書，",
    "voice": "vo_adv_1190004_044",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我就先沒收了！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n不然會妨礙你唸書！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "等一下",
    "voice": "vo_adv_1190004_045",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "要告訴老師是誰借你的喔？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n老師會直接還給他！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "唉，",
    "voice": "vo_adv_1190004_046",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "青春期的男生也真不容易啊……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "動不動就往那方面想……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n畢竟是比較敏感的時期，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "有些事還是睜一隻眼閉一隻眼吧……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "119000401"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……話說，",
    "voice": "vo_adv_1190004_047",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "還好我今天有過來。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n終於弄清楚你為什麼無心唸書了。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "偶爾會想放鬆是很正常的，",
    "voice": "vo_adv_1190004_048",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "一個人住畢竟很辛苦。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不過，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "凡事都要適可而止。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "還有，",
    "voice": "vo_adv_1190004_049",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "如果想要放鬆的話，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "隨時可以來找老師。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我可以陪陪你。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……怎麼",
    "voice": "vo_adv_1190004_050",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "突然就不講話了？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你該不會又在想",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那些有的沒的了吧？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "119000402"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我說的放鬆，",
    "voice": "vo_adv_1190004_051",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "指的是阿斯特朗啦！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我怎麼可能找你做",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那些不正經的事情呢！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "真是的～！",
    "voice": "vo_adv_1190004_052",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你這樣補習會沒有進度的～！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "認真一點～！",
    "voice": null,
    "unit_id": 101831
  },
