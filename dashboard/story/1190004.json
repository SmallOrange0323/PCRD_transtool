  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "伊緒這個人啊……",
    "voice": "vo_adv_1190004_053",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n真的完全沒注意到自己多容易散發魅力耶……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "看得我都開始緊張了，",
    "voice": "vo_adv_1190004_054",
