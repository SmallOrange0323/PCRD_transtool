[
  {
    "type": "background",
    "bg_id": "500120"
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "…………",
    "voice": "vo_adv_1033007_000",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯嗯，已經中午了啊。",
    "voice": "vo_adv_1033007_001",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真糟糕，最近老是提不起勁啊。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "上次被叫到王宮去，\\n在國王面前表演之後……",
    "voice": "vo_adv_1033007_002",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "身體好像就變得重重的，總會賴床到太陽曬屁股的啦",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我該不會有一點憂鬱吧……\\n這真是太不像我了。牧場一早就有很多工作，",
    "voice": "vo_adv_1033007_003",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我得趕快起床，好好工作才行。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "還有很多牛等著我去照顧的啦。",
    "voice": "vo_adv_1033007_004",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "可是……\\n",
    "voice": "vo_adv_1033007_005",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗚嗚，什麼事都不想做。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這樣會被寄住在【伊麗莎白牧場】的\\n莉瑪莉瑪或栞栞擔心的啦。",
    "voice": "vo_adv_1033007_006",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n雖然那些孩子，大概只會靜靜地在旁邊守護而已。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "鈴鈴的話，\\n感覺就會說",
    "voice": "vo_adv_1033007_007",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "「明明平常老是叫我工作～」",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這種諷刺我的話。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "實際上也是那樣沒錯啦。\\n",
    "voice": "vo_adv_1033007_008",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這就是見不賢而內自省啊。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "默默地做「平常的工作」，應該多少可以靜下心來的啦。",
    "voice": "vo_adv_1033007_009",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "所以得趕快起床，起來工作才行。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n從出生以來，我都是這樣一路做過來的。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "…………",
    "voice": "vo_adv_1033007_010",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……嗯？\\n怎麼，馬廄那裡好像很吵鬧？",
    "voice": "vo_adv_1033007_011",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n發生了什麼爭執嗎？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "明明【伊麗莎白牧場】的特色\\n就在於總是很和平～",
    "voice": "vo_adv_1033007_012",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "總覺得，全部都亂了步調啦。\\n為什麼會變成這樣的啦？",
    "voice": "vo_adv_1033007_013",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不行。不能就這樣放著不管，",
    "voice": "vo_adv_1033007_014",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我可是【伊麗莎白牧場】的經營者。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "得提起勁才行。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "而且……\\n感覺不是什麼紛爭或魔物襲擊啊。",
    "voice": "vo_adv_1033007_015",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好像，可以聽到笑聲……？",
    "voice": "vo_adv_1033007_016",
    "unit_id": 103311
  },
  {
    "type": "background",
    "bg_id": "500150"
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……大家～怎麼啦？",
    "voice": "vo_adv_1033007_017",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "咦、",
    "voice": "vo_adv_1033007_018",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "咦？\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "{0}！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "早安……\\n",
    "voice": "vo_adv_1033007_019",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "來【",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "伊麗莎白牧場】做什麼呀？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然，{0}的話隨時來玩都沒關係的啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "抱歉，",
    "voice": "vo_adv_1033007_020",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不知道老哥有什麼事，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n但我好像有點身體不舒服，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n沒辦法陪老哥啊。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "只是，\\n老哥專程爬到這山上的牧場來。",
    "voice": "vo_adv_1033007_021",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "要是說……改天再來，是不是太不近人情啦？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "…………",
    "voice": "vo_adv_1033007_022",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……嗯？\\n抱歉，我有點不懂意思。",
    "voice": "vo_adv_1033007_023",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "剛剛那是搞笑劇嗎？",
    "voice": "vo_adv_1033007_024",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雙、雙關語？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n為什麼會想在這個時機逗我笑呢？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我沒能好好反應，真是太抱歉啦。",
    "voice": "vo_adv_1033007_025",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n話說回來……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "剛剛的笑點在哪裡的啦？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "咦？\\n為、為什麼突然開始笑？",
    "voice": "vo_adv_1033007_026",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我說了什麼有趣的事嗎？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "咦？",
    "voice": "vo_adv_1033007_027",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我說過本人不笑的話，就沒辦法逗其他人笑嗎？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我以前說過這種話嗎？",
    "voice": "vo_adv_1033007_028",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我竟然裝作一副都懂的模樣，說過這種臭屁的話啊？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊？\\n怎麼啦，{0}？",
    "voice": "vo_adv_1033007_029",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我坐在這裡就好了嗎？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "拍手？\\n雖然不知道為什麼要這麼做……",
    "voice": "vo_adv_1033007_030",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啪啪啪♪",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "喔喔。",
    "voice": "vo_adv_1033007_031",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n{0}要表演",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n私房的搞笑短劇嗎？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "為、為什麼啦？",
    "voice": "vo_adv_1033007_032",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n之前我的確是喜歡搞笑……啦？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "現在變得好像有些摸不著頭緒。",
    "voice": "vo_adv_1033007_033",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n究竟什麼是搞笑，有什麼意義，又有什麼價值。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "實在有點煩惱的啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "喔喔？\\n老哥不理我就開始表演相聲啦！",
    "voice": "vo_adv_1033007_034",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "只是單方面地想搞笑是不行的啦。\\n得感受觀眾的興致和氣氛才行！",
    "voice": "vo_adv_1033007_035",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過算了。\\n……啊、",
    "voice": "vo_adv_1033007_036",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊哈哈。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊哈哈……♪",
    "voice": "vo_adv_1033007_037",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊嗯，非常有趣啊。",
    "voice": "vo_adv_1033007_038",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我從以前就笑點很低的啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊……感覺很久沒笑成這樣了。",
    "voice": "vo_adv_1033007_039",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "總覺得放下了心中的大石頭啦♪",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "謝謝啦。\\n{0}是來幫我打氣的對吧？",
    "voice": "vo_adv_1033007_040",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是不是從寄住在【伊麗莎白牧場】的孩子們那裡，\\n打聽到我很沮喪，所以很擔心？",
    "voice": "vo_adv_1033007_041",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不是啊？只是單純喜歡我搞笑，",
    "voice": "vo_adv_1033007_042",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n所以自己也想試看看？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這樣啊……不管是謊話還是客套話，總覺得很高興啊♪",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "欸嘿嘿。\\n搞笑絕對不是治百病的仙丹。",
    "voice": "vo_adv_1033007_043",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但是可以幫助人\\n",
    "voice": "vo_adv_1033007_044",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "暫時忘記現實的苦悶與不順心。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n就跟甜甜的點心一樣的啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然不是這個世界上不可或缺的東西。\\n",
    "voice": "vo_adv_1033007_045",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但沒有搞笑的話，總會有點寂寞的吧。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "謝謝老哥……",
    "voice": "vo_adv_1033007_046",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然我還是有點沮喪，不過心情稍微輕鬆一點啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "因為背負著國家或是世界\\n這樣沈重的責任，而變得",
    "voice": "vo_adv_1033007_047",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "失去人性的那個怪物國王……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "如果他不懂得歡笑，那真的是很可憐啊。",
    "voice": "vo_adv_1033007_048",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然這可能是我多管閒事啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "如果有一天，我可以告訴他什麼是幸福歡笑就好啦。",
    "voice": "vo_adv_1033007_049",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n這樣的話，這個世界、這個國家……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就會多一點讓人可以喘口氣的空間了吧？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "欸嘿嘿。\\n",
    "voice": "vo_adv_1033007_050",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過{0}呀，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n剛剛的哏，沒有搭檔是無法發揮真正有趣的精華的啦！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我來當老哥的搭檔好不好？",
    "voice": "vo_adv_1033007_051",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我已經記住哏了，也想到很多變化的方法啦！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "一起表演、一起歡笑吧。",
    "voice": "vo_adv_1033007_052",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "{0}真是個溫柔的人……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我可以跟著一起笑嗎？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哎呀。\\n【伊麗莎白牧場】的大家",
    "voice": "vo_adv_1033007_053",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "都聚集過來了啊。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不管是人類、獸人、牛還是羊，通通歡迎！",
    "voice": "vo_adv_1033007_054",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n快過來啊～歡樂的搞笑表演開始的啦――♪",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊哈哈……☆",
    "voice": "vo_adv_1033007_055",
    "unit_id": 103311
  }
]
