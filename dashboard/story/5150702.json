[
  {
    "type": "background",
    "bg_id": "501680"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "行軍訓練の地。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n新兵たちの奮戦により多くの魔物が討伐され、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nかつての平穏を取り戻していた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "魔物もだいぶ減ったようだし、",
    "voice": "vo_adv_5142702_000",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "残りは私たちで片付けられそうだ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "ありがとう、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "エリコちゃん、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "マコトちゃん。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "それに新兵たちも、",
    "voice": "vo_adv_5142702_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "ずいぶん強くなった。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n君たちに教官になってもらえて、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "本当に助かったよ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "最初はどうなることか",
    "voice": "vo_adv_5142702_002",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "って思ってたけどな～",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "教官役を頼まれた時も、",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "エリコが入ってきた時も、",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "さ。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "しかし彼らも、",
    "voice": "vo_adv_5142702_003",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "一人前を名乗れるほどには育ちましたし。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n十分な結果でしょう。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "そうだな。",
    "voice": "vo_adv_5142702_004",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "ま、",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "やるべきことは何とかこなせたみたいで",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "何よりだぜっ。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "ふふっ……",
    "voice": "vo_adv_5142702_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "何とかこなせた、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "というレベルではないけれどね。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n二人は教官としても、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "とてもいいコンビだったよ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "コンビって、",
    "voice": "vo_adv_5142702_006",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "あたしとエリコが？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "そんな大層なもんじゃ……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "そう呼ぶべき間柄なのかはわかりませんが、",
    "voice": "vo_adv_5142702_007",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n仲のよいお友達ではありますわね。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "エリコ……",
    "voice": "vo_adv_5142702_008",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "何せマコトさんは、",
    "voice": "vo_adv_5142702_009",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "私とあのおかたが絆を結ぶ姿に深く感激したらしく、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n身を尽くして",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "私たちを応援すると言ってくれましたので。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "いや言ってねえ！",
    "voice": "vo_adv_5142702_010",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\nおまえの中であたしはどういうキャラになってるんだ！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "深くは聞かないでおくけれど。",
    "voice": "vo_adv_5142702_011",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n二人の存在が",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "新兵たちにいい影響を与えたのは事実さ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "騎士団の一員となるなら、",
    "voice": "vo_adv_5142702_012",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "自分の体を鍛え",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "技を磨くだけでは足りない。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n命を預ける仲間として、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n周りのみんなと",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "確かな信頼関係を築く必要がある。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "それぞれが違った強みを持ち、",
    "voice": "vo_adv_5142702_013",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "補い合って困難に挑む……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\nそんな君たちの信頼関係も、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "新兵たちにとって",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\nいい目標になったんじゃないかな。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "それは、",
    "voice": "vo_adv_5142702_014",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "まあ……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "確かにそっか。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "あたしだけじゃ多分、",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "ここまでみんなを引っ張ってくなんて",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\nできなかっただろうし。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "なんだかんだで",
    "voice": "vo_adv_5142702_015",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "エリコが来てくれて助かったよ。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "それを言うなら、",
    "voice": "vo_adv_5142702_016",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "私も同じですわ。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "マコトさんの協力がなければ、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "我流の訓練にこだわって",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n勲章をもらうどころではありませんでした。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "それは本当にその通りだな……！",
    "voice": "vo_adv_5142702_017",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "この先も",
    "voice": "vo_adv_5142702_018",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "マコトさんの協力が得られるのなら、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "頼もしい限りです。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "これからも私たちの愛を、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "応援してくださいますわね？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "あー、",
    "voice": "vo_adv_5142702_019",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "いや",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "エリコ……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "それなんだけど、",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "あたしは正直言うとだな……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "正直言うと……",
    "voice": "vo_adv_5142702_020",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "なんです？　",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "やはり私たちの邪魔を？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n雌犬どころか、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "人の純心を裏切り陰で嘲笑うような女狐でしたか？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "いやっ、",
    "voice": "vo_adv_5142702_021",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "大丈夫！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\nとりあえずいいお友達でいさせてくれ！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "クスクス、",
    "voice": "vo_adv_5142702_022",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "ありがとうございます♪",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "末永く、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "よろしくお願いいたしますね。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "ではみなさん、",
    "voice": "vo_adv_5142702_023",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "任務完了までもう一息です。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n仲良く協力して頑張りましょう。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "そう、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "私とマコトさんのように♪",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "新兵たち",
    "words": "はいっ！",
    "voice": "vo_adv_5142702_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "ああもう、",
    "voice": "vo_adv_5142702_025",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "なんでこんなややこしいことになるんだよ……！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "あたしか？　",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "あたしが素直になれないせいなのか？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "訓練を乗り越え、団結力も高まった新兵たち。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n一方でマコトは、エリコとの奇妙な関係がまだまだ続きそうなことに",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n頭を抱えるのだった。",
    "voice": null,
    "unit_id": null
  }
]
