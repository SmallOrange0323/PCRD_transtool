  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在瑪爾傑海岸熱鬧的海灘開放活動中，\\n{0}悠閒地走在沙灘上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喂──！",
    "voice": "vo_adv_1079002_000",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}──！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你來的正好啊喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "欸，幹嘛逃走啊喵！",
    "voice": "vo_adv_1079002_001",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "給我站住喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呵，",
    "voice": "vo_adv_1079002_002",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "抓到了喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n要是我把手放開你就會逃掉，所以保持這樣和你說喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們一起來找貓形貝殼吧喵！",
    "voice": "vo_adv_1079002_003",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真的有啊喵！",
    "voice": "vo_adv_1079002_004",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我親眼見過的喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "現在比起攤位我更想找貓形的貝殼！",
    "voice": "vo_adv_1079002_005",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就在剛才來買鯛魚燒的客人，",
    "voice": "vo_adv_1079002_006",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我看到他戴著有貓型貝殼串在一起的裝飾品呢喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那種貝殼呀",
    "voice": "vo_adv_1079002_007",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "聽說可以帶來幸福呢喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n不僅是貓的形狀",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "還能帶來幸福真是太讚了喵～♪",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "哎～呀，",
    "voice": "vo_adv_1079002_008",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你是逃不掉的喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我是不會放手的喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們一起來找貓形貝殼吧喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我啊，",
    "voice": "vo_adv_1079002_009",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "讓生活中充斥著喜愛的東西便是我的信條啊喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "而貓形貝殼就是其中之一喵～",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "來吧，",
    "voice": "vo_adv_1079002_010",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "快一起到海邊找找喵～♪",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "貓形貝殼快出來吧喵～",
    "voice": "vo_adv_1079002_011",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我會把你弄的漂漂亮亮的喵～♪",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我也希望{0}可以努力幫忙找找呢喵～",
    "voice": "vo_adv_1079002_012",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我的幸福人生就仰賴你了喵～",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "貓形的貝殼……",
    "voice": "vo_adv_1079002_013",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "該是把它作成墜飾好呢、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "還是胸針比較好呢喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "把貝殼弄到手我的攤位，",
    "voice": "vo_adv_1079002_014",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "客人們一定會連日擁進，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n搞不好沒多久就能成為有錢人了……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊，",
    "voice": "vo_adv_1079002_015",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我也會用謝禮好好報答{0}的喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我做的鯛魚燒",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "會特別為你做個優惠的喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "啊，",
    "voice": "vo_adv_1079002_016",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "是鯛魚燒姐姐！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "妳在這裡做什麼？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "哦，",
    "voice": "vo_adv_1079002_017",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "是一直跟我買鯛魚燒的小女孩啊喵！",
