    "words": "……不過算了。",
    "voice": "vo_adv_1199004_022",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "雖然不知道怎麼回事，",
