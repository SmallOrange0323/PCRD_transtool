  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊──",
    "voice": "vo_adv_1199004_002",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是聖誕老人喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n你的腰已經沒事了來的？",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "呵──呵呵！",
    "voice": "vo_adv_1199004_003",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "多虧你們，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n休息了一陣子後，已經好了！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "你們漂亮地代理了聖誕老人的工作，",
    "voice": "vo_adv_1199004_004",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "我由衷地感激！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n謝謝你們將禮物與幸福",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "配送給大家！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "小姐你們似乎有當聖誕老人的才能呢！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "聖誕老人也這麼覺得嗎？",
    "voice": "vo_adv_1199004_005",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子也是這麼認為的！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "很了不起吧♪",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊，",
    "voice": "vo_adv_1199004_006",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這個魔法袋子",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "還給你喲。",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "真的很方便耶！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "喔喔，",
    "voice": "vo_adv_1199004_007",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "沒弄破就還給我實在幫了大忙。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "之前有位小姐把魔法袋子割破了，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n那時我花了三天三夜，熬夜才修補好呢……",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "不，",
    "voice": "vo_adv_1199004_008",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "不說這個了，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "得給你們回禮才行。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n小姐你們很努力地完成了聖誕老人的工作，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n所以任何喜歡的東西都可以給你們喔！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "哇──",
    "voice": "vo_adv_1199004_009",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "謝謝喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那麼，",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "我要一整年份的聖誕節限定布丁……",
