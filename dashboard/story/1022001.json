[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "咦、咦？",
    "voice": "vo_adv_1022001_000",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n應該是這一帶沒錯……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "因為聽說有超便宜的雜貨店所以我才到這裡來……",
    "voice": "vo_adv_1022001_001",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n但到處都看不到符合的店家啊。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "怎、怎麼辦……？",
    "voice": "vo_adv_1022001_002",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n都來到這裡了，也不想就這麼放棄。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "找誰問路看看好了……！",
    "voice": "vo_adv_1022001_003",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可、可是要和陌生人搭話……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不，我不能一直這麼怕生！",
    "voice": "vo_adv_1022001_004",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n只是問個路而已，小事一件！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，有人來了！",
    "voice": "vo_adv_1022001_005",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n向那個人問問看！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那、",
    "voice": "vo_adv_1022001_006",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那……那個！！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "路人",
    "words": "哇，嚇到我了！",
    "voice": "vo_adv_1022001_007",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "路人",
    "words": "\\n有事嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊啊啊啊，抱、抱歉！",
    "voice": "vo_adv_1022001_008",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n都是我害你嚇一跳！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我沒想到會發出那麼大的聲音來……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "欸，那……那個，店……",
    "voice": "vo_adv_1022001_009",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不對！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我不知道路怎麼走……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "欸、欸……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "今、今天是個好日子……感謝您百忙中前來……",
    "voice": "vo_adv_1022001_010",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "――我幹嘛這麼正式問候啊！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊、不是，不是那樣的……",
    "voice": "vo_adv_1022001_011",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n其實是……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "欸……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "還、還是算了！",
    "voice": "vo_adv_1022001_012",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n什麼事都沒有！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呼……失敗了……",
    "voice": "vo_adv_1022001_013",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n明明只是問路而已，為什麼我會這麼緊張呢？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "下、下一個！",
    "voice": "vo_adv_1022001_014",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n下一個人一定要好好問清楚！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "正好下一個人過來了！",
    "voice": "vo_adv_1022001_015",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n這、這次一定要成功……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "請問！",
    "voice": "vo_adv_1022001_016",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……啊啊啊啊！",
    "voice": "vo_adv_1022001_017",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我沒事幹嘛這麼大聲！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "為什麼我沒辦法從失敗中學到教訓呢……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊……是、是的！",
    "voice": "vo_adv_1022001_018",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我有問題！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你願意聽我說嗎？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "對、",
    "voice": "vo_adv_1022001_019",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "對不起！我發出這麼大的聲音！！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n真抱歉！！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，聲音又太大了……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那……那個呀。",
    "voice": "vo_adv_1022001_020",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我的名字叫依里――",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊，不對！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n現在不需要自我介紹！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就是，那個……路超便宜的――",
    "voice": "vo_adv_1022001_021",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不是！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我在找一間店……那個……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還是沒事了！",
    "voice": "vo_adv_1022001_022",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "對不起！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哇！竟然追了過來！？",
    "voice": "vo_adv_1022001_023",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "為、為什麼？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n不要過來！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "到、到底為什麼要跟上來啊！",
    "voice": "vo_adv_1022001_024",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這樣的話……我就全力逃跑！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "噠噠噠噠――",
    "voice": "vo_adv_1022001_025",
    "unit_id": 102211
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還在追我！？",
    "voice": "vo_adv_1022001_026",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "等等！你到底想幹嗎！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哈？還沒聽我說有什麼事……？",
    "voice": "vo_adv_1022001_027",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n就為了這個理由！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我剛剛已經說沒關係了啊！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你、你很纏人耶！",
    "voice": "vo_adv_1022001_028",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n沒理由這麼認真吧！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "因為我好像很困擾……？",
    "voice": "vo_adv_1022001_029",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "的、的確是很困擾……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但就算那樣也很纏人耶！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我只是想問路！",
    "voice": "vo_adv_1022001_030",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我在找超便宜的雜貨店！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……？",
    "voice": "vo_adv_1022001_031",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n你、你要幫我帶路……？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "托你的福，我順利買到東西了……",
    "voice": "vo_adv_1022001_032",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n但這樣堅持要聽我說話的人，你還真是第一個。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我很不擅長和別人交談……",
    "voice": "vo_adv_1022001_033",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n尤其如果對象是男性的話，我就會很緊張，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n緊張到說不好話……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸？現在我很正常地在說話……？",
    "voice": "vo_adv_1022001_034",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……咦？這麼說起來……？",
    "voice": "vo_adv_1022001_035",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "因為你實在太煩人了，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我才煩躁到都忘了緊張。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "現、現在已經不生氣了！",
    "voice": "vo_adv_1022001_036",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "雖然你很纏人……但也是托你的福才能找到店鋪。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "一旦說過話之後，好像就能正常說話了。",
    "voice": "vo_adv_1022001_037",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n這還真是我第一次，能和男性這樣說話……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "吶、吶……",
    "voice": "vo_adv_1022001_038",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n你叫什麼名字？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……這樣喔。",
    "voice": "vo_adv_1022001_039",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n如、如果你願意，下次再……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還還還、",
    "voice": "vo_adv_1022001_040",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還是算了！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n再見！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸欸！？",
    "voice": "vo_adv_1022001_041",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
