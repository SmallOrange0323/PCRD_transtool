    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "那個，",
    "voice": "vo_adv_1193002_050",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "大姐姐。",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "這裡要怎麼做啊？",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這裡啊……",
    "voice": "vo_adv_1193002_051",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳先織一針，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "然後再翻到背面去……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "璃乃老師！",
    "voice": "vo_adv_1193002_052",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "不知道怎麼搞的針目對不起來啦～",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n這樣是不是失敗了！？",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "別慌張、別慌張。",
    "voice": "vo_adv_1193002_053",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你先拆掉一行後再重新編織就沒問題了！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "怎麼辦、怎麼辦！",
    "voice": "vo_adv_1193002_054",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "毛線都糾纏在一起了！",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "快救我！",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "嗯！",
    "voice": "vo_adv_1193002_055",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "啊～！",
    "voice": "vo_adv_1193002_056",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "毛線球滾走了……",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "等等！",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，",
    "voice": "vo_adv_1193002_057",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "喂～",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "毛線球，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "快停下來！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……呼。",
    "voice": "vo_adv_1193002_058",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "總算在滾遠前撿到了……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……咦？",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "剛剛",
    "voice": "vo_adv_1193002_059",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好像有感受到某種氣息……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是我的錯覺嗎？",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n呃，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好像在那棵樹的樹蔭下……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "看來，",
    "voice": "vo_adv_1193002_060",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "或許真的是我的錯覺吧！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n總覺得",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好像有魔物在附近，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n所以感到有點在意。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你說……",
    "voice": "vo_adv_1193002_061",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "魔物嗎？",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "原來如此……！",
    "voice": "vo_adv_1193002_062",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "大概是我們",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "看起來玩得很開心吧！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "若是這樣，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "附近會有被我們吸引而來的魔物，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n那也沒什麼好奇怪的了。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "只要它們不對孩子們出手，",
    "voice": "vo_adv_1193002_063",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我們就不管它們。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為我之前曾在書本上讀過，",
    "voice": "vo_adv_1193002_064",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n有不少魔物只要我們不發動攻擊，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "它們也不會襲擊我們！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我想躲在附近的，肯定是這類魔物……",
    "voice": "vo_adv_1193002_065",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "對吧，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "璃乃老師！",
    "voice": "vo_adv_1193002_066",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "請幫幫我！",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "棒針上的毛線脫落了～！",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好的！",
    "voice": "vo_adv_1193002_067",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n不可以拉扯喔，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我現在馬上過去！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們走吧！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "…………",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "姐姐，",
    "voice": "vo_adv_1193002_068",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "妳看！",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "\\n",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "妳剛剛教我的地方，",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "我已經順利織好了！",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真的耶──！",
    "voice": "vo_adv_1193002_069",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳很努力呢。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "再加把勁就可以完成囉！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "好的！",
    "voice": "vo_adv_1193002_070",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……呵呵。",
    "voice": "vo_adv_1193002_071",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為哥哥的提議而開始的編織教室，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n進行得很順利呢！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嘿嘿……",
    "voice": "vo_adv_1193002_072",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "如果是這樣就好了。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這是我第一次嘗試，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以不怎麼有信心自己可以教得好……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n不過，看到大家認真學習的模樣，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我也覺得開心。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "再說",
    "voice": "vo_adv_1193002_073",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……我原本以為準備過聖誕節",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "會是只屬於我們兩個人的活動，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "然而，像這樣跟大家",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "一起準備禮物，感覺也挺不錯的。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "為了傳達各自的心意而親自動手製作，",
    "voice": "vo_adv_1193002_074",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n你不覺得",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這是件很棒的事嗎？",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "能夠找到新的樂趣，",
    "voice": "vo_adv_1193002_075",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "讓我稍微有賺到的感覺。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這也是多虧了……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "有哥哥在！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "聖誕節就快到了……",
    "voice": "vo_adv_1193002_076",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真令人期待……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就讓我們過個最棒的聖誕節吧。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好了，",
    "voice": "vo_adv_1193002_077",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "各位。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "最後再加把勁，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "卯足全力編織吧！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "好──！",
    "voice": "vo_adv_1193002_078",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "璃乃與{0}兩人就這樣面帶笑容，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n默默注視著編織教室的學生們努力奮戰的身影。",
    "voice": null,
    "unit_id": null
  }
]
