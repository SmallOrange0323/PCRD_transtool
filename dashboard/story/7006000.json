  {
    "type": "dialogue",
    "name": "旁白",
    "words": "――露娜之塔。\\n{0}的記憶線索\\n被認為存放在，這個聳立天際的巨大高塔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在其中一層內，\\n出現等待著{0}的咲戀。",
    "voice": null,
