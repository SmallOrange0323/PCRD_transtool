  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "{0}他……",
    "voice": "vo_adv_7006000_000",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好像提過",
