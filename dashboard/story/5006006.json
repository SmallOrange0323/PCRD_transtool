[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真是久等了呢，",
    "voice": "vo_adv_5006006_000",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "諸君！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n【王宮騎士團（NIGHTMARE）】可靠又受大家愛戴的副團長，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n克莉絲提娜來幫助大家囉！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這樣就可以放心了吧！",
    "voice": "vo_adv_5006006_001",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "大家可以全部死一死了喔！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "危險！？",
    "voice": "vo_adv_5006006_002",
    "unit_id": 104713
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n克莉絲、",
    "voice": null,
    "unit_id": 104713
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "剛剛都沒見到你……",
    "voice": null,
    "unit_id": 104713
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你跑去哪兒了？",
    "voice": null,
    "unit_id": 104713
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你願意來我是很開心，",
    "voice": "vo_adv_5006006_003",
    "unit_id": 104713
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但別搞錯敵人呀！",
    "voice": null,
    "unit_id": 104713
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我是真正的純啊！",
    "voice": null,
    "unit_id": 104713
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "開開玩笑……",
    "voice": "vo_adv_5006006_004",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n團長可別那麼生氣呀，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "難得長了張漂亮的臉蛋。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n再怎麼美，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "罵人的時候都會變醜喔？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔唔……",
    "voice": "vo_adv_5006006_005",
    "unit_id": 104713
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n真是的，",
    "voice": null,
    "unit_id": 104713
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "別再胡鬧了啦！",
    "voice": null,
    "unit_id": 104713
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我的頭盔在克莉絲的腳下，",
    "voice": null,
    "unit_id": 104713
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我想拿回來！",
    "voice": null,
    "unit_id": 104713
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哇，",
    "voice": "vo_adv_5006006_006",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不小心滑倒了～♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為什麼把我的頭盔踢走？　",
    "voice": "vo_adv_5006006_007",
    "unit_id": 104713
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣我很困擾的！",
    "voice": null,
    "unit_id": 104713
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈！",
    "voice": "vo_adv_5006006_008",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n順便",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "幫你把那礙事的假面也撕掉吧♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "喂啊啊啊嗚……",
    "voice": "vo_adv_5006006_009",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "搞什麼啊，克莉絲，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你到底想幹嘛？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈哈哈哈☆",
    "voice": "vo_adv_5006006_010",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我想做令人開心的事，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "然後盡量免去麻煩事！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "快",
    "voice": "vo_adv_5006006_011",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "看……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n敵人好像",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "想幫我完成願望呢。♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "still",
    "still_id": "500600601"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……！",
    "voice": "vo_adv_5006006_012",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n這是怎麼一回事，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "敵方的樣子好可疑！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "暴走的冒牌貨和",
    "voice": "vo_adv_5006006_013",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n被打倒的冒牌貨全都融合在一起？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "連純掉的頭盔也和他們全部融合在一起……",
    "voice": "vo_adv_5006006_014",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "哇，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好噁心！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦，",
    "voice": "vo_adv_5006006_015",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那是什麼啊？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我們到底",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "在跟什麼戰鬥呀！？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "唔嗯。",
    "voice": "vo_adv_5006006_016",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我呀，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "曾繞到尾狗刀那小子和……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n某個學識淵博的朋友那裡。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "根據那個魔物研究專家的說法，",
    "voice": "vo_adv_5006006_017",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n那是一種叫亡靈鎧甲的東西。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "亡靈鎧甲……",
    "voice": "vo_adv_5006006_018",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "活著的",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "鎧甲？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯。",
    "voice": "vo_adv_5006006_019",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是這麼稱呼的沒錯。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n正確來說，好像是一種能夠攝取金屬，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "然後轉化成該金屬的一種微生物群體。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n貪婪的攝取金屬，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "然後再模仿那金屬物的外觀。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是在為了戰爭，",
    "voice": "vo_adv_5006006_020",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而大量生產金屬武器和防具的時代，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n讓這生物大量繁殖起來的樣子。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n雖然我本來不知道，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但確實留有相關紀錄喔。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊啊……",
    "voice": "vo_adv_5006006_021",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n小時候，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "祖父的確有跟我說過類似的事。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n說鎧甲會在夜裡走動，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "劍則會搖搖晃晃地在空中飛舞。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那時還以為",
    "voice": "vo_adv_5006006_022",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只是一般的鬼怪故事罷了。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "原來真的存在呢。",
    "voice": "vo_adv_5006006_023",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "事實總是",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "比小說更曲折離奇啊……♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "總而言之。",
    "voice": "vo_adv_5006006_024",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "在戰爭中擔任著軍隊的角色，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n【王宮騎士團（NIGHTMARE）】的裝備……\\n武器和防具，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "讓亡靈鎧甲存在了好長一段時間。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "然後在不知不覺中增加……",
    "voice": "vo_adv_5006006_025",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n大概是捕食了倉庫中存放的鎧甲和劍，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n並取代了它們吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而這種魔物擁有群體性，",
    "voice": "vo_adv_5006006_026",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只要增加到一定的數量，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就會擁有一定程度的智能呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "然後開始自己移動，",
    "voice": "vo_adv_5006006_027",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n到處找麻煩。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "會先侵略獸人居住區，",
    "voice": "vo_adv_5006006_028",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "應該是因為他們的前身正是",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n長年迫害獸人的『王宮』的武器吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為、",
    "voice": "vo_adv_5006006_029",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為什麼會沒發現呢……？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "應該要定期仔細整理武器才是！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n若這麼做，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "任誰都會察覺異狀！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "和平的生活過得太久，",
    "voice": "vo_adv_5006006_030",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不小心大意了呢……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不過那些傢伙也為了不被我們懷疑而有所偽裝，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n平時動也不動，裝成一般的武器和防具了吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……",
    "voice": "vo_adv_5006006_031",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那這次",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "怎麼會突然暴走？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那些傢伙也是生物，",
    "voice": "vo_adv_5006006_032",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "需要經常補給營養。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n當同伴增加，就會因為食物不足而飢餓，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n然後為了找金屬而開始行動。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "若放置不管，",
    "voice": "vo_adv_5006006_033",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "城中的金屬恐怕都會進到他們的肚子裡呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "然後轉化為魔物……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可真恐怖呢，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "連用金屬製的鍋具做飯都不行呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "克莉絲提娜阿姨，",
    "voice": "vo_adv_5006006_034",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你也會做飯嗎？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "超意外！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我其實還滿賢慧的喲，",
    "voice": "vo_adv_5006006_035",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這反差就是我的魅力吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "然後你如果再稱我『阿姨』，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我可是會擰掉你那可愛的耳朵的喲♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……現在可不是玩鬧的時候喲，",
    "voice": "vo_adv_5006006_036",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖說",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "膚淺粗心如我也沒什麼資格說話就是了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "亡靈鎧甲那些傢伙好像",
    "voice": "vo_adv_5006006_037",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n想要集結所有力量擊潰我們的樣子。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "融合之後，",
    "voice": "vo_adv_5006006_038",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "變成了巨大的金屬集合體了！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n比建築物還大呢……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "若他大鬧起來，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "會造成城鎮莫大的傷害！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "而且敵人擁有攝取金屬進而繁殖的特性，",
    "voice": "vo_adv_5006006_039",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n可能會搜刮城中的金屬，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "進一步變得更大。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n的確有必要",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "殲滅呢。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為了守護蘭德索爾的和平。",
    "voice": "vo_adv_5006006_040",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "了解。",
    "voice": "vo_adv_5006006_041",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "反過來想，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n敵人聚成一塊後，反而更好掌握了呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n只要能把他打倒，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就姑且沒事了吧？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "保險起見。",
    "voice": "vo_adv_5006006_042",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "打倒那敵人後，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n最好再用金屬探測魔法在城中探查一番。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "若發現還有漏網之魚，",
    "voice": "vo_adv_5006006_043",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "再進一步處理。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可不想再經歷一次這種騷動了吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "順帶一提，",
    "voice": "vo_adv_5006006_044",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我可不想處理這種麻煩事呢……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就交給你們了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可以吧。",
    "voice": "vo_adv_5006006_045",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "作為交換，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n希望你能幫忙打倒眼前這個巨大魔物。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我們需要你的戰力，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "克莉絲。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "被這樣信任還真開心呢。",
    "voice": "vo_adv_5006006_046",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n但是相信我這種人，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n等一下被背叛可不會同情妳喔？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "至少",
    "voice": "vo_adv_5006006_047",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "比會為食慾所牽動的敵人……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n比裝成我們的冒牌貨",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "值得信任。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "作為有智慧的人類，",
    "voice": "vo_adv_5006006_048",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "值得信賴的夥伴，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n守護城鎮和平正義的夥伴……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "讓我們\\n【王宮騎士團】",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "齊心協力解決問題吧。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "全體",
    "voice": "vo_adv_5006006_049",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "拔劍！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n掃蕩亡靈鎧甲，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這惡劣的魔物！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "了解了，",
    "voice": "vo_adv_5006006_050",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "純！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗚啊啊啊啊！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "必殺一擊！",
    "voice": "vo_adv_5006006_051",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n吃下我這正義的一刀吧……☆",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "停！",
    "voice": "vo_adv_5006006_052",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n茉莉，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不行這樣隨意亂砍呀！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "敵人可是會攝取金屬的，",
    "voice": "vo_adv_5006006_053",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n若拿刀砍的話，刀可能會被奪走的！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦，",
    "voice": "vo_adv_5006006_054",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那該怎麼戰鬥啊？　",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "肉搏戰嗎？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但敵人可是金屬呢，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "打過去的話反而是我的手會碎掉喔！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "其實，",
    "voice": "vo_adv_5006006_055",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我們的鎧甲和劍在和敵人纏鬥之下，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n應該已經遭一定程度的攝取了。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n從剛剛就開始覺得",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有點沉重呢。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "敵人攝取我們的鎧甲等裝備，",
    "voice": "vo_adv_5006006_056",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "並支配，進而妨礙我們行動。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n等戰鬥結束後可得好好檢查武器跟防具，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n用火燒來消毒敵人攝取過的部分……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "必須好好淨化一番。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "唔唔唔，",
    "voice": "vo_adv_5006006_057",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "覺得好噁心！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n不過被這麼一說，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n這劍的確有些不聽使喚呢……？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈。",
    "voice": "vo_adv_5006006_058",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這可是對於主攻近戰，且以金屬製武器和防具的裝備為主的",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n【王宮騎士團（NIGHTMARE）】來說是最不妙的敵人呀。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這可不是笑的時候呀！",
    "voice": "vo_adv_5006006_059",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "該、",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "該怎麼做呢？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n這狀況真棘手？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "驚慌失措的女孩們",
    "voice": "vo_adv_5006006_060",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還真可愛呢♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n放心吧……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "早知道會發生這樣的情形，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n聰明如我已經向『陛下』調度了特殊魔法兵器了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但因為是樣品，所以樣子不太好看就是了。",
    "voice": "vo_adv_5006006_061",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n木製、完全未使用金屬，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "類似魔法大砲……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "之類的東西。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "因為是在情急之下組裝的，",
    "voice": "vo_adv_5006006_062",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "說不定射一發就會報廢……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但會放射出連金屬都能融化的高溫射線，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n可以讓敵人原地蒸發。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你們就按照我的指示，",
    "voice": "vo_adv_5006006_063",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "誘導敵人到指定位置。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我會調整發射角度，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n在不波及鎮上的人的狀況下發射高溫射線。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "唔，",
    "voice": "vo_adv_5006006_064",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "有點意外呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我還以為你會說一些",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我才不管什麼居民咧～",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "之類的話。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "智啊，",
    "voice": "vo_adv_5006006_065",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "其實我可是很愛人類的喲。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n因為他們可是這無聊的塵世中，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "難得有趣的玩具們呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……總而言之。",
    "voice": "vo_adv_5006006_066",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這些都不重要，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你們最好在我轉變心意之前照指示動作。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n偶爾也該聽聽副團長",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "說的話吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "了解……",
    "voice": "vo_adv_5006006_067",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然要遵從你的指示讓我覺得有點不服氣，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但也沒有其他選擇了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊，",
    "voice": "vo_adv_5006006_068",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "太感謝了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我們需要你的幫忙呢，{0}。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒錯。",
    "voice": "vo_adv_5006006_069",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n小子，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你能強化同伴的力量對吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n用那個力量",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "幫助我們吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯。",
    "voice": "vo_adv_5006006_070",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "拜託了。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n請幫助我們增強，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "若不夠強，就無法生存下去，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為這裡可是殘酷的戰場。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然我也不想把孩子般的你",
    "voice": "vo_adv_5006006_071",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n帶到這樣的地方。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但你放心，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我會用生命保護你的。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不只是你，",
    "voice": "vo_adv_5006006_072",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這個鎮上的人……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n還有這個世界上的人，我都要守護。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那就是正義。",
    "voice": "vo_adv_5006006_073",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n武器跟防具，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還有我們，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "都是為了守護而生。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "唔呀，",
    "voice": "vo_adv_5006006_074",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "心情真好！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n太棒了，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "力量都湧現了喔！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "如此一來定能贏的！",
    "voice": "vo_adv_5006006_075",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n{0}，謝謝！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "茉莉，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "先到處轉轉引起敵人注意！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "唔，",
    "voice": "vo_adv_5006006_076",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "明白了！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我會照小智姐說的去做！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "看呀看呀♪",
    "voice": "vo_adv_5006006_077",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n鬼怪們，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我在這邊來抓我呀！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "引爆七彩的彈藥引來敵人的注目～",
    "voice": "vo_adv_5006006_078",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n這樣可以嗎？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "做的好！",
    "voice": "vo_adv_5006006_079",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n敵人想也不想的",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就直接往茉莉靠近！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n嘻嘻……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然多少有些智力，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但不懂劍術吧？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "來教教魔物吧，",
    "voice": "vo_adv_5006006_080",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "御久間流的奧義！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n先牽制敵人的腳部，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "讓他重心不穩而跌倒！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "當對手一不穩",
    "voice": "vo_adv_5006006_081",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n要煮要殺要剮都隨便你！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "幾乎等於勝利了嘛！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真是胡鬧……",
    "voice": "vo_adv_5006006_082",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n說什麼要跳到那暴走的巨大魔物腳邊，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還說要牽制呢。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然勇猛果敢不是壞事，",
    "voice": "vo_adv_5006006_083",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但走錯一步就會被踩扁喔？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但是，",
    "voice": "vo_adv_5006006_084",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "別浪費那勇氣！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n唔嗯……！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗚嗚。",
    "voice": "vo_adv_5006006_085",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我的鎧甲好像全被攝取了一般，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n全身都覺得好沉重……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但是我",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在未經世事之前，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就和這身鎧甲頭盔在一塊了。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "要將這熟悉的重量，",
    "voice": "vo_adv_5006006_086",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "轉為力量釋放！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "克莉絲！",
    "voice": "vo_adv_5006006_087",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我會盡全力撞擊敵人然後跳到空中，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你就趁機用大砲瞄準敵人攻擊！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "了解。",
    "voice": "vo_adv_5006006_088",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "偶爾合作行動也不錯嘛……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還真開心呢♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這可是工作，",
    "voice": "vo_adv_5006006_089",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "開心不開心不重要……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只要做好該做的事！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嘻嘻。",
    "voice": "vo_adv_5006006_090",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "各位，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "快到我身後躲著吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n人類若碰到這高溫射線，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可是連骨頭都不會剩喔？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "恐怖……",
    "voice": "vo_adv_5006006_091",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "全員，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "快迴避！　",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "防備衝擊！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n克莉絲，全力發射吧！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "遵命！",
    "voice": "vo_adv_5006006_092",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "大膽地發射煙火吧，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n名為正義的煙火！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "still",
    "still_id": "500600602"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊啊真是的，",
    "voice": "vo_adv_5006006_093",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "塵土飛揚害衣服都髒了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "still",
    "still_id": "500600603"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但是啊，",
    "voice": "vo_adv_5006006_094",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "意外地感覺不錯呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可以紓解壓力呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "一想到還得掃蕩剩下的敵人，",
    "voice": "vo_adv_5006006_095",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n還要因為城中兵器散落的關係寫悔過書，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n頭就痛起來。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那些麻煩事，",
    "voice": "vo_adv_5006006_096",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就交給你們了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "擁有能夠互相支持、互相幫助的夥伴，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真是太棒囉♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只有在對自己有利的時候說是夥伴……",
    "voice": "vo_adv_5006006_097",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "算了啦，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為我也是這麼想的。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那麼，",
    "voice": "vo_adv_5006006_098",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這耀眼的光……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就把所有的不信任、猜疑還有魔物一起，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "和所有壞東西一起消滅吧。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n雖然現實往往不會這麼美好，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但我真切這麼期望著。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "結果……\\n奇妙的魔物——亡靈鎧甲\\n就在大砲的高溫射線的照射之下蒸發了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "由於【王宮騎士團（NIGHTMARE）】的行動，\\n鎮上的騷動總算解決了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後，經過金屬探測魔法等繁複的作業，\\n終於解除了魔物的威脅。\\n雖然這世上沒有什麼『絕對』，但這件事暫且落幕了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  }
]
