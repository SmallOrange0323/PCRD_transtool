[
  {
    "type": "background",
    "bg_id": "502791"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "煉獄，",
    "voice": "vo_adv_5213082_000",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "吉歐‧格黑納──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "棲息於此種種魔物，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "強弱有異，滋味千差萬別。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "身披烈焰之魔物肉，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "炙烤得宜則香氣馥郁。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "帶有毒性之魔物肉，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "調製有方則可得其藥效。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "且說，",
    "voice": "vo_adv_5213082_001",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "若將此諸般肉類悉數入鍋，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "咕嘟咕嘟地",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "慢火熬煮，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n又將匯成何等風味？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此乃吉歐‧格黑納流，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "雜燴鍋之極意──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "還望尊客細細品鑑這成果。",
    "voice": null,
    "unit_id": 129711
  }
]
