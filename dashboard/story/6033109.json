    "type": "dialogue",
    "name": "Misty★霞",
    "words": "……感覺她會在舞蹈加入變身姿勢，",
    "voice": "vo_adv_6033109_003",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "一邊說著「是模仿霞的唷～♪」",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
