[
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在【美食殿堂】的公會小屋中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n貪吃佩可召集眾人並提出了某個計畫。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "跟【美食殿堂】的各位",
    "voice": "vo_adv_1099007_000",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "去冒險？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是的！",
    "voice": "vo_adv_1099007_001",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你們",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "遲早都會回去原本的世界不是嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我想要在那之前，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "與你們一起享受冒險☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是我們平常在進行的那種吃遍之旅，",
    "voice": "vo_adv_1099007_002",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n而是遊歷各個都市，類似觀光的行程。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如何？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "之前",
    "voice": "vo_adv_1099007_003",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "聊到冒險話題時，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下看您似乎興致勃勃，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n於是便去找貪吃佩可小姐商量了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不知是否會造成您的困擾？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我非～常地開心喔！",
    "voice": "vo_adv_1099007_004",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n還請務必讓我同行。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你們覺得怎麼樣？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "贊成贊成，",
    "voice": "vo_adv_1099007_005",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "舉雙手贊成！",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n光是聽到冒險兩個字",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "就覺得興奮啊。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "要是愛蜜莉雅大人想去那麼就去吧。",
    "voice": "vo_adv_1099007_006",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n有這麼多厲害的護衛隨行，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "相信不會有危險的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真要說有什麼問題的話，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "頂多就是有個礙手礙腳的巴魯斯。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "姊姊妳也太傷人了吧！？",
    "voice": "vo_adv_1099007_007",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我當然很清楚自己實力不足，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "但我會努力",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不要扯大家後腿的。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "你不需要擔心喔，",
    "voice": "vo_adv_1099007_008",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "昴。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n雷姆一定會",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "保護好昴的。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "名為體貼的利刃",
    "voice": "vo_adv_1099007_009",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "刺進男生的心裡啦！",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯，",
    "voice": "vo_adv_1099007_010",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "肯定很有趣呢。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我現在",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "就已經開始期待了！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "background",
    "bg_id": "500651"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "決定要與【美食殿堂】一同冒險之後過了幾天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n愛蜜莉雅等人前去巡訪各式各樣的地方。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "哇，",
    "voice": "vo_adv_1099007_011",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "好棒的街景喔！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "有好多我沒看過的建築物。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "唔喔喔，",
    "voice": "vo_adv_1099007_012",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "想不到阿斯特賴亞大陸",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "還挺懂和風之心的嘛！",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "這裡該不會",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "也有溫泉吧？",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "昴、",
    "voice": "vo_adv_1099007_013",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "昴，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "你要去哪裡啊──！？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "昴先生，",
    "voice": "vo_adv_1099007_014",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "溫泉旅館在反方向。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們今天會在此留宿，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "大家一起過去吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "background",
    "bg_id": "501430"
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "巨大的風車，",
    "voice": "vo_adv_1099007_015",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "充滿笑容的城鎮……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "雖然聽說過這裡是獸人族的國家，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "但想不到是個朝氣蓬勃的好地方。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "巴魯斯，",
    "voice": "vo_adv_1099007_016",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "一直東張西望的會被逮捕喔。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "太不講理了吧……",
    "voice": "vo_adv_1099007_017",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n我根本什麼都還沒做啊！",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不對，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "之後也不會做好嗎！",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "過去跟獸人族",
    "voice": "vo_adv_1099007_018",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也曾經有一段關係緊繃的",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n時期……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但如今的關係已經有所改善，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n蘭德索爾裡",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也有許多獸人族居住。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒錯☆",
    "voice": "vo_adv_1099007_019",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n現在也有很多獸人族的人\\n加入了【王宮騎士團】喔！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "意思是曾經對立的兩個種族，",
    "voice": "vo_adv_1099007_020",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "如今可以和睦相處了？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n竟然能辦到這種事呢！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "background",
    "bg_id": "501530"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "聽說薩拉薩利亞這裡",
    "voice": "vo_adv_1099007_021",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有一種把潛伏在沙裡的魔物釣起來，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n名為「流沙釣」",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "的傳統漁法！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我之前聽咲戀小姐提過，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "早就想來挑戰一次看看了～！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "在沙漠駕駛船支",
    "voice": "vo_adv_1099007_022",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "將魔物釣起這種事，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真讓人意想不到……！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "可是為什麼驅除魔物",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "還要特地釣起來呢？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是的☆",
    "voice": "vo_adv_1099007_023",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n因為他們不光是把魔物釣上來，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還會做成美味料理！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
