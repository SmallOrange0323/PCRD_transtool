  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一起去買東西的\\n{0}和伊緒。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，和你一起出來買東西，",
    "voice": "vo_adv_1018008_000",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n真開心。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n好像約會一樣。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "咦？ 這是那時候的光……？",
    "voice": "vo_adv_1018008_001",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n啊，好耀眼……！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊！",
    "voice": "vo_adv_1018008_002",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "still",
    "still_id": "101800801"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊！",
    "voice": "vo_adv_1018008_003",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你醒來了呀。太好了～",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "記得嗎？",
    "voice": "vo_adv_1018008_004",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n你和其他男生鬧著玩的時候，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n從樓梯摔下來了喔？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我好擔心你會不會就這樣",
    "voice": "vo_adv_1018008_005",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n醒不過來了……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊，還不可以亂動喔！",
    "voice": "vo_adv_1018008_006",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "要好好休息才行。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "而、而且……",
    "voice": "vo_adv_1018008_007",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n你動來動去的話，好癢喔。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是呀，因為剛剛你好像睡得很不舒服的樣子……",
    "voice": "vo_adv_1018008_008",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這樣不好嗎？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸！不行啊！",
    "voice": "vo_adv_1018008_009",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n要是去了天堂，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n就再也醒不過來了！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……？",
    "voice": "vo_adv_1018008_010",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n不是那個意思嗎？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n是很舒服嗎？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，太好了。",
    "voice": "vo_adv_1018008_011",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n你這樣說我真開心。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那就再繼續躺一會兒……",
    "voice": "vo_adv_1018008_012",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "等到你感覺舒服一點，就維持這樣吧？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "沒關係唷。",
    "voice": "vo_adv_1018008_013",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n沒有其他人在。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "只有我們兩個人，你可以盡情撒嬌喔。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……啊！",
    "voice": "vo_adv_1018008_014",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n你的手指流血了……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是摔倒的時候擦傷的吧。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "讓我看看。",
    "voice": "vo_adv_1018008_015",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……這樣大小的傷口，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n只要舔一舔就沒事了。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "蛤嗯……",
    "voice": "vo_adv_1018008_016",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……嗯！這樣就沒問題了。",
    "voice": "vo_adv_1018008_017",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "咦？怎麼了？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n臉紅通通的……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510211"
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "我只是來看看狀況……",
    "voice": "vo_adv_1018008_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "\\n你這是在做什麼啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "竟然躺在我們伊緒的膝蓋上，",
    "voice": "vo_adv_1018008_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "\\n還強迫她舔你的手指！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "不可原諒！極刑懲罰才行！",
    "voice": "vo_adv_1018008_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "\\n大家上吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊！",
    "voice": "vo_adv_1018008_021",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n你要去哪裡！？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "別跑！",
    "voice": "vo_adv_1018008_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "\\n快追！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，太好了。",
    "voice": "vo_adv_1018008_023",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這麼有活力的話，應該沒事了。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如何呢？這是我給你的禮物！",
    "voice": "vo_adv_1018008_024",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你做了個好『夢』嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這是我依照你和伊緒的記憶創造出來的『夢』，",
    "voice": "vo_adv_1018008_025",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n原來現在的你會採取這樣的行動啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我看了也很開心呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次見囉～ ♪",
    "voice": "vo_adv_1018008_026",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊，你醒了嗎？",
    "voice": "vo_adv_1018008_027",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯，我剛剛也睡著了……",
    "voice": "vo_adv_1018008_028",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n又做了不可思議的夢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你也是嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我照顧你的夢？",
    "voice": "vo_adv_1018008_029",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "果然是同樣的夢呢……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n發生好幾次這種事，真是好不可思議呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊，話說回來，我們原本要去買保健室的用品對吧？",
    "voice": "vo_adv_1018008_030",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……所以才會做這種夢嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那我們快去買東西吧。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……啊，小心點。",
    "voice": "vo_adv_1018008_031",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n不要像夢裡面一樣跌倒受傷了。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "和{0}一起去買東西的路上，\\n伊緒心中期望著可以再做同樣的夢。",
    "voice": null,
    "unit_id": null
  }
]
