  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當{0}為了送郵件而造訪咲戀育幼院時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看見了與平時有所不同的場面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊，",
    "voice": "vo_adv_1028010_000",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你啊。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不可以挖那邊的土地喔。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要維護庭院",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也是很辛苦的。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "咦～！",
    "voice": "vo_adv_1028010_001",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "但這裡",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "可以抓到很多蚯蚓，很好玩欸！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不可以去嚇到蚯蚓啊。",
    "voice": "vo_adv_1028010_002",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就不要再去管蚯蚓了吧。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "可是～！",
    "voice": "vo_adv_1028010_003",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沒什麼可是不可是的。",
    "voice": "vo_adv_1028010_004",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "改去玩其他遊戲吧。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "好～～",
    "voice": "vo_adv_1028010_005",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真是的。",
    "voice": "vo_adv_1028010_006",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n那個年紀的小孩，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "老是會對莫名其妙的東西有興趣……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "哎呀？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n{0}。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "謝謝你總是幫忙送郵件。",
    "voice": "vo_adv_1028010_007",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n不曉得今天寄來了什麼？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我看看～？",
    "voice": "vo_adv_1028010_008",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這是買東西的明細，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "而這是……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "喔喔，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是那群孩子要接種疫苗的通知啊，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "原來已經到了這時期嗎。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "唉～",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我必須要處理的手續",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "多得跟山一樣呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過，",
    "voice": "vo_adv_1028010_009",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "看起來似乎是沒有需要緊急處理的文件呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "畢竟我現在手邊忙不過來，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真的是太好了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓、胡桃",
    "voice": "vo_adv_1028010_010",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "和綾音她們現在都出去了，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我得一個人",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "照顧那群孩子。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "大家都太有精神了，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "搞得我手忙腳亂的。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "喂～！",
    "voice": "vo_adv_1028010_011",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "我在石頭下面",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "找到了好多",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "奇怪的蟲喔～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我說啊！",
    "voice": "vo_adv_1028010_012",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有些蟲可能有毒，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不可以用手碰喔～！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "知道了～！",
    "voice": "vo_adv_1028010_013",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "我會小心～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "唉……",
    "voice": "vo_adv_1028010_014",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我現在真的很想找人幫忙。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我問你。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你可以幫我",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "去跟孩子們",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "一起玩嗎？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然想這麼說，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但你還在工作中呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真的嗎？",
    "voice": "vo_adv_1028010_015",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但是",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "害你翹班這樣……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這裡是最後一處送件地點是嗎？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那我就不用顧慮了，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "拜託你囉。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "大哥哥！",
    "voice": "vo_adv_1028010_016",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "一起玩球吧！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "大哥哥已經",
    "voice": "vo_adv_1028010_017",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "跟我約好要玩扮家家酒了啦～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "玩什麼扮家家酒，",
    "voice": "vo_adv_1028010_018",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "還是玩球比較開心吧？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "對吧，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "大哥哥！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "呿～！",
    "voice": "vo_adv_1028010_019",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "那玩完扮家家酒以後，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "下一個要跟我玩喔！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "我們約好了！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呵呵，",
    "voice": "vo_adv_1028010_020",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "他真受歡迎呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "大哥哥",
    "voice": "vo_adv_1028010_021",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "你負責當狗！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "應該是",
    "voice": "vo_adv_1028010_022",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "受歡迎的對吧……？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "這是最後一球了！",
    "voice": "vo_adv_1028010_023",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "\\n吃我的",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "超級無敵高速球吧～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "啊～～！",
    "voice": "vo_adv_1028010_024",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "真的被擋下了！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "太不手下留情了吧！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "很好，",
    "voice": "vo_adv_1028010_025",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "那接下來去抓蟲子吧！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "\\n那邊有很多奇怪的蟲喔！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "\\n我帶大哥哥你去看！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "什麼",
    "voice": "vo_adv_1028010_026",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "走吧！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n要阻止他啊！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你剛才也有聽到",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我在阻止他吧！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沒什麼可是不可是！",
    "voice": "vo_adv_1028010_027",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這對話",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "根本和剛才一樣啊。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "唉～",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我還以為你要幫忙照顧他們，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n你這樣不就真的只是在跟他們一起玩而已嗎。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "感覺本來想找人幫忙，",
    "voice": "vo_adv_1028010_028",
    "unit_id": 102811
  },
  {
