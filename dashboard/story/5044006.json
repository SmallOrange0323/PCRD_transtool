    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "和星星有關的傳說中，",
    "voice": "vo_adv_5044006_083",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "由於花心星有迷惑他人的力量，",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "\\n因此也使得他成為被其他星星疏遠的存在。",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "花心星。",
    "voice": "vo_adv_5044006_084",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "牛郎剛才說的",
