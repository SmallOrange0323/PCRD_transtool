  },
  {
    "type": "dialogue",
    "name": "牛郎",
    "words": "是的，",
    "voice": "vo_adv_5044006_081",
    "unit_id": 4711
  },
  {
    "type": "dialogue",
    "name": "牛郎",
    "words": "在星空中",
    "voice": null,
    "unit_id": 4711
  },
  {
    "type": "dialogue",
    "name": "牛郎",
    "words": "看見孤單的他，",
    "voice": null,
    "unit_id": 4711
  },
  {
    "type": "dialogue",
    "name": "牛郎",
    "words": "\\n而先向他搭話的，是我。",
    "voice": null,
    "unit_id": 4711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊～",
    "voice": "vo_adv_5044006_082",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我好像有在繪本中讀過這樣的內容……？",
