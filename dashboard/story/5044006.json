    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是真的嗎？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "喔，對啦。",
    "voice": "vo_adv_5044006_085",
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "牛郎向本大爺搭話的時候，本大爺很開心呢……",
    "voice": null,
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "\\n然後，",
    "voice": null,
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "這傢伙說他因為見不到織女而寂寞，",
    "voice": null,
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "\\n本大爺才想說要為他做點什麼。",
    "voice": null,
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "然後，",
    "voice": "vo_adv_5044006_086",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你就引起了這場騷動嘛。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "放心吧，本大爺已經要走了……",
    "voice": "vo_adv_5044006_087",
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "\\n就這樣回到在空無一人的星空盡頭，",
    "voice": null,
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "\\n大概就也不會",
    "voice": null,
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "再和你們見面了吧。",
    "voice": null,
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的，",
    "voice": "vo_adv_5044006_088",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真拿你沒辦法呢。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "對了，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "織女、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "牛郎！",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": " 要是你們願意的話，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n這之後",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要不要和花心星一起，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "在銀河生活呢？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "和花心星……",
    "voice": "vo_adv_5044006_089",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "嗎？",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯。",
    "voice": "vo_adv_5044006_090",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "在你們兩個無法相見的日子裡，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就讓花心星為你們聯繫感情。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n這樣一來，你們既能夠聽到對方的近況，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "花心星也能和你們說說話不是嗎。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "牛郎",
    "words": "這是個好主意！",
    "voice": "vo_adv_5044006_091",
    "unit_id": 4711
  },
  {
    "type": "dialogue",
    "name": "牛郎",
    "words": "\\n這樣既多了一個聊天對象，",
    "voice": null,
    "unit_id": 4711
  },
  {
    "type": "dialogue",
    "name": "牛郎",
    "words": "也能期待聽到織女的事了。",
    "voice": null,
    "unit_id": 4711
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "是啊，",
    "voice": "vo_adv_5044006_092",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "感覺像是有點奇特的書信往來，很有趣呢。",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "你、",
    "voice": "vo_adv_5044006_093",
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "你們……",
    "voice": null,
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "願、",
    "voice": null,
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "願意原諒本大爺嗎？",
    "voice": null,
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "我還是對於你附身在牛郎身上作惡這件事",
    "voice": "vo_adv_5044006_094",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "感到相當地生氣。",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "\\n想必往後好一陣子，",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "我仍會時不時地回憶起來吧。",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "不過……",
    "voice": "vo_adv_5044006_095",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "我也能夠理解你的心情。",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "\\n",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "所以，",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "你要是能和我們一起在銀河生活，",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "我就原諒你吧。",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "……真、",
    "voice": "vo_adv_5044006_096",
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "真沒辦法啊！",
    "voice": null,
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "花心星",
    "words": "本大爺就陪陪你們吧。",
    "voice": null,
    "unit_id": 13611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣事情就算是解決了，",
    "voice": "vo_adv_5044006_097",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "對吧。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯，",
    "voice": "vo_adv_5044006_098",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "可喜可賀可喜可賀。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這樣祭典也能順利進行了吧！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "走吧，牛郎。",
    "voice": "vo_adv_5044006_099",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "我們來讓這一年一度的盛宴……",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "讓七夕開幕吧！",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在流夏、杏奈、七七香及{0}的活躍表現下",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n順利消除了織女、牛郎和花心星之間的芥蒂，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n也終於能為接下來的七夕祭做準備了。",
    "voice": null,
    "unit_id": null
  }
