  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "呃……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就例如說，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n會在看似一般的自我介紹裡面，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n不經意暗示自己條件多好的那種煩人傢伙啊。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不是常會有嗎？",
    "voice": "vo_adv_1109002_031",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那種在提到自己家鄉或現在住處的時候，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n一臉高高在上講出高級住宅區的名字來展現優勢的人。",
