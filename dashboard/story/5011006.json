  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}遭到魔物抓走。\\n惠理子憤怒發狂地攻擊魔物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這傢伙、",
    "voice": "vo_adv_5011006_000",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這傢伙、",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這傢伙！　",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "把我的……",
    "voice": "vo_adv_5011006_001",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "還回來！",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "background",
    "bg_id": "500601"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "呼、",
    "voice": "vo_adv_5011006_002",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "呼……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "對手是黏黏稠稠的巧克力……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不管怎麼斬，",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "都完全無法造成傷害……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "醜陋可愛",
    "words": "――咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 11011
  },
  {
    "type": "background",
    "bg_id": "500601"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "唔，",
    "voice": "vo_adv_5011006_003",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "從尾巴射出了可可果。",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "被那種東西打中會造成致命傷呢……",
    "voice": "vo_adv_5011006_004",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "怎麼辦！　",
    "voice": "vo_adv_5011006_005",
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "怎麼辦！",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "都怪我，哥哥才會……！",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃，",
    "voice": "vo_adv_5011006_006",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "振作點！",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n首先來思考打倒魔物的辦法吧。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "唔、嗯……",
    "voice": "vo_adv_5011006_007",
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "說得也是呢，姐姐。",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呃……",
    "voice": "vo_adv_5011006_008",
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我覺得小可是因為",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n來到這個會場聽太多惡言惡語，",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n所以可可亞才會變成魔物。",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "原來如此……",
    "voice": "vo_adv_5011006_009",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n而且就算變成魔物以後，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "似乎也因為聽到惡言惡語而變得更強了。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "沒錯。",
    "voice": "vo_adv_5011006_010",
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以，",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "只要用比至今的惡言惡語",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n還更多的幸福話語灌進牠的心中，",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "或許就能阻止牠的失控了？",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "still",
    "still_id": "501100601"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯！　",
    "voice": "vo_adv_5011006_011",
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那一定就是",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "魔物的弱點了。",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "看我用愛的力量",
    "voice": "vo_adv_5011006_012",
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "射穿你！",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃、靜流、惠理子",
    "words": "上啊啊啊啊啊啊―――！",
    "voice": "vo_adv_5011006_013",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500601"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嗚嗚……",
    "voice": "vo_adv_5011006_014",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "怎麼會這麼慘。",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n全身都是巧克力黏答答的……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "啊，",
    "voice": "vo_adv_5011006_015",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "和這比起來，{0}大人呢……！",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "沒什麼大礙。",
    "voice": "vo_adv_5011006_016",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "似乎只是受到撞擊而有點頭暈。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呼，",
    "voice": "vo_adv_5011006_017",
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "太好了～",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "魔物的話，",
    "voice": "vo_adv_5011006_018",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "已經被我們打倒了，放心吧。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}",
    "voice": "vo_adv_5011006_019",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就躺在姐姐的大腿上",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好好休息吧。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哎呀，",
    "voice": "vo_adv_5011006_020",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "比起自己，居然先關心我們的樣子……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不過，我比較擔心{0}大人的身體。",
    "voice": "vo_adv_5011006_021",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "讓我好好看看",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您的身體吧……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，",
    "voice": "vo_adv_5011006_022",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "喂～！　",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳想趁亂做些什麼啊！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "三人再次圍繞著{0}展開爭論，\\n但她們臉上都充滿了開朗的笑容。",
    "voice": null,
    "unit_id": null
  }
]
