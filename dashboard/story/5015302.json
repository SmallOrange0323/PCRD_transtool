[
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這股驚人的力量……",
    "voice": "vo_adv_5015302_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "真不愧是",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "仿造了東國惡人的代名詞，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n也就是模仿惡代官的魔物呢。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不過，",
    "voice": "vo_adv_5015302_001",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "惡代官",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n在東國的傳說裡，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "其實",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "並不強啊？",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是、",
    "voice": "vo_adv_5015302_002",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是這樣嗎……！？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那個像野獸般的眼神，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "我還以為\\n一定是知名的虐待狂……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然我也畏懼權力，",
    "voice": "vo_adv_5015302_003",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過我一直覺得",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n世界上存在著英雄們會去討伐的邪惡之王……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "總之，",
    "voice": "vo_adv_5015302_004",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "它的弱點是",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "女性",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "和金錢，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "大概",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "一擊就會",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "被英雄給打死了呢。",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……感覺應該很容易就能獲勝。",
    "voice": "vo_adv_5015302_005",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你們兩位，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "要一口氣分出勝負了喔！",
    "voice": null,
    "unit_id": 105311
  }
]
