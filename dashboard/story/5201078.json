  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "好感度是……？",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "直接問似乎會比較快。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "似似花，",
    "voice": "vo_adv_5201078_005",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我想問妳這個道具，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "好感度",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "到底是什麼？",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就是好感度。",
    "voice": "vo_adv_5201078_006",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "如果這是考試",
    "voice": "vo_adv_5201078_007",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "我可要算妳答錯喔。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "好感度是什麼？",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n目前",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "應該沒有準備這種數值才對……",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "只要蛋糕好吃，",
    "voice": "vo_adv_5201078_008",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "好感度就會提升。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "原來如此。",
    "voice": "vo_adv_5201078_009",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "妳沒打算讓我理解是吧？",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "大量裝飾的數種莓果酸味，",
    "voice": "vo_adv_5201078_010",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "與香甜滑順的鮮奶油，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n入口即化的滋味",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "均勻地在口中混合，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "滲透糖分不足的",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n大腦和身體，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "好感度",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "勢必會就此上升。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "……這是要我怎麼處理……",
    "voice": "vo_adv_5201078_011",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "總之……",
    "voice": "vo_adv_5201078_012",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
