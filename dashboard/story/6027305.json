[
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "君は随分と",
    "voice": "vo_adv_6023305_000",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "交友が多岐に渡ると聞いたが。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "その中には、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "知に富み",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "学に高じた人物もいるだろうか？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "端的に換言すれば、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくに似た者ということだ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "おお、",
    "voice": "vo_adv_6023305_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ミツキ師のことか。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "彼女とは知己だ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nひねくれた里の老賢者たちが認める、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "数少ない才女だからな。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nちなみに、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくの薬学知識は",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "おおむねミツキ師の教えによるものだ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ほう、",
    "voice": "vo_adv_6023305_002",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "優れた頭脳で",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "難事件もたやすく解決する",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "名探偵とな！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくは極論、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "人より多くの文字を読んできた",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "好事家に過ぎない。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "機転や発想にも秀でた",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そのような才能とは",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "比べるべくもないさ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "なにっ、",
    "voice": "vo_adv_6023305_003",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "優雅にキメちゃう大人のレディだと？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ということは、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "妖艶な色香のただよう",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "女豹のような才媛か。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "それはキャラ被りが甚だしい。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "差別化として",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "目玉の杖でも持つか……",
    "voice": null,
    "unit_id": 111011
  }
]
