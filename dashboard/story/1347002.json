[
  {
    "type": "background",
    "bg_id": "502080"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "鳳凰與{0}用出乎意料的方式拯救了農村。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n雖然鳳凰吃飽回到了吉歐‧格黑納──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我想起來了！",
    "voice": "vo_adv_1347002_000",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我想起來了啊～～～",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "多虧我吃了很多米，",
    "voice": "vo_adv_1347002_001",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "才能想起重要的事情！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "呵呵呵，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "你可別嚇到喔……？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "心臟做好準備了嗎？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "呵呵呵。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我在這個吉歐‧格黑納，",
    "voice": "vo_adv_1347002_002",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n有一座美得舉世無雙，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "甚至美得難以描繪的庭園！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "其名為──",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "「鳳凰的庭園」！！",
    "voice": "vo_adv_1347002_003",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "沒錯沒錯～",
    "voice": "vo_adv_1347002_004",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "小小的庭園裡",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "有隻小雞──",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "才不是啦～～～！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "誰是小雞啊！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n不要像真陽一樣說那種話！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "咳咳，",
    "voice": "vo_adv_1347002_005",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "總之，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我也會邀請騎士先生去那個庭園。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "只要去了那裡，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我的神力想必",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "也會恢復",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "更多更～多！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "好了，",
    "voice": "vo_adv_1347002_006",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "跟我來吧～！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "background",
    "bg_id": "502090"
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "啊啊啊啊啊啊啊啊啊～～～！！",
    "voice": "vo_adv_1347002_007",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n怎麼會～～～～～～？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n為什麼",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "事情會變成這樣～！？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "那壯麗且美麗，",
    "voice": "vo_adv_1347002_008",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "簡直有如我的心一般純淨的庭園！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n變成只剩",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "融化的岩石跟沒融化的岩石",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "的慘狀了～！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不、",
    "voice": "vo_adv_1347002_009",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不可原諒……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不可原諒啊……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n竟敢這樣捉弄",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "淨化的",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "神鳥，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "非常偉大的我……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n竟敢這樣",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "捉弄我～！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "啾啾啾──！",
    "voice": "vo_adv_1347002_010",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "所以就說我不是小雞了！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "總之不可原諒！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我要找犯人！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n被我找到",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "就要拳頭伺候！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "朝著臉拳頭伺候20下！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "讓對方見識見識！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "……不、",
    "voice": "vo_adv_1347002_011",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不對，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "算了，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "被拳頭伺候太可憐，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n所以還是彈額頭之類的好了，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "嗯。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "才、",
    "voice": "vo_adv_1347002_012",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "才不溫柔！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "現在的我",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "可是鬼神！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "已經化為復仇之鬼了！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "來吧，騎士先生，",
    "voice": "vo_adv_1347002_013",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "要來找犯人了喔！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n就先從打聽開始！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "background",
    "bg_id": "502110"
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "啊啊，",
    "voice": "vo_adv_1347002_014",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "那座庭園的話──",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n不久前被失控的萬花菲尼克斯燒掉了喔，",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n連點痕跡都不剩。",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "犯人",
    "voice": "vo_adv_1347002_015",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不就是我自己嗎～～！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "嗚嗚嗚。",
    "voice": "vo_adv_1347002_016",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "請",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "彈我的額頭吧……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n輕輕地喔，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "輕輕地……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "啊！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "好痛好痛！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "麻、",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "麻煩用小指～～～！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "這悲嘆可真誇張。",
    "voice": "vo_adv_1347002_017",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n那座庭園確實",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "美得簡直不像是這世上的東西呢。",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "我還想再多看看啊。",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "就是說啊……",
    "voice": "vo_adv_1347002_018",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "就是說啊啊啊……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "那是一座非常棒的庭園……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "既華麗又繽紛……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n我明明",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "想讓騎士先生看看的……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "你、",
    "voice": "vo_adv_1347002_019",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "你願意幫忙嗎？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "也、",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "也對呢，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我才不能喪氣。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我們再重新蓋一座「鳳凰的庭園」吧！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "真努力呢。",
