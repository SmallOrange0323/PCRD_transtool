[
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦，",
    "voice": "vo_adv_5010212_000",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦？　",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗚哇――！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "日和沒事吧！？　",
    "voice": "vo_adv_5010212_001",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這是",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "什麼？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "地毯嗎？",
    "voice": "vo_adv_5010212_002",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "應該不是吧？　",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "黑色的霧……？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "可惡！　",
    "voice": "vo_adv_5010212_003",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "周遭一片漆黑！　",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "什麼都看不到！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "快看！　",
    "voice": "vo_adv_5010212_004",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "霧開始散了唷！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "難道說……",
    "voice": "vo_adv_5010212_005",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是在融合嗎……？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好像被什麼東西吸了過去！　",
    "voice": "vo_adv_5010212_006",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個是……！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……怎麼可能。",
    "voice": "vo_adv_5010212_007",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個是……！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……你們兩個快看。",
    "voice": "vo_adv_5010212_008",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那個，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不就是鏡餅嗎？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是嗎！　",
    "voice": "vo_adv_5010212_009",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這就是祭司說過的……！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "無法預料的情況……！",
    "voice": "vo_adv_5010212_010",
    "unit_id": 108811
  }
]
