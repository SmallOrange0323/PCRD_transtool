[
  {
    "type": "dialogue",
    "name": "紡希、千歌",
    "words": "……☆\\n……♪",
    "voice": "vo_adv_5110322_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不會吧，",
    "voice": "vo_adv_5110322_001",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌和紡希",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "怎麼會在這種地方……",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "冷靜點，望。",
    "voice": "vo_adv_5110322_002",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳看，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "只要仔細觀察，就會知道她們是假的，沒錯吧？",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……真的耶。",
    "voice": "vo_adv_5110322_003",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為之前發生的事，",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我好像變得有點緊張兮兮的。",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過，",
    "voice": "vo_adv_5110322_004",
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就算是冒牌貨，",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "外觀看起來還是妳的夥伴吧？",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這裡可以交給我來應付喔？",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……不，",
    "voice": "vo_adv_5110322_005",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒有關係。",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "或者應該說，讓我一起參戰吧。",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌和紡希已經夠倒楣了，",
    "voice": "vo_adv_5110322_006",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "竟然還做出她們的冒牌貨？",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "開什麼玩笑！",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們上吧，",
    "voice": "vo_adv_5110322_007",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘉夜、",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "矛依未！",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我要讓它瞧瞧",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "偶像生起氣來的可怕模樣！",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好、",
    "voice": "vo_adv_5110322_008",
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好喔……",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯～",
    "voice": "vo_adv_5110322_009",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "看來像她這類型的人被激怒，或許才是最可怕的。",
    "voice": null,
    "unit_id": 124911
  }
]
