[
  {
    "type": "dialogue",
    "name": "真步",
    "words": "求求你！",
    "voice": "vo_adv_5100321_000",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "聽咱們說話吧！",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "不要！",
    "voice": "vo_adv_5100321_001",
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "不要再管我了！",
    "voice": null,
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "\\n我已經",
    "voice": null,
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "不想跟任何人說話了！",
    "voice": null,
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "回去！",
    "voice": null,
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "如果你們不回去……",
    "voice": "vo_adv_5100321_002",
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哇哇，",
    "voice": "vo_adv_5100321_003",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好多魔物……！？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "怎麼辦，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可是如果不跨過這道難題，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就無法前往羊先生身邊了！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「逃跑……",
    "voice": "vo_adv_5100321_004",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "沒有這個選項對吧？",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "綾音、",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "公主！」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "當然了。",
    "voice": "vo_adv_5100321_005",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "一定要在這裡阻止羊先生才行。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "雖然希望",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "盡可能不要太粗魯……",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但現在似乎沒辦法說這種話呢。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "魔物先生小姐們，",
    "voice": "vo_adv_5100321_006",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "拜託了，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "請把道路讓開吧！",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "現在想盡可能",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "快點前進！",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "若是妨礙我們絕不手下留情！",
    "voice": "vo_adv_5100321_007",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "上吧──！",
    "voice": null,
    "unit_id": 123211
  }
]
