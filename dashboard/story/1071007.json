    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "如果真的就此分開，",
    "voice": "vo_adv_1071007_056",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "便絕對無法克服難關……",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就算無法克服，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只要大家待在一起，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就一定……",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可以一起向前邁進……",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "更何況──",
    "voice": "vo_adv_1071007_057",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要分開",
