    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "…………原來是這樣。",
    "voice": "vo_adv_1071007_045",
    "unit_id": 107131
  },
  {
    "type": "background",
    "bg_id": "510300"
