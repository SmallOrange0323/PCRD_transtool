  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_1071007_037",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這是什麼意思？",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "…………",
    "voice": "vo_adv_1071007_038",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "……我不是迷路。",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "其實我……",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "是離家出走。",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_1071007_039",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "什麼？",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n意思是說，妳是憑自己的意志離開家的囉。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "……因為，",
    "voice": "vo_adv_1071007_040",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "我是壞孩子。",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "我會把朋友弄哭……",
    "voice": "vo_adv_1071007_041",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "或是跑到危險的地方玩……",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n甚至還會對老師做一些讓他們很傷腦筋的惡作劇。",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "明明我只是想做一些開心的事而已。",
    "voice": "vo_adv_1071007_042",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "但每次我做開心的事……",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "大人們就會嚇到，",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "然後",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "罵我。",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "我老是讓爸爸和媽媽傷透腦筋，",
    "voice": "vo_adv_1071007_043",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "害他們傷心。",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n我是壞小孩。",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "所以呀，",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "我決定不要再當",
