[
  {
    "type": "background",
    "bg_id": "500353"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在克莉絲提娜徹底讓肉舖店主學到教訓的當天晚上──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500113"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_1071007_000",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "頭髮嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……噢，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "今天就不用麻煩了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我自己弄乾吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_1071007_001",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這只不過是模擬演習，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我們只是暫且過過看這種生活。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n如果開始習慣這樣過日子，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我們彼此都會很困擾吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……我的人生，",
    "voice": "vo_adv_1071007_002",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "充滿一個接一個的危險賭局。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就算我在這之後，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "轉而成為一名家庭主婦……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n也沒辦法逃離過往。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我打從一開始，",
    "voice": "vo_adv_1071007_003",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就不打算讓小子去替我償還，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "由我劍下產生的那些染上鏽色的恩怨。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……我不能把他給捲進來。",
    "voice": "vo_adv_1071007_004",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "…………",
    "voice": "vo_adv_1071007_005",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……呵。",
    "voice": "vo_adv_1071007_006",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n連如此簡單的結論沒有設想到，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就在那邊說什麼模擬演習，還真是樂昏頭了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "雖說是因為誓約而建立起的關係，",
    "voice": "vo_adv_1071007_007",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n但我似乎有些亂了分寸哪。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……我是怎麼搞的。",
    "voice": "vo_adv_1071007_008",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "──關於誓約，",
    "voice": "vo_adv_1071007_009",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我決定無限期進行保留。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n所以，模擬演習也到此為止。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "既然都這麼決定了，",
    "voice": "vo_adv_1071007_010",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就也去跟小子談──",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "…………唔！",
    "voice": "vo_adv_1071007_011",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n怎麼回事？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "窗外",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "有道好耀眼的光……？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂，給我等一下。",
    "voice": "vo_adv_1071007_012",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "很危險啊！",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真是的……",
    "voice": "vo_adv_1071007_013",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我剛才不是才說過不能衝到馬路上去嗎。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "知道了～♪",
    "voice": "vo_adv_1071007_014",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "啊～",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "那是什麼那是什麼～！？",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哦～",
    "voice": "vo_adv_1071007_015",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "話才剛說完，就立刻當耳邊風嗎。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n非常好。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "站住，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "說教時間到了！",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子，",
    "voice": "vo_adv_1071007_016",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "別笑了，快來幫忙。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "照這樣下去，不管花多久時間，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "恐怕都找不到那野丫頭的父母啊。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真是的……",
    "voice": "vo_adv_1071007_017",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我好不容易騰出工作上的空檔，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n來跟小子買新發售的遊戲啊。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "結果卻碰上這個迷路少女，還真是倒楣。",
    "voice": "vo_adv_1071007_018",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n說要去找警察，她也不要，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只好由我們兩個來負責找她的父母了。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我很不擅長和小孩相處。",
    "voice": "vo_adv_1071007_019",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n通常小孩看到我靠近，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就會害怕得哭起來。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……雖然就算他們哭，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "對我來說也是不痛不癢啦。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_1071007_020",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "的確。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "她反倒還一副很享受跟我鬧著玩的樣子。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……哼。",
    "voice": "vo_adv_1071007_021",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就讓我見識一下她能維持多久吧♪",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂～",
    "voice": "vo_adv_1071007_022",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那邊的野丫頭！",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "敢惹克莉絲提娜姐姐生氣，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小心吃不完兜著走！",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "呀啊──♪",
    "voice": "vo_adv_1071007_023",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼哈哈哈哈☆",
    "voice": "vo_adv_1071007_024",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n──給我站住！",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "欸，你看那邊",
    "voice": "vo_adv_1071007_025",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那三個人。",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "他們看起來好快樂呢。",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n不曉得是不是一家人？",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "雖然爸爸看起來非常年輕啦……",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "應該是一家人吧。",
    "voice": "vo_adv_1071007_026",
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哪天我們結婚，",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "或許就會像那樣走在街上呢。",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "嗯。",
    "voice": "vo_adv_1071007_027",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "好期待那天到來呢～♪",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "呵呵，",
    "voice": "vo_adv_1071007_028",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "似乎是呢。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n雖然很想吐槽",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "世上哪有這麼不像的一家人啦。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我原本從未想像過，",
    "voice": "vo_adv_1071007_029",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n像我這樣的人也會擁有家庭……",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但如果能有像小子這樣的老公，",
    "voice": "vo_adv_1071007_030",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "和這樣的小孩，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "或許就……",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "──呀",
    "voice": "vo_adv_1071007_031",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "啊！",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊啊……",
    "voice": "vo_adv_1071007_032",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "所以我才警告過妳的！",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "still",
    "still_id": "107100701"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "來，",
    "voice": "vo_adv_1071007_033",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
