[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "香織搭船啟程的日子來臨了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊……",
    "voice": "vo_adv_1017012_000",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "{0}，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你來為我送行嗎～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我接下來",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "正好要去碼頭那邊～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "直到剛才為止，",
    "voice": "vo_adv_1017012_001",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n【哞哞自衛隊】的大家",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "都在把氣氛炒得超級熱烈歡送我喔～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "大家一起唱歌跳舞，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "非常熱鬧呢～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……出發的日子終於到了呢～",
    "voice": "vo_adv_1017012_002",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我到現在",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "還是覺得不太真實～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過，",
    "voice": "vo_adv_1017012_003",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "雖然可能會花上一段時間，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n但我一定還會",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "再度回到這座城鎮的～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "在那之前，",
    "voice": "vo_adv_1017012_004",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "要先跟你們",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "暫時道別了～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "…………",
    "voice": "vo_adv_1017012_005",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不，",
    "voice": "vo_adv_1017012_006",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒什麼～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n比起這個，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們快去找船長──",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "可惡，",
    "voice": "vo_adv_1017012_007",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "怎麼會這樣！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "咦～？",
    "voice": "vo_adv_1017012_008",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "船長？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n這裡好像吵吵鬧鬧的，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "是怎麼了～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "喔，",
    "voice": "vo_adv_1017012_009",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "是小姑娘啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n……真抱歉，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "我們本來預計要在今天出發，但是……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "海裡……",
    "voice": "vo_adv_1017012_010",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "出現了魔物～！？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "那個渾蛋",
    "voice": "vo_adv_1017012_011",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "把航道直接堵住了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n而且牠還弄沉了在附近的船，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "再這樣下去，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "我的船也要……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那樣就糟了～！",
    "voice": "vo_adv_1017012_012",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n得想點辦法才行～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "我當然也很想這麼做，",
    "voice": "vo_adv_1017012_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "但那渾蛋",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "都不靠近陸地這邊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "從這裡",
    "voice": "vo_adv_1017012_014",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "根本沒有辦法出手，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n一定要主動",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "靠近牠才行……！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "牠想攻擊船隻耶～！？",
    "voice": "vo_adv_1017012_015",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不可以啦～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "喂，這位小兄弟，",
    "voice": "vo_adv_1017012_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "你別這麼亂來啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "雖然很不甘心，",
    "voice": "vo_adv_1017012_017",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "但船長說得沒錯～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n魔物這麼亂鬧，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "【哞哞自衛隊】",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "的大家一定會馬上過來的～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "咦？",
    "voice": "vo_adv_1017012_018",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你說那樣可能就來不及了……",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "是指？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這是為了我……？",
    "voice": "vo_adv_1017012_019",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你不用這麼做",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒關係啦～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n不必為我",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這麼努力也沒關係～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "為什麼要做到這個地步……",
    "voice": "vo_adv_1017012_020",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "呀！？",
    "voice": "vo_adv_1017012_021",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n你、",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你不能",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "突然說出這種話啦～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這很讓人開心，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "但我會小鹿亂撞的～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "{0}",
    "voice": "vo_adv_1017012_022",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "有在仔細地觀察我呢……",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這樣一想，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我都要開始",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "覺得有點害羞了……！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "原來如此……",
    "voice": "vo_adv_1017012_023",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "{0}是因為",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我沒有活力，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n才想為我去做各式各樣的事情啊～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "為了我……",
    "voice": "vo_adv_1017012_024",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "為了看到充滿活力的我……",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯，",
    "voice": "vo_adv_1017012_025",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我知道了……",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我不要再繼續",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "拖拖拉拉地迷惘下去了！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我也要跟你一起戰鬥～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "只要我們同心協力，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "一定能夠一拳",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "打趴那種魔物的～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "船長，",
    "voice": "vo_adv_1017012_026",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "但可以拜託你開船嗎～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我們想靠近那隻魔物～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "小兄弟和小姑娘，",
    "voice": "vo_adv_1017012_027",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "你們是認真的嗎！？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "當然了～！",
    "voice": "vo_adv_1017012_028",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n因為我們對自己的身手很有自信啊～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "……反正要是再繼續這樣下去，船也會被搞壞，",
    "voice": "vo_adv_1017012_029",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "那就在你們身上賭一把吧！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
