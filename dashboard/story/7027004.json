    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好，{0}！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們把祈梨當誘餌趁機逃跑吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "噫噫！？",
    "voice": "vo_adv_7027004_055",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "想丟下我！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳這沒人性的傢伙！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "知道了，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我知道了啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我把整個包包都扔掉！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔",
    "voice": "vo_adv_7027004_056",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗚嗚……！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "再見了，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我變成億萬富翁的夢想～～～！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……總算是逃過一劫了。",
    "voice": "vo_adv_7027004_057",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "犧牲的代價實在有夠大……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哈哈哈！",
    "voice": "vo_adv_7027004_058",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真是開心耶！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哪裡開心了！？",
    "voice": "vo_adv_7027004_059",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "通通都化為烏有了耶！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "矛依未妳的份也全都沒了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "到底有什麼好開心的！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "發現寶箱時的興奮期待……",
    "voice": "vo_adv_7027004_060",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "與夥伴一起逃脫怪物魔爪時的悸動心跳……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那正是",
    "voice": "vo_adv_7027004_061",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "冒險的樂趣對吧？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳說是不是？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔……",
    "voice": "vo_adv_7027004_062",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那個嘛……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是無法否認沒錯。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "對吧！",
    "voice": "vo_adv_7027004_063",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "跟發現或丟失寶物之類的",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "毫無關係！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n冒險本身",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "才是我現今的目的！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我現在",
    "voice": "vo_adv_7027004_064",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "非常的開心！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n因為能跟你們",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "一起冒險！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……唉。",
    "voice": "vo_adv_7027004_065",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你們兩位還真悠哉！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "太過悠哉了，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "讓懊悔不已的我看起來開始像個傻子了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……不過，",
    "voice": "vo_adv_7027004_066",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "也是吧？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "冷靜下來想想，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "剛才……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說不定",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我也很開心就是了。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是嗎，是嗎！",
    "voice": "vo_adv_7027004_067",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n那麼",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我也很開心喔！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……但是，",
    "voice": "vo_adv_7027004_068",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這種「最棒的寶物是冒險的回憶」",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "之類的結局就免了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我一定要獲得值錢的東西！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "好",
    "voice": "vo_adv_7027004_069",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "了，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "調整好心情，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我們走吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n去尋找比剛才的寶石",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "更為驚人的寶物！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是祈梨一行人為了探尋新的寶物，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n朝著更上面的樓層前進。",
    "voice": null,
    "unit_id": null
  }
]
