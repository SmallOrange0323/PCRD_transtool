[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "今天{0}也陪著空花練習跳舞了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生手上拿的是什麼東西啊？",
    "voice": "vo_adv_1045005_000",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n雖然有點像傳單……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……空花也想看，可以嗎？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這是……舞蹈大會的通知單嗎？",
    "voice": "vo_adv_1045005_001",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "欸欸！",
    "voice": "vo_adv_1045005_002",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n要空花參加這場大會嗎！？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不行的啦……",
    "voice": "vo_adv_1045005_003",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n空花對跳舞還沒有自信……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "而且很害羞。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊！",
    "voice": "vo_adv_1045005_004",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生打算看空花出醜的樣子，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "然後引以為樂吧？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "即使因為羞恥而痛苦的空花，",
    "voice": "vo_adv_1045005_005",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n也依然無法違抗虐待狂先生的命令……流口水。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這是欲擒故縱對吧……",
    "voice": "vo_adv_1045005_006",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生真是高手！？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻……",
    "voice": "vo_adv_1045005_007",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n被虐待狂先生這樣強迫的話，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n空花也就沒辦法再抵抗了……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "既然虐待狂先生都這樣說了……",
    "voice": "vo_adv_1045005_008",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花知道了。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花參加舞蹈大會！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……欸？正式上場之前，做更多練習？",
    "voice": "vo_adv_1045005_009",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻……要變得更加激烈對吧。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n流口水。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "好、好的、空花很期待……",
    "voice": "vo_adv_1045005_010",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "哦不是、空花會加油！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "background",
    "bg_id": "500032"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "舞蹈大會，當天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "已已已、",
    "voice": "vo_adv_1045005_011",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "已經是正式上場的時候了嗎！？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花還沒有什麼自信說……！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "那麼──麻煩下一位！",
    "voice": "vo_adv_1045005_012",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n空花小姐請上台。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "輪到空花了嗎！？",
    "voice": "vo_adv_1045005_013",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生……空花這次還是退出……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "呀啊！",
    "voice": "vo_adv_1045005_014",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n不、不要推空花！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n被這樣用力推的話！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "接下來是空花小姐上場！",
    "voice": "vo_adv_1045005_015",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n那麼請為我們跳舞吧！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "欸欸欸欸欸！",
    "voice": "vo_adv_1045005_016",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生硬把空花推上台……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n已經逃不了了……！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊、啊……",
    "voice": "vo_adv_1045005_017",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n在眾目睽睽之下做這種事！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n實在是太害羞了，空花整個人都變得不對勁！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "酒館的店員",
    "words": "空花──！",
    "voice": "vo_adv_1045005_018",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "酒館的店員",
    "words": "\\n加油──！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊，同事們也來為空花加油……",
    "voice": "vo_adv_1045005_019",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "像這樣……被這麼多熟人看著……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花要丟臉丟到家了！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊！該不會這些都是虐待狂先生的計畫……！？",
    "voice": "vo_adv_1045005_020",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "目的是為了羞辱空花對吧……嘻嘻。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "「妳喜歡一邊做一邊被別人注視吧」",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這樣？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻……虐待狂先生的特訓也超狂野的。",
    "voice": "vo_adv_1045005_021",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n即使做到腰都站不直了，也硬要繼續……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n就算達到極限了也一直做一直做……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "看著空花痛苦的表情，應該很享受吧。",
    "voice": "vo_adv_1045005_022",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n不愧是虐待狂先生！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻……嘻嘻嘻……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "酒館店員１",
    "words": "她、",
    "voice": "vo_adv_1045005_023",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "酒館店員１",
    "words": "她好像一邊跳舞，一邊念念有詞……？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "酒館店員１",
    "words": "\\n那個男的對空花做了什麼特訓？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "酒館店員２",
    "words": "但是，你看！",
    "voice": "vo_adv_1045005_024",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒館店員２",
    "words": "\\n空花跳得比平常更好呢！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "喔喔喔喔喔！！",
    "voice": "vo_adv_1045005_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "\\n這舞蹈跳得多麼熱情啊！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊啊！！",
    "voice": "vo_adv_1045005_026",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊啊啊！！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n一想起和虐待狂先生做的練習，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n身體自然而然就有反應了！！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嗚嗚……",
    "voice": "vo_adv_1045005_027",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n空花盡力了，不過只得到參加獎……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n難得虐待狂先生陪空花做了這麼多練習……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "欸？",
    "voice": "vo_adv_1045005_028",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "很很很、很美！？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "居然給空花這樣直白的讚賞……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生說空花很美……",
    "voice": "vo_adv_1045005_029",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n這……這，也就是說……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "喜、喜歡空花──",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊哇哇哇哇哇！",
    "voice": "vo_adv_1045005_030",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n太、太害羞了啦啦啦！！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一臉不可思議地，\\n直望著滿臉通紅逃跑的空花……",
    "voice": null,
    "unit_id": null
  }
]
