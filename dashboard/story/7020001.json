[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "半推半就之下答應要登塔的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正與珠希和真陽一起前進著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵喵喵！",
    "voice": "vo_adv_7020001_000",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "進到塔裡面，寶物的氣息就更加強烈了喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "究極的鯛魚燒就在眼前了喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "小希希，",
    "voice": "vo_adv_7020001_001",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我們才剛進來不久啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n妳要是那麼激動，會耗盡體力喔。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哎呀，",
    "voice": "vo_adv_7020001_002",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這麼說來，我還沒跟你說過嗎？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真是傻問題喵，{0}。",
    "voice": "vo_adv_7020001_003",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "什麼飲料適合配鯛魚燒？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "答案是牛奶喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "除此之外還需要什麼理由喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我這裡的牛奶",
    "voice": "vo_adv_7020001_004",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "會賣到小希希打工的地方，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "然後他們會用牛奶來",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "做卡士達鮮奶油。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "【伊麗莎白牧場】的牛奶，",
    "voice": "vo_adv_7020001_005",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "正是我尋找已久的珍品喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不用說做成奶油很好吃，",
    "voice": "vo_adv_7020001_006",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "搭配鯛魚燒一起喝，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n也是超級絕配喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "能夠拓展鯛魚燒的可能性的人，都是值得信賴的喵。",
    "voice": "vo_adv_7020001_007",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我常拜託她試吃新口味等等，感情就逐漸變好了喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "小希希他們那裡的鯛魚燒，",
    "voice": "vo_adv_7020001_008",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我們公會的大家也都超喜歡的喔，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真的",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "太感謝妳啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "能聽妳這麼說，對鯛魚燒店店員就是無上的幸福了喵。",
    "voice": "vo_adv_7020001_009",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我並不滿足於此喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖然卡士達鯛魚燒也很好，",
    "voice": "vo_adv_7020001_010",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但我想要做出配得上【伊麗莎白牧場】牛奶的",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n充滿原創性的鯛魚燒喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "畢竟公會雖然有出資，",
    "voice": "vo_adv_7020001_011",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但關於商品品質方面，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n責任全都在我身上喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "單純只買普通好吃的鯛魚燒的時代，已經結束了喵。",
    "voice": "vo_adv_7020001_012",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "所以我要爬上塔，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "取得製作究極鯛魚燒的食材喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "為了鯛魚燒，",
    "voice": "vo_adv_7020001_013",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我可是不擇手段的喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "小希希對鯛魚燒的熱情",
    "voice": "vo_adv_7020001_014",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真的超強的，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我也得多學學才行。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我光是",
    "voice": "vo_adv_7020001_015",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "看到這麼熱情的小希希喜歡我們賣的牛奶，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n就已經很高興了，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "所以我才會像這樣幫助她啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……真不愧是老哥，",
    "voice": "vo_adv_7020001_016",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你察覺到了嗎？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然我沒辦法大聲說出口，",
    "voice": "vo_adv_7020001_017",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但其實我",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "單純地對小希希這個人很感興趣。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那份貢獻於鯛魚燒的熱情",
    "voice": "vo_adv_7020001_018",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "與無拘無束的行動力，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "還有小希希本人",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "異想天開的個性。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這些每一樣都是在搞笑時也通用的、",
    "voice": "vo_adv_7020001_019",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "貨真價實的實力呀。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "只要深入了解那個人，",
    "voice": "vo_adv_7020001_020",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "搞不好能獲得新哏的靈感，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "說不定",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "還能拓展出新的搞笑之路也說不定，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我是這麼預想的啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真失禮喵！",
    "voice": "vo_adv_7020001_021",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我無論何時都是超認真的喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不要把我當搞笑的哏喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哎呀，",
    "voice": "vo_adv_7020001_022",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "被聽見啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "今後也請多指教囉，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "小希希。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "真陽看起來很開心地，拍了拍面露不滿的珠希的肩膀。",
    "voice": null,
    "unit_id": null
  }
]
