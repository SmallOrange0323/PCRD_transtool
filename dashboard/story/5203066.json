[
  {
    "type": "still",
    "still_id": "520306201"
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "波波爺爺的",
    "voice": "vo_adv_5203066_000",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "「克蘿茜大解密」",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "要開始啦～！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n把老夫解析的",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "古代兵器",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "巨型軀體的詳細資訊，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n用大家都能懂的方式",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "慢～慢仔細地講解給大家聽喔。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "still",
    "still_id": "520306601"
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "這次要講解的是，",
    "voice": "vo_adv_5203066_001",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "「巨型飛彈」。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n這是搭載在巨型克蘿茜胸部的",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "超強火力砲彈！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n為了能夠打倒所有敵人，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "老夫盡可能地",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "增加火藥量了！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我有問題",
    "voice": "vo_adv_5203066_002",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我有問題，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "想要問波波爺爺，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "為什麼要在胸部放飛彈呢？",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "嗯，",
    "voice": "vo_adv_5203066_003",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "那是因為……",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "克蘿茜、",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "碧。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n如果是妳們，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "看起來就有",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "銳利爪牙的魔物",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n和並非如此的魔物，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "妳們會更警戒哪邊？",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "正常來說，",
    "voice": "vo_adv_5203066_004",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "會是有銳利爪牙的魔物……",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "吧。",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就是所謂的陷阱題嗎？",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "嗯，",
    "voice": "vo_adv_5203066_005",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "就是這樣。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n露出武器的話",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "就會把注意力放在上面……",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n那麼反過來將其藏起的話，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "就可以讓對方大意，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "這也是一種戰略。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "俗話說",
    "voice": "vo_adv_5203066_006",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "有能力的老鷹會將爪子藏起來，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "這就是關鍵時刻的必殺技對吧！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "原來如此……",
    "voice": "vo_adv_5203066_007",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "優點我理解了，",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但是，",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n還是有個令我在意的地方。",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個，",
    "voice": "vo_adv_5203066_008",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我會乘坐的駕駛艙，",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "也在胸部附近對吧？",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要是不小心受到攻擊，",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不會引爆嗎？",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "……………………",
    "voice": "vo_adv_5203066_009",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個，",
    "voice": "vo_adv_5203066_010",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "波波爺爺？",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個沉默是什麼意思……",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "很好，",
    "voice": "vo_adv_5203066_011",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "稍微",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "加裝一下胸部裝甲吧。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n感謝妳",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "來自現場的寶貴意見！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "等等，",
    "voice": "vo_adv_5203066_012",
    "unit_id": 134612
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請回答我啊～～～！？",
    "voice": null,
    "unit_id": 134612
  },
  {
    "type": "still",
    "still_id": "end"
  }
]
