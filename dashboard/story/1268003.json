    "name": "優花梨",
    "words": "傳說的琥珀",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "神殿麥酒！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "對吧？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "村民2",
    "words": "真、",
    "voice": "vo_adv_1268003_057",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村民2",
    "words": "真驚人……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村民2",
    "words": "\\n我還以為只是個強悍的聖騎士大人……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村民3",
    "words": "只喝了一口",
    "voice": "vo_adv_1268003_058",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "村民3",
    "words": "就能了解到這種地步嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "村民3",
    "words": "\\n根本就比我們還要來得更清楚啊……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "呼……",
    "voice": "vo_adv_1268003_059",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "竟然會是如此熟知麥酒的大人……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n恕我失敬了……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "您或許是最適合見證這個村莊麥酒的末路的人呢。",
    "voice": "vo_adv_1268003_060",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "好了，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "看您要把我抓去哪裡吧……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "所以說！",
    "voice": "vo_adv_1268003_061",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我才不會抓你們！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "可是，",
    "voice": "vo_adv_1268003_062",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "妳剛剛",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "不是全力在戰鬥嗎？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那是因為你們先攻擊過來了啊。",
    "voice": "vo_adv_1268003_063",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我想說的只有一件事。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你們在這種地方偷偷摸摸地私釀，",
    "voice": "vo_adv_1268003_064",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n都不會對麥酒感到羞愧嗎？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "村民2",
    "words": "這是",
    "voice": "vo_adv_1268003_065",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村民2",
    "words": "什麼意思？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "應該要更加盛大地宣傳，",
    "voice": "vo_adv_1268003_066",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n讓它可以在那個超棒的海灘上喝到才對啊！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我們也不是喜歡才這樣偷偷摸摸的。",
    "voice": "vo_adv_1268003_067",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "但是，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "這種規模的",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "麥酒釀造場",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "如果沒有國家許可，\\n是會被問罪的吧？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "何況我聽說事後申請",
    "voice": "vo_adv_1268003_068",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "還會收取追徵金，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n但是這個村莊沒有可以繳納的錢……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "所以，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "為了守護村莊的傳統才會不得不……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "什麼嘛，",
    "voice": "vo_adv_1268003_069",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "原來是在意那種事啊？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那個沒問題啦。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n因為這邊",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是神殿嘛。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "在大概兩百年前的時候，",
    "voice": "vo_adv_1268003_070",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "做為神殿維持費的資金源，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n神殿取得了釀造麥酒的特別授權許可。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那條法律現在也還存在喔。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "那、",
    "voice": "vo_adv_1268003_071",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "那是真的嗎！？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "嗯。",
    "voice": "vo_adv_1268003_072",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這也有出現在今年的「國家認證準一級聖騎士資格測驗」題目裡。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "因為是完全合法的，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "所以也不會有追徵金。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "而且，",
    "voice": "vo_adv_1268003_073",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "如果是關於資金面的問題可以找我商量喔。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我還沒有給你",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我的名片對吧。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "【墨丘利財團】……？",
    "voice": "vo_adv_1268003_074",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n我記得",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "那是王都也相當有名的企業公會……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你們或許會很意外，",
    "voice": "vo_adv_1268003_075",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但其實我",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "很喜歡麥酒……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "所以關於麥酒",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我也稍微略懂一點點。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "村民2",
    "words": "不過",
    "voice": "vo_adv_1268003_076",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村民2",
    "words": "感覺一點也不意外，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村民2",
    "words": "看起來也不像是稍微略懂一點點……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "雖然你們好像對觀光和水產資源的方案不感興趣……",
    "voice": "vo_adv_1268003_077",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但如果是以這種麥酒為核心的振興村莊……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "能否讓我來幫忙呢？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "村民3",
    "words": "可是，",
    "voice": "vo_adv_1268003_078",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "村民3",
    "words": "不覺得事情聽起來太美好了嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "村民3",
    "words": "\\n是不是",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "村民3",
    "words": "背後有什麼陰謀……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "村長，",
    "voice": "vo_adv_1268003_079",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "那樣好嗎？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "當然",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "如果是真的，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "那的確是很美好啦……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "{0}……",
    "voice": "vo_adv_1268003_080",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "這兩個人的眼神都非常真誠……",
    "voice": "vo_adv_1268003_081",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我明白了，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我就相信你們看看吧。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我都已經下定決心，",
    "voice": "vo_adv_1268003_082",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n要讓這兩個人見證這個村莊麥酒的末路了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "就算被背叛了我也不後悔……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……！",
    "voice": "vo_adv_1268003_083",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "非",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "常感謝。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不是身為聖騎士，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "而是做為一個麥酒愛好者……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我會盡我所能的！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是圍繞在優花梨的「國家認證準一級聖騎士資格測驗」的騷動，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就這樣和平落幕了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在收到優花梨的報告後，【墨丘利財團】立刻送了援助到村莊來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n讓村莊轉眼間就充滿了活力。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在這樣的情況下，{0}與優花梨被找去海邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "攝影準備已經好了，",
    "voice": "vo_adv_1268003_084",
    "unit_id": 414
  },
  {
    "type": "dialogue",
