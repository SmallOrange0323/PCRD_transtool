[
  {
    "type": "background",
    "bg_id": "501570"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "融入在夜晚的黑暗中，{0}與優花梨監視著神殿。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n不久後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在兩人的眼前出現了一群人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "果然……",
    "voice": "vo_adv_1268003_000",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你看。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n有人過來了……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "呼……",
    "voice": "vo_adv_1268003_001",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "說起來還真是",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "令人頭疼啊。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n沒想到中央會派聖騎士過來……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "不過",
    "voice": "vo_adv_1268003_002",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "目前正在測驗中，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "所以正確來說不是聖騎士啦。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "但是",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "差點就要露餡，嚇死我了……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "那還不都是因為你多嘴。",
    "voice": "vo_adv_1268003_003",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "這個村莊的祕密可不能被傳出去。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n得想辦法隱瞞過去才行……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "就是說啊。",
    "voice": "vo_adv_1268003_004",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "\\n要是曝光了，那可就完了……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……你有聽到",
    "voice": "vo_adv_1268003_005",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "他們說的嗎？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "聽起來神殿裡面確實有藏著什麼東西呢。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不知道裡面會有什麼在等著呢。",
    "voice": "vo_adv_1268003_006",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n進去可能會有危險……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……你可以的話，",
    "voice": "vo_adv_1268003_007",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那我們就走吧。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就拜託你囉。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "background",
    "bg_id": "500342"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "優花梨與{0}就這樣尾隨村長他們進入神殿內部。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而神殿內部的通道連接著位於地下的可疑小房間。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……總覺得",
    "voice": "vo_adv_1268003_008",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "有點涼耶。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n難道是",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "地下的",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "儲藏庫嗎？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "穿泳裝來",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好像是個敗筆呢……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就、",
    "voice": "vo_adv_1268003_009",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就這麼辦好了……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "對啦！　",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "現在要以保持警戒為優先。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n畢竟不知道會發生什麼事，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "要維持方便活動的狀態才行。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "話說回來，",
    "voice": "vo_adv_1268003_010",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這個神殿的構造",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我好像在哪裡看過……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "停下來！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "他們就在這前面呢。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "所以",
    "voice": "vo_adv_1268003_011",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "這次的品質如何？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "哼嘿嘿，",
    "voice": "vo_adv_1268003_012",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "是這幾年來最棒的呢。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "\\n讚到會讓人升天喔。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "這樣啊，",
    "voice": "vo_adv_1268003_013",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "那還真令人期待呢。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "要是沒有那個聖騎士，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我們就能在白天進行了……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "他們好像在製造什麼東西……",
    "voice": "vo_adv_1268003_014",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這個味道……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n可是……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不會吧，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "該不會就是……？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "充斥在周遭、",
    "voice": "vo_adv_1268003_015",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這股融合了獨特芬芳與甜味的濃厚香氣。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "知道這個！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "可是好奇怪……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "在這種地方應該不可能會有才對……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但是，",
    "voice": "vo_adv_1268003_016",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這能讓人預期會有獨特暢快感的香醇風味……！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "肯定沒錯，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這就是",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "傳說中的……！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "什麼人！",
    "voice": "vo_adv_1268003_017",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好像被發現了呢。",
    "voice": "vo_adv_1268003_018",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我是「國家認證準一級聖騎士資格測驗」的考生，優花梨。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "為、",
    "voice": "vo_adv_1268003_019",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "為什麼你們會在這裡！？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "果然",
    "voice": "vo_adv_1268003_020",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "是來探查了啊。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "雖然希望你們能在一無所知的狀態下離開……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "但既然都被你們知道了，可不能就這樣放你們走。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "很抱歉我擅自尾隨你們。",
    "voice": "vo_adv_1268003_021",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n針對沒有聽從忠告這件事我也道歉。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我",
    "voice": "vo_adv_1268003_022",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是來調查這個村莊的問題的。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "為了自己的測驗。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "可是，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "現在不一樣了……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n既然看到了這裡，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "可就沒有辦法那樣說呢。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "哼，",
    "voice": "vo_adv_1268003_023",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "看你那麼年輕，不知道也沒辦法。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "這裡是……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是麥酒的私釀廠！",
    "voice": "vo_adv_1268003_024",
    "unit_id": 126811
