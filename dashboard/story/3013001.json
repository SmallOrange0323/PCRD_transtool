  },
  {
    "type": "dialogue",
    "name": "美美的母親",
    "words": "\\n可以去幫忙買晚飯的食材嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗯，知道了～。",
    "voice": "vo_adv_3013001_001",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "今天的晚飯吃什～麼？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美的母親",
    "words": "今天是燉菜喔！",
    "voice": "vo_adv_3013001_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美的母親",
    "words": "\\n這個是購物清單和地址。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美的母親",
    "words": "\\n今天有商隊來到蘭德索爾附近喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇啊～！",
    "voice": "vo_adv_3013001_003",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n那麼是要去蘭德索爾外面買東西嗎？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美還是第一次自己去蘭德索爾外面呢～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美的母親",
    "words": "那麼就拜託妳了。",
    "voice": "vo_adv_3013001_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美的母親",
    "words": "\\n要沿著街道走，絕對不要走偏了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美的母親",
    "words": "\\n路上小心喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗯，美美知道了～",
    "voice": "vo_adv_3013001_005",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美出門了～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "買東西～♪買東西～♪",
    "voice": "vo_adv_3013001_006",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "買晚飯的食材～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "今天的晚飯是燉菜～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "馬鈴薯先生、紅蘿蔔先生、磨菇先生～♪",
    "voice": "vo_adv_3013001_007",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n和肉先生一起慢慢地燉煮～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "噗滋噗滋咕嘟咕嘟，火鍋在唱歌喔～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "噗滋噗滋……",
    "voice": "vo_adv_3013001_008",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咕嘟咕嘟～——……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "background",
    "bg_id": "500200"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦咦",
    "voice": "vo_adv_3013001_009",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "～！這裡是哪裡～！？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "我、我不知道路了啦～！",
    "voice": "vo_adv_3013001_010",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "媽媽～！爸爸～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n嗚哇～～～嗯！！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那個……妳沒事吧？",
    "voice": "vo_adv_3013001_011",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗚？",
    "voice": "vo_adv_3013001_012",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "那、那個……妳是誰啊？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我叫鏡華，是精靈族。",
    "voice": "vo_adv_3013001_013",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我在遠處就聽到哭聲，所以擔心地過來看看。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "妳是迷路了嗎？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "是的……美美是從蘭德索爾到這裡來買東西，",
    "voice": "vo_adv_3013001_014",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n但卻不知道路要怎麼走了……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗚嗚～～～哇！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請、請別哭呀！妳、妳真奇怪耶。",
    "voice": "vo_adv_3013001_015",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "獸人族是充滿野性又強勢的種族，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n學校是這麼教的……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請問有前往目的地的地圖嗎？",
    "voice": "vo_adv_3013001_016",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個……還有請告訴我妳的名字。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗚嗚、嗚嗚……",
    "voice": "vo_adv_3013001_017",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "我是美美。",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這是要去目的地的便條紙喔……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請讓我看一下。",
    "voice": "vo_adv_3013001_018",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個……妳完全走錯方向了。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "再走回蘭德索爾一趟似乎會比較快。",
    "voice": "vo_adv_3013001_019",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "美美，我會看著地圖指引妳，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n所以請跟我來。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "鏡華也要陪我一起去嗎？",
    "voice": "vo_adv_3013001_020",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "謝謝～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n欸嘿嘿～最喜歡鏡華了！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啦嚕嚕，啦嚕嚕～♪",
    "voice": "vo_adv_3013001_021",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n兩人一起散步～♪散步～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "太陽公公，閃閃發亮～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……妳明明迷路了卻還很悠閒呢。",
    "voice": "vo_adv_3013001_022",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "因為雖然剛才美美都是自己一個人，",
    "voice": "vo_adv_3013001_023",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n但現在有鏡華陪著我一起走啊！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "所以覺得非常放心喔～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "（……真是個天真的孩子。",
    "voice": "vo_adv_3013001_024",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n雖然學過獸人族是更野性的種族……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但或許美美是比較特殊的獸人族？）",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "（哈！說不定美美也會",
    "voice": "vo_adv_3013001_025",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n變身成可怕的獸人！？）",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "唔唔唔－－－－！",
    "voice": "vo_adv_3013001_026",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗷嗷嗷嗷嗷－－－－－－！！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "（……嗯～～。感、感覺應該不太可能）",
    "voice": "vo_adv_3013001_027",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊！是叉路。",
    "voice": "vo_adv_3013001_028",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯～路標寫說……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這邊是蘭德索爾。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "然後……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "………",
    "voice": "vo_adv_3013001_029",
    "unit_id": 103611
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我、我們迷路了！！！",
    "voice": "vo_adv_3013001_030",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦！？",
    "voice": "vo_adv_3013001_031",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好、好奇怪！我應該沒有走錯路啊！",
    "voice": "vo_adv_3013001_032",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "妳看，路標也寫著這邊是蘭德索爾……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……嗯？",
    "voice": "vo_adv_3013001_033",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這個路標……不太對呢。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "照我的印象，蘭德索爾應該是右邊的道路……",
    "voice": "vo_adv_3013001_034",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "可是現在路標卻變成左邊是蘭德索爾。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n路標是錯的……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "應該說，是有人對調了兩邊的路標。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "是、是嗎？",
    "voice": "vo_adv_3013001_035",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "對調……是誰做出這種事～？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……啊！",
    "voice": "vo_adv_3013001_036",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "說、說不定是！？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "其、其實最近在我們精靈族之間",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n一直不斷地發生類似的事件。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "像是森林裡成熟的水果被採光光，",
    "voice": "vo_adv_3013001_037",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n草原上的草被綁在一起，變成會絆倒人的陷阱，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "或是有害人掉進洞的陷阱……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "啊！美美這裡的獸人族之間",
    "voice": "vo_adv_3013001_038",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "也聽說有發生怪異的事喔～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "像是羊種的人在睡覺時毛被剃掉，",
    "voice": "vo_adv_3013001_039",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n牛種的人，鼻子上被穿了環，",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "或是有害人掉進洞的陷阱……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……這次的路標被對調，肯定也是同一個犯人搞的鬼。",
    "voice": "vo_adv_3013001_040",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "到底是誰做的呢？",
    "voice": "vo_adv_3013001_041",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "會攻擊精靈族與獸人族的話……",
    "voice": "vo_adv_3013001_042",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "恐怕是魔族！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "說不定是曾在繪本上讀過的",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n『傳說的大魔王』搞的鬼！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "傳、『傳說的大魔王』～！？",
    "voice": "vo_adv_3013001_043",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "怎、怎麼辦，鏡華！？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……由我們來擊退他吧！",
    "voice": "vo_adv_3013001_044",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦！？",
    "voice": "vo_adv_3013001_045",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "再繼續這樣下去的話，我們兩個都回不去蘭德索爾。",
    "voice": "vo_adv_3013001_046",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "只能由我們來打倒『大魔王』了！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "怎、怎麼這樣～！美、美美才不要～！",
    "voice": "vo_adv_3013001_047",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "好、好可怕～～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗚嗚～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "明明我學到的獸人族，應該是更勇敢的種族……",
    "voice": "vo_adv_3013001_048",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美也聽說，精靈族應該是更溫柔的才對～",
    "voice": "vo_adv_3013001_049",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我、",
    "voice": "vo_adv_3013001_050",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我認為自己是很溫柔的！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不過或許是教科書上寫的和現實落差太大，",
    "voice": "vo_adv_3013001_051",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "總覺得很震驚。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "呀！",
    "voice": "vo_adv_3013001_052",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "那、那邊的樹蔭下，好像有人～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "『大魔王』你來了吧！",
    "voice": "vo_adv_3013001_053",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我來擊退他！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美・鏡華",
    "words": "………",
    "voice": "vo_adv_3013001_054",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "301300101"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哇－－－－－",
    "voice": "vo_adv_3013001_055",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "美美・鏡華",
    "words": "呀－－－－！",
    "voice": "vo_adv_3013001_056",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美・鏡華",
    "words": "？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "救，救救我－－－－！",
    "voice": "vo_adv_3013001_057",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n放我下來－－－－！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "妳、妳是誰啊！？",
    "voice": "vo_adv_3013001_058",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n怎麼會倒吊在半空中啊！？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……啊，腳踝被繩子綁住，垂掛在樹上。",
    "voice": "vo_adv_3013001_059",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "妳是踩到繩子的陷阱了吧。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我馬上放妳下來，請稍等！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "謝謝－！幫了大忙－！",
    "voice": "vo_adv_3013001_060",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n我叫禊！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "兩位是……精靈族與獸人族？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗯！我叫美美喔～！",
    "voice": "vo_adv_3013001_061",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "她是鏡華！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "禊是人族吧？",
    "voice": "vo_adv_3013001_062",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "妳也遭到了『大魔王』的襲擊嗎？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "大……魔王？",
    "voice": "vo_adv_3013001_063",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦？怎麼回事？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "最近精靈族與獸人族，",
    "voice": "vo_adv_3013001_064",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n都遭到魔族之王的攻擊。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我們也因為『大魔王』的關係而迷路了……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "是這樣嗎！？",
    "voice": "vo_adv_3013001_065",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不可原諒─！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n該死的『大魔王』～，就由禊來幹掉他！！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真可靠！我們也一起戰鬥！",
    "voice": "vo_adv_3013001_066",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "三人一起打倒『大魔王』吧！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗚？一起戰鬥……",
    "voice": "vo_adv_3013001_067",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美、美美也一起嗎？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美只要能買好東西就夠了……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哇－！好帥－－！！",
    "voice": "vo_adv_3013001_068",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n有如大人們組成的公會！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是啊！我們三人來組成公會吧！",
    "voice": "vo_adv_3013001_069",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n總覺得興奮起來了！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好－呀！",
    "voice": "vo_adv_3013001_070",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "從今天開始，我們就是禊防衛隊了－！！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "美美・鏡華",
    "words": "……咦？",
    "voice": "vo_adv_3013001_071",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "禊，我不同意取這個名字。",
    "voice": "vo_adv_3013001_072",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "因為公會成員有三個人，用個人的名字取名覺得不太對，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "如果真要這麼取名的話，至少必須用隊長的名字。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "所－以－說！禊就是公會長－！！",
    "voice": "vo_adv_3013001_073",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n這個就要由最強的人來當領導者！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "最強的？",
    "voice": "vo_adv_3013001_074",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我覺得身為劍士的美美看起來好像比較強……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嘖嘖嘖－",
    "voice": "vo_adv_3013001_075",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊的強，從外表是看不出來的。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "誰叫禊是使用非正面攻擊的攻法！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "非正面攻擊的攻法？",
    "voice": "vo_adv_3013001_076",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n到底是用什麼方式攻擊的？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "就是偷偷地設陷阱啦，趁別人睡著時惡作劇啦，",
    "voice": "vo_adv_3013001_077",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊！還有挖陷阱之類的！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "美美・鏡華",
    "words": "……咦？",
    "voice": "vo_adv_3013001_078",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "妳看，剛剛禊不是吊在半空中嗎？",
    "voice": "vo_adv_3013001_079",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那個其實是禊自己做的陷阱，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n因為搞錯才不小心踩進去了－",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……也對調了街道的路標嗎？",
    "voice": "vo_adv_3013001_080",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯！",
    "voice": "vo_adv_3013001_081",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "一切都是禊的惡作劇啊！",
    "voice": "vo_adv_3013001_082",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n『大魔王』的真實身分就是禊！！！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦？咦？怎麼回事？",
    "voice": "vo_adv_3013001_083",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，難道兩位是因為那些事而生氣了嗎？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "沒錯！",
    "voice": "vo_adv_3013001_084",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n不只是很生氣而已，還非常的困擾！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "為什麼要做這種事！？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "因為很好玩！",
    "voice": "vo_adv_3013001_085",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "很、很好……玩……？",
    "voice": "vo_adv_3013001_086",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n只、只是因為這樣！？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "說起人族，",
    "voice": "vo_adv_3013001_087",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我學到的是非常會算計的種族……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "沒想到居然是這麼隨便的種族！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "決定了",
    "voice": "vo_adv_3013001_088",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "從此以後，我要邊冒險邊學習，",
    "voice": "vo_adv_3013001_089",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n在學校或課本上面學不到的東西！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "在只有我與美美兩人的小小公會！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我們是公會",
    "voice": "vo_adv_3013001_090",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "【小小甜心】！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "咦？美，美美也要加入嗎？",
    "voice": "vo_adv_3013001_091",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "那個……美美只要能買好東西就……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好像很好玩－！也讓禊加入－！",
    "voice": "vo_adv_3013001_092",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不行！禊大魔王，給我覺悟吧！",
    "voice": "vo_adv_3013001_093",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "藍色宇宙……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "比、比起那個我們還是回蘭德索爾吧～！",
    "voice": "vo_adv_3013001_094",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美得去買東西才行～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "也、也是…",
    "voice": "vo_adv_3013001_095",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "禊！快告訴我們回去的路！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦？",
    "voice": "vo_adv_3013001_096",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這個很簡單呦。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n只要朝這個標誌指的道路走……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這個是禊對調過的路標吧！",
    "voice": "vo_adv_3013001_097",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "也是。那麼只要朝反方向走……然後在下一個叉路……",
    "voice": "vo_adv_3013001_098",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦？這個被改寫過嗎？還是原本的標誌呢？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "欸嘿嘿，禊忘記了～！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "妳想不起來嗎？",
    "voice": "vo_adv_3013001_099",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "到底要怎麼才能回去啊！？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美要買東西～！",
    "voice": "vo_adv_3013001_100",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美肚子餓了～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美好想回家～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n媽～～媽！爸～～爸！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗚哇～～！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "三位少女們組成了一個小小的公會。\\n她們接下的第一個任務是幫美美家買晚餐，\\n這個任務雖然渺小卻是無比的困難……",
