    "unit_id": 126012
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這裡就是老婆婆的田地是吧。",
    "voice": "vo_adv_1260003_033",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n我們先躲在岩石後面",
