    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥漸漸地被壓制了……",
    "voice": "vo_adv_1260003_045",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n這樣下去的話……！　",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……由我來",
    "voice": "vo_adv_1260003_046",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n幫助哥哥",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……！！",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
