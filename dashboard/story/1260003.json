    "unit_id": 126011
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呼……",
