    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n傷害我最重要的哥哥，",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n那麼我即使變成壞孩子，",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "也要阻止你搗亂……！",
