    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "謝謝你的幫助。",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……",
    "voice": "vo_adv_1260003_053",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這下就能放心了。",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n老婆婆一定也會很開心──",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "噫……",
    "voice": "vo_adv_1260003_054",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "噫噫噫！！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "老婆婆！？",
    "voice": "vo_adv_1260003_055",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n妳怎麼會在這裡……",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "我……",
    "voice": "vo_adv_1260003_056",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "我因為擔心所以才跑來阻止你們……！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n想要跟你們說我會準備好酬勞，去委託公會管理協會處理。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "不，",
