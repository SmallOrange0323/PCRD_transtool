  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "太好了七七香，",
    "voice": "vo_adv_5008203_001",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是我們的勝利呀！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "稍等一下，妳們兩個。",
    "voice": "vo_adv_5008203_002",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n看那個！",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦―！？　那是什麼！？",
    "voice": "vo_adv_5008203_003",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這是還要再繼續下去的意思嗎！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻……",
    "voice": "vo_adv_5008203_004",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這正合我意呀。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n正好想說毀得還不夠多呢。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "若真是如此，",
    "voice": "vo_adv_5008203_005",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那就陪他玩到最後一刻吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "大家要上囉！",
