  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "呼……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "好一個龐然大物……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "半吊子的手段可沒辦法打倒牠呢……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "保險起見，要確保退路才行──",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是稀奇。",
    "voice": "vo_adv_5122302_001",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "像秋乃這樣的人，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "居然會說起喪氣話。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "妳、",
    "voice": "vo_adv_5122302_002",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "妳在說什麼啊？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "本小姐我",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "才沒有說喪氣話……！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那可真是失禮了。",
    "voice": "vo_adv_5122302_003",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不愧是大有來歷的紫藤家千金，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "相信只要有妳出馬，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "區區島鯨",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就跟水蚤一樣，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "沒錯吧？",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "沒、",
    "voice": "vo_adv_5122302_004",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這是當然的，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就如同妳說的那樣♪",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不需要退路！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "各位，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "請跟上本小姐！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……",
    "voice": "vo_adv_5122302_005",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "似似花……",
    "voice": "vo_adv_5122302_006",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "對於秋乃的掌控度還真是厲害啊……！",
    "voice": null,
    "unit_id": 126811
  }
]
