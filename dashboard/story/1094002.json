  {
    "type": "dialogue",
    "name": "旁白",
    "words": "安為了【咲戀育幼院】的小朋友們，開設了魔法教室。\\n由於風評非常好，所以今天安又受委託當老師了。\\n另一方面，古蕾婭則是在遠處眺望這副景象……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "呵呵……",
