    "type": "dialogue",
    "name": "安",
    "words": "OK！　",
    "voice": "vo_adv_1094002_004",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "……",
    "voice": null,
    "unit_id": 109211
  },
