    "name": "安",
    "words": "要施展什麼樣的魔法呢～",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n來變出碰到也不會覺得燙的火球，",
