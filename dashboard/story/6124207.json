[
  {
    "type": "background",
    "bg_id": "501950"
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "にゃっふっふ、",
    "voice": "vo_adv_6114207_000",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "お店も千客万来でいい調子にゃ♪",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n猫従業員たちも楽しく働いてるにゃ～！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "がんばってるモニカにお礼をしたいけど……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "何がいいかにゃ？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "猫パンチのごとくストレートにゃ！",
    "voice": "vo_adv_6114207_001",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "……カフェのお仕事は楽しいし、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "モニカと力を合わせて、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nこれからもがんばるにゃ。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "もちろん、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "キミも一緒に、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "だにゃ♪",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "ナイスアイデアなのにゃ！　",
    "voice": "vo_adv_6114207_002",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "猫のおなかを吸えば",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n健康にいい気がするだけじゃなく、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "さまざまな問題が解決はしないけど",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n全部どうでもよくなるのにゃ！　",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "思うさま堪能させてあげるにゃ～",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "うにゃぁ！？　",
    "voice": "vo_adv_6114207_003",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "あたし一人でお店を回すってことかにゃ！？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "うう、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "でも、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "モニカがへとへとになってお店がお休みになっちゃったら",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n本末転倒なのにゃ……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "上等にゃ！　",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "その話、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "乗ってやるにゃー！",
    "voice": null,
    "unit_id": 125111
  }
]
