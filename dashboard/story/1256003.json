    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "你的夥伴都被擊倒了喔。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "好啦，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "你還要繼續跟我打嗎？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "老鼠1",
    "words": "啾、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老鼠1",
    "words": "啾啾──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "嗯，",
    "voice": "vo_adv_1256003_062",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "很好的判斷呢！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "不要再做壞事了喔！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "……呼，",
    "voice": "vo_adv_1256003_063",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "總算是",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "把工作做完了呢！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "哎呀──",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "我真是的，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "居然大意輕敵，讓你見笑了呀！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "不是什麼事情都能順心如意呢。",
    "voice": "vo_adv_1256003_064",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "一想到要是沒有你幫忙的話，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "就讓我不寒而慄啊。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "反省反省！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "但是很遺憾的是",
    "voice": "vo_adv_1256003_065",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "我能回報你的頂多只有握手而已……",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "咦，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "那樣就很夠了？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "你真的善良到神明保佑呢。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "果然人生就是該有",
    "voice": "vo_adv_1256003_066",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "你這樣的好朋友呢！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "到這城鎮來之後，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "我再次意識到",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "人之間的緣分有多偉大了啊！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "接下來",
    "voice": "vo_adv_1256003_067",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "也請你多多指教了喔！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "哈哈！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "喂～",
    "voice": "vo_adv_1256003_068",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我聽到了很大的聲響，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "你們還好嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "店長，",
    "voice": "vo_adv_1256003_069",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "你來的剛剛好啊！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "老鼠已經離開這城鎮了喔！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "這樣",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "你就能放心開店了！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這、",
    "voice": "vo_adv_1256003_070",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這是怎麼一回事……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "你們兩個",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "到底做了什麼啊？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n就算老鼠不見了，店被弄得這麼悽慘，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是要怎麼開店做生意啊！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "夠了，",
    "voice": "vo_adv_1256003_071",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "你們兩個都被開除啦──！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "哈哈！",
    "voice": "vo_adv_1256003_072",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "這下讓人傷腦筋了呢！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一波未平一波又起。要抵達陽托邦的道路還很漫長。",
    "voice": null,
    "unit_id": null
  }
