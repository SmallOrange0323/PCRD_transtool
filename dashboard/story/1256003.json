  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "今天，碧卡拉也跟{0}一起，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n向著她打工的餐飲店走去。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "唉、",
    "voice": "vo_adv_1256003_000",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "真鬱卒……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "今天也會很忙吧……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n明明還沒開始工作，人家已經想回去了……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "雖然因為人家有戴著老鼠耳朵所以沒有犯錯，",
    "voice": "vo_adv_1256003_001",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n但是化為不停洗盤子的機器好痛苦啊……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "咦，",
    "voice": "vo_adv_1256003_002",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "是、",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "是……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "那樣嗎？",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "嘿嘿……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "啊，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "應該說……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "不好意思……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "人家的心聲洩漏出來了……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "在之前的",
    "voice": "vo_adv_1256003_003",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "小偷事件之後，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n人家",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "確實感覺自己有點改變……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "有、",
    "voice": "vo_adv_1256003_004",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "有獲得成果的話，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "果然會讓想法改變，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "嗎……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "只要一步一步來，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "或許有一天就算沒有老鼠耳朵，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n人家也能成為獨當一面的",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "陽光角色吧……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "嗯，",
    "voice": "vo_adv_1256003_005",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "人家稍微有點幹勁了……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n好、",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "好……！　",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "哈哈！",
    "voice": "vo_adv_1256003_006",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "好啦，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "今天也努力洗盤子吧！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "……嗯，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "是真的耶。",
    "voice": "vo_adv_1256003_007",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "店門口有貼公告……",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "喔，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "臨時休業啊？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "傷腦筋了呢，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "這樣不就沒辦法打工了嗎！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "到昨天為止都很正常的在營業，",
    "voice": "vo_adv_1256003_008",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "這或許是發生什麼事情了呢。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "如果是職場的危機，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "我就必須貢獻一臂之力了呢！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "嗨，店長！",
    "voice": "vo_adv_1256003_009",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "到底發生什麼事啦？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "喔哇！",
    "voice": "vo_adv_1256003_010",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n……嚇我一跳，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是你們啊。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n我應該有貼了今天休業的公告在門上……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "我們當然有看到！",
    "voice": "vo_adv_1256003_011",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "但是，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "突然休業讓我們很在意啊。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "你不介意的話，可以把原因說給我們聽喔！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "……這件事應該告知職員呢。",
    "voice": "vo_adv_1256003_012",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "其實最近，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n有狡猾的老鼠們",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "在蘭德索爾中的飲食店裡四處作亂啊。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "喔，",
    "voice": "vo_adv_1256003_013",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "老鼠！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是啊，",
    "voice": "vo_adv_1256003_014",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是棘手到業者也拿牠們沒轍的對手。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "然後昨天晚上，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "牠們終於出現在我的店裡了。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我明明有做好對策，卻被輕易突圍了，",
    "voice": "vo_adv_1256003_015",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "食材被吃得亂七八糟的……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "牠們還在我的店裡，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這種情況下",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "沒辦法開店啊……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "原來如此，我知道了！",
    "voice": "vo_adv_1256003_016",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "既然如此，就交給我吧！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "因為",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "我是老鼠的專家啊！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "咦，",
    "voice": "vo_adv_1256003_017",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "妳嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是真的嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "我對這副老鼠耳朵發誓！",
    "voice": "vo_adv_1256003_018",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "沒工作我們也會很困擾啊。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是嗎？",
    "voice": "vo_adv_1256003_019",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不過，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "老實說我束手無策了，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n既然妳都這麼說了，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "就拜託你們了。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "好～！",
    "voice": "vo_adv_1256003_020",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "為了我們的明天，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "加油吧！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "──",
    "voice": "vo_adv_1256003_021",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "好啦。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "哼～",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "確實有老鼠呢。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "嗨，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "老鼠們！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "各位可以出來一下嗎？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "老鼠1",
    "words": "啾──啾──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "哈哈！",
    "voice": "vo_adv_1256003_022",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "突然就嶄露敵意了呢！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "雖然我知道你們是有自己的苦衷的，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "但是我們也有啊。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "不好意思，",
    "voice": "vo_adv_1256003_023",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "可以請你們立刻離開這家店嗎？",
    "voice": null,
    "unit_id": 125611
  },
