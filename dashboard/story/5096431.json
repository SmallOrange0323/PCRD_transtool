[
  {
    "type": "background",
    "bg_id": "501613"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣、",
    "voice": "vo_adv_5096431_000",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日和，",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "回去的船馬上就要開了，",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n妳們回程的行李都準備好了嗎？",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呃，",
    "voice": "vo_adv_5096431_001",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我已經準備好了。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可是……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……日和？",
    "voice": "vo_adv_5096431_002",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我完全還沒玩夠呀──！",
    "voice": "vo_adv_5096431_003",
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n明明就還有很多想做的事情",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "和想吃的東西──！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n時間根本不夠啦──！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊哈哈……",
    "voice": "vo_adv_5096431_004",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "日和",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "從剛剛就一直是這樣。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日和，",
    "voice": "vo_adv_5096431_005",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不可以任性。",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……呵呵，",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n雖然我也覺得快樂的時光",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "過得特別快。",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對吧對吧！？",
    "voice": "vo_adv_5096431_006",
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "既然這樣，",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們也只能出發了對吧！？",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "讓我們一起在夏天的大海盡情地玩耍，",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "直到最後一刻吧──！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n就這麼決定了！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "很好，",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "Let's Go──！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不行，",
    "voice": "vo_adv_5096431_007",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們必須得留下充裕的時間來行動才行，",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不然之後可是會陷入慌慌張張的窘境喔？",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……沒在聽嗎？",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真傷腦筋呢，",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣……",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣？",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳為什麼在把泳圈充氣呢？",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦！？",
    "voice": "vo_adv_5096431_008",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "因為日和",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "已經出發了……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我也是",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不得已的嘛……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嘿嘿……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣，",
    "voice": "vo_adv_5096431_009",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "居然連妳也這樣……",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "算、",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "算了，",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "反正我也不是",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒有遺憾。",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怜……",
    "voice": "vo_adv_5096431_010",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "果然是這樣呢。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "也一起來吧？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "直到最後一刻，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n都和我們一起……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "享受大海吧！",
    "voice": null,
    "unit_id": 122611
  }
]
