[
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「我」……",
    "voice": "vo_adv_5085308_000",
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n缺少了……",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n力量……！",
    "voice": null,
    "unit_id": 15811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "才不是那樣的！",
    "voice": "vo_adv_5085308_001",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不要自己胡思亂想！",
    "voice": "vo_adv_5085308_002",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你是我們的力量──",
    "voice": "vo_adv_5085308_003",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "──我們是你的力量！",
    "voice": "vo_adv_5085308_004",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "力量不斷在提升。",
    "voice": "vo_adv_5085308_005",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n「那名少年」也是，",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "然後，",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這一側也是。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n……勝負分曉",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "已經近在眼前了。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一定要超越！",
    "voice": "vo_adv_5085308_006",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "以全員的羈絆！",
    "voice": "vo_adv_5085308_007",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "{0}",
    "words": "這就是，",
    "voice": "vo_adv_5085308_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "{0}",
    "words": "這個連結就是，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "{0}",
    "words": "「我的力量」！",
    "voice": null,
    "unit_id": null
  }
]
