    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這樣啊……",
    "voice": "vo_adv_5206007_053",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我從沒好好跟人說過……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "background",
    "bg_id": "501620"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "連對最後一次重置時見到的美空也沒有……",
    "voice": "vo_adv_5206007_054",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "因為我，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "長久以來都是一個人……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
