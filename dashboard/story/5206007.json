    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲、厄莉絲的闇影",
    "words": "唔……",
    "voice": "vo_adv_5206007_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "厄莉絲、厄莉絲的闇影",
    "words": "咦……？",
    "voice": "vo_adv_5206007_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……光之精靈啊──",
    "voice": "vo_adv_5206007_030",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "唔",
    "voice": "vo_adv_5206007_031",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "……！？",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……不，",
    "voice": "vo_adv_5206007_032",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "還是別這麼做吧。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "一切都結束了。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
