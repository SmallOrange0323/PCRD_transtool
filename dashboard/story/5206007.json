    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這裡是……？　",
    "voice": "vo_adv_5206007_026",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "對喔，",
    "voice": "vo_adv_5206007_027",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我已經死了啊……",
