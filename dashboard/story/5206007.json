    "voice": "vo_adv_5206007_057",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n想聽。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "小樂",
    "words": "我也想聽噗♪",
    "voice": "vo_adv_5206007_058",
    "unit_id": 9512
  },
  {
    "type": "background",
    "bg_id": "500510"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "以我而言，",
    "voice": "vo_adv_5206007_059",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "真是難堪呢……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不哭不哭……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "什、",
    "voice": "vo_adv_5206007_060",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "什麼……",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "雖然已經怎麼樣都無法改變了。",
    "voice": "vo_adv_5206007_061",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但我現在，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "至少能聽妳說。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "雖然一切都結束了，",
    "voice": "vo_adv_5206007_062",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n無法改變任何事……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但若妳願意，",
    "voice": "vo_adv_5206007_063",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我希望妳跟我說。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我應該能夠好好理解妳吧……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "……",
    "voice": "vo_adv_5206007_064",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "………",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "──欲望，",
    "voice": "vo_adv_5206007_065",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "是心為了填補欠缺之物的作用。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "我別無他法，只能一直伸出手……",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "雖然，",
    "voice": "vo_adv_5206007_066",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "結果我什麼都抓不住……",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n連誕生的意義，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "也不明白……",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "縱使如此，",
    "voice": "vo_adv_5206007_067",
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "我也想要作夢。",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "\\n想著若是騎士先生，",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "或許會幫助我",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "吧……",
    "voice": null,
    "unit_id": 129021
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是、",
    "voice": "vo_adv_5206007_068",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "啊……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "background",
    "bg_id": "500510"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但",
    "voice": "vo_adv_5206007_069",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "正因為那個夢沒能實現，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我才注意到某件事……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "本來打算跟著記錄一起，",
    "voice": "vo_adv_5206007_070",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "把我的心情傳達給妳。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n但看來沒有徹底傳達過去。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "所以這次，",
    "voice": "vo_adv_5206007_071",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "能換妳聽我說嗎？",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我已經跟普蕾西亞她們說過一次，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我想肯定有稍微整理好該怎麼說了……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "……？",
    "voice": "vo_adv_5206007_072",
    "unit_id": 129021
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "失去米奈娃的權能……",
    "voice": "vo_adv_5206007_073",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n在夢想破滅後，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我還是勉強撐了下來。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n能存在的時間雖然有限，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生也願意陪在我身邊。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "background",
    "bg_id": "502570"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "只不過，",
    "voice": "vo_adv_5206007_074",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "讓我困惑的事也很多。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n因為那個我不再是管理者的世界，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "既寬闊又自由……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "如果，",
    "voice": "vo_adv_5206007_075",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "能封閉在只屬於兩人的永恆世界，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n或許我就能",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "對自己造成的犧牲置身事外……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但是，",
    "voice": "vo_adv_5206007_076",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我所傷害過的人們，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就存在於那寬闊的世界裡……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n並想要重新來過……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……我並非想被原諒。",
    "voice": "vo_adv_5206007_077",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n只不過，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "對於自己犯下的罪，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我無法置身事外……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但是，",
    "voice": "vo_adv_5206007_078",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "那些被我傷害過的人……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n最後，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "告訴我他們願意聽我說。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "那時，我心想。",
    "voice": "vo_adv_5206007_079",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n作為交換，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我能不能給予他們一些什麼呢。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的闇影",
    "words": "…………",
    "voice": "vo_adv_5206007_080",
    "unit_id": 129021
  },
  {
    "type": "background",
    "bg_id": "500510"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "也就是說，",
    "voice": "vo_adv_5206007_081",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我想說的是……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "即使，",
    "voice": "vo_adv_5206007_082",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是只能存在於這個世界中的生命。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
