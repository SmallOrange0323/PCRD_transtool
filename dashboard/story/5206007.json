  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "所以……",
    "voice": "vo_adv_5206007_056",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "要是厄莉絲小姐願意，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "能不能和我們說呢？",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "或許",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "什麼都不會改變，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但起碼",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我們能聽妳說。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
