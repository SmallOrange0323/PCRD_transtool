    "name": "厄莉絲",
    "words": "……！？",
    "voice": "vo_adv_5206007_016",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "勾不到手……！？",
    "voice": "vo_adv_5206007_017",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n為什麼……！？　",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
