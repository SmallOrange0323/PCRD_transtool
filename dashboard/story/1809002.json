    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是被收買了吧。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們被擺了一道。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小咲戀，太好了，",
    "voice": "vo_adv_1809002_067",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我正在找妳。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n還有少年你和……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這位是",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "秋乃小姐吧？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳在找我，",
    "voice": "vo_adv_1809002_068",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是指",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有什麼事嗎？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒錯，",
    "voice": "vo_adv_1809002_069",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n有事想知會妳一聲。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還記得在妳仍是副團長的時候，",
    "voice": "vo_adv_1809002_070",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n團裡有個連劍都揮不太起來的貴族嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯……",
    "voice": "vo_adv_1809002_071",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不記得了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n為了鍍金加入【王宮騎士團】",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "作威作福的傢伙",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也不只一個兩個。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是說那樣的傢伙",
    "voice": "vo_adv_1809002_072",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "一個個都被我抓住濫用職權的把柄了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沒記錯的話，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "應該都被派到邊荒地區去了吧？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在那之中，",
    "voice": "vo_adv_1809002_073",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有個人似乎又回到了蘭德索爾。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n並且……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是以公共事業企劃參加者的身分回來，",
    "voice": "vo_adv_1809002_074",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就是小咲戀你所參加的",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那個企劃。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀、秋乃",
    "words": "什麼……？",
    "voice": "vo_adv_1809002_075",
    "unit_id": null
  }
]
