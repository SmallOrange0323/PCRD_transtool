    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "經過這次的調查，",
    "voice": "vo_adv_1809002_047",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "銷路看來能獲得擴展，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n上了軌道之後，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "交易量應該也會逐步增加。",
