    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n製作出正式的企劃書。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了提交文件，他們來到了王宮。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然而──",
