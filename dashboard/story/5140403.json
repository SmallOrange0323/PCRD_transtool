    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\nこれで狩ったなんちゃってアストライア茸は10体ね。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "なかなかいいペースじゃない！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "よし、",
    "voice": "vo_adv_5094403_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "この辺りで一息つこうか。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n自然の中では不測の自体が起こりやすい。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n体力には常に余裕を持っておかないとね。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "アオイ",
    "words": "そ、",
    "voice": "vo_adv_5094403_002",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "アオイ",
    "words": "それなら……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "アオイ",
    "words": "私、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "アオイ",
    "words": "コーヒーを淹れますね。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "アオイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "アオイ",
    "words": "みなさんが元気になるように、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "アオイ",
    "words": "腕によりをかけてっ。",
    "voice": null,
    "unit_id": 104011
  }
]
