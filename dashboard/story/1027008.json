    "name": "惠理子",
    "words": "請用。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "請您喝下這藥吧。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……為、",
    "voice": "vo_adv_1027008_003",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "為什麼您不喝呢？\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我特地為了{0}大人您――",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哎呀……",
    "voice": "vo_adv_1027008_004",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這道光是？\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "之前好像也",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "發生過類似的事……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "好、",
    "voice": "vo_adv_1027008_005",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "好剌眼……\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "呀啊啊啊！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "background",
    "bg_id": "510080"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻……\\n",
    "voice": "vo_adv_1027008_006",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "快要完成了……",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哎呀，",
    "voice": "vo_adv_1027008_007",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是{0}大人您呀。\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "打擾了……\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我稍微借用了一下您的廚房。",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您問我是怎樣進入屋子裡……",
    "voice": "vo_adv_1027008_008",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "的嗎？\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻……",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "請不用在意。",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "只要兩人彼此相愛，",
    "voice": "vo_adv_1027008_009",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就可以跨越任何障礙。\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "沒錯……",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "即使是玄關的鑰匙，\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "也無法分開我們兩人的。",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "實在非常抱歉，\\n",
    "voice": "vo_adv_1027008_010",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我還差一點點就能完成準備工作。\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "在此之前請您耐心等待……",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "來吧，",
    "voice": "vo_adv_1027008_011",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "請您聞一下這個味道……\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是不是漸漸變得想睡了？",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "still",
    "still_id": "102700801"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻……",
    "voice": "vo_adv_1027008_012",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您醒來了嗎？",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "假如您跑掉的話我會很困擾的，\\n",
    "voice": "vo_adv_1027008_013",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "因此我把您稍微綁起來了……\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "很擅長綑綁的。",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "剛好菜已經做好了。\\n",
    "voice": "vo_adv_1027008_014",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "地中海風味意大利燉飯……",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這是自信之作唷。",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "別看我這樣，",
    "voice": "vo_adv_1027008_015",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "其實我很擅長做飯呢。\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "因為料理跟調製藥品差不多……",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻……",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哎呀，",
    "voice": "vo_adv_1027008_016",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "也是有這種手段呢……\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "在好像很好吃的菜餚內，",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "悄悄加入媚藥……",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "請您放心。\\n",
    "voice": "vo_adv_1027008_017",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這道料理之中",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "並沒有放入奇怪的東西。\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "為了{0}大人，我可是做得非常美味呢。",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "如果您覺得無法相信的話，",
    "voice": "vo_adv_1027008_018",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我就來試毒一下……",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "啊嗯。",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嗯～",
    "voice": "vo_adv_1027008_019",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "好吃……\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "連我自己",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "都覺得好吃。",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "看吧，",
    "voice": "vo_adv_1027008_020",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我什麼事都沒有。\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您能相信我了吧？",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……可是呢，",
    "voice": "vo_adv_1027008_021",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我不能讓您白白享受這道料理。\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這道料理是獎勵。",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我",
    "voice": "vo_adv_1027008_022",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "今天想要來\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "幫忙{0}大人溫習功課……",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "根據我聽說到的消息，\\n",
    "voice": "vo_adv_1027008_023",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您正為了準備考試而非常辛苦……",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人的痛苦就是我的痛苦。\\n",
    "voice": "vo_adv_1027008_024",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "所以",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我決定來幫助您溫習功課。",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "因此就是",
    "voice": "vo_adv_1027008_025",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這道料理該登場的時候了。",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "獎勵與處罰的搭配對學習很有效果……\\n",
    "voice": "vo_adv_1027008_026",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "如果您答對我的問題，\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就可以吃這道料理。",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "但只要您答錯任何一道問題……\\n",
    "voice": "vo_adv_1027008_027",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻……",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我想您還是不要知道比較好。",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那麼呢，",
    "voice": "vo_adv_1027008_028",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我現在要出題了。\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "因為我會擔心{0}大人的身體，\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "所以請您千萬不要答錯了……",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那麼呢，",
    "voice": "vo_adv_1027008_029",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "首先從基本問題開始……\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "一個直徑為10公分的球體，表面面積是多少？",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……咦？",
    "voice": "vo_adv_1027008_030",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您說這不是基礎問題……",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嗎？\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "沒有這回事，",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "如果是{0}大人的話，\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這種程度只是入門的入門而已。",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "來吧，",
    "voice": "vo_adv_1027008_031",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "請作答……？",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "100π……",
    "voice": "vo_adv_1027008_032",
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "答對了。\\n",
    "voice": null,
    "unit_id": 102732
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "接下來，是下一道問題……",
