[
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……若是不記得的話，",
    "voice": "vo_adv_2003008_000",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n就表示您不是大小姐。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "您說多虧了我的迷糊，",
    "voice": "vo_adv_2003008_001",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n讓您得以緩解緊張，完成了演說…………",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n還說我的迷糊總是幫助著您。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "您並不是那位笑著對我這麼說的，",
    "voice": "vo_adv_2003008_002",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我所尊敬、服侍的主人。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  }
]
