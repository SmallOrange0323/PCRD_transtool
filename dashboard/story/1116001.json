[
  {
    "type": "background",
    "bg_id": "500872"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了準備隔天的個人演唱會，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n望結束了一天的排練正在收拾中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好了，",
    "voice": "vo_adv_1116001_000",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "工作人員們好像也已經回去了，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我也差不多該回去了。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "簡單吃個晚餐，",
    "voice": "vo_adv_1116001_001",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n淋個浴，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為了明天得早點睡覺呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……",
    "voice": "vo_adv_1116001_002",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "果然還是",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "再稍微練習一下吧。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n有幾個動作做得還不是很好呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "1、",
    "voice": "vo_adv_1116001_003",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "2、",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "1、",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "2",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n轉身、",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "停！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……嗯～",
    "voice": "vo_adv_1116001_004",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "結束時手的角度，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是不是再抬高點比較好啊。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n還有",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "轉身再稍微快一點……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "很好呢！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "最近都是舉辦【慈樂之音】的演唱會，",
    "voice": "vo_adv_1116001_005",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n很久沒有辦個人演唱會了，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "必須準備得更加周全才是。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌跟紡希都不在，",
    "voice": "vo_adv_1116001_006",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "全部都只能靠我自己，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n既然目標是頂級偶像，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就不能容許不完美的表演呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好～，",
    "voice": "vo_adv_1116001_007",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "從最開始再來一次――",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呀啊！",
    "voice": "vo_adv_1116001_008",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n{0}？　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嚇到我了……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你為什麼在這裡？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這樣啊，",
    "voice": "vo_adv_1116001_009",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是幫忙演唱會場地佈置的打工呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "才巡邏到現在啊。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "做到這麼晚謝謝你呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是啊，",
    "voice": "vo_adv_1116001_010",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我是在自己練習啦。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n是在工作人員努力佈置的舞台上表演呢，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n必須得好好表現。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯？　",
    "voice": "vo_adv_1116001_011",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你看過排練了嗎？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "覺、",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "覺得怎麼樣呢？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真的嗎？　",
    "voice": "vo_adv_1116001_012",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n就算是客套話也讓我更有自信了呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個，",
    "voice": "vo_adv_1116001_013",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "新歌怎麼樣？　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那首歌",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是我自己作詞的喔。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "表演曲目也很不錯吧？　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我煩惱了很久呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對了對了，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "周邊也出了新的喔！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊――，",
    "voice": "vo_adv_1116001_014",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "怎麼辦呀。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n一跟你說起話來就覺得越來越開心了呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "想要一直聊下去呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "明天演唱會的事情啦，",
    "voice": "vo_adv_1116001_015",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "聖誕節的事情之類的。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對了，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要不要一起吃飯然後慢慢地……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呃，",
    "voice": "vo_adv_1116001_016",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不行不行！　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "還在練習中啊！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要是隨便妥協，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也做不出什麼精彩的表演！　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": "vo_adv_1116001_017",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "抱歉呢，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我還得繼續練習。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n所以呢……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "明天見喔。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……",
    "voice": "vo_adv_1116001_018",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "走掉了……",
    "voice": "vo_adv_1116001_019",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我是不是有點冷淡呢？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是",
    "voice": "vo_adv_1116001_020",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我的目標是成為頂級偶像。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n為了呈現最棒的舞台，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "必須要練習到自己能夠接受的程度呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊――",
    "voice": "vo_adv_1116001_021",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是如果",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "被{0}討厭的話怎麼辦啊！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就只有他，我不想被他討厭，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n可是……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯……",
    "voice": "vo_adv_1116001_022",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "再想下去也沒有用呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只能好好地練習，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "用表演來當作賠禮吧。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "1、",
    "voice": "vo_adv_1116001_023",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "2、",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "1、",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "2",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不行，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "總覺得沒辦法冷靜練習。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真是丟臉呢，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "明明是自己下定決心的事情卻辦不到……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦、",
    "voice": "vo_adv_1116001_024",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}！？　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為什麼……？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n你不是回去了嗎？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
