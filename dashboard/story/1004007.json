  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}正在向禊學習\\n如何才能不落入陷阱的方法。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咚──！",
    "voice": "vo_adv_1004007_000",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "呀哈哈哈！哥哥又掉到地洞裡了～",
    "voice": "vo_adv_1004007_001",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥真的是太有趣了～♪",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊和哥哥在一起覺得超級開心的！",
    "voice": "vo_adv_1004007_002",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊最喜歡哥哥了──♪",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，天色有點暗了呢。",
    "voice": "vo_adv_1004007_003",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那今天的課程就到此結束！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n接下來的部分明天再繼續吧。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "background",
    "bg_id": "500011"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "明天……10點的時候在這個廣場會合好不好？",
    "voice": "vo_adv_1004007_004",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "欸嘿嘿～",
    "voice": "vo_adv_1004007_005",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊會準備特製的陷阱，盡請期待呦。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那就這樣囉，掰掰──！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天， 約定的時間。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "有──人──在嗎────！",
    "voice": "vo_adv_1004007_006",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n有沒有人在呀────！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗚嗚，怎麼辦……禊沒有辦法逃出這個地洞陷阱了……",
    "voice": "vo_adv_1004007_007",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "本來是想要讓哥哥掉進來，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n才特地挖了這個地洞的～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "沒有想到地洞的底下居然是空的，",
    "voice": "vo_adv_1004007_008",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "讓整個地洞都塌陷了。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊好像掉到很深的地方了說～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "想盡辦法都爬不上去，",
    "voice": "vo_adv_1004007_009",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "只好等路過的人來救禊了吧～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "有沒有人在上面呀──！",
    "voice": "vo_adv_1004007_010",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "有沒有路過的旅行者──",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n還是路過的傳說勇者──！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "或是路過的美美──",
    "voice": "vo_adv_1004007_011",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n路過的鏡華──",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "還是路過的哥哥──！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥呀……",
    "voice": "vo_adv_1004007_012",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n禊和哥哥約好的地點，是在蘭德索爾的正中央耶～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n哥哥不可能來這裡的吧……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗚嗚，太失敗了～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯～乾脆來吃便當，",
    "voice": "vo_adv_1004007_013",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n然後耐心等候有人路過好了！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊要開動了──♪",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……………………\\n",
    "voice": "vo_adv_1004007_014",
    "unit_id": 100411
  },
  {
    "type": "background",
    "bg_id": "500141"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……………………",
    "voice": "vo_adv_1004007_015",
    "unit_id": 100411
  },
  {
    "type": "background",
    "bg_id": "500142"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……………………",
    "voice": "vo_adv_1004007_016",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "都沒有人路過……",
    "voice": "vo_adv_1004007_017",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n怎、怎麼辦……都已經晚上了……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊的肚子好餓呀──",
    "voice": "vo_adv_1004007_018",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n要是沒有在晚餐之前回家的話，媽媽會生氣的……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "要是就這樣回不了家怎麼辦……",
    "voice": "vo_adv_1004007_019",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n要、要是沒有人找到禊的話怎麼辦……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "要、要是有魔物跑出來的話……",
    "voice": "vo_adv_1004007_020",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊，會、會被吃掉的……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗚哇────！",
    "voice": "vo_adv_1004007_021",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n有沒有人────！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n有沒有人，救命呀────！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥、哥哥──！",
    "voice": "vo_adv_1004007_022",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n哥哥────！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n哥哥──────！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "still",
    "still_id": "100400701"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥、哥哥！？是哥哥！！",
    "voice": "vo_adv_1004007_023",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n真的是哥哥嗎？？？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哇哇──謝謝哥哥來救禊────！",
    "voice": "vo_adv_1004007_024",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "最喜歡哥哥了────！！！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊呢～還以為沒辦法逃離這個地洞了說～",
    "voice": "vo_adv_1004007_025",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "下一次哥哥要快點來救禊呦♪",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "對、對不起～",
    "voice": "vo_adv_1004007_026",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "下一次禊惡作劇的時候會更小心的！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500142"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦、咦？不過哥哥為什麼會來這裡？是怎麼找到禊的？",
    "voice": "vo_adv_1004007_027",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊沒有告訴哥哥我在這裡呀，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n而且這裡離約好碰面的地方也很遠……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "找、找了很久……這裡離蘭德索爾很遠耶？",
    "voice": "vo_adv_1004007_028",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n在毫無線索的情況下？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "從約定的時間就一直找到現在？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥、哥哥……",
    "voice": "vo_adv_1004007_029",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "謝謝你！謝謝哥哥！",
    "voice": "vo_adv_1004007_030",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊呀，想跟哥哥說，最～～",
    "voice": "vo_adv_1004007_031",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "最、最……喜…………",
    "voice": "vo_adv_1004007_032",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那個……那個……",
    "voice": "vo_adv_1004007_033",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那個───",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "――――――～～……",
    "voice": "vo_adv_1004007_034",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "沒、沒事！我們回去吧，哥哥！",
    "voice": "vo_adv_1004007_035",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "禊雖然露出了和平常一樣的笑容，但卻不敢讓{0}看到她的臉孔。",
    "voice": null,
    "unit_id": null
  }
]
