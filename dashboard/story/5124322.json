[
  {
    "type": "dialogue",
    "name": "空花",
    "words": "哎呀～～？",
    "voice": "vo_adv_5124322_000",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "看來",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "惡靈的行動",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "好像有了變化呢～～？",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這個是……",
    "voice": "vo_adv_5124322_001",
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "騷靈現象……？",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "它打算讓東西飄起後，",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "往我們砸過來！",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "是幽靈常用的招式！",
    "voice": "vo_adv_5124322_002",
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n最好先把飄起來的東西打下來比較安全！",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "我、",
    "voice": "vo_adv_5124322_003",
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "我知道了……",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n那麼",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "惡靈就留到後面",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "再來處理，",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "對吧……？",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "沒錯。",
    "voice": "vo_adv_5124322_004",
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "看那個靈氣的流向，",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n應該會有相當大量的東西朝著我們飛過來吧。",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "與其個別擊落，",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不如一次全部打下來比較安全。",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "全部打下來，",
    "voice": "vo_adv_5124322_005",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是嗎～～",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "懂是懂了，",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不過能順利辦到嗎～～？",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "也只能試試看了！",
    "voice": "vo_adv_5124322_006",
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "而且啊……",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "哼哼哼♪",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n說到把東西打下來，就是我和忍表現的時候了！",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n利用返還咒術，",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "把東西全部往對方那裡丟回去！",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "好、",
    "voice": "vo_adv_5124322_007",
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "好厲害……！",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n連這種事",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "也能做到嗎……？",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗯，",
    "voice": "vo_adv_5124322_008",
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "做得到喔。",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "「害人者終將害己」……",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "以其人之道，",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n還治其人之身，",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這就是詛咒的規矩。",
    "voice": null,
    "unit_id": 127111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "說的沒錯！",
    "voice": "vo_adv_5124322_009",
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n呵呵呵，",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "好～",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "啦……",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n我們要來整治騷靈現象啦！！",
    "voice": null,
    "unit_id": 2414
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "哇、",
    "voice": "vo_adv_5124322_010",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "哇啊……",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n空花絕對不想要……",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n和忍還有骷髏老爸為敵呢……",
    "voice": null,
    "unit_id": 127011
  }
]
