    "bg_id": "500216"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "因為山神大人參加，山路變得更加險峻，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n位居最後一名的鈴莓，體力也到了極限。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呼、",
    "voice": "vo_adv_5031006_000",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呼、",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呼！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐……",
    "voice": "vo_adv_5031006_001",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐她、",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "看到這樣子的我",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "會說些什麼呢。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n根本沒必要去跑？　",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不用這麼努力也沒關係？　",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不對……",
    "voice": "vo_adv_5031006_002",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "她一定會對我說",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要拿下優勝。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "她在終點等我。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "她的溫柔",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就在於她相信著我。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "所以，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我絕對不能放棄！　",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我要從",
    "voice": "vo_adv_5031006_003",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "老是給人添麻煩的自己",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "畢業！！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "沒想到！　",
    "voice": "vo_adv_5031006_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "鈴莓選手的跑速雖然因為山神大人的影響而變慢，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n但是她追上",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "領先的選手們了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "眼前",
    "voice": "vo_adv_5031006_005",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "變得模糊了……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我的身體告訴我，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "在這裡停下來的話，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我就動不了了……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "窮追不捨的鈴莓選手，",
    "voice": "vo_adv_5031006_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "讓觀眾響起了熱烈的掌聲！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n誰能預料到",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "她居然",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "能跑到這裡呢！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "看那表情",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "她似乎也快到極限了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們相信妳可以的！　",
    "voice": "vo_adv_5031006_007",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對吧，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喂，",
    "voice": "vo_adv_5031006_008",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳幹嘛把話題丟給我啦！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是她自己說要參加的，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n如果沒有跑到這裡的話我們會很困擾。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "僅此而已唷。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_5031006_009",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "最先聲援鈴莓小姐的人",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n是凱留小姐呢。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可是鈴莓小姐沒問題嗎……",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "她看起來似乎相當難受……",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "山神大人",
    "words": "轟隆！　",
    "voice": "vo_adv_5031006_010",
    "unit_id": 12711
  },
  {
    "type": "dialogue",
    "name": "山神大人",
    "words": "轟隆！",
    "voice": null,
    "unit_id": 12711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "呼、呼！　",
    "voice": "vo_adv_5031006_011",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "衝、",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "衝太快了，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "開始累了……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嗚咿。",
    "voice": "vo_adv_5031006_012",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花也",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "快到極限了……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那我就趁現在……！",
    "voice": "vo_adv_5031006_013",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是很想這樣說，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過我也沒那體力的啦……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "領先的三人",
    "voice": "vo_adv_5031006_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "儘管很疲憊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "仍勉強跟山神大人不分軒輊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n後面還有",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "快到極限的鈴莓選手正在追趕！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "能不能撐到終點才是問題！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "山神大人",
    "words": "轟隆！？　",
    "voice": "vo_adv_5031006_015",
    "unit_id": 12711
  },
  {
    "type": "dialogue",
    "name": "山神大人",
    "words": "轟隆隆隆隆隆隆隆隆隆隆隆！",
    "voice": null,
    "unit_id": 12711
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "哎────喲好險！　",
    "voice": "vo_adv_5031006_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "看到在做最後衝刺的鈴莓選手，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n山神大人展現出了幹勁！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "石塊",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "掉落的更激烈了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小小格里芬",
    "words": "噗噗噗噗，",
    "voice": null,
    "unit_id": 2211
  },
  {
    "type": "dialogue",
    "name": "小小格里芬",
    "words": "咕嚕咕嚕～",
    "voice": null,
    "unit_id": 2211
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "蹦蹦跳～♪",
    "voice": "vo_adv_5031006_017",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "美美選手！　",
    "voice": "vo_adv_5031006_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "騎著小小格里芬先生",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "越過了落石！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "欸嘿嘿～",
    "voice": "vo_adv_5031006_019",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這樣真有趣～♪",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "咦，",
    "voice": "vo_adv_5031006_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "美美選手……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "不知道是不是太沉浸於在落石上跳躍的樂趣，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n她跑離了路線，往完全不同的方向去了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "等等啊美美～！　",
    "voice": "vo_adv_5031006_021",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "回來啊――！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "山神大人",
    "words": "轟隆隆隆隆隆隆隆隆隆！",
    "voice": "vo_adv_5031006_022",
    "unit_id": 12711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哇哇哇！　",
    "voice": "vo_adv_5031006_023",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "現、",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "現在不是跑步的時候了吧──！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "性、",
    "voice": "vo_adv_5031006_024",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "性命更要緊的啦！　",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "各位，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "暫時先去避難吧！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "太、",
    "voice": "vo_adv_5031006_025",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "太激烈了。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花的身體撐不住。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "三位選手，",
    "voice": "vo_adv_5031006_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "以及",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "各公會跟著的馬車，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n似乎決定先離開山神大人附近去緊急避難！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n因此，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "第一名是山神大人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "而第二名",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "竟然是",
    "voice": null,
    "unit_id": null
  },
  {
