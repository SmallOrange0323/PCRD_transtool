    "words": "大小姐她……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咲戀小姐",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就是這樣的人。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "可是我卻",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "擅自擔心自己會被拋棄……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n是我沒有相信那位",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "把我當作好友的人。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐，",
    "voice": "vo_adv_5031006_061",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請妳……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "再給我一次機會……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我、",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "當然。",
    "voice": "vo_adv_5031006_062",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "去取得勝利吧……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不對，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要拿下優勝，鈴莓！　",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我在終點等妳！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "background",
    "bg_id": "500216"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是！　",
    "voice": "vo_adv_5031006_063",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我一定會過去的，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐！！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "鈴莓選手的眼中",
    "voice": "vo_adv_5031006_064",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "再次燃起了鬥志──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n究竟是主人說的話，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "還是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "她自己的內心",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "讓她有如此轉變呢──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "山神大人",
    "words": "轟隆！　",
    "voice": "vo_adv_5031006_065",
    "unit_id": 12711
  },
  {
    "type": "dialogue",
    "name": "山神大人",
    "words": "轟隆！　",
    "voice": null,
    "unit_id": 12711
  },
  {
    "type": "dialogue",
    "name": "山神大人",
    "words": "轟隆隆隆隆隆隆！",
    "voice": null,
    "unit_id": 12711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我不會輸，",
    "voice": "vo_adv_5031006_066",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "也不會放棄！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "鈴莓小姐，",
    "voice": "vo_adv_5031006_067",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "妳的身體不要緊嗎！？",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是的！　",
    "voice": "vo_adv_5031006_068",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我從大小姐那裡得到活力了！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n讓妳們",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "擔心了。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都到這裡了，",
    "voice": "vo_adv_5031006_069",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳可別輸唷！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "鈴莓，",
    "voice": "vo_adv_5031006_070",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "等妳贏了，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家一起去吃好吃的食物吧！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我會贏的。",
    "voice": "vo_adv_5031006_071",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我的身旁有大家在！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "好快好快好快――呀！　",
    "voice": "vo_adv_5031006_072",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "這追趕的速度實在是太快了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n苦惱、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "矛盾，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "她將這些都拋諸腦後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n看開一切後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "現在她的跑速已經",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "超越極限了了了了了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "對於突然現身的山神大人，",
    "voice": "vo_adv_5031006_073",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "本以為各個公會已經束手無策……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n沒想到，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "竟然",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "有一位跑者出面阻止了這個攻勢……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "儘管曾經",
    "voice": "vo_adv_5031006_074",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "淪為最後一名，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n但仍讓我們見識到她的死命追趕。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "這位驚人的巫女，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "鈴莓選手！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n她就在山神大人身後寸步之遙，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "緊追不捨！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "離終點的距離所剩無幾……",
    "voice": "vo_adv_5031006_075",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n「新春蘭德索爾的公會競速賽」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "準備要迎向",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "最後的高潮！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "movie",
    "movie_id": "503100601"
  },
  {
    "type": "background",
    "bg_id": "500216"
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "大逆轉呢。",
    "voice": "vo_adv_5031006_076",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓竟然辦到了……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真厲害耶。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "來，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們去找大家吧？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那、",
    "voice": "vo_adv_5031006_077",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "可以再維持這樣一下子嗎……？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "咦？",
    "voice": "vo_adv_5031006_078",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我的腳",
    "voice": "vo_adv_5031006_079",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "已經到極限……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "一步也動不了了。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……呵呵，",
    "voice": "vo_adv_5031006_080",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "知道了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n既然這樣，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那我給妳個公主抱吧？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "公、",
    "voice": "vo_adv_5031006_081",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "公主抱！？　",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那、",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那也未免",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "太丟人了～！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "哈哈哈，",
    "voice": "vo_adv_5031006_082",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "開玩笑的。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "而且，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "現在該給鈴莓妳的",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不是公主抱，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "而是慶祝勝利的拋高呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "她簡直就是",
    "voice": "vo_adv_5031006_083",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "「山神大人的巫女」！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "各位，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "讓我們再給鈴莓選手一次",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n熱烈的掌聲！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "獲勝的是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "【美食殿堂】！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n新春蘭德索爾的公會競速賽，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "她們贏得了出色的勝利啊啊啊啊！！",
    "voice": null,
    "unit_id": null
  }
]
