[
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這股氣息……",
    "voice": "vo_adv_5120321_000",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是怎麼回事……？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n那傢伙的力量增強了嗎！？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "伊莉亞，",
    "voice": "vo_adv_5120321_001",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的美肌在顫抖……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n不快點制止那個會很不妙呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳的美肌連那樣的感應能力都有嗎……？",
    "voice": "vo_adv_5120321_002",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "狀況很危險是事實，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "要是繼續放著不管，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那傢伙的力量似乎會無止盡地增強。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有了！",
    "voice": "vo_adv_5120321_003",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n就用我的美麗來引開他的注意如何？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "我說妳啊，",
    "voice": "vo_adv_5120321_004",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是以為靠美麗就無所不能吧？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "設法制止那傢伙增強力量正是關鍵所在。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n為此，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "無論是美麗還是什麼都行，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雪啊，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "快上吧。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……伊莉亞，",
    "voice": "vo_adv_5120321_005",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳不會是懶得應付我，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n才想說總之先慫恿我就好了吧？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好了上吧，",
    "voice": "vo_adv_5120321_006",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雪啊，統御美麗之人！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n讓那傢伙看看咱們的力量！",
    "voice": null,
    "unit_id": 126211
  }
]
