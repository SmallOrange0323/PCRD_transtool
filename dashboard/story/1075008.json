[
  {
    "type": "background",
    "bg_id": "500161"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "貪吃佩可和{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到了人變少的沙灘，悠閒地眺望西沉的夕陽。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯──♪",
    "voice": "vo_adv_1075008_000",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n今天玩得真盡興！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "歡樂的時光",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一眨眼就結束了！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以，",
    "voice": "vo_adv_1075008_001",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你的臨時打工，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n就到這裡結束囉☆",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……不過很可惜呢。",
    "voice": "vo_adv_1075008_002",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n接下來暫時",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "又沒辦法和你見面了……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "想見的話",
    "voice": "vo_adv_1075008_003",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "確實還有辦法見面，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但從明天起，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我就是尤絲蒂亞娜陛下了。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我不能再像今天這樣對你撒嬌，",
    "voice": "vo_adv_1075008_004",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n給你添麻煩了。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "當夕陽西沉後，",
    "voice": "vo_adv_1075008_005",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這個閃亮的魔法就消失了。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這麼一想",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真的有點捨不得……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我不想回去。",
    "voice": "vo_adv_1075008_006",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n好想讓你繼續當我的達令，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n再給你",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "添麻煩……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "…………",
    "voice": "vo_adv_1075008_007",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "開玩笑的啦☆",
    "voice": "vo_adv_1075008_008",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對了，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "該給你什麼報酬呢？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n先告訴我你要什麼吧！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦？",
    "voice": "vo_adv_1075008_009",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n去一個地方？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "喂～！",
    "voice": "vo_adv_1075008_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "小兄弟！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n我準時到了～！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "船上好像有人在揮手……",
    "voice": "vo_adv_1075008_011",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n難道我們接下來",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "要出海嗎？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "原來如此～",
    "voice": "vo_adv_1075008_012",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你有什麼驚喜要給我嗎？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "既然可以延長約會時間，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我很願意陪你去♪",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼達令♪",
    "voice": "vo_adv_1075008_013",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我只是個柔弱的女孩子，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n麻煩你",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "護送我上船囉♪",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "background",
    "bg_id": "500841"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大海、",
    "voice": "vo_adv_1075008_014",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大海、",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大海！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一望無際的大海！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n景色真是",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "太棒了♪",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "原來你想來的就是這裡☆",
    "voice": "vo_adv_1075008_015",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "從船上看夕陽，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真的好浪漫哦♪",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那裡……",
    "voice": "vo_adv_1075008_016",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "燈塔嗎？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "嗯，",
    "voice": "vo_adv_1075008_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "前不久才蓋好的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "這都多虧了我們的陛下。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……咦？",
    "voice": "vo_adv_1075008_018",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "這附近",
    "voice": "vo_adv_1075008_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "之前有魔物作亂……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n沒辦法出海捕魚。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "也沒有觀光客。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n我們的生活",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "都快過不下去了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "畢竟蘭德索爾也正在復興。",
    "voice": "vo_adv_1075008_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n老實說，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "我根本不敢期待中央會對這種鄉下地方伸出援手……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n不過，當時的情況也顧不了",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "這麼多，反正就先提出請願書看看。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "然後",
    "voice": "vo_adv_1075008_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "蓋燈塔的計畫就開始了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n我們全都嚇了一大跳。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "多虧有那座燈塔，不但船難變少，",
    "voice": "vo_adv_1075008_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n魔物也不再靠近。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n所以現在我們都能安心生活了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不、",
    "voice": "vo_adv_1075008_023",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對於陛下，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n大家似乎",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還是有不少疑慮……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "嗯，",
    "voice": "vo_adv_1075008_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "我們一開始",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "的確是不放心。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n不過啊……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "我們現在",
    "voice": "vo_adv_1075008_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "全家都有美味的飯吃……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n這種幸福的生活",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "是陛下幫我們討回來的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "所以",
    "voice": "vo_adv_1075008_026",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "我支持現任的陛下。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n……嗯。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "至少她還幹得比前任好一點嘛！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚",
    "voice": "vo_adv_1075008_027",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我會努力的。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "嗯？",
    "voice": "vo_adv_1075008_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊！",
    "voice": "vo_adv_1075008_029",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒什麼！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你的意見很有幫助～！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊哈哈～！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……那個。",
    "voice": "vo_adv_1075008_030",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這件事情，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}應該已經知道了吧？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "那是當然的！",
    "voice": "vo_adv_1075008_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "這位小哥",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "好像是陛下的粉絲！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n他似乎還會到其他陛下視察的地方，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "追著她四處跑的樣子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "不過，就算你是陛下的粉絲，",
    "voice": "vo_adv_1075008_032",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n在夏天和女朋友約會的時候，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "也不需要來這邊看燈塔吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒關係！",
    "voice": "vo_adv_1075008_033",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我很開心☆",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿嘿……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "原來你是",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "陛下的粉絲啊！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "原來如此！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……不好意思。",
    "voice": "vo_adv_1075008_034",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可以在這裡",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "待久一點嗎？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我想將這副景色，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "深深烙印在腦海裡面！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "background",
    "bg_id": "500161"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿嘿♪",
    "voice": "vo_adv_1075008_035",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你給我的驚喜，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n真的讓我嚇了一大跳☆",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個，",
    "voice": "vo_adv_1075008_036",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "在回去之前，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可以稍微聊聊嗎？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就是……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所謂的告白時間♪",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "船長剛才不是說了嗎？",
    "voice": "vo_adv_1075008_037",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "之前他們沒辦法去捕魚，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也沒有觀光客來這裡。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但多虧了燈塔，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "他們的煩惱解決了。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "今天一起吃海鮮，",
    "voice": "vo_adv_1075008_038",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n一起拜訪擠滿觀光客的海邊，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n最後還帶我來看那座燈塔……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你做的這一切是",
    "voice": "vo_adv_1075008_039",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "全都是為了我，對吧☆",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "其實",
    "voice": "vo_adv_1075008_040",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "決定留在王宮後，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n在我心裡的一個小小角落，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n一直覺得見不到你很寂寞。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過，",
    "voice": "vo_adv_1075008_041",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你其實一直默默站在遠方，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n關心著我身為陛下時所做的事。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你始終都是站在我這邊的……",
    "voice": "vo_adv_1075008_042",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n而且還告訴了我，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "距離不會阻隔你的心意！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以……",
    "voice": "vo_adv_1075008_043",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "下次再碰到難過的事情的時候，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我會回想起今天！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n回想起和最喜歡的人共度的夏天♪",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "以後還要",
    "voice": "vo_adv_1075008_044",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "再和我來這裡約會哦。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n達令☆",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "西斜的夕陽下……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}握住貪吃佩可伸出的手，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n對她做出了承諾。",
    "voice": null,
    "unit_id": null
  }
