    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "是了。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n這「訊息」是在",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "萊拉耶爾公主一行人到來前送抵的……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n在那之後，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "吾妹就失去了",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "一切消息。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "那麼──",
    "voice": "vo_adv_2208003_029",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n有可能是在回來吉歐‧格黑納的路上，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n碰到了",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "什麼意外",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "也說不定。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "若遲遲毫無音信，",
    "voice": "vo_adv_2208003_030",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n或許就需如此考慮。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "但就目前線索而言，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n恐怕只會是",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「救人不成",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "反把自己賠上了」。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "那麼──",
    "voice": "vo_adv_2208003_031",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "您打算怎麼做呢？",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "萊拉耶爾公主一行人",
    "voice": "vo_adv_2208003_032",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "也無法在此久留。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "那麼──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "眼下只能不湊齊「四個世界」，",
    "voice": "vo_adv_2208003_033",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n僅由三世界的公主進行會議了。",
