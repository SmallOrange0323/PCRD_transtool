[
  {
    "type": "background",
    "bg_id": "502110"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "萊拉耶爾一行人來到吉歐‧格黑納，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n已過去數日──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……（盯）。",
    "voice": "vo_adv_2208003_000",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "嗯？",
    "voice": "vo_adv_2208003_001",
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "總覺得一直有人盯著我看……",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "\\n原來是來自另一個世界的小姑娘啊。",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "啊，",
    "voice": "vo_adv_2208003_002",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "對不起！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n我居然",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "這樣冒昧地盯著不認識的人看……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "沒關係啦。",
    "voice": "vo_adv_2208003_003",
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "在妳們的世界裡，",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "\\n像我這種模樣的人很少見吧？",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "那倒沒有……",
    "voice": "vo_adv_2208003_004",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "其實我們的世界裡",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "也有會走路的貓人。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "他也是很想來的，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "但他得工作守門……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "哦？",
    "voice": "vo_adv_2208003_005",
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "是個什麼樣的人呀？",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "帥貓嗎？",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "……",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "呃……",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "不光是臉，",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "全身都毛茸茸的？",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "那種的不是我的菜耶～",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "衝鋒迅豹女性",
    "words": "哈哈！",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……唉。",
    "voice": "vo_adv_2208003_006",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老姊。",
    "voice": "vo_adv_2208003_007",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n想家啦？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "不是啦。",
    "voice": "vo_adv_2208003_008",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n不過……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "吉歐‧尼布爾黑爾",
    "voice": "vo_adv_2208003_009",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "的公主",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "什麼時候才會來呢……？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n萊拉耶爾殿下",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "也不能離開帕菲之城",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "太久呀……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "嗯，",
    "voice": "vo_adv_2208003_010",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "是沒錯啦。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "聽說目前還沒有固定的往返路線，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n難免需要多一點時間。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……嗯……",
    "voice": "vo_adv_2208003_011",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不過……",
    "voice": "vo_adv_2208003_012",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n確實",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "是有點無聊了呢。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──接著，當天晚上……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502171"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n接到了涅妃‧涅羅的祕密傳喚。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──我帶他來了。",
    "voice": "vo_adv_2208003_013",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n皇女。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "辛苦了。",
    "voice": "vo_adv_2208003_014",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "默涅。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下。",
    "voice": "vo_adv_2208003_015",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n有勞汝",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "深夜走這一遭。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然而，",
    "voice": "vo_adv_2208003_016",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "出現了一些先兆。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n需要先私下告訴汝。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "迴避耳目",
    "voice": "vo_adv_2208003_017",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不是為了別的。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此「四世界公主會議」──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n在開始之前，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "事態已經有些可疑。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "坦白",
    "voice": "vo_adv_2208003_018",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "告訴汝吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n奴家的妹妹",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "已無消無息數日。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "橫跨世界和世界的通訊魔法，",
    "voice": "vo_adv_2208003_019",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "本是無稽之談。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n但那傢伙",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正特別擅長這種伎倆。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……唔，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "叫什麼來著……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──我記得",
    "voice": "vo_adv_2208003_020",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "好像是叫「傳話人」",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "之類的。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正是、",
    "voice": "vo_adv_2208003_021",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正是。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家再三叮囑要用那個名為「傳話人」的妖術，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n定期",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "匯報消息，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然而……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──難道不是去閒晃了嗎？",
    "voice": "vo_adv_2208003_022",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n像以往那樣。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "若吉歐‧尼布爾黑爾的世界裡",
    "voice": "vo_adv_2208003_023",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n四處都是幼兒，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n倒有幾分可能，但……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "默涅，",
    "voice": "vo_adv_2208003_024",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "念出這封信。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "字字句句",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "都要清清楚楚且富含情感，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "讓騎士閣下聽清楚。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "「致姐姐。",
    "voice": "vo_adv_2208003_025",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "得到小薇歐莉特啦──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n等我喝個茶再回去哦──」……",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "這是──",
    "voice": "vo_adv_2208003_026",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "涅婭小姐",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "傳來的……訊息",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "嗎？",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "吉歐‧尼布爾黑爾的──",
    "voice": "vo_adv_2208003_027",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "公主的",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "名字……？",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
