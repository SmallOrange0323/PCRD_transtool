  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "您說的沒錯。",
    "voice": "vo_adv_1308003_084",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n是這兩位",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "帶著我們前進的。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不是的！",
    "voice": "vo_adv_1308003_085",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為看到各位很努力，所以希望能幫上忙……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我們",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就只是稍微幫了點小忙而已！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "贊助商",
    "words": "呵呵，",
    "voice": "vo_adv_1308003_086",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "贊助商",
    "words": "對於舉行比賽的幹勁",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "贊助商",
    "words": "\\n只需要這種單純的想法就足夠了。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "贊助商",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "贊助商",
    "words": "所以，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "贊助商",
    "words": "這個比賽一定會很成功。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "贊助商",
    "words": "我是這麼想的。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "贊助商",
    "words": "因此，",
    "voice": "vo_adv_1308003_087",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "贊助商",
    "words": "請你們一定要用我的房子作為會場。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "贊助商",
    "words": "\\n我很期待唷。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "啊……",
    "voice": "vo_adv_1308003_088",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "非常謝謝您！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呵呵，",
    "voice": "vo_adv_1308003_089",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "接下來會變得更忙呢。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "是呀。",
    "voice": "vo_adv_1308003_090",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n但",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "這一切",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "都是託你們的福。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n我真的",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "不知道該如何感謝你們才好……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不，",
    "voice": "vo_adv_1308003_091",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我也沒做什麼事……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n這都要歸功於這個人，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "跟鮮花祭上",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n教會我很多事情的人們……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還有大小姐。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "能被這麼優秀的妳",
    "voice": "vo_adv_1308003_092",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "稱作大小姐的人，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n肯定是位相當了不起的人物吧。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是的♪",
    "voice": "vo_adv_1308003_093",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "她是一位非常好……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "很值得侍奉的人。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這麼說著的鈴莓，臉上掛著開心的微笑。",
    "voice": null,
    "unit_id": null
  }
]
