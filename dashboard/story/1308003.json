    "words": "你們兩個",
    "voice": "vo_adv_1308003_031",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "快點拿照片去報名比賽吧！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "要是放到之後再處理就會忘記的吧？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就、",
    "voice": "vo_adv_1308003_032",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就是說呢！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "可是",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "女僕的工作……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真是的～",
    "voice": "vo_adv_1308003_033",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "都說妳今天也休息了！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "稍微沖個澡",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就準備出門吧！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n哥哥你也是！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "至少去洗把臉。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好、",
    "voice": "vo_adv_1308003_034",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好的～！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我去端水過來～！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在咲戀育幼院度過了一個熱鬧的早晨後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人前往報名參加比賽。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然而……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "唉……",
    "voice": "vo_adv_1308003_035",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "不行了……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "比賽要停辦了……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦、",
    "voice": "vo_adv_1308003_036",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦咦咦咦咦！？",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "難道說，",
    "voice": "vo_adv_1308003_037",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "是想報名參加比賽的人嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "如果是的話，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "很抱歉……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n再這樣下去，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "比賽很有可能會取消……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請、",
    "voice": "vo_adv_1308003_038",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請問發生什麼事了嗎？",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "其實……",
    "voice": "vo_adv_1308003_039",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "比賽可能會借不到場地。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n這個攝影比賽是第一次舉辦……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n說來慚愧，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "我自己",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "只是個業餘攝影愛好者。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "我也招募了一些無償協助的志願者，",
    "voice": "vo_adv_1308003_040",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "做了很多嘗試，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "但幾乎沒有什麼參加者，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "也因為這樣，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n原本要借場地給我們的人說，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "我們的比賽",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "「不夠格」。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不夠格……",
    "voice": "vo_adv_1308003_041",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "是呀……",
    "voice": "vo_adv_1308003_042",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "評審也是我們這些業餘人士，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n對方說，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "要把場地借來舉辦沒有權威又沒有公信力的比賽，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "得再考慮考慮。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "唉啊啊……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "這樣下去比賽可能無法舉辦了。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "原來如此……",
    "voice": "vo_adv_1308003_043",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n如果是這樣的話，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那也沒辦法呢。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要讓很多人看到自己的照片",
    "voice": "vo_adv_1308003_044",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n也有點難為情……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "是的，",
    "voice": "vo_adv_1308003_045",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "很抱歉讓你們白跑了一趟……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "唉，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "好不容易",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "收到了【墨丘利財團】",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n協助舉辦的提議……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "不是的，",
    "voice": "vo_adv_1308003_046",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "我也只是對名字略有耳聞，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "但是就在剛才，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "突然收到了他們的聯繫……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這一定",
    "voice": "vo_adv_1308003_047",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是大小姐告訴他們的。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好、",
    "voice": "vo_adv_1308003_048",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好的！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請讓我們一起幫忙籌備比賽吧！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "……我是很感激你們的提議啦，",
    "voice": "vo_adv_1308003_049",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "不過真的可以嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "在不久前，",
    "voice": "vo_adv_1308003_050",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我們才幫忙舉辦過慶典，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就包在我們身上吧！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "身為大小姐的女僕……",
    "voice": "vo_adv_1308003_051",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不對……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n今天女僕的工作休息一天……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "總之，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我會好好努力的♪",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "話是這麼說，",
    "voice": "vo_adv_1308003_052",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "但要從哪裡開始著手呢……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "原來如此……",
    "voice": "vo_adv_1308003_053",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "如果有協辦單位的話，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n比賽的格調也會提升，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "然後",
    "voice": "vo_adv_1308003_054",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是參加者的部分呢。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n如果還有多餘的海報，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n可以讓育幼院的孩子們也來幫忙張貼。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "是的，",
    "voice": "vo_adv_1308003_055",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "不好意思，我們因為人手不夠，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "\\n所以還剩下很多海報……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "執行委員",
    "words": "拜託你們務必幫忙！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
