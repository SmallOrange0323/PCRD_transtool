[
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗚嗚……",
    "voice": "vo_adv_5126204_000",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那傢伙的魔力",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n感覺比剛才更強了……！",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "凱留寶，",
    "voice": "vo_adv_5126204_001",
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "妳在發抖欸，",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "沒事嗎……？",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "借妳用人家的披肩吧！",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……不用啦，",
    "voice": "vo_adv_5126204_002",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳應該也會冷吧？",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就算妳不會用魔法，",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n應該也感受得到這股寒氣才對……",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯？",
    "voice": "vo_adv_5126204_003",
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的不要緊啦。",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "在制服底下",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還有穿運動服喔。",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼！？",
    "voice": "vo_adv_5126204_004",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯？",
    "voice": "vo_adv_5126204_005",
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "有需要那麼驚訝嗎？",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒事……",
    "voice": "vo_adv_5126204_006",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我只是想到妳裡面穿著運動服，身材看起來還那麼好，",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就覺得超級模特兒真可怕……",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……不對，",
    "voice": "vo_adv_5126204_007",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "現在不是說這些的時候。",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們趕快去追那傢伙吧！",
    "voice": null,
    "unit_id": 127211
  }
]
