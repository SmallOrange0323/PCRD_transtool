  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不要啊啊啊啊啊啊啊────！",
    "voice": "vo_adv_1348002_000",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n不、",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不要過來────！",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "青蛙魔物們",
    "words": "──呱呱呱！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這些青蛙是怎樣啊！？",
    "voice": "vo_adv_1348002_001",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n為什麼一直攻擊我的衣服……",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呀啊──！",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不要拉扯那邊──！",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "background",
    "bg_id": "502070"
  },
  {
    "type": "dialogue",
    "name": "青蛙魔物們",
    "words": "──呱啊啊啊啊啊！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "謝謝你！",
    "voice": "vo_adv_1348002_002",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我要把這個素材帶回去，",
    "voice": "vo_adv_1348002_003",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n在吉歐‧格黑納",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "掀起「時尚革命」！",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和紡希在叢林深處與魔物戰鬥。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為什麼",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "要來到吉歐‧格黑納數一數二的危險地帶？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n事情要回溯至昨天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502080"
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嗯……",
    "voice": "vo_adv_1348002_004",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怎麼樣都找不到呢……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n能夠做成堅韌布料的素材……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這種葉子感覺比看起來還脆弱，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n這邊的藤蔓又太硬了不適合加工……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我在找能當作衣服素材的植物。",
    "voice": "vo_adv_1348002_005",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "衣服的素材有不可或缺的重要元素，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n要舉兩個的話，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你覺得是什麼？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "只有毅力嗎！？",
    "voice": "vo_adv_1348002_006",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "思考方式是不是被吉歐‧格黑納感染了？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "毅力雖然是裁縫師很重要的元素，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但不是正確答案。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "答案是，",
    "voice": "vo_adv_1348002_007",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "耐用性和",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "易加工性。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "耐用性你能懂吧，",
    "voice": "vo_adv_1348002_008",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n因為容易破掉損壞的衣服",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "並不實用。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這在吉歐‧格黑納中，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是尤其重要的元素。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "再來是易加工性，",
    "voice": "vo_adv_1348002_009",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這也很重要。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "如果素材不易加工，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就無法做出設計複雜的衣服！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "為了做出色彩鮮艷的布料，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "也不能無視好不好染色這點。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "耐用性和易加工性",
    "voice": "vo_adv_1348002_010",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是很難兼顧的。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "堅韌的素材很難加工，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n好加工的素材又缺乏耐久力，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就是這種感覺。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那、",
    "voice": "vo_adv_1348002_011",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那是當然……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我也是為了時尚拼命的人啊。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "唉……",
    "voice": "vo_adv_1348002_012",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不管什麼事要兼顧都很困難呢。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "該怎麼辦呢……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那是？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那個～",
    "voice": "vo_adv_1348002_013",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n你是上次",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "和那位衝鋒迅豹女性",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "聊天的人對吧？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "嗯？",
    "voice": "vo_adv_1348002_014",
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "妳是誰？",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "生面孔呢。",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我是在蘭德索爾經營裁縫店的紡希。",
    "voice": "vo_adv_1348002_015",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "現在",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "正在尋找衣服的素材。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "衣服的素材？",
    "voice": "vo_adv_1348002_016",
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "這附近的素材",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "普遍是野獸或魔物的皮革。",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "雖然也有植物素材，",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "但不太精緻啊。",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "蘭德索爾那邊",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "會組合各種素材",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "做裝飾對吧？",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "沒錯，",
    "voice": "vo_adv_1348002_017",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "蘭德索爾的素材有很多種類和顏色。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "吉歐‧格黑納",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "一定也會有好的素材！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "如果有實用又可愛的衣服，",
    "voice": "vo_adv_1348002_018",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那不是超棒的嗎？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n上次和你吵架的",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那位女性也能夠……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "讓、",
    "voice": "vo_adv_1348002_019",
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "讓那傢伙打扮得可愛？",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "我、",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "那個，",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "那傢伙穿什麼",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "我都沒差……",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "在這邊嘴硬幹嘛啊，",
    "voice": "vo_adv_1348002_020",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真是的！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "總覺得像在看自己一樣真令人火大……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "總之！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你有想到什麼堅韌又好加工的素材嗎？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "這個嘛。",
    "voice": "vo_adv_1348002_021",
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "叢林深處",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "有藤蔓的群生地，",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "\\n那個如何？",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "雖然不知道是不是妳說的好素材，",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "\\n但捕獲魔物的時候都會用那個。",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "我可以保證它很堅韌也易用，",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "只是……",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我就是想聽這種情報！",
    "voice": "vo_adv_1348002_022",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n那麼我們馬上出發！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n為了時尚，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "為了可愛的衣服，不管是哪裡都要去！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "啊，",
    "voice": "vo_adv_1348002_023",
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "喂！",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "等一下等一下！",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "\\n那邊住著難纏的魔物……",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "啊，",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "跑走了……",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "那個傢伙也是、那個女生也是，",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男性",
    "words": "怎麼都不聽人說話啊……？",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "background",
    "bg_id": "502070"
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊～",
    "voice": "vo_adv_1348002_024",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真是悶熱。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n雖然吉歐‧格黑納感覺只有樹木、草和石頭，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n但這裡又更加充滿野性了呢。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……不，",
    "voice": "vo_adv_1348002_025",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "雖然的確是狂野過頭了，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但我不討厭。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n經歷了一些事之後，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "現在也很習慣了。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "而且現在，",
    "voice": "vo_adv_1348002_026",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我有要用時尚帶給吉歐‧格黑納幸福",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這個重要的目標！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我想找到在蘭德索爾沒有，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "屬於吉歐‧格黑納的時尚。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "活動自如和狂野，",
    "voice": "vo_adv_1348002_027",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "還有設計感！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "一定能夠兼顧的。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "雖然有些人",
    "voice": "vo_adv_1348002_028",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "對時尚會有「裝模作樣～」",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "的印象，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n但換個想法，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "心態也會跟著改變。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "好了，",
    "voice": "vo_adv_1348002_029",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "打聽到的地方應該就是這裡了……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n有看到類似的素材嗎？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊，",
    "voice": "vo_adv_1348002_030",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "腳下！？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n……真的耶。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "專注在聊天都沒發現！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嗯……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這個一定能拿來用，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "感覺可以做出很好的布料！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呼，",
    "voice": "vo_adv_1348002_031",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "有這麼多就夠了吧！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "趕快回去吧！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n借個小屋",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "當成簡易工作室的話馬上就能動工…………",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呀",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊！？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "青蛙魔物們",
    "words": "──呱呱呱！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這、",
    "voice": "vo_adv_1348002_032",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這些東西是什麼？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "青蛙魔物？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "等等，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "有超多隻的！？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不、",
    "voice": "vo_adv_1348002_033",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不要過來！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "走開！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這傢伙……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呀啊啊啊啊！？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真是的──！",
    "voice": "vo_adv_1348002_034",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這青蛙是怎樣！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我的衣服！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "被吃掉了……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不要啊啊啊！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生……！",
    "voice": "vo_adv_1348002_035",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n雖然很感謝你，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但請先不要管我！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n一定要保護好素材！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "謝謝你騎士先生！",
    "voice": "vo_adv_1348002_036",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n沒錯，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "現在比起我，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "請絕對要保護好那些素材！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但是之後",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "也請來救救我～～！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "然、",
    "voice": "vo_adv_1348002_037",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "然後，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "如果可以盡量不要看向這邊我會很感激的！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n只要某個東西稍微移動位置，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "重要的部分就會……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "喝啊，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真是的！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "青蛙魔物們",
    "words": "──呱呱呱！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "感、",
    "voice": "vo_adv_1348002_038",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "感覺之前",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "好像也發生過類似的事？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "難道遭遇這種事就是我的宿命嗎──？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "話說回來！",
    "voice": "vo_adv_1348002_039",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n這青蛙，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "為什麼會想吃我的衣服啊！？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n這好吃嗎？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是牠愛吃的嗎？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……啊！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "background",
    "bg_id": "502210"
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "說起來這件衣服的原料，",
    "voice": "vo_adv_1348002_040",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是在鬼岩城塞溫泉附近採集的，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n被當地人",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "稱為「青蛙皮」。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我就想說明明是植物卻叫皮",
    "voice": "vo_adv_1348002_041",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "還真奇怪……",
