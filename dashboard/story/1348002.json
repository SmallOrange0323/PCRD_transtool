    "name": "紡希",
    "words": "感覺越來越火大了……",
    "voice": "vo_adv_1348002_042",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n才這種程度，",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我可不會認輸！",
