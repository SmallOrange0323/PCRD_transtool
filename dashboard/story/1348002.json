  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "也要為了他人製作衣服！",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n這就是作為裁縫師的決心，",
