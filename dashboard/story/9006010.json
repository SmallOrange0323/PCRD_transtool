  {
    "type": "dialogue",
    "name": "旁白",
    "words": "回家途中的{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n感覺好像有人在叫他而停下了腳步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哦，",
    "voice": "vo_adv_9006010_000",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "找到了、找到了！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂～！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂，",
    "voice": "vo_adv_9006010_001",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那邊那個，就是在叫你！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n別假裝沒聽到！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯！",
    "voice": "vo_adv_9006010_002",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你記得我嗎？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是我呀！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啥？",
    "voice": "vo_adv_9006010_003",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我沒說過自己的名字嗎。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你的mimi也有收到通知吧？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我叫諾維……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯？",
    "voice": "vo_adv_9006010_004",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什麼啦。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n咦？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不能說那個名字嗎？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "為什麼……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，",
    "voice": "vo_adv_9006010_005",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "得保密才行的嘛。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "好險好險……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唉……",
    "voice": "vo_adv_9006010_006",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "如果是你的話應該無所謂吧。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我的名字叫做……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "矛依未。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊？",
    "voice": "vo_adv_9006010_007",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你問我為什麼讀同一間學校",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "卻沒有穿制服？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那是因為……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂，",
    "voice": "vo_adv_9006010_008",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "尾狗刀！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我要怎麼回答啊？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊，",
    "voice": "vo_adv_9006010_009",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "因為我回家",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "換過衣服了呀！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "稍微想一下就知道了吧？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嘿嘿！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哦，",
    "voice": "vo_adv_9006010_010",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "對了。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "因為今天是我第一次遇見你的紀念日呀。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我想說見一面也好，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就過來了。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯？",
    "voice": "vo_adv_9006010_011",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是新年的時候嗎？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "從你的角度來看是這樣啊。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "算了，",
    "voice": "vo_adv_9006010_012",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "別在意那種小細節啦。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n晶的公主騎……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂，",
    "voice": "vo_adv_9006010_013",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "尾狗刀！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你從剛才開始就一直在幹嘛呀！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我話才講到一半耶。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "呃，",
    "voice": "vo_adv_9006010_014",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這個也不能講的嗎？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊啊……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這樣很無聊耶！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯？",
    "voice": "vo_adv_9006010_015",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喔，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我只是在講電話啦。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "難道你是在擔心我嗎？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你還真是個",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "老好人呢。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊～",
    "voice": "vo_adv_9006010_016",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "知道了知道了！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我要回去了啦！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我的搭檔囉囉嗦嗦嘮嘮叨叨的",
    "voice": "vo_adv_9006010_017",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "，我要走了。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "反正也見到你了！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那就這樣，",
    "voice": "vo_adv_9006010_018",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "下次見囉！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我在阿斯特朗傳奇",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "等你哦！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}走掉後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510240"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "算了，",
    "voice": "vo_adv_9006010_019",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "今天就先這樣吧。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "距離第一次戰鬥到現在已經這麼久了啊。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "唉……",
    "voice": "vo_adv_9006010_020",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "什麼叫「今天就先這樣」啊，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "諾維姆。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n萬一我們的真實身分暴露了怎麼辦啊。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n做事之前多想想吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊哈哈哈，",
    "voice": "vo_adv_9006010_021",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "抱歉抱歉。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "尾狗刀你自己也很好奇的吧？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "晶的公主騎士……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在你看來，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "明明諾維姆的樣子",
    "voice": "vo_adv_9006010_022",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "這麼可疑卻絲毫沒有動搖……",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n要麼是個厲害的大人物，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "要麼只是",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "很遲鈍。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "嗯，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "他應該屬於後者吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "怎麼樣？",
    "voice": "vo_adv_9006010_023",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n只是聊聊幾句",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "就心滿意足了嗎？",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯。",
    "voice": "vo_adv_9006010_024",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我好像有點知道",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "為什麼晶會對他這麼熱衷了。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但",
    "voice": "vo_adv_9006010_025",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我是不會客氣的！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "下次見面時，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "贏的一定是我們！！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "唉，",
    "voice": "vo_adv_9006010_026",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "雖然嘴上這麼說但輸得很慘的也是我們啦。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "那麼，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "今天打算做什麼？",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那還用說嗎？",
    "voice": "vo_adv_9006010_027",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "當然是登入",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "阿斯特朗傳奇呀，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "搭檔！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "好好好，",
    "voice": "vo_adv_9006010_028",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "我就知道妳要這麼說。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "那我們今天也",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "好好加油吧。",
    "voice": null,
    "unit_id": 106231
  }
]
