[
  {
    "type": "background",
    "bg_id": "500093"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "同一時間。為了救出被囚禁的貪吃佩可，\\n{0}和可可蘿朝著『王宮』的內部，頭也不回的前進。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請您退下，",
    "voice": "vo_adv_2011002_000",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n嘿！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "你、",
    "voice": "vo_adv_2011002_001",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "你們是？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n入侵者……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "唔，嘎呀啊！？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼……",
    "voice": "vo_adv_2011002_002",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "【拉比林斯】的大家",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所採取的誘餌作戰奏效了，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n『王宮』內部",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的守備變得相當地薄弱了呢。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "即使如此還是配置著最低限度人員的樣子，",
    "voice": "vo_adv_2011002_003",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然仍不得鬆懈……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但如果只是這種程度，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只靠在下也能夠應付。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "咕、",
    "voice": "vo_adv_2011002_004",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "咕嗚……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n你們、",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "究竟是誰？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "來『王宮』！　",
    "voice": "vo_adv_2011002_005",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "想要和整個國家作對嗎？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "愚蠢之徒！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n你們這種傢伙的下場一定",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "會很悲慘……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "呃嘎呀！？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "安靜一點。",
    "voice": "vo_adv_2011002_006",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n若鬧出了騷動，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "導致警備的人們一擁而上可就傷腦筋了。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就讓此人和剛才擊倒的",
    "voice": "vo_adv_2011002_007",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "其他警備人員一樣，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n用布塞住嘴巴……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n總之，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "讓他先坐在這裡吧。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "每一位維持警備的",
    "voice": "vo_adv_2011002_008",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "【王宮騎士團】團員，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不曉得為何",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都戴著遮掩住顏面的頭盔。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "從遠處看起來，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "大概只會被人當成是在偷懶打盹而已。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "儘管只能稍微爭取到一些時間……",
    "voice": "vo_adv_2011002_009",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "他們",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過就是貫徹自己的勤務而已，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "奪走他們性命的話",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "實在會過意不去呢。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_2011002_010",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n得到了主公大人的肯定，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下便安心了許多。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只要和主公大人同心的話，",
    "voice": "vo_adv_2011002_011",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下便能夠",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "毫無迷惘地向前邁進。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_2011002_012",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n您說得沒錯，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如今是",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "分秒必爭、十萬火急的事態……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一秒也好，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "得盡速將貪吃佩可小姐給順利救出來才行。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要想東想西的話，",
    "voice": "vo_adv_2011002_013",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "留到事後也不遲。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請牽好在下的手，",
    "voice": "vo_adv_2011002_014",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在這前方有階梯，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "順著往下",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是『王宮』",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "惡名昭彰的地下監獄……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "以事前所獲得的情報來看，",
    "voice": "vo_adv_2011002_015",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那裡",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "應該就是貪吃佩可小姐被囚禁的場所了。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "此為願意伸出援手協助在下等人的，",
    "voice": "vo_adv_2011002_016",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那位似似花小姐",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所提供的情報，著實是幫了大忙。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "若非如此，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就可能得在這『王宮』內部",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來回奔波了呢。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "『王宮』的地下監獄",
    "voice": "vo_adv_2011002_017",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎主要是用來收容政治犯，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是警備相當嚴峻，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "幾乎脫逃無望",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的牢房……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "聽說是這樣子的。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就算能夠抵達監獄，",
    "voice": "vo_adv_2011002_018",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n要將貪吃佩可小姐從牢房中救出，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "又得耗費一番工夫。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總之如果有守衛坐鎮，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就將對方擊倒再奪走鑰匙，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然是這樣子盤算的。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但如果沒有守衛，",
    "voice": "vo_adv_2011002_019",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "或",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "面臨無法成功取得鑰匙的情況……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就請主公大人以您的能力，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "將在下",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的力量強化至極限。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "儘管有些亂來，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但也只能靠蠻力破壞牢房了。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然在下也認為這是場勝算不高的賭注，",
    "voice": "vo_adv_2011002_020",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n卻也沒有其他更好的計畫了。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不管如何，",
    "voice": "vo_adv_2011002_021",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還是得盡早抵達牢房……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哇呀！？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "still",
    "still_id": "201100201"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……。",
    "voice": "vo_adv_2011002_022",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請您提高警覺，",
    "voice": "vo_adv_2011002_023",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n往下層的樓梯前方，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n有位看起來很強的人守著。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……看來那位，",
    "voice": "vo_adv_2011002_024",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是抵達牢房前的",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "最後一道難關了呢。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……咦？",
    "voice": "vo_adv_2011002_025",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呃，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那是主公大人認識的人嗎？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您的人脈真的很廣呢，",
    "voice": "vo_adv_2011002_026",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這是再好也不過了。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如果是主公大人您的朋友，",
    "voice": "vo_adv_2011002_027",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在說明過事情的來龍去脈後，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "或許能免於一戰。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……是誰在那？",
    "voice": "vo_adv_2011002_028",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……咦？",
    "voice": "vo_adv_2011002_029",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "明明都已經竭盡所能",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不動聲色的進行移動了，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在這種距離卻仍被察覺到了！　",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是位相當敏銳的人呢。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "怎麼辦呢？",
    "voice": "vo_adv_2011002_030",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n如果是主公大人的朋友的話，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n是否該坦然地",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "面對面試著說服對方……？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是入侵者嗎？",
    "voice": "vo_adv_2011002_031",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n沒辦法了，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然守衛並非我的本業。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還是得遵從命令，",
    "voice": "vo_adv_2011002_032",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "將所有接近這個地下監獄的人就地解決。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n希望你別怨恨我呢，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "畢竟這是我的職責。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "still",
    "still_id": "end"
  }
]
