    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n請準備接招吧，",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "接下我們的愛與希望……♪",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗靜流",
    "words": "牠看起來似乎還打算繼續抵抗。",
