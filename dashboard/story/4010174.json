  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "{0}主人……",
    "voice": "vo_adv_4010174_000",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "約定碰面這件事",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真是令人內心雀躍呢。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "而且",
    "voice": "vo_adv_4010174_001",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "又是在自己生日的時候，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n連等待的時間",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "都像是美好的禮物般……♪",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不會，",
    "voice": "vo_adv_4010174_002",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您是",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "我的主人。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "要是您先到了，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "我反而會感到困擾。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "而且……",
    "voice": "vo_adv_4010174_003",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "從遠處過來的您，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在看到我時",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "微笑的那一瞬間。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "我就是",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "想看到那個。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "謝謝您，",
    "voice": "vo_adv_4010174_004",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人……♪",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您還像這樣準備了給我的禮物，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "我真的",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "感到很幸福……！",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……那個。",
    "voice": "vo_adv_4010174_005",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n都讓您為我慶祝，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "還送禮了。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "我又要做出這種請求的話，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "實在是有些惶恐……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "可以將您今天一整天的時間",
    "voice": "vo_adv_4010174_006",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "都給我嗎？",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您",
    "voice": "vo_adv_4010174_007",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "如此忙碌，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n我知道這請求",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "過於奢侈了……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真的嗎……！？",
    "voice": "vo_adv_4010174_008",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "我",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真的可以",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這麼幸福嗎……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "那麼，",
    "voice": "vo_adv_4010174_009",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n今天的我",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "可能會有些任性……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n還請您",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "多加擔待了……♪",
    "voice": null,
    "unit_id": 105931
  }
]
