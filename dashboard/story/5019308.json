    "words": "欸！　",
    "voice": "vo_adv_5019308_000",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為下雨看不清前面耶～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雨吉",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "未免也太拚了吧！？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "各位，",
    "voice": "vo_adv_5019308_001",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "請小心不要讓身體著涼了？",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "難得的暑假，",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "要是感冒就不好了。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "伊緒真是的，",
    "voice": "vo_adv_5019308_002",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "現在的狀況還提什麼感冒啦。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "身為一名成熟的淑女，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n就讓我來教教雨吉什麼叫作禮儀吧！！",
    "voice": null,
    "unit_id": 110211
  }
]
