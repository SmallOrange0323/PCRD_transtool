  {
    "type": "dialogue",
    "name": "旁白",
    "words": "由於拉菲的魔法效果，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n依里和茜里陷入前所未有的窘境。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "呃、",
    "voice": "vo_adv_5048002_000",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "咦咦？",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "怎麼會這樣？",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "沒、",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "沒看過這種效果啊！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "使用手冊裡面……",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "也沒有相關說明……",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "咦？",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "咦？",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "不會吧？",
    "voice": "vo_adv_5048002_001",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我就這樣被變成茜里？",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "這這、",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "這下該怎麼辦啊……！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "喔～",
    "voice": "vo_adv_5048002_002",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "這就是姊姊的身體嗎。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n雖然纖細到有點缺乏安全感，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "不過感覺還不賴嘛♪",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "欸，拉菲！",
    "voice": "vo_adv_5048002_003",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "妳都做了些什麼呀！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n這魔法完全失敗了吧！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "呃，",
    "voice": "vo_adv_5048002_004",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "妳、",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "妳放心，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "這不是失敗啦！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n這只是……",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "對了，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "是故意的！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我本來就是要施展這樣的魔法啦！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那、",
    "voice": "vo_adv_5048002_005",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那只是為防萬一，稍微確認一下而已……",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "咦？",
    "voice": "vo_adv_5048002_006",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那、",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那是祕密！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n天使的魔法都是企業機密，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "不能隨便地",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n洩漏給其他人！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "總、",
    "voice": "vo_adv_5048002_007",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "總而言之！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "這絕對不是什麼失敗！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n依里接下來",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "一定能得到幸福才對！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n因為拉菲我可是名資優生天使！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那、",
    "voice": "vo_adv_5048002_008",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那麼我差不多該去巡邏了，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "先走一步囉～！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "咦，",
    "voice": "vo_adv_5048002_009",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "拉菲？",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "喂！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "妳不要走！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "吼唷真是的，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "又被她給逃了……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "這下該怎麼辦啊！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "先放輕鬆吧，",
    "voice": "vo_adv_5048002_010",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "姊姊。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "現在再追也追不上她的。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "話說回來",
    "voice": "vo_adv_5048002_011",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "我們竟然身心互換了！",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n那個小女孩",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "還真的是個天使呢。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "這種漫畫情節般的事",
    "voice": "vo_adv_5048002_012",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "以後應該一輩子都碰不上了，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "我們就好好享受這難得的體驗吧！",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "……這種情況下還有辦法這麼說，",
    "voice": "vo_adv_5048002_013",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我真是服了妳耶。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "不過",
    "voice": "vo_adv_5048002_014",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "這就是我跟茜里的差異吧。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n無論何時都不悲觀，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "帶著勇氣積極行動。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "真羨慕她這樣的個性……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "對了，",
    "voice": "vo_adv_5048002_015",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "既然變成了茜里的外貌，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n那麼我好歹也該",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "讓自己進步一些。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "茜里，",
    "voice": "vo_adv_5048002_016",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "假設接下來還得身體互換一陣子，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n妳有什麼能讓我們渡過難關的好點子嗎？",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "嗯？",
    "voice": "vo_adv_5048002_017",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "關於這點……",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "幫我們想想♪",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "妳喔……",
    "voice": "vo_adv_5048002_018",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "哇～！",
    "voice": "vo_adv_5048002_019",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "哥哥真是好主意！",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "也、",
    "voice": "vo_adv_5048002_020",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "也對，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "畢竟接下來總不可能都不跟人接觸。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "……也就是說，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我得模仿茜里的一舉一動嗎！？",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "要我做出光是想像就快昏倒的",
    "voice": "vo_adv_5048002_021",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "那些發言和行為……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "不、",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "不行不行！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我死也辦不到啦～！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "……姊姊，",
    "voice": "vo_adv_5048002_022",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "妳排斥成這樣子，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n實在讓茜里有點受傷耶。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "嗚……",
    "voice": "vo_adv_5048002_023",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "對、",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "對不起。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "可是啊，",
    "voice": null,
    "unit_id": 113712
  },
  {
