    "name": "未央",
    "words": "第二次搞不好就會更熟練了對吧？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n同樣的道理，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "到了第十次搞不好就會成功了。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "所以，",
    "voice": "vo_adv_1126002_048",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我打算盡自己所能多嘗試幾次。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "妳想嘛，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "一旦喜歡上了就",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "沒辦法輕易放棄的！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "…………",
    "voice": "vo_adv_1126002_049",
    "unit_id": 1211
  },
  {
    "type": "background",
    "bg_id": "500131"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真的",
    "voice": "vo_adv_1126002_050",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "到這裡就可以了嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "是的，",
    "voice": "vo_adv_1126002_051",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "沒問題的。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "\\n多虧你們我前進了不少，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "真是非常感謝。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "……那個，",
    "voice": "vo_adv_1126002_052",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "未央小姐。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "雖然我還沒有決定",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "是否要再以偶像為目標……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "不過我會試著",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "重新考慮看看的。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "那麼，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "我先告辭了。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "嗯！　",
    "voice": "vo_adv_1126002_053",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "如果妳決定要再努力一次的話，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "就一起加油吧！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "掰掰～！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個，",
    "voice": "vo_adv_1126002_054",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "未央小姐。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下能夠問妳一件事嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n妳似乎很支持那位小姐",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "成為偶像呢……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如此一來，",
    "voice": "vo_adv_1126002_055",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "妳的對手可是會增加的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "即使如此也沒關係嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "嗯～",
    "voice": "vo_adv_1126002_056",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這個嘛，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "雖然可蘿可蘿說的是事實。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "不過撇開那個不談，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我只是單純",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "想為她加油打氣而已。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "因為她",
    "voice": "vo_adv_1126002_057",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "是有著和我一樣夢想的同伴嘛！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "遙望著女性冒險者離去的方向，",
