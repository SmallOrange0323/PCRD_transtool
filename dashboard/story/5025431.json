  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "但萬聖節今天就結束了――",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "為什麼妳會感覺有點可惜呢？",
    "voice": "vo_adv_5025431_001",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我是想早點回去的啊……",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "鏡華，",
    "voice": "vo_adv_5025431_002",
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "從半途開始",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "感覺就不那麼害怕了呢！",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "怕鬼的症狀已經好了嗎～",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "人、",
    "voice": "vo_adv_5025431_003",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "人家",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "一開始就不怕啦！",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "別說那些了，",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "到最後都不要鬆懈哦！",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "要回去開個快樂的萬聖節派對才行！",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "欸嘿嘿～",
    "voice": "vo_adv_5025431_004",
    "unit_id": 111311
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 111311
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "我想快點回去，",
    "voice": null,
    "unit_id": 111311
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "吃好吃的點心呢～",
