    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "もしいただけるのであれば、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n【メルクリウス財団】で栽培したいですわね。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "花屋へ卸したり、",
    "voice": "vo_adv_6054104_001",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "イベントを企画したり……",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "『愛を応援する』というコンセプトで、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "ビジネスを立ち上げますわ！",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "その時は",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "あなたさまも協力してくださると、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "私もうれしいのですけれど。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "ええ！　",
    "voice": "vo_adv_6054104_002",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "愛をこめて、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "育てて増やしますの。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "そうですわ、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "二人で新種を作ってみるのはいかがでしょうか！？",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "あなたさまとなら、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "キレイな花を咲かせられますわ♪",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "そういうことでしたら、",
    "voice": "vo_adv_6054104_003",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "私が花束にしてお贈りいたしますわ！",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "百でも千でも足りません、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "万の想いを込めて♪",
    "voice": null,
    "unit_id": 114411
  }
