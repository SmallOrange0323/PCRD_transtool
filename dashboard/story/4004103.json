  },
  {
    "type": "dialogue",
    "name": "迷你機械莉瑪",
    "words": "莉瑪莉瑪……",
    "voice": null,
    "unit_id": 11311
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呀啊啊啊！",
    "voice": "vo_adv_4004103_005",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n這次是開始出現一堆小小的分身～！？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請冷靜下來！",
    "voice": "vo_adv_4004103_006",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "　那個並不是莉瑪小姐！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這一定是，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "故意要讓我們以它們為敵，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n而本體",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "打算趁這段時間恢復的手段吧。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一般的方法不太行得通呢～？",
    "voice": "vo_adv_4004103_007",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果覺得因為這樣能逃掉的話可就大錯特錯了，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n讓它知道我們的厲害吧☆",
    "voice": null,
    "unit_id": 105811
  }
