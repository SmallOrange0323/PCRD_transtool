  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　等等，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那傢伙的動作很奇怪唷！",
