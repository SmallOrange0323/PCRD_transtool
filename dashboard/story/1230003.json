  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "愛梅斯在對話中想起，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}為了挺身對抗霸瞳皇帝，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而回到夥伴身邊時的事。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
