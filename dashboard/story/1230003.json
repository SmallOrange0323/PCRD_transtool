    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是辦得到的，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但我現在忙不過來，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒辦法處理這件事啊……",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "咦咦！？",
    "voice": "vo_adv_1230003_049",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那種事",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "能辦到嗎……！？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要是我的想法正確的話啦。",
    "voice": "vo_adv_1230003_050",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "關於修正那方面的事，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我在那邊也算是有打算進行各種對策……",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不過真的很抱歉啊。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……事到如今，沒關係了啦。",
    "voice": "vo_adv_1230003_051",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "比起我，妳現在還是設法",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "幫那傢伙和大家吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我的事當作附帶的就好。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，",
    "voice": "vo_adv_1230003_052",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要是……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我哪一天能自由行動了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我想跟那傢伙一起去四處看看，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n去哪都行。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我覺得……",
    "voice": "vo_adv_1230003_053",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果是那傢伙，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就會連我的願望也實現的吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "畢竟，如果能被拯救，",
    "voice": "vo_adv_1230003_054",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n比起被女王拯救，我更偏好騎士嘛。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "說的也是啊。",
    "voice": "vo_adv_1230003_055",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……如果是少年，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "一定能實現的。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "現在先守望著少年所決定的未來，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "直到最後吧。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是啊……",
    "voice": "vo_adv_1230003_056",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果是那傢伙，一定能辦到的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n因為他至今",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也是不論幾次都會再度振作起來。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以一定",
    "voice": "vo_adv_1230003_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要帶我們過去喔，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "到達幸福結局，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "到達那個在另一邊的世界──",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……我們也聊過那種事呢。",
    "voice": "vo_adv_1230003_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……欸，",
    "voice": "vo_adv_1230003_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我說你啊，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我的……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……沒什麼。",
    "voice": "vo_adv_1230003_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你有沒有其他想看的東西？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n操作方法我會教你的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你就自己找找看吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "現在能像這樣",
    "voice": "vo_adv_1230003_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "跟{0}度過平靜的時光，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就好了吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不用焦急，",
