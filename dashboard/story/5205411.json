  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呼……",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "這是第幾次了？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "紡希妳總是因為一些無趣的小事而找本小姐單挑。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呼、",
    "voice": "vo_adv_5205411_001",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呼……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這是第幾次了呢？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "華音妳老是因為一些無聊的事情而跟我吵架。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "什麼無聊的事情！？",
    "voice": "vo_adv_5205411_002",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "是因為妳說妳那邊的世界下次要舉辦慈樂之音演唱會，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n本小姐才想說",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "要親自登台站在中央幫妳們表演耶！？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳是說我一秒拒絕掉妳的這個判斷很無趣嗎！？",
    "voice": "vo_adv_5205411_003",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "如果妳說妳無論如何都要出場的話，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n那我當然是不惜跟妳打一架",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "也要阻止妳啊！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……無論如何都不行嗎？",
    "voice": "vo_adv_5205411_004",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就算妳稍微裝可愛地說也不行。",
    "voice": "vo_adv_5205411_005",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "那麼就只能靠決鬥來解決了！",
    "voice": "vo_adv_5205411_006",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳以為決鬥贏了就能出場嗎！？",
    "voice": "vo_adv_5205411_007",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哦～",
    "voice": "vo_adv_5205411_008",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呵呵呵♪",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n乖乖認命讓本小姐參加慈樂之音演唱會吧～！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n本小姐是不會放棄的～～～～～♪",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我受夠這個人了──！",
    "voice": "vo_adv_5205411_009",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n好想快點回去蘭德索爾～～～！",
    "voice": null,
    "unit_id": 134812
  }
]
