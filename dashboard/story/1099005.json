  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某日，{0}來到佈告欄前想要承接委託工作。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n此時正好看到愛蜜莉雅跟一個小妹妹在一起。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "或許是我多管閒事，",
    "voice": "vo_adv_1099005_000",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n但妳的爸爸或媽媽沒有跟妳一起嗎？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "難道說",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "是跟他們走散了……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "哼嗚……",
    "voice": "vo_adv_1099005_001",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "我不知道……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "爸爸",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "跟媽媽都不見了……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "嗚哇啊啊啊～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那個，",
    "voice": "vo_adv_1099005_002",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那個，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "妳別哭喔？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "大姐姐帶妳一起去找爸爸媽媽。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n相信一定很快",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "就會找到他們的……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "究竟",
    "voice": "vo_adv_1099005_003",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "是在哪裡走散的呢。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n人看起來好像也不在附近，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "{0}！好像是呢。",
    "voice": "vo_adv_1099005_004",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我想帶她一起去找爸爸媽媽，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "可是她一直哭……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n也不知道該去哪裡找才好。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "她一定很不安呢……",
    "voice": "vo_adv_1099005_005",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "要是一直這樣子哭下去，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "肯定也會累壞的。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "總之得先想辦法",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "讓她平靜下來才行！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你怎麼突然",
    "voice": "vo_adv_1099005_006",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "把臉遮起來？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n讓小孩子停止哭泣的絕招，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那個",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "是什麼……？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "噗、",
    "voice": "vo_adv_1099005_007",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "呵呵……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "什麼呀，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "突然做出那種奇怪的表情……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "呵呵呵！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "……啊哈哈，",
    "voice": "vo_adv_1099005_008",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "好怪的臉喔～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "\\n啊哈、",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "啊哈哈哈哈♪",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "馬上就破涕為笑了……",
    "voice": "vo_adv_1099005_009",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你的絕招",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "還真厲害呢！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你要用那枚硬幣做什麼？",
    "voice": "vo_adv_1099005_010",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "握住硬幣，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "再把手張開……？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "哇，",
    "voice": "vo_adv_1099005_011",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "原本應該被握在手裡的硬幣不見了！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n怎麼會？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "哇，",
    "voice": "vo_adv_1099005_012",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "好厲害好厲害～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "剛才那個",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "是怎麼變的？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "教教我教教我～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那應該",
    "voice": "vo_adv_1099005_013",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "也不是魔法吧？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "好厲害！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "教教我教教我！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那個，",
    "voice": "vo_adv_1099005_014",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "妳說妳在追蝴蝶，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "結果就跟媽媽他們走散了呀。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n妳還記得你們是從哪邊來的嗎？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "我不知道……",
    "voice": "vo_adv_1099005_015",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯～",
    "voice": "vo_adv_1099005_016",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "該怎麼辦才好呢？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n這附近我又不太熟悉，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n漫無目的地到處亂跑",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "肯定是找不到人的……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咦，{0}，",
    "voice": "vo_adv_1099005_017",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你剛才跑去哪裡了？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n打聽情報……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你是說",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "這孩子的情報？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "原來如此。",
    "voice": "vo_adv_1099005_018",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "就算這孩子不記得，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n或許附近的人",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "有看到她從哪裡來也說不定呢。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "可以一起的話就太～好了，",
    "voice": "vo_adv_1099005_019",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n但是你也有自己的事要忙吧……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "沒有問題嗎？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "要優先幫助有困難的人……",
    "voice": "vo_adv_1099005_020",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那我們",
    "voice": "vo_adv_1099005_021",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "就一起去找人吧！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "為了不要再走散，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我們三個手牽著手，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "女性攤商",
    "words": "啊啊，",
    "voice": "vo_adv_1099005_022",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性攤商",
    "words": "我記得這個孩子。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性攤商",
    "words": "\\n我當時想說她那樣子跑有點危險，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性攤商",
    "words": "所以對她有印象。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性攤商",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性攤商",
    "words": "沒記錯的話，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性攤商",
    "words": "她應該是從那邊那個轉角過來的。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "雜貨店的男性",
    "words": "哦，",
    "voice": "vo_adv_1099005_023",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "雜貨店的男性",
    "words": "又在幫走失兒童找爸媽啦？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "雜貨店的男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "雜貨店的男性",
    "words": "這麼說起來，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "雜貨店的男性",
    "words": "我剛才有看到一對男女經過，似乎是在找走失的孩子。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "雜貨店的男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "雜貨店的男性",
    "words": "後來他們順著這條路直直地往前過去了，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "雜貨店的男性",
    "words": "你們去看看吧。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "蔬果店的太太",
    "words": "啊啊，",
    "voice": "vo_adv_1099005_024",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "蔬果店的太太",
    "words": "這孩子的父母",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "蔬果店的太太",
    "words": "不久前有來找我打聽，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "蔬果店的太太",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "蔬果店的太太",
    "words": "不過聽他們說接下來要去市中心那邊找人喔！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接著又找了一段時間後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "走失兒童的母親",
    "words": "啊啊，",
    "voice": "vo_adv_1099005_025",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "走失兒童的母親",
    "words": "太好了……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "走失兒童的母親",
    "words": "總算找到人了……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "走失兒童的母親",
    "words": "\\n真是太好了……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "走失兒童的父親",
    "words": "感謝你們",
    "voice": "vo_adv_1099005_026",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "走失兒童的父親",
    "words": "好心幫忙。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "走失兒童的父親",
    "words": "\\n真不知道該怎麼答謝你們才好……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "走失兒童的父親",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "走失兒童的父親",
    "words": "你們有什麼要求嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "走失兒童的父親",
    "words": "只要是我能做到的，什麼事都行！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "這孩子",
    "voice": "vo_adv_1099005_027",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "當時看起來非～常地無助呢。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n我們只是",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "做了應該做的事而已。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "爸爸，",
    "voice": "vo_adv_1099005_028",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "迷路的女孩",
    "words": "人家肚子餓了！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "走失兒童的父親",
    "words": "哈哈，",
    "voice": "vo_adv_1099005_029",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "走失兒童的父親",
    "words": "跟著大哥哥大姐姐一直走，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "走失兒童的父親",
    "words": "讓妳肚子餓扁了嗎。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "走失兒童的父親",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "走失兒童的父親",
    "words": "好，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "走失兒童的父親",
    "words": "那我們今天就去吃好料吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "能夠順利找到人真是太好了。",
    "voice": "vo_adv_1099005_030",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "辛苦你了。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n結果",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "又受你關照了呢。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不但陪我一起找那孩子的父母，",
    "voice": "vo_adv_1099005_031",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "還幫忙打聽情報……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "對了，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "剛才我聽到人家說你「又在幫走失兒童找爸媽」，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n莫非",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你平時就常常幫助走失兒童？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "果然！",
    "voice": "vo_adv_1099005_032",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n{0}你真的好～溫柔喔。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n難怪大家也都很喜歡你。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "一般人",
    "voice": "vo_adv_1099005_033",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "遇到走失兒童通常只會當作沒看到，",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n就算出手幫忙，收人家的謝禮也是合情合理才對。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "像你這樣與其說是體貼，",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "不如說是濫好人？",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "帕克！",
    "voice": "vo_adv_1099005_034",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "哎呀哎呀。",
    "voice": "vo_adv_1099005_035",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n多謝你幫忙照顧走失兒童跟莉雅喔。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "你可能也注意到了，",
    "voice": "vo_adv_1099005_036",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "她又像上次一樣跟我說",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n要證明「一個人也能好好自立」",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "了呢。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "結果我午睡醒來，",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "就發現她帶著走失兒童不知道怎麼辦，多虧有你幫忙。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "不過這種平易近人的感覺……！",
    "voice": "vo_adv_1099005_037",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n你的體貼，",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "不，",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "你的濫好人程度",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "跟莉雅不相上下喔～",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "帕克",
    "voice": "vo_adv_1099005_038",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你真是的。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我才不是什麼濫好人呢──",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "女性的聲音",
    "words": "呀～！",
    "voice": "vo_adv_1099005_039",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "女性的聲音",
    "words": "搶劫啊～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "一聽到尖叫就跑過去了。",
    "voice": "vo_adv_1099005_040",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "莉雅妳打算怎麼做？",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我們也過去吧！",
    "voice": "vo_adv_1099005_041",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "帕克，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "跟我來！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "是是是～",
    "voice": "vo_adv_1099005_042",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "……這兩個人果然都是濫好人呢。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "給我站住──！",
    "voice": "vo_adv_1099005_043",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "搶匪",
    "words": "嘖，",
    "voice": "vo_adv_1099005_044",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "搶匪",
    "words": "再怎麼跑她都緊追不捨！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "搶匪",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "搶匪",
    "words": "那個半途就不見的小子應該是跟不上了，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "搶匪",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "搶匪",
    "words": "再來只要甩掉這個銀髮女就好！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "搶匪",
    "words": "讓妳瞧瞧終點前１化朗跑22秒的",
    "voice": "vo_adv_1099005_045",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "搶匪",
    "words": "尾段加速！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "搶匪",
    "words": "什麼……",
    "voice": "vo_adv_1099005_046",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "搶匪",
    "words": "這小子",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "搶匪",
    "words": "竟然繞到前頭了！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "搶匪",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "搶匪",
    "words": "但還是太天真啦！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "搶匪",
    "words": "我只要強行突破後面那個女人就行啦！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "休想得逞！",
    "voice": "vo_adv_1099005_047",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n帕克，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "拜託你了！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "好～的，",
    "voice": "vo_adv_1099005_048",
    "unit_id": 2611
  },
  {
