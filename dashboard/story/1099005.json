    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有什麼活躍表現吧。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "{0}，今天很謝謝你，",
    "voice": "vo_adv_1099005_083",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "能夠看到好多人喜悅的表情，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我覺得很開心。",
    "voice": null,
    "unit_id": 109911
  },
  {
