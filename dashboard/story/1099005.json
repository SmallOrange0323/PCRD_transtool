  {
    "type": "dialogue",
    "name": "餐廳的店長",
    "words": "你們就收下吧。",
    "voice": "vo_adv_1099005_072",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "餐廳的店長",
    "words": "這個是我",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "餐廳的店長",
    "words": "希望你們收下才給你們的。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "餐廳的店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "餐廳的店長",
    "words": "如果能幫你們今天的晚餐",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "餐廳的店長",
    "words": "加點菜，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "餐廳的店長",
    "words": "我也會很開心的。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "啊，",
    "voice": "vo_adv_1099005_073",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "他走掉了。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "能夠讓他開心真是太好了。",
    "voice": "vo_adv_1099005_074",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "{0}看來也是跟我一樣的想法，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "就更不必說了。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不過",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "照這麼看來，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "或許真的被帕克說中了。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "肉舖的店長",
    "words": "喂～",
    "voice": "vo_adv_1099005_075",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "肉舖的店長",
    "words": "小哥！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "肉舖的店長",
    "words": "你來得正好！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "肉舖的店長",
    "words": "\\n我有點事想請你幫忙！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "麵包店的老闆娘",
    "words": "肉舖那邊結束後，",
    "voice": "vo_adv_1099005_076",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "麵包店的老闆娘",
    "words": "也來我們這裡幫個忙好嗎！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "麵包店的老闆娘",
    "words": "\\n送貨的人手不夠啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "哇，",
    "voice": "vo_adv_1099005_077",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "又有人來委託工作了。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n真的非～常受歡迎呢……！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "background",
    "bg_id": "500111"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，到了黃昏時分，兩人捧著滿滿的謝禮",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n回到了咲戀育幼院。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "大街上店家的招牌烤肉串、",
    "voice": "vo_adv_1099005_078",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "肉舖的頂級培根、",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n麵包店剛出爐的長棍麵包，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還有蔬果店的馬鈴薯",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "跟番茄……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n這麼大量的東西，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真虧你們兩個有辦法拿回來呢。",
