[
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "墓場の魔物は、",
    "voice": "vo_adv_5007303_000",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "全部やっつけてやったの。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "きっとここにジャックの手掛かりがあるはずなの！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "でもドクロ親父は、",
    "voice": "vo_adv_5007303_001",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "ここは霊界に繋がってるって言ってたの。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\nこの先はすっごく危険かもしれないの……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "それでも",
    "voice": "vo_adv_5007303_002",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "ミヤコはシノブを助けたいの！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\n早く行かなくちゃなの～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "わあっ！　",
    "voice": "vo_adv_5007303_003",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "急になにか光りだしたの！？",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "とっても怖いの……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "でも負けないの！　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "ミヤコ",
    "words": "進むの～！！",
    "voice": null,
    "unit_id": 108211
  }
]
