[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了參加瑪爾傑海岸的海灘開放日，\\n珠希和{0}一起來到了海邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "今天天氣真好啊喵～！",
    "voice": "vo_adv_1079001_000",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "趕緊開始做準備吧喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "說的對，",
    "voice": "vo_adv_1079001_001",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "到了海邊就要好好做一下熱身運動才行……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那背後就麻煩你了喵～",
    "voice": "vo_adv_1079001_002",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "才不是呢喵！",
    "voice": "vo_adv_1079001_003",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們才不是來這裡玩的喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "說到海灘開放日，",
    "voice": "vo_adv_1079001_004",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "當然是海邊攤位的小吃啊喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我的目標可是要在那邊擺起鯛魚燒的攤位喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "把好吃的鯛魚燒全部大賣特賣給客人，",
    "voice": "vo_adv_1079001_005",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我要在這夏天大賺一筆啦喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "要是能賣很多出去，",
    "voice": "vo_adv_1079001_006",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我也可以請{0}吃美味的鯛魚燒哦喵～",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "所以，",
    "voice": "vo_adv_1079001_007",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "準備工作就好好交給你了喵～！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯？",
    "voice": "vo_adv_1079001_008",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "海灘開放日的主辦人好像在說些什麼喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n離活動開始還有一點時間，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "是有什麼事情喵？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "正在為海灘開放日做準備的大家！",
    "voice": "vo_adv_1079001_009",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "大事不好了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "沙灘排球大賽所使用的排球網，",
    "voice": "vo_adv_1079001_010",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n從今天早上開始就一直找不到了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "由於置放的地方凌亂不堪，",
    "voice": "vo_adv_1079001_011",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n很有可能是被什麼人給偷走了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "欸～！？",
    "voice": "vo_adv_1079001_012",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "為什麼要偷走那種東西啊喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "每年，",
    "voice": "vo_adv_1079001_013",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "沙灘排球大賽的氣氛最為熱烈，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n要說是海灘開放日時最受矚目的活動也不為過呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "這樣下去",
    "voice": "vo_adv_1079001_014",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "活動就不得不中止進行了……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那，",
    "voice": "vo_adv_1079001_015",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那可就麻煩了喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們可是為了今天都已經做足了準備的耶！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "沒錯，就是這樣！",
    "voice": "vo_adv_1079001_016",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "為了能讓大家的活動順利圓滿，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n拜託各位了，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "請幫我們找出偷走排球網的犯人！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "能在活動開始之前找出犯人的人，",
    "voice": "vo_adv_1079001_017",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "也會支付相應酬勞的！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "酬、",
    "voice": "vo_adv_1079001_018",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "酬勞！？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這可又是一個大撈一筆的機會啊喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我們兩個，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "一起抓出犯人找回排球網吧喵～！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "首先，",
    "voice": "vo_adv_1079001_019",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "從這附近的人先打聽一下狀況喵～",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n走吧，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們先來取得有用的情報吧喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "在搜集到的情報之中，",
    "voice": "vo_adv_1079001_020",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "最令人可疑的地方，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n就是當地最出名的地痞流氓了喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "肯定是想藉偷走排球網，",
    "voice": "vo_adv_1079001_021",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "當作無聊的夏日英勇事跡講述吧，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n真是一群無藥可救的傻子喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "啊？",
    "voice": "vo_adv_1079001_022",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "說什麼啊妳這傢伙！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "唉……",
    "voice": "vo_adv_1079001_023",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "果真就是一副不良份子的樣子……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n你該不會就是這附近的地痞流氓了喵？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "妳說誰是地痞流氓啊！",
    "voice": "vo_adv_1079001_024",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "啊？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "\\n又不是在地人一副裝模做樣的！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "\\n我現在馬上就把你們轟出去！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "喂！",
    "voice": "vo_adv_1079001_025",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "你這傢伙也想找麻煩嗎！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "\\n我要和那女人算帳，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "給我閃一邊去！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊，",
    "voice": "vo_adv_1079001_026",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你沒事吧喵！？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喂地痞流氓！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "為什麼要連他都撞倒呀喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不可原諒了喵！",
    "voice": "vo_adv_1079001_027",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "待我把這傢伙給抓住了，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n一定要好好質問他偷走排球網的事喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵！",
    "voice": "vo_adv_1079001_028",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵、喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "讓你見識得意忘形的後果喵──！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "這、",
    "voice": "vo_adv_1079001_029",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "這女人",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "好強……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "還不能讓你們逃走呢喵──！",
    "voice": "vo_adv_1079001_030",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "唔呃呃……！",
    "voice": "vo_adv_1079001_031",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "我、",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "我錯了……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "是我輸了！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "\\n求妳別再扭我的手啦──！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "在這之前，有件事情想問一下喵。",
    "voice": "vo_adv_1079001_032",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "今天早上，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沙灘排球大賽用的排球網是不是你偷走的喵？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "我，",
    "voice": "vo_adv_1079001_033",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "我才沒有幹出那種事情！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "\\n搞不好是最近在海岸出沒的",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "魔物搞的鬼啊！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "坦白說，",
    "voice": "vo_adv_1079001_034",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "我聽說排球網被偷走是在今早，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "\\n那時我有看到魔物",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "在海岸邊行走啊！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "此話……",
    "voice": "vo_adv_1079001_035",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "當真喵？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你沒有騙我吧喵？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "無賴",
    "words": "我真的沒有騙妳！",
    "voice": "vo_adv_1079001_036",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴",
