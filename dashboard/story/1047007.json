[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真對不起，少年。",
    "voice": "vo_adv_1047007_000",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n讓你久等了呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我向職場……向【王宮騎士團】的據點，",
    "voice": "vo_adv_1047007_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n傳達了今天要請假的通知。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過由於要排隊等候通訊魔法，",
    "voice": "vo_adv_1047007_002",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n因此耗費了不少時間。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為我不會使用魔法，",
    "voice": "vo_adv_1047007_003",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這種時候就特別不方便呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "必須要逐一地與擁有會使用通訊魔法的術士",
    "voice": "vo_adv_1047007_004",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n的公會進行交涉、辦理程序才行。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "直接走到王宮，",
    "voice": "vo_adv_1047007_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n向他們傳達聯絡事項還比較快。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就像照相機一樣……",
    "voice": "vo_adv_1047007_006",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n如果有能邊走路，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n邊使用通訊魔法的道具的話，就方便多了",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但是無論在技術上或是法律上，都很困難吧。",
    "voice": "vo_adv_1047007_007",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n由於通訊魔法的使用上有些規範，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n難以在一般大眾中流行起來",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "陛下的方針……",
    "voice": "vo_adv_1047007_008",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n讓方便的技術或魔法，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n變得很難在民間普及化",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我想，若能變得更加方便，",
    "voice": "vo_adv_1047007_009",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n也會更易於人民生活吧……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "陛下應該有什麼深遠的想法吧，",
    "voice": "vo_adv_1047007_010",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n有些不滿但也沒有辦法呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "話說回來。",
    "voice": "vo_adv_1047007_011",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n謝謝你陪我到這裡，少年。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為我一直都只是佇立在王宮前面，",
    "voice": "vo_adv_1047007_012",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所以一直到現在，都還搞不太清楚城鎮的哪裡有些什麼呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "明明只是隨意說說，想要使用通訊魔法而已……",
    "voice": "vo_adv_1047007_013",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不只走了相當遠的路，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n也耗費了不少時間，我反省了一下。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "趕緊回到家後，",
    "voice": "vo_adv_1047007_014",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就要準備休息了喔。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯。",
    "voice": "vo_adv_1047007_015",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n在昨天的任務中所受的傷還沒有痊癒……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n也沒有緊急的工作，想要安靜的休養。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那麼重新說一次。",
    "voice": "vo_adv_1047007_016",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n受你關照了呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我不會忘記這份恩情的喔，少年。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵。",
    "voice": "vo_adv_1047007_017",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你真的，是個溫柔的好孩子呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不會擺架子，也不會強加己見於人，",
    "voice": "vo_adv_1047007_018",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n能夠親切待人。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "能夠在不經意中表現出體貼，",
    "voice": "vo_adv_1047007_019",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這是非常棒的事情。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "該說我總是很粗魯嗎，",
    "voice": "vo_adv_1047007_020",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n因為我很粗枝大葉……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "對於你的言行舉止感到欽佩，",
    "voice": "vo_adv_1047007_021",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n甚至覺得很羨慕。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我也想像你一樣喔。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哎呀，不小心就喋喋不休了呢……",
    "voice": "vo_adv_1047007_022",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n總覺得和你很好聊天，總不自覺的變得很開心。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "和我在一起很無聊吧，",
    "voice": "vo_adv_1047007_023",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我就趕快告退了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵。",
    "voice": "vo_adv_1047007_024",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n只要我說出消極的話，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你就會馬上鼓勵我呢……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我覺得，你就是這點很討人喜歡喔。",
    "voice": "vo_adv_1047007_025",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……哇？",
    "voice": "vo_adv_1047007_026",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n為、為什麼抓住我的手？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有什麼話想說嗎……少年？",
    "voice": "vo_adv_1047007_027",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦……",
    "voice": "vo_adv_1047007_028",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n嗯，我是這麼打算的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有什麼問題嗎。",
    "voice": "vo_adv_1047007_029",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n因為我並不是那麼細心，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n若有什麼奇怪的地方，希望你可以指出來。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有什麼想說的，可以儘管告訴我，少年",
    "voice": "vo_adv_1047007_030",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯。",
    "voice": "vo_adv_1047007_031",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你說，就這樣分開很寂寞，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不一起去玩嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "剛好也這個時間了，",
    "voice": "vo_adv_1047007_032",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n至少一起吃個午飯……是嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這倒是沒問題呢。",
    "voice": "vo_adv_1047007_033",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我也是，總覺得有點依依不捨。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只是我還受著傷，",
    "voice": "vo_adv_1047007_034",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n中的毒也還沒恢復……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不能太過勉強。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "若是要出遠門，",
    "voice": "vo_adv_1047007_035",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n或是進行激烈運動的話會有些困難。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "即使如此也沒關係嗎？",
    "voice": "vo_adv_1047007_036",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯。",
    "voice": "vo_adv_1047007_037",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那麼走吧，少年。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我對街上不太熟悉，",
    "voice": "vo_adv_1047007_038",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n希望你能為我導覽。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "能介紹你平常經常去遊玩的地方，",
    "voice": "vo_adv_1047007_039",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n或者是吃飯的地方給我就好了呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不對。",
    "voice": "vo_adv_1047007_040",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我是想知道關於你的事情，少年。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然，不應該與你有所牽扯的……",
    "voice": "vo_adv_1047007_041",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "一般來說，明明是該絕對服從上級命令的。",
    "voice": "vo_adv_1047007_042",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不知為何，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我對於要與你拉開距離的指令很反感啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好奇怪呢。",
    "voice": "vo_adv_1047007_043",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n真不可思議。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我還是第一次有這樣的心情喔。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，雖說得有點晚，",
    "voice": "vo_adv_1047007_044",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但以這副樣子到處走動的話還真是顯眼呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "請了假又和比自己小的男孩子到處去玩～",
    "voice": "vo_adv_1047007_045",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這件事，\\n若是被同事知道，我就無法立足了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯？",
    "voice": "vo_adv_1047007_046",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你說，首先要把頭盔跟鎧甲脫掉……？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "找一家店，",
    "voice": "vo_adv_1047007_047",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n買些普通的衣服來換裝吧……？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如此一來，\\n誰都不會發現我是【王宮騎士團】的純？",
    "voice": "vo_adv_1047007_048",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "話雖如此……",
    "voice": "vo_adv_1047007_049",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我已經說過無數次，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我是不能被人看見真面目的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這是我的家訓。",
    "voice": "vo_adv_1047007_050",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n雖然也不是被看見真面目就非死不可的地步，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n並不是這麼嚴厲的家訓。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但我從孩提時期開始，",
    "voice": "vo_adv_1047007_051",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就一直遵從著這個家訓。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "要違背它是很令人害怕的……",
    "voice": "vo_adv_1047007_052",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n被一般地看見自己的真面目，感覺好害羞。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哇哇，不要硬脫！",
    "voice": "vo_adv_1047007_053",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n真強硬呢，少年……？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "事情不照自己的預期進展，",
    "voice": "vo_adv_1047007_054",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n而感到不滿嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真是的。",
    "voice": "vo_adv_1047007_055",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n雖然你很聽話又坦率，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但是換句話說……就像個孩子一樣啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "既然你都向我展現了任性的一面，",
    "voice": "vo_adv_1047007_056",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n只有我自己裝成好孩子的模樣也不公平呢",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "其實我也是，",
    "voice": "vo_adv_1047007_057",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n像個隨處可見的普通女孩子般……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "想要無所遮掩，",
    "voice": "vo_adv_1047007_058",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n以原來的樣貌，和某人一起遊玩等等。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "被鎧甲及頭盔所遮掩，",
    "voice": "vo_adv_1047007_059",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n無法與任何人直接接觸……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不能深刻的與人相處，",
    "voice": "vo_adv_1047007_060",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n是很寂寞的喔，少年。",
    "voice": null,
    "unit_id": 104711
  }
]
