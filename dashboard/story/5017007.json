  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那就這樣連拉姆的工作也一起做了吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "喂～",
    "voice": "vo_adv_5017007_081",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "拉姆。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "妳怎麼又說這種話……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n別讓可可蘿感到困擾。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真抱歉呢？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "愛、",
    "voice": "vo_adv_5017007_082",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "愛蜜莉雅小姐……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n之前就說過了，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請不要摸在下的頭……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "喔？",
    "voice": "vo_adv_5017007_083",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "嗯，",
    "voice": "vo_adv_5017007_084",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "真的是。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "氣氛超好的。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "那麼，",
    "voice": "vo_adv_5017007_085",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我們幾個也過去吧。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n就算我們可能明天就會回去了，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "也敬今天的我們。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "這次，",
    "voice": "vo_adv_5017007_086",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "要接受我的乾杯喔？",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "原本昴他們所居住的露格尼卡王國……\\n和{0}他們所居住的蘭德索爾……\\n是不會有任何交集的、這份從零開始的異世界邂逅。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "經歷這奇蹟的邂逅的人們臉上堆滿笑容，\\n這場宴會直到深夜也未結束。",
    "voice": null,
    "unit_id": null
  },
