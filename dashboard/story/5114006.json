[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在物理手段職員教育訓練之下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n莫妮卡等人總算打敗了招財貓──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "喵嗚嗚",
    "voice": "vo_adv_5114006_000",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n我輸了……",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "呼、",
    "voice": "vo_adv_5114006_001",
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "呼……",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這隻貓真是難纏……",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n原本以為用教育訓練的程度就能解決，",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n結果最後還是拿出真本事來戰鬥了。",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我也已經",
    "voice": "vo_adv_5114006_002",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "快站不穩了喵……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n總算成功阻止招財貓了，太好了喵……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "說到底，",
    "voice": "vo_adv_5114006_003",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "所謂的教育訓練，就是心靈的互相碰撞……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n換句話說，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就是拳頭相向的戰鬥，我學到一課了。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "總覺得好像不太對……",
    "voice": "vo_adv_5114006_004",
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯算了……",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們沒被招財貓教育訓練一番",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "真的是太好了。",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "多虧有",
    "voice": "vo_adv_5114006_005",
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下幫忙才得以獲勝啊！",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "話說回來，",
    "voice": "vo_adv_5114006_006",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你到底是什麼人喵？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖然有著貓咪的外表，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "或許其實根本不是貓喵……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "說起來",
    "voice": "vo_adv_5114006_007",
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "招財貓怎麼可能會說話……",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n此外，",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "招來過多的客人，",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "還有想把店據為己有也都……",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "有點帶煞！？",
    "voice": "vo_adv_5114006_008",
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n這不是有點帶煞的程度而已吧？",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n這擺飾",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不知節制地把客人和別的東西都招來了啊……",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們的店是應付不來的喵。",
    "voice": "vo_adv_5114006_009",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "果然只能把牠",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "交給專門處理魔導具的店了喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖然對帶牠來的秋乃很不好意思……",
    "voice": "vo_adv_5114006_010",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但牠的力量這麼強大……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n說不定可以賣個好價錢喵……？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就算沒辦法直接拿來用，",
    "voice": "vo_adv_5114006_011",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n或許會有人想把牠拿來當作新魔導具的材料喵～？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這麼一來，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "牠也沒辦法再做壞事了喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "嗚喵啊啊啊啊啊……",
    "voice": "vo_adv_5114006_012",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n拜託千萬別這麼對我……",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "嗚嗚嗚……",
    "voice": "vo_adv_5114006_013",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "我明明只是拚命地",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "招來顧客而已喵。",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n要是沒有客人來，店就會倒掉了啊喵嗚。",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "你們這些生意人，",
    "voice": "vo_adv_5114006_014",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "老是說我是受詛咒的招財貓，",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n根本就不可能理解我在各店鋪顛沛流離",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n是什麼樣的心情喵嗚嗚。",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "確實",
    "voice": "vo_adv_5114006_015",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是這樣沒錯……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "這些",
    "voice": "vo_adv_5114006_016",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "不都是你們的期望嗎喵。",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n有人來店裡，",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "希望有顧客來！",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n希望人潮不斷聚集",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "使店裡生意興隆喵！",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "是啊喵。",
    "voice": "vo_adv_5114006_017",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n因為那就是",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "我們招財貓的使命喵！",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "我會一直不斷不斷不斷不斷",
    "voice": "vo_adv_5114006_018",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "不斷地招來顧客喵……",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "即使店裡已經客滿，",
    "voice": "vo_adv_5114006_019",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "就算都開始排隊了，",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n即使預約都排到一年後了……",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "明明我都沒有休息，一直不斷地招來顧客……",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "我明明都招來這麼多客人了，",
    "voice": "vo_adv_5114006_020",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n為什麼大家卻還是都把店收起來，",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "只留下我孤單一個人呢喵！",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "…………啊……",
    "voice": "vo_adv_5114006_021",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n……你……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n這就是……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "做過頭",
    "voice": "vo_adv_5114006_022",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "了喵……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "做過",
    "voice": "vo_adv_5114006_023",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "頭……？",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "歇業不是因為營業額不足……",
    "voice": "vo_adv_5114006_024",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "而是因為顧客實在太多……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n而精疲力盡了喵……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就跟我們一樣喵……",
    "voice": "vo_adv_5114006_025",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "嗚嗚……",
    "voice": "vo_adv_5114006_026",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n嗚",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這樣啊，",
    "voice": "vo_adv_5114006_027",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n以你的方式",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "拚命努力了啊。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可是，",
    "voice": "vo_adv_5114006_028",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你其實不必那麼拚命地招來客人喔。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "只需要……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "打造出待起來很舒服的店，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "讓客人們能夠好好放鬆就夠了。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "如果是待起來會開心的店，",
    "voice": "vo_adv_5114006_029",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "一定沒問題。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "無論是之前來過的客人，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "還是今後將會來光顧的客人，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n都會變成我們的老顧客。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "喵嗚嗚……",
    "voice": "vo_adv_5114006_030",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "所以你不用擔心……",
    "voice": "vo_adv_5114006_031",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "呃！？",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n你剛剛",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "順著這番話，又打算招來客人了吧！？",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "喵嗚嗚……",
    "voice": "vo_adv_5114006_032",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n我的右手隱隱作痛啊喵……",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "「快招來客人……」",
    "voice": "vo_adv_5114006_033",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "我體內的招財貓之魂在吶喊著喵……",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "不能招來客人的招財貓就只是隻普通的貓！",
    "voice": "vo_adv_5114006_034",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "這種事",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "我無法忍受啊喵！",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "喵啊啊啊啊啊……！",
    "voice": "vo_adv_5114006_035",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "等等、",
    "voice": "vo_adv_5114006_036",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "住手，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "拜託！！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "現在就算招來客人，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們也沒辦法接待……！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "珠希！",
    "voice": "vo_adv_5114006_037",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "快阻止牠！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沒問題我來了喵！",
    "voice": "vo_adv_5114006_038",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我不會讓你招來任何人的喵──！！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "…………",
    "voice": "vo_adv_5114006_039",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "…………",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "…………咦？",
    "voice": "vo_adv_5114006_040",
    "unit_id": 125111
  },
  {
    "type": "still",
    "still_id": "511400601"
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "…………你失去招財貓的",
    "voice": "vo_adv_5114006_041",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "力量了嗎……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "再怎麼、",
    "voice": "vo_adv_5114006_042",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "再怎麼招攬，",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "都沒有任何人來喵……",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n為什麼喵！",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n嗚喵啊啊啊啊啊！",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "啊，",
    "voice": "vo_adv_5114006_043",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喂你別哭啦！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n你已經招來夠多人，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不必再繼續勉強自己了！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "喵嗚嗚……",
    "voice": "vo_adv_5114006_044",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n不招來客人，",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "也沒關係嗎……？",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你是因為我和珠希，",
    "voice": "vo_adv_5114006_045",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n以及你至今以來的主人",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "都希望你能招來更多更多的客人，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n你才這麼地努力對吧？",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但你不必再勉強自己了。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "我不僅招來太多客人、",
    "voice": "vo_adv_5114006_046",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "還想把店據為己有……",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n老是給大家添麻煩喵啊啊……",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n我",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "真是隻壞貓咪喵……",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這也是沒辦法的事啊。",
    "voice": "vo_adv_5114006_047",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n受人仰賴，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "任誰都會很開心。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "也有可能不小心就做過頭……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "有時就是會這樣。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沒錯喵！",
    "voice": "vo_adv_5114006_048",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n就像莫妮卡憑著氣勢就租下了這間店，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n而我則來莫妮卡的店裡幫忙這樣，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但在不知不覺中，",
    "voice": "vo_adv_5114006_049",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n這間店已經如此受到大家愛戴了。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖然租金方面還是",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "付不太起喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "在講這種話題時別說這個啦……",
    "voice": "vo_adv_5114006_050",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你聽好了，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "跟我們是一樣的，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "招財貓。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "still",
    "still_id": "511400602"
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "一樣……？",
    "voice": "vo_adv_5114006_051",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然做事不懂分寸，",
    "voice": "vo_adv_5114006_052",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "會不小心做過頭而失敗。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n很多時候事情",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "都進行得不順利。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但是，",
    "voice": "vo_adv_5114006_053",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們不會放棄。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n無論是過去，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "還是未來！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n……你不也是",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這樣走過來的嗎？",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沒錯喵。",
    "voice": "vo_adv_5114006_054",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "而且……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你也是",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這間「Naschkatze」的夥伴啊喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "可是我，",
    "voice": "vo_adv_5114006_055",
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "已經沒辦法再招來客人了喵。",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "招財貓",
    "words": "\\n幫不上你們的忙了喵……",
    "voice": null,
    "unit_id": 17312
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你不必在意是否能招來客人這種事喵。",
    "voice": "vo_adv_5114006_056",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "「Naschkatze」是我們的店喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就由我們來恢復原狀吧。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這種小事，",
    "voice": "vo_adv_5114006_057",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "交給我來做，簡直是小菜一碟喵……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呃！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "店裡變得這樣一塌糊塗，",
    "voice": "vo_adv_5114006_058",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n只靠我們幾個根本沒辦法復原喵──！！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "你們好！",
    "voice": "vo_adv_5114006_059",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "欸欸，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊也想要幫忙",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "整理祕密基地！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗯嗯♪",
    "voice": "vo_adv_5114006_060",
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n哥哥，",
    "voice": null,
    "unit_id": 102012
  },
  {
