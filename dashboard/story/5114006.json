    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "就發現自己像是被吸引了一般",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "打開了店門。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "然後，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "就發現裡面有貓咪，還有鯛魚燒……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n覺得這家咖啡廳還真有意思，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "馬上就喜歡上了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "原來是這樣喵！",
    "voice": "vo_adv_5114006_092",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n客人，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "謝謝您！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "招財貓",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "也覺得很開心呢喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯，",
    "voice": "vo_adv_5114006_093",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你果然是我們這家店的招牌貓咪喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這家店開始重新營業時，我會再來的！",
    "voice": "vo_adv_5114006_094",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "啊，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "還有，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n有需要體力活時就找我吧！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我會來幫忙的。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "還有公會長小姐也是。",
    "voice": "vo_adv_5114006_095",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我已經有所屬的公會了，所以不能加入你們，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n但有需要時我可以幫忙哦。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "委託人手不足時就找我吧。",
    "voice": "vo_adv_5114006_096",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n你們也接受",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這種方式吧？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "啊、",
    "voice": "vo_adv_5114006_097",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒錯！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……說起來，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這才是我原本的目的啊！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你有空能來幫忙的話，我會很高興的。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "當然沒問題！",
    "voice": "vo_adv_5114006_098",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "謝謝你喵！",
    "voice": "vo_adv_5114006_099",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你瞧，",
    "voice": "vo_adv_5114006_100",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你招來的客人，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n說他還會",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "再來光顧呢喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "好～",
    "voice": "vo_adv_5114006_101",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "為了讓這家店重新開始營業，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n得好好加油才行喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "老虎",
    "words": "喵～！",
    "voice": "vo_adv_5114006_102",
    "unit_id": 1712
  }
]
