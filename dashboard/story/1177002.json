    "type": "dialogue",
    "name": "香織",
    "words": "\\n總之",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "先去現場看看吧──！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "background",
    "bg_id": "505035"
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "到處都不見人影……",
    "voice": "vo_adv_1177002_017",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "大家好像都逃走了～",
