    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……雖然無可奈何，",
    "voice": "vo_adv_1177002_014",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n不過變裝派對取消了真可惜～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我本來很期待的說……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……咦？",
    "voice": "vo_adv_1177002_015",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你說只要我們解決幽靈騷動，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n變裝派對就有可能重辦？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "的確",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "有可能耶～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這也是為了守護我們的萬聖節，",
