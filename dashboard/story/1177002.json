    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "咦？",
    "voice": "vo_adv_1177002_023",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "來玩是指……",
