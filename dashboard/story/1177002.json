    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "每年",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "都很熱鬧～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過，",
    "voice": "vo_adv_1177002_005",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "蘭德索爾的萬聖節，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n比我的故鄉",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "還更加更～加熱鬧呀～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "所以我",
    "voice": "vo_adv_1177002_006",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "一直都超期待，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n能參加蘭德索爾的變裝派對喔～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……奇怪？",
    "voice": "vo_adv_1177002_007",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n有很多人",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "從市區那邊往這裡跑過來了～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n這也是什麼萬聖節的活動嗎～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "幽、",
    "voice": "vo_adv_1177002_008",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "幽靈出現啦～！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "幽靈？",
    "voice": "vo_adv_1177002_009",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n欸欸，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "大哥。",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那邊發生了什麼事嗎～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "啊，",
    "voice": "vo_adv_1177002_010",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是啊……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n像是南瓜燈籠明明沒有人碰，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n卻突然",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "飄到空中……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "或是明明沒有人在的地方，",
    "voice": "vo_adv_1177002_011",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n卻傳來女孩子的聲音……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n那邊一直發生可怕的靈異現象啊！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "所以大家",
    "voice": "vo_adv_1177002_012",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "才會害怕地逃跑啊～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n……咦？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那變裝派對怎麼辦……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "現在沒那個閒工夫了啦！",
    "voice": "vo_adv_1177002_013",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n你們最好也不要靠近那邊。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n搞不好會被詛咒喔！",
