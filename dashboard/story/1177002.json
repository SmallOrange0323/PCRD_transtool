    "name": "香織",
    "words": "快躲開──！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嚇我一跳……",
    "voice": "vo_adv_1177002_019",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
