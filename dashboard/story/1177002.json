    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "少女幽靈",
    "words": "咦～？",
    "voice": "vo_adv_1177002_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女幽靈",
    "words": "為什麼？",
