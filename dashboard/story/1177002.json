    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "哇哇！？",
    "voice": "vo_adv_1177002_024",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n又有南瓜燈籠飛來啦～！？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不管怎樣，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "先集中精神閃躲吧──！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "少女幽靈",
    "words": "啊哈哈，",
    "voice": "vo_adv_1177002_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女幽靈",
