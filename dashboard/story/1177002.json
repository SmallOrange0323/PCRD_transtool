    "name": "香織",
    "words": "雖然想阻止她惡作劇，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n不過看不見對方也無計可施……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
