  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
