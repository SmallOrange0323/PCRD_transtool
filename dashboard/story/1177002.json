    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……聽得到笑聲",
    "voice": "vo_adv_1177002_021",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "卻看不見身影啊～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這場騷動果然",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "是幽靈搞的鬼呢～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "少女幽靈",
    "words": "欸，",
    "voice": "vo_adv_1177002_022",
    "unit_id": null
  },
  {
