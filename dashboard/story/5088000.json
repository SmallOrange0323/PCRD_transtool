[
  {
    "type": "background",
    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一如往常的咲戀育幼院。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了送別即將出門的咲戀，鈴莓等人聚集在了一起。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那麼鈴莓。",
    "voice": "vo_adv_5088000_000",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我暫時不在家的這段期間，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "大家就拜託妳囉。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「好，",
    "voice": "vo_adv_5088000_001",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "包在我身上！」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "為什麼是噗吉回話啦～",
    "voice": "vo_adv_5088000_002",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "被拜託的人是我耶～",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "他是想說能照顧大家的不是只有鈴莓而已對吧，",
    "voice": "vo_adv_5088000_003",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "噗吉？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「沒錯。」",
    "voice": "vo_adv_5088000_004",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真的嗎？",
    "voice": "vo_adv_5088000_005",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不是說只有我的話會靠不住對吧？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「…………」",
    "voice": "vo_adv_5088000_006",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "噗吉？",
    "voice": "vo_adv_5088000_007",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "噗吉，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "你有聽到嗎？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呵呵。",
    "voice": "vo_adv_5088000_008",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然我拜託鈴莓照顧大家，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n不過鈴莓就拜託大家囉。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯！",
    "voice": "vo_adv_5088000_009",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我和胡桃還有噗吉會看好她的，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "放心吧！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "對吧，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "胡桃。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦！？",
    "voice": "vo_adv_5088000_010",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不、",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不用我看著，鈴莓姐她應該也",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "沒問題……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "沒問題……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「就算是名演員也演不下去嗎～」",
    "voice": "vo_adv_5088000_011",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "怎麼這樣～",
    "voice": "vo_adv_5088000_012",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯，",
    "voice": "vo_adv_5088000_013",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "看來我能放心出門了呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n那我就……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "打擾了～！",
    "voice": "vo_adv_5088000_014",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是誰呢？",
    "voice": "vo_adv_5088000_015",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "應該沒有客人預訂要來啊……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "來了～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我這就過去～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哎呀？",
    "voice": "vo_adv_5088000_016",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "妳是……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我、",
    "voice": "vo_adv_5088000_017",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "叫做美咲！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是想拜咲戀小姐為師而來的！！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦？",
    "voice": "vo_adv_5088000_018",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "拜師……？",
    "voice": "vo_adv_5088000_019",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我在看了那本完美的成熟淑女特輯後，",
    "voice": "vo_adv_5088000_020",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n就想拜咲戀小姐為師。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊～",
    "voice": "vo_adv_5088000_021",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這麼說來之前是有接受過採訪呢～",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但我接受的好像是",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "經濟雜誌的採訪，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沒想到妳竟然會看那種艱深的雜誌呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦？",
    "voice": "vo_adv_5088000_022",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我看的是",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "時尚雜誌的特輯啊……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……那個編輯，",
    "voice": "vo_adv_5088000_023",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "居然敢騙我。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那個……",
    "voice": "vo_adv_5088000_024",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊啊，",
    "voice": "vo_adv_5088000_025",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這不是美咲的錯，妳不用在意喔。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過真傷腦筋呢。",
    "voice": "vo_adv_5088000_026",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n就算突然說要拜我為師，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但我也不知道能教妳什麼，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n而且我現在又必須要長期出差。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這、",
    "voice": "vo_adv_5088000_027",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "說得也是呢……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n畢竟我是突然找上門來的……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過妳都特地過來了，",
    "voice": "vo_adv_5088000_028",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就這樣讓妳空手而回我也很過意不去。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳樂意的話，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就請參觀一下育幼院吧。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n雖然我得出門去，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但或許有什麼能讓妳",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "參考的地方也說不定呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "但是，",
    "voice": "vo_adv_5088000_029",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這樣不會造成妳們的困擾嗎……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒有這回事喔。",
    "voice": "vo_adv_5088000_030",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n因為小美咲妳是",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "來拜訪咲戀大小姐的",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "重要客人嘛。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「非常歡迎有更多人來",
    "voice": "vo_adv_5088000_031",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "照顧鈴莓小姐喔！」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "拜託請不要在客人的面前這麼說啦～",
    "voice": "vo_adv_5088000_032",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……？",
    "voice": "vo_adv_5088000_033",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "妳應該很快就會明白了，不用在意喔。",
    "voice": "vo_adv_5088000_034",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n比起那個，美咲，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "既然妳都難得過來了，我們就一起玩吧♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我、",
    "voice": "vo_adv_5088000_035",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我又不是",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "來玩的……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我想想喔……",
    "voice": "vo_adv_5088000_036",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那麼，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳就以候補徒弟的身分，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n從了解我的人那邊打聽我的事情，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳覺得這麼做",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "自己這麼說還挺不好意思的！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "如果是關於咲戀媽媽的佳話，",
