[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和初音一起來買東西。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我想要改造房間，讓它看起來更可愛──。",
    "voice": "vo_adv_1012008_000",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n如果有可愛的擺飾就好了……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n可是不知道該選什麼。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我也想聽聽你的意見，",
    "voice": "vo_adv_1012008_001",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n就叫你來了。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼，我們趕快去買東西──",
    "voice": "vo_adv_1012008_002",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "哇，",
    "voice": "vo_adv_1012008_003",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好刺眼……！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n這是，之前的……！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "奇、奇怪……？",
    "voice": "vo_adv_1012008_004",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n又變得好想睡……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕呼嚕。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "510010"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "動物園真好玩呢～",
    "voice": "vo_adv_1012008_005",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "喂喂，我們去看看伴手禮吧──！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "難得來一趟，我想買禮物送小栞──♪",
    "voice": "vo_adv_1012008_006",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "哪個好呢──？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，這個熊貓玩偶也許不錯！",
    "voice": "vo_adv_1012008_007",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這種可愛的東西很適合小栞對吧──。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？ 你、你說也很適合我……！？",
    "voice": "vo_adv_1012008_008",
    "unit_id": 101231
  },
  {
    "type": "still",
    "still_id": "101200801"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦咦──才沒那回事呢──。",
    "voice": "vo_adv_1012008_009",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n適合我的是……這個老虎之類的！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": " 吼──！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "吼──，吼──！",
    "voice": "vo_adv_1012008_010",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我要吃掉你喔──！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……什麼？ 你不好吃……？",
    "voice": "vo_adv_1012008_011",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是嗎？ 看起來很好吃呢──。",
    "voice": "vo_adv_1012008_012",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n而且你身形比我大，吃了好像會很有飽足感～",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "而且，你非常溫柔、有趣、",
    "voice": "vo_adv_1012008_013",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n認真、帥氣、親切……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……咦、咦？",
    "voice": "vo_adv_1012008_014",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n這些應該和看起來很好吃無關……？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊、啊哈哈……",
    "voice": "vo_adv_1012008_015",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我在說什麼啊？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "為什麼你要配合啊！？",
    "voice": "vo_adv_1012008_016",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是說……我、我不會真的吃掉你啦──！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那、那是當然的啊──！",
    "voice": "vo_adv_1012008_017",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你把我當成什麼啦！？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真是的──，都是你說了奇怪的話，害我嚇一跳……",
    "voice": "vo_adv_1012008_018",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……咦？",
    "voice": "vo_adv_1012008_019",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "為了賠罪，你要買這隻老虎給我？",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真的嗎！？ ",
    "voice": "vo_adv_1012008_020",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "謝謝──！",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n那麼，也讓我給你回禮。",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……咬。",
    "voice": "vo_adv_1012008_021",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "欸嘿嘿……吃、吃掉了。",
    "voice": "vo_adv_1012008_022",
    "unit_id": 101231
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n雖、雖然是臉頰……",
    "voice": null,
    "unit_id": 101231
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，辛苦了～♪",
    "voice": "vo_adv_1012008_023",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "初音相當大膽呢……",
    "voice": "vo_adv_1012008_024",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我很驚訝呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "咬是怎樣啊！ 咬！？",
    "voice": "vo_adv_1012008_025",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你不覺得太可愛了嗎！？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "總之，你們似乎像在『那邊』的時候一樣，",
    "voice": "vo_adv_1012008_026",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n在『這邊』也保持友好的關係，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n請暫時再享受一會這樣的生活吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然不久之後應該需要麻煩你努力，",
    "voice": "vo_adv_1012008_027",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但在那之前，請好好享受吧……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，這次就先聊到這裡。",
    "voice": "vo_adv_1012008_028",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "掰掰～，下次見囉 ♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500011"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼……我又睡著了？",
    "voice": "vo_adv_1012008_029",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，你也睡著了呀──。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？ 動物園的夢！？",
    "voice": "vo_adv_1012008_030",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我也做了那個夢喔──",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "之前也發生過這種事對吧？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，對了！ 我房間的改造，",
    "voice": "vo_adv_1012008_031",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你覺得放玩偶怎麼樣？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我覺得很可愛呢──",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦，你要買給我！？ ",
    "voice": "vo_adv_1012008_032",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "太棒了──！ 謝謝──！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n必須要送點什麼謝謝你呢？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……咦？ 說、說到謝禮……？",
    "voice": "vo_adv_1012008_033",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯，那個……不、不是啦！",
    "voice": "vo_adv_1012008_034",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我在夢裡吃了你，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n該說是因為一時衝動……因為太開心，所以忍不住……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗚、嗚……雖說是夢，",
    "voice": "vo_adv_1012008_035",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n但我怎麼會做出那種事……？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不算，不──算！",
    "voice": "vo_adv_1012008_036",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "給我把夢忘掉──！！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "初音因為太過害羞，\\n而當場逃走了。",
    "voice": null,
    "unit_id": null
  }
]
