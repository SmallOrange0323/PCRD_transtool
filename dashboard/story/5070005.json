    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "沒時間感嘆了，惠理子。",
    "voice": "vo_adv_5070005_062",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n這是汰舊與換新的精神。",
    "voice": null,
    "unit_id": 117111
  },
