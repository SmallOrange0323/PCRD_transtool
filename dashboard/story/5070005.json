  {
    "type": "background",
    "bg_id": "500287"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們的目的是",
    "voice": "vo_adv_5070005_054",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "為弟弟規劃出最棒的暑假。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那麼我們要做的事情就只有一件，",
    "voice": "vo_adv_5070005_055",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "沒錯吧？",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "background",
    "bg_id": "500285"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊，",
    "voice": "vo_adv_5070005_056",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "對不起喔，弟弟。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我們把你吵醒了？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "啊啊……",
    "voice": "vo_adv_5070005_057",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n睡迷糊的大人也",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "好迷人……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們把屋子給砸了！",
    "voice": "vo_adv_5070005_058",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們回去吧，",
    "voice": "vo_adv_5070005_059",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "大人……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "回去我們心愛的，",
    "voice": "vo_adv_5070005_060",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n弟弟會展現各種不同的一面，",
