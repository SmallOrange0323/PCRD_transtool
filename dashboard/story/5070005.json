    "name": "靜流",
    "words": "雖然中途有被鯊魚外型的魔物襲擊，",
    "voice": "vo_adv_5070005_065",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n但牠根本不是我們的對手呢。",
    "voice": null,
    "unit_id": 117111
  },
