  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我這樣不行對吧。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我必須振作起來，",
    "voice": "vo_adv_5070005_053",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n為弟弟規劃最棒的暑假……",
