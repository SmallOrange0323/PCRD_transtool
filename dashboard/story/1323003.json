    "name": "店長阿姨",
    "words": "沒有放棄。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……不管有多少情敵，",
    "voice": "vo_adv_1323003_053",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n喜歡達令先生的心情都不會輸給任何人。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n所以妳沒有選擇放棄……",
