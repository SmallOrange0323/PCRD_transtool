  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "結婚戒指……？」",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "「露易，",
