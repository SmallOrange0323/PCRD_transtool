[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在街上遇到了",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n緊緊握著錢的真陽。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哦～老哥呀，",
    "voice": "vo_adv_1033011_000",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好久不見啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "之前請你陪我表演搞笑，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真的謝啦！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯？",
    "voice": "vo_adv_1033011_001",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你說這個啊。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這是",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那個啦，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那個時候收到的出演費啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好歹也是我身為搞笑藝人賺到的第一筆錢嘛。",
    "voice": "vo_adv_1033011_002",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "想說買個什麼可以當作紀念的東西，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就到街上來了。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n只是一直想不到要買什麼呢。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "對了，",
    "voice": "vo_adv_1033011_003",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥也陪我……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哇哇！？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n又是這搞不懂是什麼的光！？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "到底是怎樣啦～～～！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "background",
    "bg_id": "510280"
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯～",
    "voice": "vo_adv_1033011_004",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "果然可以近距離看專業的人表演搞笑就是棒。",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "要是我老家那邊也會常常有人去辦就好了，",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n只是",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "以鄉下來說果然很難啦……",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過",
    "voice": "vo_adv_1033011_005",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真的是超厲害的啦……",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那個善用停頓的方式……",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不愧是在各個大賽所向披靡的組合呢……",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哇哇！？",
    "voice": "vo_adv_1033011_006",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥！",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n居然會在這種地方遇到你，真巧啊！",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊！",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "難不成老哥",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "也是來看搞笑表演會的嗎？",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "看樣子",
    "voice": "vo_adv_1033011_007",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "只是來買東西而已啊。",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真可惜啊，",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "居然沒看到",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那麼厲害的東西……",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "今天有電視上也很紅的搞笑藝人",
    "voice": "vo_adv_1033011_008",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "在這裡辦表演啦。",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我就是來看那個的。",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊！",
    "voice": "vo_adv_1033011_009",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "還有下午場嘛！",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "怎麼樣，老哥？",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "要不要",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "跟我一起看啊？",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n超級有趣的啦！",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥果然很懂嘛！",
    "voice": "vo_adv_1033011_010",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然我也很想讓伊麗莎白看看，",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n可是也不能把牛帶到這種地方來啦。",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥",
    "voice": "vo_adv_1033011_011",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "如果願意連伊麗莎白的份一起學習就太好啦！",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "當然！",
    "voice": "vo_adv_1033011_012",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "才不是我這種人比的上的！",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不、",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不是啦，",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我當然也有",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "在追求我理想中的搞笑喔。",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但是",
    "voice": "vo_adv_1033011_013",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "專業的果然就是厲害。",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這一點就",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "請老哥直接親眼去看看吧。",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "總之絕對不會無聊的啦，",
    "voice": "vo_adv_1033011_014",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "跟我來吧。",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "等一下搞笑藝人就要登場了！",
    "voice": "vo_adv_1033011_015",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "現場表演的搞笑可是超厲害的喔，",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你就好好期待吧！",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "大家好～",
    "voice": "vo_adv_1033011_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "\\n非常感謝今天也有這麼多人聚集在這裡～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "\\n啊～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "感謝這麼熱烈的掌聲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星2",
    "words": "哎呀～",
    "voice": "vo_adv_1033011_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星2",
    "words": "沒想到居然會有這麼多人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星2",
    "words": "願意跑來看我們這小小藝人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星2",
    "words": "\\n真的是非常感謝～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "在各位觀眾當中，",
    "voice": "vo_adv_1033011_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "有沒有人看過我們的呢～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "\\n麻煩舉個手～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "有！",
    "voice": "vo_adv_1033011_019",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我有！",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "諧星2",
    "words": "喔～",
    "voice": "vo_adv_1033011_020",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "諧星2",
    "words": "這位活力充沛的小妹妹，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星2",
    "words": "謝謝妳呀～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星2",
    "words": "咦？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星2",
    "words": "咦咦？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星2",
    "words": "\\n妳早上也有來看對吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "哈哈，",
    "voice": "vo_adv_1033011_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "難怪有看過嘛。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "\\n嗯？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "旁邊的男生是哥哥嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "\\n早上沒有看到你呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "不行喔～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "怎麼放著小孩子一個人行動呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "小、",
    "voice": "vo_adv_1033011_022",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "小孩子！？",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不對啦！",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我才是年紀比較大的姐姐啦！",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "啊哈哈，",
    "voice": "vo_adv_1033011_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "賭氣裝大人的樣子真可愛呢～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諧星1",
    "words": "\\n我們不怎麼受小孩子歡迎，所以很高興喔～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "所、",
    "voice": "vo_adv_1033011_024",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "所以說……！",
    "voice": null,
    "unit_id": 103332
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗚……",
    "voice": "vo_adv_1033011_025",
    "unit_id": 103332
  },
  {
    "type": "dialogue",
