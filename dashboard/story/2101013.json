  {
    "type": "dialogue",
    "name": "日和",
    "words": "這也是",
    "voice": "vo_adv_2101013_020",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "佩可小姐的作戰嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "她平常與人的親密接觸就很頻繁，",
    "voice": "vo_adv_2101013_021",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "應該並非如此才是……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……",
    "voice": "vo_adv_2101013_022",
    "unit_id": 105811
  },
  {
    "type": "background",
    "bg_id": "500342"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……貪吃佩可……？",
    "voice": "vo_adv_2101013_023",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……咦、",
    "voice": "vo_adv_2101013_024",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦……？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n真奇怪呢。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣就準備OK～了，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "似似花明明是這樣跟我說的啊……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "準備……？",
    "voice": "vo_adv_2101013_025",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "嘖。",
    "voice": "vo_adv_2101013_026",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n在那邊耍白癡……！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n別在那邊發呆了，",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "你們這些垃圾魔獸！　",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "快上！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "500342"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呀啊啊啊～！",
    "voice": "vo_adv_2101013_027",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "痛痛……！",
    "voice": "vo_adv_2101013_028",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "給我等一下妳這白癡佩可！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳那麼耍帥地出場，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "結果狀況還不是完全沒變嘛！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "痛呀……",
    "voice": "vo_adv_2101013_029",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好、",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好奇怪呢。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n難道",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是還缺了什麼東西嗎……？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "哈！",
    "voice": "vo_adv_2101013_030",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n怎麼，",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "就只是來耍白癡結果還是沒半招嗎？",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n你們果然就只有這點程度啊，",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "公主騎士的先生小姐們。",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "那麼，",
    "voice": "vo_adv_2101013_031",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "就送你們去死吧……",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……等等！",
    "voice": "vo_adv_2101013_032",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "優衣！？",
    "voice": "vo_adv_2101013_033",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣，",
    "voice": "vo_adv_2101013_034",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "危險！",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n別到前頭去……！",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "卡里莎！",
    "voice": "vo_adv_2101013_035",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n你剛剛……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "說了你的目標是我對吧。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "……啊？",
    "voice": "vo_adv_2101013_036",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那麼，",
    "voice": "vo_adv_2101013_037",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "能不能放過騎士先生他們……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "能不能就這樣",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "放過大家呢！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n你要對我做什麼都沒關係！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不行呀，優衣，",
    "voice": "vo_adv_2101013_038",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那種事……！",
    "voice": null,
    "unit_id": 100111
  },
  {
