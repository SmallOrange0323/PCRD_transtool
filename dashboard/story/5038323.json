  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "怎麼跟妳說的不一樣。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n妳不是說它已經奄奄一息了嗎。",
    "voice": null,
    "unit_id": 110811
