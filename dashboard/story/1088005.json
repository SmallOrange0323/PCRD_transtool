[
  {
    "type": "background",
    "bg_id": "501490"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在蘭德索爾即將迎接年末的某個冬日。\\n優衣今晚要代替雙親準備晚餐，在買好食材後，她正走在回家的路上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "晚餐的",
    "voice": "vo_adv_1088005_000",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "湯",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "該煮什麼呢……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這麼說來，",
    "voice": "vo_adv_1088005_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這次要回哪邊的老家跨年？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我爸說",
    "voice": "vo_adv_1088005_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "想和你一起喝一杯。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n說也歡迎公公婆婆他們一起來喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……跟家人",
    "voice": "vo_adv_1088005_003",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "一起啊。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果能夠",
    "voice": "vo_adv_1088005_004",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "跟之前一樣",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "和騎士先生一起的話……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不過，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "他一定會",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "很忙吧。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "唉……",
    "voice": "vo_adv_1088005_005",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生！",
    "voice": "vo_adv_1088005_006",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒有，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒有",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那回事。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我只是邊走路",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "邊想事情。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……騎士先生你除夕那天，",
    "voice": "vo_adv_1088005_007",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "有什麼計畫嗎？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "就是，",
    "voice": "vo_adv_1088005_008",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可以的話……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n要不要跟我",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "一起過呢……？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……那個，",
    "voice": "vo_adv_1088005_009",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "剛才的邀請是要看你方便！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但你應該",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "已經排好",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "計畫了吧……？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可以嗎……？",
    "voice": "vo_adv_1088005_010",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我想想，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那除夕的早上，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我們在街道的入口",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "碰頭好嗎？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒問題？",
    "voice": "vo_adv_1088005_011",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "太好了……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那就",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "除夕見。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "拜拜。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……咦咦咦！？",
    "voice": "vo_adv_1088005_012",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我和騎士先生",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "就這樣約好了！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n怎、",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怎麼辦～！！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "明明是自己主動邀請的，",
    "voice": "vo_adv_1088005_013",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n卻還是有點",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不可置信……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "除夕那天，",
    "voice": "vo_adv_1088005_014",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "該怎麼辦呢……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "要做什麼才好？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……好，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "先從今天的晚餐開始想吧！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "和騎士先生",
    "voice": "vo_adv_1088005_015",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "兩人一起跨年，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真讓人期待……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "過了幾天，終於到了除夕當天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n優衣穿上新年和服，正要從老家的小吃店\\n前往會合的地點。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "隨身物品準備好了。",
    "voice": "vo_adv_1088005_016",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "和服也",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒有哪裡……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怪怪的吧？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒問題。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我出門了～！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "優衣～！",
    "voice": "vo_adv_1088005_017",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "等一下～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "媽媽？",
    "voice": "vo_adv_1088005_018",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "爸爸也……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怎麼那麼慌忙？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n發生什麼事了嗎？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "其實……",
    "voice": "vo_adv_1088005_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "我們之前說過",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "除夕夜要去",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "神殿擺攤對吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯。",
    "voice": "vo_adv_1088005_020",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你們說過",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "第一次抽中",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可以擺攤的資格呢。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "然後啊，",
    "voice": "vo_adv_1088005_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "我們就去公會管理協會",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "張貼了打工的委託。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n結果原本要去幫忙擺攤的工讀生，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n竟然在其他工作中受傷了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "所以說，",
    "voice": "vo_adv_1088005_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "優衣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "妳能代替他去幫忙擺攤嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦咦咦！？",
    "voice": "vo_adv_1088005_023",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我嗎！？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "好不容易中籤了，",
    "voice": "vo_adv_1088005_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "所以我們不想放棄擺攤的機會。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n但也不能因此放著家裡的店不管……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n拜託妳了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "會給妳更多壓歲錢的！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "好嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……對不起，媽媽。",
    "voice": "vo_adv_1088005_025",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我今天，那個，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "有約了……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……能和騎士先生一起度過的",
    "voice": "vo_adv_1088005_026",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "珍貴時光正在等著我。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但是這種時候，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果是騎士先生……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……雖然有約了，",
    "voice": "vo_adv_1088005_027",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
