[
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你這傢伙……",
    "voice": "vo_adv_5090301_000",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這個渾蛋，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我決不會放過你的！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你竟然有臉",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "一直隨心所欲到今天啊……！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "我能隨心所欲",
    "voice": "vo_adv_5090301_001",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "是因為我有能力啊。",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n同為壞人，",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "是你們跟我的格調不同！",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "格調不同……",
    "voice": "vo_adv_5090301_002",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗎。",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這點我同意。",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你才是沒格調的人啦，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "三流賭徒！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "──步未未，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳退下！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這傢伙就由我來教訓……",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……不。",
    "voice": "vo_adv_5090301_003",
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我也要一起戰鬥喔，",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "祈梨……！",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "步未未，",
    "voice": "vo_adv_5090301_004",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳……！？",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我……",
    "voice": "vo_adv_5090301_005",
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "總是",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "只能在一旁看著……",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "所以……",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "所以",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我想要改變……！",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n我想要成為，",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "能抬頭挺胸站在祈梨身旁的朋友……！",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……也算上我啦，",
    "voice": "vo_adv_5090301_006",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "兩位。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘉夜夜！？",
    "voice": "vo_adv_5090301_007",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不要緊嗎！？",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n妳已經渾身是傷了……！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我只要一不留神就隨時會倒下去……",
    "voice": "vo_adv_5090301_008",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但是，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "身為打手卻只能在旁邊看別人打架，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我當然不可能會接受啊……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這才是",
    "voice": "vo_adv_5090301_009",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘉夜夜……！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……步未未，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳也準備好吧！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗯！",
    "voice": "vo_adv_5090301_010",
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "讓我們開始",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "怪盜團最後的工作吧！",
    "voice": null,
    "unit_id": 121511
  }
]
