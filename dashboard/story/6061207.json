  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "任務",
    "voice": "vo_adv_6061207_000",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "總算是結束了～",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家的邀約您都不曾拒絕，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n讓王子先生",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "吃了不少苦頭……",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真是抱歉。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是啊。",
    "voice": "vo_adv_6061207_001",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "雖然有辛苦的地方，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n不過也有",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "很多很多",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "快樂的事呢～",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家不會再愧疚煩惱了。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "謝謝您，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生……",
    "voice": "vo_adv_6061207_002",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您既然這麼說，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "表示下次還可以再邀約您囉？",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "如果是這樣，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那咱們就是命運共同體，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "無論到哪裡去，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "都要陪著人家喔，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還請多多指教。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您又說了會讓人開心的話。",
    "voice": "vo_adv_6061207_003",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家也是覺得",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "只要有王子先生在身邊，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家就能比平時",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "更加賣力。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "今後",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也請繼續跟人家一起做些",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "開心的事喔～",
    "voice": null,
    "unit_id": 116011
  }
]
