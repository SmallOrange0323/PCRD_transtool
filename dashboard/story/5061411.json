[
  {
    "type": "background",
    "bg_id": "500133"
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "唉，",
    "voice": "vo_adv_5061411_000",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這種如夢般的日子，",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就要在今天宣告結束了啊。",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n還要跟難得認識的人們告別，",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真是寂寞……",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "相遇與分離",
    "voice": "vo_adv_5061411_001",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "的確就像是一體兩面，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是絕對",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "無法分割的。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但是，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "莉瑪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "在這裡獲得的",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "經驗和回憶，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是不會消失的。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所以",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "可不能說出",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "像「告別」這種寂寞的詞彙哦。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真步……",
    "voice": "vo_adv_5061411_002",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "而且",
    "voice": "vo_adv_5061411_003",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳的牧場夥伴們，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還有我們，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "也都在妳身邊。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不是嗎？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真琴……",
    "voice": "vo_adv_5061411_004",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯，",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就是說呀！",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯，",
    "voice": "vo_adv_5061411_005",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要是缺乏刺激的話就來我們這吧。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我會讓妳工作到沒有空感覺寂寞哦！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也隨時歡迎妳",
    "voice": "vo_adv_5061411_006",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "到真步真步王國來玩哦～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊哈哈，",
    "voice": "vo_adv_5061411_007",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我這個人",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "竟然被這麼美好的事物圍繞著呀。",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如夢一般的日子，",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "在這之後也會持續下去。",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這真是個有些太過美妙的幸福結局呢♪",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那麼最後衝刺也要充滿少女心，",
    "voice": "vo_adv_5061411_008",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "華麗地畫下句點吧♪",
    "voice": null,
    "unit_id": 105212
  }
]
