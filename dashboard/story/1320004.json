[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "艾姬多娜結束了與霸瞳皇帝的茶會。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了滿足好奇心而觀察異世界的她再次來到了海邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "嗨。",
    "voice": "vo_adv_1320004_000",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我就知道你會來。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我在等你呀。",
    "voice": "vo_adv_1320004_001",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n因為這段時間",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你似乎常在海邊打工嘛。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "看你這樣子，",
    "voice": "vo_adv_1320004_002",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "應該已經下班了吧。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "當然",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我是看準你工作結束了才跟你打招呼的。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我才不想再從事肉體勞動呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "看你一臉疑惑，",
    "voice": "vo_adv_1320004_003",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你在想還有什麼事要找你對吧。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n你會這樣想也是理所當然。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "如你所料，",
    "voice": "vo_adv_1320004_004",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我有事要麻煩你。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "畢竟上次",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "把時間都花費在打工上了呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這次，",
    "voice": "vo_adv_1320004_005",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我想知道海邊作為娛樂的一面。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "簡單來說──",
    "voice": "vo_adv_1320004_006",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我想跟你共度時光。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "依然是毫不猶豫地回答啊。",
    "voice": "vo_adv_1320004_007",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就請你多指教囉。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……首先是暖身運動，",
    "voice": "vo_adv_1320004_008",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "要在開始活動前，",
    "voice": "vo_adv_1320004_009",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "擴展身體的可動範圍對吧。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這道理我懂。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "可是這個",
    "voice": "vo_adv_1320004_010",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "叫做廣播體操的……",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "運動量、",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "不會太多了嗎……",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "不確實做不行？",
    "voice": "vo_adv_1320004_011",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "比我想像的還注重形式呢，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你這個人……",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "原來如此。",
    "voice": "vo_adv_1320004_012",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "海邊娛樂的基本",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "是進到海裡。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "運動本身帶來的快感，",
    "voice": "vo_adv_1320004_013",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "以及水中減緩暑氣的清涼感。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "能夠一舉兩得，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這的確",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "是在海邊這地方的最佳娛樂了。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "在我原本所在的世界，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也有這樣的活動。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "問題是",
    "voice": "vo_adv_1320004_014",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這些含有鹽分的水。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這部分會帶來什麼影響，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n難以預測……",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "…………",
    "voice": "vo_adv_1320004_015",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……咕嚕咕嚕……",
    "voice": "vo_adv_1320004_016",
    "unit_id": 132011
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "雖因浮力提升而變得容易漂浮，但從另一個角度而言，",
    "voice": "vo_adv_1320004_017",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n要是不將海浪帶來的影響納入考量，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就可能會像剛剛的我一樣，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n落得悲慘下沉的結果。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "謝謝你救了我。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "而且，",
    "voice": "vo_adv_1320004_018",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這比我想得更容易讓人感到疲勞呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "看來游泳",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "不太適合我。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我們要在這沙灘",
    "voice": "vo_adv_1320004_019",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "做什麼？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n你之前會邊流汗",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "邊撿垃圾，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n也是因為有人會來使用的緣故吧。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "沙灘棒球、",
    "voice": "vo_adv_1320004_020",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "沙灘排球、",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "沙灘搶旗……",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n全都是我第一次聽到的字眼。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "縱然引起了我無窮的興趣，",
    "voice": "vo_adv_1320004_021",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n但不管哪一種，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "只有兩個人都玩不起來的話，那也只好放棄了呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n我們就等著看別人玩吧。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "其他還有……",
    "voice": "vo_adv_1320004_022",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "玩沙",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也是海邊特有的活動嗎？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……咦？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "往躺著的人身上",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "倒沙子，把人埋起來？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……你是不是把拷問和遊樂搞混了？",
    "voice": "vo_adv_1320004_023",
    "unit_id": 132011
  },
  {
    "type": "background",
    "bg_id": "500162"
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "轉眼間就晚上了呢。",
    "voice": "vo_adv_1320004_024",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "真是讓我深刻體會到了時間的有限。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "謝謝你帶我到處參觀。",
    "voice": "vo_adv_1320004_025",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "海邊……",
    "voice": "vo_adv_1320004_026",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "不僅匯聚了大量的水，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n還是個能夠窺見多元樣貌的地方。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我會有這樣的感想，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "或許也是有你這個導覽人的緣故。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "那就好。",
    "voice": "vo_adv_1320004_027",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "難得有人會說跟我在一起",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "很開心。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我也覺得",
    "voice": "vo_adv_1320004_028",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "似乎拉近了一點和你的距離。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "對了，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "大概就像你曾經說過的",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "朋友",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "那種感覺。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "所以……",
    "voice": "vo_adv_1320004_029",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我有一個",
    "voice": "vo_adv_1320004_030",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "提議。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "still",
    "still_id": "132000401"
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "──你要不要跟我",
    "voice": "vo_adv_1320004_031",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "簽訂契約？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "對，",
    "voice": "vo_adv_1320004_032",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "簽訂契約。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也可以說是和我締結合作關係。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "如你所知，我對",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "求知的欲望可說幾乎沒有上限。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n因此，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "即使是你不知道",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "或無從得知的事，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我也知之甚多。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "只要你和我簽訂契約，",
    "voice": "vo_adv_1320004_033",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我就會傾盡所有知識，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n給你想知道的答案。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我可以斷言這一定對喪失記憶的你有所幫助。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也許你會感到疑問，",
    "voice": "vo_adv_1320004_034",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "為什麼需要這種契約？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "但你想想看。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n我原本",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "並非這個世界的居民。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我會在何時、",
    "voice": "vo_adv_1320004_035",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "哪個時間點，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "被迫中斷這段珍貴的聯繫，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n並且離開這個世界，都不知道。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "正因如此，",
    "voice": "vo_adv_1320004_036",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我希望將這次邂逅",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "化為確實的連結永存。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這或許可稱之為羈絆。",
    "voice": "vo_adv_1320004_037",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n你和我透過這次邂逅，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "在夏日海邊",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "培育的羈絆，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n我希望能藉由契約的形式",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "將它化為永恆。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這可是",
    "voice": "vo_adv_1320004_038",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "需要鼓起很大勇氣的發言喔──",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我也是女孩子嘛。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我欣賞你，",
    "voice": "vo_adv_1320004_039",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "傾心於你的可能性。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我願意不顧羞恥，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "對你說這是命運哦。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n我想要一直看著你。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我想坐在頭等席，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "看著你的所見所聞。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你稱呼我為朋友，",
    "voice": "vo_adv_1320004_040",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n真的讓我很高興。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "still",
    "still_id": "132000402"
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你是",
    "voice": "vo_adv_1320004_041",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這個世界裡「未知」的結晶，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n滿足我好奇心的甜美果實。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我注視著你。",
    "voice": "vo_adv_1320004_042",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n我不希望你這個「未知」",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "僅僅是轉瞬之間的存在。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n相對的，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我會成為引導你的指標。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "可以嗎……？",
    "voice": "vo_adv_1320004_043",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你至今",
    "voice": "vo_adv_1320004_044",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也答應過許多次我的拜託不是嗎？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n結果",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "應該不曾帶給你任何不利。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n你就把這次也當作一樣的情形就好──",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "──那份契約，",
    "voice": "vo_adv_1320004_045",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "給我等一下。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500162"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "哎呀。",
    "voice": "vo_adv_1320004_046",
    "unit_id": 132011
  },
  {
    "type": "background",
    "bg_id": "502340"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我再說一次，",
    "voice": "vo_adv_1320004_047",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "給我等一下。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我不認同",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那份契約。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你也別",
    "voice": "vo_adv_1320004_048",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "遇到什麼事都只會點頭。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這情形怎麼想都很怪吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……比我預期的還早插手呢。",
    "voice": "vo_adv_1320004_049",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "看來愛梅斯妳比我想的",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "還更執著於他。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "從外表真是看不出來呢，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你這萬人迷。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "別在那邊恣意妄為了，",
    "voice": "vo_adv_1320004_050",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "艾姬多娜。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我允許妳一定程度的行動，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但如果妳要對{0}出手，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我可不會坐視不管。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "出手，",
    "voice": "vo_adv_1320004_051",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "還真是個",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "容易引人誤會的說法呢。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我只是",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "問他要不要簽訂契約而已。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳說的那個什麼契約，",
    "voice": "vo_adv_1320004_052",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n看來並未充分說明呀？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "為何想跟他簽訂契約，",
    "voice": "vo_adv_1320004_053",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n簽訂契約後我們雙方可以獲得什麼，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我以為我已經說得很清楚了。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "魔女的契約是很重要的東西。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我不會說謊。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳",
    "voice": "vo_adv_1320004_054",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "確實說了會得到什麼。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是──",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "卻沒說明有可能失去什麼。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不照實說明損失的契約，",
    "voice": "vo_adv_1320004_055",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我沒辦法視而不見。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……為了達成目的，",
    "voice": "vo_adv_1320004_056",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "本就有可能會失去些什麼。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "但那算是",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我的契約造成的結果嗎？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n也有可能無論如何",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "事情的發展都只有那種結果。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳少用缺乏具體性的話語敷衍我。",
    "voice": "vo_adv_1320004_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳只是想要可以觀測這世界的",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "「眼睛」對吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "一雙會乖乖聽從妳的建言，",
    "voice": "vo_adv_1320004_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n配合妳實驗的「眼睛」。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "還有，",
    "voice": "vo_adv_1320004_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要談約定時",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n才頭一次說出什麼羈絆的傢伙不值得信任。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你也要記住喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……真受不了。",
    "voice": "vo_adv_1320004_060",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n被拆散關係到這地步，我也沒轍了。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "愛梅斯──",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "妳也很有意思呢。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那真是多謝了。",
    "voice": "vo_adv_1320004_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "可是我不會和妳簽訂契約的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "抱歉了──",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "──引導並守護這傢伙，",
    "voice": "vo_adv_1320004_062",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是我的任務。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……原來如此。",
    "voice": "vo_adv_1320004_063",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "雖然很遺憾，",
    "voice": "vo_adv_1320004_064",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "但現在除了撤退似乎也別無他法了呢。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "那今天我就先告辭了。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "艾姬多娜，",
    "voice": "vo_adv_1320004_065",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n妳……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在打什麼主意？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "──我可是「強欲的魔女」呢。",
    "voice": "vo_adv_1320004_066",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n為了得到想要的一切，我會勤勉努力的。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就是這樣。",
    "voice": "vo_adv_1320004_067",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n我要離開了。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "雖然遺憾讓你對我有所懷疑……",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你這傢伙真是……",
    "voice": "vo_adv_1320004_068",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "──呵呵。",
    "voice": "vo_adv_1320004_069",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "看來我似乎",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "不必擔心什麼懷疑了。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "哪怕是邪惡的魔女，",
    "voice": "vo_adv_1320004_070",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "在你面前也會消失得無影無蹤。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "那麼，",
    "voice": "vo_adv_1320004_071",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "之後有機會再來見你吧。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n下次真想",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "邀請你來參加我的茶會呢。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "等到回過神來，她的身影已經從現場消失了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n彷彿一開始就沒有任何東西存在過。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n「強欲的魔女」艾姬多娜已然離去。",
    "voice": null,
    "unit_id": null
  }
]
