    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我不能離開這座城堡。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "比起一見，",
