[
  {
    "type": "background",
    "bg_id": "501720"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "背面世界「吉歐‧提格尼亞」──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n統治此地的萊拉耶爾公主，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n今天也坐在王座上，讀著家臣送上來的報告。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_1265001_000",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這樣一來文件就全部讀完了吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這次的報告",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "看來是沒有發生什麼大問題呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "嗯，",
    "voice": "vo_adv_1265001_001",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "好了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n既然工作也結束了……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我來",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "睡一下午覺吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呼",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "啊……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_1265001_002",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "…………",
    "voice": "vo_adv_1265001_003",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "咳咳。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "午安，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "啊啊……",
    "voice": "vo_adv_1265001_004",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n果然",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "被你看見了呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我還在想",
    "voice": "vo_adv_1265001_005",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "說不定沒有被看到……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n沒想到會讓人看見我嘴巴張得那麼開的模樣……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "真是不好意思……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士……",
    "voice": "vo_adv_1265001_006",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你真的是",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "很溫柔呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n那樣的話，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "也請你",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "將這件事當成我們兩人的祕密吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "可愛……？",
    "voice": "vo_adv_1265001_007",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "真是的，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "請你別捉弄我了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n你這個人",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "也是有壞心眼的地方呢……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "所以……",
    "voice": "vo_adv_1265001_008",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n你今天來是有什麼事嗎？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "伴手禮……？",
    "voice": "vo_adv_1265001_009",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這麼說來，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你有說過為了處理事情，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n所以要回去你們的世界呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "異國的伴手禮……",
    "voice": "vo_adv_1265001_010",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "有股好香的氣味。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是食物嗎？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那麼，",
    "voice": "vo_adv_1265001_011",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我們就一起享用吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "來，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "到我的身旁來。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "哎呀……！",
    "voice": "vo_adv_1265001_012",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n這是你們的世界的甜點對吧？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "巧克力、餅乾……",
    "voice": "vo_adv_1265001_013",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這個是",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "馬卡龍嗎。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "沒有放太多的奶油呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "每個看起來都好好吃♪",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "好的。",
    "voice": "vo_adv_1265001_014",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那麼，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我就先來吃這個馬卡龍吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我開動了…………",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "啊嗯。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "啊啊……",
    "voice": "vo_adv_1265001_015",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n好好吃……♪",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "能襯托出素材味道，",
    "voice": "vo_adv_1265001_016",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "恰到好處的甜度……♪",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吃起來清脆爽口。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這會讓人",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "忍不住一口接一口呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呵呵。",
    "voice": "vo_adv_1265001_017",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n甜點能夠跨越世界的藩籬呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_1265001_018",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這些",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "都跟「吉歐‧提格尼亞」的甜點很像似。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "卻不盡然相同，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "而有著自己的獨特之處。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "雖然我們的確是屬於不同的世界，",
    "voice": "vo_adv_1265001_019",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "然而",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "心中對於「美味」的感受卻沒有不同。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n這是件很美好的事情。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "透過這點讓我體會到了，",
    "voice": "vo_adv_1265001_020",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n即使生長的世界不同……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我們的心還是能夠相通。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……阿斯特賴亞大陸。",
    "voice": "vo_adv_1265001_021",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還有蘭德索爾。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "在聽過你和克蘿茜的描述後，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我心裡是這麼想的……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n說不定我們的世界比我們想像的，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還要更靠近彼此。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "要說不好奇的話，",
    "voice": "vo_adv_1265001_022",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那是騙人的。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n無論是身為國家與人民的守護者……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還是",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "以個人的身分來說。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……騎士。",
    "voice": "vo_adv_1265001_023",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n今後，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "也請告訴我關於你們世界的事情吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n無論是多麼微不足道的事情都無所謂……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "一起到那邊……？",
    "voice": "vo_adv_1265001_024",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……呵呵。",
    "voice": "vo_adv_1265001_025",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n俗話說「百聞不如一見」，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我過去，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "也曾經跟克蘿茜這麼說過。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "對於你的心意",
    "voice": "vo_adv_1265001_026",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我感到很高興……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "然而我是",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "萊拉耶爾公主。",
