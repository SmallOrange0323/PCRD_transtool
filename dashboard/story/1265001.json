  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n你應該早就知道",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "信件的內容了，對吧？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "前些天，",
    "voice": "vo_adv_1265001_045",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我們才聊過旅行的話題，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就來了這封邀請函……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我不覺得這是單純的巧合。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你是不是",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "和貪吃佩可公主說了些什麼呢？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_1265001_046",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "果然",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是這樣啊。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "沒事的。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我沒有生氣。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "看來讓你費心了呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你這份心意，",
    "voice": "vo_adv_1265001_047",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我非常感激。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "當然，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我也很感謝貪吃佩可公主的用心……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但是……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我忍不住會去思考，",
    "voice": "vo_adv_1265001_048",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n雖然說只是暫時的，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但是身為公主的我……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "離開國家真的好嗎？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "咦？",
    "voice": "vo_adv_1265001_049",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "的、",
    "voice": "vo_adv_1265001_050",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "的確……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是這樣沒錯呢。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n貪吃佩可公主",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "雖然和我一樣身為公主……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n卻時常來到這邊的世界。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這是我沒有想過的呢。",
    "voice": "vo_adv_1265001_051",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……說不定，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是我把事情想得太過嚴重了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n連我自己都沒有意識到。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "只要指示女僕長等人在留守時該如何應對，",
    "voice": "vo_adv_1265001_052",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "再讓克蘿茜擔任護衛隨行……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n如果是短期間的話，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "應該沒有問題才對。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "…",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "…我了解了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "貪吃佩可公主的邀請，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我很樂意接受。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "能請你幫忙帶路嗎？",
    "voice": "vo_adv_1265001_053",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "帶我到你們的世界──",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "阿斯特賴亞大陸去。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "background",
    "bg_id": "501660"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是在隔天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "時間差不多了，",
    "voice": "vo_adv_1265001_054",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "時間差不多了！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n差不多是普蕾西亞告訴過我",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n天上要開洞的時候了♪",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "克蘿小姐",
    "voice": "vo_adv_1265001_055",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "也太興奮了吧。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "妳是有多想去蘭德索爾啊？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "因為因為！",
    "voice": "vo_adv_1265001_056",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n之前去蘭德索爾的時候，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我就有在想了！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n下次一定要和萊拉耶爾殿下一起來！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "所以我現在才會這麼興奮！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "克蘿茜小姐。",
    "voice": "vo_adv_1265001_057",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n這次可不是單純去觀光而已哦？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "妳可要好好保護萊拉耶爾殿下，知道嗎？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我知道的～！",
    "voice": "vo_adv_1265001_058",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我可是",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "騎士呢！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n護衛的事情交給我就沒問題！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "真、",
    "voice": "vo_adv_1265001_059",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "真的沒問題嗎……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n妳可別在其他世界迷路了哦？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老姊，",
    "voice": "vo_adv_1265001_060",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "妳操心過頭了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "如果妳那麼擔心，不如一起跟去如何？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "咦咦！？",
    "voice": "vo_adv_1265001_061",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "這個的話，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我還沒有做好心理準備……！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "哈哈，",
    "voice": "vo_adv_1265001_062",
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "沒事啦。",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "這次不僅有小子在，",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "佩可小妹也在對面等著。",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "\\n不會有問題的。",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "沃爾加諾。",
    "voice": "vo_adv_1265001_063",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我們不在的這段期間，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "國家就交給你守護了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "遵命！",
    "voice": "vo_adv_1265001_064",
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "請交給臣吧，公主殿下！",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "……開玩笑的啦。",
    "voice": "vo_adv_1265001_065",
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "\\n放心，",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "我們這裡會照常工作的，",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "\\n請您好好去放鬆一下吧。",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "謝謝你。",
    "voice": "vo_adv_1265001_066",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n那麼就交給各位了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……啊。",
    "voice": "vo_adv_1265001_067",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n現在的天空，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "好像比較有那種感覺了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n是跟對面連在一起了嗎？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "沒錯沒錯！",
    "voice": "vo_adv_1265001_068",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n萊拉耶爾殿下，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "您準備好了嗎？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "嗯。",
    "voice": "vo_adv_1265001_069",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我隨時都能出發。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "…………",
    "voice": "vo_adv_1265001_070",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n琳德，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "烏爾姆，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "沃爾加諾。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我出發了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "祝您一路順風。",
    "voice": "vo_adv_1265001_071",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呵呵。",
    "voice": "vo_adv_1265001_072",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那麼……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "克蘿茜。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我們踏上旅程吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "朝著未曾探訪的異國之地──",
    "voice": "vo_adv_1265001_073",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n阿斯特賴亞大陸啟程。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……就這樣。",
    "voice": "vo_adv_1265001_074",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我們一行人",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "離開了「吉歐‧提格尼亞」。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "對我而言，",
    "voice": "vo_adv_1265001_075",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這是第一次的旅行……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n不，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "或許該說是第一次的冒險。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "冒險……",
    "voice": "vo_adv_1265001_076",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n對於在城堡裡生活至今的我而言，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n那是個極為陌生的詞彙。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……啊啊，",
    "voice": "vo_adv_1265001_077",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "怎麼辦呢？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n在不知不覺間，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我的心臟跳得好快。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n這是不安？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還是期待？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "或者說……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是他握著我的手",
    "voice": "vo_adv_1265001_078",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "所傳來的溫度──",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n而因此，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "讓我感到有點不知所措了。",
    "voice": null,
    "unit_id": 126511
  }
]
