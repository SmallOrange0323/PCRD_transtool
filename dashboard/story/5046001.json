  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "成為沙灘棒球社顧問的美里，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n放學後，讓社員們到教室集合。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "幹嘛啊，",
    "voice": "vo_adv_5046001_000",
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "突然叫我來。",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "\\n我很累想快點回去啊。",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀～",
    "voice": "vo_adv_5046001_001",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大地，你來了",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我好高興呀～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這邊就是全部的社員了嗎～？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "是的。",
    "voice": "vo_adv_5046001_002",
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "大家都到齊了。",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "喂，",
    "voice": "vo_adv_5046001_003",
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "這個組合……",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒錯。",
    "voice": "vo_adv_5046001_004",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "其實呢，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我有事要向沙灘棒球社的大家",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "報告～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我呀，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "成為社團的顧問了～！",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "啥？",
    "voice": "vo_adv_5046001_005",
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "妳說什麼？",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "美里老師",
    "voice": "vo_adv_5046001_006",
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "成為",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "我們的顧問了喔。",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大家，",
    "voice": "vo_adv_5046001_007",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "接下來就請多多指教了唷。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我們一起往夏季全國大賽邁進吧～！",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "哼……",
    "voice": "vo_adv_5046001_008",
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "現在才找顧問已經太遲了。",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "\\n而且我早就說過好幾次，",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "\\n我再也不打什麼沙灘棒球了。",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "畢竟我們說到底是連規則都不懂的外行人。",
    "voice": "vo_adv_5046001_009",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n現在才開始練，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "根本來不及啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "……哼，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "我本來就沒有要認真參加啦！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀～",
    "voice": "vo_adv_5046001_010",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那為什麼要加入沙灘棒球社呢？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就算沒經驗",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "也有點興趣吧～？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "妳才剛來，不知道也情有可原啦……",
    "voice": "vo_adv_5046001_011",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n這個學校",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "有個無聊的規定，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n就是",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "所有的學生都必須加入社團。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "不過啊……",
    "voice": "vo_adv_5046001_012",
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "沙灘棒球會用到球棒和釘鞋對吧。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "\\n",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "這邊到處都是",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "適合用來打架的工具啊。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "\\n成為社員的話，",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "這些道具就可以",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "隨我們用了嘛。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "我只是喜歡可以隨意地玩、不受拘束的社團。",
    "voice": "vo_adv_5046001_013",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n我們的青春，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "不管是特約講師還是誰，都不准來阻礙！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "怎樣？",
    "voice": "vo_adv_5046001_014",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "我看起來不像熱烈歌頌著青春的學生嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "是啊，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "你想得沒錯……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "不要緊，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "我就特別告訴你們吧。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "我就是這所學校裡反覆留級十多年……",
    "voice": "vo_adv_5046001_015",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "人稱留級王的男人！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀",
    "voice": "vo_adv_5046001_016",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "所以啦，",
    "voice": "vo_adv_5046001_017",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "我們不聽任何人的指導。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "如果無論妳如何都希望我們打沙灘棒球，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n就先讓我們看看妳有沒有當顧問的資格吧。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "說的沒錯……",
    "voice": "vo_adv_5046001_018",
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "沙灘球場上應該到處都有球。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "\\n",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "如果妳去把球全部撿起來，",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "幫我們擦乾淨的話，",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "\\n倒是可以考慮考慮。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "不過我們只顧著玩，",
    "voice": "vo_adv_5046001_019",
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "東西到處亂丟都沒在收的，",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "\\n現在應該髒得不得了啦。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "\\n……大地，",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "你也覺得這樣可以吧？",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "哼，",
    "voice": "vo_adv_5046001_020",
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "關我什麼事。",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "要怎麼做隨便妳。",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "\\n這跟我一點關係也沒有。",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "美里老師，",
    "voice": "vo_adv_5046001_021",
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "我也會幫忙！",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "\\n我作為隊長，",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "請讓我協助您！",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "等等，",
    "voice": "vo_adv_5046001_022",
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "旭。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "這件事如果不讓老師自己做就沒有意義了。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "\\n這是為了要證明，",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "她適不適合當顧問嘛。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "\\n……所以要是你敢多管閒事的話，",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "就給我走著瞧。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "唔……",
    "voice": "vo_adv_5046001_023",
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵，",
    "voice": "vo_adv_5046001_024",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒問題唷～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我會和{0}一起完成，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "交給我們吧～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "抱歉，",
    "voice": "vo_adv_5046001_025",
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "老師……",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "不過，",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "我很高興您願意成為我們的顧問。",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "\\n我入社的時候，",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "社團裡",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "就沒有顧問了，",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "\\n這件事對這個社團來說，",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "是相當大的進步呢！",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "搞不好",
    "voice": "vo_adv_5046001_026",
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "因為這樣，",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "\\n其他人也會想來打沙灘棒球呢……",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "別看大地那樣，",
    "voice": "vo_adv_5046001_027",
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "其實他非常喜歡沙灘棒球的。",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "\\n如果社團能夠重整旗鼓的話，",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "也許他會願意回來……",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵，",
    "voice": "vo_adv_5046001_028",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "為了大家",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我會加油的～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "一起為社團努力吧～！",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "非常謝謝您，老師！",
    "voice": "vo_adv_5046001_029",
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "\\n",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "……我會",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "去找個沙灘，",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "旭",
    "words": "自己練習的！",
    "voice": null,
    "unit_id": 5013
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那麼，{0}，",
    "voice": "vo_adv_5046001_030",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我們去",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "球場吧～！",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……哎呀？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "喔呀，",
    "voice": "vo_adv_5046001_031",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "美里老師。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "妳和社員們談過了吧。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "他們肯定",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "為了妳成為顧問一事在抗議吧。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "他們一開始好像感到很困惑沒錯……",
    "voice": "vo_adv_5046001_032",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "只要我作為顧問展現出可靠的一面，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n他們就會來練習唷，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我們已經約定好了～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "事情會這麼順利嗎……",
    "voice": "vo_adv_5046001_033",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n就算妳打算履行約定，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "也不曉得他們真的有心要遵守啊。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……哎呀，",
    "voice": "vo_adv_5046001_034",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這是怎麼回事～？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "啊糟糕，",
    "voice": "vo_adv_5046001_035",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "忘了東西。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "……嗯？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "是新來的老師和校長嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "他們在聊什麼……？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "社員們大多是外行人，",
    "voice": "vo_adv_5046001_036",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "沒有認真要參與的意思。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n只不過是按照學校規定加入社團，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n而球棒也不是用來打球的，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "只會用來做些下三濫的事情。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "和這麼差勁的學生談什麼約定？",
    "voice": "vo_adv_5046001_037",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "光是和他們說話都浪費時間。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n妳可是任期有限的",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "特約講師。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n做這些沒意義的事，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "並不會讓妳的時間變得有價值哦？",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "他們不過是一群什麼事都做不成，",
    "voice": "vo_adv_5046001_038",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "\\n一輩子自甘墮落、",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "毫無用處的人而已。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀哎呀……",
    "voice": "vo_adv_5046001_039",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n那些孩子，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "絕不是",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "毫無用處的唷。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "每個孩子，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "都會有屬於自己的天賦～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "只是有些孩子，",
    "voice": "vo_adv_5046001_040",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n在成長過程中，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "還沒察覺到自己的潛能而已。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這一點，",
    "voice": "vo_adv_5046001_041",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我認為",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不管是這邊的學生們，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n還是我平常照顧的孩子們，都是一樣的唷～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大家，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "肯定都能擁有美好的未來。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "雖然",
    "voice": "vo_adv_5046001_042",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大部分的社員都沒有經驗，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "但是若不試試看也不知道結果如何呀～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "說不定，",
    "voice": "vo_adv_5046001_043",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大家都能成為優秀的選手。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "而在旁守望著這樣的可能性，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n不就是身為老師的職責嗎？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "如果",
    "voice": "vo_adv_5046001_044",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "校長您還是認為不可能的話……",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那就由我證明給您看。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我絕對會和他們，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "一起去參加",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "夏季全國大賽的～！",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "……我會誠心希望，",
    "voice": "vo_adv_5046001_045",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "校長",
    "words": "妳這個不成熟的心願真的能夠實現。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "那傢伙……",
    "voice": "vo_adv_5046001_046",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "是認真這麼想的嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n還是",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "跟其他老師一樣，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "只是在有權勢的人面前裝模作樣而已……？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "就讓我們見識一下吧。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "background",
    "bg_id": "501100"
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "啊～",
    "voice": "vo_adv_5046001_047",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "真想睡。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "上課好無聊，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "乾脆翹掉吧。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "\\n就沒有什麼",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "新鮮事可做嗎……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "要不還是來欣賞一下鈴奈的寫真集吧……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "啊，",
    "voice": "vo_adv_5046001_048",
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "寫真集",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "還放在我家耶。",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "什麼！？",
    "voice": "vo_adv_5046001_049",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "你這傢伙，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "差不該還給我了吧！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "\\n要是敢占為己有，我可饒不了你！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "新鮮事嗎……",
    "voice": "vo_adv_5046001_050",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "話說回來，那位叫美里的老師，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "不就蠻有趣的嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n昨天，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "我看到她在和校長說話，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n總覺得她跟以往來我們學校的老師",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "都不一樣。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "感覺",
    "voice": "vo_adv_5046001_051",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "她好像挺不賴的。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "感覺是來自森林，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "現在罕見的",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "熱血老師喔。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "……！",
    "voice": "vo_adv_5046001_052",
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "很痛耶！",
    "voice": "vo_adv_5046001_053",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "敢突然打我很有種嘛！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "不懂什麼叫敬老尊賢嗎！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "「感覺她好像挺不賴的」？",
    "voice": "vo_adv_5046001_054",
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "\\n老師全都是一群",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "看不起我們的垃圾，",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "\\n別說傻話了。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "唔……",
    "voice": "vo_adv_5046001_055",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "可是啊……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "喂，",
    "voice": "vo_adv_5046001_056",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "大夥們！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "看那邊！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "\\n球場的角落好像有人耶？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "哼……",
    "voice": "vo_adv_5046001_057",
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "雖然不知道是哪個學校的傢伙，",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "\\n就讓我們來教教他，",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "亂闖進別人的學校裡會有什麼下場！",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "等、",
    "voice": "vo_adv_5046001_058",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "等一下。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "那個，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "該不會是……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "still",
    "still_id": "504600101"
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "那傢伙……！？",
    "voice": "vo_adv_5046001_059",
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "一大早的到底在幹什麼？",
    "voice": "vo_adv_5046001_060",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "誰知道。",
    "voice": "vo_adv_5046001_061",
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "快點把她趕走。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "501100"
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大家，",
    "voice": "vo_adv_5046001_062",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我等你們好久囉～",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "依照約定，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我正好把球",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "全都擦乾淨了喲。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "還有，",
    "voice": "vo_adv_5046001_063",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "髒掉的球衣也",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "都洗好了～",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我總是在幫孩子們洗衣服，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "對自己的技術還蠻有信心的哦！",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是不是純白無暇～？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "妳說的約定……",
    "voice": "vo_adv_5046001_064",
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "是指什麼？",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀～？",
    "voice": "vo_adv_5046001_065",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我把掉在球場的球全部擦乾淨的話，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n你們就會來練習的",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不是嗎～",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "妳真的從那時候開始就一直做到現在嗎！？",
    "voice": "vo_adv_5046001_066",
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "\\n那種隨便說說的話",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "妳竟然當真？",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "腦袋沒問題嗎！？",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "你看？",
    "voice": "vo_adv_5046001_067",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "我就說這老師果然",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "和其他傢伙不一樣吧？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n她真的是在為我們著想……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "要不然做不出這種事。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "說什麼蠢話！",
    "voice": "vo_adv_5046001_068",
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "老師什麼的，",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "全都一樣。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "\\n根本沒一個是可以相信的！",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "她一定有什麼企圖！",
    "voice": "vo_adv_5046001_069",
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "\\n我是不知道特約講師是來幹嘛的，",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "\\n反正就是想拿我們找樂子裝好人吧！",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "不，",
    "voice": "vo_adv_5046001_070",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "我會照約定來參加社團活動。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員1",
    "words": "久違地活動一下身體，對健康也不錯呢！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "嘻嘻……",
    "voice": "vo_adv_5046001_071",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "那我也陪你們玩玩吧。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "你們幾個……",
    "voice": "vo_adv_5046001_072",
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "是認真的嗎？",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "對啊！",
    "voice": "vo_adv_5046001_073",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "我一直想要來點新的刺激。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "社員2",
    "words": "\\n用來消磨時間也好！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵，",
    "voice": "vo_adv_5046001_074",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "老師好高興呢～！",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "一起加油吧。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你們兩個意下如何呢？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "真是的，",
    "voice": "vo_adv_5046001_075",
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "煩得要死。",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "\\n我就說再也不打了！",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "……我知道了。",
    "voice": "vo_adv_5046001_076",
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "我也來打吧。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "\\n約定就是約定。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "不遵守約定就算不上是男人了。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "連你都……？",
    "voice": "vo_adv_5046001_077",
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "\\n",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "我是在作夢嗎……？",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "不過，",
    "voice": "vo_adv_5046001_078",
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "社員3",
    "words": "我們會用自己的方式打。",
    "voice": null,
    "unit_id": 5212
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "哼……",
    "voice": "vo_adv_5046001_079",
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "原來是這麼一回事。",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "\\n你也蠻無賴的嘛……",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "大地",
    "words": "好好享受吧。",
    "voice": null,
    "unit_id": 5112
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大地",
    "voice": "vo_adv_5046001_080",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "如果改變心意，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "隨時歡迎你回來唷。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那麼，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就從今天放學後",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "開始練習吧～！",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "履行了和社員們的約定，美里和{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n以重建沙灘棒球社為目標，邁出了第一步。",
