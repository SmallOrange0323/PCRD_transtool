    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n透過星素之力感受到了……",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "她們兩個的悲痛……",
    "voice": "vo_adv_5137323_005",
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "苦惱………",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "憤怒……",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這還只是其中的一部分嗎……",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……做個了結吧，",
    "voice": "vo_adv_5137323_006",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "各位。",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "日和……",
    "voice": "vo_adv_5137323_007",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊，",
    "voice": "vo_adv_5137323_008",
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "做個了結吧。",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n可不能讓精靈一直為所欲為下去。",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要把精靈",
    "voice": "vo_adv_5137323_009",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "從兩人身上趕出去……",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "然後獲勝！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "已經不會──",
    "voice": "vo_adv_5137323_010",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n再讓她們兩個的笑容被奪走了！",
    "voice": null,
    "unit_id": 128711
