[
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好，",
    "voice": "vo_adv_5128203_000",
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "打倒它了！",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "──咦？那傢伙！",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "居然還能動！？",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看來事情還沒有",
    "voice": "vo_adv_5128203_001",
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就這樣告一段落呢。",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "對手",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "似乎在被徹底破壞前都不會停下來。",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那傢伙，",
    "voice": "vo_adv_5128203_002",
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是打算從它逃向的地方再射出那道光線嗎？",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "居然",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要在這大得要命的沙漠中玩鬼抓人，",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n真是讓人受夠了……",
    "voice": null,
    "unit_id": 127511
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但如果不管它，",
    "voice": "vo_adv_5128203_003",
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要是被那道光線射到也不是鬧著玩的呢。",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "只能靠我們來打倒它了，",
    "voice": null,
    "unit_id": 127611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "快去追它吧。",
    "voice": null,
    "unit_id": 127611
  }
]
