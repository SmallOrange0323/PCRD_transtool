  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_9002014_000",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你好～",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵，",
    "voice": "vo_adv_9002014_001",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這是這次的包裹呢。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n辛苦你了～",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "謝謝你",
    "voice": "vo_adv_9002014_002",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "總是遠道而來，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n非常了不起唷～♪",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……哎呀？",
    "voice": "vo_adv_9002014_003",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "表情看起來有點沒精神呢～",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是因為漫長的旅程覺得累了嗎～？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "來，",
    "voice": "vo_adv_9002014_004",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "過來這裡吧～",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n就在老師的膝蓋上",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "休息一下～",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "很好很好，",
    "voice": "vo_adv_9002014_005",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是個乖孩子呢～",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "因為你很認真，",
    "voice": "vo_adv_9002014_006",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n一定是太過努力了呢～",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "still",
    "still_id": "504600701"
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過",
    "voice": "vo_adv_9002014_007",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "老師也受到你這種直率的個性",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "很多幫助呢……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你為我創造了閃閃發亮的回憶，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是我自豪的學生呢～",
    "voice": null,
    "unit_id": 101512
  },
