    "name": "栞",
    "words": "想要",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "互相觸碰之類的，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "更親密地……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可是，",
    "voice": "vo_adv_1123003_001",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我沒有積極地主動",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "向他靠近",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "的勇氣……",
    "voice": null,
    "unit_id": 103811
