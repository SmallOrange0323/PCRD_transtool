  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某日發生的事情——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n栞在上一次成功突破了身為魔法少女的內心糾葛，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而在她的心中萌生了一個新的想法。",
