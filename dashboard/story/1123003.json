    "name": "栞",
    "words": "想要",
    "voice": "vo_adv_1123003_000",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "和{0}再拉近一些距離呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不只是談天，",
    "voice": null,
    "unit_id": 103811
