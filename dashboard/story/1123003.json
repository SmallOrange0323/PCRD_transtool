    "type": "dialogue",
    "name": "栞",
    "words": "……不對，",
    "voice": "vo_adv_1123003_002",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這樣不可以！",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n改變人的情感的魔法是被禁止的，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "書上都有寫呢。",
