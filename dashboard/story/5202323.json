[
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "呀……！",
    "voice": "vo_adv_5202323_000",
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n那孩子的聲音……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "變得",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "更加",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "激烈了……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "終於變得停不下來了呢。",
    "voice": "vo_adv_5202323_001",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "必須趁狀況惡化之前阻止它！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "都到這裡了，",
    "voice": "vo_adv_5202323_002",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "一定不會有問題的。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n因為，",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "有千歌小姐她們跟我們一起嘛。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "獨自一人的話",
    "voice": "vo_adv_5202323_003",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "或許會覺得不安。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但是，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "現在！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "一起唱歌吧，",
    "voice": "vo_adv_5202323_004",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "蘭法小姐。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n為了那孩子的演唱。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "好……",
    "voice": "vo_adv_5202323_005",
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "晚安……",
    "voice": "vo_adv_5202323_006",
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "這就是，",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "最後了……！",
    "voice": null,
    "unit_id": 134311
  }
]
