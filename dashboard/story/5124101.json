  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]接連發生靈異現象的",
    "voice": "vo_adv_5124101_000",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]恐怖海灘度假村……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]……根據除靈委託書來看，",
    "voice": "vo_adv_5124101_001",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n[FFFFFFFF]就是這座度假村沒錯呢。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]能感受到這裡散發著強烈靈氣……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]爸爸也小心一點。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]哼哼！",
    "voice": "vo_adv_5124101_002",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]本大爺怎麼可能輸給路邊的幽靈！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]趕快打倒幽靈，大賺一筆酬金吧，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]忍！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]唉。",
    "voice": "vo_adv_5124101_003",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]一直這麼大意，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]總有一天會倒楣的喔？",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]才不會！",
    "voice": "vo_adv_5124101_004",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]相信爸爸吧！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]哇哈哈！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]這次我一定",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]要在夏日沙灘浪漫豔遇，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]幫妳找一個媽媽！！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "[FFFFFFFF]唉……",
    "voice": "vo_adv_5124101_005",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n[FFFFFFFF]完全沒有在聽人說話……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "[FFFFFFFF]我看看……",
    "voice": "vo_adv_5124101_006",
    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n[FFFFFFFF]海灘度假村──",
