    "words": "[FFFFFFFF]蘭德索爾」。",
    "voice": null,
    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n[FFFFFFFF]就是這裡呢……？",
    "voice": null,
    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "[FFFFFFFF]嘻嘻嘻……",
