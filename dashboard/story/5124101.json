  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n[FFFFFFFF]終於來到這裡了～",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
