    "type": "dialogue",
    "name": "紫布菜",
    "words": "比平常還要好吃。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "你記得嗎？",
