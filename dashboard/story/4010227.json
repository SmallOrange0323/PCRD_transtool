    "type": "dialogue",
    "name": "紫布菜",
    "words": "還有甜味。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我過去",
    "voice": "vo_adv_4010227_007",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "一直專注在滑冰上，",
    "voice": null,
    "unit_id": 106432
  },
