    "type": "dialogue",
    "name": "紫布菜",
    "words": "看，",
    "voice": "vo_adv_4010227_003",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "那邊有烤番薯攤。",
