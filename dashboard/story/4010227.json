    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n但這好像是我第一次",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "跟家人以外的人度過。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "光是像這樣一起走在外面，",
    "voice": "vo_adv_4010227_001",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "也很新鮮呢。",
    "voice": null,
    "unit_id": 106432
  },
  {
