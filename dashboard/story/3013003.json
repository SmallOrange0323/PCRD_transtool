    "words": "禊、禊！美美！",
    "voice": "vo_adv_3013003_050",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我不是說不能輕易地就相信他嗎！",
    "voice": null,
