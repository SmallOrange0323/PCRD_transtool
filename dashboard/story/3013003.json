    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "也是，你在蘭德索爾的街上也是這個樣子……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "話說回來禊真慢呢～",
