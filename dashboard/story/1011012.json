    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "糟糕！",
    "voice": "vo_adv_1011012_061",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "\\n魔物被香的味道",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "給吸引過來了！",
