    "type": "dialogue",
    "name": "莽夫１",
    "words": "呀――！　",
    "voice": "vo_adv_1011012_062",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "你等等我啊，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "大哥！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "你這蠢蛋！　",
    "voice": "vo_adv_1011012_063",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "別過來這裡啊！　",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "可惡――！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "\\n為什麼會遇到這種事啊――！",
    "voice": null,
