    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "只要用全力射擊就行了……！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "已經沒問題了！",
    "voice": "vo_adv_1011012_055",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "只要和哥哥在一起，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妹妹就是無敵的！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "無論是瞄準射擊還是全體射擊……",
    "voice": "vo_adv_1011012_056",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "全部一起上吧！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "三心二意者，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "一刀兩斷！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我要上囉～！",
    "voice": "vo_adv_1011012_057",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "『日冕箭雨』！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "啊，",
    "voice": "vo_adv_1011012_058",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "就算那樣隨便射出去，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "也只會卡在樹枝上……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "欸，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "這是何等的威力啊！　",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "居然連同樹枝一起擊飛了！",
    "voice": null,
    "unit_id": 811
  },
  {
