  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "可惡……！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "我居然會輸……！",
