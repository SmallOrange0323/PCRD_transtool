  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦……？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n珠希……？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "她應該在工廠才對吧，為什麼？",
