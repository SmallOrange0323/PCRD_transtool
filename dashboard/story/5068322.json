    "type": "dialogue",
    "name": "碧",
    "words": "而而",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "而且連我也在喔〜！？",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "難道我是因為太想交朋友，",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "才終於把自己變成朋友……？",
    "voice": null,
    "unit_id": 116713
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不，",
    "voice": "vo_adv_5068322_006",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不可能……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這會是玩具王扭曲的友情所創造出來的",
