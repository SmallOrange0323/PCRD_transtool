    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "是妳們錯了！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n我才是",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "真正的玩具……",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "真正的朋友……！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n唔喔喔喔喔喔…………！！",
    "voice": null,
    "unit_id": 14912
  },
  {
