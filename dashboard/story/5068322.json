  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "真正友情嗎……！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "不，",
