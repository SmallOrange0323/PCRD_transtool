  {
    "type": "background",
    "bg_id": "510030"
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嘿咻──",
    "voice": "vo_adv_4010236_000",
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這樣就過關了。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你小子也挺厲害的嘛。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "看起來一副乖乖牌的樣子，",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n想不到這麼擅長射擊遊戲啊。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "接下來去把那台夾娃娃機清空好了。",
    "voice": "vo_adv_4010236_001",
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你說要幫我慶祝生日對吧？",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那麼",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "就得一直陪我玩到我滿意為止喔♪",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "聽好了，",
    "voice": "vo_adv_4010236_002",
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這間遊樂中心",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "的獎品內容",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n跟其他地方可不一樣。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "仔細看看那些獎品。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "沒錯，",
    "voice": "vo_adv_4010236_003",
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "實物在這裡。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那種效果器",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "用來做失真效果音色很棒。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我之前也有打算要買，",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "但它上市沒多久就停產了。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "真沒想到竟然能在這種地方看到它。",
    "voice": "vo_adv_4010236_004",
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我猜店家也很清楚",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這東西的價值不凡。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你看兌換券上還掛著大到令人傻眼的秤錘對吧。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哈哈，",
    "voice": "vo_adv_4010236_005",
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "老闆大概是既期待又怕受傷害吧。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不過話說回來──",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "真的想夾到這東西，一般至少得玩個100次以上吧？",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "金錢、時間、毅力",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "以及技術──",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這是考驗著每一個環節的硬仗。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你要夾？",
    "voice": "vo_adv_4010236_006",
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我看你也不像是會想要這種東西的傢伙啊……",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n不過有意思。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我會見證你的",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這場挑戰到最後。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……哈哈，",
    "voice": "vo_adv_4010236_007",
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "還真讓你夾到了。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "真虧你能堅持到現在。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你就那麼執著於這個獎品嗎？",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n雖說性能確實挺不賴的……",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "啊？",
    "voice": "vo_adv_4010236_008",
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n……",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "啊哈哈哈，",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我還想說你難得這麼認真，原來是這麼回事啊！",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那麼，",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我就不客氣地收下囉。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "既然如此──",
    "voice": "vo_adv_4010236_009",
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我們回去吧，",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "小子。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n義弟費盡苦心才幫我拿到手的東西，豈有不試用看看的道理。",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我今天就用你的戰利品",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "來彈奏一曲給你聽吧！",
    "voice": null,
    "unit_id": 130031
  },
  {
    "type": "movie",
    "movie_id": "401016401"
  },
  {
    "type": "background",
    "bg_id": "509015"
  },
  {
    "type": "background",
    "bg_id": "510205"
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "大哥哥♪",
    "voice": "vo_adv_4010236_010",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "我們今天去了水族館、",
    "voice": "vo_adv_4010236_011",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "又去購物、",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "還吃了生日午餐！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……可是可是，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "還沒有要說掰掰對吧？",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "哇～！",
    "voice": "vo_adv_4010236_012",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "謝謝你的禮物！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n不管是第一次收到的圍裙",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "還是今年收到的禮物，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n我全部都會好好珍惜的！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "欸欸，",
    "voice": "vo_adv_4010236_013",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "我可以打開嗎？",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "應該可以吧？",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n我要開囉～！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "哇！",
    "voice": "vo_adv_4010236_014",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "是項鍊！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "這是",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "露娜的誕生石對吧！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……好美喔。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "成熟的東西……",
    "voice": "vo_adv_4010236_015",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "露娜",
    "voice": "vo_adv_4010236_016",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "現在已經學會做很多種料理了，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n雖然不是很明顯，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "但確實有在長大對吧。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "欸，",
    "voice": "vo_adv_4010236_017",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "大哥哥。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n你幫我",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "戴上這條項鍊好嗎？",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "拜託♪",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……怎麼樣？",
    "voice": "vo_adv_4010236_018",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n適合我嗎？",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "嘿嘿、",
    "voice": "vo_adv_4010236_019",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "嘿嘿♪",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "我爸爸",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "也會幫我媽媽戴項鍊喔。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "他說這是",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "夫唱婦隨的祕訣！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "露娜的夢想呢，",
    "voice": "vo_adv_4010236_020",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n就是能夠",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "跟大哥哥永～遠在一起！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n所以──",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "等露娜再更大一點，",
    "voice": "vo_adv_4010236_021",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
