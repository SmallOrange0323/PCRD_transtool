[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "凱留與{0}在蘭德索爾的鬧區\\n正在邊走邊吃地逛街。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊唔啊唔啊唔……",
    "voice": "vo_adv_1060011_000",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呼～",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好幸福♪",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n便宜好吃份量又夠，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這裡的攤販果然最棒了！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你也吃啊。",
    "voice": "vo_adv_1060011_001",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不趁熱吃的話，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "會變得不好吃哦。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呼。",
    "voice": "vo_adv_1060011_002",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "肚子填飽後，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就冷靜下來了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總覺得",
    "voice": "vo_adv_1060011_003",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "最近……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n太常被捲入{0}的步調了，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我啊。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？",
    "voice": "vo_adv_1060011_004",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n{0}，你好像在發光？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這之前也發生過好幾次……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呀啊啊！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "唉……",
    "voice": "vo_adv_1060011_005",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n不想去上補習班……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "好想翹課……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "可是",
    "voice": "vo_adv_1060011_006",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "如果無故缺席，之後媽媽接到電話聯絡，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n會被臭罵一頓……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "絕對會被狠狠教訓。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那樣的話，",
    "voice": "vo_adv_1060011_007",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "到了某種程度",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就會開始哭了呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n肯定會說『妳以為我是為了誰的將來",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "才花這麼多錢』",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這種",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n高高在上的話……！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "妳在乎的",
    "voice": "vo_adv_1060011_008",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "只有面子和別人的眼光吧！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n明明就根本",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不關心我的未來！！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "光是想像就覺得想吐……！",
    "voice": "vo_adv_1060011_009",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "可惡、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "可惡！！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊啊，",
    "voice": "vo_adv_1060011_010",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "好想快點長大",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "獲得自由……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n等自由以後，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "想和真那大人變親近……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嗚喵啊啊！？",
    "voice": "vo_adv_1060011_011",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "又、",
    "voice": "vo_adv_1060011_012",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "又是你啊！！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n小心我宰了你喔！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "咦？",
    "voice": "vo_adv_1060011_013",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "　你問我是不是又把錢包弄丟了？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "怎麼可能會一直弄丟啊，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "笨～蛋。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我有好好帶在……",
    "voice": "vo_adv_1060011_014",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "咦？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "　奇怪？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n不會吧！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "　錢包不見了！！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊，討厭，",
    "voice": "vo_adv_1060011_015",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "到底是怎樣啦……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n太不幸了……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "唔……！",
    "voice": "vo_adv_1060011_016",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "什、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "什麼啦，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不管是誰",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "都會肚子餓吧！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "誰要和你",
    "voice": "vo_adv_1060011_017",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "一起去吃啊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n再說，我就說我的",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "錢包不見了。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n你是真的想被我宰掉嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "咦？",
    "voice": "vo_adv_1060011_018",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "　你要請客？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "誰要接受你的施捨啊！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊唔……！？",
    "voice": "vo_adv_1060011_019",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n誰、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "誰要接受你的～～……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "still",
    "still_id": "106001101"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊唔。",
    "voice": "vo_adv_1060011_020",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊唔啊唔！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n嗯～",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "好吃～♪",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這裡的漢堡",
    "voice": "vo_adv_1060011_021",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n比起其他的連鎖店，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我更加喜歡呢～！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "雖然知道卡路里很高，",
    "voice": "vo_adv_1060011_022",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "但就是讓人欲罷不能！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嚼嚼，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嚼嚼嚼♪",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "……不好不好。",
    "voice": "vo_adv_1060011_023",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n這樣不就像是被餵食的貓了嗎。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "still",
    "still_id": "106001102"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "話說回來，",
    "voice": "vo_adv_1060011_024",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你啊，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n現在也還在",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "玩阿斯特朗吧？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "如果玩阿斯特朗，",
    "voice": "vo_adv_1060011_025",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "會遇到真那大人嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我之前和你說過吧？",
    "voice": "vo_adv_1060011_026",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n真那大人和我",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "說不定是遠親的『兄妹』。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我在那之後思考過了，",
    "voice": "vo_adv_1060011_027",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n但要怎麼在現實與真那大人見面，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "卻完全不曉得。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "雖然想過在遊戲……",
    "voice": "vo_adv_1060011_028",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n在阿斯特朗",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "或許就能見面了，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
