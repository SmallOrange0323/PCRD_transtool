[
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某次在蘭德索爾後巷散步的{0}，\\n被突然出現的少年們堵住去路。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "那邊的你！",
    "voice": "vo_adv_1065006_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "給我停下！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "\\n你是什麼人！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "找誰有什麼事──！",
    "voice": "vo_adv_1065006_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "你是來見嘉夜她們嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "什麼，",
    "voice": "vo_adv_1065006_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "是嘉夜認識的人呀！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "\\n這樣要付通行費──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "付錢付錢──！",
    "voice": "vo_adv_1065006_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你們，",
    "voice": "vo_adv_1065006_004",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "夠了唷。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n他",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是我認識的人。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "讓他通過吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "今天怎麼了呢？",
    "voice": "vo_adv_1065006_005",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "找我有事嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "等等。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我來猜猜",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是不是像往常一樣",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "散步吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "欸欸，",
    "voice": "vo_adv_1065006_006",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你為什麼拿出錢包了呀！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "快收起來！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真是的……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你連普通小鬼的話都認真嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "算了，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這就是你有趣的地方。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "抱歉抱歉。",
    "voice": "vo_adv_1065006_007",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "付錢那件事，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是開玩笑的。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n那是有認識的人通過時的暗號。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "大家謝謝啦。",
    "voice": "vo_adv_1065006_008",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "來，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "給你們今天的費用。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好好運用吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "太好了──！",
    "voice": "vo_adv_1065006_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "等等去買零食！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這些傢伙在附近玩，順便幫我監視地盤。",
    "voice": "vo_adv_1065006_010",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n就像現在這樣，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們都會認真付給他們報酬。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……其實大家，",
    "voice": "vo_adv_1065006_011",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是因為「消失」失去父母的孩子們，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "以前都是靠偷竊生活。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但是現在，",
    "voice": "vo_adv_1065006_012",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "多虧有了這份工作",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n也不用做壞事了，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "而且讓他們得到生存的方法。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "講真的，",
    "voice": "vo_adv_1065006_013",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們也不確定是否要好好照顧他們，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但是什麼都無條件給他們的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "孩子們也容易撒嬌依賴。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "當然",
    "voice": "vo_adv_1065006_014",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們也知道有【咲戀育幼院】這樣的機構。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那裡確實",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "託付了很多父母「消失」的孩子對吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但是",
    "voice": "vo_adv_1065006_015",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那裡也",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "已經照顧不少人了吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "如果再把這些人都寄放過去，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "讓人覺得不太上道啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那樣的規模，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "可以照顧的人數是有限的。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "所以我們想用這樣的方式來保護他們。",
    "voice": "vo_adv_1065006_016",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n比起從別人那裡偷竊生存下去，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這種方法更踏實吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我才沒做什麼了不起的事呢。",
    "voice": "vo_adv_1065006_017",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "和這些傢伙，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "只是互相利用而已。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哈哈，",
    "voice": "vo_adv_1065006_018",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你可真是個老好人啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒問題。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這些傢伙就交給我們負責吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "話雖如此，",
    "voice": "vo_adv_1065006_019",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "開始進行這些的人並不是我，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "而是老大。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我只是在旁邊幫一點忙。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "啊──！",
    "voice": "vo_adv_1065006_020",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "你們兩人還在說話！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "\\n嘉夜──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "監視好無趣──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "話說，",
    "voice": "vo_adv_1065006_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "兩個人相處得很親密好可疑耶──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "\\n難道你，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "是嘉夜的戀人嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊？",
    "voice": "vo_adv_1065006_022",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你在說什麼呀，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們是死黨啊死黨。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n大家也要珍惜死黨啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "男孩子們",
    "words": "好的──",
    "voice": "vo_adv_1065006_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "吶嘉夜──",
    "voice": "vo_adv_1065006_024",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "現在很閒，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "今天也來教我們戰鬥方法吧──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好啦好啦，",
    "voice": "vo_adv_1065006_025",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "大家",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "排成一列──！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊，",
    "voice": "vo_adv_1065006_026",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這個嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "如果有時間時，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我都會教這些傢伙格鬥技。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n希望他們能盡量保護自己。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "對了，",
    "voice": "vo_adv_1065006_027",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
