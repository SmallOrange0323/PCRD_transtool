  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "事情變得比想像中還嚴重呢……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "排出的罪惡與汙穢，",
    "voice": "vo_adv_5108204_001",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "濃度正在增加呢。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "看來這下得比預料中更努力才行了～",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "總之",
    "voice": "vo_adv_5108204_002",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "先從一邊開始收拾囉。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n旅館的大家也會幫忙我們，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就把這當作是尾牙的餘興節目吧。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯，",
    "voice": "vo_adv_5108204_003",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是啊……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "希望不要",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "再發生其他事了……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "美里，",
    "voice": "vo_adv_5108204_004",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那種擔憂通常都會成真，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "所以再放鬆一點吧～♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "咦？",
    "voice": "vo_adv_5108204_005",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "帆稀，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "謝謝妳……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "會加油的。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵，",
    "voice": "vo_adv_5108204_006",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "帆稀在關心妳呢。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不管怎麼說，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
