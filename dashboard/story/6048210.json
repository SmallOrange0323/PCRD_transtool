    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "她是個很活潑的孩子，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "還挺叫人寂寞的呢……",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "畢竟也被變成天使的模樣了呢。",
    "voice": "vo_adv_6048210_001",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "努力做好很多天使的工作，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n讓拉菲大吃一驚吧♪",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "說的也是呢！",
    "voice": "vo_adv_6048210_002",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "下次再見面時，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "一定要好好帶她參觀蘭德索爾，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "也要把她介紹給公會的大家認識呢！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗯，",
    "voice": "vo_adv_6048210_003",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "如果是拉菲的話，一定可以辦到的。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不過，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "願望我會乖乖地自己來實現喔。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "因為",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里也是天使嘛♪",
    "voice": null,
    "unit_id": 113711
  }
]
