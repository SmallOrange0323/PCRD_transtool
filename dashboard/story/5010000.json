[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "年關將近的某天……\\n走在蘭德索爾市區的{0}，\\n和【破曉之星】的成員們在街角相遇了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊～！",
    "voice": "vo_adv_5010000_000",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　是騎士先生——！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好久不見——！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n你過得好嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊，佩可小姐她們也好嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n今天你一個人出來嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "冷靜下來，日和。",
    "voice": "vo_adv_5010000_001",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就算妳這樣子問，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也沒辦法一次回答完唷。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看到你……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這麼有精神真是太好了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你好，騎士先生。",
    "voice": "vo_adv_5010000_002",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好久不見。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "看起來很有精神呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生也來買東西？",
    "voice": "vo_adv_5010000_003",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "除夕就快到了呢。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯！",
    "voice": "vo_adv_5010000_004",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　因為在蘭德索爾",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "年底年初有營業的店會變少，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n所以各種東西",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "都預先多買了一些！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "因為是店休期間要吃的量，",
    "voice": "vo_adv_5010000_005",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "就買了很多呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也得裝飾公會小屋的門口呢。",
    "voice": "vo_adv_5010000_006",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "今天就是要把這些東西",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一次買完。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怜她們幫忙裝飾，",
    "voice": "vo_adv_5010000_007",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我則負責幫大家做御節料理。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不是祭典喔……",
    "voice": "vo_adv_5010000_008",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n騎士先生因為喪失記憶",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "所以連新年的事……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "都不記得了啊……",
    "voice": "vo_adv_5010000_009",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一興奮就沒注意……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……",
    "voice": "vo_adv_5010000_010",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那麼對騎士先生來說，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就是第一次過新年了呢！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那個啊，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一年就快要結束了唷！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "接下來就會再開始新的一年唷。",
    "voice": "vo_adv_5010000_011",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "即使一年結束了，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這個世界也不會終結，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "請放心吧。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "在年底的時候，",
    "voice": "vo_adv_5010000_012",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "為了除去那一年的髒污，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "會打掃各式各樣的地方……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一年最後的一天，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也就是在除夕的時候會去參拜神殿。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "聽說打掃乾淨迎接新年的話，",
    "voice": "vo_adv_5010000_013",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就會發生",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好事！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n其他",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也有像是吃蕎麥麵啊，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "吃年糕啊，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "吃栗金團之類的～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呵呵。",
    "voice": "vo_adv_5010000_014",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "日和總是",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "想著吃的呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這也是沒辦法啊。",
    "voice": "vo_adv_5010000_015",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也很期待優衣的御節料理和攤販的食物呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "其它的",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還有像是大人給小孩，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "叫做紅包的東西呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "在新年的時候，",
    "voice": "vo_adv_5010000_016",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對著希望下一年也能平安健康的孩子們，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "傾注這樣的心意，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "給他們一些錢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那就是紅包唷。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "意思是，",
    "voice": "vo_adv_5010000_017",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要給我們嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們和他的年紀差距，",
    "voice": "vo_adv_5010000_018",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "應該沒有大到能收紅包的程度。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果他想給紅包的話，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不是正好有一個對象嗎。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你是說，",
    "voice": "vo_adv_5010000_019",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "給可可蘿？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣啊。",
    "voice": "vo_adv_5010000_020",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可可蘿一定會很開心呢！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "？",
    "voice": "vo_adv_5010000_021",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不然這樣，不然這樣！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "除夕當天",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要不要和我們一起出來？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "除夕……",
    "voice": "vo_adv_5010000_022",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n確實如果有你在的話就比較放心呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "請務必一起來啊。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果有騎士先生在，",
    "voice": "vo_adv_5010000_023",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們也比較安心呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_5010000_024",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是祕密唷——！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　來了就知道！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那這個地圖給你！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　除夕的時候要來這裡唷！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　約好囉！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "被日和這麼說的{0}，\\n收下了目的地的地圖，約好了要在除夕那天一起出來。",
    "voice": null,
    "unit_id": null
  }
]
