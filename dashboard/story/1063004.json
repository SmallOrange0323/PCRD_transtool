  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "{0}，發生什麼事了！？",
