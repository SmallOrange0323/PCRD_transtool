    "voice": "vo_adv_1063004_026",
    "unit_id": 106331
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 106331
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n先告辭了……",
    "voice": null,
    "unit_id": 106331
  },
  {
    "type": "background",
    "bg_id": "510210"
  },
