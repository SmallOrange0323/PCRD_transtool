    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "サイズが同じだったら着せてあげたいところッスけど、",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\nさすがに無理ッスよね。",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ツムギさんに頼んでもう一着……",
