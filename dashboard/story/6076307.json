  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "お揃いの衣装で",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "街をパトロールするのもいいッスね！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "ありがとうッス！　",
    "voice": "vo_adv_6050307_003",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "こんないいもの作ってもらったら",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\n頑張らないわけにはいかないッスよね！",
    "voice": null,
