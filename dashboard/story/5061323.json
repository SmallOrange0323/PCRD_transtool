[
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呼、",
    "voice": "vo_adv_5061323_000",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呼……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可惡，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這傢伙實在是強得嚇人……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真的呢～",
    "voice": "vo_adv_5061323_001",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "再這樣下去，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們所有人都會被擊倒的～",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "呵呵，",
    "voice": "vo_adv_5061323_002",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "如果妳們沒有異想天開地",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "想跟妾身溝通的話，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n這就會是一場更實際的對決吧。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "要是妳們還想繼續堅持，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "最好要有決心這將會是一場性命的爭奪戰！",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "為什麼……",
    "voice": "vo_adv_5061323_003",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "為什麼妳要對戰鬥這麼執著！",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n妳不是有心也會說話嗎！",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "再戰鬥下去沒有任何意義啊！",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "不要說得妳好像很懂！",
    "voice": "vo_adv_5061323_004",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "這裡的支配者是妾身。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n如果想達成妳們的心願，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "就先用刀刃打倒妾身後再說！",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……啊啊，",
    "voice": "vo_adv_5061323_005",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我能夠明白。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "公主殿下那強烈的戰鬥意志，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n透露出了",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "她對自己的姿態，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "以及對自己的心沒有自信。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我很了解",
    "voice": "vo_adv_5061323_006",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳的心情。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但是，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "光靠武力是不會有任何改變的。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n必須懷著自信，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "展現出活得像自己的美好才行！",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "為此……",
    "voice": "vo_adv_5061323_007",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我要先打倒妳！",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n然後，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "引領出妳真正的心聲！",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "呿，",
    "voice": "vo_adv_5061323_008",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "妳以為那種歪理，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "妾身會乖乖聽下去嗎！",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我要上囉，",
    "voice": "vo_adv_5061323_009",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳這個不聽人說話的公主！",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂，公主，",
    "voice": "vo_adv_5061323_010",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們好像也沒時間休息了。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是啊。",
    "voice": "vo_adv_5061323_011",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真琴，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們是",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "莉瑪的支援。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就讓她見識一下",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "【哞哞自衛隊】的意志力吧～",
    "voice": null,
    "unit_id": 116011
  }
]
