    "name": "安涅默涅",
    "words": "要幫忙",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "那個人。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n若有必要，",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我也──",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "可以",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "保護他。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "這跟「大奧」",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "無關──",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "是我自己要做的。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "師傅……",
    "voice": "vo_adv_5207063_021",
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "果然很帥是也！",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n那份冷漠，",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "讓人渾身酥麻，",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好憧憬啊！",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "要酥麻是",
    "voice": "vo_adv_5207063_022",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "妳自己的事──",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "不過",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "不必憧憬我。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "所謂謙虛就是美德",
    "voice": "vo_adv_5207063_023",
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是也。",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這就是師傅的帥氣之處是也♪",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "言歸正傳，",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "師傅有沒有意願加入大奧……",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──沒有。",
    "voice": "vo_adv_5207063_024",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "真難突破是也……",
    "voice": "vo_adv_5207063_025",
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "但我是要成為",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "大奧之首的人。",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n不會只因",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這種程度放棄的！",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──唉。",
    "voice": "vo_adv_5207063_026",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "隨便妳吧──",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是，",
    "voice": "vo_adv_5207063_027",
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我會",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "照自己的意思",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "繼續發出邀請的♪",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了讓安涅默涅加入大奧，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n妮諾展開永無止盡的戰爭（邀請）。",
    "voice": null,
    "unit_id": null
  }
]
