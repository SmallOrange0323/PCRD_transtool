[
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "而後，在某日午後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n黑鐵鎧甲佇立於蘭德索爾王宮城門前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n有兩個人影再度集結到她面前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "502700001"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "茉莉團員",
    "voice": "vo_adv_5027007_000",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "和小智姐",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "一同回歸了！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳們回來啦，",
    "voice": "vo_adv_5027007_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小智、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "茉莉。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n沒事就好。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n事不宜遲，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可以請妳們先報告一下調查【龍族巢穴】的結果嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是。",
    "voice": "vo_adv_5027007_002",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "船隊的成員，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "幾乎都是幫派份子跟品行不良的傢伙。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這次的『開拓』",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "並非是以幫派的立場進行，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n而是【龍族巢穴】原本的公會活動。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過竟然能讓幫派分子協助公會的工作",
    "voice": "vo_adv_5027007_003",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "真是做了件厲害的事呢，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "帆稀……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "她們在找的是",
    "voice": "vo_adv_5027007_004",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "遺跡還有",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "沉睡在遺跡裡的某樣東西……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但我還沒有清楚掌握",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "她們打算要如何使用。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……",
    "voice": "vo_adv_5027007_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然之前的情報是說那座『島』並沒有文明存在過的跡象，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但從她們的說法聽來，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "似乎那裡曾有過遺跡的樣子。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "still",
    "still_id": "502700701"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "的確有個遺跡！",
    "voice": "vo_adv_5027007_006",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "　",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "還有",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "有個",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "很像龍的生物在那裡！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "對了，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那個人也跟她們在一起！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n總覺得",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "他們好像很熟的樣子。",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣啊？",
    "voice": "vo_adv_5027007_007",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這倒是挺有意思的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "正確來說",
    "voice": "vo_adv_5027007_008",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "應該是遺跡的殘骸",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "，還有就是",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "像龍一般的生物。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那個『島』恐怕無法以一般的方法來處理。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "難怪連管理協會都難以應付。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "比起這個――",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "龍人族更加危險……",
    "voice": "vo_adv_5027007_009",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳想說的是這個吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過，",
    "voice": "vo_adv_5027007_010",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然她們同時也有以幫派的立場在進行活動……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但是她們",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n看起來不像那種",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "單純以惡意在行動的公會……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這裡面參雜了不少我個人的主觀意見。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": "vo_adv_5027007_011",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果小智妳這麼認為",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那我就相信妳。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n妳識人的眼光，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "總是讓我獲益良多。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嘉夜和祈梨",
    "voice": "vo_adv_5027007_012",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "絕對不是壞人！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "帆稀的話，就不知道她到底在想什麼就是了……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不，",
    "voice": "vo_adv_5027007_013",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然有些讓人在意的地方，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過她也是那個人的朋友……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我想",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "應該不會有問題才對。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "502700702"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "說得也是！",
    "voice": "vo_adv_5027007_014",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "　感覺我們能成為好朋友呢！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "原來如此，",
    "voice": "vo_adv_5027007_015",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "既然是少年的朋友，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "應該沒問題吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "才幾天不見，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "感覺妳們好像有所成長。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n特別是小智，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "看起來比出任務前成熟了許多呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "沒錯！",
    "voice": "vo_adv_5027007_016",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "　比以前",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "更可靠了！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是嗎？",
    "voice": "vo_adv_5027007_017",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "　我自己是沒什麼感覺……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "也許是多虧了",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "【龍族巢穴】還有那個人吧。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那麼，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "為了表達謝意，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "找他一起去吃飯，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "順便捉弄他一下如何？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好耶！",
    "voice": "vo_adv_5027007_018",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "　",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "剛好很想念蘭德索爾的料理說！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_5027007_019",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "執勤時間也快結束了，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果妳們不介意的話我也一起去吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我也得",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好好慰勞一下妳們兩位。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "純要請客嗎？",
    "voice": "vo_adv_5027007_020",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "　",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "太棒了！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n好，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "茉莉，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我們來比比看誰會先到平常去的那家店吧！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊！",
    "voice": "vo_adv_5027007_021",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "妳太賊了！小智姐！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n等等我～！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "話說，",
    "voice": "vo_adv_5027007_022",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "結果怎麼樣啊？老大。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這次的工作",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也不算是空手而回吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就公會的工作而言是這樣沒錯～",
    "voice": "vo_adv_5027007_023",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "因為我們的主要目標是要找到龍，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就這點來說算是失敗了～……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……那些對管理協會和騎士團有影響力的貴族",
    "voice": "vo_adv_5027007_024",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我已經都打點好了。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "沒問題。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "反正，很快他們",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就會再來委託我們艾爾皮斯島的工作的。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "畢竟『我們』可以暫時趕走",
    "voice": "vo_adv_5027007_025",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那些盤據在城裡的地痞流氓，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n對王宮和管理協會來說，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還有利用價值。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "小智和茉莉的上司，",
    "voice": "vo_adv_5027007_026",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是叫做純嗎？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "總有一天，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我一定會好好的回敬她這次的事情……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "本來我還想讓【王宮騎士團（NIGHTMARE）】放鬆警戒的呢～",
    "voice": "vo_adv_5027007_027",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "結果嘉夜卻",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "在這種時候覺醒了。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "果然……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "會讓對方有所戒備吧？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那當然。",
    "voice": "vo_adv_5027007_028",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那時候的嘉夜夜豈止可怕，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "根本恐怖得要命……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "比老大生氣時還要恐怖。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "對不起啦。",
    "voice": "vo_adv_5027007_029",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "一不小心氣到失去理智了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "話說，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "別把我覺醒",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "講得好像什麼不能做的壞事好嗎。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n到底是希望我覺醒還是不希望我覺醒啊，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "選一個好嗎……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "希望妳覺醒呀，",
    "voice": "vo_adv_5027007_030",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過請選一下時機跟地點好嗎☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這次也不是沒有其他收穫唷？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n除了嘉夜覺醒的事以外～……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還有這個。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那個石板，",
    "voice": "vo_adv_5027007_031",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是似龍生物的玩具吧。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "難不成！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……妳打算拿來這裡賣，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "把這筆錢當作公會的資金來源？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真遺憾。",
    "voice": "vo_adv_5027007_032",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "完全猜錯～☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "　",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這個是",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那孩子從遺跡蒐集到的出土文物喔？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n按照現在這個世界的歷史，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "艾爾皮斯島",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "在日前被發現之前，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "有很～長一段時間",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "和阿斯特賴亞大陸沒有交流才對☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "可是這個石板",
    "voice": "vo_adv_5027007_033",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "並非那麼古老的物品。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n以年代來看，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "應該是在艾爾皮斯島上的人類滅絕之後，才被製造出來的。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳看～☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "　很明顯地互相矛盾吧～？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗯？",
    "voice": "vo_adv_5027007_034",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "　所以這代表什麼呢？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就算這個不是決定性的，",
    "voice": "vo_adv_5027007_035",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但我們也逐漸湊齊了證據對吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "『這是個錯誤的世界』的證據。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就是這麼一回事～☆",
    "voice": "vo_adv_5027007_036",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n雖然做了回溯時間這種程度的改變，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但細節的部分就被忽略了呢。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也就是說……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳不覺得，這代表",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還有我們可以介入",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "的空間嗎？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "說到這個，",
    "voice": "vo_adv_5027007_037",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "祈梨妳是不是說過什麼",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳好像能聽懂",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n似龍生物說的話之類的啊？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "只能聽得懂",
    "voice": "vo_adv_5027007_038",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "大概的意思就是了……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "如果是",
    "voice": "vo_adv_5027007_039",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "像老大和拉格那樣的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳是不是也能從似龍生物那裡問出點什麼呢？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "有可能喔～♪",
    "voice": "vo_adv_5027007_040",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "　或許和相近種族溝通的能力",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n不是我特有的，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "而是龍人族的能力也說不定。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n這件事可能有調查的價值。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們就再去一次",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那座島吧☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦咦咦！？",
    "voice": "vo_adv_5027007_041",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "　又要去？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我想暫時待在文明社會放鬆一下啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我倒是很期待！",
    "voice": "vo_adv_5027007_042",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "城裡那邊打手相關的委託",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也積了不少呢～……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "當然，",
    "voice": "vo_adv_5027007_043",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "沒辦法馬上就去啦～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "畢竟這次的事",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "以公會來說也是虧損的呢☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "得在等人們對這件事的關注度降低的同時，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "一邊存錢才行。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔，",
    "voice": "vo_adv_5027007_044",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我知道啦。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我去就是了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n但相對的，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要有獎金喔！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯嗯！",
    "voice": "vo_adv_5027007_045",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "大家一起加油吧～☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n這也是為了要找出",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "把這個世界",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "變～成這樣的犯人呢……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "【龍族巢穴】追尋著世界改變的祕密。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她們的目標是，曾經失去的世界……",
    "voice": null,
    "unit_id": null
  },
