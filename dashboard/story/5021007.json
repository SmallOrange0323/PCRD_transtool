    "voice": "vo_adv_5021007_000",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "可以聚過來一下嗎～？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳要做什麼，",
    "voice": "vo_adv_5021007_001",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "公主？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "難不成想要一起跳舞嗎～？",
    "voice": "vo_adv_5021007_002",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦？",
    "voice": "vo_adv_5021007_003",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　搞什麼，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "原來{0}也在啊。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這麼多人不跳舞就太可惜啦～♪",
    "voice": "vo_adv_5021007_004",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "好耶～♪",
    "voice": "vo_adv_5021007_005",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那麼伴奏就交給真琴負責啦～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不，我根本不會伴奏啊！？",
    "voice": "vo_adv_5021007_006",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦，",
    "voice": "vo_adv_5021007_007",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "為什麼！？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真的要嗎？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　呃、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那麼，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真是拿你沒辦法……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那我來伴奏吧～♪",
    "voice": "vo_adv_5021007_008",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好了好了。",
    "voice": "vo_adv_5021007_009",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "要跳舞可以，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但在那之前",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家有東西要想送給你們。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "送給我們？",
    "voice": "vo_adv_5021007_010",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "對呀。",
    "voice": "vo_adv_5021007_011",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那個，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "前陣子",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不是給你們添麻煩了嗎？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所以，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這也是為了平時的感謝之意，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家想送禮物給你們。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喔喔……",
    "voice": "vo_adv_5021007_012",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這是",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "以我為原型的玩偶嗎？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真是好可、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呃不，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是做得相當出色……！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "無敵開心呀～！",
    "voice": "vo_adv_5021007_013",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "　真步手真靈巧呢～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "看到你們這麼喜歡，人家也好高興。",
    "voice": "vo_adv_5021007_014",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "霞也很喜歡的樣子，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "有試著做出來真是太好了。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這樣好嗎？",
    "voice": "vo_adv_5021007_015",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　真的可以收下禮物嗎。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們也沒做什麼……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們只是順著自己的想法行動啊～♪",
    "voice": "vo_adv_5021007_016",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "沒關係的。",
    "voice": "vo_adv_5021007_017",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這裡面可是",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家對你們的一番心意。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "心意？",
    "voice": "vo_adv_5021007_018",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "沒錯。",
    "voice": "vo_adv_5021007_019",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n「人家很重視你們」，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這就是人家的心意。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "謝謝妳～真步！",
    "voice": "vo_adv_5021007_020",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n果然應該要跳舞呀～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真琴也一起來跳，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "來吧～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂、",
    "voice": "vo_adv_5021007_021",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "住手別拉啊！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好啦、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "知道了知道了！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵。",
    "voice": "vo_adv_5021007_022",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "啊，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "讓您久等了，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "對不起。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "給您，",
    "voice": "vo_adv_5021007_023",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這個是王子先生的",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "玩偶。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還有……",
    "voice": "vo_adv_5021007_024",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "另一個。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "still",
    "still_id": "502100701"
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這個",
    "voice": "vo_adv_5021007_025",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也願意收下來嗎。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這個是",
    "voice": "vo_adv_5021007_026",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家的玩偶。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "雖說也可以我自己留下來好好地珍惜，",
    "voice": "vo_adv_5021007_027",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但果然還是",
    "voice": "vo_adv_5021007_028",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "希望能",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "交由某人愛惜呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "因為您知道的，",
    "voice": "vo_adv_5021007_029",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "心意終究會傳達到，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "對吧？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n王子先生如果願意珍惜，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家和那孩子",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也一定",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "會感到",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "很開心呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您願意",
    "voice": "vo_adv_5021007_030",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "接受它嗎？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "still",
    "still_id": "502100702"
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "謝謝您，",
    "voice": "vo_adv_5021007_031",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "等到某一天那孩子也有靈魂時，",
    "voice": "vo_adv_5021007_032",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n它一定會",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "替我好好地保護王子先生。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "嗯？",
    "voice": "vo_adv_5021007_033",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "　您說人家沒有自己的玩偶怎麼辦？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "至於這點",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就不必擔心了唷。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n人家還有",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這座城堡裡的夥伴們在呀――",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "而且，保護人家的這個角色，",
    "voice": "vo_adv_5021007_034",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n王子先生會負責擔任不是嗎……♪",
    "voice": null,
    "unit_id": 101011
  },
