    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "傾聽著海浪的聲音，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "眺望著星空。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n您似乎過了一段十分平穩的時間。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "是啊，",
    "voice": "vo_adv_5148064_001",
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "非常棒喔──",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n畢竟蘭法姐",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "也很喜歡安靜的地方嘛？",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "妳們很Chill呢～",
    "voice": "vo_adv_5148064_002",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n非常棒喔～♪",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "是說，",
    "voice": "vo_adv_5148064_003",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "妳們兩人聊了什麼啊～？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "果然是跟戀愛有關的內容嗎？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "咦～",
    "voice": "vo_adv_5148064_004",
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n我怎麼可能說出口來啦～",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "不要賣關子啦～",
    "voice": "vo_adv_5148064_005",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n我們感情不是很好嗎？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "……呵呵★",
    "voice": "vo_adv_5148064_006",
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n蘭法姐的",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "戀情之類的～？",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嘿～～～♡",
    "voice": "vo_adv_5148064_007",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "說給我聽說給我聽？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n是酸酸甜甜～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "的那種感覺嗎～？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "酸甜……",
    "voice": "vo_adv_5148064_008",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "戀愛……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n那是種什麼樣的感情呢……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯～",
    "voice": "vo_adv_5148064_009",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "想要緊緊抱住，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "會心跳加速，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n想要全部吃掉，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "的感覺？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "啊，但是",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "酸甜系不是這樣吧～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "真是的～我開玩笑的啦～",
    "voice": "vo_adv_5148064_010",
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "妳們兩個。",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我跟蘭法姐講了什麼，",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "是秘密喔★",
