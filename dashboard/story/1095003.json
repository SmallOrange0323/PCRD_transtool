    "voice": "vo_adv_1095003_004",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你是說……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "要在這裡跳舞嗎！？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊啊啊……",
    "voice": "vo_adv_1095003_005",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "也就是說……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你是",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這個意思吧？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n虐、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "沒想到你會要我做到這程度……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……我、",
    "voice": "vo_adv_1095003_006",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n就照虐待狂先生說的……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花",
    "voice": "vo_adv_1095003_007",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "要脫了！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不、",
    "voice": "vo_adv_1095003_008",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不是嗎！？",
