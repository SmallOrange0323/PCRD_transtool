  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和空花在蘭德索爾的街上四處走著，\\n來到了郊區。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "來到這裡後，",
    "voice": "vo_adv_1095003_000",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "人潮真的變少了呢……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n完全沒有人",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "盯著空花看了……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這樣的話，",
    "voice": "vo_adv_1095003_001",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "似乎沒有宣傳效果，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n我們往回走吧……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊，",
    "voice": "vo_adv_1095003_002",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那邊好像",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "聚集了蠻多人呢。",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是發生什麼事了嗎？　",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "我們靠近看看吧。",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這個是……",
    "voice": "vo_adv_1095003_003",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "有人在",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "演奏呢。",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那個吟遊詩人",
