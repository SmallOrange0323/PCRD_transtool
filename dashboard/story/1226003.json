  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "優衣在那之後也「判若兩人似地」，\\n積極地投入檢測──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "兩人羽織刨冰！",
    "voice": "vo_adv_1226003_000",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "來，",
    "voice": "vo_adv_1226003_001",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊～",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……咦，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "吃不到嗎？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我再貼緊一點喔。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嘿咻。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "在雙人游泳圈",
    "voice": "vo_adv_1226003_002",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "墜入情網的瞬間～",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦，",
    "voice": "vo_adv_1226003_003",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "很擠？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好過分～",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那這招如何！",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嘿～擠過去擠過去！",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "情侶騎馬打仗────！",
    "voice": "vo_adv_1226003_004",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生快跑～！",
    "voice": "vo_adv_1226003_005",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "脖子被勒得很緊？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "哎呀對不起……！",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "background",
    "bg_id": "500161"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "今日的檢測目標終於全數達成了──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "你們倆",
    "voice": "vo_adv_1226003_006",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "真的做得很好喔。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "\\n優衣一開始很僵硬，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "但中途開始就變得積極主動了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "\\n還幫忙提出了一些改善方案，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "在各方面都很活躍！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "我今天確定了。",
    "voice": "vo_adv_1226003_007",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "\\n這一定會是場成功的慶典。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "太晚了啦。",
    "voice": "vo_adv_1226003_008",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n拜託在借錢之前就先確定好啊。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呵呵，",
    "voice": "vo_adv_1226003_009",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我很高興",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "有幫上兩位的忙。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "所以，",
    "voice": "vo_adv_1226003_010",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "你們明天",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "會繼續過來對吧？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "檢測項目",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "還剩下一半。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦……",
    "voice": "vo_adv_1226003_011",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "沒辦法的話也可以拒絕喔？",
    "voice": "vo_adv_1226003_012",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "…………",
    "voice": "vo_adv_1226003_013",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……當然沒問題。",
    "voice": "vo_adv_1226003_014",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n如果能幫上忙的話，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我很樂意。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "夫妻",
    "words": "太好了！",
    "voice": "vo_adv_1226003_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "我說啊，",
    "voice": "vo_adv_1226003_016",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "你們兩個待會有空嗎？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……？",
    "voice": "vo_adv_1226003_017",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "有的。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "把那當作額外獎勵實在不好意思，",
    "voice": "vo_adv_1226003_018",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "\\n不過那真的是看了不吃虧的美景。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "\\n我還要替明天做準備，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "就讓專務帶你們過去吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……美",
    "voice": "vo_adv_1226003_019",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "景？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "background",
    "bg_id": "500282"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "優衣和{0}兩人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n跟著專務來到了海灘的外緣──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這種地方",
    "voice": "vo_adv_1226003_020",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "有棧橋？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "很意外吧，",
    "voice": "vo_adv_1226003_021",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "這裡以前似乎是個碼頭。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n我們要走到這座棧橋的最前面去。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "雖然腳邊是有亮光，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "但還是要小心點，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "畢竟這很舊了。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好、",
    "voice": "vo_adv_1226003_022",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好的……！",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "好，",
    "voice": "vo_adv_1226003_023",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "到囉……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "怎麼樣啊！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "background",
    "bg_id": "500522"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "………………！！！！",
    "voice": "vo_adv_1226003_024",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們被星星……",
    "voice": "vo_adv_1226003_025",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "包圍著！？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "很厲害吧？",
    "voice": "vo_adv_1226003_026",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n這裡海面不可思議地平靜，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n所以星星映照在水面上，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "就能看見360度的星空。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "頭上跟腳下，",
    "voice": "vo_adv_1226003_027",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "全部都是",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "星星……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n漂亮到",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "都快不曉得……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "自己身在何處了……！",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "……呵呵，",
    "voice": "vo_adv_1226003_028",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "妳喜歡",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n其實啊，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "這裡是我",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "充滿回憶的地方。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n算是我們夫妻的",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "原點吧。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "兩位的……？",
    "voice": "vo_adv_1226003_029",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "──啊，",
    "voice": "vo_adv_1226003_030",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這麼說來，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我不小心",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "聽到了。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n兩位在說",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這次慶典是你們",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "多年來的夢想的事……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對、",
    "voice": "vo_adv_1226003_031",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對不起！",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我不是故意要偷聽的──",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "是這樣嗎？",
    "voice": "vo_adv_1226003_032",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "沒事，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "不要緊的。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n反倒是我覺得不好意思，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "讓妳聽到那種事。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不會，",
    "voice": "vo_adv_1226003_033",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒那回事……！",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你們說要為了情侶們",
    "voice": "vo_adv_1226003_034",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "舉辦活動。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我想兩位能有這種想法，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n一定是因為有經歷過",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "美妙的戀情……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "讓我覺得很羨慕。",
    "voice": "vo_adv_1226003_035",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "…………",
    "voice": "vo_adv_1226003_036",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "咦，",
    "voice": "vo_adv_1226003_037",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "妳說我們？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "經歷過美妙的戀情？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "怎麼可能。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "就算講委婉一點，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "那也是最爛的戀情。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦……？",
    "voice": "vo_adv_1226003_038",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "妳想嘛，",
    "voice": "vo_adv_1226003_039",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "我們是精靈族跟人類在交往。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n所以周遭都強烈反對，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "相關人士全都",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "得罪光了。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "background",
    "bg_id": "500282"
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "他的狀況也是一樣。",
    "voice": "vo_adv_1226003_040",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n由於實在太辛苦了，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "所以我們",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "有談過「到此為止分手吧！」",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n而那地方",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "就是這裡。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怎麼會這樣……",
    "voice": "vo_adv_1226003_041",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "呵呵，",
    "voice": "vo_adv_1226003_042",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "不過呢……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "妳看，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "這片星光很耀眼吧？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "它會把一切全～都照亮。",
    "voice": "vo_adv_1226003_043",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n把內心深處裡裡外外",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "全～都照亮。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "我當時",
    "voice": "vo_adv_1226003_044",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "無論如何都沒辦法",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "對自己的感情說謊。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "因為我就是抹滅不掉",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "「喜歡」啊。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不會吧……",
    "voice": "vo_adv_1226003_045",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "只有這份感情……",
    "voice": "vo_adv_1226003_046",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "我就是拿它沒轍。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "明明別談什麼戀愛，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "人生就會輕鬆很多的說～",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "………………！",
    "voice": "vo_adv_1226003_047",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "總之",
    "voice": "vo_adv_1226003_048",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "正因為如此吧？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n當時也有點賭氣，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "就想說要為了夾在戀愛與人生之間，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n左右為難的情侶們舉辦活動。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "可能是有經歷過那段時期吧，",
    "voice": "vo_adv_1226003_049",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n所以多少能體會",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "優衣妳的心情。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦……？",
    "voice": "vo_adv_1226003_050",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "我們家那口子說希望你們明天再過來，",
    "voice": "vo_adv_1226003_051",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n而我也希望你們能來，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "不過",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "真的不用勉強喔？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "什、",
    "voice": "vo_adv_1226003_052",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "什麼勉強，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "才沒有那回事……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士，",
    "voice": "vo_adv_1226003_053",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "先生……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "這樣啊，",
    "voice": "vo_adv_1226003_054",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "你都有注意到啊。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n很棒喔，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "看來是我多管閒事了呢。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "接下來",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "你們就兩個人享受這片景色吧。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "然後",
    "voice": "vo_adv_1226003_055",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "優衣。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n妳",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "被開除了。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦……？",
    "voice": "vo_adv_1226003_056",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "下次面試",
    "voice": "vo_adv_1226003_057",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "不只要問有沒有在交往，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n還要再個別仔細地",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "問清楚才行呢，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "嗯。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個……",
    "voice": "vo_adv_1226003_058",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "等優衣妳誠實面對自己的感情之後，",
    "voice": "vo_adv_1226003_059",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n我想我們很快就能再見面了……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "不，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "我們一定要再見面！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "加油喔，優衣，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "那我先走囉！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "…………",
    "voice": "vo_adv_1226003_060",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦？",
    "voice": "vo_adv_1226003_061",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯、",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我沒……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "事……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦，",
    "voice": "vo_adv_1226003_062",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我到底是",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怎麼了……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "眼淚……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "流個不停……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……對、",
    "voice": "vo_adv_1226003_063",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對不起，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我沒事……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對了，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是有東西跑到眼睛裡了……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不對，",
    "voice": "vo_adv_1226003_064",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不是的……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我是",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "感到安心了。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n對不用再說謊",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "感到安心……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可是我卻開口又想說謊……",
    "voice": "vo_adv_1226003_065",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "雖然只是稍微蒙混了一下，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不過……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我得鼓起勇氣來……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你聽我說，",
    "voice": "vo_adv_1226003_066",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "等這個情侶慶典舉辦了，",
    "voice": "vo_adv_1226003_067",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "要不要一起來玩？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n下次就，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呃……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "以客人的身分參加。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒有。",
    "voice": "vo_adv_1226003_068",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果是當客人的話，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我想就不用勉強自己了。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n而且一定會",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "玩得比今天還要開心。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這就是",
    "voice": "vo_adv_1226003_069",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我真實的想法……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n你願意跟我一起來嗎？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真的嗎？",
    "voice": "vo_adv_1226003_070",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "有鼓起勇氣真是太好了。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……那就，",
    "voice": "vo_adv_1226003_071",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "約好了。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯，",
    "voice": "vo_adv_1226003_072",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生你一定會遵守約定的。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n不過不是的，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這約定，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是我對自己說的。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "下次要",
    "voice": "vo_adv_1226003_073",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "再更坦率一點，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "鼓起更多勇氣……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒事，",
    "voice": "vo_adv_1226003_074",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你別在意。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我跟我自己的約定，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我會",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "確實遵守的。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在星光照耀之下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "優衣像是在慰勞自己、愛惜自己一般，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n將手放到了自己的胸前。",
    "voice": null,
    "unit_id": null
  }
]
