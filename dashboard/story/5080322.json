[
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "拿、",
    "voice": "vo_adv_5080322_000",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "拿出了看起來很美味的點心？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是打算要誘惑我們嗎？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們是不會屈服的哦！",
    "voice": "vo_adv_5080322_001",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n老婆婆做的點心比較好吃！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "對啊！",
    "voice": "vo_adv_5080322_002",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n更何況宮子對布丁以外的點心都沒興趣喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "如果出現布丁妳打算怎麼辦？",
    "voice": "vo_adv_5080322_003",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "…………",
    "voice": "vo_adv_5080322_004",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "婆婆的布丁是最棒的喲！",
    "voice": "vo_adv_5080322_005",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……剛剛的停頓",
    "voice": "vo_adv_5080322_006",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就當沒這回事吧。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在宮子輸給誘惑之前，趕緊收拾掉吧！",
    "voice": "vo_adv_5080322_007",
    "unit_id": 119311
  }
]
