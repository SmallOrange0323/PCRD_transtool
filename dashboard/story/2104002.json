  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾天後——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就在貪吃佩可等人正在月光學院辦理入學手續時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}先行造訪了自己的教室。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哇耶～！",
    "voice": "vo_adv_2104002_000",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才秀才秀才♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n好久不見～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真的好久了呢～",
    "voice": "vo_adv_2104002_001",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "話又說回來，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "學校的大半，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "都被那個叫霸瞳皇帝的傢伙毀掉了嘛，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "重新開始上課也只是最近的事情。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不過考試的事也不了了之，",
    "voice": "vo_adv_2104002_002",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以對人家來說可是超Lucky的感覺唷！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是～啦～",
    "voice": "vo_adv_2104002_003",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n如果真的就那樣進入月考期間，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "或許真的就得廢校了也說不定……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "欸～欸～",
    "voice": "vo_adv_2104002_004",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那秀才你過得如何？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真假？　",
    "voice": "vo_adv_2104002_005",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好棒棒耶！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不愧是秀才！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊？　",
    "voice": "vo_adv_2104002_006",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那什麼？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……啊，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是在講你去哪裡替別人照顧小孩",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "的事嗎？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真好～",
    "voice": "vo_adv_2104002_007",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家也想和秀才",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n一起玩擠饅頭♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那個遊戲呀！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "來玩吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "來嘛來嘛，",
    "voice": "vo_adv_2104002_008",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "美咲也一起～♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "等等，鈴奈！",
    "voice": "vo_adv_2104002_009",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n這種事情不要找我啦。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "成熟的淑女",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可不會玩那種遊戲！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好囉好囉～♪",
    "voice": "vo_adv_2104002_010",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n大家，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "班會時間到囉～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊，",
    "voice": "vo_adv_2104002_011",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "伊緒來了。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，",
    "voice": "vo_adv_2104002_012",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "快坐快坐！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n你的位子，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "在人家和美咲的中間唷☆",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "歡迎你回來，{0}。",
    "voice": "vo_adv_2104002_013",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "再跟我們一起",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "學習好多的新東西吧♪",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵♪",
    "voice": "vo_adv_2104002_014",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "能看到你回來，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "老師非常的開心唷。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n而且……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "沒想到今天！",
    "voice": "vo_adv_2104002_015",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我們又增加幾位",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "美好的夥伴們囉♪",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦？",
    "voice": "vo_adv_2104002_016",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "意思是有轉學生嗎？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "又有了？",
    "voice": "vo_adv_2104002_017",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n最近真多啊？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，",
    "voice": "vo_adv_2104002_018",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對吼，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才你不知道嘛。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "前陣子",
    "voice": "vo_adv_2104002_019",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "也來了一個轉學生喔。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就是她，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "座位在窗戶旁邊的——",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好了好了，",
    "voice": "vo_adv_2104002_020",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "大家請安靜一點～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "movie",
    "movie_id": "210400201"
  },
  {
    "type": "background",
    "bg_id": "500080"
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "可是……",
    "voice": "vo_adv_2104002_021",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我也是最近",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "才剛到這個學校來的唷。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n沒關係嗎？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "老師。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那當然呀，美空。",
    "voice": "vo_adv_2104002_022",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n能夠教導別人的話，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "自己同時也會學到東西呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "……那麼……",
    "voice": "vo_adv_2104002_023",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n公主殿下，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "初次見面★",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n雖然時間可能很短暫，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "但還請您多多指教了～♪",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好的，",
    "voice": "vo_adv_2104002_024",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我也請妳多多指教了唷☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……那個，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "美空同學？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "不用加什麼同學啦！",
    "voice": "vo_adv_2104002_025",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n直接直呼我的名字也完全OK的唷♪",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣的話，",
    "voice": "vo_adv_2104002_026",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那我就",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "叫妳「小美空」了唷。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我的話……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳能叫我貪吃佩可的話我會很開心的！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "貪吃佩可？",
    "voice": "vo_adv_2104002_027",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊哈哈，",
    "voice": "vo_adv_2104002_028",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好怪唷～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n超好笑～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "妳等等，鈴奈！",
    "voice": "vo_adv_2104002_029",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n妳也太失禮了吧，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "對方可是皇室的淑女喔！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": "vo_adv_2104002_030",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒關係的唷♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我完全",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不會在意這點事的！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n反而如果大家願意接納我，我會很開心的☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "美空",
