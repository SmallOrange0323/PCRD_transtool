    "type": "dialogue",
    "name": "實況",
    "words": "美美選手，",
    "voice": "vo_adv_5031005_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "停下來休息了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n這就是",
