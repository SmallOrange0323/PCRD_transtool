    "type": "dialogue",
    "name": "美美",
    "words": "我咬♪　",
    "voice": "vo_adv_5031005_009",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "真好吃呢～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呼呼……",
    "voice": "vo_adv_5031005_010",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真的",
    "voice": "vo_adv_5031005_011",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "看不到半個人影了……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "果然還是不行呢……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "畢竟我連體力都沒有……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "如果沒有我，",
    "voice": "vo_adv_5031005_012",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "【美食殿堂】的各位就能……",
