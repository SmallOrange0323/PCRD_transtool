    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "第一名，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "所謂強者的從容嗎！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n真是前途可畏的少女！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "美美……",
    "voice": "vo_adv_5031005_007",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "竟然開始野餐了呢。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "美美的行動",
    "voice": "vo_adv_5031005_008",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是最無法預料的呢……",
    "voice": null,
    "unit_id": 103611
  },
