  {
    "type": "dialogue",
    "name": "實況",
    "words": "好，",
    "voice": "vo_adv_5031005_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "現在第一名的是騎著小小格里芬先生的美美選手，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n跟其他選手拉開了差距！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n她有辦法領先到最後嗎！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_5031005_001",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "我們是第一名唷～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n很厲害吧～",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "美美加油！　",
    "voice": "vo_adv_5031005_002",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這樣說不定真的能獲勝耶！？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "還不能掉以輕心唷！",
    "voice": "vo_adv_5031005_003",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "以目前為止的比賽過程來看，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就算發生什麼怪事也不奇怪……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "小小格里芬",
    "words": "噗噗噗噗，",
    "voice": null,
    "unit_id": 2211
  },
  {
    "type": "dialogue",
    "name": "小小格里芬",
    "words": "咕嚕咕嚕～",
    "voice": null,
    "unit_id": 2211
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗯～？　",
    "voice": "vo_adv_5031005_004",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "小小格里芬先生，",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "你肚子餓了嗎～？",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "對耶，",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "因為你載著美美在飛奔嘛。",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "好，",
    "voice": "vo_adv_5031005_005",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美帶了點心，",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "我們一起吃吧！",
    "voice": null,
    "unit_id": 102011
  },
