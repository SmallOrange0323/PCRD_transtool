    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n趕快去抓逃跑速度很快的魔物吧！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "出現了呢！",
    "voice": "vo_adv_1806001_065",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "朝這邊過來就宰了你，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n逃走的話就抓起來。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你會是哪一種呢？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好快！？",
    "voice": "vo_adv_1806001_066",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "目前為止抓到的魔物根本就無法比擬！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "絕對要抓起來哦！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們兵分兩路來夾擊吧！",
    "voice": "vo_adv_1806001_067",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒問題，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我會用魔法來支援你的！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "做得好！",
    "voice": "vo_adv_1806001_068",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就這樣逼近牠！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要上囉！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哈啊啊啊啊啊！！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好，",
    "voice": "vo_adv_1806001_069",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這樣就完成任務了呢。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒事嗎？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有沒有受傷？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我不是說魔物，是在擔心你啊……",
    "voice": "vo_adv_1806001_070",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "算了，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都沒事就好。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "接下來只要把魔物交給那個人就好。",
    "voice": "vo_adv_1806001_071",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "走吧。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "歡迎回來，",
    "voice": "vo_adv_1806001_072",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "兩位沒事真是太……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "呃，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那個魔物是！？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什、",
    "voice": "vo_adv_1806001_073",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼……？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這是很難照料的魔物，",
    "voice": "vo_adv_1806001_074",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "但是如果能好好地讓牠跑起來的話，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n是任何魔物都只能望其項背的最棒魔物啊！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哇──！",
    "voice": "vo_adv_1806001_075",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "牠跑起來一定會讓觀眾為之沸騰的！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n太厲害了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "沒想到您會抓來這麼厲害的魔物！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是、",
    "voice": "vo_adv_1806001_076",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總之，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "能讓你滿意就好。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在這之後重新展開的大賽受到觀眾們的熱烈歡呼所包圍。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在喧囂大賽會場的一旁，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n凱留的臉上浮現了滿足的笑容。",
    "voice": null,
    "unit_id": null
  }
]
