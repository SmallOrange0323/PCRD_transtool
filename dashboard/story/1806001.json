[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "扛著東西走在街上的{0}，\\n遇見了凱留。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你又在打工送貨了嗎？",
    "voice": "vo_adv_1806001_000",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才剛從嬰兒變回來就開始工作，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還真有你的風格呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……咦？",
    "voice": "vo_adv_1806001_001",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然想說城鎮已經復原不少了，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但還是有災情慘重的地方呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "【憤怒‧軍團】的傢伙們也三不五時就引起騷動，",
    "voice": "vo_adv_1806001_002",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n要完全恢復原狀是不可能的嗎。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯，",
    "voice": "vo_adv_1806001_003",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也來幫你搬那些東西吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n稍微分我一點。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "既然你都拿得動了，",
    "voice": "vo_adv_1806001_004",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那我也拿得動。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "再說了，",
    "voice": "vo_adv_1806001_005",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是我給大家添了麻煩，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n來幫忙重建也是天經地義……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊～",
    "voice": "vo_adv_1806001_006",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了快點拿過來！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這個要搬到哪裡去？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還有人在等著呢，快點搬過去吧！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "background",
    "bg_id": "500250"
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哦～！",
    "voice": "vo_adv_1806001_007",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "等你們很久了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "快快，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "把你們搬過來的建材放在這裡吧！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "咦？",
    "voice": "vo_adv_1806001_008",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "難道說旁邊的這位女性……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不就是以前在這裡工作過的調教師小姐嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…………",
    "voice": "vo_adv_1806001_009",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……我說，",
    "voice": "vo_adv_1806001_010",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "{0}。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n該不會，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這裡是",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我工作過的魔物大賽會場？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這種地方有需要重建嗎啊啊啊！！",
    "voice": "vo_adv_1806001_011",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這麼說來，",
    "voice": "vo_adv_1806001_012",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個變態在哪裡？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好像沒有看到他的身影。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "啊，",
    "voice": "vo_adv_1806001_013",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "老闆他因為先前發生的戰鬥…………",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？",
    "voice": "vo_adv_1806001_014",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "難道說……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "需要籌措重建會場的修理費，",
    "voice": "vo_adv_1806001_015",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "正在大陸各地\\n奔走唷。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "一邊埋頭苦幹，一邊感受著勞動的喜悅呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哎～～～～",
    "voice": "vo_adv_1806001_016",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然是那樣的變態，不過人沒事真是太好了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是，",
    "voice": "vo_adv_1806001_017",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這裡也因為那場戰鬥而毀損了呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "就是啊。",
    "voice": "vo_adv_1806001_018",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n而且這裡雖然說是政府公認的，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "但畢竟是娛樂設施呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n所以沒有分配到重建的預算，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "遲遲無法修復。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "老闆他拚了命地奔波，",
    "voice": "vo_adv_1806001_019",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n好不容易才有了重新開張的希望。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也是有人很喜歡這樣的地方呢。",
    "voice": "vo_adv_1806001_020",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "希望能早點恢復營業就好了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "東西也送到了，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們就先告辭了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "請等～～～～",
    "voice": "vo_adv_1806001_021",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "一下！！！！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什、",
    "voice": "vo_adv_1806001_022",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不要突然那麼大聲嚇人啊！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n是我們搬來的東西有問題嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不，",
    "voice": "vo_adv_1806001_023",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "東西沒有任何問題。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "只是，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "既然調教師小姐在的話，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我還有一個不情之請。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要我幫忙？",
    "voice": "vo_adv_1806001_024",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n嗯，反正也算是幫忙重建，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你就說說看是什麼事吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "如您所見，會場的重建正順利進行著，",
    "voice": "vo_adv_1806001_025",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "但是比賽用的魔物卻不夠呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "希望能拜託您這位厲害的調教師協助，",
    "voice": "vo_adv_1806001_026",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n幫忙捕捉魔物。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那是，",
    "voice": "vo_adv_1806001_027",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然我是很想幫忙啦……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等一下！",
    "voice": "vo_adv_1806001_028",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你幹嘛擅自回答啊！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你也知道的吧！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就是……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我已經沒有",
    "voice": "vo_adv_1806001_029",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "操控魔物的力量了喔？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "根本就沒辦法好好完成這個委託吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼？",
    "voice": "vo_adv_1806001_030",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說起來好像是這樣沒錯。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這裡的人什麼力量都沒有，卻在抓魔物呢……",
    "voice": null,
