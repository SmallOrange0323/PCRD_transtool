[
  {
    "type": "background",
    "bg_id": "500133"
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "やったッス！　",
    "voice": "vo_adv_5104442_000",
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "自分たちの大勝利ッスよ！",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "敵の切り札も打ち止め……",
    "voice": "vo_adv_5104442_001",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "というところか。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "\\nこれで和平活動の支障はすべて排除した。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "さあ、",
    "voice": "vo_adv_5104442_002",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "早く撤収して祝杯を挙げるぞ。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "\\n思う存分に飲み、",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "そして食らうがいいよ。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "今日は特別にワタシがおごってやる。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "本当ッスか？　",
    "voice": "vo_adv_5104442_003",
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "よかったッス！",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "自分、",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "マツリ",
    "words": "もうおなかペコペコッスよ～",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "なに、",
    "voice": "vo_adv_5104442_004",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "部下の功労に報いるのもワタシの仕事だからな。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "明日からはまた頑張ってもらうことになるが……",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "フッ、",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "今日くらいは",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "クリスティーナ",
    "words": "ゆっくりしてもバチは当たらんだろうさ。",
    "voice": null,
    "unit_id": 123811
  }
]
