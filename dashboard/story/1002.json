[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在【美食殿堂】和【破曉之星】的成員們",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n體驗拉比林斯達製作的不可思議的遊戲世界後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n又過了一段日子──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "來吧、來吧，歡迎光臨！",
    "voice": "vo_adv_0001002_000",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我們有很好吃的美味可麗餅喔～！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "妳好，",
    "voice": "vo_adv_0001002_001",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "拉比林斯達小姐。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雪菲！",
    "voice": "vo_adv_0001002_002",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "今天想吃什麼？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呃，",
    "voice": "vo_adv_0001002_003",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我不是來點餐的……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那個……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗨。",
    "voice": "vo_adv_0001002_004",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "妳好──。",
    "voice": "vo_adv_0001002_005",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "切嚕～☆",
    "voice": "vo_adv_0001002_006",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "優妮們的各位～！",
    "voice": "vo_adv_0001002_007",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "大家過得好嗎？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呃……",
    "voice": "vo_adv_0001002_008",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "姐姐，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "一點都不好。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n可以請妳不要",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "一開始就貶損我們的公會名稱嗎？",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這可是歧視喔。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "具歧視性的發言將會牽扯到法規喔。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這樣啊？",
    "voice": "vo_adv_0001002_009",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真奇怪～",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我印象中，少年有時也會這樣稱呼妳們啊……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊，",
    "voice": "vo_adv_0001002_010",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那位學長可能有這樣的習慣。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就像是小孩子",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "會一直反覆地唸著粗俗用語一樣。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n再不然就是拉比姐姐的錯覺，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "俗稱幻聽。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "拉比林斯達博士，",
    "voice": "vo_adv_0001002_011",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳看看。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n任意地扭曲事實，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "然後當成真相來傳講──",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "簡直就像是這個世界的縮圖。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我可不認為這是傻里傻氣。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "克蘿依學姐，",
    "voice": "vo_adv_0001002_012",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不好了。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n因為與能抓住人心的公會名相聲錯身而過，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n優妮學姐吐槽的矛頭終於往莫名的方向去了。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "客人要求的是流行文化，",
    "voice": "vo_adv_0001002_013",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "卻以藝術路線為目標……",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "她就像是這樣的人。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "別管她了，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "等她玩夠了就會回來。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊，",
    "voice": "vo_adv_0001002_014",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那個……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n各位，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "差不多該進入正題了吧……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "正題？",
    "voice": "vo_adv_0001002_015",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳們還真是稀奇的組合。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "如果有事找我……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "對了，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是有關遊戲的事吧？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "妳很敏銳！",
    "voice": "vo_adv_0001002_016",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我不想直接說謝謝！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "很切嚕感謝妳這次把我們加入角色群！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "能夠再次重現琪愛兒的完美可愛模樣，根本就是神了。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話說回來，",
    "voice": "vo_adv_0001002_017",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "戰鬥很熱血呢。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "該怎麼說呢，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "絕妙嗎？",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "像我的弟弟們，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "基本上都吵吵鬧鬧的，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n但也會有緊張屏息的瞬間。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，的確可以玩一輩子呢。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "正是。",
    "voice": "vo_adv_0001002_018",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "勝負單純只是時運好壞，或是太過小看對手，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但藉由智力的干涉來改變戰況，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "想不到就成了令人熱血沸騰的戰鬥。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n講白一點，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是會讓人上癮。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "拉比林斯達，",
    "voice": "vo_adv_0001002_019",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "謝謝妳遵守了那時候的約定。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "讓我的角色",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "也能和大家一起戰鬥。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "即便知道那不是我本人，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還是會忍不住幫大家加油。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這樣啊。",
    "voice": "vo_adv_0001002_020",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳們可以玩得開心，真是太好了。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "能夠獲得玩家直接回饋的心得，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是開發者最大的幸福。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "全都用完吧！",
    "voice": "vo_adv_0001002_021",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "妳就把福氣全都用完吧！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "妳才做了這麼一點工作！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "喂，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "妳這個天才創作家！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n雖說只有一個大問題，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "妳就別放在心上，連接上明天吧！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "問題？",
    "voice": "vo_adv_0001002_022",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真是奇怪，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我已經很仔細地四處檢查過了啊……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "博士，",
    "voice": "vo_adv_0001002_023",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這沒有什麼好放在心上的。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我們都知道，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "人不是完美的。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這只不過是",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "無意間所犯的失誤，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "只要立即改善就可以了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，",
    "voice": "vo_adv_0001002_024",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "可是，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "當我知道有那個漏洞時，真的很震驚。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "想不到",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個拉比姐姐也會有粗心大意的時候。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這怎麼可能，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "竟然會忘了把我們實際安裝成隊長。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不，博士，",
    "voice": "vo_adv_0001002_025",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我們不是想指責妳，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "請不要啞口無言。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n妳肯定累了吧，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這我們都知道。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "雖然我們都知道……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "只是覺得",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "雪菲太可憐了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦！？",
    "voice": "vo_adv_0001002_026",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我、",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我並沒有……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不，",
    "voice": "vo_adv_0001002_027",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我都知道。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳的眼中流露出希望破碎的悲傷神",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n。若否定了現在所認識的存在，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "很可能就會造成對妳自身的否定。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳無須顧慮誰，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "只要解放顯露出的意識就好。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "預備，起。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我、",
    "voice": "vo_adv_0001002_028",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我只是……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還想和大家在一起，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n因為我覺得很開心……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雪菲！",
    "voice": "vo_adv_0001002_029",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗚嗚～！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我都快哭了～！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "相較起來，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這麼年輕就讓她代為說出自己的意見，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n對於像這樣為了保命而失控的遭遇，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "女高中生的各位會怎麼想呢？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "哎呀！",
    "voice": "vo_adv_0001002_030",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "雪菲真的好可憐！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n這麼好的孩子，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "果然應該讓她成為隊長！？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊，不，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我們的事用不著多慮。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話雖如此，",
    "voice": "vo_adv_0001002_031",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "只有雪菲一個人未免也太操勞了。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "該說是容易亂了套嗎？",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "或是辦不成同學會之類的？",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不不，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "妳用不著在意我們的事。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不過，",
    "voice": "vo_adv_0001002_032",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "她也會害怕只有自己受到特別待遇吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "如果同時實裝了三個人，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "她也會比較安心。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不不，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不用管我們……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "博士，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳知道接下來該怎麼做了吧？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊哈哈哈……",
    "voice": "vo_adv_0001002_033",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真傷腦筋。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我原本也曾想過更加豐富的更新……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "別看我這樣。",
    "voice": "vo_adv_0001002_034",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我有時是可麗餅店的店長，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n有時是祕密結社拉比林斯的公會長，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "然後，有時也是",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "七冠的迷宮女王……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "像這樣，我做了很多的事。",
    "voice": "vo_adv_0001002_035",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n這些可是相當難控制的呢。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "因為我很清楚了解大家的心情。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "拉比林斯達小姐……",
    "voice": "vo_adv_0001002_036",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "謝謝妳。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我想好朋友社的各位",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "肯定也能夠理解。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，",
    "voice": "vo_adv_0001002_037",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我很難加以否定……",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這是什麼總結方式啊。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n被妳發現",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我們不管怎麼說，對於好話都很沒轍嗎？",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這樣真的很令人無奈奈呢。",
    "voice": "vo_adv_0001002_038",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "既然她也聽了我們的抱怨，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這次就先在這裡退讓一步吧。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "說得也是。",
    "voice": "vo_adv_0001002_039",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這次就很乾脆地放棄吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "如果那位迷宮女王有很多種方法，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這也會有很多種吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "所以說，我們來談下次的話題。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "下次一定要把我們實裝成隊長喔。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "等、",
    "voice": "vo_adv_0001002_040",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "等等，各位！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雪菲。",
    "voice": "vo_adv_0001002_041",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n沒關係，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "照這種調調，只是在說些廢話罷了。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "既然來了，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "妳也說句話吧。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "來，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "預備，起。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊……",
    "voice": "vo_adv_0001002_042",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那、",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那個……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "如果可以的話，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "下次如果能讓我以隊長的身分",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "登場……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n我開玩笑的……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "就是說啊。",
    "voice": "vo_adv_0001002_043",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "下次如果有機會……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "可不能繼續待在這裡了！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n新口味的可麗餅正在呼喚著我！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "所以，各位掰～掰！",
    "voice": "vo_adv_0001002_044",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n啊，謝謝妳們玩我的遊戲～！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\nThank you for playing～！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦咦，瞬間消失了！？",
    "voice": "vo_adv_0001002_045",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n剛剛那是什麼，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是魔法？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "魔術？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "幽靈？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n到底是……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "腳底下是不是有聲音響起？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "物件變更！？",
    "voice": "vo_adv_0001002_046",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n拉比林斯達為了逃走，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "竟然做到這般地步！？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "她剛才",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "一定是利用七冠的權能，將這底下移動到某處去……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_0001002_047",
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "迷宮的女王，就是……",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這種作法，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真的是這樣。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n她是個可以很快破解迷宮遊戲的人，",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就像解謎王那樣。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯……",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真是個有趣的女人。",
    "voice": null,
    "unit_id": 110812
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "原來如此，",
    "voice": "vo_adv_0001002_048",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我了解了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這是她給我們的戰帖！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "渴望獲得的獎勵，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "將會給予捕捉到女王的人！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "走吧，各位！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊！",
    "voice": "vo_adv_0001002_049",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那兩個人真奸詐，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "竟然偷跑！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "喂，等等──！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "是這樣嗎！？",
    "voice": "vo_adv_0001002_050",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這也就是說，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我也包含在內！？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "請、",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "請等一下，各位～！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "別丟下我啊～！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n因為我也想要",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "成為隊長～！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，雪菲與好朋友社的成員們，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了找出逃走的拉比林斯達，各自跑了起來。",
    "voice": null,
    "unit_id": null
  }
