    "words": "お化け屋敷、",
    "voice": "vo_adv_6050106_000",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "お化け屋敷かぁ……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "考え始めるといろいろと難しいものですね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "騎士さん、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "何かアイデアないですか？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "だからそのためにどうするか……",
    "voice": "vo_adv_6050106_001",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "いや、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "それも大切ですね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\nまずは経験を積まないといけませんから。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "でも呼び込みは",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n騎士さんの仕事ですよ？　",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "責任重大です。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "がんばってくださいね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "お化け屋敷って基本的に直接接触厳禁なんですよ？",
    "voice": "vo_adv_6050106_002",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "でももし、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "レイ様にそんなことができたら……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "だめですね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n気づかれて叱られる未来しか見えません。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "い、",
    "voice": "vo_adv_6050106_003",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "意外と荒っぽいアイデアですね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\nえ？　",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "こんにゃくをほっぺに？　",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "そ、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "そうですか……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "まぁ、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "候補としては残しておきますね。",
    "voice": null,
    "unit_id": 113911
  }
]
