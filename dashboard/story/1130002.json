  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那麼，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我負責找這一區，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那邊就麻煩你了。",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "──唔～嗯，",
    "voice": "vo_adv_1130002_004",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "找不到呢……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n我原本想說這附近植物那麼多，",
