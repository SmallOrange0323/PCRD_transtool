    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "總是依賴{0}前輩……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n自己一個人就什麼也辦不到……",
    "voice": null,
    "unit_id": 113011
