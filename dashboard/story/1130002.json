    "type": "dialogue",
    "name": "步未",
    "words": "……這樣下去是不行的！",
    "voice": "vo_adv_1130002_010",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n我也要不放棄繼續找才對！",
    "voice": null,
    "unit_id": 113011
  },
