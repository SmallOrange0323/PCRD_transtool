    "type": "dialogue",
    "name": "步未",
    "words": "然而……",
    "voice": "vo_adv_1130002_008",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "然而我卻打算",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n如此輕易地就放棄……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
