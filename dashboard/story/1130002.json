    "type": "dialogue",
    "name": "步未",
    "words": "……不這麼做的話，",
    "voice": "vo_adv_1130002_011",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n我沒有資格和那麼努力的{0}前輩",
