    "name": "蘭法",
    "words": "兩位，",
    "voice": "vo_adv_5202061_013",
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "謝謝……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "啊，",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "只是……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
