  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "會努力，",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "不要拖累你們",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "的……",
    "voice": null,
    "unit_id": 134311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "只要大家同心協力就不會有問題的。",
