[
  {
    "type": "background",
    "bg_id": "500354"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "第一次物產展舉辦後過了一陣子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n育幼院現在會定期舉辦物產展。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "今天正好是舉辦物產展的日子──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "早安，",
    "voice": "vo_adv_1213003_000",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥！",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n請過來這裡！",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n謝謝你總是過來幫忙♪",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "可以請你幫忙補充產品嗎？",
    "voice": "vo_adv_1213003_001",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n東西有點重。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我要去",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "幫忙接待客人！",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦！？",
    "voice": "vo_adv_1213003_002",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我、",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我一直都很有精神呀，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n難道之前不是這樣嗎？",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "你說在接待客人方面，",
    "voice": "vo_adv_1213003_003",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "難得看到我不太緊張……？",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "確實是這樣。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我和平常的「胡桃」",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "可能",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不太一樣。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "呃，",
    "voice": "vo_adv_1213003_004",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我說和平常的胡桃不一樣，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "意思是",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "今天的我是",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "「保衛起司大作戰」的",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "胡桃。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "保衛起司大作戰的胡桃，",
    "voice": "vo_adv_1213003_005",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n是一名為大家帶來活力的角色，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "所以我要打起精神，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不管碰到誰都不能緊張♪",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "完全融入角色後，",
    "voice": "vo_adv_1213003_006",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "恐懼就全都消失不見了。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "雖然我平時",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "很內向，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "又很容易緊張……",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "可能是這樣吧。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嘿嘿……",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "其實我有時候",
    "voice": "vo_adv_1213003_007",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "還是會緊張，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不過這種時候",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我會唸一個祕密咒語！",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我也告訴",
    "voice": "vo_adv_1213003_008",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥好了。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "客人是起司，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "客人是起司，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "客人是起司……♪",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "能這樣想就不會怕了，",
    "voice": "vo_adv_1213003_009",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "因為起司是",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "美味的夥伴。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦！？",
    "voice": "vo_adv_1213003_010",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "怎怎、",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "怎麼了哥哥？",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "怎麼突然這麼說！？",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "真正適合用「帥氣」來形容的是，",
    "voice": "vo_adv_1213003_011",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "想透過做生意來為",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "大家帶來",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "幸福的秋乃，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n或是身負使命感",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "而一直為大家",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "奉獻的",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咲戀媽媽那樣的人……",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我完全",
    "voice": "vo_adv_1213003_012",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "還完全不夠資格！",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "唔唔～",
    "voice": "vo_adv_1213003_013",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我明明說自己還沒有資格，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n哥哥硬是要唱反調～",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "奇怪？",
    "voice": "vo_adv_1213003_014",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "賣場那邊",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "是不是發生什麼事了？",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我們去看看吧，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "唔唔……",
    "voice": "vo_adv_1213003_015",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "呃，",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "那個……",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那個女生，",
    "voice": "vo_adv_1213003_016",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "是沒多久前",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "才來到咲戀育幼院的……",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "小姐。",
    "voice": "vo_adv_1213003_017",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "這個和這個，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "我要各３個，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n可以告訴我多少錢嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "還有，",
    "voice": "vo_adv_1213003_018",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "我想報名參加大自然美食之旅，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n想知道行程是怎麼排的。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "呃……",
    "voice": "vo_adv_1213003_019",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "那個……",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "傷腦筋。",
    "voice": "vo_adv_1213003_020",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "我問的應該不是什麼",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "很困難的問題啊……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "對、",
    "voice": "vo_adv_1213003_021",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "對不起！！",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊！",
    "voice": "vo_adv_1213003_022",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "等一下！",
    "voice": null,
    "unit_id": 121311
  },
  {
