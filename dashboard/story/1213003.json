    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "嗚……",
    "voice": "vo_adv_1213003_023",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "嗚……",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "\\n",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "我、",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "我逃跑了……",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "\\n我明明",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "不該",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "這麼做……",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "嗚嗚、",
    "voice": "vo_adv_1213003_024",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "妳怎麼了？",
    "voice": "vo_adv_1213003_025",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "呀啊！？",
    "voice": "vo_adv_1213003_026",
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "\\n",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "胡桃姐姐……！",
