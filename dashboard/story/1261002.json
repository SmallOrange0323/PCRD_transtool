[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在救下倒在路旁的普蕾西亞後，又過了幾天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}再次看見",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n普蕾西亞一個人走在路上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "……（啪噠啪噠）",
    "voice": "vo_adv_1261002_000",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "哥。",
    "voice": "vo_adv_1261002_001",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "早安。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "之前，",
    "voice": "vo_adv_1261002_002",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n救了、",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "我，",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n謝謝。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_1261002_003",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "沒問題。",
    "voice": "vo_adv_1261002_004",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "那麼，",
    "voice": "vo_adv_1261002_005",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n我走了。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "background",
    "bg_id": "500360"
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "這樣啊……",
    "voice": "vo_adv_1261002_006",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n您遇見了",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "普蕾西亞呢。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "──其實，",
    "voice": "vo_adv_1261002_007",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我今天也是為了這件事，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "特地前來找您商量。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "即便先前",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "普蕾西亞餓倒在路上，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n然而那之後她還是會一個人外出……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "雖然我也曾多次詢問她",
    "voice": "vo_adv_1261002_008",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "要出門做什麼，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "但是她只會回我說",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "「一個人沒問題」……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "不過就如您所知，",
    "voice": "vo_adv_1261002_009",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n普蕾西亞",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是個自由自在……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "非常隨興的人。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "也無法保證",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "她不會被捲入壞事之中。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我",
    "voice": "vo_adv_1261002_010",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "和璃亞",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "都很",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "擔心她……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "咦？",
    "voice": "vo_adv_1261002_011",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n您是指要尾隨普蕾西亞",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "的意思嗎……？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "原來如此……",
    "voice": "vo_adv_1261002_012",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "要默默探查她的隱情對吧……！",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "…………（啪噠啪噠）",
    "voice": "vo_adv_1261002_013",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……她",
    "voice": "vo_adv_1261002_014",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "正在走路呢。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "不對，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "這是理所當然的……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "……",
    "voice": "vo_adv_1261002_015",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "她在魚販前面",
    "voice": "vo_adv_1261002_016",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "停下來了。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "魚店店長",
    "words": "普蕾西亞，妳來妳來！",
    "voice": "vo_adv_1261002_017",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "魚店店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "魚店店長",
    "words": "這是用店裡的魚做的竹輪，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "魚店店長",
    "words": "剛剛才烤好的！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "魚店店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "魚店店長",
    "words": "很好吃喔～！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "非常，",
    "voice": "vo_adv_1261002_018",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n謝謝你。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嚼嚼……",
    "voice": "vo_adv_1261002_019",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_1261002_020",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n優勝。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "魚店店長",
    "words": "對吧？",
    "voice": "vo_adv_1261002_021",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "魚店店長",
    "words": "\\n我包一些讓妳當伴手禮啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "魚店店長",
    "words": "拿去吧！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "看起來",
    "voice": "vo_adv_1261002_022",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "跟店長很親近呢……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "background",
    "bg_id": "501960"
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店店長",
    "words": "哦，",
    "voice": "vo_adv_1261002_023",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店店長",
    "words": "歡迎光臨。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店店長",
    "words": "\\n今天也很努力呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店店長",
    "words": "來，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店店長",
    "words": "這個給妳。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "懷舊糖果店店長",
    "words": "棒棒糖。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "謝謝。",
    "voice": "vo_adv_1261002_024",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n我開動了",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "……舔舔。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "這、",
    "voice": "vo_adv_1261002_025",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "這次是",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "小菜店的人給了她關東煮！",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n有蘿蔔、",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "蛋，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "跟蒟蒻……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "看起來很美味。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……不過，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "她是怎麼付錢的呢……？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "吃光光。",
    "voice": "vo_adv_1261002_026",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "小菜店店長",
    "words": "妳的吃相",
    "voice": "vo_adv_1261002_027",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "小菜店店長",
    "words": "還是一樣很棒呢。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "小菜店店長",
    "words": "\\n記得要再來喔！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "多謝。",
    "voice": "vo_adv_1261002_028",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是啊……",
    "voice": "vo_adv_1261002_029",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我想……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "她之所以會一個人外出……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "看起來",
    "voice": "vo_adv_1261002_030",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "似乎是這樣呢……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……的確，",
    "voice": "vo_adv_1261002_031",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "不管是我還是璃亞，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n都很難跟上普蕾西亞吃東西",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "的速度。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "看來她是希望",
    "voice": "vo_adv_1261002_032",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "可以不用顧慮任何人，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n獨自悠哉地享受",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "邊走邊吃的樂趣……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "原來是這樣……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "知道她是想邊走邊吃後，",
    "voice": "vo_adv_1261002_033",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "雖然有點鬆了口氣……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "但單獨行動還是會讓人擔心呢。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
