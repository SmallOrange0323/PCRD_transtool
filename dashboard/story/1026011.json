  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "鈴順利獲得想找的飲料，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與{0}一起走在往伊麗莎白牧場的路上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "被魔物襲擊的人們都沒事，",
    "voice": "vo_adv_1026011_000",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n還獲得了大量的飲料，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哎呀～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "可喜可賀、可喜可賀。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過，",
    "voice": "vo_adv_1026011_001",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "有點工作過度了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "對了，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你背我一下嘛。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "在這期間，",
    "voice": "vo_adv_1026011_002",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我會好好睡一覺……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "欸？",
    "voice": "vo_adv_1026011_003",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "怎、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n你是為了不讓我睡才發光的嗎？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我、",
    "voice": "vo_adv_1026011_004",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我知道了啦！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我走！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我會乖乖",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "自己走的～～！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "background",
    "bg_id": "510210"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗚嗚～",
    "voice": "vo_adv_1026011_005",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然努力來上學了，",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但果然還是很累……",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "在保健室睡一下就回家吧……",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不好意思～",
    "voice": "vo_adv_1026011_006",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我身體有點不舒服，請讓我在這裡休息……",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呃，",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哎呀？",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "沒人在嗎？",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "唉呀，",
    "voice": "vo_adv_1026011_007",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "算了。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我自己隨便找張床躺下吧。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呼啊～",
    "voice": "vo_adv_1026011_008",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "鬆鬆軟軟的棉被～",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n不管是",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哪裡的棉被，都令人心情平靜呢～",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n是心之故鄉～",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "晚安～",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗚，",
    "voice": "vo_adv_1026011_009",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "明明是為了不被他發現才溜出來的……",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "太敏銳了吧……",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "background",
    "bg_id": "510210"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "是是，",
    "voice": "vo_adv_1026011_010",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我在喔。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "在人家難得要睡了的時候過來，",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "是怎樣啊？",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "話說，",
    "voice": "vo_adv_1026011_011",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "別直接叫我鈴啦。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n被人聽到",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "會很不好意思吧。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "叫我森近……",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……啊。",
    "voice": "vo_adv_1026011_012",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我擅自跑掉了，",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "對不起。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我想說",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不能連在學校也給你添麻煩",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這樣。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "以後我會",
    "voice": "vo_adv_1026011_013",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "先跟你說一聲的。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……雖然不知道還有沒有下次。",
    "voice": "vo_adv_1026011_014",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "唉～",
    "voice": "vo_adv_1026011_015",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "都已經來學校了，",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n還偷懶是",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不行的吧。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好、好，",
    "voice": "vo_adv_1026011_016",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我回教室……",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就是了…………",
    "voice": "vo_adv_1026011_017",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "欸？",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "{0}，",
    "voice": "vo_adv_1026011_018",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你不是來帶我回教室的嗎？",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那是～",
    "voice": "vo_adv_1026011_019",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "因為還不習慣上學，",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "難免啦。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但我覺得",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你其實沒有必要……",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "沒有必要……",
    "voice": "vo_adv_1026011_020",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那麼擔心我……",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦？",
    "voice": "vo_adv_1026011_021",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好奇怪喔？",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "要是平時的我",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "應該會很開心地躺回被窩。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "為什麼會想要繼續加油呢……",
    "voice": "vo_adv_1026011_022",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我看起來有那麼難受嗎……",
    "voice": "vo_adv_1026011_023",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我自己是感覺不出來……",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但你很了解我，既然你都那麼說了，",
    "voice": "vo_adv_1026011_024",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "或許……",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真的是這樣吧？",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哇，",
    "voice": "vo_adv_1026011_025",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哇～～！？",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不用拉我的手，",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我自己也會去啦！",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真是的～",
    "voice": "vo_adv_1026011_026",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "是怎樣啦。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "和平常不一樣……",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "still",
    "still_id": "102601101"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗚…………",
    "voice": "vo_adv_1026011_027",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然很感謝你讓我休息，",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n但不要把我當小孩子對待啦。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我",
    "voice": "vo_adv_1026011_028",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "跟你同年紀喔。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還是同班同學，",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你知道吧。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你還要繼續把我當成小孩子啊～？",
    "voice": "vo_adv_1026011_029",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "話說回來，",
    "voice": "vo_adv_1026011_030",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你不認為我是在偷懶呢。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我實在太～懶散了，",
    "voice": "vo_adv_1026011_031",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "以至於連我自己，",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "都不曉得這",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "算不算在偷懶……",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這雖然是半開玩笑，",
    "voice": "vo_adv_1026011_032",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但我今天很不像我，",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n好像太勉強自己了。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "唉～",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不該做自己不習慣的事的～",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你有阻止我真是幫了大忙。",
    "voice": "vo_adv_1026011_033",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你該不會比我自己",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還要了解我吧？",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哎呀～",
    "voice": "vo_adv_1026011_034",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "有人能巧妙地為我管理健康，真是幫大忙了～",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n今後你也要繼續確實地守護我喔。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n拜託你了。",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "………………嗯？",
    "voice": "vo_adv_1026011_035",
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但這麼一來，",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我不就不能偷懶了？",
    "voice": null,
    "unit_id": 102632
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這樣也很麻煩啊～",
    "voice": "vo_adv_1026011_036",
    "unit_id": 102632
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你啊，",
    "voice": "vo_adv_1026011_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "做得很好哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "鈴總是懶～洋洋的，",
    "voice": "vo_adv_1026011_038",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n像省電模式一樣，所以很難看出來，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但她有時也會不小心勉強自己呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你正確察覺到的小細節，一般人絕對注意不到。",
    "voice": "vo_adv_1026011_039",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你真的很認真地在看著鈴呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "鈴雖然嘴上說很麻煩，",
    "voice": "vo_adv_1026011_040",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但好像還滿開心的樣子。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就算獨自一人做不到，",
    "voice": "vo_adv_1026011_041",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但兩人一起就能做到的事應該有很多吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "今後也繼續守護她吧。",
    "voice": "vo_adv_1026011_042",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "下次見囉♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500131"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯，",
    "voice": "vo_adv_1026011_043",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯嗯唔……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "被窩……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n好舒服……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦，",
    "voice": "vo_adv_1026011_044",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不是在被窩裡睡覺嗎？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n是太累看到的幻覺？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "而且，",
    "voice": "vo_adv_1026011_045",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "除了被窩以外，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好像還有很溫暖的什麼……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "沒、",
    "voice": "vo_adv_1026011_046",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "沒什麼！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n好了，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我們趕快回去吧！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這次我一定要",
    "voice": "vo_adv_1026011_047",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好好地睡一覺！",
    "voice": null,
    "unit_id": 102611
  },
