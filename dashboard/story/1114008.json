    "voice": "vo_adv_1114008_004",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……那個。",
    "voice": "vo_adv_1114008_005",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……",
    "voice": "vo_adv_1114008_006",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……果、",
    "voice": "vo_adv_1114008_007",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "果然還是不行！",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "就是不好吃呀……",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……露娜，",
    "voice": "vo_adv_1114008_008",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "是不是沒辦法像媽媽一樣呢。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "啊！？",
    "voice": "vo_adv_1114008_009",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "好耀眼呀……！？",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "哇啊啊！？",
    "voice": "vo_adv_1114008_010",
    "unit_id": 111411
  },
  {
    "type": "background",
    "bg_id": "510090"
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……哥～！",
    "voice": "vo_adv_1114008_011",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "大哥哥～！",
    "voice": "vo_adv_1114008_012",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "真是的，",
    "voice": "vo_adv_1114008_013",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "我說大哥哥！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n你要睡到什麼時候啊―！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "不快點的話會涼掉的！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "你問什麼，",
    "voice": "vo_adv_1114008_014",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "真是的！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n大哥哥很愛睡過頭呢！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "早餐唷！",
    "voice": "vo_adv_1114008_015",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "是露娜做的唷！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "快一點！",
    "voice": "vo_adv_1114008_016",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n快過來這裡！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "知道了講一次就好！",
    "voice": "vo_adv_1114008_017",
    "unit_id": 111431
  },
  {
    "type": "background",
    "bg_id": "510080"
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "快點，",
    "voice": "vo_adv_1114008_018",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "大哥哥！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "快看！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "　好吃吧！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "我是說看起來很好吃吧！",
    "voice": "vo_adv_1114008_019",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "那我開動了―！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……嚼嚼。",
    "voice": "vo_adv_1114008_020",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n如何？",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "　大哥哥。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "有好吃嗎？",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "那個，",
    "voice": "vo_adv_1114008_021",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "魚的部分呢，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "我是努力烤的唷。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "米飯也是很用心煮的！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "露娜，",
    "voice": "vo_adv_1114008_022",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "因為菜刀還很危險……",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n所以能做的料理沒有很多……",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "但是，",
    "voice": "vo_adv_1114008_023",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "這次可能做得不錯！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "真的嗎！？",
    "voice": "vo_adv_1114008_024",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "太好了。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……其實，",
    "voice": "vo_adv_1114008_025",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "我有失敗很多次呢。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n魚也是，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "也有燒焦的呢……",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "但是，",
    "voice": "vo_adv_1114008_026",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "因為大哥哥會稱讚好吃，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "我一想到會被稱讚，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n就努力了下來。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "嘿嘿……",
    "voice": "vo_adv_1114008_027",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "嗯！",
    "voice": "vo_adv_1114008_028",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "但是，",
    "voice": "vo_adv_1114008_029",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "只會做飯是不行的。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "大哥哥還會睡過頭，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "不好好把你叫起床的話不行。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "還有，",
    "voice": "vo_adv_1114008_030",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "大哥哥常常忘東忘西，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n露娜必須要更可靠才行。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "所以，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "要成為太太的話，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "要等露娜更大才行！",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "嗯！",
    "voice": "vo_adv_1114008_031",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "如果變成更乖的好孩子，",
    "voice": "vo_adv_1114008_032",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "是不是就能更快長大呢？",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "這樣，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "露娜就可以一直照顧你呢。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "現在還沒有辦法，",
    "voice": "vo_adv_1114008_033",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "露娜雖然還很小……",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "但等我長大，",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "露娜要跟大哥哥",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "一直永遠在一起。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……等我長大唷，",
    "voice": "vo_adv_1114008_034",
    "unit_id": 111431
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "大哥哥。",
    "voice": null,
    "unit_id": 111431
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1114008_035",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這是個好夢吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n她很值得讚許呢，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "說起露娜。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "女孩子做飯，",
    "voice": "vo_adv_1114008_036",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這可是一件大事呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "更何況是",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "作給喜歡的人吃。",
    "voice": null,
