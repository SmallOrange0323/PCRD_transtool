    "voice": "vo_adv_1007010_002",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "當時的宮子到底在想什麼啦？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n現在的宮子要好好責備她來的！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "喂妳──！！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這樣喲！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "呼……",
    "voice": "vo_adv_1007010_003",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "感覺輕鬆點了。",
