  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在雪菲奮鬥的同時，時間轉瞬即逝，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n【美食殿堂】的公會小屋迎來了「那一天」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊，",
    "voice": "vo_adv_9005015_000",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那個……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "隨時都可以喔，",
    "voice": "vo_adv_9005015_001",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小雪菲！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雪菲小姐，",
    "voice": "vo_adv_9005015_002",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請加油……！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不要畏畏縮縮的啦，雪菲～！",
    "voice": "vo_adv_9005015_003",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好、",
    "voice": "vo_adv_9005015_004",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好緊張……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "畢竟接下了這個重責大任，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我得鼓起勇氣才行。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "開始吧──",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好的各位，",
    "voice": "vo_adv_9005015_005",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n都準備好了嗎！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n一、二、三！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "still",
    "still_id": "900201701"
  },
  {
    "type": "dialogue",
    "name": "全員",
    "words": "4.5周年！",
    "voice": "vo_adv_9005015_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "全員",
    "words": "\\n恭喜！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "各位，",
    "voice": "vo_adv_9005015_007",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "今天真是個大喜之日！",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n再度迎接重要的紀念日到來，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "真叫人歡欣不已。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請各位一人說一句話吧！",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "從我開始吧☆",
    "voice": "vo_adv_9005015_008",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我能說的就只有一句話☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "──開心的日子裡飯也特別好吃！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就這樣☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這句話頗具深意，",
    "voice": "vo_adv_9005015_009",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "很有貪吃佩可小姐的個人風格呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那麼",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也來說一句。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "踏踏實實的每一步，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下今後",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也會與主公大人相伴。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？",
    "voice": "vo_adv_9005015_010",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "一句話？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只有一句話！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我想了好長一大段話耶……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呃～那個！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "今、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "今後也要注視著我喔！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "再來換我。",
    "voice": "vo_adv_9005015_011",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "最近……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "隨著時間的經過，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n我知道自己心中的寶貴事物也在不斷增加。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我想要讓它變的更多、",
    "voice": "vo_adv_9005015_012",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "更用心去珍惜它。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n這就是……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我的想法。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵。",
    "voice": "vo_adv_9005015_013",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "接下來是大家久等的環節。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n雪菲小姐──",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是不是",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "有準備了什麼禮物呢？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦？",
    "voice": "vo_adv_9005015_014",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n不、",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不是我個人的禮物，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "是大家一起……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小雪菲，",
    "voice": "vo_adv_9005015_015",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個禮物",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是妳從頭到尾，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n全心全意製作出來的。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以呢，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我覺得應該要由妳親手送出去♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……這樣好嗎？",
    "voice": "vo_adv_9005015_016",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳在害羞什麼啊。",
    "voice": "vo_adv_9005015_017",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "尾巴都變得紅通通了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "沒有那回事！？",
    "voice": "vo_adv_9005015_018",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n應該沒有吧！？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雪菲小姐，",
    "voice": "vo_adv_9005015_019",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒問題的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而且，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人正在滿心期待地等著喔。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來吧……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請送禮。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……",
    "voice": "vo_adv_9005015_020",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "你可以",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "收下這份禮物嗎？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這是我能為你準備的禮物。",
    "voice": "vo_adv_9005015_021",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "裡頭是",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我和你，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還有大家一起經歷過的",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "回憶。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n……我把它",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "畫成漫畫了。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……嗯。",
    "voice": "vo_adv_9005015_022",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但你先不要在這裡──",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇啊～♪",
    "voice": "vo_adv_9005015_023",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n小雪菲好厲害！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這本漫畫",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "既可愛又有趣！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這就是漫畫嗎……",
    "voice": "vo_adv_9005015_024",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n感覺得要有高超的畫技",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "才畫得出來，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "想不到雪菲小姐竟有這樣的才能。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，",
    "voice": "vo_adv_9005015_025",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也讓我",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看一下啦！",
