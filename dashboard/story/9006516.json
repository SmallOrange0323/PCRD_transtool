    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "真蠢呢～",
    "voice": null,
    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "竟然叫本大爺",
    "voice": null,
    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "「拯救者」耶？",
    "voice": null,
    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "不過，",
    "voice": "vo_adv_9006516_019",
    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "想掌控這個國家的野心是挺大的就是。",
    "voice": null,
    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n反正我也獲得了挺強的僕人，",
    "voice": null,
    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "所以就這樣吧！",
    "voice": null,
    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n嘰嘰嘰嘰嘰嘰！",
    "voice": null,
    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你將豪紳前議長",
    "voice": "vo_adv_9006516_020",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "染上了黑暗力量的色彩嗎……！",
