    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "這是起內鬨了嗎？",
    "voice": null,
    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n嘰嘰嘰，",
    "voice": null,
    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "那就由我們先出招囉……！",
