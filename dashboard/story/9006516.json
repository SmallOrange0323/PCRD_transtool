  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "怎、",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "怎麼回事啊～！？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n攻擊",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "完全沒效耶！！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是啊……",
    "voice": "vo_adv_9006516_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n到底為什麼",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "無法傷到豪紳議長分毫呢……？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "哼──哈哈哈！",
    "voice": "vo_adv_9006516_002",
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "軟弱！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "脆弱！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n在吾輩得到嶄新力量的拳頭之前，",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n【王宮騎士團】就跟稻草人沒兩樣！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你這傢伙，",
    "voice": "vo_adv_9006516_003",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "竟敢口無遮攔……！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不可以受他挑釁，矮子虎。",
    "voice": "vo_adv_9006516_004",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n不過……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "前議長？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "曾被這些孩子打敗的你……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是如何獲得如此強大的力量？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "哼。",
    "voice": "vo_adv_9006516_005",
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "就當作是死前的贈禮告訴你們吧。",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "吾輩狀態雖曾糟到連拯救者大人都束手無策……",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "但就在力量用盡前夕，",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "吾輩獲得了「黑暗力量」。",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "黑暗力量……！？",
    "voice": "vo_adv_9006516_006",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那果然……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是彌勒的……？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "這位大人讓吾輩",
    "voice": "vo_adv_9006516_007",
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "重生為新王！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n他正是真正的「拯救者大人」──！！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "他說這位大人……",
    "voice": "vo_adv_9006516_008",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "難道說……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "他來了嗎！？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "彌勒──！！",
    "voice": "vo_adv_9006516_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嘰嘰嘰嘰嘰嘰嘰！",
    "voice": "vo_adv_9006516_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n沒錯，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "正是本大爺───────！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "嗯？",
    "voice": "vo_adv_9006516_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "呃、",
    "voice": "vo_adv_9006516_012",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那個……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是哪位啊？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n那小小隻的……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊！",
    "voice": "vo_adv_9006516_013",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這股魔力，難道說……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是反逆獸！？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "竟然會說話，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是很稀有的類型呢……！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小智？",
    "voice": "vo_adv_9006516_014",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "關於那傢伙妳知道些什麼嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n妳好像了解的樣子……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦！？",
    "voice": "vo_adv_9006516_015",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊、",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那是那個……！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好像知道……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "又好像不知道……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "哼──哈哈哈哈！",
    "voice": "vo_adv_9006516_016",
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "不知道的話，就由我來告訴你們吧！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "這位大人是散播災厄的黑暗化身……",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "反逆獸大人！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "還賜予了吾輩黑暗力量，",
    "voice": "vo_adv_9006516_017",
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n是與彌勒並駕齊驅的「拯救者」大人！！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "你們認識這傢伙嗎？",
    "voice": "vo_adv_9006516_018",
    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "\\n這傢伙",
