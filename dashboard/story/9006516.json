  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小智？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n妳果然知道些什麼吧？",
    "voice": null,
    "unit_id": 104711
  },
