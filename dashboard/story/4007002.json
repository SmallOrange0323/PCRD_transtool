    "words": "因為沒有人可以搭乘啊……",
    "voice": "vo_adv_4007002_032",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n它就是那種不能讓普通人駕馭的",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "挑剔產品……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我來",
    "voice": "vo_adv_4007002_033",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "搭乘好了！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可！？　",
    "voice": "vo_adv_4007002_034",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳有聽到花凜的話嗎！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我有皇家裝備！　",
    "voice": "vo_adv_4007002_035",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "比普通人還強壯！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個圓盤",
    "voice": "vo_adv_4007002_036",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "在蘭德索爾搶奪食物對吧？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n要是沒有食物的話，我就",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……不對，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "蘭德索爾就完蛋了！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "能辦到的事情就得去做啊！",
    "voice": "vo_adv_4007002_037",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n請讓我去吧！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "雖然我很想說",
    "voice": "vo_adv_4007002_038",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "如果是貪吃佩可小姐的話",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "或許可以……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n但是要操控戰鬥機，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "需要兩個飛行員才行……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…………那就沒辦法了。",
    "voice": "vo_adv_4007002_039",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n和貪吃佩可一樣強壯的傢伙，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可不是那麼容易找到的。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不可以放棄！　",
    "voice": "vo_adv_4007002_040",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳們說的我都聽到了！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個聲音是……！！",
    "voice": "vo_adv_4007002_041",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "難道是……！！",
    "voice": "vo_adv_4007002_042",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是我啦！！",
    "voice": "vo_adv_4007002_043",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…………是誰？",
    "voice": "vo_adv_4007002_044",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n只聽聲音聽不出來。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是莉瑪，",
    "voice": "vo_adv_4007002_045",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "莉瑪啦！！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我來和貪吃佩可一起",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "搭乘戰鬥機！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "莉瑪……",
    "voice": "vo_adv_4007002_046",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n雖然妳確實也很強壯……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那個圓盤",
    "voice": "vo_adv_4007002_047",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "把我特地留下來準備享用的蘋果",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "全部拿走了！！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不可原諒！　",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果能報仇的話，我想去報仇！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "莉瑪……！！　",
    "voice": "vo_adv_4007002_048",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這就是食物被奪走的怨恨吧！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我懂的！　",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我也懂哦！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那我們就徹底消除怨恨吧！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "到宇宙去，",
    "voice": "vo_adv_4007002_049",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "搶回我們的蘋果！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "九死一生的危機出現了一線曙光。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n蘭德索爾的命運就這麼交給了這兩位美麗的少女。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個，",
    "voice": "vo_adv_4007002_050",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳們兩個……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n沒把我給忘掉了吧？　",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "記得嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n要救回的不是食材，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是我才對吧！？",
    "voice": null,
    "unit_id": 106012
  }
]
