[
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這一天，流夏沒有什麼事要處理。\\n於是她離開蘭德索爾，到街上隨意漫步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼啊……",
    "voice": "vo_adv_1056001_000",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "難得天氣這麼好，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "來睡個覺好了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嘿咻。",
    "voice": "vo_adv_1056001_001",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……",
    "voice": "vo_adv_1056001_002",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯……？",
    "voice": "vo_adv_1056001_003",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "誰啊？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我睡得正香的說。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你找我有什麼事？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈哈！",
    "voice": "vo_adv_1056001_004",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原來是這樣啊！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我沒事。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我可沒你想像的那麼嬌弱。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這附近的魔物對我來說，",
    "voice": "vo_adv_1056001_005",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "連暖身都算不上呢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還是要感謝你對我的關心。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "謝謝你喔。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我叫流夏。",
    "voice": "vo_adv_1056001_006",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "請多指教。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我在鬧區的魚店裡打工。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n今天閒著沒事，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就到這裡悠哉的午睡。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你手上的那個，",
    "voice": "vo_adv_1056001_007",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是釣魚的釣具吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你喜歡",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "釣魚嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "工作內容是釣魚？還真有意思。",
    "voice": "vo_adv_1056001_008",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "接下工作的人已經夠怪了，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "委託人更怪。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "搞不清楚還拿在手上？",
    "voice": "vo_adv_1056001_009",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你還真怪啊，小哥。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這麼說來，",
    "voice": "vo_adv_1056001_010",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你要去哪裡釣什麼魚啊？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}告訴流夏，\\n自己的工作是要去沿海的城鎮釣某種魚。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈哈！",
    "voice": "vo_adv_1056001_011",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那可是淡水魚喔。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n很遺憾，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就算到了海邊，你也一條都釣不到。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的，",
    "voice": "vo_adv_1056001_012",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你怎麼會接了這種到海邊釣淡水魚的工作呢？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我的工作經常需要接觸魚，當然很熟……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原來是這樣。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……",
    "voice": "vo_adv_1056001_013",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哎呀呀。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喂，小哥。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你能不能，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "讓我協助你做這個工作？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "再這樣下去，我會因為太在意你到底有沒有釣到魚，",
    "voice": "vo_adv_1056001_014",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n而沒辦法好好睡午覺。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "什麼？",
    "voice": "vo_adv_1056001_015",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "別擔心。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要魚的話，我有辦法。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們馬上出發吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "500330"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好了。",
    "voice": "vo_adv_1056001_016",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這裡有一間賣淡水魚的店。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "大叔，你在嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "嘿，歡迎光臨！",
    "voice": "vo_adv_1056001_017",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "原來是流夏。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "妳怎麼這種時間過來，是來批貨的嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不是的。",
    "voice": "vo_adv_1056001_018",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我今天是陪這孩子過來。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n小哥，是那個對吧？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是客人叫你去釣的那種魚。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "啊～這個嗎？",
    "voice": "vo_adv_1056001_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "客人，您運氣真好呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n這種魚最近賣得特別好，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "今天這些賣完就沒了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這種魚很容易跟海魚搞混。",
    "voice": "vo_adv_1056001_020",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n這樣工作差不多就結束了嘛。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼結完帳之後，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就可以早早回蘭德索爾──",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "委託人？",
    "words": "老闆──！",
    "voice": "vo_adv_1056001_021",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "委託人？",
    "words": "啊，你這傢伙！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "委託人？",
    "words": "你怎麼會在這裡！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你是誰啊？",
    "voice": "vo_adv_1056001_022",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我沒見過你……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你說的是真的嗎？",
    "voice": "vo_adv_1056001_023",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……那就怪了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喂，你這傢伙。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你既然已經委託別人去釣魚了，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n為何還要親自來買魚？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "委託人？",
    "words": "不是的，那個，這個是……！",
    "voice": "vo_adv_1056001_024",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你這傢伙……",
    "voice": "vo_adv_1056001_025",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真的是工作的委託人嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n這麼說來，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我聽說最近有個新的詐騙手法……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "委託人？",
    "words": "詐騙！？",
    "voice": "vo_adv_1056001_026",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "委託人？",
    "words": "沒有這回事！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "委託人？",
    "words": "\\n我只是來這裡買魚而已！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "抱歉，",
    "voice": "vo_adv_1056001_027",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "今天的貨賣給這位客人之後沒了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "委託人？",
    "words": "你說什麼！？",
    "voice": "vo_adv_1056001_028",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "委託人？",
    "words": "這樣我很困擾啊！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "果然沒錯……",
    "voice": "vo_adv_1056001_029",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你，",
    "voice": "vo_adv_1056001_030",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不是這孩子真正的委託人吧？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n你假扮成委託人，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "打算要騙這孩子吧？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這孩子買的魚，",
    "voice": "vo_adv_1056001_031",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "應該是真正的委託人要的魚吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "委託人？",
    "words": "什！",
    "voice": "vo_adv_1056001_032",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "委託人？",
    "words": "妳有什麼證據……！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "想必你的同伴",
    "voice": "vo_adv_1056001_033",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "現在正在",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沿海城鎮那裡擺攤，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n等這孩子抵達城鎮，卻釣不到魚的時候出面。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "把海邊釣到的很相像的魚高價賣給這孩子，",
    "voice": "vo_adv_1056001_034",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n等他回蘭德索爾後，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "再叫他負起買錯魚的責任。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不僅不付這孩子報酬，",
    "voice": "vo_adv_1056001_035",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n還以失敗為藉口，要求他賠償，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是骯髒的手段。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "然後自己再裝著一臉老實樣，",
    "voice": "vo_adv_1056001_036",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n把在這裡買的魚賣給真正的委託人……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼樣？",
    "voice": "vo_adv_1056001_037",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "被我料中了吧？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "至少要是我想騙人，就會這麼做。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "詐欺犯",
    "words": "可惡……",
    "voice": "vo_adv_1056001_038",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "詐欺犯",
    "words": "既然被發現了那也沒辦法！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "詐欺犯",
    "words": "\\n事到如今，那我只好把你們全部滅口！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "background",
    "bg_id": "500330"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嘿。",
    "voice": "vo_adv_1056001_039",
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "500330"
  },
  {
    "type": "dialogue",
    "name": "詐欺犯",
    "words": "唔哇！？",
    "voice": "vo_adv_1056001_040",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "詐欺犯",
    "words": "騙人、的吧……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哎呀呀。",
    "voice": "vo_adv_1056001_041",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "誰叫你連對方的底細都沒有摸清楚，就攻過來。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……這麼說起來，聽說現在這種流行的詐欺手法，",
    "voice": "vo_adv_1056001_042",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n都是集體犯罪。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喂，你這傢伙。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我要讓你們不得再作怪，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "帶我到你同伴那裡去。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "詐欺犯",
    "words": "嘿嘿，",
    "voice": "vo_adv_1056001_043",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "詐欺犯",
    "words": "就算妳出手也不可能贏得了我同伴的……！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你覺得我辦不到嗎？",
    "voice": "vo_adv_1056001_044",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這種惡質的犯罪行為，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不把你們徹底擊潰，我是不會善罷甘休的。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "既然都到這裡了，",
    "voice": "vo_adv_1056001_045",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥你也一起來吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n這些傢伙可是設局打算要騙你喔。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n是男人的話，有人挑釁就該迎擊。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": "vo_adv_1056001_046",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你該不會是在擔心我吧？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈，",
    "voice": "vo_adv_1056001_047",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "簡直就像是哪裡來的騎士一樣。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不錯！",
    "voice": "vo_adv_1056001_048",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這種氣魄，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我喜歡！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n小哥你是個值得尊敬的男人！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不錯不錯！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哎呀，抱歉。",
    "voice": "vo_adv_1056001_049",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼吸不過來了嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不自覺地就抱住你了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真抱歉。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這是我高興時的怪癖。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總之，",
    "voice": "vo_adv_1056001_050",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們就前往詐欺犯的基地吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "過來，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你來帶路！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "500012"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是這裡對吧？",
    "voice": "vo_adv_1056001_051",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你準備好了嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一口氣衝進去囉！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "詐欺犯",
    "words": "喂，",
    "voice": "vo_adv_1056001_052",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "詐欺犯",
    "words": "喂。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "詐欺犯",
    "words": "妳是認真的嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "詐欺犯",
    "words": "我勸妳不要這樣做比較好喔？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我當然是認真的啊？",
    "voice": "vo_adv_1056001_053",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以才會跑來這裡。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "打擾囉！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "詐欺犯夥伴1",
    "words": "妳是誰？　",
    "voice": "vo_adv_1056001_054",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我是來將你們一舉殲滅的！",
    "voice": "vo_adv_1056001_055",
    "unit_id": 105612
  },
  {
    "type": "background",
    "bg_id": "500012"
  },
  {
    "type": "dialogue",
    "name": "詐欺犯夥伴2",
    "words": "咕哇！",
    "voice": "vo_adv_1056001_056",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "詐欺犯夥伴2",
    "words": "可惡，這個女的是什麼人！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "詐欺犯夥伴2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "詐欺犯夥伴2",
    "words": "所有人上前把她圍住！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "詐欺犯夥伴2",
    "words": "這樣我們就能輕鬆獲勝了！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼啦。",
    "voice": "vo_adv_1056001_057",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "人數不多就算了，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "手還在抖嘛。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "算了。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "既然這樣我就不客氣地動真格囉。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "──納命來！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "詐欺犯夥伴1",
    "words": "呀啊啊啊啊！",
    "voice": "vo_adv_1056001_058",
    "unit_id": 911
  },
  {
    "type": "still",
    "still_id": "105600101"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼……",
    "voice": "vo_adv_1056001_059",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "已經結束啦。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "詐欺犯夥伴1",
    "words": "好，",
    "voice": "vo_adv_1056001_060",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "詐欺犯夥伴1",
    "words": "好強……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "詐欺犯夥伴2",
    "words": "妳這傢伙，",
    "voice": "vo_adv_1056001_061",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "詐欺犯夥伴2",
    "words": "到底是什麼人……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你問我嗎？",
    "voice": "vo_adv_1056001_062",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我只是個魚店的打工族而已啊。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "詐欺犯夥伴2",
    "words": "妳騙人……",
    "voice": "vo_adv_1056001_063",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "詐欺犯夥伴2",
    "words": "這怎麼可能……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我說的是真的啊……",
    "voice": "vo_adv_1056001_064",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "現在不是在這閒嗑牙的時候。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你們幾個聽清楚了。",
    "voice": "vo_adv_1056001_065",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "下次敢再胡作非為，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我就把你們的頭全砍下來。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "明白嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n……回答呢！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "詐欺犯夥伴1",
