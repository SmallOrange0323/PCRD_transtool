    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真不愧是魔法師婆婆……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊、糟了，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我又說出來了。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣說肯定會惹她生氣的，得格外小心才行。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哎呀！",
    "voice": "vo_adv_6061102_003",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣也不錯喔。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就算是男孩子，會對漂亮的東西有所憧憬也是理所當然的事。",
