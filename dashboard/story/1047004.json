[
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呼。",
    "voice": "vo_adv_1047004_000",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n已經完全天黑了呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為最近克莉絲提呈報給陛下的意見，",
    "voice": "vo_adv_1047004_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我的工作時間縮短了……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "總之變成",
    "voice": "vo_adv_1047004_002",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n能回家好好在床上睡覺的情況了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為通勤，必須得往返於家裡及王宮之間，",
    "voice": "vo_adv_1047004_003",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n反而有點麻煩啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "至今為止，",
    "voice": "vo_adv_1047004_004",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我都是在【王宮騎士團】的據點睡覺的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我不能常駐在王宮，",
    "voice": "vo_adv_1047004_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n戒備人手又變得有些不足了呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "克莉絲提娜不可能只是單純地對我親切，",
    "voice": "vo_adv_1047004_006",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n總～覺得她在計畫著什麼陰謀詭計。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但是話說回來……",
    "voice": "vo_adv_1047004_007",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n今天的確，精疲力盡呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然也沒有特別做什麼。",
    "voice": "vo_adv_1047004_008",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n只是一直站著，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n一直戒備著，也是無聊的難受。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，這就是我身為守衛的工作。",
    "voice": "vo_adv_1047004_009",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為直到前幾天，",
    "voice": "vo_adv_1047004_010",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n少年還常常來露臉……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "期待著他出現，",
    "voice": "vo_adv_1047004_011",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就這樣度過了一天……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但是已經告別了呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為少年是認真的好孩子，",
    "voice": "vo_adv_1047004_012",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n聽了我說的話，不會再靠近王宮了吧……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n應該再也不會見面了吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然我早已做好覺悟。",
    "voice": "vo_adv_1047004_013",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但果然，還是感到有點寂寞呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "…………",
    "voice": "vo_adv_1047004_014",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "…",
    "voice": "vo_adv_1047004_015",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "…嗯？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n剛剛，那邊的暗處似乎有什麼動了？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可疑份子嗎，還是魔物呢？",
    "voice": "vo_adv_1047004_016",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n會是最近傳聞中的「闇影」嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "首先，先過去看看吧。",
    "voice": "vo_adv_1047004_017",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n守護城鎮的和平，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就是我們【王宮騎士團】存在的意義。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "誰在那裡！",
    "voice": "vo_adv_1047004_018",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n若是聽得懂我說的話，就回應我的呼喚，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n現出身影來！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯，奇怪？",
    "voice": "vo_adv_1047004_019",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n少年？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真、真是巧遇呢。",
    "voice": "vo_adv_1047004_020",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n在那種地方，做什麼呢？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那個……",
    "voice": "vo_adv_1047004_021",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n明明已經告別了，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n沒有想到會突然遇見。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真不知道",
    "voice": "vo_adv_1047004_022",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n該採取怎樣的態度才好呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……？",
    "voice": "vo_adv_1047004_023",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n少年，怎麼了？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n希望你至少能回應我。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這是……",
    "voice": "vo_adv_1047004_024",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n少年，正沉睡著嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n為什麼呢？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯？",
    "voice": "vo_adv_1047004_025",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這是什麼，好刺眼……？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯嗯？",
    "voice": "vo_adv_1047004_026",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這是為何呢，總覺得我也變得昏昏欲睡。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "background",
    "bg_id": "510240"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_1047004_027",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……咦？",
    "voice": "vo_adv_1047004_028",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n啊啊少年，你等很久了呢。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呵呵。",
    "voice": "vo_adv_1047004_029",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n總算看見你的模樣，暫且放心了。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "咦？",
    "voice": "vo_adv_1047004_030",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n啊啊，嚇了一跳。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n不需要突然那麼大聲喔。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "很可怕嗎，我……？",
    "voice": "vo_adv_1047004_031",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯？",
    "voice": "vo_adv_1047004_032",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你說，因為突然有人戴著面具出現，",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n還以為是可疑份子……？",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可疑嗎。",
    "voice": "vo_adv_1047004_033",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這可是正義的英雄，",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n虎虎的面具喔。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小孩子都喜歡吧，像這種的……",
    "voice": "vo_adv_1047004_034",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n會被這麼的害怕、警戒，真是出乎意料。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔嗯。",
    "voice": "vo_adv_1047004_035",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你已經是高中生了，",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n也不是小孩子了啊",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真是失禮了。",
    "voice": "vo_adv_1047004_036",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n是我考慮不周呢。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "下一次，",
    "voice": "vo_adv_1047004_037",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就戴高中生會喜歡的面具吧。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哎呀……？",
    "voice": "vo_adv_1047004_038",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n抱歉，少年。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為你突然朝我撲上來，",
    "voice": "vo_adv_1047004_039",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我瞬間使用了合氣道的招式，把你甩出去了。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n沒有受傷吧？",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "最好不要輕易抱住女性喔。",
    "voice": "vo_adv_1047004_040",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n雖然我是不在意，也能夠應付這種情況，",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但會被其他人認為是色狼的吧？",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵。",
    "voice": "vo_adv_1047004_041",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n想要激動地抱住我，",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n能夠見到我有那麼高興嗎？",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "算了。",
    "voice": "vo_adv_1047004_042",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n好像平白引起了放學中學生們的注目，",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n趕快把事情完成回家吧。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年，希望你收下這個。",
    "voice": "vo_adv_1047004_043",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這是遊樂園的免費入場券。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯？",
    "voice": "vo_adv_1047004_044",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不，並不是約會的邀請。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我們也不是那樣的關係吧。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你經常在遊樂園，",
    "voice": "vo_adv_1047004_045",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n幫忙我的工作對吧？",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "準備英雄秀的舞台啊，",
    "voice": "vo_adv_1047004_046",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n以及飾演怪人角色等等的……",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這是，那個的謝禮。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "讓你無償的工作，我也感到十分抱歉呢。",
    "voice": "vo_adv_1047004_047",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n希望你能收下，少年。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不用客氣。",
    "voice": "vo_adv_1047004_048",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我因為工作的關係，得到了大量的免費票券。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "即使給你幾張，錢包也不痛不癢，",
    "voice": "vo_adv_1047004_049",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n與其在我手裡派不上用場，不如給別人使用更好。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "應該也可以變換成現金。",
    "voice": "vo_adv_1047004_050",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n如果你覺得報酬還是給現金比較好～的話，",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就麻煩你拿去變換現金吧。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只是，你也是高中生對吧，",
    "voice": "vo_adv_1047004_051",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n青春正盛啊……",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "要是能用這個邀請喜歡的女孩子，",
    "voice": "vo_adv_1047004_052",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n來場約會就好了。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵。",
    "voice": "vo_adv_1047004_053",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n結果我倒是成了",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n戀愛的邱比特呢。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你能高興就太好了。",
    "voice": "vo_adv_1047004_054",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n能看見像你一樣的孩子的笑容，",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n對我來說就是最棒的報酬了。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯。",
    "voice": "vo_adv_1047004_055",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我要說的事情就只有這樣。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n引起騷動真抱歉呢，少年。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵。",
    "voice": "vo_adv_1047004_056",
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n下次，有空的時候也好，",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你能再來幫忙的話，我會很開心的。",
    "voice": null,
    "unit_id": 104731
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那麼再會了，下次再見吧……少年。",
    "voice": "vo_adv_1047004_057",
    "unit_id": 104731
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，辛苦了。",
    "voice": "vo_adv_1047004_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛剛看見的，是如同夢境一般的情景唷。",
    "voice": "vo_adv_1047004_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n只要一醒來，就會全部忘記了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話說，雖然每次都要說明也很麻煩……",
    "voice": "vo_adv_1047004_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n總～覺得，會出現我意料之外的事情呀。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n盡是些麻煩事啊，真是的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然明明應該要全部忘記的。",
    "voice": "vo_adv_1047004_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但是你以及夢裡出現的女孩子，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n卻會依稀記得內容……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為夢境的關係，也會使行為產生變化。",
    "voice": "vo_adv_1047004_062",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n雖然現階段，似乎還沒什麼嚴重的影響。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊。",
    "voice": "vo_adv_1047004_063",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "抱歉抱歉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n說了和你無關的話呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在屋外就這樣睡著會感冒的，",
    "voice": "vo_adv_1047004_064",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n快點醒來吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊，為了慎重起見，先告訴你一聲。",
    "voice": "vo_adv_1047004_065",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "先不要對純提起關於這個夢的事情喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就算是有個萬一，",
    "voice": "vo_adv_1047004_066",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我的存在也不能被查覺到。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "純擔任團長的【王宮騎士團】，",
    "voice": "vo_adv_1047004_067",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "實在是個可疑的集團呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "恕我直言，",
    "voice": "vo_adv_1047004_068",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n他們在背後為我們的敵人撐腰的可能性很高呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然純，",
    "voice": "vo_adv_1047004_069",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n似乎是個單純善良的人。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但也有因為隸屬於組織，",
    "voice": "vo_adv_1047004_070",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n而拋下個人的道德觀的案例。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你要十分小心喔。",
    "voice": "vo_adv_1047004_071",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n純自己之前也說過，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不要與她太過親近比較好。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "越是親近，",
    "voice": "vo_adv_1047004_072",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n越會成為痛苦的回憶也說不定呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過話就說到這裡。",
    "voice": "vo_adv_1047004_073",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "再見囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n下次，在夢裡再會吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……",
    "voice": "vo_adv_1047004_074",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n奇、奇怪？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我，睡著了嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "感覺好像做了個奇怪的夢……",
    "voice": "vo_adv_1047004_075",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗚嗚，頭好痛。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "太不成體統了。",
    "voice": "vo_adv_1047004_076",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n居然在這種戶外睡著了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n唔～嗯，該不會被施了什麼奇怪的魔法吧？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦？",
    "voice": "vo_adv_1047004_077",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n啊啊，少年……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你也，一起睡著了嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這是怎麼回事呢？",
    "voice": "vo_adv_1047004_078",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這麼說來我確實在回家途中時，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n在陰暗處發現了你……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然因為擔心而跑了過來，",
    "voice": "vo_adv_1047004_079",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n結果不知為何似乎睡到了現在呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "完全不明白是什麼狀況。",
    "voice": "vo_adv_1047004_080",
    "unit_id": 104711
  }
]
