[
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "依里找了{0}出來見面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "呼……感覺心跳好快……",
    "voice": "vo_adv_1022007_000",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但、但是今天一定要和那傢伙道謝才行！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n他都幫了我那麼多次忙！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就簡簡單單地～輕輕地～咻地～",
    "voice": "vo_adv_1022007_001",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "說一句「謝謝！」",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n還有「再見！」然後回去就可以了！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗯！簡簡單單！輕輕鬆鬆！",
    "voice": "vo_adv_1022007_002",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗚哇啊啊啊啊啊啊～～～～！！",
    "voice": "vo_adv_1022007_003",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "早早早、早安！",
    "voice": "vo_adv_1022007_004",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n在在在、在這裡碰到真巧啊～～～",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……是我找你來的？",
    "voice": "vo_adv_1022007_005",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊、啊啊，對。對喔。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n抱、抱歉喔，找你出來～",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸、欸……其實我有話想跟你說……",
    "voice": "vo_adv_1022007_006",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n那個……就是……其、其實……那個……謝……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "謝……謝……謝……",
    "voice": "vo_adv_1022007_007",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "說到那個茜里啊",
    "voice": "vo_adv_1022007_008",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊～～～～！討厭！我這個笨蛋！笨蛋！笨蛋～！",
    "voice": "vo_adv_1022007_009",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "茜、茜里和你，不是很要好嗎？",
    "voice": "vo_adv_1022007_010",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n身為姐姐，我想說應該問問看，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n你們有沒有什麼問題……比較好。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……沒有什麼問題？",
    "voice": "vo_adv_1022007_011",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你在說什麼？明明就讓她叫你「哥哥」……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n老實說那聽了有點噁心。所以說男人就是這樣……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……不是你要求的？",
    "voice": "vo_adv_1022007_012",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n是茜里擅自那樣叫的？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n哼～這樣啊。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我還以為是你的喜好呢。",
    "voice": "vo_adv_1022007_013",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n所以想說我是不是也叫你「哥哥」會比較好……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊，沒事沒事沒事！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那你不喜歡被叫什麼「哥哥」嗎？",
    "voice": "vo_adv_1022007_014",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "要不要我跟茜里說不要那麼叫你了？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸？你覺得茜里就像妹妹一樣，所以不會討厭？",
    "voice": "vo_adv_1022007_015",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哼、哼……這樣啊……",
    "voice": "vo_adv_1022007_016",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n茜里、是、妹妹啊……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗯～～～好複雜的感覺……",
    "voice": "vo_adv_1022007_017",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n聽到「茜里像妹妹一樣」，有種好像忌妒，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但又好像鬆了口氣的感覺……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸？找你只有這件事情嗎？",
    "voice": "vo_adv_1022007_018",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不、不是！真正想說的是！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸、欸……謝……謝……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "說到那個新遊戲啊",
    "voice": "vo_adv_1022007_019",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊～～！又失敗了～～！",
    "voice": "vo_adv_1022007_020",
    "unit_id": 102211
  },
  {
    "type": "background",
    "bg_id": "500131"
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "好，這次就用那個來比賽喔！",
    "voice": "vo_adv_1022007_021",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊！還有上次呀……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸？時間已經很晚了回家比較好？",
    "voice": "vo_adv_1022007_022",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n不、不好！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "竟然已經到這個時間了……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你說再見……",
    "voice": "vo_adv_1022007_023",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "等、等等！我、我、我還有想說的話……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "想說的話……",
    "voice": "vo_adv_1022007_024",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "說不出口啊～果然今天也失敗了……",
    "voice": "vo_adv_1022007_025",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "今天也是……之前也是……之後也一定……",
    "voice": "vo_adv_1022007_026",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "之後也一定會失敗？",
    "voice": "vo_adv_1022007_027",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我不想……我不想……再失敗了！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "等、等等！",
    "voice": "vo_adv_1022007_028",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我、我有一些話，",
    "voice": "vo_adv_1022007_029",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n想要告訴你！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我有話得跟你說才行……！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那、那個……就、就是……",
    "voice": "vo_adv_1022007_030",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我總是受到你的照顧……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "第一次遇到你的時候，我立刻逃跑，",
    "voice": "vo_adv_1022007_031",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n明明我就是個怪傢伙，你還追上來，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "雖然我嚇一跳，但同樣地也很開心……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "之後在危險時刻還讓你救了我……",
    "voice": "vo_adv_1022007_032",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n你還跟我一起玩遊戲……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "如果像這樣和你一起做很多事情的話，",
    "voice": "vo_adv_1022007_033",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n說不定我怕生的問題就能改善了，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我是這麼想的。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "雖然現在我能好好說話的對象只有你……",
    "voice": "vo_adv_1022007_034",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊！但是我覺得其實那樣也不錯……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我從沒想過會有這樣的心情，",
    "voice": "vo_adv_1022007_035",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n自己也嚇一跳，但完全不會覺得討厭……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但我卻總是對你說些失禮的話……",
    "voice": "vo_adv_1022007_036",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n因此想和你道歉，或是該說是道謝……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "所以……我……",
    "voice": "vo_adv_1022007_037",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我！",
    "voice": "vo_adv_1022007_038",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我喜……喜……！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦、咦？",
    "voice": "vo_adv_1022007_039",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我不是想對他說謝謝嗎……！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我、我、我剛差點就要說什麼蠢話了～～～～！？",
    "voice": "vo_adv_1022007_040",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "…………！！！",
    "voice": "vo_adv_1022007_041",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我、我還是先回去了！再、再見！！！",
    "voice": "vo_adv_1022007_042",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哇！那、那個！那個！欸……！",
    "voice": "vo_adv_1022007_043",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不、不要問！不要問！不要問啦！",
    "voice": "vo_adv_1022007_044",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n最討厭你了～～～～～～～！！！",
    "voice": null,
    "unit_id": 102211
  }
]
