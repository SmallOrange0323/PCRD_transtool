[
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "優衣和{0}兩人為了購買新年首賣的福袋",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而前往城鎮，平安買到目標的福袋後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n享受著只有兩人的購物時光。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生。",
    "voice": "vo_adv_1088008_000",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你會不會餓？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我在想差不多該吃點東西了……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "因為正逢新年，",
    "voice": "vo_adv_1088008_001",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "店家",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "似乎都沒開呢……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "回去之後",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我再做點什麼吃的吧。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊，",
    "voice": "vo_adv_1088008_002",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但是",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "公會小屋有食材嗎……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "應該只剩下",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "白米了吧。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怎麼辦……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對了。",
    "voice": "vo_adv_1088008_003",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我家店裡賣的",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "年菜可能還有剩。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們可以去確認看看嗎？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呵呵。",
    "voice": "vo_adv_1088008_004",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我就知道。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生一路上幫我提東西，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n真想快點填飽騎士先生的肚子呢。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……爸爸媽媽，",
    "voice": "vo_adv_1088008_005",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "已經",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "從神殿回來了嗎……？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "稍微",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "等我一下喔。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我回來了～！",
    "voice": "vo_adv_1088008_006",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "哎呀，",
    "voice": "vo_adv_1088008_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "歡迎回來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "昨天妳真的幫了大忙。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n攤販已經交給新請來的工讀生們顧著了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n妳已經去過新年首賣了嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "去過了喔。",
    "voice": "vo_adv_1088008_008",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "媽媽，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "年菜",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "還有剩嗎？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "我有另外做好家裡要吃的份了喔。",
    "voice": "vo_adv_1088008_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n怎麼了嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我打算在外面吃飯，",
    "voice": "vo_adv_1088008_010",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但店家都沒有開，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "正感到困擾呢。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我可以",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "帶一些走嗎？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "啊啊，",
    "voice": "vo_adv_1088008_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "原來是這樣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "本來就是家裡要吃的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n別說是一些了，想吃多少都可以帶走。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n盛裝的盒子也是，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "那些多出來的都可以用喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝謝～！",
    "voice": "vo_adv_1088008_012",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "妳看起來很著急呢。",
    "voice": "vo_adv_1088008_013",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n是外面有誰在等妳嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦？",
    "voice": "vo_adv_1088008_014",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊啊～",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是啊！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "哎呀是這樣啊。",
    "voice": "vo_adv_1088008_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n那要快點裝一裝才行了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n好了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "快一點快一點！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真是的～",
    "voice": "vo_adv_1088008_016",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不要催我啦～！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我已經很著急了～！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "……",
    "voice": "vo_adv_1088008_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "話說回來那孩子，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n是讓誰在外面等啊……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "外面這麼冷",
    "voice": "vo_adv_1088008_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "明明讓他也進來就好了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n哎呀？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "哎呀哎呀哎呀～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "久等了～！",
    "voice": "vo_adv_1088008_019",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "挑選騎士先生可能會喜歡的菜",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "花了點時間……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "你呀，",
    "voice": "vo_adv_1088008_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "叫做騎士先生是嗎……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n重新來跟你打聲招呼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "我們女兒",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "就拜託你了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "爸爸也打個招呼！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "媽！？",
    "voice": "vo_adv_1088008_021",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "媽、",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "媽媽！？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n連爸爸也……！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真是的～！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n不要亂說啦～！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "不過～",
    "voice": "vo_adv_1088008_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "昨天受到了幫助，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n當然得鄭重的答謝對吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "\\n而且",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣的母親",
    "words": "妳也不用這麼害羞吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對我說什麼都沒關係，",
    "voice": "vo_adv_1088008_023",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對騎士先生可不行！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "還有",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "答謝的事交給我就好，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你們不用在意！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們走吧騎士先生。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你肚子餓了吧？",
