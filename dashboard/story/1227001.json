  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "精靈族學校位於遠離蘭德索爾的森林中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n鏡華所在的那間教室裡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n精靈族的孩子們今天也快樂地勤奮學習著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "那麼，各位，",
    "voice": "vo_adv_1227001_000",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n下次假期過後，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "夏令營終於要開始了。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "如我之前也說明過的，",
    "voice": "vo_adv_1227001_001",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "這次的目的地是海邊。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n對居住在森林中的我們精靈族來說，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "那是不熟悉的區域。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "要確實訂定計畫，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "並好好準備喔。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "是──！",
    "voice": "vo_adv_1227001_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "欸～欸～",
    "voice": "vo_adv_1227001_003",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "鏡華！",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n夏令營真讓人期待，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "對吧♪",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯，",
    "voice": "vo_adv_1227001_004",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "很讓人期待呢。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n畢竟這是第一次",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "跟學校的大家一起外出到海邊呢。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不過，",
    "voice": "vo_adv_1227001_005",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真的沒問題嗎？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……由我，",
    "voice": "vo_adv_1227001_006",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "來擔任小組的隊長。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "那當然啊。",
    "voice": "vo_adv_1227001_007",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n畢竟就算是在這個班級中，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "鏡華也都是最可靠的嘛。",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "可靠……",
    "voice": "vo_adv_1227001_008",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "欸嘿嘿。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n是那樣嗎……？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "而且",
    "voice": "vo_adv_1227001_009",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "鏡華",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "已經加入公會了吧？",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "明明跟我們同齡，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "還真厲害呢──！",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "妳是指【小小甜心】嗎？",
    "voice": "vo_adv_1227001_010",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那是……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "欸欸！",
    "voice": "vo_adv_1227001_011",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n鏡華",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "能使用比大人都還更厲害的魔法吧？",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我有聽說妳藉此打倒了很多強大的魔物喔！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦？",
    "voice": "vo_adv_1227001_012",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n唔、",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我確實是有在……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "打倒魔物之類的啦……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "果然是真的啊！",
    "voice": "vo_adv_1227001_013",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "那夏令營的學習課題也決定了呢。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n就向鏡華學習魔法，",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "然後作為課題展示給老師們看吧！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦？",
    "voice": "vo_adv_1227001_014",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n要由我",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "來教大家魔法嗎……？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "那樣可能不錯！",
    "voice": "vo_adv_1227001_015",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "畢竟如果是鏡華，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "感覺就能使出很厲害的魔法嘛！",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "要是大家變得能使用那種魔法，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "老師一定會對我們讚賞不已的♪",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "等、",
    "voice": "vo_adv_1227001_016",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "等等？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n就算被說是厲害的魔法……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我……！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "鏡華，",
    "voice": "vo_adv_1227001_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "請多指教囉！\\n鏡華，請多指教囉！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "唔……",
    "voice": "vo_adv_1227001_018",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯，",
    "voice": "vo_adv_1227001_019",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "交……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "交給我吧♪",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……唉。",
    "voice": "vo_adv_1227001_020",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不由得",
    "voice": "vo_adv_1227001_021",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就接受了……！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "因為",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼受到期待的話，我也無可奈何啊～～～！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "如果是簡單的魔法，那課堂上也會教，",
    "voice": "vo_adv_1227001_022",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但厲害的魔法是什麼啊……？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……宇宙藍色閃光？",
    "voice": "vo_adv_1227001_023",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "行，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "攻擊魔法很危險，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不能輕易教他們的吧……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "而且",
    "voice": "vo_adv_1227001_024",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我還無法一個人",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "完美地使出宇宙藍色閃光。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "如果沒有那個人不可思議的力量……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "也對啊……",
    "voice": "vo_adv_1227001_025",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "要是沒有那個人的力量，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我本來",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就還不太能使出困難的魔法吧……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個人的……",
    "voice": "vo_adv_1227001_026",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "要是那個人……",
    "voice": "vo_adv_1227001_027",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "在的話……？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "…………",
    "voice": "vo_adv_1227001_028",
    "unit_id": 103611
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊……",
    "voice": "vo_adv_1227001_029",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你好，{0}。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不好意思，",
    "voice": "vo_adv_1227001_030",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "突然把你叫出來。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊，",
    "voice": "vo_adv_1227001_031",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不是的。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
