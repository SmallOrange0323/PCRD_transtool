[
  {
    "type": "background",
    "bg_id": "502320"
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "啊，",
    "voice": "vo_adv_5150061_000",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "找～到涅比亞了♪",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "呃，",
    "voice": "vo_adv_5150061_001",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "帆稀！",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呃！",
    "voice": "vo_adv_5150061_002",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是什麼反應～？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "記得我跟涅比亞應該沒怎麼說過話耶～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "就算不說話也知道啦，",
    "voice": "vo_adv_5150061_003",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "因為妳有種奇妙的氣勢。",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "氣勢……",
    "voice": "vo_adv_5150061_004",
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "又來了……",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "一旦成為像我這樣的惡作劇專家，",
    "voice": "vo_adv_5150061_005",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "就會本能地明白能不能對對方",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "惡作劇並當作玩笑收場。",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "希望妳告訴我作為參考，",
    "voice": "vo_adv_5150061_006",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還有誰感覺是不能惡作劇的呢～？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "嗯～",
    "voice": "vo_adv_5150061_007",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "像深月或惠理子那樣吧，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "感覺就會笑著把我做成標本。",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯嗯。",
    "voice": "vo_adv_5150061_008",
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "啊，",
    "voice": "vo_adv_5150061_009",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "還有花凜也有點不妙呢。",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "愛惡作劇的人無法忍受因為規則或嚴肅的事而被責備。",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "誒～",
    "voice": "vo_adv_5150061_010",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那美里之類的是目標啊？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "是啊，",
    "voice": "vo_adv_5150061_011",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "感覺她就會面帶笑容地原諒任何事吧。",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "不過，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "總覺得被原諒有點不對勁呢～",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我個人覺得，",
    "voice": "vo_adv_5150061_012",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "對於惡作劇",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "做出很棒的反應，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n直接對我發怒才剛剛好啊。",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "原來如此，",
    "voice": "vo_adv_5150061_013",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "惡作劇之道也是很深奧的呢～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "話說，",
    "voice": "vo_adv_5150061_014",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "妳問這種事是想做什麼？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "因為我們",
    "voice": "vo_adv_5150061_015",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也有一個叫祈梨的",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "孩子會稍微惡作劇，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n所以我就想，這應該能當成對策吧～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "順便問一下，那妳有答案了嗎？",
    "voice": "vo_adv_5150061_016",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "關於對策。",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "一邊因為規則或嚴肅的事責備她，一邊用會原諒一切的笑容把她做成標本。",
    "voice": "vo_adv_5150061_017",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "……抱歉，",
    "voice": "vo_adv_5150061_018",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "祈梨。",
    "voice": null,
    "unit_id": 190912
  }
]
