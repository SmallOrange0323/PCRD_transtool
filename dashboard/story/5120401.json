  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "私をお呼びかしら。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "どういったおもてなしをご要望なの？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "なんて、",
    "voice": "vo_adv_5108401_001",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "ね。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "温泉旅館で働いているせいかしら、",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\nつい、",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "接客しようとしちゃうわね。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "でも安心して。",
    "voice": "vo_adv_5108401_002",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\nちゃんと",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "戦うための準備はしてあるわよ。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\nどんな状況にも対応できてこそだものね。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "それじゃ行きましょうか。",
    "voice": "vo_adv_5108401_003",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "君の望むままに、",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "力を振るってあげる。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "楽しい新年を、",
    "voice": "vo_adv_5108401_004",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "ミツキ",
    "words": "迎えましょうね……♪",
    "voice": null,
    "unit_id": 124711
  }
