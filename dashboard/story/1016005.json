[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那是在{0}買東西的時候――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，是秀才！",
    "voice": "vo_adv_1016005_000",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈嚕～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "在做什麼呢？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "在買東西嗎？",
    "voice": "vo_adv_1016005_001",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，原來是幫別人跑腿呀。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "看你在這邊東張西望，怎麼了嗎？",
    "voice": "vo_adv_1016005_002",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……不知道店在哪裡嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "原來如此。",
    "voice": "vo_adv_1016005_003",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼人家來幫你吧。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "首先要去哪裡呢？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "水果攤？",
    "voice": "vo_adv_1016005_004",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "水果攤的話，不就在那邊嗎。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n簡單～簡單～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "看，就是這裡喔。",
    "voice": "vo_adv_1016005_005",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n要買什麼？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "蘋果 3 個？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": " 咦，不覺得有點少嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你看嘛，一個 70 盧幣對吧？",
    "voice": "vo_adv_1016005_006",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這麼便宜，多買一些不好嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "呃，最大的是 9……",
    "voice": "vo_adv_1016005_007",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n因為 7x9=46，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以買 9 個也才 460 盧幣喔！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "欸～才沒那回事呢。",
    "voice": "vo_adv_1016005_008",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n七九四十六……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "七九四六，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家還記得！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對吧？",
    "voice": "vo_adv_1016005_009",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家就說買多一點才划算嘛！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那就買吧。",
    "voice": "vo_adv_1016005_010",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不好意思～請給人家 9 個蘋果～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "好的好的，蘋果 9 個對吧。",
    "voice": "vo_adv_1016005_011",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n總共 630盧幣。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "騙人！？",
    "voice": "vo_adv_1016005_012",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "630……真的假的！？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "來，這是找零。",
    "voice": "vo_adv_1016005_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "多謝惠顧～",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "…………抱歉。",
    "voice": "vo_adv_1016005_014",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家算錯了……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n九九乘法的七的部分不太會背。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……你願意原諒人家啊？",
    "voice": "vo_adv_1016005_015",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才真的超溫柔。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可是錢還夠嗎？還有東西要買吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "錢不夠買剩下的東西……？",
    "voice": "vo_adv_1016005_016",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這樣啊……嗯～該怎麼辦？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "招客",
    "words": "我們是本日新開幕的賭場！",
    "voice": "vo_adv_1016005_017",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "招客",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "招客",
    "words": "歡迎大家來試試手氣！！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊～！",
    "voice": "vo_adv_1016005_018",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才，就是那個，那個！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "盧幣不夠的話，只要讓它變多就好了！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我就知道秀才一定會贊成！",
    "voice": "vo_adv_1016005_019",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就這麼決定囉！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "安～啦，安～啦！",
    "voice": "vo_adv_1016005_020",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們肯定能行的！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就是這樣，",
    "voice": "vo_adv_1016005_021",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n趕快朝賭場出～發吧！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "still",
    "still_id": "101600501"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "太好了～！",
    "voice": "vo_adv_1016005_022",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n又中了大獎～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家今天簡直有如神助！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才也高興一點嘛～！",
    "voice": "vo_adv_1016005_023",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n大賺了一筆喔！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雖然不太明白，不過賭場還真簡單呢？",
    "voice": "vo_adv_1016005_024",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "隨便下注個數字，就會不斷中獎！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "喂喂喂，秀才！",
    "voice": "vo_adv_1016005_025",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "機會難得，就多賺一些錢吧！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "看你一副躍躍欲試呢！",
    "voice": "vo_adv_1016005_026",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n就用這股氣勢中獎吧～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "膽怯可不好喔。",
    "voice": "vo_adv_1016005_027",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "放手一搏吧～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼接下來全部押在黑 4 上面喔。",
    "voice": "vo_adv_1016005_028",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n因為人家是 4 月出生。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，輪盤轉了！",
    "voice": "vo_adv_1016005_029",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "４來吧！４來吧！４來吧～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500032"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……抱歉。",
    "voice": "vo_adv_1016005_030",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "在最後的最後失手了……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "籌碼全部沒了，",
    "voice": "vo_adv_1016005_031",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n這樣也不能買東西了……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "如果人家沒有貪心的話……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的？",
    "voice": "vo_adv_1016005_032",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家也玩得超開心喔！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雖然中大獎也很開心，",
    "voice": "vo_adv_1016005_033",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n但最後竟然失手了……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊哈哈！超好笑～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊～可是怎麼辦？",
    "voice": "vo_adv_1016005_034",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
