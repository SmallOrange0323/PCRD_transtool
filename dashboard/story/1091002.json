[
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "靜流為了讓{0}\\n吃到絕品美味的巧克力而幹勁十足\\n去參加了市區中舉辦的料理教室。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "雖然是看宣傳手冊而來的，",
    "voice": "vo_adv_1091002_000",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n不過點心教室的地點",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是這裡沒錯吧？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "說是很有名的老師來教，相當大受好評，",
    "voice": "vo_adv_1091002_001",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "會教我們做出怎樣的巧克力真讓人期待呢♪",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗚哇，",
    "voice": "vo_adv_1091002_002",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "除了我還有其他學生也來了呢。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "因為情人節快到了呢。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n大家為了做出美味的巧克力都很努力。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好～",
    "voice": "vo_adv_1091002_003",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我也要為了{0}弟弟，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n努力做出美味的甜點！",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "咦？　",
    "voice": "vo_adv_1091002_004",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "隔壁廚房的周圍也有學生耶。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這邊也有舉辦一般的料理教室呢。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯？　",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "學生裡面只有一位男性……？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "欸，",
    "voice": "vo_adv_1091002_005",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那該不會是{0}弟弟吧？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊～",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "果真是{0}弟弟啊♪",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "太巧了呢！",
    "voice": "vo_adv_1091002_006",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n你在這裡做什麼呢？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯嗯……",
    "voice": "vo_adv_1091002_007",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "平常受到可可蘿她們照顧，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n為了道謝想煮飯給她們吃？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呵呵，",
    "voice": "vo_adv_1091002_008",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真了不起呢。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "有個溫柔的弟弟，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐很開心喔♪",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊，",
    "voice": "vo_adv_1091002_009",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那位是老師嗎？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好像要開始上課了。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n姐姐",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "回去自己的班上囉。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "老師1",
    "words": "各位，",
    "voice": "vo_adv_1091002_010",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老師1",
    "words": "您們好。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老師1",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老師1",
    "words": "今天由我",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老師1",
    "words": "來擔任各位的料理講師。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老師1",
    "words": "\\n能讓你們學會製作美味的巧克力，是我的光榮。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "請多多指教！",
    "voice": "vo_adv_1091002_011",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "老師1",
    "words": "那麼，",
    "voice": "vo_adv_1091002_012",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老師1",
    "words": "首先我來發放製作的流程說明。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯嗯，",
    "voice": "vo_adv_1091002_013",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "今天的課要教的是聖誕樹幹蛋糕啊。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "老師1",
    "words": "雖然巧克力基本上都是做成一顆一顆的，",
    "voice": "vo_adv_1091002_014",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老師1",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老師1",
    "words": "不過今天要來教各位的是適合送禮的\\n聖誕樹幹蛋糕課程。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老師1",
    "words": "說到聖誕樹幹蛋糕，",
    "voice": "vo_adv_1091002_015",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老師1",
    "words": "\\n一般來說常會聯想到它的材料是瑞士卷，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老師1",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老師1",
    "words": "不過這次我們只使用甘納許和慕斯來製作出層次吧。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯～",
    "voice": "vo_adv_1091002_016",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "感覺是蠻困難的食譜呢。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不過這都是為了{0}弟弟嘛。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n姐姐會加油的！",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "哼，",
    "voice": "vo_adv_1091002_017",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "總之材料準備到這個地步，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n只要再稍微等一下就可以了吧？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "感覺不錯！　",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "順利順利♪",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "話說回來，我本來以為調溫",
    "voice": "vo_adv_1091002_018",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n只是用隔水加熱再攪拌而已，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不過意外的很有難度呢……",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好，",
    "voice": "vo_adv_1091002_019",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我稍微\\n去看看{0}弟弟的情況吧。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我看一下～",
    "voice": "vo_adv_1091002_020",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這個食譜是……",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "什麼！？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n{0}弟弟，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n他上的課程，難度會不會未免太高了！？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "「酪梨鮮蝦拼盤」",
    "voice": "vo_adv_1091002_021",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n「蘆筍佐荷蘭醬」",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "「鯛魚印度烤餅」",
    "voice": "vo_adv_1091002_022",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n「燻鮭魚熱壓吐司磚」",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "「蒸長臂大蝦燉飯」",
    "voice": "vo_adv_1091002_023",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "「甲殼類奶油醬」",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "「鵝肝醬」",
    "voice": "vo_adv_1091002_024",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n「無花果焦糖塔」",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……呃，",
    "voice": "vo_adv_1091002_025",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不管哪一道\\n都不像是新手能做出來的。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "他為了讓可可蘿她們開心，",
    "voice": "vo_adv_1091002_026",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n似乎報名了最困難的料理教室呢。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}弟弟，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "做得出來嗎？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊～",
    "voice": "vo_adv_1091002_027",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}弟弟果然一臉茫然的樣子……",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n好像很不知所措……",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯！　",
    "voice": "vo_adv_1091002_028",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這算是{0}弟弟的一件大事，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n讓姐姐來幫他一把！",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "可是，",
    "voice": "vo_adv_1091002_029",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不能傷到{0}的心才行呢！",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "雖然有點辛苦，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "為了不被{0}弟弟發現，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我就偷偷地支援他吧。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "老師2",
    "words": "那麼，",
    "voice": "vo_adv_1091002_030",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "老師2",
    "words": "接下來要製作荷蘭醬。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "老師2",
    "words": "\\n在融化的奶油中",
    "voice": null,
    "unit_id": 1511
  },
