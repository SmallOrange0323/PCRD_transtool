    "words": "好，",
    "voice": "vo_adv_4012015_000",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "到此為止感覺都不錯，",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "接下來要加入的素材是……",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "接著是這個。",
    "voice": "vo_adv_4012015_001",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這是？",
    "voice": "vo_adv_4012015_002",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "糞。",
    "voice": "vo_adv_4012015_003",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "別嘲笑我，跟我說啊～",
    "voice": "vo_adv_4012015_004",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "所以我才說糞啊。",
    "voice": "vo_adv_4012015_005",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳踩到了什麼？",
    "voice": "vo_adv_4012015_006",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "所以我說糞！",
    "voice": "vo_adv_4012015_007",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n便便啦，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "便便！！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "不好意思，",
    "voice": "vo_adv_4012015_008",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n剛剛",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "是不是有人在說便便？",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……沒有！",
    "voice": "vo_adv_4012015_009",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n沒有人在說便便。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n回床上去睡覺──",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……是嗎。",
    "voice": "vo_adv_4012015_010",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n是我聽錯，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "以為有人在說便便了啊。",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "失禮了。",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呼……",
    "voice": "vo_adv_4012015_011",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我說露易、",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "望。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n別用那麼大的音量說便便這兩字啦。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那傢伙",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "好不容易快要告別便便熱潮了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "兩人",
