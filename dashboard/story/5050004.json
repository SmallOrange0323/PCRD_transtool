    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "意外地也很辛苦啊──",
    "voice": null,
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "我也搞錯好幾次",
    "voice": "vo_adv_5050004_127",
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "帶路的步驟。",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "沒錯，",
    "voice": "vo_adv_5050004_128",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "失敗的話，下次好好發揮就好。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "光是你們能夠學會反省，就是很大的成長了。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "是啊！",
    "voice": "vo_adv_5050004_129",
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "繼續享用悲鳴吧！",
    "voice": null,
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "對了，",
    "voice": "vo_adv_5050004_130",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "今天的悲鳴很美味對吧？",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "你這麼一說……",
    "voice": "vo_adv_5050004_131",
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "我也有這種感覺……",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "不是因為今天是第一天嗎？",
    "voice": "vo_adv_5050004_132",
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "是這樣嗎？",
    "voice": "vo_adv_5050004_133",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "總感覺有一股些許的甜味呢。",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "啊，你說的我懂。",
    "voice": "vo_adv_5050004_134",
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "\\n比在墳場吃到的還甜。",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "到底是為什麼呢～",
    "voice": "vo_adv_5050004_135",
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "雖然那是我們完全沒辦法理解的話題，",
    "voice": "vo_adv_5050004_136",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n不過你們可不要太沉浸在享用悲鳴之中唷。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "沒問題啦！",
    "voice": "vo_adv_5050004_137",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "因為這是第一次這麼順利嘛！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n我們不會大意的！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "\\n",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "明天也一起拼命加油吧！",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "鬼怪們",
    "words": "喔──！！",
    "voice": "vo_adv_5050004_138",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，鬼屋的第一天平安落幕了。",
    "voice": null,
    "unit_id": null
  }
]
