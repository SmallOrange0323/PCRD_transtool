  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後，鬼怪們一步步茁壯成長，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n終於迎來了重新改裝開張營業的第一天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "唉……",
    "voice": "vo_adv_5050004_000",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "就快開始了……",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "好緊張啊……",
    "voice": null,
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "對、",
    "voice": "vo_adv_5050004_001",
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "對啊……",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "不知道會不會順利……",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "不能動，",
    "voice": "vo_adv_5050004_002",
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "本大爺、",
    "voice": null,
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "不能動……",
    "voice": null,
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "好好地把客人引導到右邊……",
    "voice": "vo_adv_5050004_003",
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "艾迪",
    "words": "\\n好好地把客人引導到右邊……",
    "voice": null,
    "unit_id": 6012
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真是的！",
    "voice": "vo_adv_5050004_004",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你們在緊張什麼啦！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "都已經練習那麼多次了，沒問題的！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n相信自己吧！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我是很孱弱的女幽靈……",
    "voice": "vo_adv_5050004_005",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我是很孱弱的女幽靈……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怜大人也冷靜一點！",
    "voice": "vo_adv_5050004_006",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "沒事的！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "沒錯！",
    "voice": "vo_adv_5050004_007",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "練習是不會背叛自己的！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "為、",
    "voice": "vo_adv_5050004_008",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "為什麼茉莉",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "可以這麼自信滿滿的？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我是超級英雄秀的粉絲嘛！",
    "voice": "vo_adv_5050004_009",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "雖然表演內容不一樣，",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但成為負責表演的人",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就覺得很開心呢！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "對，",
    "voice": "vo_adv_5050004_010",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就是這樣！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "會緊張也是正常的！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n不過首先得要讓自己樂在其中！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n要想讓客人開心，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就必須先從自己做起呢！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過現在",
    "voice": "vo_adv_5050004_011",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "倒是要讓他們害怕，",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "沒錯吧。",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這些細節無所謂啦！！",
    "voice": "vo_adv_5050004_012",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "一大早就很有精神呢，",
    "voice": "vo_adv_5050004_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "小妹妹。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "鬼魂教父，",
    "voice": "vo_adv_5050004_014",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "有什麼事嗎？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "我來看一下那些傢伙的狀況，",
    "voice": "vo_adv_5050004_015",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "他們有稍微能幹……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼怪們",
    "words": "…………",
    "voice": "vo_adv_5050004_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "看起來好像沒什麼變化呢，",
    "voice": "vo_adv_5050004_017",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n我才聽說他們至少能吃到悲鳴了啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "別看他們那樣，身為鬼屋的登場角色，",
    "voice": "vo_adv_5050004_018",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "他們確實成長了很多唷。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n現在即使出現在客人面前肯定也不會丟臉。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n一定會讓你另眼相看的。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "那真是令人期待啊。",
    "voice": "vo_adv_5050004_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "總之，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "就盡量多多招攬客人吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "當然囉，",
    "voice": "vo_adv_5050004_020",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這還用你說。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼怪們",
    "words": "…………",
    "voice": "vo_adv_5050004_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "好了好了！",
    "voice": "vo_adv_5050004_022",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "別窩在一起發愣，要開館囉！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生就繞著城鎮持續宣傳吧！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "大家一起讓客人開心吧！",
    "voice": "vo_adv_5050004_023",
    "unit_id": 113911
  },
  {
    "type": "background",
    "bg_id": "501140"
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "這鬼屋意外的很有氣氛耶！",
    "voice": "vo_adv_5050004_024",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "剛才櫃台的小姐也演得很逼真啊。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "對、",
    "voice": "vo_adv_5050004_025",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "對啊……",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "不用那麼害怕沒關係啦。",
    "voice": "vo_adv_5050004_026",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n我聽說這裡沒有那麼恐怖呢。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "可是，",
    "voice": "vo_adv_5050004_027",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "黑漆漆的還是很恐怖啊……",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "腳邊的照明不是弄得很充足嗎？",
    "voice": "vo_adv_5050004_028",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "害怕的話就往地下看吧。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "那、",
    "voice": "vo_adv_5050004_029",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "那樣的話不是很浪費嗎！",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "既然如此，",
    "voice": "vo_adv_5050004_030",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "那就和我牽著手吧。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "好啦，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "我們往前走吧。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊～！",
    "voice": "vo_adv_5050004_031",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "又有客人了嗎～？",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "歡迎光臨～！",
    "voice": "vo_adv_5050004_032",
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "和我們",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "一起玩吧～！",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "什、",
    "voice": "vo_adv_5050004_033",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "什麼啊這些孩子？",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大姐姐，",
    "voice": "vo_adv_5050004_034",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "有空的話和我們一起玩吧！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "該玩點什麼好呢～",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "呃、",
    "voice": "vo_adv_5050004_035",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "那個，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "這樣的話看你們想要玩什麼？",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我們",
    "voice": "vo_adv_5050004_036",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "正好肚子餓了呢～",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "所以……",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "……？",
    "voice": "vo_adv_5050004_037",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "可以請妳成為我們的點心嗎？",
    "voice": "vo_adv_5050004_038",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "看起來很好吃的點心，",
    "voice": "vo_adv_5050004_039",
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "我要開動囉！",
    "voice": null,
    "unit_id": 5812
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "咦？",
    "voice": "vo_adv_5050004_040",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "維多",
    "words": "吼喔喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "呀────！！",
    "voice": "vo_adv_5050004_041",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "哈哈哈，",
    "voice": "vo_adv_5050004_042",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "被這點東西嚇到，妳真可愛啊──",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "喂──",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
