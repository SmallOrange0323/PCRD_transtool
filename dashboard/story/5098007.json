    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n其實",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我有事想告訴妳們。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n而且我想在",
