  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "明明還是大白天呢♪",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "看來發生了不少事。",
    "voice": "vo_adv_5098007_032",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n感覺你",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "給太陽曬一曬之後變成熟了？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "開玩笑的！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯，",
    "voice": "vo_adv_5098007_033",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "玩笑話先擱到一邊……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "實際上，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "的確變得成熟一點了吧？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n少年還有",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "她們都是如此。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那個生物……",
    "voice": "vo_adv_5098007_034",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "叫小繆",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "來著？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "身邊人類的心靈",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "對那孩子的力量",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "會造成最大的影響。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n因為牠很純真。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "容易受到成長的環境影響。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "從這層意義上來說，",
    "voice": "vo_adv_5098007_035",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我很放心。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n少年和她們",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "都不會試圖實現邪惡的願望。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "一定會",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "走向好的方向……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "因為",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我這麼相信著。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這個我也不知道。",
    "voice": "vo_adv_5098007_036",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我不是在轉移話題喔？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是真的不知道。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那會是一年後、",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "十年後，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "還是……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不過呢？",
    "voice": "vo_adv_5098007_037",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n在重逢之前度過的時光，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "也很珍貴喔。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n和少年你們",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "在這個夏天所經歷的時光一樣珍貴。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "所以，",
    "voice": "vo_adv_5098007_038",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "少年。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n以後也陪她們共度時光吧。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n共度那不經意",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "又無可取代，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "快樂的每一天。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗯嗯。",
    "voice": "vo_adv_5098007_039",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n回答得很好♪",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……話說回來，",
    "voice": "vo_adv_5098007_040",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我有點驚訝呢。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雖說並不擔心，",
    "voice": null,
    "unit_id": 106812
  },
