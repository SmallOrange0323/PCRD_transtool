  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在漫長的暑假也接近尾聲的某一天……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n【小小甜心】的三人與{0}，",
    "voice": null,
    "unit_id": null
  },
