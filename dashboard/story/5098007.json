  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "明明是在開發早期裝設的，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "還真是依然有活力呢。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "哎呀，",
