    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n也有找栞小姐幫忙。",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "然後……",
