  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯？",
    "voice": "vo_adv_5120101_000",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n暗黑的眷屬們在騷動呢……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哦……",
    "voice": "vo_adv_5120101_001",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "居然有人入侵妾身的城堡？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還真是個膽大包天的傢伙。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈～哈哈哈哈哈！",
    "voice": "vo_adv_5120101_002",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n很好，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "看來能讓妾身好好打發時間啊。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好了，",
    "voice": "vo_adv_5120101_003",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "愚蠢的入侵者啊，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "快現身吧！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就讓妾身這個傳說的吸血鬼，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "「統御黑夜之人」",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "伊莉亞‧奧恩斯坦親自當妳的對手吧！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呵呵，",
    "voice": "vo_adv_5120101_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n「統御黑夜之人」啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n這別名還挺美的嘛。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "既然如此，",
    "voice": "vo_adv_5120101_005",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我就這樣報上名號吧。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "「統御美麗之人」，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雪",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……♪",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哦哦……",
    "voice": "vo_adv_5120101_006",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎麼好像來了個奇怪的傢伙。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "無妨，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那麼",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳有什麼事？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "伊莉亞‧奧恩斯坦。",
    "voice": "vo_adv_5120101_007",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我希望被稱為傳說的吸血鬼的妳，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "能把力量借給我。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "沒錯，",
    "voice": "vo_adv_5120101_008",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這是為了將我的美貌",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "化為永恆的存在！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "下回，",
    "voice": "vo_adv_5120101_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "「吸血鬼傳聞錄　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
