    "words": "……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "沒……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "沒有啦。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "我、",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "我是……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "開玩笑的。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "畢竟在這夢境中收到的禮物",
    "voice": "vo_adv_4010248_006",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "肯定是帶不回去的，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n終究只會淪為一場遊戲……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "所以我就想說，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n既然如此",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "乾脆玩得更認真一點",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "豈不更好？",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "咦？",
    "voice": "vo_adv_4010248_007",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "你真的……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "願意簽上名字嗎？",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "這種像笑話一般的願望，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "你竟然願意幫我實現……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "……呃，",
    "voice": "vo_adv_4010248_008",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "那麼……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n等一下……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "再去約個會",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "之類的。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n只有今天一天，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "像夫妻那樣……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "這也",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "讓我做了一場如此美妙的夢……",
    "voice": "vo_adv_4010248_009",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "謝謝你，",
    "voice": null,
