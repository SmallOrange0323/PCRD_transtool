  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "騎士先生，",
    "voice": "vo_adv_4010248_000",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "今天約我出來見面，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "該不會是……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "謝謝……",
    "voice": "vo_adv_4010248_001",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n我現在能夠",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "跟騎士先生站在一起，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "光是這樣就很幸福了。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n想不到竟有這麼一段",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "能讓我倆獨處的時間──",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "不過。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "啊，",
    "voice": "vo_adv_4010248_002",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "不過",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "要是可以的話，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n我想跟你",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "要一樣東西。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "那個……",
    "voice": "vo_adv_4010248_003",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "你可能會覺得有點怪。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n我想要騎士先生你的……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "簽名。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "還是、",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "不方便？",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "這張紙上的……",
    "voice": "vo_adv_4010248_004",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "這個欄位喔。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "簽上你的名字……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n然後再幫我蓋個章",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "就完美了。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "嗯。",
    "voice": "vo_adv_4010248_005",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "……",
    "voice": null,
