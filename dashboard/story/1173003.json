  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果你也是那麼想的話，",
    "voice": "vo_adv_1173003_051",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我會很開心……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……",
    "voice": "vo_adv_1173003_052",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果救援一直沒來的話，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我我",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我們就一起在這裡生──",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "漁夫",
    "words": "喂～",
    "voice": "vo_adv_1173003_053",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫",
    "words": "你們沒事吧～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫",
    "words": "\\n我現在就過去～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊，",
    "voice": "vo_adv_1173003_054",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那是",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "白天的漁夫先生！",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n他來",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "救我們了呢……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呼，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "太好了……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果沒被打斷的話，",
    "voice": "vo_adv_1173003_055",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "會說出什麼話呢……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我可能是曬昏頭了，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "才會變得太過大膽。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "向前踏出一步的勇氣是很重要沒錯，",
    "voice": "vo_adv_1173003_056",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但我實在是踏過頭了對吧。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真是好險……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咦！？",
    "voice": "vo_adv_1173003_057",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n沒、",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "沒有！",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我什麼都沒說……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "來救援的人載著千歌跟{0}回沙灘上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n途中千歌一直默默無語，羞紅了小臉。",
    "voice": null,
    "unit_id": null
  }
]
