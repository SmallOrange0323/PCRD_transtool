  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一個人坐在海邊的鈴奈\\n正和來路不明的生物對峙著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_5019004_000",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "魔、",
    "voice": "vo_adv_5019004_001",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "魔物？　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好像又不是……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你好你好。",
    "voice": "vo_adv_5019004_002",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你、",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你是",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "誰……？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊！",
    "voice": "vo_adv_5019004_003",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n難道是……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雨神大人？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不、",
    "voice": "vo_adv_5019004_004",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不會吧？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……嗯。",
    "voice": "vo_adv_5019004_005",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？　",
    "voice": "vo_adv_5019004_006",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我說對了嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可是，",
    "voice": "vo_adv_5019004_007",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "為什麼雨神大人會在這種地方？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "為了讓明天能舉辦活動，",
    "voice": "vo_adv_5019004_008",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "希望你能幫忙調節一下天氣……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可是，",
    "voice": "vo_adv_5019004_009",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好像……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "吶吶。",
    "voice": "vo_adv_5019004_010",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "……？",
    "voice": "vo_adv_5019004_011",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你從剛才就一臉難過的樣子，",
    "voice": "vo_adv_5019004_012",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "發生什麼不開心的事了嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，",
    "voice": "vo_adv_5019004_013",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們語言不通啊～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "剛才不自覺就跟你搭話了。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "抱歉～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "因為見不到朋友……",
    "voice": "vo_adv_5019004_014",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？",
    "voice": "vo_adv_5019004_015",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "因為見不到朋友，",
    "voice": "vo_adv_5019004_016",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "我很難過……",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦！？",
    "voice": "vo_adv_5019004_017",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n說話了！？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們竟然能夠對話，",
    "voice": "vo_adv_5019004_018",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "太狂了吧！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n明明不是人類，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但你竟然能說人話耶，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你精通兩種語言嗎！？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "難道這就是所謂的",
    "voice": "vo_adv_5019004_019",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "遭遇未知生物",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "吧！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好狂啊啊啊啊！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家好像",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "正在經歷超不得了的經驗耶～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "吶吶，",
    "voice": "vo_adv_5019004_020",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "反正這麼難得，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "能和你聊一聊嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n你說的那位朋友，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是指這島上的誰嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "不是。",
    "voice": "vo_adv_5019004_021",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "\\n他和我一樣，",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "是精靈。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "\\n人類都稱呼他是",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "晴神大人。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雨神大人和",
    "voice": "vo_adv_5019004_022",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "晴神大人啊～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你說是人類這樣稱呼他，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是什麼意思？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "他的真名是？　",
    "voice": "vo_adv_5019004_023",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你們是怎麼",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "稱呼對方的？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "……",
    "voice": "vo_adv_5019004_024",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "沒有。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "\\n因為我們",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "總是在一起，",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "不需要互相稱呼名字。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "原來是這樣啊～",
    "voice": "vo_adv_5019004_025",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "既然是朋友，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "取個只屬於你們兩人的暱稱不是很好嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家來幫你想吧！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯～……",
    "voice": "vo_adv_5019004_026",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n叫什麼好呢～……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……對了！",
    "voice": "vo_adv_5019004_027",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "……唔！？",
    "voice": "vo_adv_5019004_028",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雨神大人就叫",
    "voice": "vo_adv_5019004_029",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雨吉，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "晴神大人就叫",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "晴吉！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "雨吉和",
    "voice": "vo_adv_5019004_030",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "晴吉……",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "如何如何？",
    "voice": "vo_adv_5019004_031",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "晴吉、",
    "voice": "vo_adv_5019004_032",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "晴吉……",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "嗯……",
    "voice": "vo_adv_5019004_033",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "我覺得不錯。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "\\n雨吉和",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨神大人",
    "words": "晴吉……♪",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家叫",
    "voice": "vo_adv_5019004_034",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "鈴奈喔！　　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雨吉，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "請多指教！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "謝謝妳，",
    "voice": "vo_adv_5019004_035",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "鈴奈♪",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你好像很喜歡，我好開心～",
    "voice": "vo_adv_5019004_036",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你和晴吉",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是怎樣的朋友啊？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "我們總是一起甦醒，",
    "voice": "vo_adv_5019004_037",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n雖然老是因為一點小事就吵架……",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "我們會大玩特玩地",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "渡過夏天。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "然後，",
    "voice": "vo_adv_5019004_038",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "直到下次見面前",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "一起進入沉眠。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦！　",
    "voice": "vo_adv_5019004_039",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好像一直在玩，感覺好開心！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不用上課和寫作業，真讓人羨慕～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "上、",
    "voice": "vo_adv_5019004_040",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "課……？",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n我不懂你說的那是什麼，",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "不過我和晴吉總是在一起。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "人類們",
    "voice": "vo_adv_5019004_041",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "也一直默默的守護我們。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n那讓我很開心。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "可是……",
    "voice": "vo_adv_5019004_042",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "當春天我甦醒時，",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "只剩下我一個人。",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n是因為之前我們吵架，",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "還沒和好就陷入沉眠，",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n所以他才沒有醒來嗎？　",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "他已經",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "不會陪我玩了嗎……",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "我好想快點見到晴吉……",
    "voice": "vo_adv_5019004_043",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n希望他不會討厭我……",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雨吉～",
    "voice": "vo_adv_5019004_044",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家也很了解",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你的心情喔～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "為什麼？",
    "voice": "vo_adv_5019004_045",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我是來這座島",
    "voice": "vo_adv_5019004_046",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "工作的。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n島上的人們，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "邀請我過來！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可是，",
    "voice": "vo_adv_5019004_047",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我和跟我一起來的朋友",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "起了一點爭執。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "等明天的活動結束後，我能休假一陣子，",
    "voice": "vo_adv_5019004_048",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "本來打算要大肆地渡假一番……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "鈴奈也",
    "voice": "vo_adv_5019004_049",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "和朋友分道揚鑣了？",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯～",
    "voice": "vo_adv_5019004_050",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n大概類似吧～？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那位朋友",
    "voice": "vo_adv_5019004_051",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "和我讀同間學校，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不過學校有可能會廢校。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是不是很扯？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "廢校是指",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "學校會不見的意思！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "要是那樣子的話，",
    "voice": "vo_adv_5019004_052",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們就不能再像之前那樣一起玩了嘛！？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "今年說不定是",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n我和朋友",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "一起渡過的最後的暑假了……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們……",
    "voice": "vo_adv_5019004_053",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "當初是不是不來這座島比較好啊……？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "……",
    "voice": "vo_adv_5019004_054",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可是，",
    "voice": "vo_adv_5019004_055",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家是模特兒，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n哪有不接工作的道理嘛。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "唉～～～",
    "voice": "vo_adv_5019004_056",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "為什麼事情會變成這個樣子呢～～～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，",
    "voice": "vo_adv_5019004_057",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "讓你擔心了嗎？",
    "voice": "vo_adv_5019004_058",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "抱歉～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家沒事。",
    "voice": "vo_adv_5019004_059",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "只是來冷靜一下。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我已經反省過了，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "覺得自己說得有點太過分～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "吶吶！　",
    "voice": "vo_adv_5019004_060",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對了，你聽我說！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "鏘鏘！",
    "voice": "vo_adv_5019004_061",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n這孩子",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就是那個雨神大人！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n是不是超可愛的！？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才",
    "voice": "vo_adv_5019004_062",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你是全力在搞笑嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我現在完全笑不出來～？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你看，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就是他啊～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯，奇怪？",
    "voice": "vo_adv_5019004_063",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n真的不見了。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真是奇怪啊。",
    "voice": "vo_adv_5019004_064",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n剛才雨吉還在這裡的。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n他好像很難過的在哭～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "他說雖然大家稱呼他雨神大人，",
    "voice": "vo_adv_5019004_065",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可是那並不是他的真名。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "而且他竟然沒有自己的名字！　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "很驚人吧？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以，",
    "voice": "vo_adv_5019004_066",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家就",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "幫他取了「雨吉」這個名字！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對對，",
    "voice": "vo_adv_5019004_067",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還有啊，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n他明明是精靈，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可是他聽得懂人話耶！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n雖然只有一下下，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但我們一起聊天了喔！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯，",
    "voice": "vo_adv_5019004_068",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們聊了什麼嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這個嘛～～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "――就是這樣～",
    "voice": "vo_adv_5019004_069",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就是所謂的越吵架感情越好？　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "實在有夠催淚的不是嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才你對那樣的友情",
    "voice": "vo_adv_5019004_070",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "有什麼想法？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "超深情的～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你不覺得嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家和美咲！？",
    "voice": "vo_adv_5019004_071",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯～",
    "voice": "vo_adv_5019004_072",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你那樣說好像也是～……？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為我們老是吵架……？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不過。",
    "voice": "vo_adv_5019004_073",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "其實我們只是想要鼓勵、",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "和讚美彼此呢～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？　",
    "voice": "vo_adv_5019004_074",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這麼說來……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "剛才美咲說的……",
    "voice": "vo_adv_5019004_075",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n因為人家想說活動可能會中止而沮喪，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以她是想要鼓勵我嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這樣啊～……！",
    "voice": "vo_adv_5019004_076",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家，",
    "voice": "vo_adv_5019004_077",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好像老是在想工作的事情呢～？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "明明平時馬上就會注意到的，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "結果今天好像超煩躁。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "謝謝你讓我想起這件事，",
    "voice": "vo_adv_5019004_078",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦！？",
    "voice": "vo_adv_5019004_079",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n美咲她",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為人家生氣的關係而哭了！？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，",
    "voice": "vo_adv_5019004_080",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不要再發呆了，快衝！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n回去村莊後，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "得快點向美咲道歉才行！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "鈴奈丟下前來鼓勵自己的{0}，\\n急忙跑回美咲所在的公會小屋。",
    "voice": null,
    "unit_id": null
  }
]
