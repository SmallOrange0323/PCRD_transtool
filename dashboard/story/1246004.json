  {
    "type": "dialogue",
    "name": "美里",
    "words": "咦，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "{0}你也睡著了嗎？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵，",
    "voice": "vo_adv_1246004_062",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "新年的假期就到此結束。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n從明天開始，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "又要幹勁十足地努力工作囉～",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯，",
    "voice": "vo_adv_1246004_063",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "很開心喔♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你還記得",
    "voice": "vo_adv_1246004_064",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我們在神殿的繪馬上所寫的願望嗎？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n「希望大家都能常保笑容」……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這次的新年，我和你一起",
    "voice": "vo_adv_1246004_065",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n見到了許多人的笑容呢～",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……不過啊……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "笑得最開心的，就是老師我喔～♪",
    "voice": "vo_adv_1246004_066",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n這都是託{0}的福。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵♪\\n{0}，",
    "voice": "vo_adv_1246004_067",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "今年",
    "voice": "vo_adv_1246004_068",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我們也一起常保笑容吧～♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，美里與{0}的嶄新的一年",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就此拉開了序幕──",
    "voice": null,
    "unit_id": null
  }
]
