  {
    "type": "dialogue",
    "name": "旁白",
    "words": "玩完歌牌遊戲，等孩子們都回去後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n美里與{0}一起整理環境。",
