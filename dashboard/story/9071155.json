    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n原本就已經少顆螺絲的腦袋，",
    "voice": null,
    "unit_id": 106611
  },
  {
