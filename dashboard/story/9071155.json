    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "哼～",
    "voice": "vo_adv_9071155_013",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是嗎～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那麼，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就讓我來看看祈梨妳現在的實力吧，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n看能不能真的下剋上成功？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啥？",
    "voice": "vo_adv_9071155_014",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼意思？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊，",
