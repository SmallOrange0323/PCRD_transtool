    "words": "好、",
    "voice": "vo_adv_5042004_079",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好誇張的力量……",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要是再承受一次攻擊，",
    "voice": "vo_adv_5042004_080",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我們會扛不住的……！",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥！",
    "voice": "vo_adv_5042004_081",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "站在前線是很危險的！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥你剛才",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "也受到了攻擊啊！！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生，",
    "voice": "vo_adv_5042004_082",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不可以……！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩……",
    "voice": "vo_adv_5042004_083",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "快住手……！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥，",
    "voice": "vo_adv_5042004_084",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不要逞強啊！",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不管你有幾條命都扛不住的！",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真的是岌岌可危",
    "voice": "vo_adv_5042004_085",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呀……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "傷腦筋～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "…………",
    "voice": "vo_adv_5042004_086",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "……嘿，璃乃",
    "voice": "vo_adv_5042004_087",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "，謝謝妳來到",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "這個世界。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n能夠遇見像妳這樣的朋友，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我很開心。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "愛麗絲……？",
    "voice": "vo_adv_5042004_088",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "妳這是什麼",
    "voice": "vo_adv_5042004_089",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "大吃一驚的表情呀。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n我只是坦率地向妳道謝而已。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "愛麗絲，這是什麼意思……？",
    "voice": "vo_adv_5042004_090",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n為什麼要在這種情況下",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "說這種話呢？",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "現在開始，我要完全解放自己的救世主之力，。",
    "voice": "vo_adv_5042004_091",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n起碼能瞞過黑之王的耳目吧。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "妳們先暫時退下，",
    "voice": "vo_adv_5042004_092",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "重振旗鼓。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "聽懂了嗎？",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "到底是什麼意思！？",
    "voice": "vo_adv_5042004_093",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n為什麼不是愛麗絲妳跟我們一起重振旗鼓呢！？",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這、",
    "voice": "vo_adv_5042004_094",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這是什麼！？",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "突然有光芒……！",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "愛麗絲……！？",
    "voice": "vo_adv_5042004_095",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n喂，",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "愛麗絲！！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "接下來，就交給妳了。",
    "voice": "vo_adv_5042004_096",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "要打倒那傢伙，",
    "voice": "vo_adv_5042004_097",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "救世主之力必須要更一步覺醒。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "要是能和妳一起尋找方法就好了……",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "……真的",
    "voice": "vo_adv_5042004_098",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "很對不起。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "不過，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "妳一定辦得到。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "妳一定可以得到",
    "voice": "vo_adv_5042004_099",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "真正的救世主之力……",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n我",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "相信著妳。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "拜託妳了，",
    "voice": "vo_adv_5042004_100",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "守護住這個世界──",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n璃乃──",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "黑之王的出現，讓書中世界充滿了黑暗力量所引發的瘴氣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而愛麗絲所釋放的光芒，就宛如黑暗中的燈火籠罩著璃乃等人。",
    "voice": null,
    "unit_id": null
  }
]
