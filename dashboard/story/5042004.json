[
  {
    "type": "background",
    "bg_id": "501020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在紅心皇后的城堡前，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一行人與受到黑之王侵蝕的人們展開交戰。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "唔喵喵喵喵喵！",
    "voice": "vo_adv_5042004_000",
    "unit_id": 100113
  },
  {
    "type": "background",
    "bg_id": "501020"
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不、",
    "voice": "vo_adv_5042004_001",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不要過來啦～！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "background",
    "bg_id": "501020"
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "唔喔喔喔喔～～！！",
    "voice": "vo_adv_5042004_002",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗚……",
    "voice": "vo_adv_5042004_003",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "根本沒完沒了呀～！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "交給我們吧！",
    "voice": "vo_adv_5042004_004",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n愛麗絲，",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們上！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "隨時奉陪！",
    "voice": "vo_adv_5042004_005",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃、愛麗絲",
    "words": "去吧～～！！",
    "voice": "vo_adv_5042004_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "成功了！",
    "voice": "vo_adv_5042004_007",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我們先去跟祈梨她們會合吧！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "嘻嘻嘻！",
    "voice": "vo_adv_5042004_008",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "黑之王萬歲！！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "background",
    "bg_id": "501020"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這、",
    "voice": "vo_adv_5042004_009",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這些人突然在搞什麼鬼呀！",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我只好使出嘉夜夜式無腦談判……",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n那就是，",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "用武力讓他們聽話！！",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "background",
    "bg_id": "501020"
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "唔咿咿咿咿！",
    "voice": "vo_adv_5042004_010",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "大臣，妳也要動手呀！",
    "voice": "vo_adv_5042004_011",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "有呀～？",
    "voice": "vo_adv_5042004_012",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n……拉格在做了♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "拉格",
    "words": "嘎喔！",
    "voice": "vo_adv_5042004_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳偶爾也該自己動手吧！",
    "voice": "vo_adv_5042004_014",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔～……",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳對待龍的方式還真是一如往常的蠻橫！！",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "祈梨！",
    "voice": "vo_adv_5042004_015",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "帆稀小姐！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是我～",
    "voice": "vo_adv_5042004_016",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "歡迎你們～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "歡迎蒞臨",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "紅心皇后的城堡～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "現在是悠悠哉哉打招呼的時候嗎！？",
    "voice": "vo_adv_5042004_017",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你們幾個，快把情況解釋清楚！",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這個嘛，",
    "voice": "vo_adv_5042004_018",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那些被黑之王侵蝕的人們",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n唰唰地攻擊過來，",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "然後我們就嗚哇──！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對吧！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "步未！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雖、",
    "voice": "vo_adv_5042004_019",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雖然我也不清楚，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但差不多就是這樣……！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那種說明方式誰聽得懂啊！？",
    "voice": "vo_adv_5042004_020",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n妳是笨蛋嗎！？",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "原來如此～",
    "voice": "vo_adv_5042004_021",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n也就是說操縱著",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那些瘴氣的敵人名叫黑之王啊～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳怎麼可以透過那些模稜兩可的形容理解情況呀！？",
    "voice": "vo_adv_5042004_022",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "總而言之，",
    "voice": "vo_adv_5042004_023",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "大家平安無事，那我就放心了～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們",
    "voice": "vo_adv_5042004_024",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "為了尋找回到原來的世界的方法而踏上旅程，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n遭到形形色色的盜賊襲擊～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "實在是束手無策了，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我就「說服」他們",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "來協助我們～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說服……",
    "voice": "vo_adv_5042004_025",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說服！？",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n不是吧，",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "與其說是說服，",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不如說是更邪惡的方式吧！？",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "而且這種話，",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "誰會相信啊……",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "居然能夠說服盜賊",
    "voice": "vo_adv_5042004_026",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "成為自己的同伴……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "帆稀小姐好厲害呀！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "同樣身為公會長，我好崇拜妳呀！",
    "voice": "vo_adv_5042004_027",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "帆稀小姐，",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "下次妳可以再教教我其他事嗎！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵呵～",
    "voice": "vo_adv_5042004_028",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "可以呀～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n之後讓我仔仔細細地教妳，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這、",
    "voice": "vo_adv_5042004_029",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這群人也太天真過頭了吧！",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……",
    "voice": "vo_adv_5042004_030",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咳，",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗯，大概就是這麼一回事。",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n所以我們就把這座無人城當作據點了。",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "作為紅心皇后和",
    "voice": "vo_adv_5042004_031",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "她的大臣喲♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那麼，",
    "voice": "vo_adv_5042004_032",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "紅心皇后和",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "黑之王聯手的傳聞……",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啥～！？",
    "voice": "vo_adv_5042004_033",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那擺明了就是謠言啊。",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說到底，",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "黑之王是什麼啊？",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們",
    "voice": "vo_adv_5042004_034",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "探索的手段好像稍～微粗暴了一點，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n所以在他們眼裡，我們就像是在破壞這個國家吧～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "黑之王呀～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "一定是他",
    "voice": "vo_adv_5042004_035",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "唆使底下的人",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "散播紅心皇后的負面謠言……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n打算把我們集結在一起後，",
    "voice": null,
    "unit_id": 106711
  },
  {
