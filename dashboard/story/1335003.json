    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "{0}。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n聽了你的想法後，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我感覺心情變輕鬆了。",
