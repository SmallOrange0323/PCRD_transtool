  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那樣的話，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "感覺每天都會非常快樂呢……",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n如果那樣的未來能夠到來，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那就真的太好了。",
