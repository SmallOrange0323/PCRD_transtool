[
  {
    "type": "background",
    "bg_id": "500181"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "鏡華在精靈之森的深處，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n找到了迷路的{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真是的，",
    "voice": "vo_adv_1036011_000",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "為什麼只是去洗手間都可以迷路啊！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n是因為你總是在發呆對吧？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你這人實在",
    "voice": "vo_adv_1036011_001",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "令人很不放心耶！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……早知道我就陪你一起去了。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不、",
    "voice": "vo_adv_1036011_002",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不是喔，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我沒辦法跟進洗手間喔！？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n這你懂吧？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……懂的話那就算了。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "唉。",
    "voice": "vo_adv_1036011_003",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼你也該回去了。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n因為很擔心，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我會把你送去精靈之森出口。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呃，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "如果要從這裡出去……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦？",
    "voice": "vo_adv_1036011_004",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "太陽的方向",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "跟平常不一樣……？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "哇！？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好、",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好亮……！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……呼。",
    "voice": "vo_adv_1036011_005",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯？",
    "voice": "vo_adv_1036011_006",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "什麼啊，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是{0}嗎。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n因為突然來搭話，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我還以為是哪個變態呢。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "開玩笑的。",
    "voice": "vo_adv_1036011_007",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "{0}的聲音，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我已經聽得很熟悉了，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "所以不會弄錯。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦？",
    "voice": "vo_adv_1036011_008",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你說我為何那麼",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "沮喪？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……難道，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你是在擔心我嗎？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "雖然其實並不是沮喪……",
    "voice": "vo_adv_1036011_009",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你要聽我說說嗎？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我……",
    "voice": "vo_adv_1036011_010",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "接下來要去參加宣傳照的",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "攝影會。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n媽媽擅自",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "幫我應徵了兒童模特兒的招募會，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "而且不知為何中選了……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "因為媽媽",
    "voice": "vo_adv_1036011_011",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "似乎很高興地表示",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "「可以作為很棒的紀念」，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n所以讓我無法拒絕，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就一路拖到了今天。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "唉……",
    "voice": "vo_adv_1036011_012",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n模特兒什麼的",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "太害羞了，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我根本做不到……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦……",
    "voice": "vo_adv_1036011_013",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦咦！？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我才不要給你看！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "絕對不要！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就算你咬著手指裝可憐，",
    "voice": "vo_adv_1036011_014",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不行的事情就是不行！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n請不要用這種小孩子撒嬌的方式！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "為、",
    "voice": "vo_adv_1036011_015",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "為什麼你要跪在地上！？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n難道",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是要跪地磕頭嗎！？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你要對小孩子做到那種地步嗎！？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我、",
    "voice": "vo_adv_1036011_016",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我知道了，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你可以來看！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我讓你跟我一起過去啦，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n所以請不要在這種地方對我磕頭！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "討厭……",
    "voice": "vo_adv_1036011_017",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "實在是拿你沒轍耶。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你可以跟我一起去，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但是相對的千萬不要妨礙我喔！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "background",
    "bg_id": "510200"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "哇……",
    "voice": "vo_adv_1036011_018",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好多大人……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我原本以為是",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "更小規模的攝影會。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "啊，",
    "voice": "vo_adv_1036011_019",
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "妳就是",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "今天擔任模特兒的女孩子吧！",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊，",
    "voice": "vo_adv_1036011_020",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是的……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請多多指教。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n今天要受各位照顧了。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "喔，",
    "voice": "vo_adv_1036011_021",
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "是個很認真的孩子呢。",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n請多多指教。",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "那麼，",
    "voice": "vo_adv_1036011_022",
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "這是攝影用的服裝，",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n能麻煩妳去另一邊換上嗎。",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n會有造型師陪妳過去。",
    "voice": null,
    "unit_id": 1131
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "哇……",
    "voice": "vo_adv_1036011_023",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "純白色，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "而且輕飄飄的",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "漂亮服裝……",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "等等，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這不是新娘禮服嗎！？",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我只有聽說",
    "voice": "vo_adv_1036011_024",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是宣傳照用的服裝。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
