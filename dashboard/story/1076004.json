[
  {
    "type": "background",
    "bg_id": "500162"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後。\\n{0}和可可蘿，\\n一起前往住宿的度假小屋。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "…………",
    "voice": "vo_adv_1076004_000",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊，主人……",
    "voice": "vo_adv_1076004_001",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n真是非常抱歉，在下又被強烈的睡意所襲擊。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "甚、",
    "voice": "vo_adv_1076004_002",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "甚至到了沒辦法站起來的程度……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請稍等一下，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下來拍拍臉把睡意驅散。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗚哇？",
    "voice": "vo_adv_1076004_003",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n為什麼，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要把在下抱起來呢……？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯……",
    "voice": "vo_adv_1076004_004",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "老實說，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是幫了大忙。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n麻煩您了，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下實在榮幸至極。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下，",
    "voice": "vo_adv_1076004_005",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "因為平常這個時間早已入睡……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以腦袋好像還是醒不來，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真不好意思。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "白天也有斷斷續續地小睡，",
    "voice": "vo_adv_1076004_006",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n照理說應該很有精神才對。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在海邊游玩，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "意外地很耗體力呢……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "精疲力盡了。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好想就這樣",
    "voice": "vo_adv_1076004_007",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一直安穩地熟睡到早上。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人不好意思，",
    "voice": "vo_adv_1076004_008",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不小心太過撒嬌了……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這樣是不行的呢，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "明明有身為支持引導主人",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的嚮導責任在身。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下卻總是",
    "voice": "vo_adv_1076004_009",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "反過來受您的照顧……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊……",
    "voice": "vo_adv_1076004_010",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n但是不知為何，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有種懷念的感覺。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "白天",
    "voice": "vo_adv_1076004_011",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "被陽光曬得發燙、",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "刺痛刺痛的皮膚……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n主人的體溫、",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "心跳……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n好像曾在哪裡，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也有過這樣珍貴的心情……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主、",
    "voice": "vo_adv_1076004_012",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這個光芒是……？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊……",
    "voice": "vo_adv_1076004_013",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好睏，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒辦法思考了。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "still",
    "still_id": "107600401"
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人，",
    "voice": "vo_adv_1076004_014",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真是感謝您。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "能在這裡遇見主人，",
    "voice": "vo_adv_1076004_015",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真是作夢也沒想到。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n果然主人是",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "指引迷惘在下",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "的救世主……♪",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_1076004_016",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "雖然在下",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "今天想和父親",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "一起練習游泳。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "但父親因為工作臨時有急事……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "留下在下一個人，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "很寂寞呢。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "如果只有在下的話，",
    "voice": "vo_adv_1076004_017",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "即便想練習游泳，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n也不知道該怎麼練習才好……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人在這附近，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "還願意教導在下真的非常感謝。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510190"
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "嗯，",
    "voice": "vo_adv_1076004_018",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "為什麼呢？",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n主人，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "常常要在下別這樣叫呢。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "但是",
    "voice": "vo_adv_1076004_019",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人就是主人啊……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "即使您這樣吩咐，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下也無法遵從。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "嗯……",
    "voice": "vo_adv_1076004_020",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "確實是有點怪，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "也許是一般不會使用的稱呼吧。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "但在下個人還是覺得，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n稱呼您為主人",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "是最適合的方式了。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不過",
    "voice": "vo_adv_1076004_021",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人不喜歡的話，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "應該來想個替代方案。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n至少在別人面前，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "使用別的稱呼方式好了。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "妥協一下……",
    "voice": "vo_adv_1076004_022",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "但其實在下，還是很希望稱呼主人呢。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人有沒有什麼，",
    "voice": "vo_adv_1076004_023",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n認為「想被這樣喊～」",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "的稱呼方式呢？",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "唔，",
    "voice": "vo_adv_1076004_024",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "用名字……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "但是很抱歉，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "忘了主人的名字。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "因為主人就是主人，",
    "voice": "vo_adv_1076004_025",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n所以想說名字不太重要……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "雖然這麼問很失禮，",
    "voice": "vo_adv_1076004_026",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "能再告訴在下一次",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您的名字嗎？",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "唔……",
    "voice": "vo_adv_1076004_027",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "但，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人並不是",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下的哥哥吧？",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "嗯。",
    "voice": "vo_adv_1076004_028",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n您說，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "被比自己年紀小的對象這樣稱呼是很常見的？",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "原來這是很平常的事呢，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "學到一課了。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "那麼……",
    "voice": "vo_adv_1076004_029",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n如您所願，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "請讓在下這樣稱呼。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "哥、",
    "voice": "vo_adv_1076004_030",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "…………",
    "voice": "vo_adv_1076004_031",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……那個，",
    "voice": "vo_adv_1076004_032",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "怎麼覺得非常的難為情。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "也許在下這麼說很任性，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n真的不能",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "稱呼您為主人嗎？",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_1076004_033",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n您說，稱呼主人也沒關係？",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人，謝謝您……♪",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人",
    "voice": "vo_adv_1076004_034",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "很溫柔呢。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "無論和誰說話",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "都常會令人感到困惑。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n主人卻",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不厭其煩地陪伴在下。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "今天也是，",
    "voice": "vo_adv_1076004_035",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "碰巧遇見就出聲",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "叫住了在下……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n還親身教導",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下游泳的方法。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n主人，在下真的很開心。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下",
    "voice": "vo_adv_1076004_036",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "絕對不會忘記今天的事情。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n就算變成老婆婆也好，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "死掉投胎轉世也好……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n這道光芒",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "會永遠留在在下的靈魂深處吧。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "希望有朝一日",
    "voice": "vo_adv_1076004_037",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "能回報您的恩情。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n即使現在還沒辦法，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "但等變成大人之後……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n無論在遙遠的未來",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "或下輩子，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "有朝一日一定會報答您的。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人，",
    "voice": "vo_adv_1076004_038",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "約定好了。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在心中發誓。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，",
    "voice": "vo_adv_1076004_039",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦你了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛剛看見的，是如同夢境一般的情景唷。",
    "voice": "vo_adv_1076004_040",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n醒來之後，大概就會全都忘光囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "看來這次是和大家一起來海邊玩，",
    "voice": "vo_adv_1076004_041",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n而回想起了這方面的回憶呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然你和小可可蘿，",
    "voice": "vo_adv_1076004_042",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n在「那裡」沒什麼交集……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但那時夏天你去了附近的泳池，",
    "voice": "vo_adv_1076004_043",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n好像正巧就碰到她了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然小可可蘿過著不尋常的生活，",
    "voice": "vo_adv_1076004_044",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不過這個時候已經正常地開始上小學了的樣子。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n然後，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "為了學校的游泳課好像一直練習著呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "多虧了你在這天",
    "voice": "vo_adv_1076004_045",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "教導她游泳的方法……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n讓小可可蘿在學校不會跟不上大家的進度，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n以不錯的狀態就這樣慢慢融入了班級的樣子。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "{0}，你做了很棒的事情嘛。",
    "voice": "vo_adv_1076004_046",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "了不起了不起♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "謝謝你喔，",
    "voice": "vo_adv_1076004_047",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "總是幫忙照顧小可可蘿……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為我的立場很難出手協助，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n只能在一旁焦慮地看著。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你能讓小可可蘿感到幸福，",
    "voice": "vo_adv_1076004_048",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真的幫了我大忙。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "總之……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然這種說法好像很奇怪，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就像是自己的事一樣感到開心，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真的很感謝你呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "謝謝你，{0}。",
    "voice": "vo_adv_1076004_049",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n可以的話，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "以後小可可蘿也拜託你多照顧囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……哎呀，不是悠閒聊天的時候呢。",
    "voice": "vo_adv_1076004_050",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n雖說是夏天，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在室外睡著的話還是容易感冒的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n快點起來。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "掰掰，{0}。",
    "voice": "vo_adv_1076004_051",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n下次在夢裡再會吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500162"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人、",
    "voice": "vo_adv_1076004_052",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_1076004_053",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n因為剛剛突然搖晃得很厲害，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就驚醒了……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人還好嗎，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有沒有哪裡覺得痛呢？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯嗯。",
    "voice": "vo_adv_1076004_054",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n您說好像有一瞬間，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "失去意識……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗎？",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人也累了呢，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下還是",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "自己走路吧。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然被主人抱著送回去，",
    "voice": "vo_adv_1076004_055",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感到感激又開心……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但身為嚮導，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "果然還是想拉著主人的手",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "引導您♪",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來吧主人，",
    "voice": "vo_adv_1076004_056",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "手牽著手一起出發吧。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "回到在下與主人的",
    "voice": "vo_adv_1076004_057",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "安居歸屬。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n然後充分地休息，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n明天和後天",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都好好地享受海水浴場的樂趣吧。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊，",
    "voice": "vo_adv_1076004_058",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是讓人興奮呢……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人♪",
    "voice": null,
