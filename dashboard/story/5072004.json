[
  {
    "type": "background",
    "bg_id": "501360"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "慈樂之音的三人自從開始籌辦夏日音樂會之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n時光飛逝，很快地距離演唱會已剩不到幾天了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好啦，",
    "voice": "vo_adv_5072004_000",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "今天也要繼續排練！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌、",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "紡希！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "打起精神來吧♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "接下來會越來越忙碌囉！",
    "voice": "vo_adv_5072004_001",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我們要做好所有能夠做的事，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "絕不妥協，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也毫無顧慮！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n一起打造出屬於我們的舞台吧♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "小望",
    "voice": "vo_adv_5072004_002",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真是幹勁十足哪……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "每次越接近演唱會，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "她的情緒就會愈發高漲。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "而這次似乎打從一開始就衝上了最高點。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不……",
    "voice": "vo_adv_5072004_003",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我想她的情緒",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "應該還沒達到頂峰吧。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "妳不覺得她這次可能會比以往都還來得起勁嗎？",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……這樣",
    "voice": "vo_adv_5072004_004",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "要跟上她的腳步可就辛苦了……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳們兩個！",
    "voice": "vo_adv_5072004_005",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "看起來活力不足喔？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "來吧",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "來吧，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我分點活力給妳們♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "好、",
    "voice": "vo_adv_5072004_006",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "好的！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我知道了，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "別再握著我的手揮來揮去了！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……呵呵。",
    "voice": "vo_adv_5072004_007",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊……",
    "voice": "vo_adv_5072004_008",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "很感激你的好意，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但我們不能接受。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "因為我們想讓",
    "voice": "vo_adv_5072004_009",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "{0}好好欣賞，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我們在準備就緒的舞台上，展現出的完美表現。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真不虧是千歌，",
    "voice": "vo_adv_5072004_010",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "說得好！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n{0}，敬請期待演唱會當天的演出吧。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們會為你準備好",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "特等席的♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那麼，",
    "voice": "vo_adv_5072004_011",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "到時候見囉♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一二三四！",
    "voice": "vo_adv_5072004_012",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一二三四！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "舞步稍微慢了喔！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n不要過度專注在歌唱上！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是！",
    "voice": "vo_adv_5072004_013",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一二三四！",
    "voice": "vo_adv_5072004_014",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一二三四！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n紡希，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "笑容再多一點！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n粉絲們可是會一直盯著我們看的喔！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是！",
    "voice": "vo_adv_5072004_015",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "關於表演曲目，",
    "voice": "vo_adv_5072004_016",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這首歌和這首歌",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要不要調換一下？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "快歌接連著唱，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "觀眾們可能會感到疲憊。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可是，",
    "voice": "vo_adv_5072004_017",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這樣一來，換裝的時間點……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我來想辦法調整。",
    "voice": "vo_adv_5072004_018",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n無論是幫忙脫衣服穿衣服還是綑綁，我都很在行。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "……綑綁？",
    "voice": "vo_adv_5072004_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "如何？",
    "voice": "vo_adv_5072004_020",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我將布料輕量化，穿起來比較不會悶熱，",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n這樣方便活動嗎？",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯。",
    "voice": "vo_adv_5072004_021",
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n沒有什麼問題……",
    "voice": null,
    "unit_id": 104212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯……",
    "voice": "vo_adv_5072004_022",
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "感覺動作若大一點似乎有點恐怖呢。",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "會不會舞跳得太起勁，",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "衣服就扯破了？",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "說得也是～",
    "voice": "vo_adv_5072004_023",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "小望",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "老是動來動去的……",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "容易拉扯到的地方，",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我會改換成更為牢固的布料。",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這次演唱會的規模大了許多，",
    "voice": "vo_adv_5072004_024",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "而且周遭都是大海……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "在沒有回音的情況下，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "希望可以讓歌聲盡可能地傳遠一點。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那要不要稍微調高",
    "voice": "vo_adv_5072004_025",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "歌的音量？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不，",
    "voice": "vo_adv_5072004_026",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "音量若再調高，麥克風就容易產生嘯聲，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n這樣更難讓粉絲們聽清楚",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們所唱的歌曲。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "正式上場時，我們就盡量大聲唱！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只要卯足全力歌唱，一定可以傳得遠！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……",
    "voice": "vo_adv_5072004_027",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "說得也是。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "唱歌這方面，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "本就不容許有任何妥協。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "background",
    "bg_id": "501361"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……啊，",
    "voice": "vo_adv_5072004_028",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "天色都變暗了……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "時間過得真快……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
