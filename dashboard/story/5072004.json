    "voice": "vo_adv_5072004_062",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那那那個！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n不好意思，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "海、",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "海邊出現了魔物！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "望、",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "望小姐她……！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "……！",
    "voice": "vo_adv_5072004_063",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501362"
  },
  {
