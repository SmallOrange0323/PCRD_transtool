    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "很好，",
    "voice": "vo_adv_5072004_065",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這樣都解決掉了！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "果然只要去做就能做到！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦！？",
    "voice": "vo_adv_5072004_066",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n糟了，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我漏掉了一隻──",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "background",
    "bg_id": "501362"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "！",
    "voice": "vo_adv_5072004_067",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "風之精靈啊，",
    "voice": "vo_adv_5072004_068",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n此刻，\\n寄宿於",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這首歌",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "之中吧……！",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "background",
    "bg_id": "501362"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊……",
    "voice": "vo_adv_5072004_069",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "大家……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "小望……",
    "voice": "vo_adv_5072004_070",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳這笨蛋！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n妳自己一個人",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "在做什麼啊！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "抱歉……",
    "voice": "vo_adv_5072004_071",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那位粉絲沒事吧？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳最擔心的是這個嗎？",
    "voice": "vo_adv_5072004_072",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……他沒有受傷，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我想應該沒事。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不如說在這之後，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "他才會被製作人狠狠教訓一頓吧。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這樣啊……",
    "voice": "vo_adv_5072004_073",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "太好了。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……妳說什麼太好了？",
    "voice": "vo_adv_5072004_074",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌……？",
    "voice": "vo_adv_5072004_075",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "馬上就要舉辦演唱會的偶像，",
    "voice": "vo_adv_5072004_076",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n竟然獨自一個人戰鬥，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就算是為了保護粉絲。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "妳不覺得",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這樣做很危險嗎？",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "萬一妳在這裡受了傷，",
    "voice": "vo_adv_5072004_077",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n可是會給許多人造成困擾的喔？",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……因為",
    "voice": "vo_adv_5072004_078",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要是放著不管，那名粉絲就會有危險，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "大家一起打造的舞台也會遭到破壞……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……這種事，",
    "voice": "vo_adv_5072004_079",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我絕不能……！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "「妳為何要一個人來呢？",
    "voice": "vo_adv_5072004_080",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "已經是妳的夥伴了吧？」",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……！",
    "voice": "vo_adv_5072004_081",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "望對於偶像的熱忱，",
    "voice": "vo_adv_5072004_082",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "想要認真唱好歌、",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "跳好舞",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "並且努力戰鬥的決心，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我很能夠理解。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "會不顧一切地一頭栽進去，",
    "voice": "vo_adv_5072004_083",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n就是妳的個性。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但是，",
    "voice": "vo_adv_5072004_084",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "妳至少應該要馬上來找我們，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……找妳口頭上稱之為夥伴的我們幫忙，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不是嗎？",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌……",
    "voice": "vo_adv_5072004_085",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "千歌",
    "voice": "vo_adv_5072004_086",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真的生氣了……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不同於我情緒發洩式的生氣，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n像千歌那樣",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "靜靜地發怒的類型，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "老實說是最恐怖的了……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就是說啊……",
    "voice": "vo_adv_5072004_087",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "千歌會生氣也是可想而知的。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n小望老是想獨自一人攬下所有的事。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "紡希……",
    "voice": "vo_adv_5072004_088",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "對不起，",
    "voice": "vo_adv_5072004_089",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "小望。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "讀了騎士先生所寫的訪談筆記。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我",
    "voice": "vo_adv_5072004_090",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這才明白，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳之所以想選定這個海邊當作演唱會開端的原因。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個是……",
    "voice": "vo_adv_5072004_091",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呃。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "小望，",
    "voice": "vo_adv_5072004_092",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳之前曾這樣對我說過吧。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "「妳如果有困難，",
    "voice": "vo_adv_5072004_093",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "儘管跟我們開口吧。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n因為我們都是同個團體的",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "夥伴啊。」",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "聽到這句話，",
    "voice": "vo_adv_5072004_094",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我真的很開心。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我心想",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這個人是真心需要我的。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "所以，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我也要好好努力來回應她的這份心意。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但是……",
    "voice": "vo_adv_5072004_095",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "在緊要關頭的時候，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳就不需要我了嗎？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "…………",
    "voice": "vo_adv_5072004_096",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "兩位，",
    "voice": "vo_adv_5072004_097",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我真的很抱歉──",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……彼此的歌聲要能夠交疊在一起，",
    "voice": "vo_adv_5072004_098",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "最重要的是團結一心。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "妳獨自硬扛下危機，",
    "voice": "vo_adv_5072004_099",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "卻要我們一同在眾多觀眾面前同聲歌唱……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……我是辦不到的。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "如果沒有十足的默契，",
    "voice": "vo_adv_5072004_100",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我們的舞也跳不成了。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "要是不能",
    "voice": "vo_adv_5072004_101",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "團結一心……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "等一下，",
    "voice": "vo_adv_5072004_102",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌、",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "紡希……！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "唔……！",
    "voice": "vo_adv_5072004_103",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "小望！？",
    "voice": "vo_adv_5072004_104",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n難道",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "在剛才的戰鬥中……！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不……",
    "voice": "vo_adv_5072004_105",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我沒事……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我沒有被直接攻擊到，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只是身體覺得有點麻麻的。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "更重要的是……！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這是……",
    "voice": "vo_adv_5072004_106",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "妳中了魔物的毒了。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳說中毒……",
    "voice": "vo_adv_5072004_107",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "她不要緊吧！？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯。",
    "voice": "vo_adv_5072004_108",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這是用恢復魔法就可以治療的毒，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我想應該沒有大礙，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n可以趕在演唱會之前恢復。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這也是個大好機會。",
    "voice": "vo_adv_5072004_109",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "妳就趁這機會",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "讓身體好好休息吧。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……可是",
    "voice": "vo_adv_5072004_110",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……明天還有很多準備工作……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "剩下的準備工作，",
    "voice": "vo_adv_5072004_111",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我和紡希會完成的。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊……！",
    "voice": "vo_adv_5072004_112",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": "vo_adv_5072004_113",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我知道了……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在演唱會前夕，慈樂之音三人的心思彼此擦肩而過。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n眼看距離夏日演唱會開唱的日子已經所剩無幾了──",
    "voice": null,
    "unit_id": null
  }
]
