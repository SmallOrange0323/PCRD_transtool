  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "如果會學習我和璃乃的行為，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n可能會很棘手呢。",
