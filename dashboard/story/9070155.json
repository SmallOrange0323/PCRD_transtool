[
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "唔唔……！",
    "voice": "vo_adv_9070155_000",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n這隻魔物怎麼會這麼凶暴……！",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "如果不靠闇影之力，",
    "voice": "vo_adv_9070155_001",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n實在是無法與其對抗……！",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "莉莉。",
    "voice": "vo_adv_9070155_002",
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n後面……！",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "呀啊……！",
    "voice": "vo_adv_9070155_003",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "──光之精靈啊！",
    "voice": "vo_adv_9070155_004",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和、怜",
    "words": "呀啊啊啊！！\\n喝啊啊啊啊！！",
    "voice": "vo_adv_9070155_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真是千鈞一髮呢……",
    "voice": "vo_adv_9070155_006",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "大家，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "都沒事吧？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是……",
    "voice": "vo_adv_9070155_007",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是的。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n真是非常抱歉，",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "【破曉之星】的各位。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n像這樣陷入危機中勞煩各位拯救，",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我們實在是無地自容……",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "別在意，",
    "voice": "vo_adv_9070155_008",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有困難的時候",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就要互相幫助幫助！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但是，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳們在這種地方做什麼？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我們，",
    "voice": "vo_adv_9070155_009",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是作為冒險者",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "前來調查吉歐‧格黑納的。",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……還有，",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "同時也在訓練不靠闇影之力來戰鬥。",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "武者修行──",
    "voice": "vo_adv_9070155_010",
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "的意思。",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "原來是這樣！",
    "voice": "vo_adv_9070155_011",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們是",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "接下了討伐魔物的委託過來的……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "目標對象，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "似乎不是這隻魔物耶？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊，",
    "voice": "vo_adv_9070155_012",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "牠的特徵跟接下委託時聽到的不太一樣……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n雖然「總之非常巨大」、",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "「像龍一樣的鱗片」",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是有一致。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "卻沒有「巨大的背鰭」。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是這樣嗎？",
    "voice": "vo_adv_9070155_013",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那麼",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "被委託討伐的魔物會在哪裡……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "是那裡的，",
    "voice": "vo_adv_9070155_014",
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "那個嗎？",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "巨大怪獸",
    "words": "嘎喔喔喔喔喔────！！",
    "voice": null,
    "unit_id": 50511
  },
  {
    "type": "dialogue",
    "name": "日和、優衣、怜",
    "words": "就是那個──────！？",
    "voice": "vo_adv_9070155_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那就是討伐目標……",
    "voice": "vo_adv_9070155_016",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "等",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "等，",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "會不會太大了點！？",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "快要跟蘭德索爾的城堡一樣大了吧……！？",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "感覺突然就要挑戰頭目了呢！",
    "voice": "vo_adv_9070155_017",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好像有點熱血起來了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊，",
    "voice": "vo_adv_9070155_018",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們的力量在背面世界是否也能行得通……",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n正好能拿牠當對象試一試。",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "咦咦？",
    "voice": "vo_adv_9070155_019",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n各位，",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "難道打算就這樣正面迎擊嗎！？",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "這簡直就是",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "螳臂當車、",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "暴虎馮河啊……",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "若想要進一步調查，",
    "voice": "vo_adv_9070155_020",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那隻魔物也會成為阻礙吧？",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "在這裡為了彼此的目的，",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要是妳們也能協助我們就幫大忙了。",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "沒錯沒錯～！",
    "voice": "vo_adv_9070155_021",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "而且",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "現在還有我們能一起戰鬥！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不管是委託還是武者修行，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "都一起努力",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "克服萬難吧──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我的魔法一定會好好保護大家的。",
    "voice": "vo_adv_9070155_022",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n所以……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "【幻變少女】少女的各位",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "也能幫幫我們嗎？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "好、",
    "voice": "vo_adv_9070155_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "好的！\\n嗯。",
    "voice": null,
    "unit_id": null
  }
]
