[
  {
    "type": "movie",
    "movie_id": "210100001"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "企圖對世界進行變革的霸瞳皇帝，被一名無名英雄給打倒了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "被所有人忘卻了的少女‧貪吃佩可\\n在取回了她的名字『尤絲蒂亞娜』後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "同時也取回了王女的身分……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "而在那一天過後，時間輾轉過了一個月。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "母親、少女",
    "words": "呀啊啊啊！",
    "voice": "vo_adv_2101001_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人！",
    "voice": "vo_adv_2101001_001",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n一塊上吧！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "――哈啊！",
    "voice": "vo_adv_2101001_002",
    "unit_id": 105911
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "嘎哦哦哦哦……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "嗯、",
    "voice": "vo_adv_2101001_003",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "嗯！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n謝謝你們，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "大哥哥、",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "大姐姐！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "非、",
    "voice": "vo_adv_2101001_004",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "非常感謝你們……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n感謝你們……！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……竟然就連距離蘭德索爾並未有多遠的道路上，",
    "voice": "vo_adv_2101001_005",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n都仍還有魔物於此處徘徊。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "果然\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "【王宮騎士團】的人手不足之問題仍然相當嚴重呢。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……兩位。",
    "voice": "vo_adv_2101001_006",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下等人是",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "蘭德索爾的冒險者，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n目前則是在運送貨物的工作歸途上。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "若兩位不介意，",
    "voice": "vo_adv_2101001_007",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要不要一同搭乘馬車呢？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n運客的業者，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下等人會負責向對方解釋清楚的……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "background",
    "bg_id": "500320"
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "……真的非常謝謝你們的幫忙。",
    "voice": "vo_adv_2101001_008",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "因為前陣子那場魔物的騷動，所以離開了蘭德索爾，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "並且在位於鄉下的故鄉中暫住了一陣子……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "「城裡已經安全了，",
    "voice": "vo_adv_2101001_009",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "重建也很順利。」",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n因為丈夫在送來的信中這樣寫道。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n所以我才帶著孩子，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "正在回去的路上。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是辛苦您了。",
    "voice": "vo_adv_2101001_010",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過還請您安心。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "正如您丈夫在信中所述，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n當下",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "蘭德索爾已重回了和平，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並且在重建上也充滿了生氣。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下與在下的主人，",
    "voice": "vo_adv_2101001_011",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "最近這陣子",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n也在幫忙重建的相關事宜。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n今日，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "便是向那熟識的牧場",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "遞送著食品的訂單",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "與資材費用……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "哥哥，",
    "voice": "vo_adv_2101001_012",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "我們來玩吧～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "嘿、",
    "voice": "vo_adv_2101001_013",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "不行……！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "對不起唷，這位哥哥。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n這孩子就是活潑了一點……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "來玩吧，",
    "voice": "vo_adv_2101001_014",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "來玩吧～♪",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……主人，",
    "voice": "vo_adv_2101001_015",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您的身體還行嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您才經歷了場戰鬥，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "應該還很疲憊才……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……",
    "voice": "vo_adv_2101001_016",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……從與霸瞳皇帝決戰的那天算起，",
    "voice": "vo_adv_2101001_017",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "約莫過了一個月。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人所受的傷，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "本該是全都治好了才是……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……然而從那一日以來，",
    "voice": "vo_adv_2101001_018",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n主人似乎就偶爾",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "會有劇烈暈眩的樣子。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而似乎是為了不讓在下擔心，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以都不怎麼表現出來就是了……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "話說回來，",
    "voice": "vo_adv_2101001_019",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "你們還真是了不起呢。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "明明還沒有多少年紀，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "就能像這樣兩個人一起出來工作了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下等人僅是",
    "voice": "vo_adv_2101001_020",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n為了賺取自己的生活費，因此才會承接工作而已……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "然而依舊非常感謝您的稱讚。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "前陣子與主人一同暫時叨擾的",
    "voice": "vo_adv_2101001_021",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "【咲戀育幼院】，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n最近也為了收容失去雙親的孩子們，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以面臨著相當的困境。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為了回報她們，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "因此才會需要一些資金。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "然而……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……主人。",
    "voice": "vo_adv_2101001_022",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您畢竟才受過腹部被開了個大洞如此這般的重傷……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下認為，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人您還是該好好安養歇息才是。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n資金的方面，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就由在下來負責賺取便是……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人……",
    "voice": "vo_adv_2101001_023",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您方才戰鬥的模樣，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真的是變得相當可靠了呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……啊，",
    "voice": "vo_adv_2101001_024",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不好。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "明明知道得讓主人",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好好保重身體的才是……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "然而能與主人兩人這樣同行，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "卻也同時感受到了無比的喜悅……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……但",
    "voice": "vo_adv_2101001_025",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……不知為何。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "於在下的心中……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總是有種難以言喻的不安逐漸蔓延。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下最喜愛的，",
    "voice": "vo_adv_2101001_026",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那帶給人溫暖又溫柔的主人……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n似乎會就此離去……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n如此這般悲傷的預感，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總是在腦海裡揮散不去……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "……",
    "voice": "vo_adv_2101001_027",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "咦～？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n欸欸，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "那個是什麼～？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "still",
    "still_id": "210100101"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……？",
    "voice": "vo_adv_2101001_028",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n從索爾之塔的上空，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感受到了魔力的波動……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那是……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "空中",
    "voice": "vo_adv_2101001_029",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有個女孩子……！？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "咦咦，",
    "voice": "vo_adv_2101001_030",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "為什麼～！？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "她似乎失去了意識……",
    "voice": "vo_adv_2101001_031",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n再這麼下去她將會摔到地面上的，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "相當危險！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "210100102"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人！？",
    "voice": "vo_adv_2101001_032",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請您振作一點，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人……！",
    "voice": null,
    "unit_id": 105913
  },
