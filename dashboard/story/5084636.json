  {
    "type": "dialogue",
    "name": "栞",
    "words": "{0}……\\n你一直沉睡著呢。",
    "voice": "vo_adv_5084636_000",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我因病臥床的時候，",
    "voice": "vo_adv_5084636_001",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊是不是這種心情呢？",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "明明擔心得不得了，",
    "voice": "vo_adv_5084636_002",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "卻什麼也無法做……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不對，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "一定為我做了她所能做到的事吧。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "{0}",
    "voice": "vo_adv_5084636_003",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "為我做了許多事。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我想稍微回報你。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我會為你做我所能做到的事。",
    "voice": "vo_adv_5084636_004",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "要是你醒過來了，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "只要稍微稱讚我一下就好，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我會很開心的。",
    "voice": null,
    "unit_id": 103813
  }
