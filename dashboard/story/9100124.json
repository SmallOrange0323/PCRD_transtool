[
  {
    "type": "background",
    "bg_id": "501630"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生！",
    "voice": "vo_adv_9100124_000",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "索爾魔珠，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "已經找回七個了喔。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n還剩下",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "一個……！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "拍手拍手拍手拍手……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "哎呀這真是……",
    "voice": "vo_adv_9100124_001",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "超乎想像。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n沒想到你們能抗戰至此。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "剩下的一個──",
    "voice": "vo_adv_9100124_002",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "我手中的這個索爾魔珠如果也被奪走，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n這個巨神將失去作為容器的功能，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n厄莉絲小姐",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "也將無法使用米奈娃的力量……",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣一來，",
    "voice": "vo_adv_9100124_003",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就是我們的勝利了……！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯。",
    "voice": "vo_adv_9100124_004",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n湊齊索爾魔珠的話，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就能通往索爾之塔的塔頂了……！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "彌勒！",
    "voice": "vo_adv_9100124_005",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n快點死心，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "把最後的索爾魔珠交出來！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不然宰了你喔！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "很遺憾。",
    "voice": "vo_adv_9100124_006",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n我",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "還不能消失呢。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "反倒──",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "是時候",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "該收下你們的靈魂了。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊……",
    "voice": "vo_adv_9100124_007",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "魔、",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "魔物從地上",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "冒出來了！？",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不……",
    "voice": "vo_adv_9100124_008",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不只是從地上，",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "牆上和天花板也是……！",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "現在的終炎巨神",
    "voice": "vo_adv_9100124_009",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "是充滿了龐大魔力的容器──",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n將它的身體組織分離出來的話，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "要多少隻魔物就能生成多少隻。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這是，",
    "voice": "vo_adv_9100124_010",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "幾百隻……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不、",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不是……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n是幾千隻吧……！？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "即使和其他人聯手，",
    "voice": "vo_adv_9100124_011",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n這個數量也是打不完啊……！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "呵呵呵……",
    "voice": "vo_adv_9100124_012",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "那麼，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "就留在這裡和魔物一起滴血不留地被啃食殆盡吧。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n不……",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "說來你們全部人",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "都已經在肚子裡了呢。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "那麼，",
    "voice": "vo_adv_9100124_013",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "再會。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n之後我會來迎接",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "失去角色、只剩下靈魂的你們。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "呵呵呵、",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "哈哈哈哈……！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個傢伙……！！",
    "voice": "vo_adv_9100124_014",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n一開始就打算這麼做了吧──！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "凱留，",
    "voice": "vo_adv_9100124_015",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "現在不是生氣的時候……！",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我們完全被包圍了……！！",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "！",
    "voice": "vo_adv_9100124_016",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "快到在下身後──",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "──不！",
    "voice": "vo_adv_9100124_017",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n現在立刻到我身後！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "全部人都過來！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哇！？",
    "voice": "vo_adv_9100124_018",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你是……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那個、",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "太吾！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "是大吾！",
    "voice": "vo_adv_9100124_019",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "都這種時候了別讓我吐槽啦！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "喝啊！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "去吧，本大爺的",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "超級無敵厲害結界！！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──嘎喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "把魔物彈開了！？",
    "voice": "vo_adv_9100124_020",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "魔物無法進入這個結界呢……！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "嗯，",
    "voice": "vo_adv_9100124_021",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "千鈞一髮呢……！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "真是",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "膽顫心驚啊。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "多虧了拉基拉基啊！",
    "voice": "vo_adv_9100124_022",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n找他幫忙是正確的決定！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你們……",
    "voice": "vo_adv_9100124_023",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n在這個時間點空間跳躍過來嗎？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎麼一回事啊！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "菲歐在下面吵鬧不休啊。",
    "voice": "vo_adv_9100124_024",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "已經沒有救兵，陷入大危機了──",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "她是這樣說的。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n所以我們直接",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "用空間跳躍過來救援！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "真是的……！",
    "voice": "vo_adv_9100124_025",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "跑到敵人的肚子裡什麼的，",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n很明顯就是個陷阱不是嗎！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "至少也準備個後路吧蠢蛋！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "大吾，",
    "voice": "vo_adv_9100124_026",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "現在沒有時間說教了喔？",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n身為最後的救兵得趕緊動作了……！",
    "voice": null,
