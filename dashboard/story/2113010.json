    "name": "尾狗刀",
    "words": "……呼……",
    "voice": "vo_adv_2113010_000",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "……",
    "voice": "vo_adv_2113010_001",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "沒人監視，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "也沒有追兵……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "……唉～",
    "voice": "vo_adv_2113010_002",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "真是累死人啦～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "……雖然",
    "voice": "vo_adv_2113010_003",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我是擅長駭入啦，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n但是要我對放在「這裡」的自動角色，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n從裡面暫時開啟",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "一條通路……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "受不了，",
    "voice": "vo_adv_2113010_004",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "有夠會使喚人的。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n這種部分",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "真是有像七冠呢──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不過，",
    "voice": "vo_adv_2113010_005",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "即便是「長老」，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n在兩手拿著要給女兒的伴手禮的情況下，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n也很難從外部連過來啦……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "…………",
    "voice": "vo_adv_2113010_006",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "好了……",
    "voice": "vo_adv_2113010_007",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n總之，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "已經處理完真正長老的委託，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n也取得「那裡」的情報了。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "……厄莉絲的問題，",
    "voice": "vo_adv_2113010_008",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n看來只能交給那位龍人族的小姐解決……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "這部分",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "就只能請她加油了。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "……那麼，",
    "voice": "vo_adv_2113010_009",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n在輪到我最後的登場之前，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "先好好休息一下吧。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "…………\\n……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501205"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "稍早之前──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n取得最後一顆索爾魔珠的【美食殿堂】",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "離開了精靈族之村。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n接著，來找和可可蘿道別完，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "等待著消滅的嚮導老君的人是──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……呵呵♪",
    "voice": "vo_adv_2113010_010",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真是不好意思呀？",
    "voice": "vo_adv_2113010_011",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n非常謝謝你",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "留了時間給我，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n「嚮導老君」。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "still",
    "still_id": "211301001"
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "妳是，",
    "voice": "vo_adv_2113010_012",
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "\\n「她」的……",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵，",
    "voice": "vo_adv_2113010_013",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們是朋友",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "已經是過去式了～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "現在我跟她",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "目的也不一樣，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n從「這裡」也不知道",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "她在做什麼～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "「她」",
    "voice": "vo_adv_2113010_014",
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "趁著WISDOM確定解散的時候，",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "離開了我們。",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "\\n現在立場",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "跟我們處在對立的狀態下。",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "廢除……",
    "voice": "vo_adv_2113010_015",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是斷尾求生嗎～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n很像聯合國會做的事情呢～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n所以說，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "「那裡」已經設立後繼的新組織了吧～？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "正是。",
    "voice": "vo_adv_2113010_016",
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "\\n只不過這次",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "不是保護團體，",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "\\n而是「網路監理團體」。",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不是Conservation，",
    "voice": "vo_adv_2113010_017",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "而是Supervision啊～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "雖說限制與放任就像鐘擺一樣會不停擺盪，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n但外頭的情況",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "果然也變得令人好心寒呢～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "只盯著眼前的現象，",
    "voice": "vo_adv_2113010_018",
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "\\n才會認為現況動盪。",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "若以綜觀森林的視野，",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "便可察覺",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "真正被困住的究竟為何者吧。",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "哇～",
    "voice": "vo_adv_2113010_019",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你好達觀哦～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "明明你實際的歲數",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "可沒那麼老耶～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還是說，",
    "voice": "vo_adv_2113010_020",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那個傳聞是真的呢～？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "12年前的你……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "若妳有事，",
    "voice": "vo_adv_2113010_021",
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "請簡潔扼要地說明。",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "我能留在這裡的時間",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "已經所剩無幾了。",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "啊，",
    "voice": "vo_adv_2113010_022",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n說得也是～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我會來找你～",
    "voice": "vo_adv_2113010_023",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n是希望你可以，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n借我一點～點",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你的力量。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "啊，",
    "voice": "vo_adv_2113010_024",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n你想問我",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是要用來做什麼的嗎～？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "──我想問的",
    "voice": "vo_adv_2113010_025",
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "反而是動機。",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "\\n為何",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "要去挑戰不可能的事？",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "哎呀～討厭啦～",
    "voice": "vo_adv_2113010_026",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我好歹也是遊戲玩家～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "看到太刁鑽的遊戲",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就是會想攻略一下啊～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過，",
    "voice": "vo_adv_2113010_027",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我心裡也有",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "單純看不慣",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "「那個」的想法啦～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "至於謝禮，",
    "voice": "vo_adv_2113010_028",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我想想……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就讓可可蘿",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "可以平安地回去，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "怎麼樣──？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "這提議很吸引人，",
    "voice": "vo_adv_2113010_029",
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "但相信我的孩子與友人們，",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "一定會靠自己雙腳步向未來。",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "哈哈☆",
    "voice": "vo_adv_2113010_030",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n就知道你會這麼說～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n……呵呵，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真不知道你是過度保護呢，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還是嚴厲呢～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "……嗯。",
    "voice": "vo_adv_2113010_031",
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "從整個層面來看，",
    "voice": "vo_adv_2113010_032",
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "我應該適合被稱為傻父親吧。",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "\\n等結束與你的對談後，",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "我打算為",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "實現女兒的願望而行動。",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這樣啊──",
    "voice": "vo_adv_2113010_033",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我剛才",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "用「龍眼」偷看了一下……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n要實現這件事",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "似乎會非常辛苦哦～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "弄個不好，",
    "voice": "vo_adv_2113010_034",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "很有可能會跟那邊的世界整個為敵吧～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "不必擔心我。",
    "voice": "vo_adv_2113010_035",
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "\\n若要比程度，",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "妳的打算不也相當困難嗎？",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "然而，",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "即便如此──",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "若妳仍想追求",
    "voice": "vo_adv_2113010_036",
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "能超越「厄莉絲」的力量，",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "\\n我就向妳指出",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "那條等同於不可能的道路吧。",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "dialogue",
    "name": "佐拉",
    "words": "\\n以我作為嚮導老君的身分。",
    "voice": null,
    "unit_id": 107211
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "…………\\n……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501820"
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "……",
    "voice": "vo_adv_2113010_037",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "……唉。",
    "voice": "vo_adv_2113010_038",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "──美空小姐。",
    "voice": "vo_adv_2113010_039",
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "…………",
    "voice": "vo_adv_2113010_040",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "妳好，",
    "voice": "vo_adv_2113010_041",
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "我找妳找好久了。",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "你大可不必找我啊──",
    "voice": "vo_adv_2113010_042",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "而且我也不覺得好──",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "哎呀，",
    "voice": "vo_adv_2113010_043",
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n心情還是沒有好轉嗎？",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n真傷腦筋。",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "是啊──",
    "voice": "vo_adv_2113010_044",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "因為現在的我",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "是個敗犬──",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "話說……",
    "voice": "vo_adv_2113010_045",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n可以請你別裝成",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "很關心我的樣子嗎？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "反正你又不是真心覺得傷腦筋。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "呵呵──",
    "voice": "vo_adv_2113010_046",
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "先不談妳心情好不好。",
    "voice": "vo_adv_2113010_047",
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n看來現在已進展到最後的局面了。",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "我也不得不請我們這裡的主角登場──",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "……畢竟厄莉絲大人",
    "voice": "vo_adv_2113010_048",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "不斷使用著力量──",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n我想暫時應該還很困難吧？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "話說，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我跟你",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "也都還在借用她的力量呢。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "是啊。",
    "voice": "vo_adv_2113010_049",
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n所以首先，",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "為了讓她能發揮真正的力量……",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n發動「重置」所需的條件，",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "目前並沒有達成。",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "話是這麼說──",
    "voice": "vo_adv_2113010_050",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n但殺了騎士同學",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "或是優衣其中一個，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n會連厄莉絲大人自己",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "也無法阻止「重置」吧？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "是啊，",
    "voice": "vo_adv_2113010_051",
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "所以雖然至今為止，",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "這主要是靠霸瞳皇帝來觸發……",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "……呵呵。",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "美空小姐",
    "voice": "vo_adv_2113010_052",
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "也知道吧？",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n除了讓公主騎士的少年，",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "或是草野優衣小姐死掉之外──",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n還有其他",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "能觸發「重置」的方法。",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "唉……",
    "voice": "vo_adv_2113010_053",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "真受不了彌勒先生。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n你是要我",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "去當壞孩子嗎──？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "那種事大可拜託尾狗刀先生去做就好了啊。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "尾狗刀先生",
    "voice": "vo_adv_2113010_054",
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "已經不會回來了吧。",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n他在精靈族之村似乎沒有取得索爾魔珠，",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n還失去戰力而撤退了。",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "你透過「再生怪物」",
    "voice": "vo_adv_2113010_055",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "偷看了吧。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n品味真低級──",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "嗯，",
    "voice": "vo_adv_2113010_056",
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "因為我本來就沒指望他啊。",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "──雖然能得知新的超能力者在哪裡，",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "是很大的收穫……",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "不過現在",
    "voice": null,
    "unit_id": 192611
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "這件事並不緊要。",
    "voice": null,
