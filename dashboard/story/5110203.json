[
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "看招！",
    "voice": "vo_adv_5110203_000",
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "天樓霸斷劍！",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喝啊──！",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "樂園守護者",
    "words": "──嘰喔喔喔！",
    "voice": null,
    "unit_id": 17111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "呼～",
    "voice": "vo_adv_5110203_001",
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這樣就行了，",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯！",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "話說回來，妳們兩位",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真的很強呢！",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啥？",
    "voice": "vo_adv_5110203_002",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "都什麼時候了，才在說這個……",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "因為",
    "voice": "vo_adv_5110203_003",
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "之前都是跟城鎮居民對戰，",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n根本沒機會看到妳們認真戰鬥的模樣！",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不管是戰鬥偶像還是打手，",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "果然都不是隨口瞎掰的！",
    "voice": null,
    "unit_id": 125014
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這個嘛，",
    "voice": "vo_adv_5110203_004",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為戰鬥也是【慈樂之音】的重要工作啊！",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我要是認真起來，可不是只有這樣。",
    "voice": "vo_adv_5110203_005",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "等這場騷動結束後，我們來交手比試一下吧。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n如果是矛依未，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "應該可以打場讓人熱血沸騰的架呢！",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": "vo_adv_5110203_006",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這些就等一切全都結束後再說吧。",
    "voice": null,
    "unit_id": 124811
  }
]
