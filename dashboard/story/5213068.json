    "name": "萊拉耶爾",
    "words": "吉歐‧提格尼亞的特產，",
    "voice": "vo_adv_5213068_000",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "可不只有甜點而已喔。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這種氣泡奶油，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "最大的特色就是在口中彈跳迸裂的口感。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這次就用這個，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "來做做看刺激感十足的甜點吧。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我以前，",
    "voice": "vo_adv_5213068_001",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "也很怕這種氣泡的口感，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "所以一直敬而遠之……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不過最近開始能食用了，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "也漸漸明白它的妙處。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "請客人好好享受",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這份大人的滋味吧。",
    "voice": null,
    "unit_id": 126511
  }
]
