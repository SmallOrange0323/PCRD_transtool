  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]在跳蚤市場的活動檔期快結束的某天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n吉塔和{0}來到會場後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n便看到攤販不多的廣場角落聚集著人潮。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "[FFFFFFFF]大家，",
    "voice": "vo_adv_5118065_000",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "[FFFFFFFF]準備好了沒！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "[FFFFFFFF]\\n第一屆跳蚤市場格鬥大會，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "武器店",
    "words": "[FFFFFFFF]開始────！！！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "參加者們",
    "words": "[FFFFFFFF]喔────！！！",
    "voice": "vo_adv_5118065_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]格鬥大會？",
    "voice": "vo_adv_5118065_002",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n雖說是在廣場的角落，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]但怎麼挑這種地方舉辦？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]嗯～？",
    "voice": "vo_adv_5118065_003",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]啊～{0}～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]嗨呵～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]你也要參加嗎～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]你也認識她嗎？",
    "voice": "vo_adv_5118065_004",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]……我說你，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]跟你要好的女孩子會不會太多了點？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]雖然，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]這跟我沒關係啦？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]透過{0}介紹，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n吉塔和香織互相打招呼。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]所以……",
    "voice": "vo_adv_5118065_005",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n香織要參加這個大會嗎？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n這是怎樣的大會？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]說真的～？",
    "voice": "vo_adv_5118065_006",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]\\n我也不太清楚啊～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]我看氣氛炒得很熱，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]才跑來看看的～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "[FFFFFFFF]怎麼？",
    "voice": "vo_adv_5118065_007",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "[FFFFFFFF]你們不知道嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "[FFFFFFFF]那我來說明吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "[FFFFFFFF]這是武器店老闆主辦的格鬥大會！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "[FFFFFFFF]\\n似乎有確實獲得國家的許可喔。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "[FFFFFFFF]規模雖小，",
    "voice": "vo_adv_5118065_008",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "[FFFFFFFF]冠軍卻可以獲得老闆自豪的裝備。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "[FFFFFFFF]\\n加上參加也不用錢！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "[FFFFFFFF]\\n假如對自己身手有信心，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "[FFFFFFFF]不參加說不過去啊！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]是喔～",
    "voice": "vo_adv_5118065_009",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]聽起來很有趣呢～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]果然參加大會是對的啊～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]……我、",
    "voice": "vo_adv_5118065_010",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]我也要參加！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]既然有厲害的人參加，",
    "voice": "vo_adv_5118065_011",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]我想這會是個不錯的經驗……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]而且，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]搞不好會像之前一樣，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]在身上沒有劍的時候遭遇戰鬥。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]我也得鍛鍊一下格鬥技，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]這也是修行啊！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]就這麼決定了～♪",
    "voice": "vo_adv_5118065_012",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]主辦人～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "[FFFFFFFF]還有一個人要報名啊～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]就這樣，吉塔和香織兩人參加格鬥大會，",
