    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n順利在淘汰賽中晉級──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n並在決賽中對上了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500033"
  },
  {
