[
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "哼，",
    "voice": "vo_adv_5050321_000",
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "像妳們這等傢伙",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "可沒有資格當我的對手啊。",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "鬼魂教父",
    "words": "\\n妳們的對手是它們。",
    "voice": null,
    "unit_id": 14011
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "唔，",
    "voice": "vo_adv_5050321_001",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "出現那麼多敵人還真麻煩。",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果被敵人數量牽制就危險了，",
    "voice": "vo_adv_5050321_002",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n一起合作打倒它們吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "馬修",
    "words": "我們也會幫忙的！",
    "voice": "vo_adv_5050321_003",
    "unit_id": 5712
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "現在的我們",
    "voice": "vo_adv_5050321_004",
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "休茲",
    "words": "可不會輸給這種傢伙！",
    "voice": null,
    "unit_id": 5912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "如果是現在的我們，",
    "voice": "vo_adv_5050321_005",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "一定能夠展現默契十足的聯手攻擊！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "立刻將它們收拾乾淨吧！！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "鬼怪們",
    "words": "喔──！！",
    "voice": "vo_adv_5050321_006",
    "unit_id": null
  }
]
