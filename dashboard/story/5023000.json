    "voice": "vo_adv_5023000_010",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不可以，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那是曼德拉草……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n一拔起來就會發出很大的叫聲――",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呀！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "指引客2",
    "words": "妳、",
    "voice": "vo_adv_5023000_011",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "指引客2",
    "words": "妳沒事吧導遊小姐！？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "指引客2",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "指引客2",
    "words": "對不起～",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "指引客2",
