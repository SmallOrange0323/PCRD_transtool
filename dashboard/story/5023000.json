  {
    "type": "dialogue",
    "name": "碧",
    "words": "是有聽過……",
    "voice": "vo_adv_5023000_019",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是城鎮裡的學校",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒錯吧？",
