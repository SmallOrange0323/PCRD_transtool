    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "的……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "background",
    "bg_id": "500190"
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "歡迎回家，",
    "voice": "vo_adv_5023000_013",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "小碧。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "導遊的工作如何？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "唉……",
    "voice": "vo_adv_5023000_014",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這對我來說還是太……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "會嗎？",
    "voice": "vo_adv_5023000_015",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "剛剛的客人",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "說她很感謝小碧妳喔？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……是，",
    "voice": "vo_adv_5023000_016",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不過，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "像我這樣不擅長和人交談的人，",
