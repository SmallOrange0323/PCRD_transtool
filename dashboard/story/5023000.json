    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是這樣嗎？　",
    "voice": "vo_adv_5023000_027",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我覺得這是一個很好的機會。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n為了能讓小碧妳",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "稍微地",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "鼓起勇氣。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒問題的。",
    "voice": "vo_adv_5023000_028",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
