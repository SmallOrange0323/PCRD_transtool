    "type": "dialogue",
    "name": "碧",
    "words": "……呃，",
    "voice": "vo_adv_5023000_024",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "難不成？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "所以，我打算讓小碧，",
    "voice": "vo_adv_5023000_025",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
