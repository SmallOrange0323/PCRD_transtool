    "voice": "vo_adv_5023000_021",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n就算短期入學也沒關係，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "他們希望我們能",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "安排一個女孩插班入學。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……？",
    "voice": "vo_adv_5023000_022",
    "unit_id": 104011
  },
