    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "等等！　",
    "voice": "vo_adv_7013004_033",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "如果我在這裡還偷懶的話",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就真的成了一個沒用的獸人了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我也來助陣吧！　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "來吧，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你也一起來！",
    "voice": null,
    "unit_id": 102611
  },
