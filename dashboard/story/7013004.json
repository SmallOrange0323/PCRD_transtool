[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在鈴的指示之下，一行人一邊各種策略性地休息，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一邊攀登著露娜之塔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n原本以為美冬會受不了反反覆覆的休息，沒想到——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "鈴，",
    "voice": "vo_adv_7013004_000",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是不是差不多要休息了？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "從剛剛的魔物經過之後",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "又過了蠻長一段時間吧？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦？　",
    "voice": "vo_adv_7013004_001",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "說的也是。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對吧！",
    "voice": "vo_adv_7013004_002",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n按照目前為止的休息頻率來看，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "應該差不多又要休息了吧！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯……",
    "voice": "vo_adv_7013004_003",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "說的也是！　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那就來休息吧！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊、",
    "voice": "vo_adv_7013004_004",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那裡有個適合藏身的遮蔽處！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們去那裡休息吧！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好耶！　",
    "voice": "vo_adv_7013004_005",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我們在這裡慢慢休息吧！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你在說什麼啊。",
    "voice": "vo_adv_7013004_006",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不是說好要聽從鈴的指示嗎？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "托鈴的福，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們一路上都沒有跟魔物戰鬥就得以來到這裡。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "雖然我一開始也抱有疑問，",
    "voice": "vo_adv_7013004_007",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不過這種做法也相當有效率呢。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n雖然有點花時間，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但考慮到安全問題，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我感覺這是最佳的做法。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "雖然和我本來的想法完全相反，",
    "voice": "vo_adv_7013004_008",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不過被單一想法束縛",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n反而是一種缺乏效率的行為。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "得經常保持在最佳的狀態才行。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "沒錯沒錯，",
    "voice": "vo_adv_7013004_009",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "並不是只有辛勤工作才算是工作唷。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不努力工作，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "也是一種工作呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真是深奧啊，",
    "voice": "vo_adv_7013004_010",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "鈴！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯嗯，",
    "voice": "vo_adv_7013004_011",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我們就按照這個步調",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "一邊多做休息一邊前進……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "怎麼了？",
    "voice": "vo_adv_7013004_012",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呃，",
    "voice": "vo_adv_7013004_013",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那個、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然有點難以啟齒……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過我感覺到了一大群魔物的氣息……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦？　",
    "voice": "vo_adv_7013004_014",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我完全沒有感覺到啊……？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "牠們還遠在只有獸人才能感知到的地方，",
    "voice": "vo_adv_7013004_015",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n不過確實是",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "朝著這裡過來了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "所以又要躲起來等牠們經過嗎？",
    "voice": "vo_adv_7013004_016",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然我也很想這麼做，",
    "voice": "vo_adv_7013004_017",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n不過以這個數量來看，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "如果不想戰鬥",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "恐怕就只能逃了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣啊……",
    "voice": "vo_adv_7013004_018",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好不容易來到這裡卻要回頭，真是可惜。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "對、",
    "voice": "vo_adv_7013004_019",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "對不起……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n都是因為我太得意一直休息才會這樣……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你在說什麼啊。",
    "voice": "vo_adv_7013004_020",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "鈴妳一點錯也沒有。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "事實上",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們也因此避免了許多與魔物間的戰鬥啊。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "如果妳真的只是在偷懶的話，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我也會生氣的。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦？",
    "voice": "vo_adv_7013004_021",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "其實，",
    "voice": "vo_adv_7013004_022",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我一直偷偷在計算",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "休息所帶來的效益比例。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們幾乎沒有任何無謂的休息。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "「幾乎」",
    "voice": "vo_adv_7013004_023",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "的意思就是說",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "果然還是有少部分是在浪費時間呢……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不！",
    "voice": "vo_adv_7013004_024",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n如果再加上恢復體力這個觀點來看，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可說是完全沒有任何多餘的休息！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n托妳的福，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那種程度的魔物群，我應該能全部打倒！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "可是，",
    "voice": "vo_adv_7013004_025",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "數量真的很多耶？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就算是美冬也……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "以我來說，我可是休息又再休息，",
    "voice": "vo_adv_7013004_026",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "體力可說是十分充沛呢！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n正好藉此來運動一下！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "運、",
    "voice": "vo_adv_7013004_027",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "運動？　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "和魔物戰鬥是運動嗎？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然我不是很懂妳說的話……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過，謝謝妳。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我去去就來。",
    "voice": "vo_adv_7013004_028",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "來吧！　",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "儘管上吧！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就讓我把剛剛的鬱悶，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "一掃而空吧！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我要上囉～～！",
    "voice": "vo_adv_7013004_029",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……咦？",
    "voice": "vo_adv_7013004_030",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n難不成美冬她",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "其實只是想大鬧一場而已？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不對，",
    "voice": "vo_adv_7013004_031",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你這說法太奇怪了吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n這不是用來描述戰鬥的吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過她本人很開心就算了……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "也就是所謂的工作狂？　",
    "voice": "vo_adv_7013004_032",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這真是社會造成的扭曲現象啊。",
