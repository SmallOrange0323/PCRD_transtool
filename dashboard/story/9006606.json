[
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這裡就是",
    "voice": "vo_adv_9006606_000",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "阿剌克涅的巢穴最深處──",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n這裡面",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "裝飾著好驚人的寶石和黃金呢……",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "金光閃閃。",
    "voice": "vo_adv_9006606_001",
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "除了從庫露露小姐那裡偷來的魔寶石，",
    "voice": "vo_adv_9006606_002",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n敵人似乎還蒐集了無數的金銀財寶……",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "比起什麼寶石──",
    "voice": "vo_adv_9006606_003",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雪菲！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n妳在哪裡！？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "抱歉讓您久等了，",
    "voice": "vo_adv_9006606_004",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雪菲小姐……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還有──",
    "voice": "vo_adv_9006606_005",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "趕緊滾出來，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "阿剌克涅！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我要宰了妳！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "…………呵。",
    "voice": "vo_adv_9006606_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "呵呵、",
    "voice": "vo_adv_9006606_007",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "哈哈哈……",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n擅自闖入吾的牢獄之中──",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n竟然還敢",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "如此高聲地大放厥詞。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那就是阿剌克涅女士……！",
    "voice": "vo_adv_9006606_008",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "多麼龐大的身軀啊……！",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "太過，",
    "voice": "vo_adv_9006606_009",
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n巨大。",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "在這狹小的地洞中，",
    "voice": "vo_adv_9006606_010",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "沒有任何款待──",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n吾就針對這點致個歉吧。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n呵呵。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不需要那種東西……！",
    "voice": "vo_adv_9006606_011",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n乖乖認命",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "把雪菲還給我們！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這裡可沒有",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "保護妳的夥伴了！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "夥伴──？",
    "voice": "vo_adv_9006606_012",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n妳說那個傳令、",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "盜賊們",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "和寶石蜘蛛是吾的夥伴？",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "別說笑了。",
    "voice": "vo_adv_9006606_013",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "那些傢伙不過是棋子罷了……",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n但吾不否認那是群無能之徒，連在吾消化完畢前的時間",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n都無法爭取。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "怎麼會……",
    "voice": "vo_adv_9006606_014",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n居然說為自己戰鬥的人們",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n是棋子",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "跟無能之徒……！",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "不明白的話，",
    "voice": "vo_adv_9006606_015",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "吾就告訴你們吧──",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n對吾來說，你們也只是",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "敵方的棋子罷了。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "咦……！？",
    "voice": "vo_adv_9006606_016",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也就是說，",
    "voice": "vo_adv_9006606_017",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳甚至不認為我們是敵人嗎……！？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "打亂吾算計的，",
    "voice": "vo_adv_9006606_018",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "僅僅是那位名為厄莉絲的前管理者的介入。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n而吾的對手從一開始──",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "便只有那位鐵皇女一人。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "…………",
    "voice": "vo_adv_9006606_019",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼……",
    "voice": "vo_adv_9006606_020",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n少看不起人了！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "既然妳的身軀大成這副德性，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就表示妳的腳邊很多破綻吧！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "像你們這樣的存在，",
    "voice": "vo_adv_9006606_021",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "吾連小瞧的意思都沒有。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n不過在吾消化完畢前，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "就來跟吾玩玩吧……！",
    "voice": null,
    "unit_id": 136013
  }
]
