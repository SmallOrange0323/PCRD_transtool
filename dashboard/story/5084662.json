  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "晶的公主騎士的昏睡……",
    "voice": "vo_adv_5084662_000",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n不得不說，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是非比尋常的事態呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "很遺憾，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "他就這麼沉睡不醒的可能性非常高吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……我可能已經無法再見到你了呢。",
    "voice": "vo_adv_5084662_001",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n這會讓我很困擾的。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "畢竟也還沒能模仿你……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "學生就這麼消失，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "即使身為七冠也是會感到悲傷的。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……不該有這樣的結局的。",
    "voice": "vo_adv_5084662_002",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n曾經擊敗我的你，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "根本不該在這裡結束。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "如果是至今好幾度",
    "voice": "vo_adv_5084662_003",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "超乎我預期的你，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n就應該沒有辦不到的事。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "所以……",
    "voice": "vo_adv_5084662_004",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我相信你一定會平安甦醒的喔。",
    "voice": null,
    "unit_id": 107011
  }
]
