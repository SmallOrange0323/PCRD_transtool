    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "有成功守護了嗎。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n這片屬於大家的海邊……",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "拿出來自信吧，",
    "voice": "vo_adv_5152402_001",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "莉雅。",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "妳看，",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "海邊的人們在向妳揮手喔。",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雖然有種害羞的感覺……",
    "voice": "vo_adv_5152402_002",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "但是很高興呢。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "終於可以休息了呢。",
    "voice": "vo_adv_5152402_003",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n啊啊，",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "在那之前可不能忘了對巴魯斯的處罰。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "能守護住大家的笑容，",
    "voice": "vo_adv_5152402_004",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "實在太好了。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那麼，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "各位──",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "──讓我們繼續度過「夏日佳期」吧！",
    "voice": "vo_adv_5152402_005",
    "unit_id": 131911
  }
]
