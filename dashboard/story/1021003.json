    "voice": "vo_adv_1021003_047",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n妳真是個貼心的孩子。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n一定是父母教得好吧。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "……妳也好好跟人家學學～真是丟臉。",
