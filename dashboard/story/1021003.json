  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "妳看，姐姐說要把蝴蝶結讓給妳喔。",
