  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嘻、嘻嘻……",
    "voice": "vo_adv_1021003_000",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "{0}哥哥，你好……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "今、今天，哥哥也要和我一起買東西嗎……？",
    "voice": "vo_adv_1021003_001",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "是的……",
    "voice": "vo_adv_1021003_002",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我又被派出來跑腿了……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "如果哥哥可以，幫我拿東西的話…",
    "voice": "vo_adv_1021003_003",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我就告訴{0}哥哥，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n一些能夠順利買到東西的建議唷……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊嗚……",
    "voice": "vo_adv_1021003_004",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "會、會不會有點自以為是呢……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "但是那個，哥哥……",
    "voice": "vo_adv_1021003_005",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n哥哥看起來，還不太習慣買東西的樣子……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我、我只是想，教哥哥很多很多的事情……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊，唉呀……",
    "voice": "vo_adv_1021003_006",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n沒、沒有讓哥哥感到困擾嗎……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "太好了……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嘻嘻，真拿哥哥沒辦法……",
    "voice": "vo_adv_1021003_007",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥明明就是個大人了……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n卻還沒辦法、一個人好好買東西呢……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那麼，我就來教哥哥很多很多的事……",
    "voice": "vo_adv_1021003_008",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嘻、嘻嘻……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊嗚……",
    "voice": "vo_adv_1021003_009",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n這個意思是說不用教哥哥買東西的方法之類的，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n也沒關係嗎……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯……",
    "voice": "vo_adv_1021003_010",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n哥哥很喜歡拿東西提行李嗎……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不對，是哥哥很貼心對吧……♪",
    "voice": "vo_adv_1021003_011",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那個……",
    "voice": "vo_adv_1021003_012",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我要買晚餐的材料……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "因為也有生鮮的食材，要是放到壞掉就不好了……",
    "voice": "vo_adv_1021003_013",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我們就先買哥哥要買的東西吧……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "然後，再買我要買的東西……",
    "voice": "vo_adv_1021003_014",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n這樣，就不會讓食材壞掉了……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嘻嘻，我是不是很聰明呢……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哇……",
    "voice": "vo_adv_1021003_015",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n為、為什麼要摸我的頭呢……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不、不要摸我……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗚嗚，對不起……",
    "voice": "vo_adv_1021003_016",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我、很容易被嚇到……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "並不是討厭被哥哥摸啦……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那個……",
    "voice": "vo_adv_1021003_017",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n話說回來，哥哥要買什麼東西呢……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "介紹打工的，資訊雜誌……？",
    "voice": "vo_adv_1021003_018",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "因為伙食費和住宿費之類的，",
    "voice": "vo_adv_1021003_019",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n一直都是由和哥哥一起住的孩子出錢……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "所以想說自己賺錢，減輕那個孩子的負擔……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我懂的……",
    "voice": "vo_adv_1021003_020",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n因為我也是，借住在【咲戀育幼院】裡……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "要是一直受別人照顧，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "會覺得很不好意思對吧……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "可是，如果是打工資訊雜誌的話……",
    "voice": "vo_adv_1021003_021",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n不用特地去買，在廣場之類的地方都有免費發送唷……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "地點就在回家的途中，到時應該就拿得到……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥連這件事都不知道，真的能夠打工嗎……？",
    "voice": "vo_adv_1021003_022",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊，對不起，不小心說了自以為是的話……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我、我沒有惡意，原諒我吧……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嘻嘻。",
    "voice": "vo_adv_1021003_023",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n哥哥真的是什麼都不知道呢……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n好、好可愛……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "打工要加油喔……",
    "voice": "vo_adv_1021003_024",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我會幫哥哥加油的……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "假如我將來，一不小心，成為大人物的話……",
    "voice": "vo_adv_1021003_025",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我會雇用哥哥的唷……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嘻嘻嘻……",
    "voice": "vo_adv_1021003_026",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那個，如果哥哥沒有其他想買的東西了……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我可以買自己要買的東西了嗎……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我剛才，看到了一條很可愛的蝴蝶結髮飾……",
    "voice": "vo_adv_1021003_027",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我呀，很喜歡蝴蝶結……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊，就是這條……",
    "voice": "vo_adv_1021003_028",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥你看，這個蝴蝶結明明這麼可愛卻很便宜……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "即使是用我的零用錢，也勉強能買得起……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊嗚。我是從咲戀媽媽那裡，拿到零用錢的……",
    "voice": "vo_adv_1021003_029",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n等我以後長大了，我想要好好工作來還錢……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不然總是拿錢的話，很不好意思呀……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "女孩",
    "words": "買啦買啦買啦！",
    "voice": "vo_adv_1021003_030",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女孩",
    "words": "\\n媽媽，買那個蝴蝶結給我啦！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "呀……？",
    "voice": "vo_adv_1021003_031",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n啊、啊嗚？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那個孩子，是不是想要這個髮飾呢……？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "不行喔～",
    "voice": "vo_adv_1021003_032",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n妳看，那個姐姐好像已經把最後一個買走了呢。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "已經賣完了，所以忍耐一下吧。",
    "voice": "vo_adv_1021003_033",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n今天的晚餐，媽媽會煮妳喜歡吃的漢堡排喔。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女孩",
    "words": "不要不要不要，買給我啦！",
    "voice": "vo_adv_1021003_034",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女孩",
    "words": "\\n我想要那個蝴蝶結～不要啦啊啊啊！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "真是的，不要這麼任性！",
    "voice": "vo_adv_1021003_035",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n我們家可沒有會一直說「不要」的孩子！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "趕快過來，不然我就要把妳丟掉囉？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女孩",
    "words": "不要啦啊啊！",
    "voice": "vo_adv_1021003_036",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女孩",
    "words": "\\n買啦買啦買啦！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女孩",
    "words": "不買給我那個蝴蝶結的話我就不回去！",
