[
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──數天後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500091"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "美空正一個人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n坐上蘭德索爾的城牆外側，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n眺望著逐漸昏暗的天空。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "118200301"
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "…………",
    "voice": "vo_adv_1182003_000",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "……唉。",
    "voice": "vo_adv_1182003_001",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "……我真是",
    "voice": "vo_adv_1182003_002",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "無藥可救呢。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "難得",
    "voice": "vo_adv_1182003_003",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "騎士同學說要跟我一起約會的……",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n我還鬧起脾氣，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "把他一個人丟在那裡。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "真是",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "受夠了。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "…………",
    "voice": "vo_adv_1182003_004",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "……可是可是。",
    "voice": "vo_adv_1182003_005",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n雖然",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我可能真的有點固執……",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n但那時候的騎士同學",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "也沒有多好啊。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "在我們爭執途中，",
    "voice": "vo_adv_1182003_006",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n那些綁架犯如果逃走之類的話。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n之後肯定又會在",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "某個地方做壞事。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "說到這。",
    "voice": "vo_adv_1182003_007",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n又覺得",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "生氣起來了。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "如果沒有那些綁架犯，",
    "voice": "vo_adv_1182003_008",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n我現在就在跟騎士同學約會……",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "感情變得更好。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n說不定就可以理解",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "因為戀愛而心跳加速的感覺了。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "……不。",
    "voice": "vo_adv_1182003_009",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n仔細想想，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "說到底。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n我一直",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "都沒有從正面",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "出現在騎士同學面前呢……",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "幾天前的美空",
    "words": "「呵呵★",
    "voice": "vo_adv_1182003_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幾天前的美空",
    "words": "\\n猜～猜我是誰？」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "118200301"
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "…………",
    "voice": "vo_adv_1182003_011",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "總是",
    "voice": "vo_adv_1182003_012",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "從他後方。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n就像是偷襲一樣。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "……希望這麼做，",
    "voice": "vo_adv_1182003_013",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n事情就能順著自己的步調進展，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "之類的？　",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "還是說。",
    "voice": "vo_adv_1182003_014",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n如果騎士同學注意到我正朝他走過去，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n卻擺出厭惡的表情的話該怎麼辦，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "或是說……",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我在害怕……",
    "voice": "vo_adv_1182003_015",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "之類的……？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "雖然我不覺得",
    "voice": "vo_adv_1182003_016",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "騎士同學會喜歡上我。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n雖然我也非常清楚",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "騎士同學完全是個濫好人。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "雖然騎士同學可能會說，",
    "voice": "vo_adv_1182003_017",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n不想再見到我，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我也可能會被騎士同學避而不見。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "即使如此，",
    "voice": "vo_adv_1182003_018",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我啊。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n能不能為了讓騎士同學中意我，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n而不再繼續固執下去",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "呢……",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "…………",
    "voice": "vo_adv_1182003_019",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "明明",
    "voice": "vo_adv_1182003_020",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "還沒有愛上他。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "就覺得……",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "已經很挫折了。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n果然我",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "辦不到呢──",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我又",
    "voice": "vo_adv_1182003_021",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "變得想要放棄了呢。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n…………",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "118200302"
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "……咦？",
    "voice": "vo_adv_1182003_022",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "咦、",
    "voice": "vo_adv_1182003_023",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "咦……？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n騎士同學……？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "你在",
    "voice": "vo_adv_1182003_024",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "找我嗎？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n為什麼……",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "…………",
    "voice": "vo_adv_1182003_025",
    "unit_id": 192011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "118200303"
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "……啊哈★",
    "voice": "vo_adv_1182003_026",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "之前",
    "voice": "vo_adv_1182003_027",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我有好好說過了呀？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n我對騎士同學的感情，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "並不想要停在「喜歡」，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n而是想要好好愛上你的這個話題。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "如果真的變成那樣。",
    "voice": "vo_adv_1182003_028",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n我也能從現在的人生放棄模式，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n轉變成普通的女孩子吧──",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "這樣。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "這些，",
    "voice": "vo_adv_1182003_029",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "完全就是我的真心話喔。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "騎士同學你該不會，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "不相信我吧？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "如果是這樣的話，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我好傷心──",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "呢。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "118200304"
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "呵呵。",
    "voice": "vo_adv_1182003_030",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我也沒有那麼受傷，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "所以不用感到抱歉。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n畢竟要相信一個至今為止都還是敵人的我所說的話",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "是很困難的呢。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "還有還有。",
    "voice": "vo_adv_1182003_031",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n有件事",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我那時候沒有說──",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "如果",
    "voice": "vo_adv_1182003_032",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "真的愛上騎士同學的話。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n一定會",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "非常非常開心的～♪",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n我是這麼想的──",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
