[
  {
    "type": "background",
    "bg_id": "500783"
  },
  {
    "type": "movie",
    "movie_id": "201400001"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為數眾多的魔物和闇影正到處肆虐，蘭德索爾成為了戰場。\\n而此時朝著一群群魔物們進行突擊的貪吃佩可，所遭遇到的是――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "在這裡狹路相逢也是天注定，",
    "voice": "vo_adv_2014001_000",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "霸瞳皇帝！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n呀啊啊啊！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "background",
    "bg_id": "500783"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "呵呵，",
    "voice": "vo_adv_2014001_001",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "好可怕好可怕。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n堂堂公主殿下，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "竟然這麼拚命呢……",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "連表情都如此猙獰。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這不可惜了妳那張可愛的小臉蛋嗎？",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "當然要拚命了！",
    "voice": "vo_adv_2014001_002",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n為了我的國民！　",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也為了父皇他們！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n只要我能把你給打倒，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這全部的一切，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就都能夠救回來了……！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "哎呀是喔？",
    "voice": "vo_adv_2014001_003",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那麼，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳就加把勁試試看能不能將我逼至絕境吧。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n妳當鬼，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "來抓我♪",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咕嗚……！",
    "voice": "vo_adv_2014001_004",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你別給我光是在那邊四處亂竄的呀！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了追趕霸瞳皇帝，貪吃佩可則是到處橫衝直撞，\\n同時{0}為了掩護她，\\n也死命地追著後面，然而……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": "vo_adv_2014001_005",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請往這來！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n涅比亞大人，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有意向在下等人",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n傳達一項『作戰』的樣子！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您的擔憂理當為是。",
    "voice": "vo_adv_2014001_006",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "然而……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "儘管冒昧，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但若是如今的在下一行人，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n是無法將霸瞳皇帝給擊敗的。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為得扭轉此局勢，",
    "voice": "vo_adv_2014001_007",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n也同是為拯救貪吃佩可小姐……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下等人，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如今所需要的是那份『作戰』啊，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "background",
    "bg_id": "500780"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "涅比亞大人！",
    "voice": "vo_adv_2014001_008",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下已遵照指示，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "將主公大人給帶回來了！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "嗯。",
    "voice": "vo_adv_2014001_009",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n真不愧是讓菲歐這麼中意的人呢，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "乖寶寶♪",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "好啦，",
    "voice": "vo_adv_2014001_010",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "那我要更具體地進行說明了唷。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我只會說一次而已，所以給我專心聽好了呀！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n明白了嗎？{0}！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "現在，",
    "voice": "vo_adv_2014001_011",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "在凱留的體內，寄宿著『那邊』的晶……",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n拉比林斯達所暫存的魔力和『鑰匙』。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……",
    "voice": "vo_adv_2014001_012",
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好像是真的。",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就算想隱瞞好像也沒什麼意義，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也就只能老實承認了。",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "首先將這把『鑰匙』交給{0}，",
    "voice": "vo_adv_2014001_013",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n便是這個『作戰』的大前提唷。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n而",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "說到交給他的方法……",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "欸……",
    "voice": "vo_adv_2014001_014",
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "涅比亞！",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說真的，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "除了妳剛剛講的那個方法以外就沒其他辦法了嗎！？",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "吼唷，",
    "voice": "vo_adv_2014001_015",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "妳到底還要煩惱到什麼時候才行啊？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "這又不是說要妳去做什麼了不起的大事情。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對我來說是大事情啦，",
    "voice": "vo_adv_2014001_016",
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "笨蛋！",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "更別還說，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是要和這傢伙……！",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "聽我說。",
    "voice": "vo_adv_2014001_017",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "魔術相關的契約",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "、讓渡",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "、榨取等等所需要進行的儀式，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n大部份也就是那幾種基本的行為模式。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n而這次，也是其中之一唷。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "這個嘛，",
    "voice": "vo_adv_2014001_018",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "用一般的話來講……",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "就是親嘴唷。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "親嘴。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "親、",
    "voice": "vo_adv_2014001_019",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "親嘴……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗎？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "和凱留小姐……？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗚嗚嗚嗚～！",
    "voice": "vo_adv_2014001_020",
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "辦、",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "辦不到果然辦不到啦！　",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "太丟臉了啦這種事情！",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……而且，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "人家也",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還沒有，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "跟誰親過……！",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "所～以～說～！",
    "voice": "vo_adv_2014001_021",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n這世界都已經陷入危機了，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "不是讓妳討價還價的時候了！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n妳不也是，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "說想要替這些傢伙們盡一份心力的嗎！？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗚……",
    "voice": "vo_adv_2014001_022",
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗚～～……、",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳說的，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也對啦，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒錯啦……",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n可、",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可是呀～……",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "哼哼♪　",
    "voice": "vo_adv_2014001_023",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "而、且、呀～",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "雖然嘴巴上說「不要～」或「辦不到～」之類的，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n但妳其實不討厭他對吧？　",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "這傢伙♪",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "煩、",
    "voice": "vo_adv_2014001_024",
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "煩死了煩死了煩死了～！",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "果然還是不要！　",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "絕對不要！",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "討厭的事就是討厭啦～！",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……要和主公大人，",
    "voice": "vo_adv_2014001_025",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個……，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "竟然能……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "親嘴什麼的。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您是如此令人好生羨慕的呢……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "倘若能與您交換的話，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就讓在下……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "好了沒，",
    "voice": "vo_adv_2014001_026",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "如果再繼續這樣磨蹭下去，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n貪吃佩可要被幹掉了唷？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "畢竟現在最危險的，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "可是正在和霸瞳皇帝戰鬥的那孩子啊。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您、",
    "voice": "vo_adv_2014001_027",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您說的是……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n凱留小姐，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "事到如今也別無他法了……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就向主公大人，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "慢慢的，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "輕輕地。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "稍微些許，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如同擦過的程度般……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "獻上嘴唇……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "對在下來說，",
    "voice": "vo_adv_2014001_028",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "儘管是斷腸之念。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "然而倘若只有僅僅的一瞬……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "做為凱留小姐限定，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "勉勉強強算您安全上壘。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "安全上壘妳～個頭！　",
    "voice": "vo_adv_2014001_029",
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在這種全場大亂鬥的正中央，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要、",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要和這傢伙……",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "親嘴……",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼的啊。",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "至少怎麼說，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "換個地方之類的也好啊……",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔呣……",
    "voice": "vo_adv_2014001_030",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您說『換個地方』",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗎？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "現在，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "蘭德索爾不論是任何角落都充斥著魔物，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如果要找個沒人打擾的地方，好像有不小的難度……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……涅比亞大人。",
    "voice": "vo_adv_2014001_031",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n由您所說的，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為了達成『鑰匙』的讓渡，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是除了唇與唇之間的接觸以外，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "別無他法的嗎？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "接觸的『地方』，",
    "voice": "vo_adv_2014001_032",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "倘若能換的話……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "比方說，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "對主公大人的額頭，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "讓凱留小姐獻上個吻，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這麼辦，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n可不可行呢？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "咦……？",
    "voice": "vo_adv_2014001_033",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "……可以啊？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可以喔～！",
    "voice": "vo_adv_2014001_034",
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我說啊妳這人！",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n早一點說行不行啊，",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這麼重要的事情！",
    "voice": null,
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "啊不是啊？",
    "voice": "vo_adv_2014001_035",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "妳又沒問我～？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咕呣呣～！",
    "voice": "vo_adv_2014001_036",
    "unit_id": 106015
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n氣死人了～！",
    "voice": null,
    "unit_id": 106015
  },
