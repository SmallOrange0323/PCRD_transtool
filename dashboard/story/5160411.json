[
  {
    "type": "background",
    "bg_id": "501473"
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "交流祭終於",
    "voice": "vo_adv_5160411_000",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "也在今天結束了嗎。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然發生了大大小小的問題，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但是可以說是大成功吧。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是啊。",
    "voice": "vo_adv_5160411_001",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是大成功到可以讓人確信吉歐‧格黑納跟蘭德索爾，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n接下來也能好好相處的程度呢。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過，",
    "voice": "vo_adv_5160411_002",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "讓我感到遺憾的就只有",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "梅杜莎沒能站上",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n蛇祭的頒獎台而已吧。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "因為",
    "voice": "vo_adv_5160411_003",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我已經達成了見涅妃‧涅羅的目的了，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "要是我出場的話會壓倒性地獲勝，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n那樣熱鬧不起來吧？",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "實際上是……",
    "voice": "vo_adv_5160411_004",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "因為戰鬥後的疲勞，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "隔天幾乎睡了一整天，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "結果就，嗯，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還是別提的好呢。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不管怎麼說，",
    "voice": "vo_adv_5160411_005",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "兩個世界",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "能迎來最棒的新年，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n是令人高興的事情。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "接下來是──",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "嗯，",
    "voice": "vo_adv_5160411_006",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我今年一定會找到姊姊她們，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "讓今年變成最棒的一年的！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "……話雖如此，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我知道沒辦法輕易找到她們，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n也會有很多辛苦的事情。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "但是，",
    "voice": "vo_adv_5160411_007",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "只要有妳們在的話……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "一定沒問題的。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我暫時會待在蘭德索爾，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "請多指教！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯，",
    "voice": "vo_adv_5160411_008",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那是當然的啊！",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "因為我們已經是夥伴了，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我們就互相幫忙吧。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "對了對了，",
    "voice": "vo_adv_5160411_009",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我有事要先告訴妳。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n蘭德索爾在日常中潛藏的危險，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然不像吉歐‧格黑納那麼多，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n但是意外地",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "會發生很多問題。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "……咦？",
    "voice": "vo_adv_5160411_010",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就是說啊。",
    "voice": "vo_adv_5160411_011",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "新年就不用說了，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "在聖誕節跟萬聖節發生事件",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n是每年的慣例，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "在海邊",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也頻頻發生問題啊。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "咦咦！？",
    "voice": "vo_adv_5160411_012",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "所以說──",
    "voice": "vo_adv_5160411_013",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "咲戀、莫妮卡",
    "words": "歡迎來到蘭德索爾，",
    "voice": "vo_adv_5160411_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀、莫妮卡",
    "words": "梅杜莎♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "……難道我",
    "voice": "vo_adv_5160411_015",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "有點太早做決定了？",
    "voice": null,
    "unit_id": 133611
  },
