    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯？",
    "voice": "vo_adv_5029002_031",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "　有什麼好訝異的？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我命令你",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "現在馬上衝進那裡大鬧一場……♪",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊～",
    "voice": "vo_adv_5029002_032",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過不要傷到她喔？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "跟聖誕老人克莉絲提娜約定好囉……☆",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿1",
    "words": "噗喔……噗喔喔喔～！\\n（喝……喝～呀！）",
    "voice": "vo_adv_5029002_033",
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗯？",
    "voice": "vo_adv_5029002_034",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "　那是什麼聲音……",
