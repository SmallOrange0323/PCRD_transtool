  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "感覺更有可能變成新的都市傳說呢。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "你們管太多了！",
    "voice": "vo_adv_5144007_048",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "還有",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "小姑娘們，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "向來賓致詞的時間到了。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "作為負責人，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "快去盛大地宣布鮮花祭的開幕吧。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好的！",
    "voice": "vo_adv_5144007_049",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我練習過很多次了，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "包在我身上！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我開始緊張起來了……！",
    "voice": "vo_adv_5144007_050",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "希望可以不咬到舌頭順利講完……！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "沒事的。",
    "voice": "vo_adv_5144007_051",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n好像可以看著小抄照唸也沒關係，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n就算因為緊張忘了要說什麼也可以放心。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "說、",
    "voice": "vo_adv_5144007_052",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "說的也是，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是我擔心過頭了對吧？",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "小抄也帶好……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那麼我出發了～！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我會好好地去向來賓致詞的，",
    "voice": "vo_adv_5144007_053",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n請仔細地",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "看著我喔？",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯～",
    "voice": "vo_adv_5144007_054",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "總覺得很擔心呢～",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "畢竟鈴莓就是會在這種時候冒失搞砸嘛。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "沒問題的！",
    "voice": "vo_adv_5144007_055",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "致詞小抄的內容",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也寫得很好，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n她一定",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "會說得很精彩的！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「那樣確實是很好，",
    "voice": "vo_adv_5144007_056",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n就只差最重要的鈴莓小姐沒有把它帶在手邊而已了。」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "茉莉、綾音",
    "words": "啊。",
    "voice": "vo_adv_5144007_057",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呃～",
    "voice": "vo_adv_5144007_058",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "各位來賓。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n今天……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "小抄小抄……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雞、",
    "voice": "vo_adv_5144007_059",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雞肉300公克，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "和馬鈴薯４顆、",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "紅蘿蔔１根、",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n洋蔥１顆……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "奇、",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n開場白有這麼地嶄新嗎？",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "妳在說什麼啊，鈴莓小姐！？",
    "voice": "vo_adv_5144007_060",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n應該不是那樣的內容吧！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我不小心搞錯，",
    "voice": "vo_adv_5144007_061",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "拿到做料理的筆記了～！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "所以……！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請大家在芙菈瓦村的鮮花祭，",
    "voice": "vo_adv_5144007_062",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "盡情地",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "享受",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "吧！！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，雖然鈴莓的冒失直到最後都沒能改過來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但解決完村子問題的{0}等人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n還是順利地在美好的鮮花祭中接待了觀光客。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "movie",
