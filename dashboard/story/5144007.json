    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "快走吧！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "你們一定會後悔救了",
    "voice": "vo_adv_5144007_016",
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "那傢伙的！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "畢竟壞蛋不管到哪裡",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "都是壞蛋啊～！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真是的！",
    "voice": "vo_adv_5144007_017",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n那個人直到最後都這麼壞心眼，令人困擾呢！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "有的人會像龍次先生一樣能夠反省，",
    "voice": "vo_adv_5144007_018",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n也有人完全學不乖呢。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這部分",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就只能看當事人的心態了呢～",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "……我也只是",
    "voice": "vo_adv_5144007_019",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "運氣好而已。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "要是再有一點什麼差錯，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "我說不定也會排在那條隊伍裡吧。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "龍次先生你",
    "voice": "vo_adv_5144007_020",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不是有好好站在村子這一邊嗎。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呃，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請、",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請你打起精神來！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "話雖如此，",
    "voice": "vo_adv_5144007_021",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "我還是無法就這樣感到高興啊。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "那些傢伙",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "要不是知道我在這裡，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n也不會策劃要來襲擊吧。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這種事",
    "voice": "vo_adv_5144007_022",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "也是沒辦法預防的呀！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "又不是龍次先生你叫他們來的！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "就算如此，",
    "voice": "vo_adv_5144007_023",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "我還是要負起責任。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "……老頭子。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "怎麼啦？",
    "voice": "vo_adv_5144007_024",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "我沒有忘記我說過",
