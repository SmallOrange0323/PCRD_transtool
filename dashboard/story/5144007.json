    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "願意接受任何懲罰。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "就算是要打我還是把我趕出村子，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "我都沒有怨言。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "這樣啊。",
    "voice": "vo_adv_5144007_026",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "你就來我家拔草一個月好了。",
