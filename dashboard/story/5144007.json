    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是啊♪",
    "voice": "vo_adv_5144007_003",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n大家也是，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真的",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "辛苦你們了～",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "畢竟一旦答應要幫忙了，",
    "voice": "vo_adv_5144007_004",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n就得抱著責任感去做才行！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "剛開始的時候問題一大堆，",
    "voice": "vo_adv_5144007_005",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我還擔心不知道會變成怎樣呢～",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "反正結果好，",
    "voice": "vo_adv_5144007_006",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就一切都好呀！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n而且引起騷動的罪魁禍首幫派",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也全部都逮捕到了，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我也覺得很好♪",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "可、",
    "voice": "vo_adv_5144007_007",
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "可惡～！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "我那麼辛苦地準備了殺手鐧，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "卻因為那個冒失的小姑娘而被抓到～！！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "可惡～！！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "吵死了，",
    "voice": "vo_adv_5144007_008",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "走快一點！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n距離蘭德索爾可還遠著啊！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "可惡……",
    "voice": "vo_adv_5144007_009",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "喂，等一下。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "龍次，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "幫派手下1",
    "words": "為什麼你沒有被追究責任啊！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那是當然的，",
    "voice": "vo_adv_5144007_010",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "因為他沒有做任何壞事！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n他已經不是你們的同伴了！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "妳把我正想說的話，",
    "voice": "vo_adv_5144007_011",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "漂亮地替我說出來了呢。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "就是這樣，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "這次我們真的要道別了。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "道別？",
    "voice": "vo_adv_5144007_012",
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "你怎麼可能辦得到！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "你一定還會",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "再犯同樣的過錯的！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "你會不斷地走錯路，",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "幫派老大",
    "words": "不斷地背叛周遭的人！",
    "voice": null,
    "unit_id": 2514
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒有這回事。",
    "voice": "vo_adv_5144007_013",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "現在的龍次先生身邊",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "已經有很多會幫助他的人了。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "可以趕快把他帶走嗎？",
    "voice": "vo_adv_5144007_014",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n像這樣的男人，",
