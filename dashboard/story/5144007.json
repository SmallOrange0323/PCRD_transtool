    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "那我也",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "有很多地方應該改進的吧。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「雖然該最優先改進的地方",
    "voice": "vo_adv_5144007_043",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "是穿著打扮就是了。」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "吵死了，",
    "voice": "vo_adv_5144007_044",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "你這個自以為是的玩偶！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n這身服裝",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "等鮮花祭結束後我就會丟了！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n我可不會再穿第二次了啊！",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "啊？",
    "voice": "vo_adv_5144007_045",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n我可是打算今後讓你當村子的吉祥物，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n一直穿那樣來接待觀光客的……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這個還是重新考慮一下比較好喔，",
    "voice": "vo_adv_5144007_046",
