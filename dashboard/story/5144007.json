    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "啊？",
    "voice": "vo_adv_5144007_027",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n喂，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "我是說認真的……",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "龍次先生，",
    "voice": "vo_adv_5144007_028",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大家不是",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "已經表達了對你的心意了嗎。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你已經",
    "voice": "vo_adv_5144007_029",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "被正式視為村子的一員了。",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "要是太嘮嘮叨叨的話，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "又會被討厭的喔？",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "……",
    "voice": "vo_adv_5144007_030",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "其他的人",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "真的也覺得這樣就好嗎？",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "男性村民",
    "words": "我們都有聽說事情的來龍去脈了。",
    "voice": "vo_adv_5144007_031",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性村民",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性村民",
    "words": "真虧你明明受到威脅，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性村民",
    "words": "還能打算應戰而不逃跑。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性村民",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性村民",
    "words": "我明白你是認真地要跟幫派訣別了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "關於這點，",
    "voice": "vo_adv_5144007_032",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "那個……",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "說實在的，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "我一開始本來是打算逃跑的。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "因為",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "我想說已經束手無策了。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦，",
    "voice": "vo_adv_5144007_033",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是這樣的嗎？",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那你為什麼會留下來……",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "因為你們說服了我啊。",
    "voice": "vo_adv_5144007_034",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n對於像我這樣的人渣，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "真虧你們能那麼堅持呢。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為，",
    "voice": "vo_adv_5144007_035",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我也曾經有過和你一樣的心情。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "鈴莓小姑娘也有嗎？",
    "voice": "vo_adv_5144007_036",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "我還以為妳不管再怎麼冒失，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "都不會氣餒的。",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我曾經因為自己的冒失，",
    "voice": "vo_adv_5144007_037",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "弄壞了很重要的東西。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我非常地難過，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就逃出了育幼院。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "居然有過這種事啊……",
    "voice": "vo_adv_5144007_038",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "但是，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "既然妳被育幼院派過來這裡，",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "\\n就代表妳有順利重新來過對嗎？",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是的♪",
    "voice": "vo_adv_5144007_039",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那時候，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "有人在身邊支持著我……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐也對我",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "說了很多溫柔的話語。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "在真的很傷腦筋，找不到解決辦法的時候，",
    "voice": "vo_adv_5144007_040",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n每個人",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "都會需要有人支持自己的。",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這是為了",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "獲得重新來過的勇氣……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒錯吧？",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嘿嘿♪",
    "voice": "vo_adv_5144007_041",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n那個時候，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真的是",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "受你關照了～",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "原來如此，",
    "voice": "vo_adv_5144007_042",
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "陰柔男就是",
    "voice": null,
    "unit_id": 6312
  },
  {
    "type": "dialogue",
    "name": "龍次",
    "words": "「支持妳的人」是吧。",
