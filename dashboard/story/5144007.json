  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n鈴莓也被成功救回，鮮花祭開幕",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n所面臨的問題全部都解決了。",
