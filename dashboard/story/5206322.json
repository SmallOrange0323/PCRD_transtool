[
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這次召喚出闇影了！？",
    "voice": "vo_adv_5206322_000",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那該不會是……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "大家。",
    "voice": "vo_adv_5206322_001",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n是【幻變少女】的，",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "闇影。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "普蕾西亞，",
    "voice": "vo_adv_5206322_002",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "妳仔細看。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n阿賀斗紫布菜的闇影也出現了。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "啊。",
    "voice": "vo_adv_5206322_003",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n……",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "雪菲。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n也加入，",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "【幻變少女】。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "來吧？",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦！？",
    "voice": "vo_adv_5206322_004",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "雖、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "雖然我很高興妳有這份心意……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……",
    "voice": "vo_adv_5206322_005",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "可以說都是，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "前末端裝置的闇影吧……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n步調都被打亂了……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "總而言之，",
    "voice": "vo_adv_5206322_006",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "想必不是普通的闇影。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "也許因為理想鄉的力量，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "而有所強化也說不定。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n就假設跟我的闇影一樣，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "以會復活為前提應戰吧。",
    "voice": null,
    "unit_id": 135011
  }
]
