[
  {
    "type": "background",
    "bg_id": "500330"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}為了【new generations】的練習",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n停留在村子裡，並陪同凜進行晨練——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "嗯？",
    "voice": "vo_adv_1125003_000",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "一群人聚在那裡。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "一大早就那麼多人，真是難得呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "「凜」就是",
    "voice": "vo_adv_1125003_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "那個當偶像的女孩吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "該怎麼辦才好……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "可是，",
    "voice": "vo_adv_1125003_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "這樣下去村子會出大事的……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……我說，",
    "voice": "vo_adv_1125003_003",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "發生什麼事了嗎？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "聽起來好像和我有關係。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "是啊，",
    "voice": "vo_adv_1125003_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "不得了！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "告示板上面貼了一張奇怪的紙……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "告示",
    "words": "對「蒼藍劍士凜」提出決鬥。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "告示",
    "words": "\\n若是妳不接受決鬥，村子將會有災難降臨。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "告示",
    "words": "決鬥不准攜帶同伴，必須要一個人前來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "告示",
    "words": "\\n時間與地點是——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……對我提出決鬥",
    "voice": "vo_adv_1125003_005",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "既然上頭都這麼寫了，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "那我也只能去了呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "不對不對，",
    "voice": "vo_adv_1125003_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "小姐妳一個人去太危險了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n這個不管怎麼看都是陷阱啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "這個我知道。",
    "voice": "vo_adv_1125003_007",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "但是，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "如果我不去，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "各位可能都會有危險。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "謝謝。",
    "voice": "vo_adv_1125003_008",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "不過，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "要是被發現了不曉得會出什麼事，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "還是我自己去吧。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "上頭也有畫地圖，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "這張紙",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我就帶走囉。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "為了以防萬一，",
    "voice": "vo_adv_1125003_009",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "村裡的人們",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n請關緊門窗，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "就算有什麼事也別跑出來外面。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "懂嗎？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "啊，",
    "voice": "vo_adv_1125003_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "嗯。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "知道了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大叔",
    "words": "妳一個人去真的沒問題嗎……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "沒問題，",
    "voice": "vo_adv_1125003_011",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "放心吧。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "別看我這樣，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "其實我挺強的喔。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我絕對會想辦法解決的。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "要是",
    "voice": "vo_adv_1125003_012",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "卯月和未央",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "問我去哪裡的話，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n你就幫我告訴她們我一個人去練習了。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我先走了。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，",
    "voice": "vo_adv_1125003_013",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "找到了找到了！　",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我說你，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "又一個人到處閒晃了？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我不是說過別擅自行動了嗎，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你今天不是要陪她們練習嗎？",
    "voice": "vo_adv_1125003_014",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "趕快過來吧。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不對，",
    "voice": "vo_adv_1125003_015",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你在說什麼啊？　",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "完全搞不懂你的意思耶？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……喂，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別突然拉著人就走啦！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你要帶我去哪裡！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……真的是這裡沒錯嗎？",
    "voice": "vo_adv_1125003_016",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然也姑且和村裡的人們確認過了，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n但這要是搞錯了，不是很不妙嗎？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊啊……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是不安……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我依約前來決鬥了！　",
    "voice": "vo_adv_1125003_017",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "好了，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "快點出來吧！",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，",
    "voice": "vo_adv_1125003_018",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "來了！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……喂，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別把頭伸出去啦，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你也給我躲好！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "嘿～",
    "voice": "vo_adv_1125003_019",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "沒想到真的一個人來了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "妳是相當有自信呢？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "還是單純只是個笨蛋呢？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "你是",
    "voice": "vo_adv_1125003_020",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "那個時候的！",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "現在不是正在為了你至今所做的壞事贖罪嗎？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "我這裡可是有一大群的夥伴呢，",
    "voice": "vo_adv_1125003_021",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "我讓那些傢伙幫助我逃獄啦。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "然後啊，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "我想來回敬妳之前的所作所為呢。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……",
    "voice": "vo_adv_1125003_022",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "完全沒有反省的意思呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我就再護送你去一趟王宮騎士團吧。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "妳可別以為事情會有妳想得那麼順利啊！",
    "voice": "vo_adv_1125003_023",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "\\n",
