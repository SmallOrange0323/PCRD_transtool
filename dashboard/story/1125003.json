    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我倒是很喜歡妳把所有人修理得一蹶不振的氣概。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "那、",
    "voice": "vo_adv_1125003_060",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "那個！　",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "非常謝謝你們",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "救了我！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "妳是",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "在村子舉辦演唱會的偶像小姐……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "沒錯吧？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "妳真的非常帥氣呢！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "呵呵，",
    "voice": "vo_adv_1125003_061",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n我會努力",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "讓偶像的演唱會也像這樣被人讚許的。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "別這麼說！　",
    "voice": "vo_adv_1125003_062",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "我相信妳",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "一定能以「蒼藍的偶像劍士凜」，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "成為超具話題的偶像！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村中女子",
    "words": "我會支持妳的！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "感覺屬性太多了吧。",
    "voice": "vo_adv_1125003_063",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "呃，",
    "voice": "vo_adv_1125003_064",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "就算你說什麼好像很強……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "但偶像不需要那種要素吧。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……還有，",
    "voice": "vo_adv_1125003_065",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我一直有個疑問。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "那個",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "「蒼藍劍士」的名稱",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "到底是怎麼回事？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "擊退盜賊，創造新的英勇事蹟的凜。\\n「蒼藍的偶像劍士」的成名錄才剛要開始——",
    "voice": null,
    "unit_id": null
  }
]
