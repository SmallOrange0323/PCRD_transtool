  {
    "type": "dialogue",
    "name": "真步",
    "words": "今天的",
    "voice": "vo_adv_5146411_000",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "「大夢想樂園」也是",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "客滿狀態♪",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就算人家不在，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這座遊樂園",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也沒問題呢……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "開玩笑的，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "其實人家",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "根本就沒～有做什麼大貢獻♪",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "別這麼說別這麼說！",
    "voice": "vo_adv_5146411_001",
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "現在之所以會有這麼多客人來玩，",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n真步小小姐和英雄先生的貢獻，",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n占了99.99999999999999……",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "％呀！",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "我的貢獻程度，",
    "voice": "vo_adv_5146411_002",
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n根本只有0.00000000000000……",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "1％左右而已！",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真是的，",
    "voice": "vo_adv_5146411_003",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "庫露露小姐謙虛過頭了呀。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "妳今後",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "可以再更有自信一點",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也沒關係唷？",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "至少人家",
    "voice": "vo_adv_5146411_004",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "很尊敬庫露露小姐♪",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "要不是因為如此，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家也不會跟妳",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "一起工作到現在呀。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這全都是",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "托庫露露小姐的福哪♪",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "真步小小姐……！",
    "voice": "vo_adv_5146411_005",
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……好了，",
    "voice": "vo_adv_5146411_006",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那人家",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "差不多要",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "回去蘭德索爾了。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "下次",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家會以客人的身分",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n來「大夢想樂園」",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "玩的喔♪",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "對了，",
    "voice": "vo_adv_5146411_007",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家能作為職員，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n最後再跟妳一起",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "說一次那個嗎？",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "嗯，",
    "voice": "vo_adv_5146411_008",
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "當然可以！",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "來喊和真步小小姐",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "一起說過好幾次的",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "那句話吧！",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "要來囉！",
    "voice": "vo_adv_5146411_009",
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "預備～！",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露、真步",
    "words": "歡迎來到",
    "voice": "vo_adv_5146411_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "庫露露、真步",
    "words": "「大夢想樂園」～♪",
