  {
    "type": "dialogue",
    "name": "旁白",
    "words": "長時間持續激戰到最後，貪吃佩可一行人，\\n終於成功地讓某種未知的巨大物體停了下來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "太好了！",
