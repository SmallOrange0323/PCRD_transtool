  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "{0}。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n也是為了讓我這個美麗藝術品，",
