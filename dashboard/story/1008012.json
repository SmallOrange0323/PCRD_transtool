    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "楚楚可憐的美人……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真驚人……",
    "voice": "vo_adv_1008012_025",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "沒想到你的眼睛",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還能有這樣的用途！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哭泣的我",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真是既夢幻又美麗，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
