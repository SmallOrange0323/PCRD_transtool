    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "臣服於我的美之下──！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "background",
    "bg_id": "500400"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雪和{0}成功從鏡中脫逃，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n並一鼓作氣地通過地下城，總算是抵達了山頂。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呼、",
    "voice": "vo_adv_1008012_039",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呼……",
