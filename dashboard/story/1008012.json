[
  {
    "type": "background",
    "bg_id": "500250"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和雪聽從愛梅斯的話語，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n以聖山山頂為目標，走在從神殿所連接的地下城裡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呀啊～！",
    "voice": "vo_adv_1008012_000",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "討、",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "討厭，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我討厭蟲！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呀啊啊！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我踩到",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "蝙蝠大便了啦！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我受不了",
    "voice": "vo_adv_1008012_001",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這地方了……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不僅很不衛生，有一大堆蟲和蝙蝠，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n剛才還差點掉進地洞裡……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "該不會",
    "voice": "vo_adv_1008012_002",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這狀況本身就是最後的測驗？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n會是在測試我能",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "忍受到什麼地步嗎……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那是……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "果然是鏡子！",
    "voice": "vo_adv_1008012_003",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "而且還是非常漂亮的鏡子耶！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哎呀……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "即使碰上如此悽慘的狀況，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我依然很美呢……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "若要舉例，",
    "voice": "vo_adv_1008012_004",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "大概就有如那朵出淤泥而不染的",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "美麗蓮花吧。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n光是看著，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "煩悶的心情便彷彿被洗滌一般……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這鏡面是不是有些扭曲呀？",
    "voice": "vo_adv_1008012_005",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "唔、",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "唔哇！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我要被吸進鏡子裡了！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "{0}！唔、",
    "voice": "vo_adv_1008012_006",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "唔哇～！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗚嗚，",
    "voice": "vo_adv_1008012_007",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "中計了……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "沒想到竟在地下城裡設下「詛咒鏡子」……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n是利用我的個性而安排的狡猾詭計啊。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊，",
    "voice": "vo_adv_1008012_008",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "未料我竟會被自己的美麗所害，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我的美還真是",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "罪孽非常深重哪……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "順道一提，",
    "voice": "vo_adv_1008012_009",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "所謂的詛咒鏡子",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是一種魔物。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不是偶爾在地下城",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "會出現擬態成寶箱的魔物嗎？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這就是那種魔物的鏡子版。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過別擔心，",
    "voice": "vo_adv_1008012_010",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然它這個把人關進鏡子中的",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "能力很棘手，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n但照理說只要使用魔法，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就能脫逃。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "臣服於",
    "voice": "vo_adv_1008012_011",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的美之下吧！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "騙人，",
    "voice": "vo_adv_1008012_012",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "竟然反彈回來了！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呀啊！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊、",
    "voice": "vo_adv_1008012_013",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊啊……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎、",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼辦……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我那",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "玉筍般的白皙玉手呀……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "傷的大小不是重點！",
    "voice": "vo_adv_1008012_014",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我受傷這件事本身就是很嚴重的問題了！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "糟透了……",
    "voice": "vo_adv_1008012_015",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不但身上有了傷，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n魔法也無效，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "已經束手無策了……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我們肯定",
    "voice": "vo_adv_1008012_016",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "一輩子無法從這裏出去了。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n未料我這般惹人憐愛的花兒，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n就要不為人知地",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "凋落在這種地方了嗎……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我原本預計自己將來會擄獲全世界人們的心，",
    "voice": "vo_adv_1008012_017",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n沒想到這璀璨未來將在此被剝奪……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "太殘酷了！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "往後我的人生肯定會成為",
    "voice": "vo_adv_1008012_018",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "舞台上的悲劇故事被歌頌下去……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……啊，",
    "voice": "vo_adv_1008012_019",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如果我們倆都出不去，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就沒有人負責傳承故事了……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這讓我的心情更加消沉了……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "已經沒救了呀……",
    "voice": "vo_adv_1008012_020",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "現在的我",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "甚至連看鏡子的心情也沒有……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這代表著什麼，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "相信你也明白吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哇！",
    "voice": "vo_adv_1008012_021",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "靠、",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "靠太近了啦！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你該不會是",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "自暴自棄，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "想乾脆強奪我惹人憐愛的雙唇……！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "再怎麼說還是太突然了啦！",
    "voice": "vo_adv_1008012_022",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這、",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這種事情是",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "必須做好準備和決心的……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦、",
    "voice": "vo_adv_1008012_023",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "原來你是……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這意思……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過看你的眼睛又如何？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "肯定什麼都看不──",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊。",
    "voice": null,
