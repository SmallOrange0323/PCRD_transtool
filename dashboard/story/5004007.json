  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後，{0}一行人安然無恙地從海底遺跡逃脫出來了。\\n當時剛好也是午餐時間，\\n大家便開開心心地在海邊烤肉順便慶功。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我要開動～囉☆",
    "voice": "vo_adv_5004007_000",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我會盡量串盡量烤的，",
    "voice": "vo_adv_5004007_001",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n喜歡的大家就盡量拿吧！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而且這一頓",
    "voice": "vo_adv_5004007_002",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "居然不用錢哦，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n走路路過不要錯過，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "盡情地吃吧～♪",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "啊，",
    "voice": "vo_adv_5004007_003",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "但飲料要另外計費的！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "如此",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "盛況空前，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這下有得忙囉……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這位大叔",
    "voice": "vo_adv_5004007_004",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是誰啊？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n怎麼突然和我們算起帳來了……？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊哈哈。",
    "voice": "vo_adv_5004007_005",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n這位是",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "聘我來海之家短期打工的",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "店長先生。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊，",
    "voice": "vo_adv_5004007_006",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "鈴莓小姐",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在海之家打工啊。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n您工作",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哪裡哪裡～",
    "voice": "vo_adv_5004007_007",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n各位才是經歷了一場大冒險，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "相當勞累了吧，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n請各位好好休息，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "多吃一點來補充營養吧。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還請各位",
    "voice": "vo_adv_5004007_008",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "盡情享用！",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然我",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不是很擅長料理，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n不過只是串起來然後拿去烤的話",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "也很難失敗吧♪",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哇，",
    "voice": "vo_adv_5004007_009",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "唉唷……",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呀啊啊啊！？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔哇，",
    "voice": "vo_adv_5004007_010",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還是請妳小心一點吧！？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "要是頭撞上碰過火的金屬網和鐵板的話可就悲劇了，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n會受重傷的！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "欸嘿嘿……",
    "voice": "vo_adv_5004007_011",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n不好意思，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "看來我的魔力和體力似乎也消耗得差不多了。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "暈頭轉向的～",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我還是別到處亂走好了。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "難得大家都平安無事，",
    "voice": "vo_adv_5004007_012",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還是畫下一個完美的句點吧。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要是在最後一刻冒失地跌了一跤受重傷的話",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就太糟糕了，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "感覺像付出的辛勞全都變成放水流了一樣。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "嗯，",
    "voice": "vo_adv_5004007_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "鈴莓妳就好好休息吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n話說",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "妳的家人似乎也過來了呢，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n妳們一起去玩沒關係的喔？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "家人……？",
    "voice": "vo_adv_5004007_014",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐還有大家！",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "still",
    "still_id": "500400701"
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "鈴莓～！",
    "voice": "vo_adv_5004007_015",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n快過來，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "一起玩啊♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "鈴莓姐～！",
    "voice": "vo_adv_5004007_016",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n妳看，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我撿到了這麼美的貝殼哦……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊哈哈。",
    "voice": "vo_adv_5004007_017",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n雖然這個淺灘上雙腳能觸地，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還不至於溺水，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n但是大家",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還是要小心別受傷了哦。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓～",
    "voice": "vo_adv_5004007_018",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "工作之餘有空閒的話",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳也一起來玩水吧？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "難得穿了一身可愛的泳裝，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n不下水玩玩太可惜了哦♪",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就是就是！",
    "voice": "vo_adv_5004007_019",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "　【咲戀育幼院】的所有人，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n不……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我們一家人一起開心玩水吧！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "妳看妳看，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉也會游泳哦～？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「唔哇？",
    "voice": "vo_adv_5004007_020",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n別鬧了啊～",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "弄濕了搞不好會發霉的……",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n鈴莓小姐，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "能為我施展防水魔法嗎？」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啪啦啪啦……",
    "voice": "vo_adv_5004007_021",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n欸嘿嘿，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "海裡好多美麗的東西啊……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哇啊，",
    "voice": "vo_adv_5004007_022",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好開心的感覺～♪",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n啊哈哈，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "【咲戀育幼院】的各位都來海水浴場玩了啊。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯，",
    "voice": "vo_adv_5004007_023",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "順便來看看妳的工作表現啊。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "反正是夏天嘛～",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也想帶著這些孩子來海邊玩玩。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但是。",
    "voice": "vo_adv_5004007_024",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n妳不在的時候",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "果然還是很寂寞啊，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳也過來我們這邊……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "和我們一起玩吧♪",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊哈哈，",
    "voice": "vo_adv_5004007_025",
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐難得符合年紀，",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "樂成這個樣子呢。",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不過我現在",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還在工作中……",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這樣好嗎？",
    "voice": null,
    "unit_id": 107711
  },
  {
    "type": "still",
    "still_id": "500400702"
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "嗯。",
    "voice": "vo_adv_5004007_026",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n這裡就交給我，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "妳就去吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "海底遺跡的魔物被驅除了之後，",
    "voice": "vo_adv_5004007_027",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n變得安全多了，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "人潮都開始增加……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "照這情況看來",
    "voice": "vo_adv_5004007_028",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "能轉虧為盈，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n我們家也就不用過著縮衣節食的生活了啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這都是你們的功勞。",
    "voice": "vo_adv_5004007_029",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n真的很謝謝你們！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n你們真是我的……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是瑪爾傑海岸的救世主啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "still",
    "still_id": "500400703"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不用客氣啦～",
    "voice": "vo_adv_5004007_030",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n欸嘿嘿，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然碰上了許多插曲，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但感覺是個不錯的結局呢♪",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我把打倒的魔物作為食材都帶回來了，",
    "voice": "vo_adv_5004007_031",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "切開來後一看……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n魔物的肚子裡，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n除了皇冠之外的「皇家裝備」也都好好地躺在裡頭。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這是我非常重要的東西，",
    "voice": "vo_adv_5004007_032",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒有變成海裡的碎藻泥垢真是太好了。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？",
    "voice": "vo_adv_5004007_033",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　欸，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "剛才那些串在一起烤肉的東西，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n難道都是魔物的肉嗎？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那隻被我們打倒的，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "長了好幾根觸手的傢伙？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是的！",
    "voice": "vo_adv_5004007_034",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　然後",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "在海底遺跡探索所遭遇到一併打倒的",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n魔物小嘍囉們也都一起……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n畢竟棄置一旁任其腐爛也是浪費嘛，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "索性也一起吃了吧♪",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不做沒益處的殺生，",
    "voice": "vo_adv_5004007_035",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "把擊殺的魔物吃得乾乾淨淨！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這便是我們【美食殿堂】的作風啊……☆",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "still",
    "still_id": "500400704"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呸、",
    "voice": "vo_adv_5004007_036",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呸，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這種事妳早點說啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n唔哇，那些噁心的魔物肉，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "難道我都吞下肚了……！？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_5004007_037",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n您不需要吐出來的，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "挺美味的啊。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "經過適當的處理，",
    "voice": "vo_adv_5004007_038",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n也用了魔法解析",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "證明了無毒，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是相當安全的肉。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來，",
    "voice": "vo_adv_5004007_039",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人您也嘗嘗……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊～♪",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "剛烤過的稍微有點燙口呢。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下來吹吹吧，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼♪",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "該死，",
    "voice": "vo_adv_5004007_040",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我又吃到怪異料理啦～！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我說過好幾遍了吧，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我從生理上就排斥食用魔物了啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不行不行，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我突然覺得噁心反胃了……！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵。",
    "voice": "vo_adv_5004007_041",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "還是乖乖地把它吃下去吧，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "凱留小姐。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "高等的魔物",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "含有大量能量，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n您剛好",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "可以補足大量消耗掉的魔力哦。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦！？",
    "voice": "vo_adv_5004007_042",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "花凜，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是妳～！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "欸，",
    "voice": "vo_adv_5004007_043",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳一定知道什麼隱情對吧！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這次的旅遊我怎麼想都覺得不對勁，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n明明是海水浴場旺季，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但除了我們海邊一個人也沒有啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我已經聽說了此處有危險魔物的出沒，",
    "voice": "vo_adv_5004007_044",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "禁止下水游泳的事情了！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這樣妳居然還敢招待我們，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我們才被搞得落到這副田地！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都是妳一手策劃的對吧，",
    "voice": "vo_adv_5004007_045",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這一切！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n是想把我們丟進修羅場，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "讓我們去解決這個大問題吧！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n絕、",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對是這樣！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　之前好像也是這樣來著……！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵。",
    "voice": "vo_adv_5004007_046",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n這就任憑各位想像了♪",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不過，",
    "voice": "vo_adv_5004007_047",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們身為【公會管理協會】……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n對那些完全不做有意義的活動，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "成天只會拿補助的費用去吃吃喝喝的公會，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我們是無法置之不理的。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "偶爾也必須要讓他們幹點活～",
    "voice": "vo_adv_5004007_048",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "才行。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不過呢這次是",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "出乎意料地變成相當危險的狀況，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n這方面我們還是要好好反省的。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "作為諸位這次，",
    "voice": "vo_adv_5004007_049",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "漂亮解決瑪爾傑海岸異變的獎勵……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n目前",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "【美食殿堂】依然是受到認可的公認公會，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我們會繼續提供補助金。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "再來，我們額外再奉送一些優惠。",
    "voice": "vo_adv_5004007_050",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n真正的",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "「迷人的南國之旅」，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n度假區免費招待券♪",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊！",
    "voice": "vo_adv_5004007_051",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "果然是這樣！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真正的「迷人的南國之旅」的舉辦地，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n根本不是在瑪爾傑海岸對吧？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這裡分明就還是在本國啊，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "之前就覺得奇怪了！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵。",
    "voice": "vo_adv_5004007_052",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "還有，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們也為貪吃佩可小姐準備了一份禮物哦。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦？",
    "voice": "vo_adv_5004007_053",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　這是",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "什麼呢……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n和我戴在頭上的髮飾一模一樣耶？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是的。",
    "voice": "vo_adv_5004007_054",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "雖然長得一模一樣，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n不過這是有得到特別的神靈庇護的東西。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "有了這個東西的加持，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "所有力量應該都會被強化的。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就算穿著泳裝，",
    "voice": "vo_adv_5004007_055",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "應該還是可以稍微戰鬥。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這次是",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "「皇家裝備」遺失是吧……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們得知裝備遺失，G",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n造成您相當大的困擾。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們也認為要是再碰上同樣的狀況就麻煩了，",
    "voice": "vo_adv_5004007_056",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n這是我們思考了該如何才能在身穿泳裝",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "的狀況下也能作戰，所得出來的方式。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "也算是表示對這次，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "你們相當努力的讚賞。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇，",
    "voice": "vo_adv_5004007_057",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是幫大忙了。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不然這次真的是一直在拖大家的後腿，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n感覺心裡好難受啊～",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵。",
    "voice": "vo_adv_5004007_058",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "真是一場災難呢～",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n那隻盤踞在海底遺跡的魔物，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "會利用牠的手下",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "去搜刮貴重金屬，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n或是人類等較有價值的東西，納為己有。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "「皇家裝備」之所以會被盜走，",
    "voice": "vo_adv_5004007_059",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n或者可可蘿會被擄走都是這個原因導致的吧。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n附近一帶的船舶也是經常遭到襲擊，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "漁獲量因此而大減。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "真的，",
    "voice": "vo_adv_5004007_060",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就是一場大災難的感覺呢。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n魔物就是為人類帶來禍害的生物總稱，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n讓我不禁想起",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那在字典上的定義。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "最近，",
    "voice": "vo_adv_5004007_061",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "各地似乎都有魔物活躍的跡象……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n恐怕再過不久，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n人類社會就會發生",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "傷亡慘重的災難也說不定。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "到時候恐怕就要和這次一樣，",
    "voice": "vo_adv_5004007_062",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n需要再度麻煩各位解決。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "屆時，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就有勞各位幫忙了。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳給我等一下，",
    "voice": "vo_adv_5004007_063",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳剛才是不是說了「這次」？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n花凜～",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "該不會下次妳又要讓我們去搞定類似的事情了吧！？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵。",
    "voice": "vo_adv_5004007_064",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那就要看各位，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "今後的活動表現而定了。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我們是不會去刁難那些平時勤奮努力、",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n表現認真的公會的。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那麼接下來，",
    "voice": "vo_adv_5004007_065",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我還有一些待處理的業務……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "先走一步了哦♪",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，",
    "voice": "vo_adv_5004007_066",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "站住！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　別想逃啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可惡，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "下次再讓我碰到絕不饒她，那個該死的眼鏡女……！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "算了算了啦……",
    "voice": "vo_adv_5004007_067",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "花凜可能也是",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n因為身為【公會管理協會】的職員，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "無可奈何才出此下策吧。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而且，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家現在都平安無事的不是很好嗎。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那只是結果論啊！",
    "voice": "vo_adv_5004007_068",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n啊真是弄得亂七八糟的，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "算了我要大吃特吃了！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n喂店長，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "除了魔物以外的魚",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都給我烤起來！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "好、",
    "voice": "vo_adv_5004007_069",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "好的！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "樂意之至……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_5004007_070",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n只要結尾好",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就一切都好……",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是指這麼一回事呢。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位。",
    "voice": "vo_adv_5004007_071",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n再一次，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感謝諸位",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "救了在下。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "像這樣",
    "voice": "vo_adv_5004007_072",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "大家圍著餐桌聚在一起，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n對在下來說",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是無上的快樂了。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對呀。",
    "voice": "vo_adv_5004007_073",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……妳能平安無事的真是太好了，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小可蘿。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就是說啊～。",
    "voice": "vo_adv_5004007_074",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "說到底還不是小可蘿，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n為了讓{0}逃生，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n居然犧牲了自己而被擄走。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我覺得妳這麼做，",
    "voice": "vo_adv_5004007_075",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n{0}也不會高興的。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳應該更珍惜妳自己才對啊，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小可蘿。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家",
    "voice": "vo_adv_5004007_076",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "都是非常珍惜妳，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "喜歡妳的。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下明白了……",
    "voice": "vo_adv_5004007_077",
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真的很對不起各位。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哎呀，",
    "voice": "vo_adv_5004007_078",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "搞得像是在說教一樣。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "反正不管如何，結果是好的，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n大家就一起愉快地大吃大喝吧！",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "現在可是夏天呢！",
    "voice": "vo_adv_5004007_079",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n難得到了海邊，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n一臉愁眉不展的那可就太沒意思了啊",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
