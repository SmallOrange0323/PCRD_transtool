  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "偌大的塔裡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "回響著戰鬥的聲音。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "喝啊啊啊啊！",
    "voice": "vo_adv_7029004_000",
    "unit_id": 106416
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呼……",
    "voice": "vo_adv_7029004_001",
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呼……",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n就這樣",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "繼續維持覺醒……",
    "voice": null,
    "unit_id": 106416
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "加油──♪",
    "voice": "vo_adv_7029004_002",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊……",
    "voice": "vo_adv_7029004_003",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "唉，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "又不行了啊……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過，",
    "voice": "vo_adv_7029004_004",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我覺得妳有慢慢習慣喔～？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "公主型態也沒有失控。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那是因為……",
    "voice": "vo_adv_7029004_005",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "如果肚子太餓，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "變成那副模樣",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就麻煩了……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "因為變成小嬰兒的雪菲也很可愛，",
    "voice": "vo_adv_7029004_006",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n所以就算那樣我也完全沒問題喔♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n如果真的變了，我就直接帶回家～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我、",
    "voice": "vo_adv_7029004_007",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我才不覺得沒有問題！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "真是的，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "帆稀小姐。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不要捉弄我啦！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我一直都是認真的喔～？",
    "voice": "vo_adv_7029004_008",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "接下來，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這附近的敵人看起來都已經打倒了，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們稍微移動一下吧。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "想找的東西也沒找到呢。",
    "voice": "vo_adv_7029004_009",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我以為在這附近可以找到的～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是不是要再繼續往前呢。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊、",
    "voice": "vo_adv_7029004_010",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗯。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那個……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "帆稀小姐。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "怎麼了怎麼了～？",
    "voice": "vo_adv_7029004_011",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n妳果然",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "想加入【龍族巢穴】了嗎？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那個，",
    "voice": "vo_adv_7029004_012",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這件事的話，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "很抱歉。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "什麼啊～",
    "voice": "vo_adv_7029004_013",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真可惜。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那個……",
    "voice": "vo_adv_7029004_014",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "為什麼",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就算一直被我拒絕，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還是要幫我呢？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "一般來說，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "被拒絕了這麼多次，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就算討厭我也不奇怪。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦？",
    "voice": "vo_adv_7029004_015",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但是……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "從剛剛開始",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "帆稀小姐就一直在邀請我。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n該不會是，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "【龍族巢穴】人手不夠之類的……？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我在想是不是",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "一定要龍人族才行。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "啊哈哈，",
    "voice": "vo_adv_7029004_016",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我太煩人了嗎。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n抱歉喔？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我也常常被大家說呢～",
    "voice": "vo_adv_7029004_017",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "像是嘉夜說",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不曉得我到底是不是在開玩笑～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還有，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n祈梨也說",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我太常用同樣的哏了～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "之類的。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真是的，",
    "voice": "vo_adv_7029004_018",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "希望你能在本人不在的時候再說這種話呢。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我想幫助雪菲的理由……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n當然是",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "為了幸福結局",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "喔。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "幸福結局……？",
    "voice": "vo_adv_7029004_019",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯。",
    "voice": "vo_adv_7029004_020",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "普通平凡的幸福結局是不夠的，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n是為了最棒的幸福結局。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過，",
    "voice": "vo_adv_7029004_021",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "因為雪菲有些地方就是沒辦法讓人丟下不管呢～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就算不是龍人族，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我覺得我也會幫妳喔？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但是",
    "voice": "vo_adv_7029004_022",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "總覺得，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "一直單方面",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "在依賴帆稀小姐……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這樣，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "顯得我真的像個小嬰兒一樣……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "才沒有這種事喔～？",
    "voice": "vo_adv_7029004_023",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n畢竟妳也一直",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "很努力地在當我的助手嘛♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就算是這樣，",
    "voice": "vo_adv_7029004_024",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "也沒有改變我一直受到大家照顧的事實。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "而且不只帆稀小姐……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還有拉比林斯達小姐、",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "伊莉亞小姐和流夏小姐，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n最近甚至",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "連涅妃‧涅羅小姐也一直在幫我……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵，",
    "voice": "vo_adv_7029004_025",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "流夏確實會這樣呢～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "從以前就很喜歡照顧別人，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "沒辦法放著有困難的人不管。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呵呵，",
    "voice": "vo_adv_7029004_026",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "對啊。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n帆稀小姐",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "也認識流夏小姐嗎？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯？",
    "voice": "vo_adv_7029004_027",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "算是吧～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "雖然因為各種原因，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "最近沒什麼見面。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過只要她過得很好，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我想那就好了……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "過年找年菜的時候，",
    "voice": "vo_adv_7029004_028",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我真的一直受到",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "流夏小姐的照顧。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "即便如此，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我也沒有給她任何回報。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "對其他人也是……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那樣也沒關係吧。",
    "voice": "vo_adv_7029004_029",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "能讓人想要幫妳，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這也是一種才能……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不如說，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是種品格吧。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "難道，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "雪菲",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不滿意自己",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "被別人幫助嗎？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "至少，",
    "voice": "vo_adv_7029004_030",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n我覺得",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "一直被幫助的自己很不爭氣。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這樣啊～",
    "voice": "vo_adv_7029004_031",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真是認真呢。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n嗯……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "雪菲，",
    "voice": "vo_adv_7029004_032",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n妳還記得自己",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "快消失時的事情嗎？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦？",
    "voice": "vo_adv_7029004_033",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那個，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗯……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "當然，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還記得。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那時候，",
    "voice": "vo_adv_7029004_034",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "雪菲",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是為了保護大家才消失的……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那是，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "為了回報",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "大家照顧妳的恩情嗎？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我沒有這種打算……",
    "voice": "vo_adv_7029004_035",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "只是，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "想著要",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "保護大家而已。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦？",
    "voice": "vo_adv_7029004_036",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵，",
    "voice": "vo_adv_7029004_037",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "什麼嘛，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳也明白的不是嗎。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "答案很簡單。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們啊，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也都是這麼想的喔。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊……",
    "voice": "vo_adv_7029004_038",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n原來是這樣……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我覺得大家，",
    "voice": "vo_adv_7029004_039",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是按照自己的意願",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "去幫助雪菲的喔。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "所以，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳不需要覺得愧疚。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我所追求的幸福結局，",
    "voice": "vo_adv_7029004_040",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n也是出自於究極的自我滿足喔～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
