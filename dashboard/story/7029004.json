    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "而且，",
    "voice": "vo_adv_7029004_043",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "可能只是妳自己沒注意，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n雪菲其實也幫助了很多人喔。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "所以妳可以",
    "voice": null,
    "unit_id": 106711
  },
  {
