    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿，",
    "voice": "vo_adv_1172003_019",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你來這邊一下！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這是……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒想到海灘居然與這種地方是連通的。",
    "voice": "vo_adv_1172003_020",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "她是不是不小心闖進這裡的深處了？",
