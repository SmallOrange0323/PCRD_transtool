    "words": "\\n你完全不認識我，卻還是幫了我，對吧？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我那時候嚇了一跳。",
    "voice": "vo_adv_1172003_062",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為你這個人",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "完全不認識我啊。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "儘管如此，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你還是幫了我呢。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……我啊，",
    "voice": "vo_adv_1172003_063",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "自從在那一天",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "遇到你後，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n就覺得有在一點一滴地……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "接近以偶像的身分訂定的目標，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也就是理想中的自己。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為有你在，",
    "voice": "vo_adv_1172003_064",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "並且支持著我，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我今天也成功地守住了一位女孩的笑容囉。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我很感謝你。",
    "voice": "vo_adv_1172003_065",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果你以後",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也能繼續支持我，我會很高興的。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "話題太嚴肅啦～",
    "voice": "vo_adv_1172003_066",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然偶像不該太常",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "讓人看到煩惱的一面……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但是你的話應該就沒關係",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "吧。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿嘿♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……剛才說的事情，",
    "voice": "vo_adv_1172003_067",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "希望你能當成我們兩人之間的祕密。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n因為偶像得要一直閃閃發光的才好。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這是為了把難過和悲傷的心情吹跑，",
    "voice": "vo_adv_1172003_068",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "讓大家露出笑容喔！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "background",
    "bg_id": "500691"
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "謝謝你們。",
    "voice": "vo_adv_1172003_069",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n真的是不知道",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "該怎麼和兩位道謝才好……",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "請妳",
    "voice": "vo_adv_1172003_070",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不要放在心上。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "能回到媽媽身邊，真是太好了呢！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "嗯！",
    "voice": "vo_adv_1172003_071",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "大姐姐，",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "謝謝妳～！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "妳救了我的寶貝女兒。",
    "voice": "vo_adv_1172003_072",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "請一定要",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "讓我道謝。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "\\n方便的話，",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "請告訴我妳的名字……",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "單純是我想幫忙而已。",
    "voice": "vo_adv_1172003_073",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n妳就當成是這樣吧──",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "說到這個，",
    "voice": "vo_adv_1172003_074",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "有傳聞說剛才有人在這片沙灘上看到望望喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "怎麼可能啊，",
    "voice": "vo_adv_1172003_075",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "立於巔峰的頂尖偶像，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n哪會特地跑來人潮眾多的海灘來……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "呃，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "嗯？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……嗯，",
    "voice": "vo_adv_1172003_076",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們在海灘上到處跑，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n還想完全不露餡，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這樣的確是",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "想得太美了呢。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我明明想",
    "voice": "vo_adv_1172003_077",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "悠哉地度過接下來的休息時間啊～",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n話雖如此，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "再這樣下去，好像又會造成大騷動。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……事情就是這樣，{0}！",
    "voice": "vo_adv_1172003_078",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "準備好，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要跑囉！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "唱歌的大姐姐，",
    "voice": "vo_adv_1172003_079",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "掰掰～！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯！",
    "voice": "vo_adv_1172003_080",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也會",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "讓自己變得更加出名，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n努力讓妳也能認識我的！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "到了那時候，",
    "voice": "vo_adv_1172003_081",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們就在演唱會現場再見面吧！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "望一邊對揮手的小女孩眨眨眼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一邊牽著{0}的手，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n奔馳在白色的沙灘上。",
    "voice": null,
    "unit_id": null
  }
