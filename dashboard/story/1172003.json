  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在巡演地點的海灘上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n望和{0}聊起今天的計畫。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "之前跟",
    "voice": "vo_adv_1172003_000",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "再之前的假日都引起了騷動，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但我今天",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一定要悠哉地度過假日！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以說呢，",
    "voice": "vo_adv_1172003_001",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們就悠閒地在海邊散步吧。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "以什麼都不做來度過時間也很奢侈呢♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "然後啊，",
    "voice": "vo_adv_1172003_002",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "還可以悠哉欣賞沒入海中的夕陽。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n等到了晚上之後──",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那個……",
    "voice": "vo_adv_1172003_003",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是，",
    "voice": "vo_adv_1172003_004",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有什麼事情嗎？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "請問你們有沒有看到一個小女孩？",
    "voice": "vo_adv_1172003_005",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n我在找我女兒，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "大概",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "有這麼高……",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "小女孩？",
    "voice": "vo_adv_1172003_006",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們沒看到……",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "那",
    "voice": "vo_adv_1172003_007",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "她是不是沒到這個方向來呢……",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "很抱歉，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "打擾你們了。",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": "vo_adv_1172003_008",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "請等一下！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳的女兒走丟了嗎？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "是的，",
    "voice": "vo_adv_1172003_009",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "她不久前還跟我待在一起的，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "但我才一下子沒盯著她，她就跑不見了……",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個……",
    "voice": "vo_adv_1172003_010",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果妳不介意的話，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可以讓我們也來幫忙找嗎？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "咦？",
    "voice": "vo_adv_1172003_011",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "可是，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "這樣太麻煩你們了……",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果妳女兒是和媽媽走散的，",
    "voice": "vo_adv_1172003_012",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我想她現在一定也覺得很不安。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我想趕快找到她，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "讓她放心下來。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝。",
    "voice": "vo_adv_1172003_013",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我相信你一定會願意跟我一起找的。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真抱歉，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "變成要你幫忙了。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "不好意思，",
    "voice": "vo_adv_1172003_014",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "很謝謝你們。",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那我們",
    "voice": "vo_adv_1172003_015",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就往這個方向沿著海岸找找看。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個方向",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就拜託你了！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一段時間後，",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們再回這裡會合喔！",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}，",
    "voice": "vo_adv_1172003_016",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你那邊如何？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有找到嗎？",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也沿著海岸走到了遙遠的另一端，",
    "voice": "vo_adv_1172003_017",
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "卻沒有收穫。",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那位媽媽",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "說她要再去樹林那邊看看。",
