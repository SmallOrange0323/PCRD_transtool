  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾人在與彌勒的交換人質以破局收場後，進入了戰鬥。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在混戰之中，",
