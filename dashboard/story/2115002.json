    "voice": "vo_adv_2115002_017",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n你為什麼事到如今突然在加油啊！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "啥！？",
    "voice": "vo_adv_2115002_018",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "\\n你才是，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "你之前不是說\\n現在的公主只是個吃閒飯的嗎！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "那、",
    "voice": "vo_adv_2115002_019",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "那是……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "也沒辦法吧！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n最近一堆恐怖攻擊耶！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "才讓我覺得她是不工作的稅金小偷……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "可是啊！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "她現在面對那種",
    "voice": "vo_adv_2115002_020",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "比魔物還殘酷還恐怖的東西們，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n只有一個人還是挺身而出了耶！",
