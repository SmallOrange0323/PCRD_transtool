    "type": "dialogue",
    "name": "無賴２",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "明明就可以趁早逃跑，",
    "voice": null,
    "unit_id": 911
  },
