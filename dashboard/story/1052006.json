[
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "似似花～妳在哪～？",
    "voice": "vo_adv_1052006_000",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊，找到了！",
    "voice": "vo_adv_1052006_001",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n這棵",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "樹，是似似花對吧？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……嗯。",
    "voice": "vo_adv_1052006_002",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我應該完美地變化成了樹木才對，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "為什麼妳能看穿呢？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯～感覺氣味不同？",
    "voice": "vo_adv_1052006_003",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不知道為什麼，就是認得出似似花♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "原來如此。",
    "voice": "vo_adv_1052006_004",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n就算外表完美地變化，嗅覺卻沒辦法也欺騙過去嗎？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "值得參考。",
    "voice": "vo_adv_1052006_005",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n看來我的變化能力，尚有改良的餘地呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n如果要可以完全變化，我必要再努力一點。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "至少，要達到『前世』的我的程度……",
    "voice": "vo_adv_1052006_006",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "只能辦到如此不徹底的變化的話，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n可配不上變貌大妃之名。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "前世？\\n變貌大妃？",
    "voice": "vo_adv_1052006_007",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我聽不太懂……\\n",
    "voice": "vo_adv_1052006_008",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那個，從那之後，我思考到了很晚。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我果然還是想變成人類的外貌。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "用這個外貌，在人類的世界裡實在難以生存。",
    "voice": "vo_adv_1052006_009",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n不過人家並不是希望捨棄這個外表。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……就算變化之後，還可以變回來嗎？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "可以。應該說要變換成另一個肉體，",
    "voice": "vo_adv_1052006_010",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n對現在的我來說還有點困難。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "光是只將妳的外表暫時修改成人類的樣子，就精疲力竭了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣啊。\\n那麼就當作嘗試，",
    "voice": "vo_adv_1052006_011",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "能請妳幫我變身嗎？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "雖然有點害怕～\\n不過這種機會，說不定遇不到第二次了。",
    "voice": "vo_adv_1052006_012",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "好的。",
    "voice": "vo_adv_1052006_013",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，請妳摸我的手。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "現在開始我要干涉妳的肉體，使之產生變化。",
    "voice": "vo_adv_1052006_014",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這也是我第一次替他人施術，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n所以要是產生誤差就不好意思了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "人家聽不太懂……\\n那個，會不會痛？",
    "voice": "vo_adv_1052006_015",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n好可怕！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "當然，有產生劇痛的可能性。",
    "voice": "vo_adv_1052006_016",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n這是將肉體像黏土一樣重塑。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "而這原本是不可能的，所以還請妳忍耐一下些許的負擔。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯……\\n那就",
    "voice": "vo_adv_1052006_017",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "拜託妳了，似似花。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "好的。",
    "voice": "vo_adv_1052006_018",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我以變貌大妃之名，賜予妳奇蹟吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……唔。",
    "voice": "vo_adv_1052006_019",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n嗯，大概就是這樣吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "still",
    "still_id": "105200601"
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "…………",
    "voice": "vo_adv_1052006_020",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那個，\\n已經，變化完成了嗎？",
    "voice": "vo_adv_1052006_021",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n總覺得不太有真實感……？",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是的。",
    "voice": "vo_adv_1052006_022",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n要是有事先準備好鏡子就好了呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "感覺如何呢？有沒有哪裡會痛？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不會，沒問題。",
    "voice": "vo_adv_1052006_023",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊，不過有點冷！",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哈、哈啾☆",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "嗯。由於妳的外貌變化成人類的樣子，",
    "voice": "vo_adv_1052006_024",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n原先來自毛皮的保溫效果就消失了呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "事實上，以沒有毛皮來說，妳穿的衣服算是相當單薄。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不過我姑且替妳把裝備的鎧甲等等，",
    "voice": "vo_adv_1052006_025",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n依照比例縮小、調整好了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "幫上大忙了～要是直接穿著原本的鎧甲就會鬆掉了呢。",
    "voice": "vo_adv_1052006_026",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哇～……能完全看到肌膚呢，總覺得很害羞～♪",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哦唷唷？\\n身體的大小改變後，有點難維持平衡……？",
    "voice": "vo_adv_1052006_027",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "感、感覺劍也變得很重。",
    "voice": "vo_adv_1052006_028",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n在這個狀態下，戰鬥是辦不到的呢。",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是的。",
    "voice": "vo_adv_1052006_029",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n請盡可能地避免粗魯的舉動。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在不穩定的狀態下，",
    "voice": "vo_adv_1052006_030",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我想受到一點刺激就會變回原本的樣貌了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n因為本來就是半強迫地使肉體產生變化。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我知道了，我會小心。",
    "voice": "vo_adv_1052006_031",
    "unit_id": 105212
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……唷，好像有腳步聲？",
    "voice": "vo_adv_1052006_032",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n這不是魔物，是人類的腳步聲？",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嘻嘻，耳朵和之前一樣好～♪",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是的。",
    "voice": "vo_adv_1052006_033",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我參考了獸人的外貌，還留著原本的耳朵。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "要是完全變化成普通人類……",
    "voice": "vo_adv_1052006_034",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "和原本的肉體相差甚遠的話，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n會有產生身體機能不完全的可能。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "唔。\\n的確感覺和小栞還有小鈴一樣呢。",
    "voice": "vo_adv_1052006_035",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "比起這個，\\n似似花，妳先躲起來比較好哦。",
    "voice": "vo_adv_1052006_036",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳不太想被其他人看見對吧？",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "畢竟人家的外表變得像人類一樣了，\\n應該不會嚇得人喊『有魔物～』才對。",
    "voice": "vo_adv_1052006_037",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "由人家來好好說服接近的人，替妳把人趕走♪",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是幫了忙呢。",
    "voice": "vo_adv_1052006_038",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "勞妳費心了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不會啦。\\n畢竟似似花實現了人家的夢想呢。",
    "voice": "vo_adv_1052006_039",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "最～喜歡妳了。\\n我們當好朋友吧。",
    "voice": "vo_adv_1052006_040",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果想要什麼謝禮，就盡管說吧♪",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？似似花？",
    "voice": "vo_adv_1052006_041",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n啊啊",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "，又變成樹木躲起來了吧……？",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哦唷。\\n得好好應對接近的人才行。",
    "voice": "vo_adv_1052006_042",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那個，請問是哪位？",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯？\\n啊！",
    "voice": "vo_adv_1052006_043",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n唷呼",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "～♪",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "欸，好過份！",
    "voice": "vo_adv_1052006_044",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n為什麼會說出這種話呢，就好像第一次見面一樣……？",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "（啊，對了，人家的身體變化了呢。",
    "voice": "vo_adv_1052006_045",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n認不出我是莉瑪嗎？）",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯！\\n怎麼了嗎？",
    "voice": "vo_adv_1052006_046",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "怎麼擺出驚慌失措的表情……？",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？\\n為什麼要道歉，還說認錯人了……？",
    "voice": "vo_adv_1052006_047",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "（這樣啊。\\n",
    "voice": "vo_adv_1052006_048",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "他不知道我就是莉瑪呢。",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n因為我變成了人類的樣子。）",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "（雖然就是同一人～\\n",
    "voice": "vo_adv_1052006_049",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但會不會覺得我是『像莉瑪的其他人』？）",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "（怎麼辦。\\n是不是只要說出自己是莉瑪就好了呢？",
    "voice": "vo_adv_1052006_050",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n在繪本裡，要是真實身分被發現就會變回原本的樣子了。）",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "（也不知道變回原樣的契機是什麼，\\n",
    "voice": "vo_adv_1052006_051",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "做任何行動前得小心謹慎才行。",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "預防萬一，對他也隱藏真實身分好了。）",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "（之後再詳細問問似似花，\\n會因為什麼契機變回原本的樣貌。）",
    "voice": "vo_adv_1052006_052",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "（……哦唷，他一臉懷疑地看著我！",
    "voice": "vo_adv_1052006_053",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我想",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "想～？）",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那個，\\n你在找那個叫莉瑪的女孩子嗎？",
    "voice": "vo_adv_1052006_054",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n有什麼事？",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "唔。\\n",
    "voice": "vo_adv_1052006_055",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "叫莉瑪的女孩子似乎很煩惱，",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n【伊麗莎白牧場】的大家都很擔心？",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "所以大家才會拜託你……",
    "voice": "vo_adv_1052006_056",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n來看看狀況嗎？",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣啊～\\n抱歉，讓你們擔心了。",
    "voice": "vo_adv_1052006_057",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過沒事哦，我很有精神啦♪",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊……\\n那個，",
    "voice": "vo_adv_1052006_058",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "人家認為那位叫莉瑪的女孩子也很有精神哦？",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "為什麼能這麼斷定嗎？\\n你這麼問會讓人家有點困擾～？",
    "voice": "vo_adv_1052006_059",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就、就是女人的直覺？",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？\\n你要去哪裡？",
    "voice": "vo_adv_1052006_060",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦，要去找叫莉瑪的女孩子？",
    "voice": "vo_adv_1052006_061",
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "人家就在這裡……啊，現在外表是這樣～？",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105212
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊啊真是的，該怎麼辦才好～！？",
    "voice": null,
    "unit_id": 105212
  }
]
