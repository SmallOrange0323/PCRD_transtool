  {
    "type": "dialogue",
    "name": "旁白",
    "words": "冬天傍晚的天空逐漸靠近，在除夕的神殿裡參拜的客人愈來愈多，\\n{0}一行人也開始忙碌地東奔西走。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "姐姐～。",
    "voice": "vo_adv_5010004_000",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這邊的飲料可以拿嗎？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "年輕人",
    "words": "那麼姐姐，",
    "voice": "vo_adv_5010004_001",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "年輕人",
    "words": "等等也可以給我們兩瓶嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好——！",
    "voice": "vo_adv_5010004_002",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "　我馬上拿過去——！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣已經算不上戒備的工作，",
    "voice": "vo_adv_5010004_003",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n變得只是打雜呢——！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "不好意思！",
    "voice": "vo_adv_5010004_004",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "因為我忘記寫上願望，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n想在這裡寫，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "神殿裡面有可以寫的地方，",
    "voice": "vo_adv_5010004_005",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "沒問題唷！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "這樣啊？",
    "voice": "vo_adv_5010004_006",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "　",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "謝謝您。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "年輕人",
    "words": "妳是警衛嗎？",
    "voice": "vo_adv_5010004_007",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "年輕人",
    "words": "　",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "年輕人",
    "words": "好像有人被偷走錢包。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦咦！？",
    "voice": "vo_adv_5010004_008",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好好——！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　我現在就去！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "在這種時候做壞事的人，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要打屁股喔——！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "background",
    "bg_id": "500551"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗨，",
    "voice": "vo_adv_5010004_009",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原來在這裡啊。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n優衣和日和……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好像被叫去幫忙的樣子呢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好不容易有了一點空閒時間。",
    "voice": "vo_adv_5010004_010",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過也差不多該回去戒備了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也不知道願望什麼時候會再出來。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你也可以陪我一起來嗎。",
    "voice": "vo_adv_5010004_011",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n發生事情的時候，兩個人一起的話比較安心呢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒有這種事。",
    "voice": "vo_adv_5010004_012",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我已經很依靠你的幫忙了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "所以希望你",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不要再說些自輕的話呢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不用說抱歉，",
    "voice": "vo_adv_5010004_013",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你了解就好了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那麼就重新振作起來，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "去巡視吧。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "background",
    "bg_id": "500561"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然人還是一樣多，",
    "voice": "vo_adv_5010004_014",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過沒有異常。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "女性的聲音",
    "words": "這是什麼啊！",
    "voice": "vo_adv_5010004_015",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "女性的聲音",
    "words": "　怎麼會這樣！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有願望實體化了嗎？",
    "voice": "vo_adv_5010004_016",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "　",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "得快一點了！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "可惡！！",
    "voice": "vo_adv_5010004_017",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "　",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "看招啊啊！！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "怎麼回事……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "　我的武器完全打不中！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "……好想找到。",
    "voice": "vo_adv_5010004_018",
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "好想找到……",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們是神殿的警衛！",
    "voice": "vo_adv_5010004_019",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "　很危險的，快退下！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n接下來就交給我們！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "今年的警衛是你們啊。",
    "voice": "vo_adv_5010004_020",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "不好意思，拜託囉！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "好想找到……",
    "voice": "vo_adv_5010004_021",
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "比剛剛的顏色和形體更鮮明……",
    "voice": "vo_adv_5010004_022",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "總覺得用之前的方式對付這傢伙行不通。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你也小心一點。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你說好想找到，",
    "voice": "vo_adv_5010004_023",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是指什麼？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "好……好想……",
    "voice": "vo_adv_5010004_024",
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "找到工作……",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "\\n想在今年以前，",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "找到工作……",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……是從正在求職的參拜客人身上誕生的願望啊。",
    "voice": "vo_adv_5010004_025",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這種狀況，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "該怎麼淨化才好？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "好想……",
    "voice": "vo_adv_5010004_026",
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "找到工作……",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "\\n一直找不到……",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "是為什麼？",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我會幫你找到工作……",
    "voice": "vo_adv_5010004_027",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "又不可能這麼說，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "該怎麼辦……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "……想要更。",
    "voice": "vo_adv_5010004_028",
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "想要，",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "更有精神……",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有、",
    "voice": "vo_adv_5010004_029",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有精神？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "想要更有精神！",
    "voice": "vo_adv_5010004_030",
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "　有精神！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原來如此。",
    "voice": "vo_adv_5010004_031",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也許是看他的心態說不定。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n總之來試試看吧。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然這種事是日和比較擅長，",
    "voice": "vo_adv_5010004_032",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但我也要發揮自己的極限努力看看呢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "……工作。",
    "voice": "vo_adv_5010004_033",
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個……",
    "voice": "vo_adv_5010004_034",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "打起精神！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n明年一定會發生好事唷！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "　就連工作也能找到的！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "……",
    "voice": "vo_adv_5010004_035",
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "唔，",
    "voice": "vo_adv_5010004_036",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我剛剛說的話有哪裡不行的嗎……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "想要",
    "voice": "vo_adv_5010004_037",
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "實體化的願望",
    "words": "更有精神……",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "「更有精神」什麼的……",
    "voice": "vo_adv_5010004_038",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n要怎麼樣才能說出比這個更好的話……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且剛剛的話，",
    "voice": null,
    "unit_id": 108911
  },
  {
