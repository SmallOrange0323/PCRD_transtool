    "type": "dialogue",
    "name": "優衣",
    "words": "那個，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對那種服裝……",
    "voice": null,
    "unit_id": 100213
  },
