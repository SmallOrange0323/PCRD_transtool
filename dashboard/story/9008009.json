    "name": "優衣",
    "words": "騎、",
    "voice": "vo_adv_9008009_011",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生你……",
    "voice": null,
    "unit_id": 100213
  },
