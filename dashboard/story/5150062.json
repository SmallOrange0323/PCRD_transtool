[
  {
    "type": "background",
    "bg_id": "502320"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我說帆稀，",
    "voice": "vo_adv_5150062_000",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n妳可以",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不要那樣嗎？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那樣是哪樣～？",
    "voice": "vo_adv_5150062_001",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我什麼都沒有做喔～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳一邊跟在我後面，",
    "voice": "vo_adv_5150062_002",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n一邊時不時睜開眼睛盯著我這邊吧。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我有注意到喔？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "咦～？",
    "voice": "vo_adv_5150062_003",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我不明白妳在說什麼呢～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "…………",
    "voice": "vo_adv_5150062_004",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "看，就是剛剛！",
    "voice": "vo_adv_5150062_005",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我就是在說不要那樣猛然睜開眼睛！",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "人……",
    "voice": "vo_adv_5150062_006",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是會眨眼的喔……？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "哪可能有那種魄力超強的眨眼。",
    "voice": "vo_adv_5150062_007",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "反正就是那樣吧，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳對嚮導小妖精很好奇吧？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳心想著",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真想調查啊～之類的吧？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真的是有事都沒辦法瞞過愛梅斯呢～",
    "voice": "vo_adv_5150062_008",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不是嘛，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "畢竟愛梅斯的存在可是特殊到",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "連與涅比亞都不同對吧？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n因為很稀奇，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "所以我忍不住就增加了眨眼次數……",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳堅持要說是眨眼呢……",
    "voice": "vo_adv_5150062_009",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "比起那個，愛梅斯，",
    "voice": "vo_adv_5150062_010",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳差不多該休息了吧？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n一路跑下來累了吧？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我會幫妳擦防曬乳喔～？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "依照剛才的發展，",
    "voice": "vo_adv_5150062_011",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我是不可能會說",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "「那就麻煩妳」的吧？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n是怎樣？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "該不會因為是夏天而很興奮吧？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳那對翅膀",
    "voice": "vo_adv_5150062_012",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我也會好好幫妳塗的喔～？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就說不要露出那個眼神了！",
    "voice": "vo_adv_5150062_013",
    "unit_id": 131711
  }
]
