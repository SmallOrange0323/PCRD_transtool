    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怎麼這樣……",
    "voice": "vo_adv_5137301_004",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………攻過來吧。",
    "voice": "vo_adv_5137301_005",
    "unit_id": 135616
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "！",
    "voice": "vo_adv_5137301_006",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "會被附身……",
    "voice": "vo_adv_5137301_007",
    "unit_id": 135616
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "是我們的，",
    "voice": null,
    "unit_id": 135616
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "疏忽……",
    "voice": null,
    "unit_id": 135616
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "所以，",
    "voice": "vo_adv_5137301_008",
    "unit_id": 135514
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不用在意我們……",
    "voice": null,
    "unit_id": 135514
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 135514
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "妳們兩個……",
    "voice": "vo_adv_5137301_009",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……我明白了。",
    "voice": "vo_adv_5137301_010",
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n讓我們心無顧慮地戰鬥吧！",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………好……",
    "voice": "vo_adv_5137301_011",
    "unit_id": 135616
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n不必……",
    "voice": null,
    "unit_id": 135616
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "掛心……",
    "voice": null,
