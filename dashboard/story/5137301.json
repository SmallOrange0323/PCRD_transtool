    "unit_id": 135514
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n大家……",
    "voice": null,
    "unit_id": 135514
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n這已經……",
    "voice": null,
    "unit_id": 135514
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "是我們努力壓制的，",
    "voice": null,
    "unit_id": 135514
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "狀態了……",
    "voice": null,
    "unit_id": 135514
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 135514
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……要趕走精靈，",
    "voice": "vo_adv_5137301_003",
    "unit_id": 128811
  },
