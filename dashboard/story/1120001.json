    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "作為勞煩你們的賠禮兼謝禮，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "這糖果你們收下吧。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n來。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哇哇！",
    "voice": "vo_adv_1120001_056",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我們拿了那麼多也吃不完啊。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "妳就分給那位和妳一起在路上吃東西的朋友吧。",
    "voice": "vo_adv_1120001_057",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "保證味道很好喔。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我知道很好吃啦。",
    "voice": "vo_adv_1120001_058",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們這次真的要走了。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我想我那個",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很貪吃的朋友收到糖果會很開心的。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是啊。",
    "voice": "vo_adv_1120001_059",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n貪吃佩可應該會很開心吧。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？　",
    "voice": "vo_adv_1120001_060",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你說的不是糖果，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而是因為能看見老奶奶開心的表情嗎？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那好像也是……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，",
    "voice": "vo_adv_1120001_061",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "覺得太好了的人是老奶奶，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可不是我喔！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n所以你別在那笑嘻嘻的啦～！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "凱留紅著臉，胡亂揮著糖果。",
    "voice": null,
    "unit_id": null
  }
]
