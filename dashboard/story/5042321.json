[
  {
    "type": "dialogue",
    "name": "黑之王",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 13411
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就算黑之王很強，還是逐漸開始衰弱了呢！",
    "voice": "vo_adv_5042321_000",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n就這樣一鼓作氣……",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦？",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "黑暗",
    "voice": "vo_adv_5042321_001",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "開始往黑之王身邊聚集了……！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "璃乃！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "要是不想辦法解決那股黑暗，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n我們的攻擊就對牠不管用了！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "怎、",
    "voice": "vo_adv_5042321_002",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "怎麼這樣……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n我還以為就快打倒牠的說……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵，",
    "voice": "vo_adv_5042321_003",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我有個作戰計畫，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不用擔心♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真不愧是老大！",
    "voice": "vo_adv_5042321_004",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那麼，",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是怎麼樣的作戰計畫啊？",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "只要大家一起攻擊",
    "voice": "vo_adv_5042321_005",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n直到突破黑暗為止就好啦～☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n感覺很有趣……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我是說很簡單對吧♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不……",
    "voice": "vo_adv_5042321_006",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n那個不叫解決方法，",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n而是單純用蠻力突破……",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "居然能在短短一瞬間就想到這種方法，",
    "voice": "vo_adv_5042321_007",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真不愧是帆稀小姐！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "果然帆稀小姐就是厲害♪",
    "voice": "vo_adv_5042321_008",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "只要攻擊再攻擊不斷攻擊就好了是吧！",
    "voice": "vo_adv_5042321_009",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n這我很擅長！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這些傢伙",
    "voice": "vo_adv_5042321_010",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "果然腦袋空空的啊～！！",
    "voice": null,
    "unit_id": 106612
  }
]
