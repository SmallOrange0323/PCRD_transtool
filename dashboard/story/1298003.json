  {
    "type": "dialogue",
    "name": "旁白",
    "words": "真琴今天依舊對新人施以嚴厲的訓練。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了慰勞那樣的真琴，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}帶著某樣東西造訪了訓練營地。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯？",
