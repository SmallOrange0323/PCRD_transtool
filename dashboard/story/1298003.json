    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "\\n才加入【王宮騎士團】的喔。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "我們也是各自煩惱過後",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "下定了決心，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "現在",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "才在這裡的。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "雖然我們是第一次",
    "voice": "vo_adv_1298003_028",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "進行擊退魔物這種事……",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "但我們也想出一份力！",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "拜託妳了！",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳們……",
    "voice": "vo_adv_1298003_029",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真是的，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "變得很會說了嘛。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我明白了。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "想跟來的傢伙就跟上！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "別遲到了啊！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "原來如此……",
    "voice": "vo_adv_1298003_030",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "確實就如報告所述，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "密密麻麻的。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "感覺光是去數有多少隻都讓人感到厭煩啊。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "冷靜，",
    "voice": "vo_adv_1298003_031",
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "冷靜下來啊我……",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "\\n剛剛還說得那麼振振有辭的，",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "不要害怕啊……！",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "第一次",
    "voice": "vo_adv_1298003_032",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "的實戰……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "為了保護大家，我必須加油才行……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "\\n可是……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "這麼多的魔物……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "最糟的情況，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "我",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "今天",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "就會在這裡……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……我知道啦。",
    "voice": "vo_adv_1298003_033",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "新人們",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n都因為恐懼而畏縮了，這點事我很清楚。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂，",
    "voice": "vo_adv_1298003_034",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "聽好了。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我就老實說了。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我打從一開始",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就沒有把妳們算進戰力裡。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "怎、",
    "voice": "vo_adv_1298003_035",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "怎麼會……！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "\\n沒問題的，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "我們",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "能上……！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳們現在會害怕",
    "voice": "vo_adv_1298003_036",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是正常的反應。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳們還只是訓練中的實習生啊？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n面對眼前大量的魔物，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "手腳會發抖是理所當然的。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "可是，",
    "voice": "vo_adv_1298003_037",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "這樣子",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "我們，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "\\n就只會礙手礙腳而已……！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不要那樣想。",
    "voice": "vo_adv_1298003_038",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n把在安全的地方觀摩戰鬥",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "也想成是訓練的一部分。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "比那些還要更重要",
    "voice": "vo_adv_1298003_039",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "的事情，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是妳們為了保護某人，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "而鼓起勇氣來到這裡。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "只要有那份心，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "總有一天",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "一定能夠成為獨當一面的騎士。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "所以今天，",
    "voice": "vo_adv_1298003_040",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "作為邁向獨當一面的第一步，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n就是去習慣實戰的氣氛。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "只要那樣就行了。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我就是為此才帶妳們來的。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "教官……",
    "voice": "vo_adv_1298003_041",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……那麼。",
    "voice": "vo_adv_1298003_042",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "接下來，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就好好看著吧。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n看著教官戰鬥的模樣！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不，不行！",
    "voice": "vo_adv_1298003_043",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n你絕對別使用那個力量！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……你也試著想想看，",
    "voice": "vo_adv_1298003_044",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "新人們將來出任務時，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n根本不會有人替他們強化。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "然而，作為新人榜樣的我，",
    "voice": "vo_adv_1298003_045",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n卻以接受強化的狀態打倒魔物，這樣像話嗎？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就算向那些傢伙",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "展現教官那樣子的背影，也沒有意義。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……我知道你是在擔心我。",
    "voice": "vo_adv_1298003_046",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但是，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "拜託了。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "讓我在沒有強化的狀態下戰鬥吧。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "──因為，",
    "voice": "vo_adv_1298003_047",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我可是教官啊。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……唉，",
    "voice": "vo_adv_1298003_048",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不論哪個傢伙",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "都這麼會講。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好啊，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "隨你高興吧！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要盡情大鬧了喔！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "still",
    "still_id": "129800301"
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒想到竟然會有這一天，在戰鬥時將後背託付給",
    "voice": "vo_adv_1298003_049",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n原本連握劍方式都不知道的{0}……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n過去的我就算聽了也不會相信吧。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "──你變強",
    "voice": "vo_adv_1298003_050",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "了呢！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "確實，",
    "voice": "vo_adv_1298003_051",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "畢竟我教了你很多東西啊。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n不管是武器的使用方式，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還是戰鬥的方法！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我就來測試你能遵循我當時的指導",
    "voice": "vo_adv_1298003_052",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n到什麼程度！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你可要卯足幹勁啊！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嘿嘿……",
    "voice": "vo_adv_1298003_053",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那麼，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要上囉！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
