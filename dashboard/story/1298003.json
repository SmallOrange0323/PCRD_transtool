    "words": "教官她",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "跟騎士先生在一起時總是很開心的樣子。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "那兩個人",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "是什麼樣的關係呢……？",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "他們兩個的感情這麼好耶？",
    "voice": "vo_adv_1298003_005",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "在我看來，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "他們不只是",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "佐藤",
    "words": "朋友而已吧！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "咦咦！？",
    "voice": "vo_adv_1298003_006",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "也就是說，該不會……！？",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "\\n……我們直接問問看吧，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "佐藤！",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……所以，",
    "voice": "vo_adv_1298003_007",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "公主也說她想上傳影片喔。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "那、",
    "voice": "vo_adv_1298003_008",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "那",
