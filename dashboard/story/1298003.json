    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "所以才會加入【王宮騎士團】！",
