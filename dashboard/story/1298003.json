    "words": "許多人員",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新兵",
    "words": "\\n正忙於應付那邊……！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "也就是說，",
    "voice": "vo_adv_1298003_022",
    "unit_id": 129811
  },
