    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "雖然隱約察覺到對彼此互有好感，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "\\n但還沒有正式交往的階段……",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "就是",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "這麼一回事吧……！！",
