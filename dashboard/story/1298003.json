    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "個！",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "真琴教官、",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "安博",
    "words": "\\n可以耽誤你們一下嗎！？",
