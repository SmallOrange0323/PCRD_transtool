    "name": "真琴",
    "words": "啊啊，",
    "voice": "vo_adv_1298003_003",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "對了，你聽我說喔！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "公主",
    "voice": null,
    "unit_id": 129811
  },
  {
