[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "諾維姆與尾狗刀兩人組隊之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n過了一小段時日。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "喂，尾狗刀！",
    "voice": "vo_adv_5110602_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n我們來決定由誰當隊長吧！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "哇啊～",
    "voice": "vo_adv_5110602_001",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "妳又提出麻煩的事情來了──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "沒有啦，",
    "voice": "vo_adv_5110602_002",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "因為「那群傢伙們」一直都是合力戰鬥，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n才有辦法連戰連勝到現在，不是嗎？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我一直在思考我們跟他們有何不同，",
    "voice": "vo_adv_5110602_003",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "最後想到",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "很可能是因為我們",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "沒有選出隊長的關係！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嗯，",
    "voice": "vo_adv_5110602_004",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "他們那邊",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "固定都是以那傢伙為中心。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不過，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我們這邊基本上只有兩個人吧？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n沒必要選出隊長來吧？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "不，",
    "voice": "vo_adv_5110602_005",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "有必要！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "呵，",
    "voice": "vo_adv_5110602_006",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "妳一點都沒變，還是那麼熱血啊。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不過，",
    "voice": "vo_adv_5110602_007",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "決定好指揮系統",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "的確也不是什麼壞事。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "如果讓諾維姆無拘無束地行動，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "感覺會很危險。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "所以說，",
    "voice": "vo_adv_5110602_008",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我們這就來選出",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "隊長吧！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "聽好了，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "隊長的命令",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "是絕對的！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "不管隊長下達什麼樣的命令，都必須遵守喔！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "哼哼哼！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "哇啊，",
    "voice": "vo_adv_5110602_009",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n就算沒有超能力，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我也很清楚知道妳在心裡所打的邪惡算盤。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我說啊，",
    "voice": "vo_adv_5110602_010",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "諾維姆之所以",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "想當隊長，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n只是想讓我聽命於妳吧？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "啥！？",
    "voice": "vo_adv_5110602_011",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "才、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "才沒這回事！？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n我完全沒有想過",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "要讓怕麻煩的尾狗刀",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n聽命於我喔！？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "……枉費我稍微對妳另眼相看。",
    "voice": "vo_adv_5110602_012",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "那麼，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我們要怎麼決定呢？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n該不會是要手持武器對戰一場吧？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "就是這樣沒錯！",
    "voice": "vo_adv_5110602_013",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n自古以來，不都是這麼決定的嗎！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "最強的人最偉大！",
    "voice": "vo_adv_5110602_014",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "從妳這句發言絲毫感受不到半點領袖風範。",
    "voice": "vo_adv_5110602_015",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "或者說，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "就力量而言，很明顯是妳優於我吧？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n況且妳還帶著一把很危險的劍──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "什麼嘛，",
    "voice": "vo_adv_5110602_016",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "還沒開戰就要投降了嗎？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "隊長就決定由我來當囉！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "好啦好啦，",
    "voice": "vo_adv_5110602_017",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "是我輸了。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "那麼，接著來進行下一場比試──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "咦？",
    "voice": "vo_adv_5110602_018",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "下一場？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不能只靠對妳自己有利的勝負",
    "voice": "vo_adv_5110602_019",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n來決定隊長吧？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n所以，接下來將由我來制定比試的規則。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "唔……",
    "voice": "vo_adv_5110602_020",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "那麼，就以數學來一較高下。",
    "voice": "vo_adv_5110602_021",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我們互相給對方出題，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "像這樣輪流解題下去。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n那我就先來出題……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "等、",
    "voice": "vo_adv_5110602_022",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "等一下！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n這樣一來，絕對是對尾狗刀比較有利啊！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n太卑鄙了！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "咦？",
    "voice": "vo_adv_5110602_023",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "還沒開戰就要投降了嗎？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "那麼，就算我們平手～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n如何？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "要進行下一回合了嗎？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "嗚唔～～～～～！",
    "voice": "vo_adv_5110602_024",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n這樣",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "要比到什麼時候",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n才能決定誰當隊長啊～～～～～～～！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "尾狗刀聽著諾維姆的慘叫聲，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n不禁微微一笑。",
    "voice": null,
    "unit_id": null
  }
]
