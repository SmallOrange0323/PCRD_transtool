[
  {
    "type": "background",
    "bg_id": "500023"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "繼續著逃亡之旅的怜與{0}，\\n被追兵發現後，逐漸失去退路。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這邊也是死路嗎……！",
    "voice": "vo_adv_1089003_000",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "怜小姐，",
    "voice": "vo_adv_1089003_001",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "您已經無路可逃了。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "請死心吧。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "\\n現在回頭的話，老爺還是肯原諒您的。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真纏人！",
    "voice": "vo_adv_1089003_002",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我追求自由有什麼不對！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "……如果您還要繼續抵抗的話，",
    "voice": "vo_adv_1089003_003",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "有可能連您的同伴也受到傷害。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "什麼！",
    "voice": "vo_adv_1089003_004",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "跟他沒有關係吧！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "他跟您一路逃到這裡來，",
    "voice": "vo_adv_1089003_005",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "要說沒有關係，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "是一點說服力都沒有的喔。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "怜小姐跟那位先生很親近的這件事，",
    "voice": "vo_adv_1089003_006",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "\\n我們已經有調查過了。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "基於任務，",
    "voice": "vo_adv_1089003_007",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "為了帶回怜小姐，我們會不擇手段。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "畢竟，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "老爺就是這麼交待下來的。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "來吧。",
    "voice": "vo_adv_1089003_008",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "請您不要抵抗，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "跟我們走。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……到此為止了嗎。",
    "voice": "vo_adv_1089003_009",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "因為，",
    "voice": "vo_adv_1089003_010",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "已經無路可逃了……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n更何況，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果因為我的關係讓你受到危害，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也不能接受。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……謝謝你一路上的陪伴。",
    "voice": "vo_adv_1089003_011",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是到此為止吧。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我不能再",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "繼續把你捲進來了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……要是會失去重要的夥伴，",
    "voice": "vo_adv_1089003_012",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那還是老實的照父親的意思走就好了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我知道了，",
    "voice": "vo_adv_1089003_013",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我投降！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不准碰他一根寒毛！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "很明智的判斷，",
    "voice": "vo_adv_1089003_014",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "請移駕到這邊。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "\\n我們為您安排馬車。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說到底都是不可能實現的願望嗎……",
    "voice": "vo_adv_1089003_015",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日和、",
    "voice": "vo_adv_1089003_016",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還有連你也都得失去的話，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我寧願放棄「自我」。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣就好了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣子……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "──！！",
    "voice": "vo_adv_1089003_017",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是的……",
    "voice": "vo_adv_1089003_018",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還真是狡猾呢，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你這個人啊。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "聽到這種話，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不就又讓我的決心動搖了嗎。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "喂，放開手！",
    "voice": "vo_adv_1089003_019",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "就算您是跟怜小姐關係曖昧的男人，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "\\n再有更過分的行為我們可不能容忍！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "怜小姐也請您",
    "voice": "vo_adv_1089003_020",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "說服您的情人！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "什麼、",
    "voice": "vo_adv_1089003_021",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不、",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他不是什麼情人……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "跟剛才的貴族一樣誤會了……",
    "voice": "vo_adv_1089003_022",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真麻煩啊。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "該怎麼跟父親說明才好……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……啊啊，",
    "voice": "vo_adv_1089003_023",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果這樣的話，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就乾脆麻煩到底好了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……那個，",
    "voice": "vo_adv_1089003_024",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n既然你都這麼阻止我放棄了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不論什麼事情你都會幫忙吧？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是嗎。",
    "voice": "vo_adv_1089003_025",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那就開始囉，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不要動喔……！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "still",
    "still_id": "108900301"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……拜託你。",
    "voice": "vo_adv_1089003_026",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "暫時，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "維持這樣子。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "什麼！？",
    "voice": "vo_adv_1089003_027",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "怜、",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "怜小姐！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "\\n在這種眾目睽睽的地方，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "做出那種行為……！！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謠言就讓它越描越黑好了……",
    "voice": "vo_adv_1089003_028",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n為了讓他們相信，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我的決心是貨真價實的。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "不准看！",
    "voice": "vo_adv_1089003_029",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "絕對不准看啊！！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "直到我說可以睜眼之前，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "都要閉上眼睛！！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "是，",
    "voice": "vo_adv_1089003_030",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "是的！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看來是很順利了。",
    "voice": "vo_adv_1089003_031",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "儘管讓他們看吧。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "臉靠得好近……",
    "voice": "vo_adv_1089003_032",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "感覺得到肌膚的溫度。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就算想別過視線，",
    "voice": "vo_adv_1089003_033",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "卻還是移不開……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n還有微熱的吐息……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "居然和你靠得這麼近……",
    "voice": "vo_adv_1089003_034",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對我來說還真是大膽……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果有天不是和你演戲，",
    "voice": "vo_adv_1089003_035",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就這樣子真的……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還是別想了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "繼續下去的話優衣會生氣的。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "香味？",
    "voice": "vo_adv_1089003_036",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "到處跑來跑去的留了些汗，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我想應該沒有那種事……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……總感覺突然想要放開你了。",
    "voice": "vo_adv_1089003_037",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不要問理由。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "所以拜託了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嚇得都不敢問了，",
    "voice": "vo_adv_1089003_038",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但我好像沒有汗味。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "太好了呢……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不用在意",
    "voice": "vo_adv_1089003_039",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那種事情。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n現在也不是講求什麼矜持的時候了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且……",
    "voice": "vo_adv_1089003_040",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒有什麼汗味啊。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我反而覺得這味道還不錯……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "剛剛的就忘了吧。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "到底在亂說什麼啊我。",
    "voice": "vo_adv_1089003_041",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n……或許是因為氣氛剛好呢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……也差不多了。",
    "voice": "vo_adv_1089003_042",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "放開吧……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "background",
    "bg_id": "500023"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呼……",
    "voice": "vo_adv_1089003_043",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "怎麼樣！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣就明白了吧？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "怎麼會……",
    "voice": "vo_adv_1089003_044",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "去吧，",
    "voice": "vo_adv_1089003_045",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "回去告訴我父親！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我已經有了要託付終身的對象！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我是絕對，",
    "voice": "vo_adv_1089003_046",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不會讓那個人稱心如意的！！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "怜小姐，",
    "voice": "vo_adv_1089003_047",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "您這樣……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "會有怎樣的後果，我們可不能保證啊。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "\\n……撤退了！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "……怜小姐。",
    "voice": "vo_adv_1089003_048",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "失禮了。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呼……",
    "voice": "vo_adv_1089003_049",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "順利挨過了呢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝你願意幫我。",
    "voice": "vo_adv_1089003_050",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這麼一來，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "至少在父親的下一道命令前，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n可以暫時平穩的過日子吧。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是……",
    "voice": "vo_adv_1089003_051",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "剛才說什麼託付終身的，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那句只是逢場作戲而已，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我到現在都沒考慮過。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對我來說可真是不切實際呢……",
    "voice": "vo_adv_1089003_052",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "明明連未來會怎樣都不知道……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "咦？",
    "voice": "vo_adv_1089003_053",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊……",
    "voice": "vo_adv_1089003_054",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是這樣沒錯。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就像你說的。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "把和重要的夥伴的約定、",
    "voice": "vo_adv_1089003_055",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "重要的願望實現。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "為了那樣的未來，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我才會生存下去。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……再跟你說一聲，",
    "voice": "vo_adv_1089003_056",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n多虧了你，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我才能繼續走在自己的路上。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "對{0}這樣說著的怜，\\n朝向期盼著的未來，踏出了嶄新的一步。",
    "voice": null,
    "unit_id": null
  }
]
