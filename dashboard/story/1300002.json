    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "啊啊？",
    "voice": "vo_adv_1300002_038",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這邊……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "從我身上！？",
