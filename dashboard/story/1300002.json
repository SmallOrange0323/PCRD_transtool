    "name": "員工",
    "words": "啊啊……！",
    "voice": "vo_adv_1300002_033",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n被夾在中間，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "小哥的眼神開始渙散了……！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "啊啊……！",
