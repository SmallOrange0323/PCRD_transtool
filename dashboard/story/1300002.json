[
  {
    "type": "background",
    "bg_id": "500250"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和倭一起逃離追兵。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人潛入了",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "位於蘭德索爾地下的賭場。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "好久沒來這裡了，",
    "voice": "vo_adv_1300002_000",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n果然賭場的空氣很甜美呢。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "啊哈哈，",
    "voice": "vo_adv_1300002_001",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那當然了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n要躲藏起來的話這種不三不四的地方最適合了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "咦？",
    "voice": "vo_adv_1300002_002",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "從外表看不出來，你其實很會玩嗎？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n那可能也不需要我的說明──",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這裡是魔物大賽會場。",
    "voice": "vo_adv_1300002_003",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n一直逃跑的話太無聊了，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "來玩一下吧。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n快過來小子！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "歡迎光臨。",
    "voice": "vo_adv_1300002_004",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n歡迎來到第224屆",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "怪物大賽的會場！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "這位客人，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "您要押多少賭金呢？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "當然是，",
    "voice": "vo_adv_1300002_005",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這邊有的錢全部了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我押單勝。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "全額押單勝！？",
    "voice": "vo_adv_1300002_006",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "客、",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "客人，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "真是賭徒呢……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嗯？",
    "voice": "vo_adv_1300002_007",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "怎麼了小子。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n難道連你也要對我用錢的方式指指點點的？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "真是的，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你們每個人都吵死人了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "聽好了。",
    "voice": "vo_adv_1300002_008",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我們家的錢就是我的錢。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "想怎麼花都是我的自由。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "而且如果生活費倍增了，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "若菜也一定會很開心。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "賭博這種東西，",
    "voice": "vo_adv_1300002_009",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "就是可能失去的東西越重要才越有趣啦。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "僅有一次的勝負竟然賭上了人生，",
    "voice": "vo_adv_1300002_010",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "呵呵呵，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "超令人興奮的啊……！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哈哈哈，",
    "voice": "vo_adv_1300002_011",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那真是太好了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n累積了很多社會經驗呢♪",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那麼，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "下一個比賽是……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "………………",
    "voice": "vo_adv_1300002_012",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嗯？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n那是怎麼了。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n怎麼會有客人跑進賽道內。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "顧客１",
    "words": "嘿嘿嘿……♪",
    "voice": "vo_adv_1300002_013",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "嘻嘻嘻……",
    "voice": "vo_adv_1300002_014",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……那些傢伙，",
    "voice": "vo_adv_1300002_015",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "是在做什麼。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──喂！",
    "voice": "vo_adv_1300002_016",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "給我馬上讓開！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "顧客１",
    "words": "好、",
    "voice": "vo_adv_1300002_017",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "顧客１",
    "words": "好痛痛痛痛！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "顧客１",
    "words": "\\n妳在做什麼啊大姐！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "給我老實說。",
    "voice": "vo_adv_1300002_018",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n你們剛剛是不是打算在賽道中動手腳？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n想出老千？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "出、",
    "voice": "vo_adv_1300002_019",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "出老千！？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "才、",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "才沒有那個打算呢。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "要找碴也該適可而止吧！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "\\n我們是在賽道拍紀念照……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "沒有做其他事！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "妳這傢伙才是",
    "voice": "vo_adv_1300002_020",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "明明沒有證據還突然抓住別人的脖子！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "\\n快為妳的失禮道歉！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "小子你安靜！",
    "voice": "vo_adv_1300002_021",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……我啊，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "最討厭的就是賭場被搗亂了！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "在這種地方，",
    "voice": "vo_adv_1300002_022",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "就不要做會令人懷疑的舉動，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我是在教你們難道不懂嗎，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這群蠢貨！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "顧客１",
    "words": "妳說什麼！",
    "voice": "vo_adv_1300002_023",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "顧客１",
    "words": "\\n就說我們什麼都沒做了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……想吵架嗎。",
    "voice": "vo_adv_1300002_024",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "啊啊啊啊啊啊！？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "顧客１",
    "words": "喔喔喔喔喔喔！？",
    "voice": "vo_adv_1300002_025",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "啊啊啊啊啊啊啊啊啊啊！？",
    "voice": "vo_adv_1300002_026",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "喔喔喔喔喔喔喔喔喔喔！？",
    "voice": "vo_adv_1300002_027",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "哇哇哇哇……！",
    "voice": "vo_adv_1300002_028",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n怎怎怎怎怎麼辦……！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n這樣沒辦法開始比賽啊……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "小子。",
    "voice": "vo_adv_1300002_029",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n不要妨礙我們",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "快讓開！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "沒錯，",
    "voice": "vo_adv_1300002_030",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "妨礙到我們吵架了！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "\\n就叫你滾開了小伙子！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "喔喔喔喔喔喔喔喔喔",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "喔！？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這傢伙，",
    "voice": "vo_adv_1300002_031",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "誰准你這樣吼我的同伴了！",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "啊啊啊啊啊啊啊啊啊",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "啊啊啊！？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "啊啊！",
    "voice": "vo_adv_1300002_032",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "小哥被夾在啊跟喔的中間了……！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "不行啊小哥，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "待在那邊會有生命危險！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n小哥，",
    "voice": null,
    "unit_id": 2511
  },
  {
