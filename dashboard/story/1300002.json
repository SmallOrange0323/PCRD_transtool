    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你在害怕嗎。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n從剛剛開始看起來就不太對勁呢？",
