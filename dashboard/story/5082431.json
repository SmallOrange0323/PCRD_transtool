[
  {
    "type": "background",
    "bg_id": "501160"
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "蒐集年菜材料之旅，",
    "voice": "vo_adv_5082431_000",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "要結束了呢……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "中途發生了許多事，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還覺得這趟旅程有點漫長，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n論實際時間，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "卻是比想像中還要短很多呢。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "獨自旅行的時候",
    "voice": "vo_adv_5082431_001",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要考慮的事無論如何都會很多，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n自然會覺得漫長。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "發生了很多事",
    "voice": "vo_adv_5082431_002",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "倒也是事實。",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "取回那些被奪走的材料",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "可是費了不少力氣……",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那時候真的",
    "voice": "vo_adv_5082431_003",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "謝謝妳們。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n有兩位陪伴著",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "真是幫大忙了。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不必在意。",
    "voice": "vo_adv_5082431_004",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這次不是和平常的成員一同旅行，",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身也玩得很愉快。",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "而且年菜也相當美味。",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也過得很開心喔。",
    "voice": "vo_adv_5082431_005",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n和至今的獨自旅行相比",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "又是別有一番風情。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我也是，",
    "voice": "vo_adv_5082431_006",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "能夠和大家一起旅行真是太好了。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這麼重要的回憶，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我絕對不想忘記。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼，",
    "voice": "vo_adv_5082431_007",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "讓我們開始最後的奮鬥吧。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "來，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "出發！",
    "voice": null,
    "unit_id": 120811
  }
]
