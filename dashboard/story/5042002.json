  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了找尋黑之王的線索，一行人來到鎮上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n除了愛麗絲之外，所有人都對眼前有趣的景象驚嘆不已。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哇啊啊啊啊……！",
    "voice": "vo_adv_5042002_000",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n好特別的城鎮喔～！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "是嗎？",
    "voice": "vo_adv_5042002_001",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n在我看來這很尋常，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "沒什麼特別的啊。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "很特別喔。",
    "voice": "vo_adv_5042002_002",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "比起城鎮和景色，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "愛麗絲妳本身就很可愛、很特別呢。",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這麼出色的設計……",
    "voice": "vo_adv_5042002_003",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要不是現在場合不對，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我都想畫下來了。",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "哈哈哈！",
    "voice": "vo_adv_5042002_004",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n聽見妳這麼誇獎，我很開心～♪",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嘿，璃乃！",
    "voice": "vo_adv_5042002_005",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n那我們要",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "先從什麼事情著手呢？",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這個嘛，",
    "voice": "vo_adv_5042002_006",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "總之，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要不要先試著打聽關於黑之王的情報呢？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖然路上沒什麼人啦……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "了～解！",
    "voice": "vo_adv_5042002_007",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "走吧，步未。",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們一起去～！！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗚哇！？",
    "voice": "vo_adv_5042002_008",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "日、",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "日和，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "妳別拉著我呀～！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，",
    "voice": "vo_adv_5042002_009",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呃……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "她們走掉了。",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那麼，哥哥，",
    "voice": "vo_adv_5042002_010",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "愛麗絲，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們一起努力吧。",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "……要是能那麼順利就好了。",
    "voice": "vo_adv_5042002_011",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦？",
    "voice": "vo_adv_5042002_012",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "什麼意思呀？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "看看先行動的那兩個人就會明白了。",
    "voice": "vo_adv_5042002_013",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n妳看，她們在那裡。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "喲，小妹妹們，",
    "voice": "vo_adv_5042002_014",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "妳們是生面孔吧。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "是來旅行的嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是的。",
    "voice": "vo_adv_5042002_015",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "想向您請教一件事，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不曉得您知不知道……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們",
    "voice": "vo_adv_5042002_016",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "正在尋找黑之王的所在之處！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "！！？？",
    "voice": "vo_adv_5042002_017",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "呸、呸呸！！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n妳們兩個在胡說八道什麼！？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "咦？",
    "voice": "vo_adv_5042002_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "剛、",
    "voice": "vo_adv_5042002_019",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "剛才的話，我會假裝沒聽見的。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n我走了！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊，",
    "voice": "vo_adv_5042002_020",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那個，",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "等一下……",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n她走掉了。",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "日和，",
    "voice": "vo_adv_5042002_021",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "步未！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "璃乃。",
    "voice": "vo_adv_5042002_022",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我們剛才試著向居民搭話，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但對方卻發了一頓脾氣……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "可惜，",
    "voice": "vo_adv_5042002_023",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我們好像來晚了一步。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "黑之王帶來的影響",
    "voice": "vo_adv_5042002_024",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "似乎也已經擴散到這座城鎮了。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "璃乃，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "雖然我們才剛抵達這裡，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "但最好趕快離開這座城鎮。",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "……就是妳們幾個嗎？",
    "voice": "vo_adv_5042002_025",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n聽說妳們四處打聽黑之王的事啊？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那個，",
    "voice": "vo_adv_5042002_026",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你是什麼人？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "哈哈哈……",
    "voice": "vo_adv_5042002_027",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "我可是瞭若指掌喔……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n凡是關於黑之王的大小事，我都一清二楚……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真、",
    "voice": "vo_adv_5042002_028",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n請你務必",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "告訴我們",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "關於黑之王的事！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "嗯，我就告訴你們吧……",
    "voice": "vo_adv_5042002_029",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n黑之王的所在之處……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "就是黑暗本身……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "所以…………",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "我要把你也送進黑暗的深淵！",
    "voice": "vo_adv_5042002_030",
    "unit_id": 1111
  },
  {
    "type": "background",
    "bg_id": "501010"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥、",
    "voice": "vo_adv_5042002_031",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥！？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n得救了……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "謝、",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "謝謝哥哥！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "居然被擋下了……",
    "voice": "vo_adv_5042002_032",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "那我也要拿出真本事了！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "！！？？",
    "voice": "vo_adv_5042002_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這、",
    "voice": "vo_adv_5042002_034",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這種不舒服的感覺……",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是怎麼回事……！！",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可能是因為得到了愛麗絲的力量……",
    "voice": "vo_adv_5042002_035",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我感覺得出來！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n這個人",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是黑之王的同夥！！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "……這麼快就出現啦。",
    "voice": "vo_adv_5042002_036",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n上吧，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "璃乃，妳出場的時候到了！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "驅除他身上的黑暗！！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
