    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊～！",
    "voice": "vo_adv_1146004_005",
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是{0}耶～哈囉～！",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "聖誕～",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "快樂～！",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我是聖誕大姐姐優花梨唷～",
