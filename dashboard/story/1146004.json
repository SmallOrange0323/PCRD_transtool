  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "嗯，",
    "voice": "vo_adv_1146004_007",
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "放心啦～",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我有好好把工作做完才喝酒哦～～",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "話說啊，明明年底放假卻把我叫去上班～",
    "voice": "vo_adv_1146004_008",
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n結果自己跑回家陪老婆小孩，不覺得我上司很過分嗎～？",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "他知不知道聖誕節對單身女性有多重要啊！！",
    "voice": "vo_adv_1146004_009",
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n就算是我啊？",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "在聖誕節這天也想",
    "voice": null,
    "unit_id": 103433
