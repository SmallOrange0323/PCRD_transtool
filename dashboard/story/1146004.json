  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "正值深夜，優花梨和{0}在返家的路上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這次這麼突然邀請你，真的很抱歉。",
    "voice": "vo_adv_1146004_000",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n今天發生了很多事……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但我玩得非常盡興喔。",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "到這裡我就能自己回去了……",
    "voice": "vo_adv_1146004_001",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呵呵，",
    "voice": "vo_adv_1146004_002",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那就恭敬不如從命吧。",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "正好街道因為聖誕節的燈飾這麼明亮……",
    "voice": "vo_adv_1146004_003",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊，",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好像不只燈飾亮啊。",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這道光是……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呀，",
    "voice": "vo_adv_1146004_004",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好刺眼……！",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "background",
    "bg_id": "510352"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}走到因為聖誕節而熱鬧起來的車站前，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n被一個熟識的人叫住了。",
