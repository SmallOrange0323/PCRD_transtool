    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你能懂吧？",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "豪華的晚餐、",
    "voice": "vo_adv_1146004_010",
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "漂亮的燈飾，",
    "voice": null,
    "unit_id": 103433
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "還有交換禮物……",
    "voice": null,
    "unit_id": 103433
