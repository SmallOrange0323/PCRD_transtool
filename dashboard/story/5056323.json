[
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗚嗚……",
    "voice": "vo_adv_5056323_000",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也到極限了……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可是……！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "只差一點點，",
    "voice": "vo_adv_5056323_001",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就快了……！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的！",
    "voice": "vo_adv_5056323_002",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "即將分出高下了……！",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "……！",
    "voice": "vo_adv_5056323_003",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "小兄弟和小姑娘們都繃緊了神經……",
    "voice": "vo_adv_5056323_004",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n鎮上那幫漁夫",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "也全都在作戰……！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "是啊，",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "這種情況下我怎麼可能放棄呢……！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "要上啦，",
    "voice": "vo_adv_5056323_005",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "各位！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n這是最後的大決戰了！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……",
    "voice": "vo_adv_5056323_006",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n和正大叔……！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……為了小鎮、",
    "voice": "vo_adv_5056323_007",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為了大間的人們……",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n和正先生的這份心意，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下等人也會陪著您",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "直到您達成心願的！",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "交給我吧，",
    "voice": "vo_adv_5056323_008",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "和正先生！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我絕對會把牠釣上來的！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "嘿……",
    "voice": "vo_adv_5056323_009",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n你們真是一群",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "可靠的弟子啊。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "好啦──",
    "voice": "vo_adv_5056323_010",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "做個了結吧！！",
    "voice": null,
    "unit_id": 6411
  }
]
