  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "晚宴順利結束的幾天後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}與薇歐莉特來到吉歐‧尼布爾黑爾的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n某個邊境村子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……到了，",
    "voice": "vo_adv_1380003_000",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n看來就是這裡沒錯。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……前幾天",
    "voice": "vo_adv_1380003_001",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "出現在晚宴上的暗殺者，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n就是在這個村子接下殺害我的委託──",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "…………\\n……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502460"
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "……不、",
    "voice": "vo_adv_1380003_002",
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "不行！",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "\\n薇歐莉特公主和騎士閣下，",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "只有兩位前往村子……",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "\\n這種事我可不同意！",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "那村子的代表",
    "voice": "vo_adv_1380003_003",
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "也沒有參加",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "前幾天的晚宴。",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "\\n如今殺手的委託失敗，",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "或許正在進一步謀劃造反行動。",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "\\n要去那樣的地方……",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "至少",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "讓無頭騎士的騎士團同行──",
    "voice": null,
    "unit_id": 52612
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "──不行。",
    "voice": "vo_adv_1380003_004",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "雖然管家爺爺會擔心很正常……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "但是武裝士兵成群結隊過去的話，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "一定會讓對方心懷警戒，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n這樣就沒辦法談話了。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "請你答應我吧，",
    "voice": "vo_adv_1380003_005",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "管家爺爺。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "杜蘭",
    "words": "……",
    "voice": "vo_adv_1380003_006",
    "unit_id": 52612
  },
  {
    "type": "background",
    "bg_id": "502440"
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……呵呵。",
    "voice": "vo_adv_1380003_007",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "若是以前的管家爺爺，",
    "voice": "vo_adv_1380003_008",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "絕對不可能",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "會允許這種危險的事。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "但他",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "卻答應讓我們兩人出發……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "這也就是說，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n他",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "是不是稍微認同我一點了呢……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "當然，",
    "voice": "vo_adv_1380003_009",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "有騎士先生一起……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "這一點，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n應該是最大的因素。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎士先生……",
    "voice": "vo_adv_1380003_010",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "謝謝您。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n……這句話",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "令我心中充滿勇氣。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "好，",
    "voice": "vo_adv_1380003_011",
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "總算收集到武器了……！",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "\\n",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "雖然只有生鏽的鈍刀……",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "但只能上了！！",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "\\n就用這個把那傢伙給──",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "咦……？",
    "voice": "vo_adv_1380003_012",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "難、",
    "voice": "vo_adv_1380003_013",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "難道說",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "他們正在策劃造反行動……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "雖說已經預料到了……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "但真的是……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……咦？",
    "voice": "vo_adv_1380003_014",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n的、",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "的確呢，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "村裡的各位看起來不像──",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "魔物的集團",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……！",
    "voice": "vo_adv_1380003_015",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "那些奇怪的魔物，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "難道是……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "出、",
    "voice": "vo_adv_1380003_016",
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "出現了──！",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "\\n年輕人拿起武器！",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "老年人和小孩子前往避難所！",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "村民們",
    "words": "哦哦哦……！！",
    "voice": "vo_adv_1380003_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "是的，",
    "voice": "vo_adv_1380003_018",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "而且力量",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "也非常強大。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n那般粗糙的武器，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "根本無法抗衡……！",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "尤克！",
    "voice": "vo_adv_1380003_019",
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "布爾布！",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "烏修布茲爾！",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n……我們上！",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n皇權怠惰……！",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "background",
    "bg_id": "502440"
  },
  {
    "type": "dialogue",
    "name": "魔物的集團",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……呼。",
    "voice": "vo_adv_1380003_020",
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "看來",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "魔物暫時撤退了呢。",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n各位，",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "你們沒受傷吧……？",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "妳、",
    "voice": "vo_adv_1380003_021",
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "妳是",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "薇歐莉特……",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "公主。",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "……嘖，",
    "voice": "vo_adv_1380003_022",
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "看來事跡敗露了啊。",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "\\n",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "委託殺手",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "去暗殺妳的人",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "就是我……",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "少女殭屍",
    "words": "哥、",
    "voice": "vo_adv_1380003_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女殭屍",
    "words": "哥哥……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "妳不要說話。",
    "voice": "vo_adv_1380003_024",
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "\\n",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "……話先說在前頭，",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "這跟村裡的人",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "無關。",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "\\n",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "要懲罰的話，",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "就針對我──",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……請你",
