  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "\\n",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
    "words": "才不會回應",
    "voice": null,
    "unit_id": 314
  },
  {
    "type": "dialogue",
    "name": "青年殭屍",
