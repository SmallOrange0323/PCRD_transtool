    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "先從四面攻擊，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "瓦解對方的守勢。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……她很冷靜，",
    "voice": "vo_adv_5208322_002",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且從宏觀的角度掌握了戰況。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是厲害……",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "總有一天我也要到達這種領域……",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "怜，",
    "voice": "vo_adv_5208322_003",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "妳行嗎？",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不好意思，志那都。",
    "voice": "vo_adv_5208322_004",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我來配合妳！",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
