  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我們",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "總是在互相殘殺呢。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "這個嘛，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "對於喜歡糾纏人的我來說，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n即使如此也很愉快。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "但是……",
