    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "真是的，",
    "voice": "vo_adv_1182001_003",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "討厭──★",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "不要用那麼害怕的表情",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "看著我嘛♪",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "現在的我",
    "voice": "vo_adv_1182001_004",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "不是【憤怒‧軍團】的成員，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n只是個普通的女孩子★",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我不會做任何",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "會讓騎士同學生氣的事情喔？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "呵呵★",
    "voice": "vo_adv_1182001_005",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "那當然是……",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "來跟騎士同學",
    "voice": "vo_adv_1182001_006",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "約會的呀★",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "哇★",
    "voice": "vo_adv_1182001_007",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n不愧是騎士同學，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "已經很習慣跟女孩子相處了呢──♪",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "嗯～",
    "voice": "vo_adv_1182001_008",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "那我們要做什麼呢。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n坦白說我以為我九成會被拒絕，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n所以沒有任何計畫♪",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "原來如此原來如此★",
    "voice": "vo_adv_1182001_009",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "總之",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "就先在這附近隨意逛逛吧♪",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "那麼，",
    "voice": "vo_adv_1182001_010",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n我們就恩恩愛愛地",
