    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船員",
    "words": "\\n你們搞什麼啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "偷渡客嗎！？",
    "voice": "vo_adv_1182001_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n剛才是躲在哪裡！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "嗯──",
    "voice": "vo_adv_1182001_022",
    "unit_id": 192012
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n引起騷動了呢。",
    "voice": null,
    "unit_id": 192012
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "啊★",
    "voice": "vo_adv_1182001_023",
    "unit_id": 192012
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n我想到了一個好點子♪",
    "voice": null,
    "unit_id": 192012
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192012
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "把這些人當成魚餌──",
