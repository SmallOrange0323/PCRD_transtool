    "voice": "vo_adv_1182001_092",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "在這之前。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "看到了不管發生什麼事",
