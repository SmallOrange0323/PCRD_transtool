    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "緊緊貼在一起──",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "咦──",
    "voice": "vo_adv_1182001_011",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "又沒關係。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "明明騎士同學",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "身邊的女孩子",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n總是一個換一個──",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "而、",
    "voice": "vo_adv_1182001_012",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "且、",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "呀──",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n就算騎士同學說不要──？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "嘿★",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
