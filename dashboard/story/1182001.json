  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我們一起經歷過",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "那麼多次互相殘殺不是嗎★",
