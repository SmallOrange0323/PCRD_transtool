    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "如果「緊抱」深愛的人，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "心臟也會「揪」一下，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "或是覺得",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "「心動★」吧。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "……果然，",
    "voice": "vo_adv_1182001_097",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "還沒。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n現在的我",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "對騎士同學的感情不是愛，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "而是比較像喜歡呢──",
