    "voice": "vo_adv_1182001_093",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我",
    "voice": "vo_adv_1182001_094",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "喜歡",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "騎士同學喔？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "是千真萬確的。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "如果要談戀愛的話，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "對象是騎士同學就太好了呢。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "可是可是……",
    "voice": "vo_adv_1182001_095",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "嗯～",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "悸動",
    "voice": "vo_adv_1182001_096",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "的感覺似乎還不夠。",
