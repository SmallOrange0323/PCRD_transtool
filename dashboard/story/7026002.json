  {
    "type": "dialogue",
    "name": "露娜",
    "words": "…………",
    "voice": "vo_adv_7026002_002",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……她是不是",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "討厭露娜了呢。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……為什麼？",
    "voice": "vo_adv_7026002_003",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "真奇怪……",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "好奇怪，",
    "voice": "vo_adv_7026002_004",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "但又有點好玩。",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "…………露娜不知道。",
    "voice": "vo_adv_7026002_005",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "不過……",
