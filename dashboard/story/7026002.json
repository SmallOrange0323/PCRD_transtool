    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "露娜……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我有一件事想告訴妳……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……告訴露娜？",
    "voice": "vo_adv_7026002_014",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "妳有興……",
    "voice": "vo_adv_7026002_015",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "聊的話……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不好意思！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我重來一次！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "妳有……",
    "voice": "vo_adv_7026002_016",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "有……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "有……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "──YO！",
    "voice": "vo_adv_7026002_017",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n日安喲！！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "露娜之塔with露娜！",
    "voice": "vo_adv_7026002_018",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n真是讓人精神煥發！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "想要友誼增長、決意上場、白忙一場！",
    "voice": "vo_adv_7026002_019",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n重新開始的人生！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "下跪道歉的檢討聲！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "放手一搏再接再厲！",
    "voice": "vo_adv_7026002_020",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "想和妳聊……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "聊……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "療癒身心──！！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "…………",
    "voice": "vo_adv_7026002_021",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "碧滿臉通紅地僵在原地，露娜滿臉困惑地僵在原地。",
