    "words": "…………\\n……露娜也有點想跟她玩。",
    "voice": "vo_adv_7026002_010",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "…………聊天。",
    "voice": "vo_adv_7026002_011",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "露娜，",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "不敢跟不認識的人",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "聊天……",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "碧",
