[
  {
    "type": "background",
    "bg_id": "500122"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，主公大人您這樣不行……",
    "voice": "vo_adv_1059007_000",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n不可以淘氣喔，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個壞孩子。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您這樣舔的話，在下的臉會黏答答的。",
    "voice": "vo_adv_1059007_001",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好不容易一起泡澡，我們都洗得乾乾淨淨的。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這樣豈不是又髒掉了？",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呀……",
    "voice": "vo_adv_1059007_002",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，請您不要把頭埋進在下的衣服底下。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好癢啊，啊哈哈♪",
    "voice": "vo_adv_1059007_003",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n呵呵，主公大人您真愛撒嬌呢。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……哎呀？",
    "voice": "vo_adv_1059007_004",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n深夜裡有何貴幹，主公大人？",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯。",
    "voice": "vo_adv_1059007_005",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n您說聽到在下的房裡傳來奇怪的聲音，放心不下所以來看看？",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下深感抱歉，明明已經這麼晚了。",
    "voice": "vo_adv_1059007_006",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "說不定也有人已經就寢了，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n都是在下思慮不周。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_1059007_007",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n主公大人會來在下的房間，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n還真是稀奇呢……♪",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "房間的格局都一樣，私人物品也還很少。",
    "voice": "vo_adv_1059007_008",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n彷彿像照鏡子一般，很相似吧。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這裡確實有點煞風景，在下也有意想好好裝潢。",
    "voice": "vo_adv_1059007_009",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但在找到在下與主公大人的愛巢之前，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這裡不過是借宿的地方而已。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您說什麼？",
    "voice": "vo_adv_1059007_010",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的……前幾天我們不是撿到了迷路的汪汪嗎？",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然我們有請相關機構的人員幫忙尋找汪汪的主公大人。",
    "voice": "vo_adv_1059007_011",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但似乎不太順利。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而且近來公家機關的辦事效率太差，盡是負面評價呢。",
    "voice": "vo_adv_1059007_012",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們只好耐心等待……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在找到牠的飼主前，就由在下來收留牠。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您也知道的吧。",
    "voice": "vo_adv_1059007_013",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n因為汪汪沒有名字，叫起來挺不方便，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n所以在下把牠叫做『主公大人』。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過主公大人您本人在場的話，容易搞混就是了。",
    "voice": "vo_adv_1059007_014",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "主人",
    "words": "開心……♪",
    "voice": null,
    "unit_id": 1811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呀……",
    "voice": "vo_adv_1059007_015",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請您聰明一點，主公大人。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下正在跟人類的主公大人說話。",
    "voice": "vo_adv_1059007_016",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請您先去睡，在下待會就過去了。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_1059007_017",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n牠現在已經是在下的家人了。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "剛開始的時候，牠連飯都不肯吃呢。",
    "voice": "vo_adv_1059007_018",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但在下很有耐心地照顧牠……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "牠已經知道在下不是敵人了吧。",
    "voice": "vo_adv_1059007_019",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n終於向在下敞開心扉了。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "反倒是牠最近太愛撒嬌，讓在下很困擾。",
    "voice": "vo_adv_1059007_020",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您看看，牠現在還在用臉磨蹭在下呢……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊主公大人，您實在太可愛了♪",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_1059007_021",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個，不可以嗎……？",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "多虧了汪汪主公大人陪在下一起睡，",
    "voice": "vo_adv_1059007_022",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n最近都能一覺睡到天亮。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "果然身旁能感受到他人的體溫，就會令人覺得安心呢。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總有一天牠會回到真正的飼主那邊，",
    "voice": "vo_adv_1059007_023",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "與牠分開的話，在下會很寂寞的。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可以的話，在下也想跟人類的主公大人一起睡。",
    "voice": "vo_adv_1059007_024",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但很可惜那是被禁止的。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唉唷。",
    "voice": "vo_adv_1059007_025",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n汪汪主公大人好像睡著了。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "小心不要吵醒牠，讓在下慢慢地抱到床上吧。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下要給牠蓋被被、哼首搖籃曲……",
    "voice": "vo_adv_1059007_026",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n陪在牠旁邊睡、摸摸牠的頭，直到牠睡著為止。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，您覺得很懷念嗎？",
    "voice": "vo_adv_1059007_027",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在我們來【咲戀育幼院】之前，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下都是這樣哄主公大人入睡呢。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_1059007_028",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n人類的主公大人也好久沒這樣了……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您想對在下撒嬌嗎？",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人想要撒嬌的話，在下隨時都非常歡迎。",
    "voice": "vo_adv_1059007_029",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不，是在下想要這麼做。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人。",
    "voice": "vo_adv_1059007_030",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就算只有一下子也沒關係，要不要一起睡呢。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "讓我們感受彼此的體溫吧。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好的。",
    "voice": "vo_adv_1059007_031",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請您靠過來。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請從後面抱住在下。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊主公大人，您總是把在下當成易碎品一樣……",
    "voice": "vo_adv_1059007_032",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n溫柔地對待在下。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_1059007_033",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n被主公大人這樣抱著，讓在下想起小時候的事情。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那時忙於工作的父親，很少有機會回家。",
    "voice": "vo_adv_1059007_034",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n每當父親深夜晚歸的時候，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n不時會心血來潮地陪在在下身旁睡覺。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下忘不了當時父親的溫暖。",
    "voice": "vo_adv_1059007_035",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下真是懦弱又愚昧的小孩……",
    "voice": "vo_adv_1059007_036",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n為了尋求父親的溫暖而貼近主公大人。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下甚至抱著汪汪主公大人，把牠當作是父親的替代品。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是，",
    "voice": "vo_adv_1059007_037",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n一個人睡果然還是寂寞難耐。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人。",
    "voice": "vo_adv_1059007_038",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n……今晚就好，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下可以叫您爸爸嗎？",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哎呀？",
    "voice": "vo_adv_1059007_039",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n沒有回答……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人睡著了呢。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "該怎麼辦，被主公大人這樣抱著，在下動彈不得呢。",
    "voice": "vo_adv_1059007_040",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "算了，這樣也不錯。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "兩個人和一隻汪汪一起睡的話，這張床稍微有點小呢。",
    "voice": "vo_adv_1059007_041",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好像不小心就會翻下床。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "讓主公大人受傷的話，",
    "voice": "vo_adv_1059007_042",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下無法承擔那份責任。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是……",
    "voice": "vo_adv_1059007_043",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，主公大人好溫暖喔♪",
    "voice": null,
    "unit_id": 105912
  }
]
