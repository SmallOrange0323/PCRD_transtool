[
  {
    "type": "background",
    "bg_id": "501220"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在可可蘿進行完儀式後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}等人為了療傷兼觀光，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n便待在可可蘿的故鄉度過了數日。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嘿咻，",
    "voice": "vo_adv_1155001_000",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嘿咻……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "把這個如此這般……",
    "voice": "vo_adv_1155001_001",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哎呀。",
    "voice": "vo_adv_1155001_002",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "早安，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常抱歉，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下是不是吵醒您了呢？",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下正為了主人",
    "voice": "vo_adv_1155001_003",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "製作新鮮的果汁，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這些都是",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "今天早上才採回來的新鮮水果。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是否",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "製造了些許噪音呢……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有使用了充滿香氣的水果、",
    "voice": "vo_adv_1155001_004",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在堅硬果皮中",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "富含水分的水果等，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n混合了數種水果來製作。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "現在",
    "voice": "vo_adv_1155001_005",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "則是在研磨充滿營養的",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "柔軟果皮。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "畢竟若不細心處理，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就有可能會卡在喉嚨中。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "絕對不能讓主人",
    "voice": "vo_adv_1155001_006",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "受到那種痛苦，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n所以在下必須",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "仔仔細細地處理。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就快要完成了，",
    "voice": "vo_adv_1155001_007",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還請主人再稍等一下。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……嘿。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呀。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "喝！",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼……",
    "voice": "vo_adv_1155001_008",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這樣應該就足夠了吧。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "接下來",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是充分攪拌……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好的，",
    "voice": "vo_adv_1155001_009",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "完成了。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這就是可可蘿特製，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "精靈村的綜合果汁。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n來，請。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請您慢慢享用。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_1155001_010",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看來有符合您的胃口，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也感到非常開心。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n能看到主人用爽朗的笑容說出感想……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哎呀？",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人的齒縫",
    "voice": "vo_adv_1155001_011",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "卡了一小片果皮在那。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n是否因為在下將果皮研磨得細小的關係呢。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": "vo_adv_1155001_012",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請將您那美妙的笑容",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "轉向在下這邊。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "讓在下用小指",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來代替牙籤，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "替您取下果皮吧。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "戳戳。",
    "voice": "vo_adv_1155001_013",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……好的，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "已經取下來了。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": "vo_adv_1155001_014",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您的笑容越來越美妙了呢。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就在下看來，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那如同才剛升起的太陽一樣耀眼。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_1155001_015",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然已經成功完成儀式了……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n為了實際感受到這點，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在村子裡的這段時間，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下想繼續穿著它。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "穿著這套服裝，",
    "voice": "vo_adv_1155001_016",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就不可思議地能提起幹勁……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "或是說讓在下能夠更集中精神。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而且",
    "voice": "vo_adv_1155001_017",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人現在",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來到在下的故鄉，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n身為這個村子的代表，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下必須更鄭重地接待您才行。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以",
    "voice": "vo_adv_1155001_018",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "若您願意賞臉……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "今天是否能讓在下",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "帶您參觀村子呢？",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然",
    "voice": "vo_adv_1155001_019",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "與在下我們平常居住的蘭德索爾，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n或是冒險過的無數危險場所相比，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並沒有",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "什麼特別稀有的東西，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可能多少",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "會讓主人感到無聊。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但，",
    "voice": "vo_adv_1155001_020",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "既然是難得的機會，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n務必還請主人賞臉，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看看在下出生長大的故鄉。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "由於這次",
    "voice": "vo_adv_1155001_021",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "帶給了主人許許多多的麻煩，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也為了謝罪……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您意下如何呢？",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常謝謝您。",
    "voice": "vo_adv_1155001_022",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請放心交給在下導覽吧。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "background",
    "bg_id": "501200"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這裡是",
    "voice": "vo_adv_1155001_023",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "引自山中湧泉的",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "小河。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n生活所需用水",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "全都",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "取自於這條小河。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "方才主人享用的",
    "voice": "vo_adv_1155001_024",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "水果與蔬菜等，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n也都是使用這條小河的水所栽種的。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "正是這乾淨澄澈的水，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "孕育了那些美味的農作物。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而這裡",
    "voice": "vo_adv_1155001_025",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也是村裡的孩子們良好的遊戲場所。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在年幼的時候，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "經常來這條小河戲水。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在夏季的炎熱暑日將腳泡在河中，",
    "voice": "vo_adv_1155001_026",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就能感到沁入心脾的清涼，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常舒適。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……呵呵。",
    "voice": "vo_adv_1155001_027",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "能像這樣與主人",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一起走在村子裡，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n真令人料想不到。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然是在下提出",
    "voice": "vo_adv_1155001_028",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要帶主人參觀村子的……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但就像是",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "自己年幼時的回憶",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "全都赤裸裸地呈現在主人眼前，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "令人不禁",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有些許害羞。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可是，",
    "voice": "vo_adv_1155001_029",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也曾心想有朝一日，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n想如現在這樣與主人一同回來故鄉，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這確實",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也是事實……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": "vo_adv_1155001_030",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "或許還沒",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "做好心理準備……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……咳。",
    "voice": "vo_adv_1155001_031",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就前往下一處吧。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這裡是",
    "voice": "vo_adv_1155001_032",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "位於村子中心的廣場。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下在村子的那些時日，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "經常在這裡",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "與年紀相近的小孩們一起玩耍，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n或是",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "接受大人們驅使精靈的特訓。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也並非是相約在此集合，",
    "voice": "vo_adv_1155001_033",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n大家",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都是自然地聚集於此，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "談笑風生、",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "和樂融融。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只要閉上眼，",
    "voice": "vo_adv_1155001_034",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "便能看見那副光景",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有如昨日所發生的事一樣，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那麼鮮明──",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "啊，",
    "voice": "vo_adv_1155001_035",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "是可可蘿姐姐！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "哇～！",
    "voice": "vo_adv_1155001_036",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "果然是跑到這裡來了！",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "我們找妳好久了！",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哦哦……！",
    "voice": "vo_adv_1155001_037",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "兩位",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都過得好嗎？",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "少女們",
    "words": "嗯！",
    "voice": "vo_adv_1155001_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": "vo_adv_1155001_039",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這兩位",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "便是在下居住於村子時，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n經常一起遊玩的",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "年幼精靈術士同胞。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "主人……？",
    "voice": "vo_adv_1155001_040",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "這個人",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "就是那個主人嗎？",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "可可蘿姐姐說的",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "那個重要之人！",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的，",
    "voice": "vo_adv_1155001_041",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "正是如此。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……啊，",
    "voice": "vo_adv_1155001_042",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不是的，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所說的重要之人，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並非那方面的意思。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n僅是指",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "對在下的職責而言，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是非常重要的……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "姐姐怎麼了？",
    "voice": "vo_adv_1155001_043",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "妳的臉",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "好紅喔。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "是有哪裡還不舒服嗎？",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，",
    "voice": "vo_adv_1155001_044",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "連主人都……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這、",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "僅是剛好變紅了而已，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下的身體狀況非常良好。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請不必擔心。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "啊哈哈，",
    "voice": "vo_adv_1155001_045",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "你們的感情",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "真的很好呢！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "……問妳喔，",
    "voice": "vo_adv_1155001_046",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "可可蘿姐姐。",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "我是不是，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "總有一天也能遇見重要之人呢？",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哎呀，",
    "voice": "vo_adv_1155001_047",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "突然這麼問是怎麼了嗎？",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "就是呀，",
    "voice": "vo_adv_1155001_048",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "我們兩個人，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n都還沒辦法像可可蘿姐姐一樣",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "聽到愛梅斯大人的聲音，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "父母",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "也只是普通的精靈族而已。",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "羨慕獲得職責的",
    "voice": "vo_adv_1155001_049",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "可可蘿姐姐",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "什麼的，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n我至今雖然從沒這麼想過……",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "可是，",
    "voice": "vo_adv_1155001_050",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "我現在也想要變得能夠聽到愛梅斯大人的聲音，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n也想要",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "能夠遇到像可可蘿姐姐的主人，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "那樣的重要之人……",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯……",
    "voice": "vo_adv_1155001_051",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "若是如此，",
    "voice": "vo_adv_1155001_052",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一定……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是肯定能與其相遇的，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下如此認為。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "真的嗎！？",
    "voice": "vo_adv_1155001_053",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真的。",
    "voice": "vo_adv_1155001_054",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "確實，",
    "voice": "vo_adv_1155001_055",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下之所以會與主人相遇，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n是因為愛梅斯大人的指示沒錯。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在起初相遇時，",
    "voice": "vo_adv_1155001_056",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下身為主人的隨從，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "僅僅",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只是為了完成職責",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而照顧主人。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "然而，",
    "voice": "vo_adv_1155001_057",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在與主人共同度過的時日中，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下漸漸萌生了更進一步的感情。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並非僅是得陪伴在身旁的責任感，",
    "voice": "vo_adv_1155001_058",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而是對在下自己而言，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人成了不可或缺的人。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……沒錯，",
    "voice": "vo_adv_1155001_059",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "確實是十分重要的人。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "竟然會產生這種心境轉化，",
    "voice": "vo_adv_1155001_060",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是愛梅斯大人下達指示時",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "從未想像過的。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以，",
    "voice": "vo_adv_1155001_061",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就算現在沒有任何特別的力量……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n不論契機",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是什麼事物……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "無法預料的美好相遇，",
    "voice": "vo_adv_1155001_062",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n肯定，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "會隨著風兒突然來到您面前的。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "無論是什麼人，",
    "voice": "vo_adv_1155001_063",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只要一同度過時間、",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "創造回憶，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n真正的感情就會萌芽……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是這麼認為的。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "嗯……",
    "voice": "vo_adv_1155001_064",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "雖然我有點聽不太懂，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "但我好像明白",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "可可蘿姐姐的心情了！",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_1155001_065",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總有一天",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "肯定能徹底理解的。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "話說回來，",
    "voice": "vo_adv_1155001_066",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "方才",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "兩位說在找在下，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n應該還有什麼",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "其他要事才對？",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "對喔！",
    "voice": "vo_adv_1155001_067",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n我們想要請姐姐跟以前一樣指導我們，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n所以在找妳！",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "哪，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "姐姐願意吧？",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "對對！",
    "voice": "vo_adv_1155001_068",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n我們想要請變強的姐姐教我們，",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "才跑來這個廣場的！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "就覺得妳一定會來這邊！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "當然，",
    "voice": "vo_adv_1155001_069",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒有問題。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就如同過去那樣，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "和風一起嬉戲吧。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "still",
    "still_id": "115500101"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "──風之精靈啊，",
    "voice": "vo_adv_1155001_070",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請起身而舞吧。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……呵呵。",
    "voice": "vo_adv_1155001_071",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "精靈開心到像輕飄鬆軟的",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "絨毛一樣呢。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這個村子的風，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "果然非常特別。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "拜託了，",
    "voice": "vo_adv_1155001_072",
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "精靈！",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我也",
    "voice": "vo_adv_1155001_073",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "不會輸的！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "過來吧，",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "精靈！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哦哦，",
    "voice": "vo_adv_1155001_074",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這是……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好一陣子不見，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "你們都變得",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "很擅長跟精靈對話了呢。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "厲害到",
    "voice": "vo_adv_1155001_075",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下已經沒有東西可以教你們，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n你們已經是獨當一面的精靈術士了。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_1155001_076",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "真是令人懷念的光景呀。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n是在請可可蘿指導嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大人",
    "words": "可可蘿在出村子前，",
    "voice": "vo_adv_1155001_077",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大人",
    "words": "\\n大家總是在這裡",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大人",
    "words": "和精靈玩到日落呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哦哦，",
    "voice": "vo_adv_1155001_078",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位……！",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好久不見了。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "still",
    "still_id": "115500102"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": "vo_adv_1155001_079",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這邊的各位",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "便是在下年幼時",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "指導在下讀書、",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n料理等事物的",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位村民們。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要說",
    "voice": "vo_adv_1155001_080",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位等同於在下的父母",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也不為過。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下與各位共同度過了許多時間。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的，",
    "voice": "vo_adv_1155001_081",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "正是如此。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「這個村子",
    "voice": "vo_adv_1155001_082",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "跟蘭德索爾相比",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並沒有什麼特色」。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n雖然稍早",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下曾這麼說了，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但那是在下的錯誤發言。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "居住此地的人們，",
    "voice": "vo_adv_1155001_083",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "其溫情正是這個村子最自傲之物，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n人與人之間的互動景象，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n正是在下所愛的故鄉風景。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "至今從未改變的",
    "voice": "vo_adv_1155001_084",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這道風景，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n能夠在這次",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也讓主人見到，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下非常開心。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這裡",
    "voice": "vo_adv_1155001_085",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "正是在下出生長大的土地……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是由溫暖的心所培育的",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可可蘿。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "可可蘿被故鄉的同胞們圍繞，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n並露出懷念的微笑。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  }
]
