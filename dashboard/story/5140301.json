[
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "喲，",
    "voice": "vo_adv_5140301_000",
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "「罪人＜豬隻＞」們！",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "\\n連主都在「嘆息」了呀～？",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "不可饒恕的「罪過＜犯規＞」可是需要「罰符」的喔！？",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "可惡，出現了啊，",
    "voice": "vo_adv_5140301_001",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "企圖抹殺人類的",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "宇宙暗黑大魔王！",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "啊？",
    "voice": "vo_adv_5140301_002",
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "妳們這些「異常者＜傢伙＞」是怎麼回事？",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "\\n",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "「逆轉＜顛倒＞」善惡，",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "富美惠",
    "words": "胡扯什麼宏大的「陰謀論＜妄想＞」──",
    "voice": null,
    "unit_id": 18211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "閉嘴，",
    "voice": "vo_adv_5140301_003",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "宇宙暗黑大魔王！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "人類的和平",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "由我們來守護！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "優妮們，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "使出全力上吧！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "沒錯！",
    "voice": "vo_adv_5140301_004",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n好朋友社，",
    "voice": null,
    "unit_id": 110911
  },
  {
