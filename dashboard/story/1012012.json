    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是不是會硬是想壓制住",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n增強後的超能力啊。",
