  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}帶著初音，去找了栞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "原來發生了那樣的事……",
    "voice": "vo_adv_1012012_000",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我在睡著的時候",
    "voice": "vo_adv_1012012_001",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "被帶過來了，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這樣不行啦～！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我唯獨不想",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "讓小栞擔心的說……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是啊，",
    "voice": "vo_adv_1012012_002",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "如果不安的話，希望妳能跟我商量。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為我們，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可是一家人呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗚嗚，",
    "voice": "vo_adv_1012012_003",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "抱歉呢小栞——",
