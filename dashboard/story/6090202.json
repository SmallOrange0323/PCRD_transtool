[
  {
    "type": "background",
    "bg_id": "500042"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那個混帳賭場……！",
    "voice": "vo_adv_6090202_000",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不管是想對步未未動歪腦筋，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n還是找我們地盤的麻煩！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我都絕對",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不會原諒的！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我要完全、",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "徹底地！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "把它從這個蘭德索爾連根拔除……！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "謝謝你，",
    "voice": "vo_adv_6090202_001",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥……！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n跟夥伴在一起，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "像那種傢伙就能輕鬆獲勝！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "讓我們痛扁賭場王一頓，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "保護大家吧！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說、",
    "voice": "vo_adv_6090202_002",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說得也是……",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我得注意別再失去理智，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n又自己一個人橫衝直撞才行……",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怪盜任何時候都要保持冷靜酷帥，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對吧！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦！？",
    "voice": "vo_adv_6090202_003",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你在說什麼啊！？",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……我逼自己太緊了？",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "或、",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "或許的確就如你說的……",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "才要稍微玩一下，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n讓腦袋冷靜嗎……",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就來玩排七吧！",
    "voice": null,
    "unit_id": 121611
  }
]
