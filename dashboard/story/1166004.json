  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在惡質貴族那件事過了一陣子後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}對在街上遇到的嘉夜打了招呼。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啥？",
    "voice": "vo_adv_1166004_000",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呃，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是你啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我剛才的態度很糟糕吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n真的",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "很對不起。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不，什麼都沒有……",
    "voice": "vo_adv_1166004_001",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哎，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "想用這句話瞞過你是不可能的吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "其實在那之後，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我和老大報告了和貴族發生的糾紛……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "501320"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "──所以說，",
    "voice": "vo_adv_1166004_002",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "事情就是這樣。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "因為我的過失，搞砸了大好機會。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒能回應妳的期待，真是抱歉啊。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "畢竟雖然當時的情況特殊，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我或許可以",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "處理得再好一點。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但是，",
    "voice": "vo_adv_1166004_003",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我絕對沒有做錯事情。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n就只有這件事，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我能抬頭挺胸地這麼肯定。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這個嘛～",
    "voice": "vo_adv_1166004_004",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n如果能因為這件事打好關係，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n或許就能帶來龐大的利益，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "在這一點上的確像是損失慘重呢～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過，",
    "voice": "vo_adv_1166004_005",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "正是因為嘉夜一直努力到現在，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n這門生意才能上軌道，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "現在也經營得很順利。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳真的幫了一個大忙喔～☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是、",
    "voice": "vo_adv_1166004_006",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "既然妳都這麼說了，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "下次就──",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "一直以來真的是辛苦妳了。",
    "voice": "vo_adv_1166004_007",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "接下來的事情就交給我吧。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……咦？",
    "voice": "vo_adv_1166004_008",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "什麼意思？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "包括嘉夜會讓這門生意上軌道，",
    "voice": "vo_adv_1166004_009",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n還有",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "會犯下嚴重失敗的事情在內，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "全～都在我的意料之中啊☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "所",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "、以",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "、說，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不管再怎麼嚴重，我都能處理好喔～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "繼任的導遊已經決定好了，",
    "voice": "vo_adv_1166004_010",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "下個大好機會也開始有了動作。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嘉夜不必擔心任何事情，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳就跟以前一樣繼續加油吧，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "打手小姐☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這……",
    "voice": "vo_adv_1166004_011",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣啊！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哎～",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "都是老大的任性害我接下了莫名其妙的工作啦。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n那我馬上就去打架囉。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊～好～開心啊～！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "事情",
    "voice": "vo_adv_1166004_012",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就是這樣。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就像老大說的，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這下子我就能專心當打手了，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "明明就有一堆的好處，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我的心情卻不管怎麼樣都不太爽快。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就算打架也不太開心，",
    "voice": "vo_adv_1166004_013",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我好像",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "有點不對勁啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嘿，",
    "voice": "vo_adv_1166004_014",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "該怎麼辦才好啊……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呃，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這陣光芒是怎麼回事！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗚、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗚哇──！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "奇怪～？",
    "voice": "vo_adv_1166004_015",
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哎呀哎呀～？",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n看這寂寞的背影，",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "該不會是學長吧～？",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊哈哈，",
    "voice": "vo_adv_1166004_016",
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "果然是你！",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你在這種地方做什麼啊？",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n該不會是",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "來見我的吧？",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊，",
    "voice": "vo_adv_1166004_017",
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好的，",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我得到了55分的答案～",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你這樣不行啦，學長～！",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "要以更高的分數為目標啊～！",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n真希望你能再用功一點，",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "學習怎麼跟女孩子相處。",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不提這個了，我說學長啊，",
    "voice": "vo_adv_1166004_018",
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你拿在手上的東西是什麼啊～？",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不，",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我知道那是書啦。",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我是要問你那是什麼書！",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "該不會是",
    "voice": "vo_adv_1166004_019",
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那種書吧？",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "如果是的話，這樣不太好呢，",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "非常不好。",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "在這件事情上",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你要怎麼解釋啊？",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "學～長？",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "咦？",
    "voice": "vo_adv_1166004_020",
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這、",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這個……",
    "voice": null,
    "unit_id": 106532
  },
