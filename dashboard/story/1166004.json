    "name": "嘉夜",
    "words": "就算會感到迷惘",
    "voice": "vo_adv_1166004_034",
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "或不安，",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就只有那份驕傲絕對不會有所動搖，",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也不逃避。",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n就是因為這樣，他們才能成功解決事件。",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣很帥對吧！",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "still",
    "still_id": "116600402"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_1166004_035",
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "和我",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "完全不一樣。",
    "voice": null,
    "unit_id": 106532
  },
  {
