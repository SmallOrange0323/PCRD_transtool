    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊～",
    "voice": "vo_adv_1166004_032",
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真有趣～！",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n如果是這部作品，的確能理解為什麼會拍成電影啊。",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n下次去買預售票吧！",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這個嘛……",
    "voice": "vo_adv_1166004_033",
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然我單純覺得角色和故事很有趣，",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但女主角他們",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "對自己的工作引以為傲，",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我喜歡的大概是這個部分吧。",
