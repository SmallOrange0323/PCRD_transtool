  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n哦～",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "原來原作是漫畫啊。",
