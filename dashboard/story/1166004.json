    "name": "嘉夜",
    "words": "我總是在逃避。",
    "voice": "vo_adv_1166004_036",
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "逃避空手道，",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也逃避重要的朋友。",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就算在阿斯特朗裡變得再怎麼強，",
