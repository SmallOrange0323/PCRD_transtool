    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯？",
    "voice": "vo_adv_1166004_028",
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你說女主角和我很像？",
