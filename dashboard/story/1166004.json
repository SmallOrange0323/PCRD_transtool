    "name": "嘉夜",
    "words": "要是像這樣繼續逃避下去，",
    "voice": "vo_adv_1166004_037",
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我會變成什麼樣子呢？",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n會做起什麼樣的工作呢？",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……不，",
    "voice": "vo_adv_1166004_038",
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我連自己周遭的事情都解決不了了，",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我不認為自己有能力工作啊。",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_1166004_039",
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "學長，",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你大概是在鼓勵我吧，",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n但你是真心這麼認為的嗎？",
    "voice": null,
    "unit_id": 106532
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不是在隨口說說？",
