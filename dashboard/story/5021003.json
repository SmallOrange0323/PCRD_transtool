  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一行人為了尋找奄美魔物的線索，\\n於是便在漁村裡四處打聽消息。\\n就在那時候，從村民那裡得知了玩偶浮在空中的目擊情報。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "吶、我說。",
    "voice": "vo_adv_5021003_000",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n果然……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "唔～嗯。",
    "voice": "vo_adv_5021003_001",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "雖然希望這是個巧合，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "但似乎不是那麼一回事呢～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "大家",
    "voice": "vo_adv_5021003_002",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "該不會變成壞孩子了吧……",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那個，公主。",
    "voice": "vo_adv_5021003_003",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "現在還不能確定就是它們對吧？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "竟然奪取他人的靈魂，",
    "voice": "vo_adv_5021003_004",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "我絕無法原諒。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "要是大家真的做了那種事，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家就……",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "相信它們……？",
    "voice": "vo_adv_5021003_005",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒錯，公主。",
    "voice": "vo_adv_5021003_006",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n無論消失的玩偶們",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "和這件事是否有關連，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n但要是連我們都不信任它們的話那怎麼辦。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "對啊～",
    "voice": "vo_adv_5021003_007",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "{0}說得真好～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒問題的～！",
    "voice": "vo_adv_5021003_008",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "　我的家鄉有個說法，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n「凡是受到他人愛戴的事物，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "必有善良靈魂寄宿其中」",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "所以說，",
    "voice": "vo_adv_5021003_009",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真步的玩偶",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "怎麼可能會是壞孩子呀～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就是啊。",
    "voice": "vo_adv_5021003_010",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "每天都和它們聊天、",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還幫它們梳理得很乾淨，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n受到如此重視的它們",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "肯定不可能會去做壞事啦。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵。",
    "voice": "vo_adv_5021003_011",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "謝謝妳，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "香織。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還有王子先生",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "和真琴。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "說的對。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家要相信",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "大家都是好孩子呀。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喔，",
    "voice": "vo_adv_5021003_012",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們快抵達目擊玩偶的地方了。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真是的，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們不是來海邊玩嗎，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "怎麼會淪落到穿泳裝進入森林的下場。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "因為漁夫遭到襲擊的地方在這附近呀，",
    "voice": "vo_adv_5021003_013",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒辦法呢～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "是說",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這附近不曉得有沒有長苦瓜呢～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "儘管很像，",
    "voice": "vo_adv_5021003_014",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但這裡也不是妳的家鄉，",
