    "name": "雷姆",
    "words": "雷姆的理想嗎？",
    "voice": "vo_adv_1097001_042",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n那當然",
