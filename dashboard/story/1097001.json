    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "咦？",
    "voice": "vo_adv_1097001_038",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "你說那方面希望能交給你確認，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "真是不好意思，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "就麻煩你了。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "這可不行呢。",
    "voice": "vo_adv_1097001_039",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "得要更振作一點才行……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "謝謝你。",
    "voice": "vo_adv_1097001_040",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆還差得遠呢。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "只憑這點程度的女僕力，",
    "voice": "vo_adv_1097001_041",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n實在",
