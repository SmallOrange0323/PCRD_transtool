[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當{0}正在散步時，\\n發現有個抱著頭發愁的女孩子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯……",
    "voice": "vo_adv_1053001_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n成功組織公會這點是不錯，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n但沒想到",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "居然連擊退魔物都做不到……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這一切",
    "voice": "vo_adv_1053001_001",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "都是因為我欠缺作為司令官的能力。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "如果我可以給出更正確的指示……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "好吧！",
    "voice": "vo_adv_1053001_002",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這樣一來只能進行特訓了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "只要我變強，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那麼公會也會變強的！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……但是城鎮中有人太危險了呀。",
    "voice": "vo_adv_1053001_003",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n沒辦法，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "到城外去特訓吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯？",
    "voice": "vo_adv_1053001_004",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "怎麼了閣下？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "找我何事？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "城鎮外面很危險……嗎？",
    "voice": "vo_adv_1053001_005",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這我當然知道。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n就是因為危險，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "才能達到訓練的效果不是嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什麼……？",
    "voice": "vo_adv_1053001_006",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你說小孩不可以一個人外出……？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我、",
    "voice": "vo_adv_1053001_007",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我才不是小孩呢！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我是莫妮卡‧拜斯溫特！",
    "voice": "vo_adv_1053001_008",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n隸屬光榮的純白之翼，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可是傑出的軍人喔！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "才不是遊戲！",
    "voice": "vo_adv_1053001_009",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下這呆板的語氣是什麼意思！？",
    "voice": "vo_adv_1053001_010",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "看來閣下",
    "voice": "vo_adv_1053001_011",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是不相信了！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我沒有撒謊，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我真的是軍人！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯？",
    "voice": "vo_adv_1053001_012",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我父母在哪？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我家在哪……？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "為什麼",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "要問這些？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "為了送我回家……？",
    "voice": "vo_adv_1053001_013",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我不是說了嘛，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我不是小孩！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔唔唔……",
    "voice": "vo_adv_1053001_014",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n看來閣下",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是想要激怒我是吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "算了，閣下請自便！",
    "voice": "vo_adv_1053001_015",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我要去特訓。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就算阻止我也沒用的！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯……",
    "voice": "vo_adv_1053001_016",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這裡的話",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "很寬敞很適合訓練呢。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……閣下是怎樣，",
    "voice": "vo_adv_1053001_017",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "居然跟過來了？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不用擔心，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "即使出了城鎮，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n也不會馬上就遇到魔物的──",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "魔、",
    "voice": "vo_adv_1053001_018",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "魔物！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "說人人就到呀……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "什麼？",
    "voice": "vo_adv_1053001_019",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你說逃走嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那好，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下自己一個人逃吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我是軍人。",
    "voice": "vo_adv_1053001_020",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "即使面對魔物也絕不會逃跑。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n就算孤身一人也要奮力一戰。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼了……發什麼呆呢？",
    "voice": "vo_adv_1053001_021",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你說「真拿妳沒辦法」是什麼意思？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……唔！？",
    "voice": "vo_adv_1053001_022",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這是什麼……？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n有股力量湧出來了！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "有這股力量，",
    "voice": "vo_adv_1053001_023",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "面對魔物也不用懼怕啦！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n看招！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "哼哼，",
    "voice": "vo_adv_1053001_024",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我的實力如何呀？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "很棒是吧？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是吧，",
    "voice": "vo_adv_1053001_025",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "很厲害對吧！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n閣下也終於肯認可我是軍人了呢……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "欸？",
    "voice": "vo_adv_1053001_026",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你說小孩居然這麼強讓人很驚訝？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我才不是小孩！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喂、喂！",
    "voice": "vo_adv_1053001_027",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "為什麼抓我的手！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我有說你可以碰我嗎！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "啊……？",
    "voice": "vo_adv_1053001_028",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "因為很危險，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n所以你要送我回家？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔、",
    "voice": "vo_adv_1053001_029",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔唔唔……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我都說了，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不要把我當小孩！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
