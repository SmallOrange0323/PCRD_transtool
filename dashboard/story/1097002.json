  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "今天也是一如往常的蘭德索爾。\\n雷姆正急著前往與可可蘿等人約定碰面的地方。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "糟了，",
    "voice": "vo_adv_1097002_000",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "有點太晚出門了。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "育幼院的孩子們太可愛，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "一不小心就……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "要是不快點",
    "voice": "vo_adv_1097002_001",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "會趕不上時間的。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "這樣雖然有點不得體，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "但是就跑過去……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "喂──！",
    "voice": "vo_adv_1097002_002",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n那邊怎麼樣啊──！？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "不行──",
    "voice": "vo_adv_1097002_003",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "這個完全沒有辦法啊──！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "真是的，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "傷腦筋了啊──！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "嗯，",
    "voice": "vo_adv_1097002_004",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "街上聚集了好多人……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是發生了什麼事嗎？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不好意思，",
    "voice": "vo_adv_1097002_005",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "請問怎麼了嗎？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "哦？",
    "voice": "vo_adv_1097002_006",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "女僕小姐？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "哎呀～",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "沒怎麼了，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "就是妳看到樣子。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "看到樣子……",
    "voice": "vo_adv_1097002_007",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n是倒在路中央",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "的樹木嗎？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "還真大呢……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "不久之前",
    "voice": "vo_adv_1097002_008",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "有魔物在這附近作亂。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n雖然是成功驅逐了，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "但損害就是這個。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "雖然招集了男丁要來移走這棵樹，",
    "voice": "vo_adv_1097002_009",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "但是這相當艱難……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "看來會耗上一整天了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "街道沒辦法通行的話，",
    "voice": "vo_adv_1097002_010",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n馬車那些就會動彈不得呢。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "……那個，",
    "voice": "vo_adv_1097002_011",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "可以的話，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "能讓我來幫忙嗎？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "啊？",
    "voice": "vo_adv_1097002_012",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n妳說幫忙，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "是女僕小姐妳嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是的，",
    "voice": "vo_adv_1097002_013",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "力氣活的話，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "我想應該可以幫得上忙，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "怎麼樣呢？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "男子們",
    "words": "……",
    "voice": "vo_adv_1097002_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男子們",
    "words": "啊～",
    "voice": "vo_adv_1097002_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男子們",
    "words": "哈哈哈哈哈哈！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "喂喂，",
    "voice": "vo_adv_1097002_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "小姑娘，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "很感謝妳有那個心，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "但小姑娘是辦不到的。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "可別用妳那瘦弱的手臂",
    "voice": "vo_adv_1097002_017",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "勉強亂來啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n哈～",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "笑死我了",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "笑死我了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "唔……",
    "voice": "vo_adv_1097002_018",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "這絕不是在開玩笑……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "知道了知道了。",
    "voice": "vo_adv_1097002_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "但是，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "這種事是男人的工作，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "女僕小姐。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "要是妳真辦得到的話，",
    "voice": "vo_adv_1097002_020",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n就算要我們把今天的酒錢",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "全部給妳都行啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "……",
    "voice": "vo_adv_1097002_021",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是這樣",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "的嗎。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "我明白了。",
    "voice": "vo_adv_1097002_022",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n是我多管閒事了，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "真是抱歉。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "各位，",
    "voice": "vo_adv_1097002_023",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "請各位工作加油。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n雷姆就先告辭了。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "哦哦，",
    "voice": "vo_adv_1097002_024",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "小心點啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n大力士女僕小姐！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男子們",
    "words": "啊～",
    "voice": "vo_adv_1097002_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男子們",
    "words": "哈哈哈哈哈哈！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊，",
    "voice": "vo_adv_1097002_026",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雷姆小姐，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這裡。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雷姆小姐來了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "很抱歉讓你們久等了。",
    "voice": "vo_adv_1097002_027",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n剛才在途中",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "稍微和人交談了一下……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請別在意，",
    "voice": "vo_adv_1097002_028",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這種事情",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也是會發生的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n我們在等的時候",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也很樂在其中。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "正好",
    "voice": "vo_adv_1097002_029",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有很多第一次見到的攤販。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "於是就隨著主公大人的好奇心",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "邊走邊吃了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "自從和貪吃佩可小姐在一起以後，",
    "voice": "vo_adv_1097002_030",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n把魔物當成食材的機會也增加了，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但魔物料理",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是正在流行嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "魔物「風」",
    "voice": "vo_adv_1097002_031",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
