[
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嘿！",
    "voice": "vo_adv_5142203_000",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "怎麼樣啊！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要是知道我們有多強了，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n就趕快回自己的森林去吧！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "說的沒錯。",
    "voice": "vo_adv_5142203_001",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "要不然，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就讓你一輩子無法起身……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "北方森林的魔物",
    "words": "──嘎喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 18311
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哎呀哎呀？",
    "voice": "vo_adv_5142203_002",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "剛才那些氣勢都到哪去了？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "牠夾著尾巴逃跑了呢。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "看來魔物也憑本能察覺到對手很不妙了呢……",
    "voice": "vo_adv_5142203_003",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不妙……？",
    "voice": "vo_adv_5142203_004",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是指誰呢？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就是妳啦！！",
    "voice": "vo_adv_5142203_005",
    "unit_id": 129811
  }
]
