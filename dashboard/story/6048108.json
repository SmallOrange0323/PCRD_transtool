  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "那個弓箭",
    "voice": "vo_adv_6048108_000",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "非常強啊……！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我們",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "能夠制止它嗎……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "那個自信心是從哪裡來的啊……",
    "voice": "vo_adv_6048108_001",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "不過",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "被你這樣一講，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "不知道為什麼就感覺能成功制止它呢。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n既然你誇下海口那就拜託你了喔！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "這、",
    "voice": "vo_adv_6048108_002",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "這不是理所當然的嗎？",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "事到如今你要是說要逃跑我可饒不了你哦！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "走吧！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "趕快制止它的失控，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "差不多該結束這場騷動了呢！",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "……你這種耿直到犯傻的個性，",
    "voice": "vo_adv_6048108_003",
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "讓人有點羨慕呢。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "嗯，",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我非常害怕……",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "不過",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "不可思議的是我完全沒有想逃走的意思。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n大概",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "是因為我不是一個人吧。",
    "voice": null,
    "unit_id": 113712
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "我相信你喔。",
    "voice": null,
    "unit_id": 113712
  }
]
