[
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "離開公務機關回家的路上，{0}和可可蘿\\n悠閒地在街上漫步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "今天天氣真好呢！",
    "voice": "vo_adv_1059011_000",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這種日子",
    "voice": "vo_adv_1059011_001",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "會讓人很想躺在綠色的草坪上，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n讓全身感受",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "太陽公公的溫暖。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哦呀。",
    "voice": "vo_adv_1059011_002",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您剛剛打了一個很大的呵欠耶，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要不要",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "稍微睡個午覺再走？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "狗",
    "words": "汪汪！",
    "voice": null,
    "unit_id": 1811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_1059011_003",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "汪汪主公大人好像有點",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n精力過剩的樣子呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼，稍微",
    "voice": "vo_adv_1059011_004",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "去那邊草地玩耍一下也可以喔。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請注意不要",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "跑太遠喔。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼，",
    "voice": "vo_adv_1059011_005",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請人類主公大人",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "過來這邊。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請把在下的膝蓋",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "當作枕頭躺下吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵。",
    "voice": "vo_adv_1059011_006",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "兩邊都同一個名字，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下只好",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一直主公大人主公大人地叫，真是忙碌。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過已經是很熟悉的名字了，",
    "voice": "vo_adv_1059011_007",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n叫再多遍都沒問題。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人……♪",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這麼說起來，",
    "voice": "vo_adv_1059011_008",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "從在下把主公大人",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "稱為主公大人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n到現在也已經過了一段時間呢……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "回想起來真的",
    "voice": "vo_adv_1059011_009",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有很多……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咦？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這道光，",
    "voice": "vo_adv_1059011_010",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是愛梅斯大人的……？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還好是在柔軟的草地上",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "background",
    "bg_id": "510140"
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "抱歉突然把您叫出來，",
    "voice": "vo_adv_1059011_011",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下是您忠誠的僕人－",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "棗 可蘿。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "啊……",
    "voice": "vo_adv_1059011_012",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真的是非常抱歉。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n您說過",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "盡量不要",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在人前稱呼您主人吧。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不過現在周圍沒什麼人",
    "voice": "vo_adv_1059011_013",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "應該沒關係吧？",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "那真是太好了。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "果然，",
    "voice": "vo_adv_1059011_014",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "面對主人",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "卻不叫主人，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "總覺得很不習慣。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人……",
    "voice": "vo_adv_1059011_015",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人♪",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "話說回來，",
    "voice": "vo_adv_1059011_016",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "今天還真熱。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n附近人會很少",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "應該也是因為這樣吧。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這是",
    "voice": "vo_adv_1059011_017",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "冰涼的果汁",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "嗎？",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n這是給在下的嗎？",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……咕嚕，",
    "voice": "vo_adv_1059011_018",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "咕嚕。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "謝謝您，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人您",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真是溫柔……♪",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "啊，",
    "voice": "vo_adv_1059011_019",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不過",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這個只有一瓶。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這樣的話",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人也會口渴。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "可是",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "也不能因為這樣，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "就辜負主人的好意。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "所以，",
    "voice": "vo_adv_1059011_020",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這瓶果汁",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "我們就一人一半吧。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下剛剛已經喝了一口了，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "接下來",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "輪到主人了。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "哇～",
    "voice": "vo_adv_1059011_021",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您喝果汁的樣子真豪爽……♪",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "接下來換我了――",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "好了，",
    "voice": "vo_adv_1059011_022",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "現在也解渴了，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n就讓我們切入正題吧。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人……",
    "voice": "vo_adv_1059011_023",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n米奈娃",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這個名字，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您有聽過嗎？",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "本該待在WISDOM的她，",
    "voice": "vo_adv_1059011_024",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n前一陣子",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "卻失蹤了……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "其實最近，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "她有與在下聯繫。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "內容提到",
    "voice": "vo_adv_1059011_025",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n自己平安無事，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "還有――",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "――迷宮女王的",
    "voice": "vo_adv_1059011_026",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "公主騎士",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這件事。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "是的。",
    "voice": "vo_adv_1059011_027",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n正如您所猜測的……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "她是掌管阿斯特朗傳奇",
    "voice": "vo_adv_1059011_028",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "營運管理的",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\nAI……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "人工智慧。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真的非常抱歉。",
    "voice": "vo_adv_1059011_029",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下說明得不夠充分，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "嚇到您了吧。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "管理阿斯特朗傳奇的AI－",
    "voice": "vo_adv_1059011_030",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n米奈娃，其開發團隊中的一員",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "正是在下的父親。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "still",
    "still_id": "105901101"
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "而在下",
    "voice": "vo_adv_1059011_031",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "則從旁協助父親的研究，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n經常擔任和米奈娃對話的",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "『說話對象』。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "根據父親的說法，",
    "voice": "vo_adv_1059011_032",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "要讓人工智慧成長，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "須讓它與真正的人類大量對話。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n因此在下",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "被選為她的",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "『說話對象』。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "為了協助父親研究，",
    "voice": "vo_adv_1059011_033",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "常常和米奈娃聊天。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n聊的內容幾乎都是一些",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "閒聊和日常生活的對話而已……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "但也因為這樣，",
    "voice": "vo_adv_1059011_034",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下和米奈娃之間",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "有著一股連結。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "米奈娃",
    "voice": "vo_adv_1059011_035",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "說過好幾次。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n她說在下",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "需要一個可以侍奉的對象。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "從那個人身上",
    "voice": "vo_adv_1059011_036",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "會學到很多東西，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n總有一天，在下會",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在不知不覺中成長到",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n與父親旗鼓相當的程度。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "聽到她這麼說的時候，",
    "voice": "vo_adv_1059011_037",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下感覺自己的心跳",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "莫名地加速。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "幻想著不知長相，",
    "voice": "vo_adv_1059011_038",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "也不知名字，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下未曾謀面的……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "嗯，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "未來主人的",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "樣貌。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "呵呵，",
    "voice": "vo_adv_1059011_039",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "簡直就像是",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "盼望白馬王子到來的",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "少女一樣……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n真的就是",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "那樣的心情。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "background",
    "bg_id": "510140"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "米奈娃聯絡在下時，在下告訴她。",
    "voice": "vo_adv_1059011_040",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下已經",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "找到自己應該侍奉的對象",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "了。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "他不僅純潔善良……",
    "voice": "vo_adv_1059011_041",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "還能將眾人的心彼此連結，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n對有困難的人們",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "一視同仁地幫助，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "充滿著行動力，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n是一位心地善良的、",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "未來的勇者。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "他一定",
    "voice": "vo_adv_1059011_042",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "可以帶領在下",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "抵達更高的境界。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "若是蘊含著抵達塔頂可能性的",
    "voice": "vo_adv_1059011_043",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n迷宮女王的",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "公主騎士的話……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "被迷宮女王選上，",
    "voice": "vo_adv_1059011_044",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "連米奈娃都一見傾心的那個人。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "那個人，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "就是在下長年等待，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n將成為在下主人的人……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下",
    "voice": "vo_adv_1059011_045",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "滿心期盼，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "等不及相遇的人。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下認為主人一定是",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "一位很了不起的人物。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "請您不要謙虛。",
    "voice": "vo_adv_1059011_046",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人您",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "跟在下想像的一模一樣。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您害羞的表情也很帥。",
    "voice": "vo_adv_1059011_047",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人果然",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "跟在下想像的一模一樣……♪",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下……",
    "voice": "vo_adv_1059011_048",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "一直，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "一直衷心期盼您的到來。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "期盼一位為在下指引方向的人……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "期盼主人的到來。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "初次見面的時候",
    "voice": "vo_adv_1059011_049",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下並未做任何說明，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n您當時",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "一定覺得很疑惑吧。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真的非常抱歉。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下",
    "voice": "vo_adv_1059011_050",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "沒有什麼親近的朋友，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n很不擅長",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "與人相處……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "什麼……？",
    "voice": "vo_adv_1059011_051",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n米奈娃……？",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "的確在下",
    "voice": "vo_adv_1059011_052",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n覺得和米奈娃聊天",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "總是很開心，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "她失蹤的時候，",
    "voice": null,
    "unit_id": 105931
  },
  {
