  {
    "type": "background",
    "bg_id": "501150"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……！",
    "voice": "vo_adv_1057010_015",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你快看啊，{0}！",
    "voice": "vo_adv_1057010_016",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "飛起來了！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "飛起來了！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "舵手",
    "words": "就這樣",
    "voice": "vo_adv_1057010_017",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "舵手",
    "words": "上升到預定高度。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "舵手",
    "words": "──上升完畢。",
    "voice": "vo_adv_1057010_018",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "舵手",
    "words": "\\n維持巡航速度。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "舵手",
    "words": "注意氣流的同時，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "舵手",
    "words": "朝目的地前進。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "目前為止都十分順利。",
    "voice": "vo_adv_1057010_019",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "哇……",
    "voice": "vo_adv_1057010_020",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n這就是在天上飛的景色！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "好壯觀喔……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "糟糕，",
    "voice": "vo_adv_1057010_021",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "現在可是在工作中，我得專心。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "好──",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "要加油囉──！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嗯！",
    "voice": "vo_adv_1057010_022",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那麼就麻煩你跟我",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "一起戒備周圍吧！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接下來的一段時間裡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "吉塔與{0}就這樣站在甲板上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n警戒著他們視線所及範圍有無異狀。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501150"
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "就快到了呢……",
    "voice": "vo_adv_1057010_023",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "各位，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "請提高警覺！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "對喔，",
    "voice": "vo_adv_1057010_024",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "接下來",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就要抵達這次航線最危險的地方了。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "將會經過一座據說棲息著",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "凶暴魔物的山，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n得提防點……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "船員2",
    "words": "不妙，",
    "voice": "vo_adv_1057010_025",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "船員2",
    "words": "魔物出現了！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "船員2",
    "words": "雖然距離還很遠，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "船員2",
    "words": "但牠們是朝著我們吼叫的。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "船員2",
    "words": "\\n是剛好遇到牠們出來散步嗎？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "船員2",
    "words": "注意左舷！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "船員1",
    "words": "既然發現了我們，牠們馬上就會呼朋引伴了……",
    "voice": "vo_adv_1057010_026",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "船員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "船員1",
    "words": "所有人都繃緊神經！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "船員1",
    "words": "魔物馬上就要來襲了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是！{0}！",
    "voice": "vo_adv_1057010_027",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我們靠在一起戰鬥吧！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "背貼著背！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝！",
    "voice": "vo_adv_1057010_028",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "各位，",
    "voice": "vo_adv_1057010_029",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "麻煩你們了！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n非戰鬥人員盡快從甲板上撤離！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
