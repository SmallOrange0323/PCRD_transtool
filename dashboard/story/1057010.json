  {
    "type": "dialogue",
    "name": "旁白",
    "words": "吉塔與{0}成功獲得了在飛空艇上的工作。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n上工第一天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "他們倆在飛空艇啟航的地點碰面──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "大家早安！",
    "voice": "vo_adv_1057010_000",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "從今天起請大家多多指教！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "我們才是，",
    "voice": "vo_adv_1057010_001",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "要請兩位多多指教了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "趕緊做好出發的準備吧。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是！",
    "voice": "vo_adv_1057010_002",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……早安。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "今天要加油喔。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "昨晚",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "有睡好嗎？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "啊哈哈，",
    "voice": "vo_adv_1057010_003",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你也是嗎？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "幸好不是只有我睡不著！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就是說嘛，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "很難入眠呢……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "真的嗎？",
    "voice": "vo_adv_1057010_004",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你好厲害喔～！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "哪像我一點都睡不好……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嘿嘿。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "其實我啊，",
    "voice": "vo_adv_1057010_005",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是第一次期待到",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "睡不著覺喔。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不過因為我有閉上眼，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "還是有睡著一下子──",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "船員1",
    "words": "喂，新來的！",
    "voice": "vo_adv_1057010_006",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "船員1",
    "words": "你們竟然杵在這裡閒聊？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "船員1",
    "words": "\\n別告訴我你們這麼快就鬆懈下來啦？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "對不起，",
    "voice": "vo_adv_1057010_007",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們不是故意的……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "船員2",
    "words": "飛空艇能搭乘的人數有限。",
    "voice": "vo_adv_1057010_008",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "船員2",
    "words": "\\n你們也來幫忙",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "船員2",
    "words": "把貨物運上去吧！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "包在我們身上！",
    "voice": "vo_adv_1057010_009",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n走吧，{0}！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嘿",
    "voice": "vo_adv_1057010_010",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "咻……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這樣就全部搬完了嗎？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "船員3",
    "words": "是啊。",
    "voice": "vo_adv_1057010_011",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "船員3",
    "words": "謝啦，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "船員3",
    "words": "這樣我們就能提早出發了。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "船員3",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "船員3",
    "words": "隊長！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "船員3",
    "words": "隨時都可以出發了！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "明白了！",
    "voice": "vo_adv_1057010_012",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "準備也都已經完成，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n那麼這就起飛吧……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "朝天空起飛。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "出發！",
    "voice": "vo_adv_1057010_013",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "開始離地！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
