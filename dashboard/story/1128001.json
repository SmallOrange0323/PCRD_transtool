[
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}送完了貨，走在街上準備回家。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "喂～！",
    "voice": "vo_adv_1128001_000",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "喂～這邊啦！",
    "voice": "vo_adv_1128001_001",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥～！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "果然是老哥的啦！",
    "voice": "vo_adv_1128001_002",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "等一下～！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥也要去蘭德索爾嗎？",
    "voice": "vo_adv_1128001_003",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "剛好我也要去，一起走吧！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "今天大家都出門了",
    "voice": "vo_adv_1128001_004",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "所以牧場休息一天～",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "栞栞",
    "voice": "vo_adv_1128001_005",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "在精靈之森享受姊妹的兩人時光。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "莉瑪莉瑪",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "提著伴手禮到咲戀小姐家過夜去了。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "鈴鈴也休假",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "回老家了。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "然後啊，",
    "voice": "vo_adv_1128001_006",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "剛好今天",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "在蘭德索爾",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n有一場公會管理協會主辦的",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "初學者戰鬥講習，\\n我打算去聽看看的啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "因為最近牧場四周變得好危險啊～",
    "voice": "vo_adv_1128001_007",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n動不動就會發現魔物的腳印，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我天天都提心吊膽，很怕動物們會被攻擊啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "所以，為了守護牧場，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我一定要變強！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……老實說，",
    "voice": "vo_adv_1128001_008",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我是很不想戰鬥啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n比起戰鬥技術，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我還比較想加強搞笑能力",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "和酪農知識啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過，",
    "voice": "vo_adv_1128001_009",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "再怎麼說我也是公會長。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我有責任要保護大家的安全的啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "為了在緊要關頭",
    "voice": "vo_adv_1128001_010",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "能作為劍與盾而戰，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我必須得先做好準備啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "有備無患就是開心！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哈哈！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哎呀～",
    "voice": "vo_adv_1128001_011",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我使出渾身解數的搞笑竟然被無視的啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "難道對老哥來說太難懂了？",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "而且！",
    "voice": "vo_adv_1128001_012",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "現在是關心穿著的時候嗎？",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n明明有個非常適合當作閒聊話題的哏",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n就在你的眼前耶！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嘿嘿，",
    "voice": "vo_adv_1128001_013",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "謝啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "光是穿上了這套衣服就覺得自己變強了呢。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我終於懂為什麼搞笑藝人和演員",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "會對服裝這麼講究了啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯，",
    "voice": "vo_adv_1128001_014",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但我希望你可以放在心裡想就好不要講出來的啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我這空蕩蕩的胸口",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "也寫不了幾個大字啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "沒錯！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "胸部不大所以胸無大字！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哈哈！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊……",
    "voice": "vo_adv_1128001_015",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "難得講得不錯，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "怎麼講完會這麼空虛的啦……",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "再聊下去沒完沒了，",
    "voice": "vo_adv_1128001_016",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "趕快往鎮上前進吧。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我要直接去聽講習，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥你要去哪？",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真、",
    "voice": "vo_adv_1128001_017",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真的嗎！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我啊，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然嘴上講得很厲害，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n但自己一個人去還是有點怕怕的啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "如果老哥也一起的話，",
    "voice": "vo_adv_1128001_018",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就沒什麼好擔心的啦！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你、",
    "voice": "vo_adv_1128001_019",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你在說什麼啊！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這、",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這種話要向",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你真正重視的人說吧……",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不對，",
    "voice": "vo_adv_1128001_020",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥的意思應該是",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "要保護我不受到物理性的攻擊，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n並非帶有什麼羅曼蒂克的含意。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "也很",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "令人開心了啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "來，",
    "voice": "vo_adv_1128001_021",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那我們出發吧老哥──",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "呃啊！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n很危險耶！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不要突然抓住別人的領子啦！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "咦？",
    "voice": "vo_adv_1128001_022",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真的耶。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "在變強之前就遇上這種事，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n運氣也太差了啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是說，",
    "voice": "vo_adv_1128001_023",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這隻魔物也太悠閒了吧。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這不是魔物，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是牛的啦！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "看這健壯的體格和",
    "voice": "vo_adv_1128001_024",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "漂亮的毛色。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n這是",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "有人養的牛的啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "從農場逃出來的嗎？",
    "voice": "vo_adv_1128001_025",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "還是放牧的時候走失了？",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
