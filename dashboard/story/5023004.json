    "name": "克蘿依",
    "words": "……該不會。",
    "voice": "vo_adv_5023004_045",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "……難不成？",
    "voice": "vo_adv_5023004_046",
    "unit_id": 110911
  },
