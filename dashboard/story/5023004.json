    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "克蘿依，妳等一下。",
    "voice": "vo_adv_5023004_038",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n難道妳不打算見證碧努力的結果嗎？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我知道啦。",
