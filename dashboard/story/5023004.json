  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不過，",
    "voice": "vo_adv_5023004_032",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這想法倒是蠻有道理的。",
