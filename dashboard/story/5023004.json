  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這、這都是",
    "voice": "vo_adv_5023004_003",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "多虧了大家的幫忙呢！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n非、",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "非常感謝！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "恭喜妳～",
