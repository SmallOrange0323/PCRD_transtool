  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "會努力讓自己能跟琪愛兒說話的！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n雖然難度很高……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": "vo_adv_5023004_035",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "等一下等一下，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "妳們怎麼這樣自顧自的就決定了，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n可以不要講得好像人家是個難相處的代表嗎？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n跟琪愛兒相處難度完全不高好嗎？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "……完全不高吧？",
    "voice": "vo_adv_5023004_036",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是，到了特別講座當天――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "唔哇。",
    "voice": "vo_adv_5023004_037",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "人好多。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我可以回去嗎？",
