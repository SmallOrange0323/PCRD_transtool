[
  {
    "type": "background",
    "bg_id": "501322"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某種異變正在蘭德索爾境內無聲無息地進展著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n矛依未與神祕少女接觸後，感受到一股異樣的感覺。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔……",
    "voice": "vo_adv_5110601_000",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "總覺得腦袋從剛剛就一直昏昏沉沉的……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這跟鎮上所發生的異變有關連嗎？",
    "voice": "vo_adv_5110601_001",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "如果真有關連，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那就有點不妙了……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n連我也會變成那個樣子嗎……？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "話說回來，這種感覺",
    "voice": "vo_adv_5110601_002",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "到底是什麼啊……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好像又溫暖",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "又讓人不捨……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……且令人懷念？",
    "voice": "vo_adv_5110601_003",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "咦……？",
    "voice": "vo_adv_5110601_004",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n怎麼",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "眼前",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "一片白……？　",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……尾狗、",
    "voice": "vo_adv_5110601_005",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "刀……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "──！？",
    "voice": "vo_adv_5110601_006",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n好危險好危險，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我剛才不小心",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "睡著了嗎！？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯～",
    "voice": "vo_adv_5110601_007",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "什麼嘛……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "什麼時候跑到外頭來了……？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "而且周遭景色",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還一片朦朧？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這果然是",
    "voice": "vo_adv_5110601_008",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我在做夢吧……？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n話雖如此，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我的意識仍相當清楚呢。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "算了，",
    "voice": "vo_adv_5110601_009",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "怎樣都行！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n勉強自己思考並不是我個人的作風。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n總之，先找找看有沒有可以回到原處的方法！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……不過，",
    "voice": "vo_adv_5110601_010",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "放眼望去，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這裡也只有「那個」而已。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯，",
    "voice": "vo_adv_5110601_011",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n這地方到處都飄浮著",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "讓人摸不著頭緒的奇妙結晶。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這種結晶",
    "voice": "vo_adv_5110601_012",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "很明顯不是普通的結晶。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可以感受到一股奇妙的力量……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "而且更加不可思議的是……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……果真有種",
    "voice": "vo_adv_5110601_013",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "令人懷念的感覺。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可是，",
    "voice": "vo_adv_5110601_014",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我又沒見過這種結晶，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "與其說結晶本身很令人懷念……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n反倒更像是結晶",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "直接……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "與我的內心搭話？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……",
    "voice": "vo_adv_5110601_015",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "要試著用手觸碰看看嗎？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "應該沒問題吧？",
    "voice": "vo_adv_5110601_016",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n不會在觸碰的瞬間",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就轟隆地",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "爆炸吧？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "尾狗刀如果在這裡，",
    "voice": "vo_adv_5110601_017",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大概會說出「要再更小心謹慎點～」",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "之類的話。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "他搞不好會說：",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "「太麻煩了，別管了吧？」",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哈哈。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過，",
    "voice": "vo_adv_5110601_018",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那傢伙現在不在這裡。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我只能相信我自己了呢。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那麼，",
    "voice": "vo_adv_5110601_019",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我要碰囉……！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就在觸碰的瞬間，結晶光芒萬射，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n喚醒了深藏於矛依未心中，令人懷念的光景──",
    "voice": null,
    "unit_id": null
  }
]
