[
  {
    "type": "background",
    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "為了追求美食",
    "voice": "vo_adv_6017205_000",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "四處冒險，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n應該會遭遇不少困難吧。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆有注意到這件事。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "冒著巨大風險追求美食，",
    "voice": "vo_adv_6017205_001",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "可說是冒險家的典範呢。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不過",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "也因為這樣，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "你才能幫助我們這麼多。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "我們",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "真的非常",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "仰賴大家。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "沒想到會聽到這麼實際的答案……！",
    "voice": "vo_adv_6017205_002",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "的確",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "這是很重要的先決條件，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "也許它正是離大家最近的一個敵人。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "無論如何，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "請你",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "要在",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不會影響生活的前提下冒險喔。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "凱留小姐",
    "voice": "vo_adv_6017205_003",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "也說過一樣的話，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n不過兩位回答的時候",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "都一臉非常開心的樣子。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆可以感覺到，你其實真的很開心。",
    "voice": null,
    "unit_id": 109711
  }
]
