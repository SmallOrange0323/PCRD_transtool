  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "唔……",
    "voice": "vo_adv_6044304_000",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗯？，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "怎麼？吉格魯特，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你願意",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "聽我的煩惱啊？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "真不愧是吉格魯特。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對象是你的話，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "說出來應該也無所謂。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "其實……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我打算買伴手禮",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "給惠理子和深月，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你覺得什麼比較好？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哦……",
    "voice": "vo_adv_6044304_001",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這雖然很普通，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "卻有種很吸引人的感覺……！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "明明沒感受到什麼魔力，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "卻不知道為何讓人很想要……！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這個的話，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "相信那兩人也肯定會喜歡吧！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "感謝你，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "祈願竹饅頭……",
    "voice": "vo_adv_6044304_002",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "還有這種東西啊。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "拿來當作伴手禮",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "的確是很簡單明瞭，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n但我身為熾炎戰鬼煉獄血盟暗黑團的團長，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "送這個真的好嗎……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "惠理子和深月會喜歡的東西啊。",
    "voice": "vo_adv_6044304_003",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我說，吉格魯特。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "可以把你身體的一部分",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "送給我嗎？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "例如頭髮之類的。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不對，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我在想些什麼啊！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "抱歉，吉格魯特！",
    "voice": null,
    "unit_id": 113211
  }
]
