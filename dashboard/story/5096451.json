    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "その想いが、",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "ノゾミ",
    "words": "私たちをもっとアイドルの高みに近づけてくれるから♪",
    "voice": null,
    "unit_id": 117211
  },
  {
    "type": "dialogue",
    "name": "チカ",
