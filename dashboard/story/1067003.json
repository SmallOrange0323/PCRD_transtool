    "voice": "vo_adv_1067003_088",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "難得的大餐都白白浪費掉了……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "那、",
    "voice": "vo_adv_1067003_089",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "那個……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "客人……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n很抱歉……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "對不起，給你們造成困擾了。",
    "voice": "vo_adv_1067003_090",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "餐費我就放在這裡囉？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "走吧☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "這麼多……！？",
    "voice": "vo_adv_1067003_091",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "這、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "這位客人！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n請您等一下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "客人～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "剛才的刺客",
    "voice": "vo_adv_1067003_092",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真是過分呢……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n竟然為了自己的目的，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "把大家能夠享受幸福時光的地方拿來利用。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "應該",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還有更好的方法才對不是嗎？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……持有像幫派老大這般",
    "voice": "vo_adv_1067003_093",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "強大的力量，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n肯定會在某處產生",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "與之相對的反抗之力。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "因為我需要利用這股力量，",
    "voice": "vo_adv_1067003_094",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "對於其反抗之力，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n自然也有所準備。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "視時間和場合，有時也會發生這種事～☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你的力量也是如此吧？",
    "voice": "vo_adv_1067003_095",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "公主騎士♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
