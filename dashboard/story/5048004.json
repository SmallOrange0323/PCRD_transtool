  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "哪有，",
    "voice": "vo_adv_5048004_001",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "我只是小兒科而已。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "我反而聽人說",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "依里妳才是遊戲方面的行家。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "\\n像妳這次帶的那遊戲",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "就是內行人才知道的。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "哪裡，",
    "voice": "vo_adv_5048004_002",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "我還差得遠了。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "所以今天",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "我要仔細聽大家聊天，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "好好向大家學習♪",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "欸，",
    "voice": "vo_adv_5048004_003",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "依里妳看！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "這布偶",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "是我之前抽獎抽中的！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "哇！",
    "voice": "vo_adv_5048004_004",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "好可愛喔！",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "這個角色",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "叫什麼呀？",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "咦？",
    "voice": "vo_adv_5048004_005",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "這是",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "「Grateful Eight」的那個倉鼠人……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "\\n應該還算蠻有名的角色吧？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "對對對，",
    "voice": "vo_adv_5048004_006",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "就是那個！",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "剛剛不小心搞錯了。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "真是太糊塗了♪",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喔～",
    "voice": "vo_adv_5048004_007",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "依里閣下！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好厲害的角色切換。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "小惡魔指數高到破表了！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "依里這孩子，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不容小覷！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……呃，",
    "voice": "vo_adv_5048004_008",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "與其說是角色切換，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "感覺更像是變了一個人似的。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喔唷？",
    "voice": "vo_adv_5048004_009",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "鈴閣下，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳是什麼時候到的？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "其實前不久就到了，",
    "voice": "vo_adv_5048004_010",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "只是看到她跟之前判若兩人，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "一不小心就",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "出神到現在了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我記得之前聽別人說，",
    "voice": "vo_adv_5048004_011",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n個性陽光的",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "應該是妹妹才對呀～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "依里依里妳今天",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "該不會是別人扮演的吧？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "討、",
    "voice": "vo_adv_5048004_012",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "討厭啦，鈴妳真會開玩笑～",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "這只是比較誇張的角色切換啦～♪",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我想也是啦。",
    "voice": "vo_adv_5048004_013",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "只是開個玩笑，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不要放在心上。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "呼……",
    "voice": "vo_adv_5048004_014",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "嚇死我了。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "想不到鈴她看起來好像很溫吞，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n直覺卻出奇的敏銳啊。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "不過總之，",
    "voice": "vo_adv_5048004_015",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "既然氣氛也差不多炒熱了，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "接下來就算行為誇張一點，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "也該設法給大家留下好印象。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "畢竟姊姊她是這麼的可愛，",
    "voice": "vo_adv_5048004_016",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n當然要變得更人見人愛才行♪　",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "欸，",
    "voice": "vo_adv_5048004_017",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "各位！",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "我現在想玩個遊戲，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n各位要一起來玩嗎？",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "喔？",
    "voice": "vo_adv_5048004_018",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "好啊。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "依里想玩的遊戲",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "我也很感興趣！",
