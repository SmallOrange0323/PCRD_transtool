  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "你真的好專業喔。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "真是讓人",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "太佩服了！",
