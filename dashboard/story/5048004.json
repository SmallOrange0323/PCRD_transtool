    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "我想玩的是──",
    "voice": "vo_adv_5048004_019",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "真心話大冒險！",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "鈴、七七香",
    "words": "真、",
    "voice": "vo_adv_5048004_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴、七七香",
    "words": "真心話大冒險──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "真心話大冒險就是那個……",
    "voice": "vo_adv_5048004_021",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "現充與",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "玩咖們",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "專屬的派對遊戲……！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "我、",
    "voice": "vo_adv_5048004_022",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "我們的確是遊戲愛好者，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "\\n可是這類遊戲實在有點超出範圍了……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "奇、",
    "voice": "vo_adv_5048004_023",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "奇怪了？",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "還以為",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "大家會",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n反應熱絡地大喊著「耶～！」呢……",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "而且話說",
    "voice": "vo_adv_5048004_024",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "我比較想跟依里妳聊更多有關遊戲的話題。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "\\n其實我對",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "「天魔學園默示錄」有點興趣，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "想請教依里妳的感想。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "喔喔，",
    "voice": "vo_adv_5048004_025",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "畢竟依里可是七七香認證過的硬派玩家嘛。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "也教我怎麼打「黑暗求生者」的隱藏Boss好嗎？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "怎、",
    "voice": "vo_adv_5048004_026",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "怎麼辦……",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "完全聽不懂他們在說什麼……",
    "voice": null,
    "unit_id": 113812
