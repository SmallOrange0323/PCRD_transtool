  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "卻忘記真正該傳達的",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "不是只是這一面。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "姊姊雖然個性怕生，",
    "voice": "vo_adv_5048004_052",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "但其實是個比誰都溫柔，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n懂得體貼他人的女孩子。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "這次我不會再搞錯了。",
    "voice": "vo_adv_5048004_053",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "讓我",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "把妳的優點，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "毫無保留地",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "呈現給大家吧，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "姊姊！　",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "耶，",
    "voice": "vo_adv_5048004_054",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "我贏了！",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "太、",
    "voice": "vo_adv_5048004_055",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "太強了……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "太厲害了！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n就算妳是唯一玩過遊戲的人，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "也未免太技壓群雄了！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n【惡魔偽王國軍】的天使",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "都是怪物嗎！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "嗯，",
    "voice": "vo_adv_5048004_056",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "這遊戲規則簡單，初學者也很有勝算，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "\\n但明明眼看就快要贏了，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "\\n最後卻還是被妳擊倒。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性參賽者",
    "words": "遊戲實力果然名不虛傳呢！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "嘻嘻，",
    "voice": "vo_adv_5048004_057",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "妳們也把我捧太高了吧。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "太好了……",
    "voice": "vo_adv_5048004_058",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "還好這個遊戲",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "我陪姊姊玩過好幾次，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n也是我唯一贏得過姊姊的遊戲。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "欸，",
    "voice": "vo_adv_5048004_059",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "我們再比一場吧！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "\\n我覺得",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "我好像玩這遊戲玩上癮了啊！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "好的，",
    "voice": "vo_adv_5048004_060",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "要比幾次都歡迎。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n只不過，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "我是絕對不會輸的喔♪",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "那個……",
    "voice": "vo_adv_5048004_061",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "今天因為不少生面孔，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "害我有點緊張。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n沒能好好表達真是對不起。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "然後，",
    "voice": "vo_adv_5048004_062",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "要是可以的話，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "下次也請邀我參加喔。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "我下次一定會表現得比這次更好的！",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "喔喔，",
    "voice": "vo_adv_5048004_063",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "沒問題！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性參賽者",
    "words": "我們竭誠歡迎！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "呼，",
    "voice": "vo_adv_5048004_064",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "總算是撐過去了……",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n這大概是我這輩子碰過的最大危機吧。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "要是那時哥哥沒來當忙解圍，",
    "voice": "vo_adv_5048004_065",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n我現在應該已經搞砸了吧。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "果然",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "還是哥哥最可靠了！",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "嗯。",
    "voice": "vo_adv_5048004_066",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "幸好她們倆當時替我解圍。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "其實鈴跟七七香",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "應該早就察覺出什麼，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "但還是配合著我，什麼都沒過問。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "姊姊還真是",
    "voice": "vo_adv_5048004_067",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "交到了一群好朋友呢。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "這就像是",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "自己的事一樣令人開心。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "但是，除了哥哥你們幫我大忙之外，",
    "voice": "vo_adv_5048004_068",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "更重要的是我重新回想過了有關姊姊的事。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "要不然，",
    "voice": "vo_adv_5048004_069",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "線下聚現在應該已經被我搞砸了，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n就算維持住場面，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "給人的印象也肯定不會太好呢。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "嗯～",
    "voice": "vo_adv_5048004_070",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "看來姊姊她",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "遠超出我的認識，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n是個更更更～",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "棒的好姊姊呢。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "啊～",
    "voice": "vo_adv_5048004_071",
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "想著想著突然好想看看姊姊。",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "我們快回去吧，",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "哥哥！",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "腦海裡浮現心愛的姊姊依里的模樣，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n茜里輕快地邁開了腳步。",
    "voice": null,
    "unit_id": null
  }
]
