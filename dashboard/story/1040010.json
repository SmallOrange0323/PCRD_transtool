    "type": "dialogue",
    "name": "碧",
    "words": "\\n我",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "確實有成長了……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "{0}！",
    "voice": "vo_adv_1040010_055",
