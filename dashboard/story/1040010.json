  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但我總有一天會交到朋友的！",
    "voice": null,
    "unit_id": 104011
  },
