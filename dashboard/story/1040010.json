  {
    "type": "dialogue",
    "name": "旁白",
    "words": "宣布BB團重新開始活動後，{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n決定帶碧離開精靈之森，前往城鎮。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我、",
    "voice": "vo_adv_1040010_000",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我我我我我我我我、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我該怎麼辦才好……！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "像我這種邊緣人",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "居然要上街交朋友……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我沒有問題嗎……？",
    "voice": "vo_adv_1040010_001",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我果然",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "會在被發現是邊緣人的瞬間，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n被大家扔石頭跟欺負吧……？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "快冷靜下來，碧！",
    "voice": "vo_adv_1040010_002",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n像這種時候",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "只要用力深呼吸，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n在掌心裡寫下「精靈族」再吃下去，就能放鬆了！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說、",
    "voice": "vo_adv_1040010_003",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說得也是……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "吸吸吐……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "吸吸吐……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n然後……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "寫下「精靈族」……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我吃……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呀啊啊啊～～～！？\\n對不起對不起對不起對不起！",
    "voice": "vo_adv_1040010_004",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n拜託了，請不要丟我石頭～！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，",
    "voice": "vo_adv_1040010_005",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "原來是團長嗎……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對不起，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "一聽說要去街上，我就感到很動搖……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我是想讓自己冷靜下來，才會一直跟「有我在喔好朋友號」說話。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "果然",
    "voice": "vo_adv_1040010_006",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不去不行對吧……？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n老實說……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我非常害怕……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我是有去過街上……",
    "voice": "vo_adv_1040010_007",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但是有目的才不得不去的程度……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "一定會跟人擦身而過時，",
    "voice": "vo_adv_1040010_008",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我會改成匍匐前進",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "來避免跟人對上目光……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "而且，",
    "voice": "vo_adv_1040010_009",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就算去街上，我也不認為自己交得到朋友。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n畢竟光是跟{0}成為朋友，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n也已經像是奇蹟一樣了……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要",
    "voice": "vo_adv_1040010_010",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "交朋友檢定只有10級的我，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n再交新的朋友……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n還太早了！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗚……！",
    "voice": "vo_adv_1040010_011",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n正論刺得我好痛……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "確實是……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那樣沒錯。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "而且，",
    "voice": "vo_adv_1040010_012",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "既然{0}都那麼說了，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n肯定是有什麼用意……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我明白了……！",
    "voice": "vo_adv_1040010_013",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n雖然很害怕，",
