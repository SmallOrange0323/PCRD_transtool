  {
    "type": "dialogue",
    "name": "旁白",
    "words": "嘉夜和大吾之間的對決之日終於到來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了見證兩人的戰鬥，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n無論是騎士、貴族或無賴都聚集在會場邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "{0}，",
    "voice": "vo_adv_1065012_000",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "今天就麻煩你當我的助手了！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我會不客氣地依賴你的，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你可要做好準備啊！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好～了……",
    "voice": "vo_adv_1065012_001",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那我們就去",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "見他一面吧！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……我說啊，大吾先生。",
    "voice": "vo_adv_1065012_002",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "在上次見面之前，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我們曾見過一面。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你記得嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "不知道啦。",
    "voice": "vo_adv_1065012_003",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "妳要是想被本大爺記住的話，",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "\\n嘴巴嘰哩呱啦地講也沒有意義。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "用拳頭來讓本大爺記住吧。",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……嗯。",
    "voice": "vo_adv_1065012_004",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我會讓你徹底記住我，不再把我忘掉。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯……",
    "voice": "vo_adv_1065012_005",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這次的對手非常強。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我得相信自己才行呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好！",
    "voice": "vo_adv_1065012_006",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我要上了！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "放馬過來！",
    "voice": "vo_adv_1065012_007",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "觀眾",
    "words": "唔喔喔喔喔喔喔！！",
    "voice": "vo_adv_1065012_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我要迅速打倒你！",
    "voice": "vo_adv_1065012_009",
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "喝啊！",
    "voice": "vo_adv_1065012_010",
    "unit_id": 190711
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "不痛不癢啊！",
    "voice": null,
    "unit_id": 190711
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嘖！",
    "voice": "vo_adv_1065012_011",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "居然都是大動作攻擊啊！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "他的拳壓好驚人……！",
    "voice": "vo_adv_1065012_012",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "隨便靠近的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "會被他一拳KO的！",
    "voice": null,
    "unit_id": 106511
  },
  {
