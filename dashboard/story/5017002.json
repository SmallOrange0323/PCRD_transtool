  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在【咲戀育幼院】生活幾天後，\\n愛蜜莉雅她們已經和育幼院的成員們完全打成一片了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯～",
    "voice": "vo_adv_5017002_000",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "今天天氣非～常好！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "是個絕佳的購物日！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的，",
    "voice": "vo_adv_5017002_001",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n愛蜜莉雅小姐",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎也已經習慣了這裡的生活。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "still",
    "still_id": "501700201"
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "是啊，",
    "voice": "vo_adv_5017002_002",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真的很感謝大家。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n這一切",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "都多虧了【咲戀育幼院】裡的人這麼照顧我們，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "還有把咲戀小姐介紹給我們的可可蘿他們！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真的非～常感謝。",
    "voice": "vo_adv_5017002_003",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "好孩子好孩子♪",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那、",
    "voice": "vo_adv_5017002_004",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請不要摸在下的頭。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n不是，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下並不討厭這樣，只是……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "妳看，",
    "voice": "vo_adv_5017002_005",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "姊姊。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n愛蜜莉雅大人",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "非常喜歡可可蘿小姐呢。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "因為兩人不僅同是妖精，",
    "voice": "vo_adv_5017002_006",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "連髮色和眼睛的顏色都一樣嘛。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n即使有多了個妹妹的感覺也不奇怪。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "姊姊力很強的拉姆我懂這種感覺……",
    "voice": "vo_adv_5017002_007",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n擁有可愛妹妹的姊姊，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是世界上最幸運的人。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不是的，",
    "voice": "vo_adv_5017002_008",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "姊姊。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不是那樣的。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "擁有好姊姊的妹妹，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "才是世界上最幸福的人。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "哎呀，",
    "voice": "vo_adv_5017002_009",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "妳嘴巴變甜了耶，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雷姆。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真可愛。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "姊姊……",
    "voice": "vo_adv_5017002_010",
    "unit_id": 109711
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "哎呀呀，",
    "voice": "vo_adv_5017002_011",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳們幾個。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n在大馬路上還這麼恩愛呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咦，",
    "voice": "vo_adv_5017002_012",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咲戀小姐？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗨，",
    "voice": "vo_adv_5017002_013",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "愛蜜莉雅。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還有拉姆和雷姆妳們好。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "看來妳們跟可可蘿處得不錯呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯。",
    "voice": "vo_adv_5017002_014",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我們",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "感情",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "非～常好。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "對吧？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都、",
    "voice": "vo_adv_5017002_015",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都說請不要摸在下的頭了……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯嗯，",
    "voice": "vo_adv_5017002_016",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "感情和睦是件美事。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "而且妳們也很照顧我們的孩子，真的幫了大忙。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "因為我們受到育兒院的照顧。",
    "voice": "vo_adv_5017002_017",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "而且鈴莓小姐和孩子們也都對我們很好。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "鈴莓又總是少根筋，",
    "voice": "vo_adv_5017002_018",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "看都看不膩。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不曉得雷姆來幫忙之前",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "育兒院到底是怎麼營運的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "平常的話綾音和胡桃會幫她的忙喔。",
    "voice": "vo_adv_5017002_019",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳們幾個來了以後",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓似乎也很努力。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "說到這個……",
    "voice": "vo_adv_5017002_020",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "胡桃小姐最近正感慨打破的盤子和燒焦的鍋子",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "越來越多……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "因、",
    "voice": "vo_adv_5017002_021",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "因為鈴莓小姐",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是一位很努力的人。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不過，",
    "voice": "vo_adv_5017002_022",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "也因為這樣所以綾音和胡桃都很細心呢。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n年紀那麼小，但做菜和打掃樣樣拿手，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "而且非～常乖巧！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "小孩們也不會怕我……",
    "voice": "vo_adv_5017002_023",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n雖然現在不該這麼悠哉，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "但我",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真的有點幸福。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "感受到幸福和時機可是一點關係也沒有喔。",
    "voice": "vo_adv_5017002_024",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "只要愛蜜莉雅妳感覺快樂幸福，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那就足夠稱做幸福了嘛。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咲戀小姐……",
    "voice": "vo_adv_5017002_025",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我也是，",
    "voice": "vo_adv_5017002_026",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "聽到妳們稱讚那些孩子也很高興喔？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不論妳想待到什麼時候都沒關係。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這並不是基於我們都是精靈族的關係，",
    "voice": "vo_adv_5017002_027",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n但彼此都是精靈族，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "像這樣互相幫助不是也很好嗎？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您真了不起，",
    "voice": "vo_adv_5017002_028",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咲戀小姐。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下和主公大人",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都很敬佩您。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯。",
    "voice": "vo_adv_5017002_029",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我因此也得到了許多的勇氣。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n真的，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咲戀小姐真的很厲害。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "別連你也叫我「媽媽」啦。",
    "voice": "vo_adv_5017002_030",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "才十七歲而已喔？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "十、",
    "voice": "vo_adv_5017002_031",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "十七歲……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我得",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "更努力才行了……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "哎呀，",
    "voice": "vo_adv_5017002_032",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "怎麼連你也變得這麼正經八百的。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沒關係啦。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真是的，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "大家就像一家人一樣嘛。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "喔喔，",
    "voice": "vo_adv_5017002_033",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "家人……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這真是一個很棒的字眼。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下也想要和主公大人",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "建立這麼深厚的羈絆。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過話又說回來，",
    "voice": "vo_adv_5017002_034",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咲戀小姐。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "鮮少在這個時間見到您呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "因為我被【王宮騎士團】找去啊──",
    "voice": "vo_adv_5017002_035",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "路上",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "突然想看看育幼院的大家，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就繞過來看一下。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "王宮……",
    "voice": "vo_adv_5017002_036",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咲戀小姐是城堡裡的大人物嗎？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "並不是那樣的。",
    "voice": "vo_adv_5017002_037",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "只是我曾擔任過【王宮騎士團】的副團長。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n因為這層關係，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "到了現在有事的時候他們還是偶爾會找我去。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "聽說最近",
    "voice": "vo_adv_5017002_038",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "蘭德索爾附近的村莊",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n有人失蹤，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還有一些怪異的目擊情報。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然目前還沒有造成明顯的騷動，",
    "voice": "vo_adv_5017002_039",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n但等到真的發生什麼事就太遲了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "所以他們",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也找我過去了解狀況。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "失蹤，",
    "voice": "vo_adv_5017002_040",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "還有怪異的目擊情報……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那個，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "拉姆、",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "雷姆。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那該不會就是……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是啊，",
    "voice": "vo_adv_5017002_041",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "愛蜜莉雅大人。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n拉姆也覺得",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "十之八九不會錯的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "大罪司教……",
    "voice": "vo_adv_5017002_042",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "――？",
    "voice": "vo_adv_5017002_043",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n妳們幾個",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那個，",
    "voice": "vo_adv_5017002_044",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咲戀小姐。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n妳們在城堡討論的內容，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n之後是否可以告訴我呢？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "那個，",
    "voice": "vo_adv_5017002_045",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "詭異事件的犯人",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n可能就是我們在找的人也說不定。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是這樣子嗎，",
    "voice": "vo_adv_5017002_046",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這是為了妳們呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我會去多了解詳情。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過，",
    "voice": "vo_adv_5017002_047",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "在那之前請妳們不要胡來喔。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這就是我對妳們提出的條件。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯，",
    "voice": "vo_adv_5017002_048",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "拜託妳了，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咲戀小姐。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "很好，",
    "voice": "vo_adv_5017002_049",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "回答得好。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那麼，我",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "先去一趟王宮。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n妳們",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "去買東西也要注意安全喔。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咲戀小姐",
    "voice": "vo_adv_5017002_050",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真的很了不起。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "明明都是妖精，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "但我跟她真的差太多了。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下覺得您不需要和咲戀小姐比較",
    "voice": "vo_adv_5017002_051",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n而感覺自己不如她。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咲戀小姐有咲戀小姐的優點。",
    "voice": "vo_adv_5017002_052",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "愛蜜莉雅小姐則有愛蜜莉雅小姐的優點。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "可可蘿……",
    "voice": "vo_adv_5017002_053",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "謝謝妳。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我覺得自己好像恢復了精神。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "把迅速就重新振作起來的愛蜜莉雅大人先放一旁，",
    "voice": "vo_adv_5017002_054",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n那個魔女教在王宮似乎也已經成為話題了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "失蹤再加上目擊證詞……",
    "voice": "vo_adv_5017002_055",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "究竟",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "大罪司教有什麼陰謀？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "目前還不清楚，",
    "voice": "vo_adv_5017002_056",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不多注意不行。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我們現在也還不知道昴到底身在何方。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真的是個",
    "voice": "vo_adv_5017002_057",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不管到哪裡都很會給別人添麻煩的男人。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那傢伙真的是個問題之王。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不論何事能專精為王就是好事。",
    "voice": "vo_adv_5017002_058",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "真不愧是昴，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "就是個充滿潛力的原石！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雷姆小姐",
    "voice": "vo_adv_5017002_059",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您真的很仰慕那位昴先生呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下懂的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "因為在下",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "對主公大人的心情也是一樣的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是的！",
    "voice": "vo_adv_5017002_060",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "可可蘿小姐！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "妳能理解這種心情真的讓我很開心！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雷姆雖然是我可愛的妹妹，",
    "voice": "vo_adv_5017002_061",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "但竟然會選擇巴魯斯，這種品味實在令人難以苟同。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "總之，",
    "voice": "vo_adv_5017002_062",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我們得趕快找到昴才行。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "彷彿",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "他一直在躲我們一樣，怎麼找也找不到他。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "若再不快點，",
    "voice": "vo_adv_5017002_063",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "在打倒大罪司教之後",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n我們就要自己回宅邸了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "拉姆，",
    "voice": "vo_adv_5017002_064",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "妳也真是的。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不要說那麼壞心的話嘛！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "――――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人？",
    "voice": "vo_adv_5017002_065",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您怎麼突然停下腳步？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "會被大家丟下喔？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "對對，",
    "voice": "vo_adv_5017002_066",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "手腳要俐落一點。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "把鈴莓囑咐要買的東西買回來後，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n我們也去幫忙做育幼院的工作吧。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "好的，",
    "voice": "vo_adv_5017002_067",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "打掃、洗衣",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "還有做菜全交給雷姆吧！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "然後",
    "voice": "vo_adv_5017002_068",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "在一旁監督就是拉姆的工作。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "來吧，",
    "voice": "vo_adv_5017002_069",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "可可蘿也一起去吧？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "畢竟",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "被這麼樣的委託買東西了。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯，",
    "voice": "vo_adv_5017002_070",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下明白。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那麼主公大人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們也出發吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呼，",
    "voice": "vo_adv_5017002_071",
    "unit_id": 2712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "好險好險。",
    "voice": null,
    "unit_id": 2712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我還以為會被發現，",
    "voice": null,
    "unit_id": 2712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那傢伙直覺真準。",
    "voice": null,
    "unit_id": 2712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "好了，",
    "voice": "vo_adv_5017002_072",
    "unit_id": 2712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就從這裡開始，",
    "voice": null,
    "unit_id": 2712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這裡……",
    "voice": null,
    "unit_id": 2712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我呢，",
    "voice": null,
    "unit_id": 2712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可別出差錯才好喔。",
    "voice": null,
    "unit_id": 2712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "命運，",
    "voice": null,
    "unit_id": 2712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "等著瞧。",
    "voice": null,
    "unit_id": 2712
  }
]
