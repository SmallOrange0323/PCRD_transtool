  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "這這這、",
    "voice": "vo_adv_5150006_005",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "這我知道啊！",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "可是，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我從剛才只要每次調回原狀，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "就會立刻又發生變化啊！",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "涅比亞，",
    "voice": "vo_adv_5150006_006",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "借我看一下好嗎？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……環境系統似乎",
    "voice": "vo_adv_5150006_007",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "以現在進行式持續變更呢。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就算下達修正指令，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也會立刻",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "發生下一個環境變化。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……這完全是",
    "voice": "vo_adv_5150006_008",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "出bug了吧。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "居民們",
    "words": "嗚哇～～～！",
    "voice": "vo_adv_5150006_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這件事",
    "voice": "vo_adv_5150006_010",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就交給我負責吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我會動員全體團員執行的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "絕對不會讓任何人受傷。",
    "voice": "vo_adv_5150006_011",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……畢竟這是",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "快樂的夏季活動啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也來幫忙。",
    "voice": "vo_adv_5150006_012",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "放心吧，",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你就去做自己該做的事。",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳們……！",
    "voice": "vo_adv_5150006_013",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那麼，",
    "voice": "vo_adv_5150006_014",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花就來對抗這場狂風暴雨吧！",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好，就交給妳了。",
    "voice": "vo_adv_5150006_015",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……嗯？",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳剛才說對抗狂風暴雨？",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是的！",
    "voice": "vo_adv_5150006_016",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n空花",
