  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "正當得知涅比亞真正的想法，以為短暫的夏季騷動要落幕之際，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n涅比亞操作的環境系統「索爾生成系統」",
    "voice": null,
    "unit_id": null
  },
