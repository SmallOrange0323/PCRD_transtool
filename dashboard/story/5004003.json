[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呼、呼、",
    "voice": "vo_adv_5004003_000",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哈、哈……！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喂，",
    "voice": "vo_adv_5004003_001",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n自己走啦，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我沒有什麼力氣，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳不會要我背著妳走吧？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要不是因為情況緊急，哪會給妳這種福利啊！",
    "voice": "vo_adv_5004003_002",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n記得要好好感謝我啊！？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喂，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們到了可蘿仔他們消失的地方了喔！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔咕……",
    "voice": "vo_adv_5004003_003",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n不要叫得那麼大聲啦，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我的頭都嗡嗡作響了。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳沒問題吧？",
    "voice": "vo_adv_5004003_004",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳現在看起來狀況超差的耶～",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n總是精神飽滿不是妳唯一的優點嗎？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔嗯。和大家一起來旅行太開心了，",
    "voice": "vo_adv_5004003_005",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n結果玩過頭，一路累到隔天了對吧？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也和妳一樣啊，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "全身肌肉酸痛的……！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以，我才不想揹著妳這個笨重的身軀走咧！",
    "voice": "vo_adv_5004003_006",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n快下來，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "從這裡開始就給我站好自己走了吧！？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呵呵。妳一邊抱怨……卻一邊擔心我的身體狀況，",
    "voice": "vo_adv_5004003_007",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n還盡可能地穩住身子揹起我，我真的好喜歡小凱留喲。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿咻……",
    "voice": "vo_adv_5004003_008",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊～",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎麼感覺暈暈的。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳真的沒問題嗎？",
    "voice": "vo_adv_5004003_009",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n要為妳施點",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "恢復魔法嗎？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不用了。小可蘿他們不是消失了嗎？",
    "voice": "vo_adv_5004003_010",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n很有可能是發生了什麼異變了……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n魔力還是",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "儘可能的保存起來比較好吧。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說的也是。",
    "voice": "vo_adv_5004003_011",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳的話，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只要吃點什麼東西就能若無其事地恢復了吧……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "話說",
    "voice": "vo_adv_5004003_012",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "海之家居然還沒開始營業，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "本來想去隨便買點什麼來吃的說。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯～",
    "voice": "vo_adv_5004003_013",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是對不起……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我現在，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "感覺吃什麼都無法打起精神了。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有件事雖然很難以啟齒……",
    "voice": "vo_adv_5004003_014",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我今天一早起來後，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n發現我帶著過來的",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「皇家裝備」不見了。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我慌慌張張地到處尋找，還是不見蹤影……",
    "voice": "vo_adv_5004003_015",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n只要有「皇家裝備」，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n攝取到的卡路里就會",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "直接變成滿滿元氣呢。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "蛤啊？",
    "voice": "vo_adv_5004003_016",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　「皇家裝備」不見了？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這是怎麼回事，好好管理自己的東西好不好！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n如此重要的東西，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那是妳的生命線不是嗎……！？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚嗚。",
    "voice": "vo_adv_5004003_017",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過真的很不可思議耶……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n因為為了就算睡眠期間被襲擊也能隨時應對，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我一直有把「皇家裝備」抱著睡的習慣。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "早上起來，",
    "voice": "vo_adv_5004003_018",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不知為何就消失不見了。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼",
    "voice": "vo_adv_5004003_019",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "「消失不見」啊……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n該怎麼辦啊，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳能強得這麼離譜",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不就是因為多虧了「皇家裝備」嗎？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳現在只穿著泳裝一點裝備也沒有，",
    "voice": "vo_adv_5004003_020",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "根本是無用武之地的米蟲啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好過份……",
    "voice": "vo_adv_5004003_021",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n不過妳說的倒是一點也沒錯，我沒辦法反駁～",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哭哭。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不要哭了啦……真是傷腦筋～這下真的很不妙了。",
    "voice": "vo_adv_5004003_022",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我現在魔力也枯竭中，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n貪吃佩可的「皇家裝備」還不見蹤影？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "已經山窮水盡，一點辦法也沒有了！",
    "voice": "vo_adv_5004003_023",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "該如何是好，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n{0}跟可蘿仔和那傢伙消失不見了啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "欸～！",
    "voice": "vo_adv_5004003_024",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "　【美食殿堂】的各位～！",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗚喵！？",
    "voice": "vo_adv_5004003_025",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n啊啊嚇死我了，妳是……嗯……？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，是咲戀育幼院的鈴莓！",
    "voice": "vo_adv_5004003_026",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n妳在海之家打工對吧……",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "欸，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}！\\n你不是消失不見了嗎？",
    "voice": "vo_adv_5004003_027",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你怎麼會",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "和鈴莓在一起……？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個。",
    "voice": "vo_adv_5004003_028",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n就是不知道為何{0}倒在了海邊……",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我暫時幫他做了點應急救治，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "並了解了一下狀況。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "看來{0}和可可蘿，",
    "voice": "vo_adv_5004003_029",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n似乎是一起被",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "巨大魔物拖進海中去了。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "像這樣，被海中伸出的像觸手一般的東西纏住……",
    "voice": "vo_adv_5004003_030",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n在驚慌失措下，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "連抵抗的機會都沒有，就被拖進海裡去了吧。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔～嗯。",
    "voice": "vo_adv_5004003_031",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n才想說你們",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎麼突然消失不見的……？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "巨大魔物？",
    "voice": "vo_adv_5004003_032",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　那是什麼啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n平時那麼和平的瑪爾傑海岸，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "居然有那種東西？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "話說回來。",
    "voice": "vo_adv_5004003_033",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n既然如此，{0}為什麼還一副沒什麼大礙的樣子啊？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還有一起被拖下去的",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小可蘿呢……？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這個嘛，按照{0}的說法……",
    "voice": "vo_adv_5004003_034",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n在被拖入海中的同時，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n好像是可可蘿小姐用了自己的長槍",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "將觸手切斷了的樣子。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "比起自己的安危，",
    "voice": "vo_adv_5004003_035",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n先確保了{0}的安全……",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不過在切斷了纏繞{0}的觸手的同時，",
    "voice": "vo_adv_5004003_036",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n失去了意識，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "於是就這樣……",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼嘛……",
    "voice": "vo_adv_5004003_037",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n為何都到了這種時候，還選擇以「主人﹞為優先而忽略自己啊？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n可蘿仔這傢伙，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是個大笨蛋～！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那是",
    "voice": "vo_adv_5004003_038",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼時候的事了。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n在水裡面無法呼吸，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "再不趕快把可蘿仔救出來的話，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "她會缺氧而死的……！",
    "voice": null,
    "unit_id": 107811
  }
]
