    "words": "唱歌",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "也是能透過一點訣竅來提升的。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "比如說，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "破音的話──",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "～～～～♪",
    "voice": "vo_adv_5202062_012",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "……好厲害，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "居然能這麼滑順地唱出高音！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "男性精靈族",
    "words": "我還是第一次能這麼隨心所欲地唱出來……！",
