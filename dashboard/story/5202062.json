    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那時候一樣？　",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "為了{0}，",
    "voice": "vo_adv_5202062_025",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我要手把手地一步一步從基礎開始指導他唱歌……",
