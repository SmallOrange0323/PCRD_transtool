  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在精靈族之村，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "千歌著手進行演唱會的準備。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n同時一找到空閒時間，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "也在努力練習歌曲演唱。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "～～～～♪",
    "voice": "vo_adv_5202062_000",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "{0}！\\n這是當然的！",
    "voice": "vo_adv_5202062_001",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "因為這次可是為了村民們",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所舉辦的特別演唱會！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "而且，",
    "voice": "vo_adv_5202062_002",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我也很高興蘭法小姐和我有一樣的想法……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n想要用自己的方式",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "盡全力回應她！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這裡離村子有一小段距離，",
    "voice": "vo_adv_5202062_003",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我想說在這裡就不會被人看到，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可以好好地練習。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以──",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "啊！",
    "voice": "vo_adv_5202062_004",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "果然沒錯吧！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "\\n我就想說從遠處傳來了美妙的歌聲！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "男性精靈族",
    "words": "如果能像那樣自由自在地唱歌，",
    "voice": "vo_adv_5202062_005",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "男性精靈族",
    "words": "\\n肯定會很快樂吧……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "…………",
    "voice": "vo_adv_5202062_006",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "沒問題的，",
    "voice": "vo_adv_5202062_007",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "{0}。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n雖然確實嚇了我一跳，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不過這種程度不要緊的。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊，",
    "voice": "vo_adv_5202062_008",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但是……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "兩位，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我在這裡練習的事，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還請拜託幫我保密喔。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "偷看的兩人",
    "words": "「好的～！」",
    "voice": "vo_adv_5202062_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "偷看的兩人",
    "words": "\\n「是……！」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "話說回來，",
    "voice": "vo_adv_5202062_010",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "妳的歌聲真的很棒呢！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "不像我，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "想要發出高音的時候",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "總是會唱破音。",
