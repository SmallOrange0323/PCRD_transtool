    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "和小孩子們在正式開始之前練習呢。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n當時是一起登上舞台……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對了！　",
    "voice": null,
    "unit_id": 134411
  },
  {
