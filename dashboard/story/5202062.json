  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "這種事……",
