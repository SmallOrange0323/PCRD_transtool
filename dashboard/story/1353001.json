    "name": "店長",
    "words": "啊哈哈，",
    "voice": "vo_adv_1353001_012",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我才該跟你們道謝！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n你們真的很能幹呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不愧是",
