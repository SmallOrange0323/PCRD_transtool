    "words": "閃耀的太陽。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "波光粼粼的海洋。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "眩目的泳衣季節。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在氣溫急速上升的盛夏海邊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n可璃亞和{0}在度假村打工。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "讓您久等了。",
    "voice": "vo_adv_1353001_000",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這是您點的麥酒♪",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "下一位客人，",
    "voice": "vo_adv_1353001_001",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "您要點章魚燒是嗎～",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥～！",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "章魚燒一份，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "麻煩你了～♪",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "{0}、",
    "voice": "vo_adv_1353001_002",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "可璃亞，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "辛苦了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不愧是你們兩位，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "真有默契～！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "說什麼真有默契，",
    "voice": "vo_adv_1353001_003",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "太過獎了。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是因為哥哥配合我，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "讓我做起來很順手♪",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……店長，",
    "voice": "vo_adv_1353001_004",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "久疏問候了。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n餐廳的經營",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "還順利嗎？",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "嗯嗯，",
    "voice": "vo_adv_1353001_005",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "非常好喔！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "多虧你們，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我還開了海之家分店呢！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這些",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "都要感謝",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "你們那時來這邊打工啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哪裡哪裡。",
    "voice": "vo_adv_1353001_006",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不過真是讓人懷念呢♪",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……哥哥，你還記得嗎？",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n我第一次打工時的事情。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "嗯，",
    "voice": "vo_adv_1353001_007",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我和你討論想打工的事，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n哥哥就跟我一起來了呢♪",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n那時候真的好開心～",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "你、",
    "voice": "vo_adv_1353001_008",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "你忘記了嗎……？",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那時候，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我和哥哥討論想打工的事，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n你不就跟我一起來了嗎。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我那時是因為看到「充滿笑容的職場」，",
    "voice": "vo_adv_1353001_009",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這個求職廣告才去應徵的。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "結果聽到的",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "卻是地痞們的",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "「咕嘿嘿～」",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "笑聲。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n一開始還以為",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "自己被騙了……",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不過，",
    "voice": "vo_adv_1353001_010",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "之後我和哥哥一起努力接待客人。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n客人們",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "也幾乎都很溫柔。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "真的是很寶貴的經驗呢♪",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "店長，",
    "voice": "vo_adv_1353001_011",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "再次感謝你",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "當時的照顧。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n而且還又找哥哥和我一起來打工，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n我真的非常高興♪",
    "voice": null,
    "unit_id": 135311
  },
  {
