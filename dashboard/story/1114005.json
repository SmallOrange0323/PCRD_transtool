    "voice": "vo_adv_1114005_009",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "雖然有點害怕……",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……但是，",
    "voice": "vo_adv_1114005_010",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "好期待呢！",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "background",
    "bg_id": "500132"
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "哇……",
    "voice": "vo_adv_1114005_011",
    "unit_id": 111411
  },
  {
