    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "所以我原諒你。",
    "voice": "vo_adv_1114005_006",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n但是作為交換……",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……能像爸爸一樣",
    "voice": "vo_adv_1114005_007",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "牽著露娜的手嗎？",
    "voice": null,
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "……呵呵！",
    "voice": "vo_adv_1114005_008",
    "unit_id": 111411
  },
  {
    "type": "dialogue",
    "name": "露娜",
    "words": "\\n好大啊，",
