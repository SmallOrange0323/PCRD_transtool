    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "快去吧！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝謝妳，真琴。",
    "voice": "vo_adv_1002012_006",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我出發囉。",
    "voice": null,
    "unit_id": 100211
