    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那我們聽到的小孩聲音是？　",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊──",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊已經搞不懂了！",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "……萬聖節會將死者與生者的世界連結起來。",
    "voice": "vo_adv_5025005_010",
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "在這天，",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "那些年輕尚輕就逝去的靈魂，",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n會混進現世在過節的孩子們裡，",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "一起來享受萬聖節。",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "我就",
    "voice": "vo_adv_5025005_011",
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "邀請那些靈魂進入宅邸，",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "讓它們成為花的朋友。",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "為了安慰在我死後",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "變得孤身一人的",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "這孩子……",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "讓幽靈當朋友？　",
    "voice": "vo_adv_5025005_012",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "可是她說",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "朋友會消失……",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "它們的靈魂能存在於現世的時間就只有",
    "voice": "vo_adv_5025005_013",
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "萬聖節當天。",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "所以我",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "會在萬聖節結束前，",
