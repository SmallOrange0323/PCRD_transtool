    "name": "男",
    "words": "沒錯……",
    "voice": "vo_adv_5025005_006",
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "我是爸爸喔……",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "我們一直都",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "在一起呢。",
    "voice": null,
    "unit_id": 3511
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個人是",
    "voice": "vo_adv_5025005_007",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "花的父親？　",
