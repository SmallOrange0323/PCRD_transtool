  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "什麼意思？",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n那個叔叔是花的爸爸……",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "可是他是幽靈？",
