    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不過既然你推薦了，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
