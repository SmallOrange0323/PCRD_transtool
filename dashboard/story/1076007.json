[
  {
    "type": "background",
    "bg_id": "501032"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在海之家養足精神的{0}和可可蘿，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在夕陽西下的海邊聊天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人，",
    "voice": "vo_adv_1076007_000",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就快要入夜了。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "終於到了",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "冒險的時候。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在「星海」，",
    "voice": "vo_adv_1076007_001",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "究竟有什麼樣的景色在等著我們呢……？",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下相信",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那裡會是",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "比文獻中描述得還要美的世界。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "文獻",
    "voice": "vo_adv_1076007_002",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只不過是他人寫下的話語……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "等著我們的，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n肯定是筆墨難以形容的絕美景象。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "觸感……",
    "voice": "vo_adv_1076007_003",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "氣味……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "溫度……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "每個人",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都會有不同的感受，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n有一百個人，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就會有一百種答案。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以，",
    "voice": "vo_adv_1076007_004",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就讓我們親自去",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "找出自己的答案吧。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哎呀，",
    "voice": "vo_adv_1076007_005",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人……？",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那道光是……？",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "background",
    "bg_id": "510240"
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……不好意思，",
    "voice": "vo_adv_1076007_006",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人！",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "很抱歉",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "突然就來打擾您……！",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您還記得",
    "voice": "vo_adv_1076007_007",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "之前您教在下",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "游泳的事情嗎？",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "關於這件事，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "有件事要向您報告……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "其實今天",
    "voice": "vo_adv_1076007_008",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "有游泳課，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下在同學面前",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "展現了泳技……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下成功游完了",
    "voice": "vo_adv_1076007_009",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "25m，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n結果其他同學",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "跑來找在下說話。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "多虧有主人，",
    "voice": "vo_adv_1076007_010",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下除了學會游泳之外，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n雖然只有一點點……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "但也和同學",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "相處得更融洽了。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人的指導收穫了成果，",
    "voice": "vo_adv_1076007_011",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n讓在下",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "好開心好開心……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下無論如何",
    "voice": "vo_adv_1076007_012",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "都想和您道謝，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "因此才會在",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "學校前面等您。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "嗯，",
    "voice": "vo_adv_1076007_013",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這全都多虧了主人。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不好意思……",
    "voice": "vo_adv_1076007_014",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下有一件事",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "想要和您商量……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "哇……！",
    "voice": "vo_adv_1076007_015",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n這就是大海……！",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真是壯闊的景象……！",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "雖然已經在書籍和電視上看過了，",
    "voice": "vo_adv_1076007_016",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n但沒想到居然會這麼寬廣……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "遠遠超乎在下的想像。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "果然有些事物",
    "voice": "vo_adv_1076007_017",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真的得親眼見到，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n才能體會這種感動。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下平常",
    "voice": "vo_adv_1076007_018",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "只會在",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "自家和學校間往來而已，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "別說海洋了，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "連居住的城市都不太瞭解。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "因此，",
    "voice": "vo_adv_1076007_019",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "對在下而言，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n是主人您讓在下見識到了未知的世界。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "而且，",
    "voice": "vo_adv_1076007_020",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在在下拜託您之後，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您在當週的週末馬上就帶在下來海邊了，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真不愧是主人。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下打從心底感謝您♪",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "好的。",
    "voice": "vo_adv_1076007_021",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下想利用主人教授的泳技，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "來親身感受這片大海。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "哇",
    "voice": "vo_adv_1076007_022",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "噗！？",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "海、",
    "voice": "vo_adv_1076007_023",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "海水跑到嘴裡……！",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "怎麼會這麼鹹……！",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "而且，",
    "voice": "vo_adv_1076007_024",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這裡的海浪……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "只有膝蓋左右的高度，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n卻讓人覺得整個身體都要被沖走了……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "讓在下清楚體認到",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "人在大自然面前",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "有多麼無力……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "嗯……",
    "voice": "vo_adv_1076007_025",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "看來憑在下",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "稚嫩的泳技，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n還沒有辦法順利前進……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不好意思，",
    "voice": "vo_adv_1076007_026",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n可以的話，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "能請您拉著在下的手嗎……？",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "握……！",
    "voice": "vo_adv_1076007_027",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "一握住主人的手手，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n之前感受到的不安全都消失了。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這樣肯定就沒問題了……",
    "voice": "vo_adv_1076007_028",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "那麼，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下要出發了！",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "嘿咻……",
    "voice": "vo_adv_1076007_029",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "嘿咻……！",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "有您強而有力的牽引，",
    "voice": "vo_adv_1076007_030",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下游得輕鬆了不少……♪　",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不過，",
    "voice": "vo_adv_1076007_031",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "雖然有主人拉著，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n這裡還是和游泳池很不一樣……！　",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下很想集中注意力不被海浪沖走，",
    "voice": "vo_adv_1076007_032",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不過海水太鹹，很難集中精神……！　",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "糟、",
    "voice": "vo_adv_1076007_033",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "糟糕……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "腳要抽筋了……！　",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "呀啊……！",
    "voice": "vo_adv_1076007_034",
    "unit_id": 107631
  },
  {
    "type": "still",
    "still_id": "107600701"
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……主、",
    "voice": "vo_adv_1076007_035",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人……？",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在、",
    "voice": "vo_adv_1076007_036",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下沒事……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "感謝您",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "救了在下。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "腳抽筋了……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "要是沒有主人伸出援手，",
    "voice": "vo_adv_1076007_037",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下早就已經溺水了……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "可、",
    "voice": "vo_adv_1076007_038",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "可是……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這個姿勢……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……在下已經是",
    "voice": "vo_adv_1076007_039",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "能夠自己洗澡的大人了。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "像這樣被抱著……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這、",
    "voice": "vo_adv_1076007_040",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "雖然有點不好意思，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "就暫時先這樣……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這裡腳碰不到地，",
    "voice": "vo_adv_1076007_041",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n就表示在下已經",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "游了一段距離了。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下剛才",
    "voice": "vo_adv_1076007_042",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "還對海浪感到恐懼，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "但像這樣被主人抱著，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不知為什麼就能放心下來。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "still",
    "still_id": "107600702"
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……冷靜下來",
    "voice": "vo_adv_1076007_043",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "觀察四周之後，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n可以發現我們",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "就站在無垠的大海之中。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "遙望遠方，",
    "voice": "vo_adv_1076007_044",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "看不到海洋和天空的分界線，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "一望無際都是藍色……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "我們就像是在",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "一張塗成藍色的畫紙裡面一樣。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在沙灘上沒辦法看到這幅景象……",
    "voice": "vo_adv_1076007_045",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這個世界，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "原來這麼寬廣。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "即使有相關知識，",
    "voice": "vo_adv_1076007_046",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n實際上去看、",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "去感受、",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "去品味，卻又是另一回事。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人今天",
    "voice": "vo_adv_1076007_047",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "帶在下看到了這麼棒的景色。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您果然是",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "指引在下的人……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "而且，",
    "voice": "vo_adv_1076007_048",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "無論是什麼時候，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您總是溫柔地給予在下包容……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n給予在下走向未知世界的勇氣。",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……剛剛在下一直在逞強，",
    "voice": "vo_adv_1076007_049",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n但面對您的溫柔，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下還是忍不住對您撒嬌了……",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人……",
    "voice": "vo_adv_1076007_050",
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "若您允許的話，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "請再保持一下",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這個姿勢，",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "讓在下看看大海……♪",
    "voice": null,
    "unit_id": 107631
  },
  {
    "type": "background",
