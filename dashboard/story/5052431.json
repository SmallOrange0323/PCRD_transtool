  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "與魔法提督Lovely★莫妮卡",
    "voice": "vo_adv_5052431_000",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n共度的時光即將結束了……",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "現在想想，時間還過真快呢。",
    "voice": "vo_adv_5052431_001",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然在接連不斷的激烈戰鬥當中，",
    "voice": "vo_adv_5052431_002",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "也曾差點灰心喪志。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "但",
    "voice": "vo_adv_5052431_003",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "能一路努力到現在，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n都是多虧了有魔法少女夥伴，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "以及……",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "眾人的溫暖聲援……！",
    "voice": "vo_adv_5052431_004",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "如果你也",
    "voice": "vo_adv_5052431_005",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "因為挫折想放棄，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n或是遇到討厭的事時，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "希望你能回想起來。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "回想起我們魔法少女，",
    "voice": "vo_adv_5052431_006",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "充滿愛與希望的活躍表現……！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "怎麼了？",
    "voice": "vo_adv_5052431_007",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "你說你不想道別？",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "呵，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "我們",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "永遠都在你們的心中。",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "而且",
    "voice": "vo_adv_5052431_008",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "戰鬥也還沒結束。",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n在這個世界上，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "還充滿著需要我們幫忙的人！",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "倘若這個城鎮、",
    "voice": "vo_adv_5052431_009",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "這個國家",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "面臨危機，",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "\\n我們無論多少次都會前來相助的！",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "在那之前，",
    "voice": "vo_adv_5052431_010",
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "Lovely★莫妮卡",
    "words": "要暫時道別了！",
    "voice": null,
    "unit_id": 114211
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我很期待",
    "voice": "vo_adv_5052431_011",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "下次見面喔！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "請絕對",
    "voice": "vo_adv_5052431_012",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "不要忘了我們……！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "掰掰，",
    "voice": "vo_adv_5052431_013",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "要保重喔！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "……欸，",
    "voice": "vo_adv_5052431_014",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "大家",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "在做什麼啊？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n我們的戰鬥",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "不是還要持續下去嗎……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "──模擬最終回演出。",
    "voice": "vo_adv_5052431_015",
    "unit_id": 114211
  }
]
