    "words": "[FFFFFFFF]是、",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]是的，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]沒錯、",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]沒有錯……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]那、",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]那是人家重要的……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]重要的老鼠耳朵……！",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]什麼嘛，",
    "voice": "vo_adv_5118069_025",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]原來是這樣啊。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]\\n那也好，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]省了我們去找人的時間。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]來，拿去。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]謝、",
    "voice": "vo_adv_5118069_026",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]謝……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]謝謝妳……！",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]神明保佑……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]神明保佑……！",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]呼～",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]真是太好了……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]看來這確實是很重要的物品呢。",
    "voice": "vo_adv_5118069_027",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]\\n能協助您再次與其相會，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]在下也感到相當欣慰。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]既然是那麼重要的東西，",
    "voice": "vo_adv_5118069_028",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]就不要讓它離開妳身邊啊。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]\\n妳可要振作點哪，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]真是的……！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]好、",
    "voice": "vo_adv_5118069_029",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]好的……！",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]總覺得這兩人的態度冷暖差很多哪……",
    "voice": "vo_adv_5118069_030",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n簡直就像三溫暖一樣……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]主公大人！",
    "voice": "vo_adv_5118069_031",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]原來你也跑來這裡了呀。",
    "voice": "vo_adv_5118069_032",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]來得正好，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]稍微幫我們拿點東西吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]咦……",
    "voice": "vo_adv_5118069_033",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n她們是{0}先生認識的人嗎……？",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]原來如此，",
    "voice": "vo_adv_5118069_034",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]是這麼一回事嗎。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]在下",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]這下明白前幾天主公大人為何要出門一趟了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]沒想到只是沒有老鼠耳朵，性格就會大變，",
    "voice": "vo_adv_5118069_035",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]\\n妳這個人個性也是挺麻煩的呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]\\n……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]不過，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]今天沒有",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]鬧出什麼大事，真是太好了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]呃、",
    "voice": "vo_adv_5118069_036",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]嗯……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]噢，",
    "voice": "vo_adv_5118069_037",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]對了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]\\n碧卡拉小姐，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]作為友好的證明……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]\\n在下想送您一個東西。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]還請您",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "[FFFFFFFF]收下。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]這是剛才我們買東西時",
    "voice": "vo_adv_5118069_038",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]店家多送我們的。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]聽說好像是最近",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]造成話題的飾品。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]既然妳剛來這邊不久，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "[FFFFFFFF]稍微認識一下在流行什麼也不吃虧吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]謝、",
    "voice": "vo_adv_5118069_039",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]謝謝……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n那人家就收下了……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]嚥口水……",
