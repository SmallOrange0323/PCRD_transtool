  {
    "type": "dialogue",
    "name": "旁白",
    "words": "多虧了鈴準確的指示，{0}一行人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n完全沒有和魔物戰鬥，一路順利地前進著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "——咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "又是魔物。",
    "voice": "vo_adv_7013003_000",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那個，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那隻落單的魔物，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n是不是先打下來會比較好啊？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯～？　",
    "voice": "vo_adv_7013003_001",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "如果戰鬥的話，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "騷動的聲音會引來許多魔物喔。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "所以",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那個魔物我們也要躲過才行。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這、",
    "voice": "vo_adv_7013003_002",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "——咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "牠走掉了呢。",
    "voice": "vo_adv_7013003_003",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那麼，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "繼續前進吧！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不，",
    "voice": "vo_adv_7013003_004",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我們稍微休息一下吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦？　",
    "voice": "vo_adv_7013003_005",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我還",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "一點都不累喔？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "是我累了啦。",
    "voice": "vo_adv_7013003_006",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可、",
    "voice": "vo_adv_7013003_007",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可是、",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們從剛剛開始就只有等著魔物離開而已，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n以經過的時間來看進展不是很多耶……？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "果然這時候休息是有點太早了嗎。",
    "voice": "vo_adv_7013003_008",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "剛剛也休息過了呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我是真的走累了～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "能不能找個歪理休息一下呢～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊、",
    "voice": "vo_adv_7013003_009",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不、",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不過，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "本來一開始就約好要遵照鈴的指示的！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我知道了！　",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們休息一下吧！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這、",
    "voice": "vo_adv_7013003_010",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這樣啊？　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那麼，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我們就到那個遮蔽處休息一下吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "…………",
    "voice": "vo_adv_7013003_011",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那個、",
    "voice": "vo_adv_7013003_012",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "難得可以休息，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n妳不用站得那麼直也沒關係吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我、",
    "voice": "vo_adv_7013003_013",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我知道啊。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可是，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "該怎麼說呢，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n明明還有該做的事情卻跑來休息，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n總讓我感覺很不自在。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "什麼都不要想，只要休息就好啦。",
    "voice": "vo_adv_7013003_014",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我們不是約好要聽我的嗎？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "說、",
    "voice": "vo_adv_7013003_015",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "說的也是。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我會好好休息！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "總覺得",
    "voice": "vo_adv_7013003_016",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "她好像還沒有聽懂……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過算了，她願意休息就好了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們已經休息很久了吧？　",
    "voice": "vo_adv_7013003_017",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是不是可以動身了？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "…………",
    "voice": "vo_adv_7013003_018",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "睡著了！？　",
    "voice": "vo_adv_7013003_019",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "竟然能在這種地方睡著？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "——咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "妳、",
    "voice": "vo_adv_7013003_020",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "妳快起來！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "有、",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "有一大群魔物……！！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "——咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "…………從旁邊過去了。",
    "voice": "vo_adv_7013003_021",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊！！",
    "voice": "vo_adv_7013003_022",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n難不成鈴已經預見",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那一大群魔物才指示要休息的！？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯嗯？　",
    "voice": "vo_adv_7013003_023",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "怎、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "鈴，",
    "voice": "vo_adv_7013003_024",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "妳真厲害！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦？　",
    "voice": "vo_adv_7013003_025",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "難不成",
    "voice": "vo_adv_7013003_026",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "妳已經掌握了",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "魔物的習性！？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "如果真的是這樣，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "妳能不能也教教我？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣一來我說不定可以規劃出更有效率的行進方法！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呃、",
    "voice": "vo_adv_7013003_027",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那～～個……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我並沒有特別去記那個喔。",
    "voice": "vo_adv_7013003_028",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n只是憑著魔物的腳步聲",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "和氣息大概感覺動靜，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "然後隨著前進而已，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這次的休息也只是因為我想休息才休息的。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我的這個，",
    "voice": "vo_adv_7013003_029",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "該怎麼說呢、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "該說是、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "長年累積的經驗嗎？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還是一種直覺……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "把對方的行動模式完全背起來這種事，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我沒有在遊戲以外的地方做過啦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "原來是靠玩遊戲累積的經驗啊。",
    "voice": "vo_adv_7013003_030",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我自己的確是沒有這樣的經驗，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n從鈴的角度來看",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我根本就是個外行人……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "美、",
    "voice": "vo_adv_7013003_031",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "美冬？　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "妳有在聽我說話嗎？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我當然有在聽！",
    "voice": "vo_adv_7013003_032",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "總、",
    "voice": "vo_adv_7013003_033",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "總之，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "只要照著我說的去做就沒問題了！　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好嗎！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "說得對！",
    "voice": "vo_adv_7013003_034",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我要學會鈴這種不戰而勝的做法",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "還早一百年呢！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "請讓我更仔細地觀察並",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "向妳學習！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不、",
    "voice": "vo_adv_7013003_035",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不戰而勝的做法？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我並沒有打算那麼做的說……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那麼！　",
    "voice": "vo_adv_7013003_036",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "既然魔物們都離開了，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們就繼續前進吧！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "她就這樣走掉了……",
    "voice": "vo_adv_7013003_037",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嘛，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過只要她願意聽我的",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "怎樣都無所謂啦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你那是什麼眼神？",
    "voice": "vo_adv_7013003_038",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "美冬她沒意見不就好了嗎。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我又沒有",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "做任何壞事？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你們兩個～！　",
    "voice": "vo_adv_7013003_039",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "趕快前進吧～！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我馬上過去～！　",
    "voice": "vo_adv_7013003_040",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "來吧，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你也趕快走吧！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "鈴和{0}就這樣慌忙跑到美冬身邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他們3人的塔中探索是否能夠就這樣平安結束呢？",
    "voice": null,
