  {
    "type": "background",
    "bg_id": "500151"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞！咦，奇怪！？剛才確實聽到聲音了……",
    "voice": "vo_adv_5001004_002",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n小栞在哪裡！？啊，欸……這是我送給她的圖鑑魔物？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，{0}！",
    "voice": "vo_adv_5001004_003",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞呢！？小栞在哪裡！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n她可能有危險了！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，{0}！",
    "voice": "vo_adv_5001004_004",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我聽見了小栞呼喊的聲音，用超能力飛過來了！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n欸，小栞在哪裡！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我，要是我能早點過來的話……！",
    "voice": "vo_adv_5001004_005",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯……說得也是。我應該要趕緊找她而不是一直在這哭著……",
    "voice": "vo_adv_5001004_006",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n小栞……小栞！妳在哪裡―！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "──呀！　",
    "voice": "vo_adv_5001004_007",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "哎！",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是小栞的聲音！",
    "voice": "vo_adv_5001004_008",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是從那裡傳來的！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500171"
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊",
    "voice": "vo_adv_5001004_009",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "！",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "background",
    "bg_id": "500171"
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "──嘰哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好！　",
    "voice": "vo_adv_5001004_010",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "打倒它了──！",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "──咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "什麼！？恢、恢復回來了！？怎麼會！？",
    "voice": "vo_adv_5001004_011",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……栞！小栞！",
    "voice": "vo_adv_5001004_012",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊──",
    "voice": "vo_adv_5001004_013",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞！妳沒事太好了～！",
    "voice": "vo_adv_5001004_014",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "唔……姊姊，現在不是做這種事的時候啊……",
    "voice": "vo_adv_5001004_015",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊！說得對！",
    "voice": "vo_adv_5001004_016",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不過沒事的！姐姐我會用魔法來打敗它的！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "閃亮亮☆ 包在我身上吧！",
    "voice": "vo_adv_5001004_017",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嘿──噫！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "──咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦咦！？為、為什麼打不倒它！",
    "voice": "vo_adv_5001004_018",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "箭矢的傷害也能夠馬上恢復過來……",
    "voice": "vo_adv_5001004_019",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒聽說過有這種魔物啊！會是從哪裡冒出來的。",
    "voice": "vo_adv_5001004_020",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是……是從那本圖鑑裡突然冒出來的……",
    "voice": "vo_adv_5001004_021",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "從那本書！？這是怎麼回事！？",
    "voice": "vo_adv_5001004_022",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我想肯定能從書裡找到什麼頭緒，",
    "voice": "vo_adv_5001004_023",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但我拼命從魔物那裡逃開卻把書給丟在一旁了……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好！既然這樣那我們就把書給拿回來……",
    "voice": "vo_adv_5001004_024",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊啊，但也不能放著小栞在這裡不管啊！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "{0}！　謝謝你！",
    "voice": "vo_adv_5001004_025",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我馬上就會回來的！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對不起",
    "voice": "vo_adv_5001004_026",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "{0}，把你給捲進來了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "在姊姊回來這裡之前，就拜託你了！",
    "voice": "vo_adv_5001004_027",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "500151"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼、呼……記得、是放在這附近……找到了！",
    "voice": "vo_adv_5001004_028",
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500151"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "唔，跑走了……不、不過這圖鑑裡一定有記載什麼方法吧！",
    "voice": "vo_adv_5001004_029",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……這、這是古代語！？我看不懂啊～！",
    "voice": "vo_adv_5001004_030",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n感覺小栞……能讀得懂！如果是小栞的話！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我必須趕快回去了！欸，書和……書籤也在這裡！",
    "voice": "vo_adv_5001004_031",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "等等我哦，小栞、{0}！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500171"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞！　",
    "voice": "vo_adv_5001004_032",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "{0}！　久等了ー！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊。知道了些什麼嗎？",
    "voice": "vo_adv_5001004_033",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "抱歉小栞，我看不懂書上所寫的古代語……",
    "voice": "vo_adv_5001004_034",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不……姊姊能幫我把書拿回來，謝謝妳。",
    "voice": "vo_adv_5001004_035",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這本書在哪裡一定寫有把魔物封印起來的方法……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞目前讀到的內容裡，有提過那樣的事情嗎？",
    "voice": "vo_adv_5001004_036",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就我的印象裡面好像沒這麼寫……等一下。",
    "voice": "vo_adv_5001004_037",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n還有最後一個部分還沒讀到，可能是寫在後面……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "still",
    "still_id": "500100401"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "有了！……這是一本將魔物封印在裡面的圖鑑……",
    "voice": "vo_adv_5001004_038",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……書籤是封印魔物的鑰匙，遠離了這本圖鑑魔法效力就會減弱，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n魔物便會從圖鑑中解放出來……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "鑰匙？是書籤嗎？",
    "voice": "vo_adv_5001004_039",
    "unit_id": 101211
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯……我想可能是我把那個書籤，夾在其他喜歡的書裡了，",
    "voice": "vo_adv_5001004_040",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "魔法效果才會因此減弱了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "原來是這麼重要的東西嗎……",
    "voice": "vo_adv_5001004_041",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "然後呢？有將它再次封印住的方法嗎？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "等我一下……啊，應該……是這個吧。",
    "voice": "vo_adv_5001004_042",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "要將魔物再次封印，就必須讓書籤",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n觸碰到魔物才行……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "原來如此，這個書籤就是封印魔法的術式嗎！",
    "voice": "vo_adv_5001004_043",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼只要讓這個書籤碰到魔物的話！",
    "voice": "vo_adv_5001004_044",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就能再次，將它封印起來了……！",
    "voice": "vo_adv_5001004_045",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "太好了──！厲害，小栞妳太厲害了！",
    "voice": "vo_adv_5001004_046",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "哇ー！　",
    "voice": "vo_adv_5001004_047",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小、",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞！　",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "{0}他！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "{0}，",
    "voice": "vo_adv_5001004_048",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "請快趴下！",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我要把書籤綁在箭矢上射出去了！",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "喝啊啊啊！",
    "voice": "vo_adv_5001004_049",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "──嘰哦哦哦哦哦！",
