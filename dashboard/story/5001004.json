    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "封印……成功……還有一隻！",
    "voice": "vo_adv_5001004_050",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "回收箭矢就交給我來吧！來，小栞！魔力傳遞！",
    "voice": "vo_adv_5001004_051",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊，謝謝妳了。",
    "voice": "vo_adv_5001004_052",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……嘶――、喝――……喝呀",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "！",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "──嘰哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呼……擺脫危機了，應該是吧……從書裡逃出來的魔物有三隻。",
    "voice": "vo_adv_5001004_053",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n得再找到最後一隻才行。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？小栞妳有看到那一隻魔物鳥嗎？",
    "voice": "vo_adv_5001004_054",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "魔物鳥？沒有，和出現在我面前的不太一樣……怎麼回事？",
    "voice": "vo_adv_5001004_055",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "剛才去取書的時候，那隻魔物鳥就跑了出來，",
    "voice": "vo_adv_5001004_056",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "它大概逃到哪裡去了吧……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊、姊姊！？",
    "voice": "vo_adv_5001004_057",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼……對不起哦小栞、{0}……",
    "voice": "vo_adv_5001004_058",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n超能力用過了頭……睡意湧上來了……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "{0}……",
    "voice": "vo_adv_5001004_059",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞就……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "拜託你了……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊……",
    "voice": "vo_adv_5001004_060",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好好休息吧。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "{0}，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就由我們來追擊逃跑的魔物吧。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你看……圖鑑上還有兩隻是空白的……",
    "voice": "vo_adv_5001004_061",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這邊是我看到的魔物，姊姊看到的是……應該是席茲吧。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這是非常難應付的魔物……我們追丟的魔物也是",
    "voice": "vo_adv_5001004_062",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n相當凶猛的肉食獸……我們趕緊去將它封印起來吧。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}把睡著的初音背了起來，\\n和小栞一同前去封印魔物。",
    "voice": null,
    "unit_id": null
  }
]
