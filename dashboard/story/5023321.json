[
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這、",
    "voice": "vo_adv_5023321_000",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這隻曼德拉草，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "有一股非常危險的氣息……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "各位，",
    "voice": "vo_adv_5023321_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就如同所說的，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n那株曼德拉草的毒性非常強。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n請務必小心不要碰觸到它的觸手。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "說什麼務必小心，",
    "voice": "vo_adv_5023321_002",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n就算聽到這種粗略的建議……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "哇，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "它往這邊來了！？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "喂、",
    "voice": "vo_adv_5023321_003",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "等？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊～",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "事情越來越麻煩了～",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "應該說現在不是說這個的時候了的感覺一直冒出來，也太搞笑了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "它、",
    "voice": "vo_adv_5023321_004",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "它攻過來了！　",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "小心喔！！",
    "voice": null,
    "unit_id": 110711
  }
]
