[
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "嘿！",
    "voice": "vo_adv_9003516_000",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n我之前也說過……",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "你可別扯本大爺的後腿啊，阿澤爾德！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "當然，",
    "voice": "vo_adv_9003516_001",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "這我當然記得。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "我很期待你自前些時日至今的成長喔，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "卡里莎。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我們也要",
    "voice": "vo_adv_9003516_002",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "展現稍微成長後的成果，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n給祈梨和嘉夜看看喔～！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喔，",
    "voice": "vo_adv_9003516_003",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好氣魄！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "看來這場架會很有意思──",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "要上了，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "最後一回合！",
    "voice": null,
    "unit_id": 106511
  }
]
