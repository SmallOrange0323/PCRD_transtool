  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "首先",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "其中一方先喵喵一下，",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "然後另一方就喵喵……",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "昴",
