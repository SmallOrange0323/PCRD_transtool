    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "這間宅邸裡。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "上次是保管酒的倉庫，",
