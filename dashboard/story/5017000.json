[
  {
    "type": "background",
    "bg_id": "500362"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這裡是親龍王國露格尼卡梅札斯邊境伯的宅邸。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這座宅邸的見習執事菜月昴，今天也和平時一樣，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n跟兩位前輩女僕拉姆和雷姆",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一起辛勤地工作著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "啊～",
    "voice": "vo_adv_5017000_000",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "拖著剛康復的身體整理倉庫好累～",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n整個身體隱隱作痛，腰和腿嘎搭嘎搭作響，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "手臂抖個不停又呼吸急促。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "你沒事吧？",
    "voice": "vo_adv_5017000_001",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "昴。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "今天是難得的假日，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n你可以把這些交給我們，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "好好休息就好了……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不，",
    "voice": "vo_adv_5017000_002",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我很感謝雷姆妳的心意，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "真的。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "一直被當作傷患照顧根本不符合我的個性，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n說真的身體明明能動",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "卻得一直躺著，對我來說才是痛苦。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "可是……",
    "voice": "vo_adv_5017000_003",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "沒關係啦，雷姆。",
    "voice": "vo_adv_5017000_004",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n讓巴魯斯做他想做的吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "怎麼連姊姊都這麼說。",
    "voice": "vo_adv_5017000_005",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "他想工作的話就讓他工作就好。",
    "voice": "vo_adv_5017000_006",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n反正，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "他只是想被人稱讚說，這麼不舒服還那麼努力。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真是低級的心機。",
    "voice": "vo_adv_5017000_007",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "妳真是一針見血呢，",
    "voice": "vo_adv_5017000_008",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "姊姊！",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "這個嘛，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "雖然我不能說自己完全沒有這種想法！",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "但、",
    "voice": "vo_adv_5017000_009",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "但可不是因為",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n想表現給你們或愛蜜莉雅碳看",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "而已喔！",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "――剛才",
    "voice": "vo_adv_5017000_010",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "有誰提到我嗎？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "唔喔喔喔喔喔喔――！！",
    "voice": "vo_adv_5017000_011",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "哇，",
    "voice": "vo_adv_5017000_012",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嚇我一跳……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "昴你竟然能",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "跳這麼高。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "愛、",
    "voice": "vo_adv_5017000_013",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "愛、",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "愛、",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "愛蜜莉雅碳……！？",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "妳怎麼會突然跑來這裡！？",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "這裡屋塵滿天飛耶！？",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "屋塵……",
    "voice": "vo_adv_5017000_014",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "是什麼？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我不是很懂，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n不過我感覺好像聽到有人提到我的名字，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "有點在意。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "沒有沒有沒有，",
    "voice": "vo_adv_5017000_015",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "關於愛蜜莉雅碳的話題嗎？",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "完全沒有喔。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "真的完全",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不是真的，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我沒有騙妳也沒有瞞著妳喔。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "――哎呀哎呀，",
    "voice": "vo_adv_5017000_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這蒙混的手法也太粗糙又隨便了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "唔，",
    "voice": "vo_adv_5017000_017",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "那個聲音是……",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "帕克！",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "說謊可不行唷，",
    "voice": "vo_adv_5017000_018",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "昴。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n你這麼拼命地隱瞞，感覺事有蹊蹺。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n照我的直覺，",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "這應該是件不能讓莉雅聽見的糟糕事吧。",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "昴，",
    "voice": "vo_adv_5017000_019",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "是真的嗎？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真的像帕克說的一樣，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "是不能讓我",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "聽到的內容嗎……？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我真的拿愛蜜莉雅碳這種寂寞的眼神沒轍！",
    "voice": "vo_adv_5017000_020",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不是啦，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "完全不是那樣，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不是在講那種事情……",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "只是，",
    "voice": "vo_adv_5017000_021",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "對於看到我病剛痊癒還認真工作的樣子，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "愛蜜莉雅碳是否會溫柔地",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "可愛地誇獎我，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "而有點期待……",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "話說回來，",
    "voice": "vo_adv_5017000_022",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "愛蜜莉雅大人",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是不是有事情要囑咐我們？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "啊，",
    "voice": "vo_adv_5017000_023",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我有事想請昴幫忙……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我被無視了嗎！？",
    "voice": "vo_adv_5017000_024",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我可是會鬧彆扭喔！？",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "可能會離家出走喔！？",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "沒事的。",
    "voice": "vo_adv_5017000_025",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "昴的努力雷姆都看在眼裡！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "我會用這雙眼睛，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "從早到晚一點不漏地仔細看清楚！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "這說法還真有點恐怖，",
    "voice": "vo_adv_5017000_026",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不過謝啦。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n果然，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "只有雷姆站在我這邊……",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "怎麼會……",
    "voice": "vo_adv_5017000_027",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "竟然說我可愛到想娶回家，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "人家會害羞啦……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我才沒說成那樣好嗎！？",
    "voice": "vo_adv_5017000_028",
    "unit_id": 2711
  },
  {
