    "name": "帕克",
    "words": "不過，",
    "voice": "vo_adv_5017000_055",
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "貝蒂有這麼容易找得到嗎？",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "她總是",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "一個人偷偷躲在禁書庫裡面……",
    "voice": null,
    "unit_id": 2611
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "什麼啊，",
    "voice": "vo_adv_5017000_056",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不用擔心。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n那不就是把宅邸裡面的門",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "和自己房間連結在一起的魔法嗎？",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不知道為什麼，",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我好像是屬於可以輕易猜中那扇門的體質。",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "說不定",
    "voice": "vo_adv_5017000_057",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "打開這個倉庫的門就可以立刻找到碧翠子……",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "――！？",
    "voice": "vo_adv_5017000_058",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "昴，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "等一下！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "門在發光……！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "唔、唔喔喔喔喔喔喔――！？",
    "voice": "vo_adv_5017000_059",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這",
    "voice": "vo_adv_5017000_060",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不是碧翠絲大人的禁書庫！",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "而是跟",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "某個其他的地方相連……！",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不好！",
    "voice": "vo_adv_5017000_061",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "昴！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "快放開那本書！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n再這樣下去的話會……！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "快、",
    "voice": "vo_adv_5017000_062",
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "快被門吸進去了！？",
    "voice": null,
    "unit_id": 2711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "呀啊啊啊啊啊――！！",
    "voice": "vo_adv_5017000_063",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "白色的光照亮了整個房間，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n當光消失的時候――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "房間裡已是空無一人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在這個被寂靜支配的房間裡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "有一本書",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "掉落在地上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "只聽見",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "書本翻頁的聲音，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在原本毫無內容、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "空白的頁面上浮現了文字。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n上面只有一句話，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這麼寫道。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "「――身處不同世界之人，將於異邦相逢」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯、",
    "voice": "vo_adv_5017000_064",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯～？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "奇怪，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好像感覺到有什麼奇怪的干涉……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "錯覺嗎，",
    "voice": "vo_adv_5017000_065",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "應該不是吧……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好像在我不知道的地方",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "發生了什麼事……？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真糟糕……",
    "voice": "vo_adv_5017000_066",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "希望那傢伙",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "沒遇到什麼事就好了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "到底是",
    "voice": "vo_adv_5017000_067",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "什麼人做的好事，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真是的……",
    "voice": null,
    "unit_id": 190011
  }
]
