[
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在四周無人的空曠平原上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n傳來了響亮的叫喊聲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "哼、",
    "voice": "vo_adv_5111603_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "喝！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n吃我這招啊啊啊！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "太慢了！",
    "voice": "vo_adv_5111603_001",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n這種程度的攻擊，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "連隻小飛蟲都殺不死！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "怎麼了怎麼了，",
    "voice": "vo_adv_5111603_002",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "諾維姆妳在幹嘛？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n……是在罷工抗議嗎？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "最好、",
    "voice": "vo_adv_5111603_003",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "是啦！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n唔喔喔喔呀啊啊啊啊！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "哼，",
    "voice": "vo_adv_5111603_004",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "喊得挺大聲的嘛！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "但如果只會憑藉氣勢──",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "下場就是這樣！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "唔呃呃呃",
    "voice": "vo_adv_5111603_005",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "呃───！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "唉～唉～",
    "voice": "vo_adv_5111603_006",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "被打飛得還真遠。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "話說剛剛",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "絕對防禦是有發動的吧？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n那怎麼可能打中嘛。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "咳咳……",
    "voice": "vo_adv_5111603_007",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "可是啊──",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你聽到不會手癢嗎？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "叫絕對防禦這種名稱，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "就是會讓人想破解看看吧？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "呵。",
    "voice": "vo_adv_5111603_008",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "諾維姆，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "妳真傻。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n就是因為無法破解才叫絕對啊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "不過妳那種反骨精神，",
    "voice": "vo_adv_5111603_009",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "我也不是不能理解。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "接下來呢？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "要繼續試嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "嗯，",
    "voice": "vo_adv_5111603_010",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "那當然！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "對了，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "尾狗刀你也──",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "躡手躡腳、",
    "voice": "vo_adv_5111603_011",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "躡手躡腳……",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "喂，站住，",
    "voice": "vo_adv_5111603_012",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "別想跑！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "快，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "尾狗刀你也來幫忙！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n我們兩個人合力，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "搞不好就能破解「絕對」！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "妳在說什麼啊，",
    "voice": "vo_adv_5111603_013",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我聽不懂妳的意思──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我是說只要我們合力，沒有什麼是辦不到的！",
    "voice": "vo_adv_5111603_014",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "……唉。",
    "voice": "vo_adv_5111603_015",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "好吧，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n雖然很麻煩，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "但我就幫妳吧。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "呵，",
    "voice": "vo_adv_5111603_016",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "不管要來多少人都無妨！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "那麼，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "我來發動能力……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "諾維姆，",
    "voice": "vo_adv_5111603_017",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "就是現在。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "咦？",
    "voice": "vo_adv_5111603_018",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "啊？",
    "voice": "vo_adv_5111603_019",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "喂，等一下，尾狗刀！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n不是說要破解絕對防禦嗎！？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n我都還沒發動能力──",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我又沒有想破解的意思──",
    "voice": "vo_adv_5111603_020",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "你這個人～！",
    "voice": "vo_adv_5111603_021",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n諾維姆，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "這樣妳也無所謂嗎！？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "真不愧是尾狗刀！",
    "voice": "vo_adv_5111603_022",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "……原來如此，",
    "voice": "vo_adv_5111603_023",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "看來妳比我想的還蠢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "算了，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "那我也不能輸給你們！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "諾維姆、",
    "voice": "vo_adv_5111603_024",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "尾狗刀，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "我可不會手下留情喔！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "看著對自己發起挑戰的諾維姆和尾狗刀，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n誓約女君一臉愉悅地舉起了武器。",
    "voice": null,
    "unit_id": null
  }
]
