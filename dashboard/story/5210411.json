  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "拜訪吉歐‧格黑納的日子",
    "voice": "vo_adv_5210411_000",
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "感覺既漫長又短暫，",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "今天就要告一段落了呢。",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "小霞，",
    "voice": "vo_adv_5210411_001",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "要回蘭德索爾了嗎？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n好寂寞喔……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是啊。",
    "voice": "vo_adv_5210411_002",
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過，",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我一定會再來的。",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我已經徹底喜歡上這個世界了，",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而且還有見習助手拿娜小姐在嘛。",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "嗯！",
    "voice": "vo_adv_5210411_003",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "……對了！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n下次拿娜我們，",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "也去蘭德索爾玩吧！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "小阿！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "我、",
    "voice": "vo_adv_5210411_004",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "我嗎？",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "會不會，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "造成困擾呢……？",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "別說什麼造成困擾了。",
    "voice": "vo_adv_5210411_005",
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我非常歡迎喔。",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我也有很多想介紹給妳認識的夥伴呢。",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "那麼，",
    "voice": "vo_adv_5210411_006",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "總有一天我一定",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "會去拜訪的……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "……嗚……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "background",
    "bg_id": "502250"
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "哇哇，",
    "voice": "vo_adv_5210411_007",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "小阿怎麼了！？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "肚子痛嗎？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "是為什麼呢……",
    "voice": "vo_adv_5210411_008",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "眼淚湧了上來……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n感覺就像一直以來，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "希冀的事情……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "實現了一樣……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "太誇張了啦小阿！",
    "voice": "vo_adv_5210411_009",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "去別的世界什麼的",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "很簡單的！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "只要在那邊也交朋友就好了嘛！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "原來是那樣啊……",
    "voice": "vo_adv_5210411_010",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "原來只要那樣，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "就好了啊……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "background",
    "bg_id": "502710"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "煩惱這種事，",
    "voice": "vo_adv_5210411_011",
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "說不定也就如此單純呢。",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "只要有獨一無二的「某個人」陪在身邊，",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "一切都會好起來。",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "對我來說，",
    "voice": "vo_adv_5210411_012",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "那就是，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "小拿和",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "騎士先生……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "咦？",
    "voice": "vo_adv_5210411_013",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "先不提小騎士，",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "拿娜也是？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "拿娜有做什麼嗎……？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呵呵，",
    "voice": "vo_adv_5210411_014",
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那麼，",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "回到蘭德索爾之後，",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我得準備很多甜甜圈才行呢。",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "為了讓妳們隨時來都沒問題。",
    "voice": null,
    "unit_id": 137412
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "真的嗎！？",
    "voice": "vo_adv_5210411_015",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "萬歲──！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n太好了呢小阿！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "好期待喔～！！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "……",
    "voice": "vo_adv_5210411_016",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "是啊！",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "『願いが叶う海岸』で過ごすのも、",
    "voice": "vo_adv_5206411_000",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "今日で最後ね……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "というか、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "最終的には",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "誰の願いも",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "叶わなかったような……？",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "……ん。",
    "voice": "vo_adv_5206411_001",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\nお兄も。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "カナヅチの。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "まま。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "結局、",
    "voice": "vo_adv_5206411_002",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "元に戻っちゃったものね。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\n……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "でも、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "ここに来る前より、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "スッキリできた気がするわ。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "ん。",
    "voice": "vo_adv_5206411_003",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\nわたしも。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\n",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "エリスは？",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "そうね……",
    "voice": "vo_adv_5206411_004",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "わたしも、",
    "voice": "vo_adv_5206411_005",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "以前の未練は手放す決心ができた。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "そして、",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "これからは違った生き方を……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "騎士クンと……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "……そうね。",
    "voice": "vo_adv_5206411_006",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\nいい夏休みだったと思う。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "ハッピーちゃん",
    "words": "ぶっぶっ～！",
    "voice": "vo_adv_5206411_007",
    "unit_id": 9512
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "ふふ、",
    "voice": "vo_adv_5206411_008",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "お互いを知ることもできたものね。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\n……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "そういえば、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "エリスさんは",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "この後どうするの？",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "一度、",
    "voice": "vo_adv_5206411_009",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "城に戻るわ。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\nわたしには、",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "まだ修復の眠りが必要だから。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "おしろ。",
    "voice": "vo_adv_5206411_010",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\nきになる。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "…………",
    "voice": "vo_adv_5206411_011",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "興味があるなら、",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "いつか招待してもいい。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
