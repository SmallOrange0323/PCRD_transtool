  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這種狀態也太……！　",
