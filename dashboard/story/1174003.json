    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n要是讓騎士先生",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "留下了不好的回憶該怎麼辦……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……",
    "voice": "vo_adv_1174003_056",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦，",
    "voice": "vo_adv_1174003_057",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "可是……",
