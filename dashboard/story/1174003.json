[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "慈樂之音的巡演順利落幕後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}被紡希叫了出來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生，",
    "voice": "vo_adv_1174003_000",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我有話要和你說！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那個……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "…………你明天和後天，",
    "voice": "vo_adv_1174003_001",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "有空嗎？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "如果有事的話",
    "voice": "vo_adv_1174003_002",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就算了。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我只是順便問問你而已！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……什麼？",
    "voice": "vo_adv_1174003_003",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你有空？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真的嗎！？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "其實，",
    "voice": "vo_adv_1174003_004",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這附近",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "有個著名的孤島度假勝地，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我拿到了",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那裡的住宿優惠券。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "正好",
    "voice": "vo_adv_1174003_005",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "多出了一張，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生不介意的話，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "要不要",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "一起去呢？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就是可以我才會邀請你嘛。",
    "voice": "vo_adv_1174003_006",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n你這個人真奇怪。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你什麼意思嘛！？",
    "voice": "vo_adv_1174003_007",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我邀請騎士先生",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "有這麼奇怪嗎！？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我話先說在前頭，",
    "voice": "vo_adv_1174003_008",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這是為了還騎士先生的人情。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……因為今年夏天，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我受了你諸多關照。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你有意要來的話，",
    "voice": "vo_adv_1174003_009",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "明天就到碼頭會合吧。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n那我先走了！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生",
    "voice": "vo_adv_1174003_010",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "他會來嗎？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……不，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "他是那種被邀請",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就不會拒絕的人，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "一定沒問題的。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "光是要拿到優惠券就費了不少力氣，",
    "voice": "vo_adv_1174003_011",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我還為了騎士先生特地預約了驚喜晚餐……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不如說，他要是沒來的話我會生氣的！　",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……是說，",
    "voice": "vo_adv_1174003_012",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "一開始就",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "講清楚不就行了。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "在騎士先生面前真的很不坦率耶。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "background",
    "bg_id": "500280"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "兩位，",
    "voice": "vo_adv_1174003_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "我們到囉。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "歡迎來到",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "祕境之島！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嗯～！",
    "voice": "vo_adv_1174003_014",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "終於到了～！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你覺得這座島的風景",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怎麼樣啊？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "哼哼。",
    "voice": "vo_adv_1174003_015",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "要好好感謝我喔。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n這可是憑你自己一個人絕對來不了的地方呢。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "那麼，",
    "voice": "vo_adv_1174003_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "我幫你們把行李搬進小屋，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "兩位玩得開心啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "謝謝你！",
    "voice": "vo_adv_1174003_017",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "……對了對了，",
    "voice": "vo_adv_1174003_018",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "我這裡有個值得一聽的情報。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n聽說這座島的沙灘上，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "散落著一種名為「星之碎片」的美麗沙子。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "據說集滿100個碎片",
    "voice": "vo_adv_1174003_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "就能實現願望喔。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "……像妳這種年紀的姑娘，",
    "voice": "vo_adv_1174003_020",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n或多或少都有一兩個",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "想實現的願望吧？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "比如",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "和那個男孩子在一起──",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "等等！？",
    "voice": "vo_adv_1174003_021",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "請別開我玩笑啦！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n小心我把你綁起來唷！？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "哈哈哈！",
    "voice": "vo_adv_1174003_022",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "妳紅著那張臉發怒",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "可一點也沒有說服力啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "那麼，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "電燈泡就先行告退了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "兩位慢慢來！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那、",
    "voice": "vo_adv_1174003_023",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那個人一定誤會了……！　",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "什、",
    "voice": "vo_adv_1174003_024",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "什麼啊！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……咦，",
    "voice": "vo_adv_1174003_025",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "白色的沙子？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n仔細一看，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "有點像星星的形狀呢……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n難道",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這就是「星之碎片」？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "據說集滿100個碎片",
    "voice": "vo_adv_1174003_026",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "船長",
    "words": "就能實現願望喔。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我的願望……",
    "voice": "vo_adv_1174003_027",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "說到底",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "願望本來就該由自己實現。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "如果是當作一種寄託，收集一下倒也無妨。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生。",
    "voice": "vo_adv_1174003_028",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "天黑以前我們各自行動吧。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我會暫時待在這片沙灘上！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……什麼？",
    "voice": "vo_adv_1174003_029",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "如果要收集碎片的話就一起找？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
