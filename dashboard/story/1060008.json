  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還好嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "聽陛下所言，",
    "voice": "vo_adv_1060008_117",
    "unit_id": 106012
  },
  {
