    "name": "黑暗伊緒",
    "words": "而且，",
    "voice": "vo_adv_1190003_089",
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "明明到剛才都還覺得那麼害羞的……",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "但在變身戰鬥後，",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "心情似乎豁然開朗了！",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "……感覺非常舒服呢♪",
    "voice": "vo_adv_1190003_090",
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "啊～嗯！",
    "voice": "vo_adv_1190003_091",
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "黑暗力量果然還在～～！",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "真是的……",
    "voice": "vo_adv_1190003_092",
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "雖然不知道到底怎樣才能消除黑暗力量，",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n但我會以自己的方式努力試試的。",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "希望總有一天，",
    "voice": "vo_adv_1190003_093",
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "我能抬頭挺胸地自稱是魔法少女……",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "在那天來臨之前，",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "也希望",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "你能一直",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "在身旁守護著我。",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "這個是",
    "voice": "vo_adv_1190003_094",
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "老師只出給你的作業♪",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n不可以偷懶哦？",
