    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "呃！？",
    "voice": "vo_adv_1190003_096",
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "又出現了？",
