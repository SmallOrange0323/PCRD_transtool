    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "對學習這麼有熱誠真是有心。",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "不過，",
    "voice": "vo_adv_1190003_098",
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "有點太調皮了唷。",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "我會給它",
    "voice": null,
    "unit_id": 119011
  },
  {
    "type": "dialogue",
    "name": "黑暗伊緒",
    "words": "滿滿的",
