  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "幸虧拉基拉基先生幫忙，",
    "voice": "vo_adv_9100002_000",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們總算回到這裡了！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是……！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "【憤怒‧軍團】那夥人",
    "voice": "vo_adv_9100002_001",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n好像在城裡到處作亂……！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "帆稀小姐和真軌先生，",
    "voice": "vo_adv_9100002_002",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n似乎分頭",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "去阻止他們了……",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們也",
    "voice": "vo_adv_9100002_003",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "馬上前往救援吧！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "「嗯！」\\n「好！」",
    "voice": "vo_adv_9100002_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……主公大人。",
    "voice": "vo_adv_9100002_005",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n【憤怒‧軍團】個個都是強敵。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不曉得只發動一次攻擊",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "能不能擊敗對方……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過別輕言放棄，",
    "voice": "vo_adv_9100002_006",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不管幾次都一起挑戰吧！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一定要保護",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "城裡的人們！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "……呵呵♪",
    "voice": "vo_adv_9100002_007",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "不會輕易戰敗的喔──★",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦！",
    "voice": "vo_adv_9100002_008",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n美空！？",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "用影像魔法強行介入……",
    "voice": "vo_adv_9100002_009",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "公主殿下，",
    "voice": "vo_adv_9100002_010",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "雖然妳說「不管幾次」──",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n不過在一定時間內",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "能挑戰的次數是有限的。★",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "如此一來……",
    "voice": "vo_adv_9100002_011",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "最好不要平白浪費挑戰次數，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n謹慎挑戰為妙吧。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "儘管放馬過來，我們會把你們打到心服口服！",
    "voice": "vo_adv_9100002_012",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "你們這些沒用的傢伙",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "全都吃癟去吧！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哈！",
    "voice": "vo_adv_9100002_013",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "終於可以把你徹底打垮了啊，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "臭矮子！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "那是我要說的話，垃圾貓！",
    "voice": "vo_adv_9100002_014",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n我要把妳跟其他小嘍囉",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "統統痛扁一頓！",
    "voice": null,
    "unit_id": 191611
  },
  {
