    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "大家",
    "voice": null,
    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "受傷……",
    "voice": null,
    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n我會",
    "voice": null,
    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "很難過",
    "voice": null,
    "unit_id": 118111
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "的……",
