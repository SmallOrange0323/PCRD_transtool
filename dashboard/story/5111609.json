[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "矛依未碰觸奇妙的結晶，各種回憶湧上心頭。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這些就是……",
    "voice": "vo_adv_5111609_000",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "全部了嗎。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "回憶一個個浮現……",
    "voice": "vo_adv_5111609_001",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哈哈……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真是",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "令人懷念……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "雖然也有過難受的時候……",
    "voice": "vo_adv_5111609_002",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但那時候真的很愉快。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n不管回想起幾次，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "都覺得很開心。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過……",
    "voice": "vo_adv_5111609_003",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我不能沉浸在那些回憶裡",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "佇足不前。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不管我的未來會發生什麼事，",
    "voice": "vo_adv_5111609_004",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我都不會逃避。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我要繼續邁進。",
    "voice": "vo_adv_5111609_005",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n創造出",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "能夠超越這些愉快回憶的未來。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好了，",
    "voice": "vo_adv_5111609_006",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "快醒來吧，我！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n再繼續睡懶覺，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "會被尾狗刀笑的……！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "background",
    "bg_id": "501322"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……嗯……",
    "voice": "vo_adv_5111609_007",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯……",
    "voice": "vo_adv_5111609_008",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "怎麼，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是你啊。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你在擔心我嗎？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "謝啦！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過，",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我一點事也沒有。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "──我現在",
    "voice": "vo_adv_5111609_009",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "狀況絕佳！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "胸懷要在未來創造嶄新回憶的想法，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n矛依未不帶一絲迷惘地繼續前進。",
    "voice": null,
    "unit_id": null
  }
]
