  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n吱吱恰♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "吱吱恰♪",
    "voice": "vo_adv_9074155_000",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n吱吱恰♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "香織姐姐，",
    "voice": "vo_adv_9074155_001",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "終於找到妳了～！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "呃……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "妳在做什麼呀？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n那是殭屍對吧？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗨呵～！",
    "voice": "vo_adv_9074155_002",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們正在跳舞啊～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n我迷路了很傷腦筋，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "所以在跳舞，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "一回過神來就聚集這麼多人了呀～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "禊也一起來跳吧～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "跟殭屍跳舞感覺好像很有趣！",
    "voice": "vo_adv_9074155_003",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "話雖如此，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "在那之前～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咪嘻嘻♪",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯？",
    "voice": "vo_adv_9074155_004",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "妳怎麼突然跑到沼澤裡～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n是有東西",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "掉在裡面了嗎～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不是，",
    "voice": "vo_adv_9074155_005",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊在找可以用來惡作劇的新點子！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這個世界到處",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "都藏著古～老的道具，很有趣喔～♪",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這個看起來很像陷阱呢！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嘿～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咻♪",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚啾嚕……",
    "voice": "vo_adv_9074155_006",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "到、",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "到底發生了什麼素？",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n偶發現了一個大小剛好的章魚壺所以在休息呢……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "奇、",
    "voice": "vo_adv_9074155_007",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n長得像章魚的……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "人類？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚啾……",
    "voice": "vo_adv_9074155_008",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "突然被撈起的章魚壺……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "一群跳舞的人……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "難、",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "難道偶",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "會被弄成生魚片，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n當作神祕儀式的活祭品嗎──！？",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "救救",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "救救偶～！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那個……",
    "voice": "vo_adv_9074155_009",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "沒錯沒錯♪",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n我們大家會一起烹調，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "然後大～口地！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好好享用喔～！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……開玩笑的♪",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "果、",
    "voice": "vo_adv_9074155_010",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "果然素這樣嗎！？",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "偶還想再多跟公主姐接撒嬌呢……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n沒想到竟然會被像是邪神的傢伙吃掉……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦，",
    "voice": "vo_adv_9074155_011",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "邪神？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊才不是什麼邪神喔～！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊──",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "邪神？",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗚哇！？",
    "voice": "vo_adv_9074155_012",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n好大的鬼魂，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "什麼時候出現的！？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "哇哇哇！？",
    "voice": "vo_adv_9074155_013",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不可以亂摸舞孃喔！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那就來個飯前運動，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "舞動身體戰鬥吧～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "請不要活吃偶唷～！？",
    "voice": "vo_adv_9074155_014",
    "unit_id": 136911
  }
]
