[
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "閉会式か……",
    "voice": "vo_adv_5064606_000",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ふむ、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "あのときも色々あったな。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "そっすね。",
    "voice": "vo_adv_5064606_001",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\nトンチキ案件てんこ盛りでしたね。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "アレがあそこでコレしたり、",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "ソレがこっちでナンだったり。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "指示代名詞ばかりで",
    "voice": "vo_adv_5064606_002",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "要点の定まらぬ陳述だな。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "通称ふわっとしてる。",
    "voice": "vo_adv_5064606_003",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "いや、一応気ィ遣ってんだけど。",
    "voice": "vo_adv_5064606_004",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "あんま思い出したくないでしょ、",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\nチエルが逃げ出したり",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "ユニ先輩の粘土像が暴れたりとかそんなん。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "そんなことありましたっけ？",
    "voice": "vo_adv_5064606_005",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "はて、",
    "voice": "vo_adv_5064606_006",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "とんと覚えておらぬが。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "最後のライブで、",
    "voice": "vo_adv_5064606_007",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\nクロエ先輩が意外とノリノリだったことは覚えてますけど。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そうだな。",
    "voice": "vo_adv_5064606_008",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nクロエ君が意外と華麗なステップを踏んでいたことは覚えている。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "アレいつ練習したんですかね。",
    "voice": "vo_adv_5064606_009",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "なんとなくアドリブで、",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "ってレベルじゃなかったですよね。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "あ？　",
    "voice": "vo_adv_5064606_010",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "なんだ？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\nうちが夜中に用途不明のフリをコソ練してたら問題あんのか？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "ああッ？　てめ、",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "やんのかコラ。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "やんならやんぞ、",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "表出ろコラ。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "いやあ、",
    "voice": "vo_adv_5064606_011",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "なんだかんだ言っても楽しかったですよね、",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "テレフェス。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "シカトしてんじゃねえぞコラ。",
    "voice": "vo_adv_5064606_012",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\nやんならやんぞ、",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "かかってこいコラ。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "また来年も",
    "voice": "vo_adv_5064606_013",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "みんなでちぇるっとフェスりましょう！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "なかよし部は永遠に不滅です！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そうだな。",
    "voice": "vo_adv_5064606_014",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nユニちゃんズは永遠に不滅──",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "──あれ？",
    "voice": "vo_adv_5064606_015",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nちょっと待って。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "来年ぼく卒業してない？",
    "voice": null,
    "unit_id": 116411
  }
]
