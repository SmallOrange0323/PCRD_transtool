[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和伊緒一起買東西時，\\n突然被一道詭異的光芒包圍。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸？欸？",
    "voice": "vo_adv_1018004_000",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n這是什麼光？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊！！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "still",
    "still_id": "101800401"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "怎麼了？",
    "voice": "vo_adv_1018004_001",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n怎麼發呆了……？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "因為是假日學校都沒有其他人，",
    "voice": "vo_adv_1018004_002",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n所以在緊張嗎？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸？這件衣服？",
    "voice": "vo_adv_1018004_003",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "因為今天只有我們兩個人，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n所以就穿了休閒一點的衣服。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "雖然很開心你誇獎我的打扮，",
    "voice": "vo_adv_1018004_004",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n但不專心的話不行喔？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "難得可以只有兩個人在一起……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "沒關係。",
    "voice": "vo_adv_1018004_005",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n讓我來仔細地指導你吧。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n來，放鬆一點……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那開始上課囉。",
    "voice": "vo_adv_1018004_006",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n首先打開現代國文的教科書。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "雖然總是讓你幫忙，",
    "voice": "vo_adv_1018004_007",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n但課業的話我可以幫你！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我會加油的！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那你哪邊不懂呢？",
    "voice": "vo_adv_1018004_008",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……咦？怎麼了？",
    "voice": "vo_adv_1018004_009",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n為什麼一直看我……？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "胸部？胸部怎麼了嗎？",
    "voice": "vo_adv_1018004_010",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……欸？沒什麼？",
    "voice": "vo_adv_1018004_011",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是、是嗎……？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n沒什麼的話就好……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸、欸欸！？",
    "voice": "vo_adv_1018004_012",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n突然說什麼奇怪的話？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n不可以戲弄老師哦。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……只是，從來沒有被男生",
    "voice": "vo_adv_1018004_013",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n說過可愛，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n所以有點開心……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但是要好好看教科書才行喔。",
    "voice": "vo_adv_1018004_014",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n專心、專心！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你看看這個題目。",
    "voice": "vo_adv_1018004_015",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n回答人物的心情這一題。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n上次考試的時候你寫錯了――",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊，你又在看我了。",
    "voice": "vo_adv_1018004_016",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n集中力已經不夠了嗎？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "真拿你沒辦法～",
    "voice": "vo_adv_1018004_017",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n那我們休息一下吧。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510220"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這裡有茶和點心。",
    "voice": "vo_adv_1018004_018",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n一邊吃一邊聊聊天吧。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，這種時光很快樂吧？",
    "voice": "vo_adv_1018004_019",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我一直很憧憬和朋友一起念書。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "教彼此不懂的地方，休息時間一起吃點心，",
    "voice": "vo_adv_1018004_020",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n然後脫離重點變成聊戀愛的話題……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "對了！要不要聊戀愛的事？",
    "voice": "vo_adv_1018004_021",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n你有喜歡的女孩嗎？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這樣啊……真可惜。",
    "voice": "vo_adv_1018004_022",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不過好像有點放心了。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "眼前？什麼意思？",
    "voice": "vo_adv_1018004_023",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊！那女孩就像浮現在眼前一樣，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n總是想著她的意思吧。真好！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸？我喜歡的類型？",
    "voice": "vo_adv_1018004_024",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，祕密！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n說不定哪天你就會知道了唷？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……欸、欸，這是在聊戀愛話題對吧？",
    "voice": "vo_adv_1018004_025",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n又實現夢想了！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好，差不多該繼續念書了。",
    "voice": "vo_adv_1018004_026",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "還沒辦法專心嗎……？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊，",
    "voice": "vo_adv_1018004_027",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "對了！這樣的話，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n如果你認真念書，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n老師就幫你來場特別指導做為獎勵。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "非常開心、",
    "voice": "vo_adv_1018004_028",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n讓人心跳加速的特別指導唷。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n老師會很溫柔地教你的。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，你變得這麼有幹勁，真開心♪",
    "voice": "vo_adv_1018004_029",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我會努力教你的。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如何呢？這是我給你的禮物！",
    "voice": "vo_adv_1018004_030",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你做了個好『夢』嗎？？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "剛剛的情景，是我依照你和伊緒的『記憶碎片』",
    "voice": "vo_adv_1018004_031",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n創造出來的『夢』唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "很懷念嗎？嗯，還不清楚啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果你收集到更多的『記憶碎片』，",
    "voice": "vo_adv_1018004_032",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我就會再讓你做『夢』的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你和許多女孩在一起的『夢』做得越多……",
    "voice": "vo_adv_1018004_033",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就可以藉此還原世界的真實面貌。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要加油喔♪♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次見囉～♪",
    "voice": "vo_adv_1018004_034",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯、",
    "voice": "vo_adv_1018004_035",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯嗯？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這裡是……？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "咦？我和你在買東西……",
    "voice": "vo_adv_1018004_036",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n但不知不覺好像睡著了。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我夢到在教你功課……",
    "voice": "vo_adv_1018004_037",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸！？",
    "voice": "vo_adv_1018004_038",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n你也做了同樣的夢？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n真不可思議呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……怎麼了？",
    "voice": "vo_adv_1018004_039",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n有什麼在意的地方嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸？特別指導的內容？",
    "voice": "vo_adv_1018004_040",
