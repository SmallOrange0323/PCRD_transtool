    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "被你看到剛洗完澡的樣子，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有點害羞呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呵呵。",
    "voice": "vo_adv_6029110_001",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "難怪會泡過頭呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過要記得補充水分喔！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這個，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是真陽送的牛奶……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要不要一起喝？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你還好嗎！？　",
    "voice": "vo_adv_6029110_002",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你重心有點不穩耶！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n來，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "抓著我。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你的身體，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好溫暖。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……好像連我",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "都覺得有點昏了。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？　",
    "voice": "vo_adv_6029110_003",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可能是因為溫泉泡太久了吧。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真是的，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不要一直盯著我看嘛！　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我會渾身發燙的！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哇！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你的臉",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不要湊過來啦！",
    "voice": null,
    "unit_id": 111611
  }
