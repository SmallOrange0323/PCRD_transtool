[
  {
    "type": "background",
    "bg_id": "509012"
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "學長！",
    "voice": "vo_adv_4010198_000",
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "快一點快一點──！",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n不快點的話，",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "海要跑掉了──！",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "學長，",
    "voice": "vo_adv_4010198_001",
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "天真，",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你太天真了哦。",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "雖然海的確不會跑掉，",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但快樂的時光一轉眼就會不見哦。",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "特別是──",
    "voice": "vo_adv_4010198_002",
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "在生日這天來玩的時候！",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯！",
    "voice": "vo_adv_4010198_003",
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "因為",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "之前我們兩個來的時候，",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n忙著幫助別人，",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "幫著幫著一下子就到黃昏了。",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這一次，",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我會只看著學長你──",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "呃，",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "剛剛的當我沒說！",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "忘了它吧。",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "來吧，",
    "voice": "vo_adv_4010198_004",
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "學長！",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "來玩吧來玩吧──！",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要從什麼開始？",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n因為是難得的生日，",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "來把想做的事全都做一遍吧！",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "很好～",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "首先，",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "先從長距離游泳開始──",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "background",
    "bg_id": "510251"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "──噗哈～！",
    "voice": "vo_adv_4010198_005",
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "玩得真痛快～",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "身體動不了了～",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嘿嘿。",
    "voice": "vo_adv_4010198_006",
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "因為也沒遇到有困難的人，",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "所以一直都是兩人獨處呢！",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是因為夏天快結束了嗎？",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "整片海洋就像是",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "只屬於我跟學長一樣……",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哇哇，",
    "voice": "vo_adv_4010198_007",
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "仔細重新一想，",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真的只有我們兩個……！",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n一有自覺後，好像",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "突、",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "突然不好意思起來了。",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n學長的臉",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "在夕陽照射下，",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "總覺得……",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦？",
    "voice": "vo_adv_4010198_008",
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊……",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這個是",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "生日禮物？",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哇啊，",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好漂亮的手鍊……",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "夕陽的光線透了過去……",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "學長……",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嘿嘿♪",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真是的，",
    "voice": "vo_adv_4010198_009",
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "前輩……！",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n被你這樣對待，",
    "voice": null,
    "unit_id": 122431
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我沒辦法直視前輩的臉了啦～！　",
    "voice": null,
    "unit_id": 122431
  }
]
