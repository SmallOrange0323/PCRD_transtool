  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天吉塔與{0}聽說到，\\n有人想要委託騎空團工作，\\n於是前往鬧區。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你好─！",
    "voice": "vo_adv_1057007_000",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n聽說有工作想要委託我們……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哦哦，",
    "voice": "vo_adv_1057007_001",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你們就是騎空團啊！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n來的正好！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這間店一直受到惡德伊商會的騷擾，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n希望你們能幫忙保護這裡！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "惡德伊商會……",
    "voice": "vo_adv_1057007_002",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就是最近在蘭德索爾跨足各種事業的",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那一間商會呀……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那些人打算從我手裡搶走這間店還有這塊土地！",
    "voice": "vo_adv_1057007_003",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n所以就每天來騷擾……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "害我都做不成生意了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "好過份……",
    "voice": "vo_adv_1057007_004",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "45我瞭解了。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "交給我們吧！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哦唷哦唷，",
    "voice": "vo_adv_1057007_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這是怎麼著？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n今天可一定要請你把這裡讓出來啊？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是誰！？",
    "voice": "vo_adv_1057007_006",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "我是惡德伊。",
    "voice": "vo_adv_1057007_007",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "惡德伊商會的惡德伊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "\\n不好意思請問妳是……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "那位店長的熟人嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我叫吉塔。",
    "voice": "vo_adv_1057007_008",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n是受到這個人委託，要保護這間店的騎空團！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "騎空團……",
    "voice": "vo_adv_1057007_009",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "這邊也出招了呢……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "\\n不過我們的想法似乎非常像呢。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "各位，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "該你們出場了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "店長啊！",
    "voice": "vo_adv_1057007_010",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "\\n你要是不老實點離開的話……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "場面可就會難看了哦？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "那邊那兩個小鬼，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "可沒辦法當我們的對手喔！？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "咿……！",
    "voice": "vo_adv_1057007_011",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "快、快幫幫我！\\n這些傢伙，就是受惡德伊所託來收走我的店的公會。\\n拜託了，幫我趕走他們！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "店長請你退下！",
    "voice": "vo_adv_1057007_012",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n這裡就交給我們！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不會再讓你們恣意妄為了！",
    "voice": "vo_adv_1057007_013",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "由我們來當你們的對手！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "很有種不是嘛！",
    "voice": "vo_adv_1057007_014",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "不過我們也是拿錢辦事！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "可不會手下留情，認命吧！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "\\n你們幾個，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "動手！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "部下們",
    "words": "唔喔喔喔喔喔喔！",
    "voice": "vo_adv_1057007_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "要來了！",
    "voice": "vo_adv_1057007_016",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "準備好！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "部下１",
    "words": "喔啦啊！",
    "voice": "vo_adv_1057007_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就是那裡！",
    "voice": "vo_adv_1057007_018",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "噠啊！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "部下１",
    "words": "唔喔啊！",
    "voice": "vo_adv_1057007_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "對手不過就是兩個小鬼，搞什麼東西啊，蠢貨！",
    "voice": "vo_adv_1057007_020",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "\\n這可不是遊戲！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "給我盡全力上！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "對方公會人很多，要小心！",
    "voice": "vo_adv_1057007_021",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嗯！謝謝！",
    "voice": "vo_adv_1057007_022",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不要讓戰鬥波及到店家，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "慢慢遠離這裡吧！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "部下２",
    "words": "喔啦！",
    "voice": "vo_adv_1057007_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "部下２",
    "words": "差不多該給我去死了吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "唔……！",
    "voice": "vo_adv_1057007_024",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這傢伙！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "部下２",
    "words": "嘎啊！",
    "voice": "vo_adv_1057007_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呼、呼……",
    "voice": "vo_adv_1057007_026",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你沒事吧……？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "太好了……",
    "voice": "vo_adv_1057007_027",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "再稍微陪我努力一下……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "對手只不過是兩個小鬼，到底什麼時候才能解決！",
    "voice": "vo_adv_1057007_028",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "\\n既然這樣就由我來了結……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "\\n喂，就是妳！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "要不要和我一對一決鬥！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "決鬥……？",
    "voice": "vo_adv_1057007_029",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "是啊沒錯。",
    "voice": "vo_adv_1057007_030",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "要是妳贏，我們再也不會對這間店出手。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "不過要是妳輸了，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "就把店交出來，然後解散騎空團！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "惡德伊先生，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "這樣沒問題吧？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "唔姆……",
    "voice": "vo_adv_1057007_031",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "就隨你高興吧。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "不過呢，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "請你可千萬不要輸掉了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這麼亂來的決鬥，",
    "voice": "vo_adv_1057007_032",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "誰要接受呀！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n他們一定會耍什麼小手段的！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……我瞭解了。",
    "voice": "vo_adv_1057007_033",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這場決鬥，我接受。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "為什麼……！",
    "voice": "vo_adv_1057007_034",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "繼續這樣下去，",
    "voice": "vo_adv_1057007_035",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不久就會輸給人數差距……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n說不定會有陷阱，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這一點我當然知道。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不過這對我們來說，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "也是有機會的……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就算勝算再怎麼低，",
    "voice": "vo_adv_1057007_036",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n也一定得成功……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "哈！",
    "voice": "vo_adv_1057007_037",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "看來妳也蠻瞭解什麼是分個輸贏嘛。",
