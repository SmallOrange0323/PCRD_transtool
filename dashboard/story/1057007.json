  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "上前來吧！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……我去去就回。",
    "voice": "vo_adv_1057007_038",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "這個硬幣落地的聲音就是決鬥開始的信號。",
    "voice": "vo_adv_1057007_039",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "\\n可以吧？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我知道了。",
    "voice": "vo_adv_1057007_040",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "那我就扔了……",
    "voice": "vo_adv_1057007_041",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "當然是假的啦！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呀",
    "voice": "vo_adv_1057007_042",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "竟然用硬幣趁機偷襲……！？",
    "voice": "vo_adv_1057007_043",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "得手啦！",
    "voice": "vo_adv_1057007_044",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "啊唔！",
    "voice": "vo_adv_1057007_045",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "喔啦喔啦喔啦！",
    "voice": "vo_adv_1057007_046",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "爽快點投降吧！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "唔嗚，",
    "voice": "vo_adv_1057007_047",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "還、",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "還沒結束……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "什麼騎空團！",
    "voice": "vo_adv_1057007_048",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "明明連飛上天都辦不到！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "\\n少得意忘形了！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "給我乖乖地在地上爬！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "沒有、",
    "voice": "vo_adv_1057007_049",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這一回事……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "總有一天，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們一定會飛上去！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n騁馳在這片天空！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "太天真了！",
    "voice": "vo_adv_1057007_050",
    "unit_id": 1011
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "啊！劍被──！",
    "voice": "vo_adv_1057007_051",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "用這招了結妳！！",
    "voice": "vo_adv_1057007_052",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這就是我的極限……？",
    "voice": "vo_adv_1057007_053",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這樣就結束了嗎……？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "抱歉……",
    "voice": "vo_adv_1057007_054",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n一起在空中翱翔的約定，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "無法實現了……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "唔……！",
    "voice": "vo_adv_1057007_055",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "沒有錯呢……",
    "voice": "vo_adv_1057007_056",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就像你所說的……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n不可以放棄……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n因為我們還有必須做的事情……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "還沒有結束……！",
    "voice": "vo_adv_1057007_057",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n這場勝負──！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "好刺眼……",
    "voice": "vo_adv_1057007_058",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "是障眼法嗎！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "still",
    "still_id": "105700701"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "──這場勝負現在才開始！",
    "voice": "vo_adv_1057007_059",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "這傢伙，",
    "voice": "vo_adv_1057007_060",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "什麼時候換了衣服……！？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你的聲音，",
    "voice": "vo_adv_1057007_061",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我聽到了……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n支撐了快要倒下的我……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "算了，",
    "voice": "vo_adv_1057007_062",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "用這招了結妳！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我已經看穿了！",
    "voice": "vo_adv_1057007_063",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "破！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "什麼！？",
    "voice": "vo_adv_1057007_064",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "剛才那招怎麼可能反擊……！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "這傢伙的拳頭怎麼回事……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "太快了！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "一口氣直接解決你！",
    "voice": "vo_adv_1057007_065",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n奧義……「絕閃」！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "喝啊啊啊啊！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "公會長",
    "words": "唔啊啊啊啊啊啊啊啊！！",
    "voice": "vo_adv_1057007_066",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "部下１＆部下２",
    "words": "老……",
    "voice": "vo_adv_1057007_067",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "部下１＆部下２",
    "words": "老大啊啊啊！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呼啊啊啊……",
    "voice": "vo_adv_1057007_068",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n……分出勝負了。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "還想繼續嗎？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n如果還想繼續打，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就由我來當你們的對手哦？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "要是想就此結束，",
    "voice": "vo_adv_1057007_069",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n就帶著倒在那邊的男人快點滾！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "部下１＆部下２",
    "words": "噫噫噫噫！",
    "voice": "vo_adv_1057007_070",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "部下１＆部下２",
    "words": "老大你振作一點，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "部下１＆部下２",
    "words": "老大！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "……還真有兩下子呢。",
    "voice": "vo_adv_1057007_071",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡德伊",
    "words": "給我記住了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……呼唔。",
    "voice": "vo_adv_1057007_072",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "剛才真危險──",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "──咦……？",
    "voice": "vo_adv_1057007_073",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我剛才做了什麼……？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "對了，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那些人、",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呢……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝……",
    "voice": "vo_adv_1057007_074",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n……我贏了、",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "對吧……？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我只記得我快要倒下，接下來的事情就不清楚了……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "連語氣都變了……？",
    "voice": "vo_adv_1057007_075",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "當時太過拼命而沒有意識到，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n原來我變成那樣啊……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……我慢慢想起來了。",
    "voice": "vo_adv_1057007_076",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "怎麼會那樣呢……？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "如果能更加熟練使用那份力量，",
    "voice": "vo_adv_1057007_077",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n之後一定能辦到更多事對吧？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……不過，",
    "voice": "vo_adv_1057007_078",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "到底是怎麼辦到的呢……？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "說不定，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是因為你的聲音傳了過來。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "真是謝謝你。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那時候我感到非常振奮！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "或許是這樣吧……",
    "voice": "vo_adv_1057007_079",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不對，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "一定是這樣的！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "總有一天我們一起前往空中旅行，",
    "voice": null,
    "unit_id": 105711
  },
  {
