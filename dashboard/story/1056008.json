    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n昨天在電話裡跟我說了。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你若是個沒骨氣的傢伙，砍了也無妨。",
