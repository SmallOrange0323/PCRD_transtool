[
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "流夏久違的回到自由的日常生活中，\\n此時她正打算到城鎮的郊外睡個午覺。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼……",
    "voice": "vo_adv_1056008_000",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不錯不錯，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "睡意順利地湧上來了……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥。",
    "voice": "vo_adv_1056008_001",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那當然。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "擊退妖刀之類的事件終於平息，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總算能夠悠閒度日了呢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，你沒事的話要不要一起來？",
    "voice": "vo_adv_1056008_002",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我身旁的貴賓席還空著喔。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說好玩的。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "只是開玩笑啦。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……你怎麼啦，",
    "voice": "vo_adv_1056008_003",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一臉傻楞楞的樣子。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "什麼事？",
    "voice": "vo_adv_1056008_004",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你儘管問。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "噗哈！",
    "voice": "vo_adv_1056008_005",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你、",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你突然問這什麼問題啊！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那時候……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我講這個並不是那個意思……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "當下一不小心說出了真心話……",
    "voice": "vo_adv_1056008_006",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看他一臉漫不經心的樣子，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一開口話鋒就很敏銳呢這小子……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然這的確是我的真心話，可是……",
    "voice": "vo_adv_1056008_007",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "等一下等一下！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "為什麼我得這麼慌張呢！？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那，",
    "voice": "vo_adv_1056008_008",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那件事就算了吧？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你看，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "陽光這麼耀眼。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我要睡囉！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……真奇怪。",
    "voice": "vo_adv_1056008_009",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "明明刺眼得讓人睡不著……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼會、",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這麼睏……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的……",
    "voice": "vo_adv_1056008_010",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼會這樣呢……",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n在會長面前又不好拒絕……",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咦，",
    "voice": "vo_adv_1056008_011",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你來買東西？",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我嗎？",
    "voice": "vo_adv_1056008_012",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我正在……",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "散步中。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n……那就先這樣囉。",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "啊！",
    "voice": "vo_adv_1056008_013",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "你，",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "你是那個常和流夏大姐頭在一起的人！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "\\n",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "我是",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "流夏大姐的小弟！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "你是因為擔心大姐頭，",
    "voice": "vo_adv_1056008_014",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "才跑來的吧！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "\\n真不愧是大姐頭看上的男人！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "大姐頭常常",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "跟我提到你的事！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "不過，",
    "voice": "vo_adv_1056008_015",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "就算是商店街的會長請託，",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "\\n還真的去參加相親……",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "大姐頭人真是太好了。",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "怎麼了嗎？",
    "voice": "vo_adv_1056008_016",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "你怎麼僵住了……",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "難道你不知道這件事嗎！？",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "\\n",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "大姐頭也真是的，怎麼可以這樣！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "其實",
    "voice": "vo_adv_1056008_017",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "那個相親對象",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "是個很糟糕的傢伙！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "表面上裝得像個誠懇的男人，",
    "voice": "vo_adv_1056008_018",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "\\n",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "但私底下在做的，",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "是連我們小混混都會怕的壞事呢。",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "我是相信大姐頭一定可以應付喔？",
    "voice": "vo_adv_1056008_019",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "\\n",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "但畢竟對方是那種人，我還是很擔心……",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "我本來跟死黨商量好，",
    "voice": "vo_adv_1056008_020",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "要去破壞相親，卻被大姐頭發現……",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "\\n",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "所以才會在這裡束手無策……",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "如果是你這被大姐頭認同的人，",
    "voice": "vo_adv_1056008_021",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "這件事，",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "\\n說不定你能幫得上忙！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "這是相親地點的地圖！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "大姐頭",
    "voice": "vo_adv_1056008_022",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小弟",
    "words": "就拜託你了！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}照著手上的地圖，\\n急忙趕到相親會場──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你剛剛",
    "voice": "vo_adv_1056008_023",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說什麼……？",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "相親對象",
    "words": "在妳身邊晃來晃去的那些小混混。",
    "voice": "vo_adv_1056008_024",
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "相親對象",
    "words": "\\n那些傢伙就放著不要管就好了。",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "相親對象",
    "words": "反正他們也不會成為善良百姓。",
    "voice": "vo_adv_1056008_025",
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "相親對象",
    "words": "\\n人渣就該過得像個人渣一樣才對啊。",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "still",
    "still_id": "105600801"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我不說話，你就一個人在那裡嘮嘮叨叨地高談闊論……",
    "voice": "vo_adv_1056008_026",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n真正的人渣到底是誰啊！",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你這爛到根的性格，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我現在就把它斬斷！",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "相親對象",
    "words": "噫噫噫噫噫！",
    "voice": "vo_adv_1056008_027",
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是人都會犯錯。",
    "voice": "vo_adv_1056008_028",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "每個人都該有個改過自新的機會！",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那幾個傢伙外表看起來那樣，",
    "voice": "vo_adv_1056008_029",
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n但現在努力洗新革面，正經地活著！",
    "voice": null,
    "unit_id": 105632
  },
  {
    "type": "dialogue",
    "name": "相親對象",
    "words": "妳、",
    "voice": "vo_adv_1056008_030",
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "相親對象",
    "words": "妳冷靜一點嘛！",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "相親對象",
    "words": "不過講了幾句小混混蠢小鬼們的壞話而已，",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "相親對象",
    "words": "\\n有必要氣成那樣嗎！",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "相親對象",
    "words": "而且，",
