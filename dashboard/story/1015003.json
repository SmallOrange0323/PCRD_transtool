[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}陪同美里赴王都舉行繪本朗讀會。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "有{0}在真是幫了我大忙了呢。",
    "voice": "vo_adv_1015003_000",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "今天比起平常，帶了更多的繪本，",
    "voice": "vo_adv_1015003_001",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n要搬運實在是很費勁呢。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "謝謝你的幫忙。好棒好棒。",
    "voice": "vo_adv_1015003_002",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我認為所謂的繪本，對孩子們來說，就像是教科書一樣。",
    "voice": "vo_adv_1015003_003",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "能開心地學習到各式各樣的事物對吧？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不只有村子裡的孩子，",
    "voice": "vo_adv_1015003_004",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我希望也能讓王都的孩子們都能知道這些美妙的繪本，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n所以休假時常常會來到這裡喔～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "同行的父母們似乎也樂在其中，",
    "voice": "vo_adv_1015003_005",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "老師覺得非常高興呢──",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "啊！是美里老師──！",
    "voice": "vo_adv_1015003_006",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀？妳好呀～",
    "voice": "vo_adv_1015003_007",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "妳好──！",
    "voice": "vo_adv_1015003_008",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n媽媽──！是美里老師──！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "好的好的聽見了不用那麼大聲喊叫。",
    "voice": "vo_adv_1015003_009",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "美里老師，妳好～",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，妳好～",
    "voice": "vo_adv_1015003_010",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "小女一直以來都承蒙關照了。",
    "voice": "vo_adv_1015003_011",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "真不好意思，是個吵鬧的孩子。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不會不會，才沒這種事呢。",
    "voice": "vo_adv_1015003_012",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "如果沒給妳添麻煩的話就好了……",
    "voice": "vo_adv_1015003_013",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "完全沒這回事。　",
    "voice": "vo_adv_1015003_014",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n倒不如說，她一直都給了我滿滿的活力喔。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "就是說嘛──！",
    "voice": "vo_adv_1015003_015",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n我把活力都分給了大家喔！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒錯呢～",
    "voice": "vo_adv_1015003_016",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "一直以來謝謝妳囉。真乖真乖。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "欸嘿嘿嘿～",
    "voice": "vo_adv_1015003_017",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵呵……",
    "voice": "vo_adv_1015003_018",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "今天是外出購物嗎？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不是的，我們去了一趟醫院。",
    "voice": "vo_adv_1015003_019",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n因為這裡的醫院比村子裡的還要有規模。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，難不成是感冒了……",
    "voice": "vo_adv_1015003_020",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不是的喔～其實是──",
    "voice": "vo_adv_1015003_021",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "媽媽呀，有小寶寶了呦！",
    "voice": "vo_adv_1015003_022",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀哎呀！那還真是，非常恭喜呢。",
    "voice": "vo_adv_1015003_023",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這孩子真是的……",
    "voice": "vo_adv_1015003_024",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "非常謝謝妳。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "預產期是何時呢？",
    "voice": "vo_adv_1015003_025",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "大概再三個月左右，還早呢。",
    "voice": "vo_adv_1015003_026",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我要變成姊姊了──！",
    "voice": "vo_adv_1015003_027",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，那麼，",
    "voice": "vo_adv_1015003_028",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n得成為一個可以當做榜樣的姊姊呢～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "沒問題──！",
    "voice": "vo_adv_1015003_029",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這樣的話，也要敢吃紅蘿蔔喔～",
    "voice": "vo_adv_1015003_030",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嗚哇──！那個才不要──！",
    "voice": "vo_adv_1015003_031",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵呵♪",
    "voice": "vo_adv_1015003_032",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n小寶寶，真讓人期待呢～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嗯！",
    "voice": "vo_adv_1015003_033",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "即將誕生的孩子，之後務必也得讓美里老師看顧呢。",
    "voice": "vo_adv_1015003_034",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這是當然的。",
    "voice": "vo_adv_1015003_035",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我會負起責任好好照顧的唷。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "非常謝謝你。那麼，我們也差不多該……",
    "voice": "vo_adv_1015003_036",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "老師，打擾你們約會真不好意思。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，才不是約會什麼的啦──",
    "voice": "vo_adv_1015003_037",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "媽媽──約會是什麼──？",
    "voice": "vo_adv_1015003_038",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "呵呵呵，對妳來說還太早了喔。",
    "voice": "vo_adv_1015003_039",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n來，我們回家吧～",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎啊哎啊，走掉了。",
    "voice": "vo_adv_1015003_040",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不好意思呢。不小心聊的入神了。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "話雖如此，有了小寶寶，真是可喜可賀呢。",
    "voice": "vo_adv_1015003_041",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "要為他朗讀怎樣的繪本好呢。",
    "voice": "vo_adv_1015003_042",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵呵，村子又要熱鬧起來了～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，說的也是……",
    "voice": "vo_adv_1015003_043",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "小寶寶啊，是為了許多人的愛，",
    "voice": "vo_adv_1015003_044",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n而進到母親的肚子裡的呦。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "被眾人的祝福包圍之下誕生，",
    "voice": "vo_adv_1015003_045",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n接受了滿滿的愛養育而成，接著逐漸成長……",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "無論是人類或動物，大家都是母親生下來的喔～",
    "voice": "vo_adv_1015003_046",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "當然{0}也是……",
    "voice": "vo_adv_1015003_047",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……是呢，真對不起。",
    "voice": "vo_adv_1015003_048",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……因為失去了記憶，是不會知道的吧。",
    "voice": "vo_adv_1015003_049",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n也不明白的吧……",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒什麼喔……只是，",
    "voice": "vo_adv_1015003_050",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n只是突然想緊緊抱住你而已。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不是的喔……",
    "voice": "vo_adv_1015003_051",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n只是，突然想要擁抱你而已……",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒事的唷。",
    "voice": "vo_adv_1015003_052",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n因為有老師在你身邊啊～我會陪在你身邊的喔～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "至少……至少對這孩子來說，",
    "voice": "vo_adv_1015003_053",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n要成為像他的母親般可靠的老師……",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "儘管無法理解美里擁抱的意義，\\n{0}還是接受了這份柔和的溫暖。",
    "voice": null,
    "unit_id": null
  }
]
