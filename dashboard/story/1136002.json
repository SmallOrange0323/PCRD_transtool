[
  {
    "type": "background",
    "bg_id": "500164"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在午餐的尖峰時段結束後，{0}一行人\\n來到沙灘上休息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沒想到會有那麼多的客人上門。",
    "voice": "vo_adv_1136002_000",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n這全都要感謝純呢。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": "vo_adv_1136002_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我什麼都沒做啊……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然妳那麼說，",
    "voice": "vo_adv_1136002_002",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但我認為在沙灘上穿著鎧甲的模樣",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是很罕見的。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是嗎？",
    "voice": "vo_adv_1136002_003",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不只是其他的客人，",
    "voice": "vo_adv_1136002_004",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "連我們家的小朋友也非常感興趣。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "咲戀媽媽，",
    "voice": "vo_adv_1136002_005",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "妳跟那個人認識嗎？",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "好奇怪的打扮～",
    "voice": "vo_adv_1136002_006",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "喂，",
    "voice": "vo_adv_1136002_007",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不要那樣說人家！",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n你們不用害怕，純可是個好人喔？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "等等！",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不要用跑的！",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要在我看得到的地方玩喔──！",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "好──！",
    "voice": "vo_adv_1136002_008",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我知道──！",
    "voice": "vo_adv_1136002_009",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵……",
    "voice": "vo_adv_1136002_010",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "純？",
    "voice": "vo_adv_1136002_011",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有什麼好笑的嗎？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒有啦，",
    "voice": "vo_adv_1136002_012",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然早就聽妳說過了，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但我還是第一次看到",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小咲戀像這樣",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n照顧小孩子的模樣。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……我看起來，",
    "voice": "vo_adv_1136002_013",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有好好照顧到他們嗎？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_1136002_014",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "光是像這樣在一旁觀看，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就能強烈感受到\\n孩子們都",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "很仰慕妳的事實。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n真不愧是小咲戀。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這當然",
    "voice": "vo_adv_1136002_015",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不是我一個人的力量。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是有許多人的幫助，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我才能像這樣照顧他們。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯？",
    "voice": "vo_adv_1136002_016",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "發生什麼事了？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "孩子們好像在那裡爭執……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "我也要沙灘球啦──！",
    "voice": "vo_adv_1136002_017",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "才不要，",
    "voice": "vo_adv_1136002_018",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我要拿這個代替游泳圈來游泳！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "唉喲，",
    "voice": "vo_adv_1136002_019",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你們兩個是怎麼啦？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "嗚～",
    "voice": "vo_adv_1136002_020",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "都怪他獨占玩具啦……",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我也不願意啊，",
    "voice": "vo_adv_1136002_021",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "誰叫它只有一個！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯……",
    "voice": "vo_adv_1136002_022",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這下頭痛了……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n玩具數量很少，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你們要一起玩才行喔？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……",
    "voice": "vo_adv_1136002_023",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小咲戀，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這件事可以交給我處理嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你們兩個",
    "voice": "vo_adv_1136002_024",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "聽好囉？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你們好不容易才能來海邊玩。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n自己一個人玩不是很可惜嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "可是～",
    "voice": "vo_adv_1136002_025",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "她就不會游泳啊～",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "既然她不會，",
    "voice": "vo_adv_1136002_026",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那你教她怎麼游如何？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你們難得來海邊一趟，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n大家一起游泳會",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "比較快樂吧？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "連來海邊都要照顧妹妹嗎──",
    "voice": "vo_adv_1136002_027",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "好吧，是沒差啦。",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n妳",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "要練習嗎？",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "哥哥教超爛的，我才不要！",
    "voice": "vo_adv_1136002_028",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "對了，",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "鎧甲大姐姐陪我一起玩吧！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我嗎？",
    "voice": "vo_adv_1136002_029",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我是很想陪妳玩啦……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "等等。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "摸我會有危險喔！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "咦──？",
    "voice": "vo_adv_1136002_030",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "為什麼──？",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "呀！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "這個鎧甲好燙喔──！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為我一直待在外面啊。",
    "voice": "vo_adv_1136002_031",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "太陽的高熱",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "把鎧甲烤得很燙。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這很危險的，最好不要亂摸。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "抱歉，",
    "voice": "vo_adv_1136002_032",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這我辦不到。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n畢竟是家訓。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "咦～",
    "voice": "vo_adv_1136002_033",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "妳這樣很無趣耶──！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "來──",
    "voice": "vo_adv_1136002_034",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "大家現在看到的就是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "這次比賽的最大獎，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "特大美人魚游泳圈──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n其他還有很多豪華的獎品！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "敬請踴躍參加──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "咦？",
    "voice": "vo_adv_1136002_035",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "那是什麼？",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "好大一個！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "好棒──！",
    "voice": "vo_adv_1136002_036",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "好可愛──！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "是美人魚游泳圈──！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n好好喔──！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "好大──！",
    "voice": "vo_adv_1136002_037",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "如果是那麼大的游泳圈，",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "就能大家一起坐了！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "純",
