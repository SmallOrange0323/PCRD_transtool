  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，",
    "voice": "vo_adv_1099003_000",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "早",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "安……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "早上沒能去叫您起床，",
    "voice": "vo_adv_1099003_001",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真的非常抱歉……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感覺，",
    "voice": "vo_adv_1099003_002",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n早上起來時",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好像有點發燒……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊……",
    "voice": "vo_adv_1099003_003",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝、",
    "voice": "vo_adv_1099003_004",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝您，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在快倒下的時候，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "扶住在下……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼、",
    "voice": "vo_adv_1099003_005",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "哎呀？",
    "voice": "vo_adv_1099003_006",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "早安兩位，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你們怎麼了？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咦？",
    "voice": "vo_adv_1099003_007",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "可可蘿的身體不舒服？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不好了！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "讓我看一下！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼、",
    "voice": "vo_adv_1099003_008",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真的",
    "voice": "vo_adv_1099003_009",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "非～常難受的樣子。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n而且還有發燒，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "她應該很難過……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "體內的瑪那似乎沒有不穩。",
    "voice": "vo_adv_1099003_010",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我想",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "一定是累積的疲勞爆發出來了。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "因為可可蘿",
    "voice": "vo_adv_1099003_011",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n是個非～常努力的人啊。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "喂～",
    "voice": "vo_adv_1099003_012",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我知道你很擔心她，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n但是你可不能那樣慌慌張張的呢。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你冷靜下來，",
    "voice": "vo_adv_1099003_013",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n從育幼院裡",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "找出退燒的藥。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "這裡",
    "voice": "vo_adv_1099003_014",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "也有很多小孩子，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我想一定會備有藥品的。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我趁這段時間",
    "voice": "vo_adv_1099003_015",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n把可可蘿",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "背到房間去。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嘿咻……！",
    "voice": "vo_adv_1099003_016",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不、",
    "voice": "vo_adv_1099003_017",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不可以，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "愛蜜莉雅小姐……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下怎麼能這樣子勞煩您……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不～行，",
    "voice": "vo_adv_1099003_018",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我不接受異議。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "對於努力過頭而倒下去的人，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n我是不會",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "再讓她繼續勉強的。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "快點把身體養好，",
    "voice": "vo_adv_1099003_019",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n等妳恢復精神了，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "再讓妳繼續努力。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗚嗚，",
    "voice": "vo_adv_1099003_020",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯，",
    "voice": "vo_adv_1099003_021",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "做得很好。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那麼，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "好好抓住我喔。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主公大人、",
    "voice": "vo_adv_1099003_022",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "愛蜜莉雅小姐，",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n給您們添麻煩了……",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯，",
    "voice": "vo_adv_1099003_023",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "是啊，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "非～常了不起。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "可可蘿也別擔心了。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "就是說呢，",
    "voice": "vo_adv_1099003_024",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n如果是為了喜歡的人，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "才不會覺得是麻煩呀。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……非常",
    "voice": "vo_adv_1099003_025",
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 105912
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯，",
    "voice": "vo_adv_1099003_026",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不用客氣！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "background",
    "bg_id": "500120"
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "啊，",
    "voice": "vo_adv_1099003_027",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "找到藥了嗎？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "欸，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你怎麼會變得這麼狼狽？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "因為在找藥的時候，",
    "voice": "vo_adv_1099003_028",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n有很多東西從櫃子上掉了下來？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "但是，",
    "voice": "vo_adv_1099003_029",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "有好好把藥保護住了",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你啊，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真的不管做什麼都會變成大冒險呢。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯嗯，",
    "voice": "vo_adv_1099003_030",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "再來",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "得把這個藥餵給可可蘿吃才行。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我想想……",
    "voice": "vo_adv_1099003_031",
    "unit_id": 109911
  },
  {
