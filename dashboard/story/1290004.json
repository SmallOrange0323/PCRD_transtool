    "type": "dialogue",
    "name": "？？？",
    "words": "謝謝。",
    "voice": "vo_adv_1290004_050",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不小心……",
    "voice": "vo_adv_1290004_051",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "說謊了。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "對不起，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "但是，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "只有現在而已……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就原諒我吧。",
