    "words": "是我比較了解。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我的話，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "從學名到分布地區，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就連花語都瞭若指掌。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n例如……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這種花的",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "花語是思念，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "也就是紫菀花……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……沒錯。",
    "voice": "vo_adv_1290004_071",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那個時候……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n被草野優衣所踐踏，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n只屬於我和騎士先生的理想鄉中……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "也綻放著這種花……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……不只是這個。",
    "voice": "vo_adv_1290004_072",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "關於這裡所有植物的事，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我都能教你。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……就由我來為你，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "更新既有的知識。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n厄莉絲把放眼可見的所有植物的知識",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n都告訴了{0}……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510351"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "時間已經非常晚了呢。",
    "voice": "vo_adv_1290004_073",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "其實，",
    "voice": "vo_adv_1290004_074",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我還想要再延續一下這段時光……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n但是現在的我，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "已經沒有辦法",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "繼續維持重現了。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "{0}，今天很謝謝你。",
    "voice": "vo_adv_1290004_075",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我真的……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "非常開心。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "還能再見的。",
    "voice": "vo_adv_1290004_076",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n只要你如此期望。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n……無論何時都能。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…",
    "voice": "vo_adv_1290004_077",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…那麼。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "再見了。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不能說沒有遺憾。",
    "voice": "vo_adv_1290004_078",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n因為騎士先生……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "沒有叫我的名字。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不過。",
    "voice": "vo_adv_1290004_079",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n那就保留到下次見面吧。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n騎士先生的話，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "一定會記得的。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "still",
    "still_id": "129000401"
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "────",
    "voice": "vo_adv_1290004_080",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "剛剛",
    "voice": "vo_adv_1290004_081",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "的……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n難道是……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "紫苑",
    "voice": "vo_adv_1290004_082",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "愛莉……",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "129000402"
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "……嗯。",
    "voice": "vo_adv_1290004_083",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "我是……",
    "voice": "vo_adv_1290004_084",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "紫苑愛莉。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "\\n因為你用這個名字呼喚我了。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "從今天開始，",
    "voice": "vo_adv_1290004_085",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "愛莉",
    "words": "我的名字就是……！",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "background",
    "bg_id": "500510"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "啊……",
    "voice": "vo_adv_1290004_086",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n早安，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "呵呵，",
    "voice": "vo_adv_1290004_087",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "別在意。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………",
    "voice": "vo_adv_1290004_088",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我。",
    "voice": "vo_adv_1290004_089",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n沒有可以在「現實」中生活的肉體。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "想觸碰到你的話，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "除了這個人造的世界之外，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "都無法辦到。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "只有在這個世界，",
    "voice": "vo_adv_1290004_090",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我才有可能",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "和你結為連理。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n不管我多麼地憎恨、",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "多麼地避諱……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n也只有",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "在這座名為《阿斯特朗傳奇》的牢獄中才能做到。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但是……",
    "voice": "vo_adv_1290004_091",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我得到了。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n得到了你只為我，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "所思考而生的東西。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "紫苑愛莉。",
    "voice": "vo_adv_1290004_092",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "唯獨這個名字，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不會被任何人奪走。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就算是",
    "voice": "vo_adv_1290004_093",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "沒有實際軀體、",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "總有一天會消逝的資訊……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n只有這份禮物會永遠留存。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "咦",
    "voice": "vo_adv_1290004_094",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……沒關係。",
    "voice": "vo_adv_1290004_095",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n不用道歉。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "果然……",
    "voice": "vo_adv_1290004_096",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我真的，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "很喜歡你。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "最喜歡你了。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "要我放棄這份感情，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我做不到。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "即便又再一次地，",
    "voice": "vo_adv_1290004_097",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "無法實現。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n即便不被允許。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "即便最後……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "甚至，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "會陷入絕望。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "即使如此……",
    "voice": "vo_adv_1290004_098",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "即使如此，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "再一次就好。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我想再一次試著",
    "voice": "vo_adv_1290004_099",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "愛上你。",
    "voice": null,
    "unit_id": 129011
  }
