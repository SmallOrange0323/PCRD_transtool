    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那麼……",
    "voice": "vo_adv_1290004_052",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你的名字是？",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "{0}……",
    "voice": "vo_adv_1290004_053",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我記住了。",
    "voice": null,
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "請多指教喔。",
    "voice": "vo_adv_1290004_054",
    "unit_id": 129031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n{0}。",
