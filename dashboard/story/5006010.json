[
  {
    "type": "dialogue",
    "name": "島クジラ",
    "words": "だいたい、",
    "voice": "vo_adv_5005010_000",
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "島クジラ",
    "words": "何もかもが思い通りになるこの島で、",
    "voice": null,
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "島クジラ",
    "words": "\\n一体何が不満だったのだ……",
    "voice": null,
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "島クジラ",
    "words": "\\nワシに逆らった者は",
    "voice": null,
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "島クジラ",
    "words": "お前らが初めてだぞ！",
    "voice": null,
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "島クジラ",
    "words": "あんな、",
    "voice": "vo_adv_5005010_001",
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "島クジラ",
    "words": "外の不自由な世界の",
    "voice": null,
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "島クジラ",
    "words": "\\nどこが面白いと言うのだ！",
    "voice": null,
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "島クジラ……",
    "voice": "vo_adv_5005010_002",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "お前は間違ってるにゃ！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n願いが叶わないなら面白くない？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\nそんなことはないにゃ。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "思い通りにいかないから、やりがいがあるにゃ。",
    "voice": "vo_adv_5005010_003",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "あたしはこのメルクリウス財団のみんなと、",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n島にいるよりもっと面白おかしく人生を生きてみせるにゃ！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "ミフユ",
    "words": "そう。",
    "voice": "vo_adv_5005010_004",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "ミフユ",
    "words": "夢は、",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "ミフユ",
    "words": "叶えてもらうものじゃないわ。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "ミフユ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "ミフユ",
    "words": "私たちの手で掴むものよ。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "あなたのちっぽけな幻想で満足できるほど、",
    "voice": "vo_adv_5005010_005",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\n私たちの欲望は、小さなものじゃないもの！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "そうですわ。",
    "voice": "vo_adv_5005010_006",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\nあまり見くびらないでくださいませ。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "私たち……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "メルクリウス財団の欲望を！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "島クジラ",
    "words": "おおおお愚か者どもめ……",
    "voice": "vo_adv_5005010_007",
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "島クジラ",
    "words": "\\nワシをコケにした報い、",
    "voice": null,
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "島クジラ",
    "words": "死で受けてもらうぞ！",
    "voice": null,
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "さあ、来ますわ！",
    "voice": "vo_adv_5005010_008",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "　戦いの始まりですわよ！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "島クジラ",
    "words": "ぐああああっ！",
    "voice": "vo_adv_5005010_009",
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "島クジラ",
    "words": "　そ、",
    "voice": null,
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "島クジラ",
    "words": "そんなバカなああああ……！",
    "voice": null,
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "や、",
    "voice": "vo_adv_5005010_010",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "やりましたわ！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "　島クジラに勝ちましてよ！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "これも、",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "{0}さまのお陰ですわ！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "島クジラ",
    "words": "ぐおおおおおっ！",
    "voice": "vo_adv_5005010_011",
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "あれ？",
    "voice": "vo_adv_5005010_012",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "　何かしら？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\n沈んでいく島クジラが、",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\n何かを背中から一斉に吹き出してる……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "あいたっ！　",
    "voice": "vo_adv_5005010_013",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "固くてちっちゃな……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "これは……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "タマキ",
    "words": "キャットコインにゃ！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "ミフユ",
    "words": "このコインは実在してたのね……",
    "voice": "vo_adv_5005010_014",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "ミフユ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "ミフユ",
    "words": "もしかしたら、",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "ミフユ",
    "words": "昔にこの島に漂着した\\n海賊のお宝だったのかも！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "なんだか、思いがけず儲かっちゃった！",
    "voice": "vo_adv_5005010_015",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "でも、",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "それより問題は……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "ミフユ",
    "words": "これで、",
    "voice": "vo_adv_5005010_016",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "ミフユ",
    "words": "本当にランドソルへ帰れるのかってことよね……",
    "voice": null,
    "unit_id": 108011
  }
]
