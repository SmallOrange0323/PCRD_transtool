  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "終於來了！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真是的～",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "居然讓淑女久候，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n這可不是紳士該做的事情喔哥哥！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『……",
    "voice": "vo_adv_1023500_001",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "嗯，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "雖然是綾音自己想要早點見到小子，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n才急著跑來約定的地方呢』",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "才、",
    "voice": "vo_adv_1023500_002",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "才不是那樣啦！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我可是守時的好孩子喔！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……所以說哥哥你，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "找我有什麼事呢？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咦……！？",
    "voice": "vo_adv_1023500_003",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥你記得啊……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "謝謝你～！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是不是又更接近完美的大姊姊一些了呢♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咦，",
    "voice": "vo_adv_1023500_004",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "你說在育幼院準備了派對……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這樣的話你要早點說啊哥哥！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這樣的話得馬上回去才行呢♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『我、",
    "voice": "vo_adv_1023500_005",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我的！？",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n不是、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "就算你突然給我這樣的東西……",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "啊、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "這樣啊！",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n這也是",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "要給綾音的生日禮物的其中之一對吧？』",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是這樣嗎！？　",
    "voice": "vo_adv_1023500_006",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這樣的話我的是……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哇♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n這是",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "成套的洋裝！　",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉噗吉，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是一對的喔～♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "欸嘿嘿，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "想要快點穿穿看呢～♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真、",
    "voice": "vo_adv_1023500_007",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真的嗎！？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可是突然間為什麼……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咦、",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n因為今天是我的生日？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_1023500_008",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這樣的話我可不會放過哥哥喔！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "今天可要大家一起，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n直到晚上都一直一起玩家家酒喔，做好覺悟吧♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就是這樣，",
    "voice": "vo_adv_1023500_009",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥要讓我坐在肩膀上回去喔♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n當然",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不可以有異議喔～！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "欸嘿嘿，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "今天要全～力的撒嬌喔♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……哥哥對我一直都很溫柔，謝謝你呢，",
    "voice": "vo_adv_1023500_010",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯？　",
    "voice": "vo_adv_1023500_011",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "你問我說了什麼……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "什麼都沒～有♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好了哥哥，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "再繼續加速吧！",
    "voice": null,
    "unit_id": 102311
  },
  {
