  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在暫時居住的咲戀育幼院裡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n雷姆與{0}一起幫忙鈴莓工作。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "嘿、",
    "voice": "vo_adv_1097007_000",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "咻。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "呼，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "這樣盤子就洗得差不多了呢。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "呵呵，",
    "voice": "vo_adv_1097007_001",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "給孩子們用的小小器皿，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "真是可愛♪",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是的，",
    "voice": "vo_adv_1097007_002",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "簡直就像遊戲玩具一樣呢。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n鈴莓小姐是不是也這樣覺得？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "鈴莓小姐？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……不、",
    "voice": "vo_adv_1097007_003",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不見……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n不見了，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不管哪裡都……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "……",
    "voice": "vo_adv_1097007_004",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "妳的臉色看起來好差，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n是發生什麼事了嗎？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "難道說",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是感冒了……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哈、",
    "voice": "vo_adv_1097007_005",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哈哇……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哈哇哇哇……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "該怎麼辦才好，{0}先生、",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雷姆小姐～～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "炒麵麵包的，",
    "voice": "vo_adv_1097007_006",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "專用盤子？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是的……",
    "voice": "vo_adv_1097007_007",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n是一個形狀很適合",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "用來盛裝大小姐最愛吃的炒麵麵包的",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n專用盤子。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "它不見了……",
    "voice": "vo_adv_1097007_008",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n從好幾天前開始……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不管哪裡都找不到。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好像被我給弄丟了～～～～！",
    "voice": "vo_adv_1097007_009",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我明明想著即使再怎麼冒失，",
    "voice": "vo_adv_1097007_010",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n只有大小姐這個重要的盤子",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "絕對不能打破、",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n也不能弄丟，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "一直以來都很小心翼翼地對待。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗚嗚嗚……",
    "voice": "vo_adv_1097007_011",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我這個人，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "終究還是搞砸了……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這已經不光是冒失而已。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我沒有資格當女僕。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這次一定會被開除的～！！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "請、",
    "voice": "vo_adv_1097007_012",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "請冷靜下來，鈴莓小姐。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "事情的經過雷姆都了解了。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n那些妳覺得有可能放置的地方，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "都已經找過了對吧？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是的……",
    "voice": "vo_adv_1097007_013",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n不只是廚房，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "連衣櫃跟庭院都找過了，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n但是到處都沒有……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是嗎……",
    "voice": "vo_adv_1097007_014",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "不過，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "這還真是不可思議呢。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n盤子應該不會自己擅自亂跑才對……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "難道說……",
    "voice": "vo_adv_1097007_015",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是已經被我打破了……？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "說不定在我打破後卻沒有發現到盤子破掉，",
    "voice": "vo_adv_1097007_016",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n就這樣在打掃地板的時候掃起來丟掉了……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗚嗚，",
    "voice": "vo_adv_1097007_017",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "很有可能……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "如果是我的話非常，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是絕對有可能會這樣做～～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "……",
    "voice": "vo_adv_1097007_018",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "打掃地板？",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "打掃地板……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "啊，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "這麼說起來……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆在想搞不好是……",
    "voice": "vo_adv_1097007_019",
    "unit_id": 109711
  },
  {
    "type": "background",
    "bg_id": "500120"
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "妳說要把地板，",
    "voice": "vo_adv_1097007_020",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "給掀起來？？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是的，",
    "voice": "vo_adv_1097007_021",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "就是地板。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "失禮了。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "我記得",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是在這附近……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "有個稍微用力",
    "voice": null,
    "unit_id": 109711
  },
  {
