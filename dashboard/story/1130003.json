    "words": "接著來喝點茶吧。",
    "voice": "vo_adv_1130003_059",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我拿這邊的藥草去泡茶囉～",
