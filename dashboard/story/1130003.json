    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這個點心真好吃！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "啊，",
    "voice": "vo_adv_1130003_053",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個是金平糖，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n我在一個叫大江戶的鎮上吃過後，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n覺得很好吃，就經常隨身帶著了……",
    "voice": null,
    "unit_id": 113011
  },
