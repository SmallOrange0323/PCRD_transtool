[
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "已經破壞結晶了，",
    "voice": "vo_adv_5019323_000",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n應該",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不會再下那種冰冷的雨了！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雨吉，",
    "voice": "vo_adv_5019323_001",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "再撐一下……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n再一下下你就能見到晴吉了，冷靜點！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "對不起……",
    "voice": "vo_adv_5019323_002",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦……",
    "voice": "vo_adv_5019323_003",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這個聲音……？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "難道這是",
    "voice": "vo_adv_5019323_004",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "雨吉的心聲……？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "對不起……",
    "voice": "vo_adv_5019323_005",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "對不起……",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "我並不想那麼做……",
    "voice": "vo_adv_5019323_006",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n我並不想跟你吵架的……",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "晴吉一定不會原諒我……",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "我好孤單喔……",
    "voice": "vo_adv_5019323_007",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n我還想再跟你一起玩……",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "晴吉……",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……雨吉",
    "voice": "vo_adv_5019323_008",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n原來害怕見到晴吉呢。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "吵架後，",
    "voice": "vo_adv_5019323_009",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "變得孤單一人，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "覺得很難過……",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "剛才的屏障和結晶",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "原來是因為這樣子啊。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "既然如此，",
    "voice": "vo_adv_5019323_010",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "身為和好的前輩，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n我們得教教他該怎麼做才行！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "鈴奈……",
    "voice": "vo_adv_5019323_011",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "說的沒錯！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我們教教她吧，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "所謂的朋友，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n才不會因為小小的吵架就分道揚鑣！",
    "voice": null,
    "unit_id": 110211
  }
]
