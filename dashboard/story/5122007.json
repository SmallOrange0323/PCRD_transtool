[
  {
    "type": "background",
    "bg_id": "502010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "大間的海洋恢復成原本的美麗模樣──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "優花梨、",
    "voice": "vo_adv_5122007_000",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真軌先生！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "和正先生",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "說要展示很有趣的捕魚法給我們看！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "哼哼，",
    "voice": "vo_adv_5122007_001",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "這是大海驚喜箱。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "你們看著喔，",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "就用這個來誘導金槍鮪──",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "唉唷！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "犯傻啦。",
    "voice": "vo_adv_5122007_002",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "嘩啦！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "連、",
    "voice": "vo_adv_5122007_003",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "連同大海驚喜箱",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "一起掉進海裡了！？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──咻砰砰砰砰砰砰砰砰──！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "可、",
    "voice": "vo_adv_5122007_004",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "可媲美水上煙火的大爆炸──！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "……但是爆炸掀起的浪，",
    "voice": "vo_adv_5122007_005",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "一口氣把金槍鮪全沖到海灘上了！？",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "喔喔，",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "真是大豐收。",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "太、",
    "voice": "vo_adv_5122007_006",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "太厲害了！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "和正先生，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "難道這一開始就是你的目的……？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "…………啊，",
    "voice": "vo_adv_5122007_007",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "嗯。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "是這樣沒錯。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……！",
    "voice": "vo_adv_5122007_008",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n優花梨！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那個人相當能幹呢。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "一定要",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "把他挖角過來當我們的外部顧問！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "秋乃，這個主意………………",
    "voice": "vo_adv_5122007_009",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "實在太棒了！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "妳、",
    "voice": "vo_adv_5122007_010",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "妳們啊……",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n因為發生了太多事的反作用，",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "讓妳們的大腦完全進入度假模式了吧……",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "聽我的勸，",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "妳們還是先把那個主意",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "收回去吧。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "那些小事情就先別管了！",
    "voice": "vo_adv_5122007_011",
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "總之先來切魚吧！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "我已經受夠曖昧模糊的味道了！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "\\n",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "真軌",
    "words": "快來享用美味到會讓人大吃一驚的金槍鮪吧！",
    "voice": null,
    "unit_id": 191011
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "贊成～！",
    "voice": "vo_adv_5122007_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……呵呵，",
    "voice": "vo_adv_5122007_013",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "大家看起來都很開心呢。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "太好了，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "大間又恢復原本美麗的模樣了。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不，",
    "voice": "vo_adv_5122007_014",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n是多虧了秋乃她們",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "強到可稱作是執念的毅力。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……我稱讚別人很難得嗎？",
    "voice": "vo_adv_5122007_015",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……呵呵。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "…………",
    "voice": "vo_adv_5122007_016",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "人與人之間，",
    "voice": "vo_adv_5122007_017",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "到頭來",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "終究都是各自獨立。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就算手牽著手，",
    "voice": "vo_adv_5122007_018",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "感覺自己與他人產生了聯繫……",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "每個人心裡還是會藏著一個，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "絕對不會敞開的祕密房間。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那扇門不能打開。",
    "voice": "vo_adv_5122007_019",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不能",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "揭露出那些祕密。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這就是",
    "voice": "vo_adv_5122007_020",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我所認為的",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "世間真理。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……嗯，",
    "voice": "vo_adv_5122007_021",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "差不多就是這樣吧。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……是啊。",
    "voice": "vo_adv_5122007_022",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真令人驚訝。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "秋乃她們堅決不顧我的反對，",
    "voice": "vo_adv_5122007_023",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n把自己弄得渾身是傷，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "卻還是靠著那股不顧後果的信念穿破了世間真理，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n最終",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "打開了眾人的心扉。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……除了痛快以外，沒有別的詞可以形容了。",
    "voice": "vo_adv_5122007_024",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……",
    "voice": "vo_adv_5122007_025",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n看來這一次，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是「祕密主義者似似花」",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "輸了呢。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……咦？",
    "voice": "vo_adv_5122007_026",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……！",
    "voice": "vo_adv_5122007_027",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你為什麼會知道這件事？",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……原來如此。",
    "voice": "vo_adv_5122007_028",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "畢竟真軌也是急壞了。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "他大概是認為",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "如果是你就不會多問，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "願意陪他一起找吧。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "能正確計算風險與報酬的交叉點，",
    "voice": "vo_adv_5122007_029",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n採取最能符合主人心意的方法。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不愧是我的僕人。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "雖然也有冒失之處，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但可稱得上是模範隨從。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……沒錯。",
    "voice": "vo_adv_5122007_030",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這個資料記錄裝置，",
    "voice": "vo_adv_5122007_031",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就是我的祕密。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "很小一個對不對？",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "可是，",
    "voice": "vo_adv_5122007_032",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "卻很沉重。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "…………",
    "voice": "vo_adv_5122007_033",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真想拋開它啊……",
    "voice": "vo_adv_5122007_034",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n要是我能拋開一切，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "說出這個祕密，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "會有多麼自由呢……",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……",
    "voice": "vo_adv_5122007_035",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……真奇妙，",
    "voice": "vo_adv_5122007_036",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我覺得好像能夠理解了。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "理解覺得可以說給你聽、",
    "voice": "vo_adv_5122007_037",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "想著希望能讓你知道，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n不小心就放下了心防的",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那些少女的心情……",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你那種特質，",
    "voice": "vo_adv_5122007_038",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "該稱之為包容力嗎？",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "呵呵……",
    "voice": "vo_adv_5122007_039",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "過去明明是由我",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n來教育失去記憶與智能的你……",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n但現在",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "情況好像反過來了呢。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "………………",
    "voice": "vo_adv_5122007_040",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "──不過。",
    "voice": "vo_adv_5122007_041",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "改變自己以外的物體模樣，",
    "voice": "vo_adv_5122007_042",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "並不是我原本的能力。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "所以要大量改變是不可能的，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但只改變這一個倒還可以。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不，",
    "voice": "vo_adv_5122007_043",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這並不是擬態。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我把那東西的存在本身變成貝類了。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你看，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "有貝類的虹管對吧？",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "牠",
    "voice": "vo_adv_5122007_044",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不會再變回原本的模樣了。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "牠沒有背負著任何機密，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就只是一顆安靜的雙殼貝。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……",
    "voice": "vo_adv_5122007_045",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "變成貝類的話，",
    "voice": "vo_adv_5122007_046",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也不會做什麼壞事吧。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──噗通。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "晃～啊、晃～啊……",
    "voice": "vo_adv_5122007_047",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "逐漸沉下去了呢。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……",
    "voice": "vo_adv_5122007_048",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "請別露出那種表情。",
    "voice": "vo_adv_5122007_049",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我並不是不信任你。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……沒錯。",
    "voice": "vo_adv_5122007_050",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……沒有錯。",
    "voice": "vo_adv_5122007_051",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那可不是",
    "voice": "vo_adv_5122007_052",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "普通的祕密。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "background",
    "bg_id": "501210"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「──測試，",
    "voice": "vo_adv_5122007_053",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "測試。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「──我成了教育者，",
    "voice": "vo_adv_5122007_054",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "負責教導失去智能與生活能力的他。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「關於他的生態還有許多未知的部分，",
    "voice": "vo_adv_5122007_055",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "為了留下正確的紀錄，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n從這一刻起我將以音聲",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "來記錄『教育日誌』。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「──今天",
    "voice": "vo_adv_5122007_056",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "要練習加法的進位，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "成效不佳。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我不小心就用了嚴格的態度指導他，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "他仍然努力照我說的方式解題。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n儘管是因為心智退化的緣故，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但他太過率直，讓人很沒勁。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "107000101"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「──他總算學會加法的進位了。",
    "voice": "vo_adv_5122007_057",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我忍不住跟他擊了掌，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "恐怕會有損",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "教育者的威嚴。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n率直的性格難道是有傳染力的嗎……」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "107000101"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「──他好像身體不舒服，",
    "voice": "vo_adv_5122007_058",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "今天停課。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n因此",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這份教育日誌",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "今天也暫停一次。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「他想必",
    "voice": "vo_adv_5122007_059",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "會受到與他同住的少女們無微不至的照料，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n而我",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "該做的其他工作可是堆積如山。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「……明明是這樣子。",
    "voice": "vo_adv_5122007_060",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n然而不知為何我卻心不在焉，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "什麼事都沒辦法做，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n像現在這樣漫不經心地",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "記錄著沒什麼事情可記錄的教育日誌。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「記錄……？",
    "voice": "vo_adv_5122007_061",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我到底",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是想記錄什麼呢……」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "107000101"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「──課程",
    "voice": "vo_adv_5122007_062",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "最後一天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n他的算術與一般常識",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "都沒有問題，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "應該不會有生活上的困難了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n教育他的工作，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我決定就到今天為止。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「接下來",
    "voice": "vo_adv_5122007_063",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "他必須自行開闢自己的人生之路。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我既沒有理由與他保持更多個人聯繫，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也沒有",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那個必要。」",
