[
  {
    "type": "background",
    "bg_id": "501132"
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "唉……",
    "voice": "vo_adv_6050103_000",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "為什麼我會接下",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n那些讓人費心的孩子們的委託呢？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "當然啊！",
    "voice": "vo_adv_6050103_001",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "話說騎士先生",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你雖然說會幫忙，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n但還不是跟著那些孩子們一起搗亂！",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "算了，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我相信你該做事的時候還是會幫忙我的。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "什麼！？",
    "voice": "vo_adv_6050103_002",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "才不是那樣呢。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真是的，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生到底怎麼看我的啊？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "其實你也不是說我壞話，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "幹嘛這麼慌張呢",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嗯，總之，",
    "voice": "vo_adv_6050103_003",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我很想幫怜大人好好打扮一番，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n這是事實啦，",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但被你這樣點破總覺得不是很痛快啊。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "雖然這是事實……",
    "voice": null,
    "unit_id": 113911
  }
]
