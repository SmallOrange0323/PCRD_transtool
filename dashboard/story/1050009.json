  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "每天都會去書店查看雜誌，",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "\\n跟店員交流資訊，",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "很認真學習呢。",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我、",
    "voice": "vo_adv_1050009_031",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我沒有要學習的意思啦。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "如果是成熟的淑女，做到這點小事情",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "算是常識。",
    "voice": null,
    "unit_id": 105011
  },
  {
