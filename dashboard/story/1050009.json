  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "一掃而空了。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "所以，",
    "voice": "vo_adv_1050009_027",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
