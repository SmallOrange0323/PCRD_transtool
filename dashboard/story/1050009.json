  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "說得對！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "如果是成熟的淑女，怎能不趕上流行！",
