    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "沒、",
    "voice": "vo_adv_1050009_042",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "沒錯！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "因為成熟的淑女必須很時尚！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "像是化妝啦髮型啦衣服啦，",
