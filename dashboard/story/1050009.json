  },
  {
    "type": "dialogue",
    "name": "其他學校的女生",
    "words": "\\n",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "其他學校的女生",
    "words": "小孩子要自稱是成熟的淑女，",
