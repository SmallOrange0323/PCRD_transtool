    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "其他學校的女生",
    "words": "只是裝出來的，不是嗎？",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "其他學校的女生",
    "words": "\\n我不會把只是對時尚感興趣的小孩子，",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "其他學校的女生",
    "words": "\\n稱作成熟的淑女。",
    "voice": null,
    "unit_id": 5411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這！？",
    "voice": "vo_adv_1050009_046",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這是什麼話！！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n妳想說我不是成熟的淑女嗎！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "別、",
