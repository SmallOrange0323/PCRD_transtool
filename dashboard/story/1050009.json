  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "妳想說什麼……？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "其他學校的女生",
    "words": "我認為那樣",
