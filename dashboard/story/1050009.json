  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "…………",
    "voice": "vo_adv_1050009_000",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……啊！",
    "voice": "vo_adv_1050009_001",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "沒、",
    "voice": "vo_adv_1050009_002",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "沒什麼！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "成熟的淑女也有各種情況啦。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n好了，別管我！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……啊，",
    "voice": "vo_adv_1050009_003",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你真的打算走掉！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "淑女陷入沮喪了耶！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這時候溫柔的陪伴她，才是紳士的應對方式吧！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……咦？",
    "voice": "vo_adv_1050009_004",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "開玩笑的！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這是大人的策略！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "好、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "好奸詐！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "大人果然很奸詐！！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "如果你是紳士，請以更聰明的方式吸引淑女的注意！",
    "voice": "vo_adv_1050009_005",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n總有些方法吧！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "…………不行嗎？",
    "voice": "vo_adv_1050009_006",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我也不是",
    "voice": "vo_adv_1050009_007",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "一直都跟朋友在一起。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "要說的話，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那只是大家自己黏著我而已。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "直到不久之前……",
    "voice": "vo_adv_1050009_008",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "她們也",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "非常高興地聽著我說話。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n如果沒發生那種事，現在也還會……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "別提這個了！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "總之，",
    "voice": "vo_adv_1050009_009",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我是作為獨立的成熟淑女，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n主動選擇一人獨處的！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "…………你有",
    "voice": "vo_adv_1050009_010",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "意見嗎？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "跟我一起……？",
    "voice": "vo_adv_1050009_011",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這是約會的邀請……？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "好、",
    "voice": "vo_adv_1050009_012",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "好吧？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n反正我今天碰巧",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "有空，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "偶爾跟你約會也不錯！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n你會帶我去時髦的地方對吧♪",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嘿嘿♪",
