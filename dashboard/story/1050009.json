  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗯～",
    "voice": "vo_adv_1050009_015",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那我選這個",
