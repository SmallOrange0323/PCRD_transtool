  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "\\n",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "所以，",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "我看今天就散會好了。",
    "voice": null,
    "unit_id": 415
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "\\n那麼，",
