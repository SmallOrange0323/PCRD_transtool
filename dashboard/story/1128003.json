[
  {
    "type": "background",
    "bg_id": "500158"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "真陽和{0}順利回到了牧場，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但到達時太陽幾乎都已經下山了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "呼～",
    "voice": "vo_adv_1128003_000",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "總覺得發生了好多意料之外的事，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n回來已經都這麼晚了啊。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "現在要摸黑走山路回去的話太危險了啦。",
    "voice": "vo_adv_1128003_001",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "今天就先在這裡住一晚的啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "小事小事。",
    "voice": "vo_adv_1128003_002",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我這裡也沒什麼好招待你的，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n但食物要多少有多少的啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你在這裡好好放鬆吧。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好，",
    "voice": "vo_adv_1128003_003",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那麼趕快來吃飯吧。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "今天就招待你吃用牧場的乳製品",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "做出來的高級料理的啦！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哎呀～",
    "voice": "vo_adv_1128003_004",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥你真的很捧場耶。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "看到你吃得這麼開心，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "也不枉我精心準備這些料理了啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我們這裡啊，栞栞是小鳥胃，",
    "voice": "vo_adv_1128003_005",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "鈴鈴又有點偏食，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n平常沒辦法煮太多。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "大家現在在做什麼呢……",
    "voice": "vo_adv_1128003_006",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不知道有沒有好好吃飯？",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "會不會玩得太過頭了呢……",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "因為平常都生活在一起，",
    "voice": "vo_adv_1128003_007",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "突然看不到人的時候",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就會擔心這擔心那的啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯～",
    "voice": "vo_adv_1128003_008",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我想是一時不習慣吧。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "平常都熱熱鬧鬧的，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "大家在一起好像是理所當然的一樣。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "一想到如果大家都不回來的話……",
    "voice": "vo_adv_1128003_009",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我的心裡",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就會有點難過呢。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過，",
    "voice": "vo_adv_1128003_010",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "現在有老哥陪在我身邊，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "所以我一點都不會寂寞。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……老哥，",
    "voice": "vo_adv_1128003_011",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我知道你純粹是為了我才這麼講，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n但這種話你可千萬",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不能對其他女孩子說。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不然可是會招來各種誤解，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "而且事情會一發不可收拾的啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不、",
    "voice": "vo_adv_1128003_012",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我也不是",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不願意跟你一起睡啦……",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯？",
    "voice": "vo_adv_1128003_013",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "怎麼了嗎老哥？",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "怎麼突然站起來……",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n咦？",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哇！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "為什麼一直靠過來的啦？",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不、",
    "voice": "vo_adv_1128003_014",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不行啦！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這種事情",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "要按部就班……",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊？",
    "voice": "vo_adv_1128003_015",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "欸？",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你說聲音嗎……",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真、",
    "voice": "vo_adv_1128003_016",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真的耶，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我也聽到了啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n這是什麼聲音？",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "難、",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "難道說是",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "魔物？",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老、",
    "voice": "vo_adv_1128003_017",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥你要去哪……",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你要去外面查看狀況嗎？",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……我也",
    "voice": "vo_adv_1128003_018",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "一起去的啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n不能夠把事情",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "都推給客人。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "background",
    "bg_id": "500152"
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗚嗚，",
    "voice": "vo_adv_1128003_019",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "晚上果然很恐怖啦……",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n如果是平常的話，栞栞和莉瑪莉瑪都會來幫我。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然頂著公會長的頭銜，",
    "voice": "vo_adv_1128003_020",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但只要沒有大家的幫忙，我就會像現在這樣，什麼事都辦不到。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我深刻感受到",
    "voice": "vo_adv_1128003_021",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n大家的存在對我有多麼重要的啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "可是，",
    "voice": "vo_adv_1128003_022",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "最近大家實在太過努力了，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n就連鈴鈴都",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "很認真工作。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "如果連這種事",
    "voice": "vo_adv_1128003_023",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我都沒辦法挺身解決，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n就有損公會長之名的啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這、",
    "voice": "vo_adv_1128003_024",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這麼說也是。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "太過逞強",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是不會有好結果的啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "噗哈！",
    "voice": "vo_adv_1128003_025",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老、",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你怎麼了，為什麼突然發出牛叫聲啦！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "難道說",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你是為了讓我不要緊張嗎？",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我的確",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是想著必須要努力，結果太過逞強了啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "沒錯！",
    "voice": "vo_adv_1128003_026",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "身為搞笑藝人，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "得隨時保持從容的笑容才行。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n不然就",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "沒辦法帶給眾人歡笑的啦。",
