  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "像這樣肩併著肩逛街購物，",
    "voice": "vo_adv_6054208_000",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "坐在路邊長凳上閒聊，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還真是挺開心的。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "可是到時候，",
    "voice": "vo_adv_6054208_001",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "搞不好又要麻煩你提東西了。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……你說那樣也很開心？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還真符合你的個性呢。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n不過其實我也是。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "只要和你在一起，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不管做什麼都讓人感到開心。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好啊。",
    "voice": "vo_adv_6054208_002",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這次幸虧有你，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "才終於能放鬆一下。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n謝謝你。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "約會……",
    "voice": "vo_adv_6054208_003",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "哎唷，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你是在逗著我玩的吧？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……不過，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好啊。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "反正我也喜歡",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "跟你獨處時無拘無束的感覺，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "更重要的是",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "過得也很愉快。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那麼，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們一言為定囉！",
    "voice": null,
    "unit_id": 114511
  }
]
