[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "對晶甚感好奇的諾維姆，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n決定要向同為七冠的變貌大妃探聽她是個什麼樣的人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "似似花，",
    "voice": "vo_adv_5111605_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我問妳。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n妳覺得",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "晶她是個",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "什麼樣的人啊？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n我知道她好歹是七冠，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "所以很優秀。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "沒錯，",
    "voice": "vo_adv_5111605_001",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "無能之輩是沒辦法擔任七冠的。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n她有著出眾的才華，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "也具備持續專研的毅力。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "是喔～",
    "voice": "vo_adv_5111605_002",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "她果然很厲害嗎！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "妳們成為敵人以前，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "妳很尊敬",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "跟信任她囉？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "不，",
    "voice": "vo_adv_5111605_003",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "並沒有，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "一點也不會。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "如果要排不能信任的七冠排名，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n她毫無疑問地是第一名。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "……是喔……",
    "voice": "vo_adv_5111605_004",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "妳好像有話想說？",
    "voice": "vo_adv_5111605_005",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "不，",
    "voice": "vo_adv_5111605_006",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "沒什麼。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "那",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "她那裡讓妳無法信任？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "在能力方面不是沒問題嗎？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n詳細告訴我吧！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "她跟周遭人的溝通相當有問題。",
    "voice": "vo_adv_5111605_007",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n舉例來說，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "跟她確認工作進度，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "她只會回「普通」。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "問她和合作廠商交涉起來感覺如何也是",
    "voice": "vo_adv_5111605_008",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "「普通」，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n確認處理客訴的結果也是",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "「普通」，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "叫外賣的時候，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "看了菜單也是",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "「普通」……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "總之她祕密主義到家，",
    "voice": "vo_adv_5111605_009",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "從不透露自己的情報。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "但儘管如此，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "她所提出的成果卻總是「最棒」的。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "可疑之處實在太多了，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "不可能信任她。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "與其說是祕密主義，",
    "voice": "vo_adv_5111605_010",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我覺得她只是在敷衍回應而已……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "算",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "了，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我知道似似花有多辛苦了！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n順便問一下，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "這種八卦還有多少？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "這個嘛，",
    "voice": "vo_adv_5111605_011",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "請稍等一下。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "我應該",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "有把她對我的折磨，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n記錄在文件檔裡……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "還、",
    "voice": "vo_adv_5111605_012",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "還有建檔喔！？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n妳也太會記仇了吧！？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "這樣的話，",
    "voice": "vo_adv_5111605_013",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "妳就和晶在同一間辦公室共事看看吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "只要配合她的突發奇想，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "睡個幾天晚上的睡袋，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n妳應該就能理解我的感受了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "唔，",
    "voice": "vo_adv_5111605_014",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "這我可能不太想……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "但是，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "最後妳還是有陪她，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n不就代表妳們關係不錯嗎？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "……不知道為什麼，",
    "voice": "vo_adv_5111605_015",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "每當有其他成員在工作上陷入困難，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n她就會不知從哪聞訊前來協助。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "所以，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "我也不是沒有受過她幫助。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "我從不覺得我們關係很好，",
    "voice": "vo_adv_5111605_016",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "但欠著人情不還",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "感覺也很差。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "我們之間",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "只是盡最基本的道義……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "就只是這樣而已。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "哦哦！",
    "voice": "vo_adv_5111605_017",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "感覺",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "這樣的關係很酷耶！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n既然這樣，與其記錄埋怨她的事，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "留下這種互相幫助的回憶，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n不是比較不火大嗎？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "……我和她，",
    "voice": "vo_adv_5111605_018",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "已經是敵人了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "現在才去緬懷過去，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "也不會改變現狀。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "也是……",
    "voice": "vo_adv_5111605_019",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "因為",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "看妳講起來好像很高興，",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我就脫口而出了。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "換個話題吧。",
    "voice": "vo_adv_5111605_020",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n妳只要記得，晶是七冠裡祕密最多、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "最不值得信任……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "變貌大妃",
    "words": "是個十分可疑的女人就好。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "這樣啊，",
    "voice": "vo_adv_5111605_021",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我知道了！",
