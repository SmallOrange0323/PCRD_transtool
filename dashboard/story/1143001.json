    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "誰快來想想辦法啊～～！！",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──蘭德索爾中迴盪著智那沉痛的慘叫聲。",
