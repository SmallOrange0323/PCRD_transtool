  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "完全就是必須爆紅的最新造型，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "最尖端的流行口味！",
