    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "剛剛那只是，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "上相甜點帶來的幻覺，只是場夢。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "現實中是邊緣人的我就算裝成陽光角色，",
    "voice": "vo_adv_5213065_003",
    "unit_id": 104011
